********************************************************************************
* Draw the laser temperature gauge [dashboard]
* 
* Used by the routines at #R$190D, #R$2AD0 and #R$6433.
* .
* Draws the laser temperature (#R$F813) / 2 as a bar (#R$6C37). Does nothing
* if the dashboard isn't shown (#R$6C9E).
draw_laser_temperature:                                    ; >6b60
       .call @gate_dashboard_hidden                        ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @laser_temp_gauge,a                            ; LD A,($F813)      ; 
       srl  a,1                                            ; SRL A             ; A = the laser temperature / 2
       li   hl,>1539                                       ; LD HL,$1539       ; the laser temperature gauge
       b    @draw_bar_gauge                                ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the missile indicator
* 
* Used by the routines at #R$2D58, #R$2D70, #R$2D7E, #R$46CA and #R$6433.
* .
* Does nothing unless the dashboard is showing (#R$6C9E). Sets the four
* sprites 4-7 (from $1B10 in the sprite attribute table, #R$39A4) along the
* dashboard: one for each missile the ship can carry, in green for each
* missile it has (#R$F776) - except the next to be fired, which is light
* red when armed and dark red when locked on (#R$E910) - and an empty
* pattern for the rest.
* .
* At $6B8F, uses the missile pattern, coloured light red if it's the next
* to be fired and armed, dark red if locked on, otherwise green ($6BA3).
* .
* At $6BA5, sets this missile's sprite (#R$39A4) and moves on to the next,
* 6 pixels to the right.
draw_missile_indicator:                                    ; >6b6e
       .call @gate_dashboard_hidden                        ; CALL $6C9E        ; do nothing unless the dashboard is showing
       limi 0                                              ; DI                ; 
       movb @bytes+>10,a                                   ; LD A,$10          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>5b,a                                   ; LD A,$5B          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1B10: sprite 4's attributes
       ; EI                                                ; EI                ; TODO: check code. 
       li   bc,>b838                                       ; LD BC,$B838       ; y = $B8, x = $38
       mov  @missile_count,hl                              ; LD HL,($F776)     ; L = number of missiles
       movb one,h                                          ; LD H,$01          ; H = 1 for the first
_6b83:                                                     ; >6b83
       movb h,a                                            ; LD A,H            ; 
       cb   a,@l                                           ; CP L              ; 
       jeq  draw_missile_indicator_2                       ; JR Z,$6B8F        ; the next to be fired
       joc  draw_missile_indicator_2                       ; JR C,$6B8F        ; TODO: check code. one the ship has
       movb @bytes+>14,d                                   ; LD D,$14          ; no missile: the empty pattern...
       movb @bytes+>0f,@e                                  ; LD E,$0F          ; ...in white
       jmp  _6ba5                                          ; JR $6BA5          ; 
draw_missile_indicator_2:                                  ; >6b8f
       movb @bytes+>10,d                                   ; LD D,$10          ; the missile pattern
       jne  draw_missile_indicator_3                       ; JR NZ,$6BA3       ; not the next to be fired
       movb @missile_state,a                               ; LD A,($E910)      ; A = missile state
       socb a,a                                            ; OR A              ; 
       jeq  draw_missile_indicator_3                       ; JR Z,$6BA3        ; not armed
       cb   a,@bytes+>02                                   ; CP $02            ; 
       movb @bytes+>09,@e                                  ; LD E,$09          ; armed: light red
       jne  _6ba1                                          ; JR NZ,$6BA1       ; 
       movb @bytes+>06,@e                                  ; LD E,$06          ; locked on: dark red
_6ba1:                                                     ; >6ba1
       jmp  _6ba5                                          ; JR $6BA5          ; 
draw_missile_indicator_3:                                  ; >6ba3
       movb @bytes+>02,@e                                  ; LD E,$02          ; green
_6ba5:                                                     ; >6ba5
       .call @set_sprite                                   ; CALL $39A4        ; set the sprite
       movb @c,a                                           ; LD A,C            ; 
       ab   @bytes+>06,a                                   ; ADD A,$06         ; 6 pixels to the right
       movb a,@c                                           ; LD C,A            ; 
       ab   one,h                                          ; INC H             ; next missile
       movb h,a                                            ; LD A,H            ; 
       cb   a,@bytes+>05                                   ; CP $05            ; all four done?
       jne  _6b83                                          ; JR NZ,$6B83       ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Draw the roll dial [dashboard]
* 
* Used by the routines at #R$6433 and #R$6BE1.
* .
* Draws the roll rate (#R$F815, -16 to 16) as a pixel at (rate + 16) * 22 / 32
* + 1 on the roll dial (#R$6C71).
draw_roll_dial:                                            ; >6bb3
       movb @roll_rate,a                                   ; LD A,($F815)      ; A = the roll rate
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       movb @bytes+>16,@e                                  ; LD E,$16          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = (rate + 16) * 22 (#R$1F60)
       movb @bytes+>20,a                                   ; LD A,$20          ; 
       .call @divide_hl_a                                  ; CALL $2079        ; HL = (rate + 16) * 22 / 32 (#R$2079)
       movb @l,a                                           ; LD A,L            ; 
       ab   one,a                                          ; INC A             ; 
       li   hl,>12b3                                       ; LD HL,$12B3       ; the roll dial
       b    @draw_dial_gauge                               ; JP $6C71          ; draw it (#R$6C71)

********************************************************************************
* Draw the pitch dial [dashboard]
* 
* Used by the routines at #R$6433 and #R$6BE1.
* .
* Draws the pitch rate (#R$F816, -16 to 16) as a pixel at (rate + 16) * 22 /
* 32 + 1 on the pitch dial (#R$6C71).
draw_pitch_dial:                                           ; >6bca
       movb @pitch_rate,a                                  ; LD A,($F816)      ; A = the pitch rate
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       movb @bytes+>16,@e                                  ; LD E,$16          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = (rate + 16) * 22 (#R$1F60)
       movb @bytes+>20,a                                   ; LD A,$20          ; 
       .call @divide_hl_a                                  ; CALL $2079        ; HL = (rate + 16) * 22 / 32 (#R$2079)
       movb @l,a                                           ; LD A,L            ; 
       ab   one,a                                          ; INC A             ; 
       li   hl,>13b3                                       ; LD HL,$13B3       ; the pitch dial
       b    @draw_dial_gauge                               ; JP $6C71          ; draw it (#R$6C71)

********************************************************************************
* Roll and pitch: stop them when the keys are released
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). After launching, the
* ship is rolling ($E929, #R$1837): this slows the roll down by 1 a frame
* (redrawing its dial and setting up the rotation) until it's stopped or
* reversed.
* .
* Otherwise (at $6BFE), with option D (bit 1 of #R$E914), stops the roll
* and pitch if their keys weren't held this frame (#R$E774, #R$E775),
* redrawing the dial and setting up the rotation. Then clears the
* key-held flags for the next frame.
settle_roll_pitch:                                         ; >6be1
       movb @launch_roll,a                                 ; LD A,($E929)      ; still rolling after launching?
       socb a,a                                            ; OR A              ; 
       jeq  _6bfe                                          ; JR Z,$6BFE        ; no
       movb @roll_rate,a                                   ; LD A,($F815)      ; A = the roll rate
       socb a,a                                            ; OR A              ; 
       jeq  settle_roll_pitch_dials                        ; JR Z,$6BFA        ; stopped
       jhe  !                                              ; JP M,$6BFA        ; or reversed
       b    @settle_roll_pitch_dials                       ;                   
!
       sb   one,a                                          ; DEC A             ; slow it down
       movb a,@roll_rate                                   ; LD ($F815),A      ; 
       .call @draw_roll_dial                               ; CALL $6BB3        ; draw the roll dial
       b    @refresh_roll_table                            ; JP $2209          ; set up the roll
settle_roll_pitch_dials:                                   ; >6bfa
       sb   a,a                                            ; XOR A             ; 
       movb a,@launch_roll                                 ; LD ($E929),A      ; done rolling after launching
_6bfe:                                                     ; >6bfe
       movb @options,a                                     ; LD A,($E914)      ; 
       czc  @bit1,a                                        ; BIT 1,A           ; option D?
       jeq  _6c2f                                          ; JR Z,$6C2F        ; no
       movb @roll_key_held,a                               ; LD A,($E774)      ; roll key held?
       socb a,a                                            ; OR A              ; 
       jne  _6c1a                                          ; JR NZ,$6C1A       ; yes
       li   hl,roll_rate                                   ; LD HL,$F815       ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = the roll rate
       socb a,a                                            ; OR A              ; 
       jeq  _6c1a                                          ; JR Z,$6C1A        ; already stopped
       sb   *hl,*hl                                        ; LD (HL),$00       ; stop the roll
       .call @draw_roll_dial                               ; CALL $6BB3        ; draw the roll dial
       .call @refresh_roll_table                           ; CALL $2209        ; set up the roll
_6c1a:                                                     ; >6c1a
       movb @pitch_key_held,a                              ; LD A,($E775)      ; pitch key held?
       socb a,a                                            ; OR A              ; 
       jne  _6c2f                                          ; JR NZ,$6C2F       ; yes
       li   hl,pitch_rate                                  ; LD HL,$F816       ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = the pitch rate
       socb a,a                                            ; OR A              ; 
       jeq  _6c2f                                          ; JR Z,$6C2F        ; already stopped
       sb   *hl,*hl                                        ; LD (HL),$00       ; stop the pitch
       .call @draw_pitch_dial                              ; CALL $6BCA        ; draw the pitch dial
       .call @refresh_pitch_table                          ; CALL $2212        ; set up the pitch
_6c2f:                                                     ; >6c2f
       sb   a,a                                            ; XOR A             ; 
       movb a,@roll_key_held                               ; LD ($E774),A      ; clear the key-held flags
       movb a,@pitch_key_held                              ; LD ($E775),A      ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a bar gauge [dashboard]
* 
* Used by the routines at #R$6A59, #R$6A88, #R$6AAD, #R$6AC4, #R$6AD0, #R$6B48,
* #R$6B54 and #R$6B60.
* .
* Draws a bar A pixels long (0-24) across the three 8-pixel character cells
* of a dashboard gauge, 4 pixel rows tall (#R$6CA8): A / 8 full cells, a
* cell with the first A mod 8 pixels set (from #R$6DE3), then empty cells.
* Does nothing if the dashboard isn't shown (#R$6C9E).
* 
* I:A The bar's length in pixels (0-24)
* I:HL The VRAM address of the gauge's first cell
draw_bar_gauge:                                            ; >6c37
       .call @gate_dashboard_hidden                        ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb a,@e                                           ; LD E,A            ; E = the length
       sb   d,d                                            ; LD D,$00          ; D = 0, the number of cells drawn
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; A = the number of full cells
       jeq  _6c52                                          ; JR Z,$6C52        ; none
       movb a,@c                                           ; LD C,A            ; C = the number of full cells
       movb a,d                                            ; LD D,A            ; D = the cells drawn
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       sb   @e,a                                           ; SUB E             ; 
       neg a                                               ; NEG               ; 
       movb a,@e                                           ; LD E,A            ; E = the pixels left over (length mod 8)
       movb @b255,a                                        ; LD A,$FF          ; all pixels set
       .call @draw_gauge_tiles                             ; CALL $6CA8        ; draw the full cells (#R$6CA8)
_6c52:                                                     ; >6c52
       movb @e,a                                           ; LD A,E            ; 
       socb a,a                                            ; OR A              ; 
       jeq  _6c66                                          ; JR Z,$6C66        ; no pixels left over
       ab   one,d                                          ; INC D             ; one more cell drawn
       li   ix,gauge_bar_patterns                          ; LD IX,$6DE3       ; IX -> the partial cell patterns (#R$6DE3)
       movb a,@bar_gauge_partial_pattern+>0002             ; LD ($6C60),A      ; patch the displacement (#R$6C5E+2)
bar_gauge_partial_pattern:                                 ; >6c5e
       movb *ix,a                                          ; LD A,(IX+$00)     ; A = the pattern for that many pixels
       movb one,@c                                         ; LD C,$01          ; one cell
       .call @draw_gauge_tiles                             ; CALL $6CA8        ; draw it
_6c66:                                                     ; >6c66
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       sb   d,a                                            ; SUB D             ; 
       jeq  _6c70                                          ; JR Z,$6C70        ; all 3 cells drawn
       movb a,@c                                           ; LD C,A            ; C = the cells left
       sb   a,a                                            ; XOR A             ; empty
       .call @draw_gauge_tiles                             ; CALL $6CA8        ; draw them
_6c70:                                                     ; >6c70
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a dial gauge [dashboard]
* 
* Used by the routines at #R$6BB3 and #R$6BCA.
* .
* Draws a single pixel at position A (0-23) across the three 8-pixel
* character cells of a dashboard gauge, 4 pixel rows tall (#R$6CA8): empty
* cells up to the one with the pixel, the pixel (from #R$E700), then empty
* cells. Used for the roll and pitch dials. Does nothing if the dashboard
* isn't shown (#R$6C9E).
* 
* I:A The pixel's position (0-23)
* I:HL The VRAM address of the gauge's first cell
draw_dial_gauge:                                           ; >6c71
       .call @gate_dashboard_hidden                        ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb one,d                                          ; LD D,$01          ; D = 1 (counting the cell with the pixel)
       movb a,@e                                           ; LD E,A            ; E = the position
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; A = the number of empty cells before the pixel
       jeq  _6c85                                          ; JR Z,$6C85        ; none
       movb a,@c                                           ; LD C,A            ; 
       ab   d,a                                            ; ADD A,D           ; 
       movb a,d                                            ; LD D,A            ; D = the cells drawn
       sb   a,a                                            ; XOR A             ; empty
       .call @draw_gauge_tiles                             ; CALL $6CA8        ; draw them (#R$6CA8)
_6c85:                                                     ; >6c85
       movb @e,a                                           ; LD A,E            ; 
       andi a,>0700                                        ; AND $07           ; the pixel's position in its cell
       movb a,@dial_gauge_pixel_mask+>0001                 ; LD ($6C8C),A      ; patch the mask lookup's address (#R$6C8B+1)
dial_gauge_pixel_mask:                                     ; >6c8b
       movb @pixel_bitmask_table+>0004,a                   ; LD A,($E704)      ; A = the pixel's mask (#R$E700)
       movb one,@c                                         ; LD C,$01          ; one cell
       .call @draw_gauge_tiles                             ; CALL $6CA8        ; draw it
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       sb   d,a                                            ; SUB D             ; 
       jeq  _6c9d                                          ; JR Z,$6C9D        ; all 3 cells drawn
       movb a,@c                                           ; LD C,A            ; C = the cells left
       sb   a,a                                            ; XOR A             ; empty
       .call @draw_gauge_tiles                             ; CALL $6CA8        ; draw them
_6c9d:                                                     ; >6c9d
       .ret                                                ; RET               ; 

********************************************************************************
* Dashboard-hidden gate: skip both this routine and its caller if $E903=0
* 
* Used by the routines at #R$2DC8, #R$6A88, #R$6AAD, #R$6AC4, #R$6AD0, #R$6ADC,
* #R$6B12, #R$6B48, #R$6B54, #R$6B60, #R$6B6E, #R$6C37, #R$6C71 and #R$85FB.
* .
* All the dashboard-gauge-drawing routines below call this first. When the
* dashboard is hidden ($E903=0) it POPs the caller's own return address off
* the stack before returning, so RET here unwinds two levels - both this
* routine and whichever gauge routine called it - skipping the drawing work
* entirely.
gate_dashboard_hidden:                                     ; >6c9e
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb @space_view_showing,a                          ; LD A,($E903)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _6ca6                                          ; JR NZ,$6CA6       ; 
       .pop af                                             ; POP AF            ; 
_6ca6:                                                     ; >6ca6
       .ex_af_af_                                          ; EX AF,AF'         ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Draw C tiles (4 pixel-rows tall) at HL using pattern A [dashboard]
* 
* Used by the routines at #R$6A59, #R$6C37 and #R$6C71.
* .
* A thin wrapper around #R$35B8 with the height fixed at 4; HL (the VRAM
* address) and C (the tile count) are left set by the caller.
draw_gauge_tiles:                                          ; >6ca8
       .push de                                            ; PUSH DE           ; 
       movb a,@e                                           ; LD E,A            ; 
       movb @bytes+>04,b                                   ; LD B,$04          ; 
       .call @fill_vram_rect                               ; CALL $35B8        ; 
       ; EI                                                ; EI                ; TODO: check code. 
       .pop de                                             ; POP DE            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Show the tunnel rings
* 
* Used by the routines at #R$1873, #R$645B and #R$894D.
* .
* The effect for launching (#R$645B, when $E8F6 is set by #R$1837),
* docking (#R$1873) and hyperspace (#R$894D): clears the space view
* (#R$388F), plays sound effect 7, and draws three circles (#R$3D0E)
* that grow outwards - radii starting at 2, 26 and 68 and growing by 4,
* 7 and 10 each frame - 6 frames at a time (#R$3846), four times over.
* The line drawing is switched from OR to XOR meanwhile (at $3CA8 and
* $3CE7), so that each ring is drawn over the last.
tunnel_rings:                                              ; >6cb2
       .call @clear_space_view                             ; CALL $388F        ; clear the space view
       movb @bytes+>a9,a                                   ; LD A,$A9          ; 
       movb a,@shallow_line_plot_op                        ; LD ($3CA8),A      ; draw lines with XOR
       movb a,@steep_line_plot_op                          ; LD ($3CE7),A      ; 
       movb @bytes+>07,a                                   ; LD A,$07          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 7
       movb @bytes+>04,b                                   ; LD B,$04          ; four times
_6cc4:                                                     ; >6cc4
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@tunnel_ring_radii                           ; LD ($E776),A      ; first ring's radius
       movb @bytes+>1a,a                                   ; LD A,$1A          ; 
       movb a,@tunnel_ring_radius_2                        ; LD ($E777),A      ; second's
       movb @bytes+>44,a                                   ; LD A,$44          ; 
       movb a,@tunnel_ring_radius_3                        ; LD ($E778),A      ; third's
       movb @bytes+>06,b                                   ; LD B,$06          ; 6 frames
_6cd6:                                                     ; >6cd6
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>04,@c                                  ; LD C,$04          ; 
       li   hl,tunnel_ring_radii                           ; LD HL,$E776       ; the radii
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 rings
_6cde:                                                     ; >6cde
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb *hl,@l                                         ; LD L,(HL)         ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>03,b                                   ; LD B,$03          ; 
       li   de,>0010                                       ; LD DE,$0010       ; 
       li   ix,>0000                                       ; LD IX,$0000       ; 
       li   iy,>0000                                       ; LD IY,$0000       ; 
       mov  hl,@tunnel_ring_radius                         ; LD ($E921),HL     ; 
       .call @draw_circle                                  ; CALL $3D0E        ; draw a ring
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       ab   @c,a                                           ; ADD A,C           ; 
       movb a,*hl                                          ; LD (HL),A         ; grow it by 4, 7 or 10
       inc  hl                                             ; INC HL            ; 
       ab   one,@c                                         ; INC C             ; 
       ab   one,@c                                         ; INC C             ; 
       ab   one,@c                                         ; INC C             ; 
       sb   one,b                                          ; DJNZ $6CDE        ; next ring
       jne  _6cde                                          ;                   
       movb @message_timer,a                               ; LD A,($E919)      ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6D0D        ; 
       b    @tunnel_rings_show                             ;                   
!
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@message_timer                               ; LD ($E919),A      ; 
tunnel_rings_show:                                         ; >6d0d
       .call @copy_space_view                              ; CALL $3846        ; copy the space view to the screen
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6CD6        ; next frame
       jne  _6cd6                                          ;                   
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6CC4        ; 
       jne  _6cc4                                          ;                   
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@tunnel_rings_finished                       ; LD ($E923),A      ; 
       movb @bytes+>b1,a                                   ; LD A,$B1          ; 
       movb a,@shallow_line_plot_op                        ; LD ($3CA8),A      ; draw lines with OR again
       movb a,@steep_line_plot_op                          ; LD ($3CE7),A      ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Set up the laser for the current view
* 
* Used by the routine at #R$645B.
* .
* Called when the view changes (#R$645B). Finds which laser is fitted to
* the current view (#R$EB9A): each laser's entry in the equipment has one
* bit per mount (bit 0 front, 1 rear, 2 left, 3 right), and they're checked
* in the order pulse (#R$F779), mining (#R$F781), beam (#R$F77A) and
* military (#R$F782) - the last one fitted wins. On the title screen
* ($E940) there's none. Stores the laser type (0-3, or $FF for none) in
* #R$F818; with none, hides the crosshair sprites, otherwise sets up the
* laser ($6D82).
* .
* At $6D82, looks up the laser type's record at #R$6EB3: its cooldown
* between shots (#R$F819) and power (#R$F81A), and its crosshair pattern
* (#R$6DEB), which it uploads to the sprite patterns at $3800 (#R$39B9);
* then sets up the crosshair as four 16x16 sprites around the middle of the
* view (#R$39A4), in the laser type's colour.
view_laser:                                                ; >6d24
       movb @b255,@c                                       ; LD C,$FF          ; no laser yet
       movb @e940_gate_flag,a                              ; LD A,($E940)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _6d6e                                          ; JR NZ,$6D6E       ; the title screen - no laser
       movb @current_view,a                                ; LD A,($EB9A)      ; A = current view
       movb a,b                                            ; LD B,A            ; 
       ab   one,b                                          ; INC B             ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; 
_6d33:                                                     ; >6d33
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $6D33        ; A = the view's mount bit
       jne  _6d33                                          ;                   
       movb b,d                                            ; LD D,B            ; 
       movb @b255,@c                                       ; LD C,$FF          ; 
       movb a,@e                                           ; LD E,A            ; E = mount bit
       movb @item_pulse_laser,a                            ; LD A,($F779)      ; pulse laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d46                                          ; JR Z,$6D46        ; not fitted
       movb b,d                                            ; LD D,B            ; 
       ; AND E                                             ; AND E             ; TODO: check code. 
       jeq  _6d46                                          ; JR Z,$6D46        ; not on this mount
       movb b,@c                                           ; LD C,B            ; type 0
_6d46:                                                     ; >6d46
       ab   one,b                                          ; INC B             ; 
       movb @item_mining_laser,a                           ; LD A,($F781)      ; mining laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d53                                          ; JR Z,$6D53        ; 
       movb b,d                                            ; LD D,B            ; 
       ; AND E                                             ; AND E             ; TODO: check code. 
       jeq  _6d53                                          ; JR Z,$6D53        ; 
       movb b,@c                                           ; LD C,B            ; type 1
_6d53:                                                     ; >6d53
       ab   one,b                                          ; INC B             ; 
       movb @item_beam_laser,a                             ; LD A,($F77A)      ; beam laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d60                                          ; JR Z,$6D60        ; 
       movb b,d                                            ; LD D,B            ; 
       ; AND E                                             ; AND E             ; TODO: check code. 
       jeq  _6d60                                          ; JR Z,$6D60        ; 
       movb b,@c                                           ; LD C,B            ; type 2
_6d60:                                                     ; >6d60
       ab   one,b                                          ; INC B             ; 
       movb @item_military_laser,a                         ; LD A,($F782)      ; military laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d6d                                          ; JR Z,$6D6D        ; 
       movb b,d                                            ; LD D,B            ; 
       ; AND E                                             ; AND E             ; TODO: check code. 
       jeq  _6d6d                                          ; JR Z,$6D6D        ; 
       movb b,@c                                           ; LD C,B            ; type 3
_6d6d:                                                     ; >6d6d
       ab   one,b                                          ; INC B             ; 
_6d6e:                                                     ; >6d6e
       movb d,a                                            ; LD A,D            ; 
       movb a,@flag_search_result_cache                    ; LD ($EFA0),A      ; 
       movb @c,a                                           ; LD A,C            ; 
       movb a,@view_laser_type                             ; LD ($F818),A      ; the laser type for this view
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6D82        ; there is one - set it up
       b    @set_up_laser                                  ;                   
!
       li   hl,>1b00                                       ; LD HL,$1B00       ; none: hide the crosshair sprites
       movb @bytes+>04,b                                   ; LD B,$04          ; 
       b    @hide_sprites                                  ; JP $3942          ; 
set_up_laser:                                              ; >6d82
       movb a,@e                                           ; LD E,A            ; E = the laser type
       ab   a,a                                            ; ADD A,A           ; A = type * 5
       ab   a,a                                            ; ADD A,A           ; 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,laser_types                                 ; LD HL,$6EB3       ; the laser types
       a    de,hl                                          ; ADD HL,DE         ; HL -> this type's record
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@laser_cooldown                              ; LD ($F819),A      ; laser cooldown
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@laser_power                                 ; LD ($F81A),A      ; laser power
       movb *hl,@e                                         ; LD E,(HL)         ; E = the crosshair colour
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL = the RLE pattern stream pointer (record bytes 3-4)
       limi 0                                              ; DI                ; 
       sb   a,a                                            ; LD A,$00          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb @bytes+>78,a                                   ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, write mode: $3800 (sprite pattern table)
       .call @write_run_length_encoded_byte_stream         ; CALL $39B9        ; write the RLE-encoded pattern
       sb   a,a                                            ; LD A,$00          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb @bytes+>5b,a                                   ; LD A,$5B          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, write mode: $1B00 (sprite attribute table)
       li   bc,>3870                                       ; LD BC,$3870       ; initial (row, column)
       sb   d,d                                            ; LD D,$00          ; pattern/colour base
       movb @bytes+>02,@l                                  ; LD L,$02          ; 2 columns
_6db8:                                                     ; >6db8
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>02,h                                   ; LD H,$02          ; 2 rows
_6dbb:                                                     ; >6dbb
       .call @set_sprite                                   ; CALL $39A4        ; write this quadrant's sprite-attribute entry
       movb b,a                                            ; LD A,B            ; 
       ab   @bytes+>10,a                                   ; ADD A,$10         ; next row, 16 pixels down
       movb a,b                                            ; LD B,A            ; 
       sb   one,h                                          ; DEC H             ; 
       jne  _6dbb                                          ; JR NZ,$6DBB       ; next row
       .pop bc                                             ; POP BC            ; 
       movb @c,a                                           ; LD A,C            ; 
       ab   @bytes+>10,a                                   ; ADD A,$10         ; next column, 16 pixels across
       movb a,@c                                           ; LD C,A            ; 
       sb   one,@l                                         ; DEC L             ; 
       jne  _6db8                                          ; JR NZ,$6DB8       ; next column
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Refuse a flight command while docked
* 
* Used by the routines at #R$19FC, #R$1A8A, #R$1B13, #R$1B25, #R$2D58, #R$3223,
* #R$329E, #R$64A1, #R$64B5, #R$64C9, #R$64DD, #R$88AC and #R$8926.
* .
* Called by the handlers for keys that only work in flight. If the
* player is docked (#R$E90A), beeps, shows "Docked!" on the message line
* (#R$3955, #R$5FFB) and returns to the key handler's caller; otherwise returns normally.
refuse_if_docked:                                          ; >6dcf
       movb @docked,a                                      ; LD A,($E90A)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _6de2                                          ; JR Z,$6DE2        ; in flight
       .call @trigger_sfx_6                                ; CALL $16FE        ; beep
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       li   hl,msg_docked                                  ; LD HL,$6F17       ; "Docked!"
       .call @show_message                                 ; CALL $5FFB        ; show it for a while
       .pop hl                                             ; POP HL            ; return to the key handler's caller
_6de2:                                                     ; >6de2
       .ret                                                ; RET               ; 

********************************************************************************
* Gauge bar patterns
* 
* The patterns for the end of a gauge's bar (#R$6C37), 0-7 pixels long.
gauge_bar_patterns:                                        ; >6de3
       byte >00,>80,>C0,>E0,>F0,>F8,>FC,>FE

********************************************************************************
* Crosshair patterns
* 
* The crosshair sprite patterns for the four laser types (#R$6EB3), which
* #R$6D82 uploads to sprite patterns 0-15 at $3800 and shows as four 16x16
* sprites making up a 32x32 crosshair. Each is a run-length encoded stream
* (#R$39B9) of (count, value) pairs, ending with 0, that expands to the 128
* bytes of the four sprite patterns: pulse laser at #R$6DEB, mining laser
* at #R$6E1A, beam laser at #R$6E47 and military laser at #R$6E80.
* .
* The beam laser's stream expands to only 127 bytes, so the last byte of
* sprite pattern 15 keeps whatever the previous crosshair left there. The
* other three streams all end with a run of zeros, so it's 0.
crosshair_patterns:                                        ; >6deb
       byte >0F,>00,>01,>3F,>02,>00,>07,>01                          ; pulse laser: a cross with a gap in the middle
       byte >06,>00,>01,>80,>01,>3F,>0F,>00
       byte >01,>80,>06,>00,>07,>01,>04,>00
       byte >07,>80,>06,>00,>01,>01,>0F,>00
       byte >01,>FC,>01,>01,>06,>00,>07,>80
       byte >02,>00,>01,>FC,>0F,>00
       byte >00                                                      ; end
crosshair_mining:                                          ; >6e1a
       byte >05,>00,>01,>0F,>05,>0C,>05,>00                          ; mining laser: a box, open at the sides
       byte >05,>00,>01,>FF,>0F,>00,>05,>0C
       byte >01,>0F,>0F,>00,>01,>FF,>0A,>00
       byte >01,>FF,>0F,>00,>01,>F0,>05,>30
       byte >0F,>00,>01,>FF,>0A,>00,>05,>30
       byte >01,>F0,>05,>00
       byte >00                                                      ; end
crosshair_beam:                                            ; >6e47
       byte >01,>00,>01,>60,>01,>30,>01,>18                          ; beam laser: an X with a gap in the middle (127 bytes)
       byte >01,>0C,>01,>06,>01,>03,>22,>00
       byte >01,>03,>01,>06,>01,>0C,>01,>18
       byte >01,>30,>01,>60,>22,>00,>01,>06
       byte >01,>0C,>01,>18,>01,>30,>01,>60
       byte >01,>C0,>22,>00,>01,>C0,>01,>60
       byte >01,>30,>01,>18,>01,>0C,>01,>06
       byte >00                                                      ; end
crosshair_military:                                        ; >6e80
       byte >07,>00,>01,>0F,>03,>0C,>09,>00                          ; military laser: a box with a tick above and below
       byte >03,>01,>01,>FF,>0D,>00,>03,>0C
       byte >01,>0F,>0F,>00,>01,>FF,>03,>01
       byte >08,>00,>03,>80,>01,>FF,>0F,>00
       byte >01,>F0,>03,>30,>0D,>00,>01,>FF
       byte >03,>80,>09,>00,>03,>30,>01,>F0
       byte >07,>00
       byte >00                                                      ; end

********************************************************************************
* Laser types
* 
* Five bytes for each type of laser, read by #R$6D82: the cooldown between
* shots (#R$F819), the power (#R$F81A), the colour of the crosshair
* sprites, and the address of the crosshair pattern (#R$6DEB).
laser_types:                                               ; >6eb3
       byte >05,>05,>02                                              ; 0: pulse laser - cooldown 5, power 5, medium green
       data crosshair_patterns                                       ; the crosshair pattern
       byte >04,>0A,>06                                              ; 1: mining laser - cooldown 4, power 10, dark red
       data crosshair_mining                                         ; the crosshair pattern
       byte >02,>05,>07                                              ; 2: beam laser - cooldown 2, power 5, cyan
       data crosshair_beam                                           ; the crosshair pattern
       byte >00,>0A,>0D                                              ; 3: military laser - cooldown 0, power 10, magenta
       data crosshair_military                                       ; the crosshair pattern

********************************************************************************
* Flight sprite patterns
* 
* Two run-length encoded sprite pattern streams (see #R$39B9), each ending
* with 0, uploaded whenever the cockpit screen is set up (#R$63F1). The
* first fills the 16x16 sprite patterns $10 and $14 at $3880: a filled 5x5
* square (a missile the ship has) and a hollow one (an empty missile slot),
* as used by #R$6B6E. The second fills pattern $18 at $38C0: the compass
* dot used by #R$85FB.
flight_sprite_patterns:                                    ; >6ec7
       byte >05,>F8,>1B,>00,>01,>F8,>03,>88,>01,>F8,>1B,>00,>00      ; $3880: missile, empty missile slot
compass_dot_pattern:                                       ; >6ed4
       byte >01,>40,>02,>E0,>01,>40,>1C,>00,>00                      ; $38C0: compass dot

********************************************************************************
* Stardust roll handlers
* 
* The handlers that roll the stardust in each view, indexed by the current
* view (see #R$67A8, #R$68CD).
stardust_roll_handlers:                                    ; >6edd
       data stardust_roll_front                                      ; front
       data stardust_roll_rear                                       ; rear
       data stardust_roll_left                                       ; left
       data stardust_roll_right                                      ; right

********************************************************************************
* Stardust pitch handlers
* 
* The handlers that pitch the stardust in each view, indexed by the current
* view (see #R$67A8, #R$68CD).
stardust_pitch_handlers:                                   ; >6ee5
       data stardust_pitch_front                                     ; front
       data stardust_pitch_rear                                      ; rear
       data stardust_pitch_left                                      ; left
       data stardust_pitch_right                                     ; right

********************************************************************************
* Unit matrix
* 
* A 3x3 identity matrix of 16-bit values, where 1.0 is $4000 - i.e. an
* orientation pointing straight ahead. Nothing has been found that uses it.
unit_matrix:                                               ; >6eed
       data >4000,>0000,>0000                                        ; 
       data >0000,>4000,>0000                                        ; 
       data >0000,>0000,>4000                                        ; 

********************************************************************************
* Station indicator glyph
* 
* The 12 pixel rows of the console's "S" (space station in range)
* indicator, drawn by #R$6ADC: the first 8 into one character cell's
* pattern and the last 4 into the top of the cell below.
station_indicator_glyph:                                   ; >6eff
       byte >1F,>3F,>30,>30,>30,>3E,>1F,>03                          ; upper cell
       byte >03,>03,>3F,>3E                                          ; lower cell

********************************************************************************
* ECM indicator glyph
* 
* The 12 pixel rows of the console's "E" (ECM on) indicator, drawn by
* #R$6B12: the first 8 into one character cell's pattern and the last 4
* into the top of the cell below.
ecm_indicator_glyph:                                       ; >6f0b
       byte >1F,>1F,>18,>18,>18,>1E,>1E,>18                          ; upper cell
       byte >18,>18,>1F,>1F                                          ; lower cell

********************************************************************************
* The message "Docked!"
msg_docked:                                                ; >6f17
       text 'DOCKED!',>00

********************************************************************************
* Stardust direction vectors
* 
* An 8x8 table of direction vectors of length 63, used by #R$6805 to point
* a stardust particle's velocity. Entry (C,B), at $6F1F+2*(8*C+B), holds
* the vector (C,B) scaled up to length 63: first the X component,
* 63*C/sqrt(C^2+B^2), then the Y component, 63*B/sqrt(C^2+B^2), both
* rounded. Each line below is one value of C, for B = 0 to 7. Entry (0,0),
* which has no direction, holds (0,63) like the rest of its line.
stardust_directions:                                       ; >6f1f
       byte >00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F ; C=0
       byte >3F,>00,>2D,>2D,>1C,>38,>14,>3C,>0F,>3D,>0C,>3E,>0A,>3E,>09,>3E ; C=1
       byte >3F,>00,>38,>1C,>2D,>2D,>23,>34,>1C,>38,>17,>3A,>14,>3C,>11,>3D ; C=2
       byte >3F,>00,>3C,>14,>34,>23,>2D,>2D,>26,>32,>20,>36,>1C,>38,>19,>3A ; C=3
       byte >3F,>00,>3D,>0F,>38,>1C,>32,>26,>2D,>2D,>27,>31,>23,>34,>1F,>37 ; C=4
       byte >3F,>00,>3E,>0C,>3A,>17,>36,>20,>31,>27,>2D,>2D,>28,>30,>25,>33 ; C=5
       byte >3F,>00,>3E,>0A,>3C,>14,>38,>1C,>34,>23,>30,>28,>2D,>2D,>29,>30 ; C=6
       byte >3F,>00,>3E,>09,>3D,>11,>3A,>19,>37,>1F,>33,>25,>30,>29,>2D,>2D ; C=7

********************************************************************************
* Startup code, now the stardust table
* 
* Used by the routine at #R$0106.
* .
* The startup code, which #R$0106 calls once. It is disassembled as
* #R$6F9F@startup, from a snapshot taken before it ran. Its last job is to
* hand its own memory over to the stardust table: it stores its start
* ($6F9F) in #R$EFA6 and its end ($7044) in #R$EFA4, and #R$68CD keeps the
* 15 particles here (11 bytes each). So in this snapshot these bytes are
* the stardust table.
* .
* Each particle's 11 bytes:
* .
* #TABLE
* { =h Offset | =h Contents }
* { $00-$01 | X: the horizontal position relative to the centre of the space
* view (#R$68CD), in signed 8.8 fixed point - the high byte is the pixel
* offset, negative to the left; the view is 176 pixels across }
* { $02-$03 | Y: the vertical position, in the same format - negative
* upwards; the view is 128 pixels high }
* { $04-$05 | The X velocity: the amount added to X each time the
* particle moves, in the same format (#R$6805) }
* { $06-$07 | The Y velocity, likewise }
* { $08 | The respawn flag: $FF when the particle has left the view and
* needs a new position (#R$68CD), 0 once it has one (#R$6805) }
* { $09 | The amount added to the X velocity for each step up in the
* ship's speed, and taken away for each step down (#R$6956, #R$699C): a
* quarter of the direction vector's X component (#R$6F1F) }
* { $0A | The same for the Y velocity }
* TABLE#
* .
* The startup code:
* .
* 1. Saves HL (the address of the cockpit screen picture) in #R$F740.
* 2. Clears $D600-$EFAA.
* 3. Writes 23 JPs, 8 bytes apart from $0000, from the table of addresses
* at #R$71F2: the RST vectors (#R$0000 to #R$0038), and 15 more that
* nothing uses (see #R$003B).
* 4. Copies the pixel masks at $1187 to #R$E700.
* 5. Initialises some variables, loads the default commander (#R$A433) and
* relocates the ship blueprints (#R$7045).
* 6. Seeds the random number generator (#R$2176) from the R register.
* 7. Hands its memory over to the stardust table, as above.
* 8. Fills the explosion's table of random numbers (#R$EEC6).
* 9. Sets the sprite size to 16x16 (VDP register 1, #R$F3E0).
startup_code_stardust_table:                               ; >6f9f
       byte >00,>15,>00,>19,>28,>00,>30,>00,>00,>0A,>0C              ; particle 0
       byte >00,>37,>00,>CB,>2D,>00,>D3,>FF,>00,>0B,>F4              ; particle 1
       byte >00,>EB,>00,>1B,>D8,>FF,>30,>00,>00,>F6,>0C              ; particle 2
       byte >00,>3B,>00,>E0,>37,>00,>E1,>FF,>00,>0D,>F8              ; particle 3
       byte >00,>13,>00,>EC,>27,>00,>CF,>FF,>00,>09,>F3              ; particle 4
       byte >00,>3F,>00,>DD,>37,>00,>E1,>FF,>00,>0D,>F8              ; particle 5
       byte >00,>30,>00,>2C,>30,>00,>28,>00,>00,>0C,>0A              ; particle 6
       byte >00,>EF,>00,>16,>D9,>FF,>31,>00,>00,>F6,>0C              ; particle 7
       byte >00,>DD,>00,>2F,>D9,>FF,>31,>00,>00,>F6,>0C              ; particle 8
       byte >00,>E8,>00,>12,>CC,>FF,>23,>00,>00,>F3,>08              ; particle 9
       byte >00,>29,>00,>C7,>25,>00,>CD,>FF,>00,>09,>F3              ; particle 10
       byte >00,>CB,>00,>32,>D3,>FF,>2D,>00,>00,>F4,>0B              ; particle 11
       byte >00,>3E,>00,>35,>30,>00,>29,>00,>00,>0C,>0A              ; particle 12
       byte >00,>24,>00,>CA,>23,>00,>CC,>FF,>00,>08,>F3              ; particle 13
       byte >00,>3F,>00,>21,>37,>00,>1F,>00,>00,>0D,>07              ; particle 14

********************************************************************************
* #R$6F9F's original RET, deliberately excluded from its self-reclaimed
* range (see step 7 there: the reclaimed span is $6F9F-$7043, this byte
* is not part of it)
original_ret_deliberately_excluded_self:                   ; >7044
       .ret                                                ; RET               ; 

********************************************************************************
* Relocate the ship blueprints [startup]
* 
* Used by the routine at #R$6F9F.
* .
* The addresses in the blueprint table (#R$A7D7), and the first four words of
* each blueprint (the addresses of its vertices, edges, faces and name, see
* #R$A817), are stored as if the table were at $0100. This adds $A6D7 to each
* of them (#R$7068), skipping the empty entry 0.
relocate_blueprints:                                       ; >7045
       li   hl,>ff00                                       ; LD HL,$FF00       ; 
       li   de,ship_blueprints                             ; LD DE,$A7D7       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       mov  hl,@scratch_buffer                             ; LD ($E600),HL     ; the offset: $A7D7 - $0100
       li   hl,ship_blueprints                             ; LD HL,$A7D7       ; HL -> the blueprint table
       movb @bytes+>20,b                                   ; LD B,$20          ; 32 entries
_7054:                                                     ; >7054
       .call @relocate_word                                ; CALL $7068        ; relocate the next entry (#R$7068)
       jeq  _7065                                          ; JR Z,$7065        ; 0 - skip it
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       .ex_de_hl                                           ; EX DE,HL          ; HL -> the blueprint
       movb @bytes+>04,b                                   ; LD B,$04          ; its first 4 words
_705e:                                                     ; >705e
       .call @relocate_word                                ; CALL $7068        ; relocate them
       sb   one,b                                          ; DJNZ $705E        ; 
       jne  _705e                                          ;                   
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
_7065:                                                     ; >7065
       sb   one,b                                          ; DJNZ $7054        ; next entry
       jne  _7054                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Relocate a word [startup]
* 
* Used by the routine at #R$7045.
* .
* Adds the relocation offset (in $E600) to the word at HL, unless it's 0, and
* moves HL past it.
* 
* I:HL The word
* O:HL The next word
* O:F Z set if the word was 0
relocate_word:                                             ; >7068
       movb *hl,@e                                         ; LD E,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; DE = the word
       movb d,a                                            ; LD A,D            ; 
       socb @e,a                                           ; OR E              ; 
       jne  !                                              ; RET Z             ; 0 - return with Z set
       .ret                                                ;                   
!
       .push hl                                            ; PUSH HL           ; 
       mov  @scratch_buffer,hl                             ; LD HL,($E600)     ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = the word + the offset
       .pop hl                                             ; POP HL            ; 
       dec  hl                                             ; DEC HL            ; 
       movb d,*hl                                          ; LD (HL),D         ; 
       dec  hl                                             ; DEC HL            ; 
       movb @e,*hl                                         ; LD (HL),E         ; store it
       inc  hl                                             ; INC HL            ; 
       inc  hl                                             ; INC HL            ; HL -> the next word
       .ret                                                ; RET               ; 

********************************************************************************
* Reset the flight variables
* 
* Used by the routines at #R$1837 and #R$894D.
* .
* Called on launching (#R$1837) and on arriving in a system (#R$894D).
* Clears the flags and countdowns of the last flight: the station
* destroyed (#R$EFA9), the ECM jammer (#R$EFA8), the cloaking device
* (#R$EF9F), identify (#R$EF9D), shooting at the station ($EF97), the
* Torus jump ($EF8E, #R$E918), the police (#R$E934), the hyperspace
* countdown (#R$E91B, #R$E920), docking (#R$E917), docked (#R$E90A),
* the missile (#R$E910), the laser temperature (#R$F813), the roll and
* pitch (#R$F815, #R$F816), and more. Starts the shuttle, asteroid and
* trader countdowns (#R$EF8F-#R$EF91) at random values from 128 to 255,
* and the pirate countdown (#R$EF9A) at (government + 2) * 256. Sets the
* speed to 22 (#R$F814), the energy to 96 (#R$F817) and the shields to
* 24 (#R$F80F, #R$F810), and scatters new stardust (#R$6882).
reset_flight:                                              ; >707d
       sb   a,a                                            ; XOR A             ; 
       movb a,@station_destroyed                           ; LD ($EFA9),A      ; the station is back
       movb a,@jammer_active_flag                          ; LD ($EFA8),A      ; ECM jammer off
       movb a,@cloaking_active_flag                        ; LD ($EF9F),A      ; cloaking device off
       movb a,@identify_target                             ; LD ($EF9D),A      ; 
       movb a,@legal_status_copy                           ; LD ($EF97),A      ; the player hasn't shot at the station
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ; 
       movb a,@police_to_launch                            ; LD ($E934),A      ; no police to launch
       movb a,@message_timer                               ; LD ($E919),A      ; 
       movb a,@jump_in_progress                            ; LD ($E722),A      ; 
       movb a,@torus_jump_countdown                        ; LD ($E918),A      ; 
       movb a,@hyperspace_countdown_inner                  ; LD ($E91B),A      ; no hyperspace countdown
       movb a,@unused_flag_e91f                            ; LD ($E91F),A      ; 
       movb a,@hyperspace_trigger                          ; LD ($E920),A      ; 
       movb a,@docking                                     ; LD ($E917),A      ; not docking
       movb a,@docked                                      ; LD ($E90A),A      ; not docked
       movb a,@missile_state                               ; LD ($E910),A      ; missile unarmed
       movb a,@laser_temp_gauge                            ; LD ($F813),A      ; laser cool
       movb a,@roll_rate                                   ; LD ($F815),A      ; roll rate = 0
       movb a,@pitch_rate                                  ; LD ($F816),A      ; pitch rate = 0
       movb a,@launch_roll                                 ; LD ($E929),A      ; not rolling after launching
       movb a,@safe_zone_entry_latch                       ; LD ($EF9C),A      ; 
       li   de,shuttle_countdown                           ; LD DE,$EF8F       ; the shuttle, asteroid and trader countdowns
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 bytes
_70c2:                                                     ; >70c2
       .call @random_byte                                  ; CALL $2176        ; 
       socb @bytes+>80,a                                   ; OR $80            ; 128-255
       movb a,*de                                          ; LD (DE),A         ; 
       inc  de                                             ; INC DE            ; 
       sb   one,b                                          ; DJNZ $70C2        ; 
       jne  _70c2                                          ;                   
       movb @current_system_government,a                   ; LD A,($F762)      ; A = government
       ab   @bytes+>02,a                                   ; ADD A,$02         ; 
       movb a,@pirate_countdown_hi                         ; LD ($EF9B),A      ; the pirate countdown
       movb @bytes+>16,a                                   ; LD A,$16          ; 
       movb a,@speed_gauge_value                           ; LD ($F814),A      ; speed 22
       movb @bytes+>60,a                                   ; LD A,$60          ; 
       movb a,@energy_gauge                                ; LD ($F817),A      ; energy 96
       movb @bytes+>18,a                                   ; LD A,$18          ; 
       movb a,@fore_shield                                 ; LD ($F80F),A      ; shields 24
       movb a,@aft_shield                                  ; LD ($F810),A      ; 
       b    @scatter_stardust                              ; JP $6882          ; scatter the stardust

********************************************************************************
* Clear the screen and draw its frame
* 
* Used by the routine at #R$60B1.
* .
* Called when a text screen replaces the space view (#R$60B1). Turns the
* display off (VDP register 1), clears the pattern table, sets the colour
* table to white on black ($F1), draws the frame (#R$7161, #R$37E9), and
* turns the display back on.
clear_screen_draw_frame:                                   ; >70e8
       limi 0                                              ; DI                ; 
       movb @vdp_reg1_cache,a                              ; LD A,($F3E0)      ; 
       .push af                                            ; PUSH AF           ; 
       andi a,>bf00                                        ; AND $BF           ; display off
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; VDP register 1
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; VRAM busy
       sb   a,a                                            ; LD A,$00          ; 
       limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $0000
       ; EI                                                ; EI                ; TODO: check code. 
       movb @bytes+>18,@c                                  ; LD C,$18          ; 24 rows of the pattern table...
       sb   a,a                                            ; LD A,$00          ; 
       .call @fill_vram_256                                ; CALL $35AD        ; ...cleared
       sb   a,a                                            ; XOR A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; 
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; VRAM busy
       sb   a,a                                            ; LD A,$00          ; 
       limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>60,a                                   ; LD A,$60          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $2000
       ; EI                                                ; EI                ; TODO: check code. 
       movb @bytes+>18,@c                                  ; LD C,$18          ; 24 rows of the colour table...
       movb @bytes+>f1,a                                   ; LD A,$F1          ; 
       .call @fill_vram_256                                ; CALL $35AD        ; ...white on black
       sb   a,a                                            ; XOR A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; 
       li   hl,screen_frame                                ; LD HL,$7161       ; the frame
       .call @draw_lines                                   ; CALL $37E9        ; draw it
       .pop af                                             ; POP AF            ; 
       limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; display back on
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Draw the cockpit picture
* 
* Used by the routine at #R$63F1.
* .
* Turns the display off (bit 6 of VDP register 1, cached at $F3E0),
* decompresses the cockpit picture (#R$F740, #R$390E) - recolouring the
* space view in witchspace (#R$EEC1, #R$3A4D, colour $51) - and turns the
* display back on.
blank_screen_decompress_picture_recolour:                  ; >7139
       limi 0                                              ; DI                ; 
       movb @vdp_reg1_cache,a                              ; LD A,($F3E0)      ; A = VDP register 1 (#R$F3E0)
       .push af                                            ; PUSH AF           ; save it
       andi a,>bf00                                        ; AND $BF           ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; turn the display off
       mov  @cockpit_picture_addr,hl                       ; LD HL,($F740)     ; HL -> the cockpit picture (#R$F740)
       .call @decompress_picture                           ; CALL $390E        ; decompress it (#R$390E)
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jeq  _7157                                          ; JR Z,$7157        ; no
       movb @bytes+>51,a                                   ; LD A,$51          ; yes: colour the space view $51
       .call @colour_space_view                            ; CALL $3A4D        ; (#R$3A4D)
_7157:                                                     ; >7157
       .pop af                                             ; POP AF            ; 
       limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; turn the display back on
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Screen frame
* 
* Used by the routine at #R$70E8.
* .
* The lines drawn round text screens by #R$70E8 (see #R$37E9): a box from
* (22, 3) to (233, 188), and a line across at y = 171 above the message
* line.
screen_frame:                                              ; >7161
       byte >03,>16                                                  ; box: from (22, 3)
       byte >03,>E9                                                  ; to (233, 3)
       byte >BC,>E9                                                  ; to (233, 188)
       byte >BC,>16                                                  ; to (22, 188)
       byte >03,>16                                                  ; back to (22, 3)
       byte >FF
       byte >AB,>17                                                  ; line: from (23, 171)
       byte >AB,>E8                                                  ; to (232, 171)
       byte >FF
       byte >FF                                                      ; end of the list

********************************************************************************
* Default commander file
* 
* Used by the routine at #R$A433.
* .
* The commander file for the default commander, JAMESON: copied into the
* commander file buffer by #R$A433, and then into the variables listed
* at #R$A551 (#R$A469).
default_commander_file:                                    ; >7172
       byte >00                                                      ; galaxy number: 0
       byte >4A,>5A,>48,>02,>53,>B7                                  ; galaxy seeds
       byte >07                                                      ; current system: 7 (Lave)
       byte >03                                                      ; options: sound on, D
       byte >E8,>03,>00                                              ; cash: 1000 (100.0 credits)
       byte >00                                                      ; market random byte
       byte >2D,>31,>01,>FF                                          ; scratch buffer
       byte >46,>03,>00,>00,>81,>80,>00,>00,>00,>00,>00,>00,>80,>80,>00,>00,>00,>00,>00,>00 ; fuel 70, 3 missiles, pulse laser on the front
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00,>00,>00,>00                                          ; cargo
       byte >00                                                      ; legal status: clean
       byte >00,>00,>00                                              ; score
       byte >00                                                      ; combat rank: Harmless
       byte >00                                                      ; scratch buffer
       byte >00                                                      ; Constrictor's trail
       byte >00                                                      ; kills
       byte >01                                                      ; next mission: 1
       byte >00                                                      ; mission state: none
       byte >00                                                      ; mission system
       byte >40                                                      ; jumps to the next mission: 64
       byte >00,>00,>00,>00                                          ; game time
       byte >00,>00,>00                                              ; unused

********************************************************************************
* Jump table addresses
* 
* The addresses #R$6F9F writes as JPs at $0000, $0008, ... $00B8: the RST
* vectors' targets (#R$0000 to #R$0038), then the 15 unused ones (see
* #R$003B). Only these 8 words are here; #R$6F9F reads the other 15 from
* the start of the interrupt handler (#R$7202), whose code they are.
jump_table_addresses:                                      ; >71f2
       data print_char
       data rst_08_target_print_tokenised_string
       data rst_10_target_print_ath_tokenised
       data rst_18_target_format_value_print
       data rst_20_target_print_list_positioned
       data rst_28_target_draw_list_tile
       data ask_for_number
       data vblank_handler

********************************************************************************
* VBlank interrupt handler
* 
* Used by the routine at #R$0038.
* .
* Reached via RST $38 (#R$0038) 50 times a second. Saves all the
* registers, acknowledges the interrupt, flags that it's running
* (#R$E91E) and counts the frame (#R$E90B, #R$F748). Then:
* .
* While a hyperspace countdown is running (#R$E91B), counts it down a
* second (50 frames, #R$E91C) at a time with a beep, and when it runs out
* triggers the jump (#R$E920, see #R$894D); otherwise checks the controls
* for acceleration (#R$73BA) unless the VRAM is busy (#R$EF9E).
* .
* Counts the ECM down (#R$E912) until it stops at -1; ticks the clock
* (#R$729D); plays the sounds (#R$7645); sounds the alarm (effect 5) at
* alert level 2 (#R$E90C) unless it's already playing ($E916); unless
* the VRAM is busy, draws the scanner when it's ready (#R$EB02, #R$8380)
* and flashes parts of the screen (#R$72C1); and reads the keyboard
* (#R$347A) and joysticks (#R$7312).
vblank_handler:                                            ; >7202
       .push af                                            ; PUSH AF           ; 
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; 
       .push ix                                            ; PUSH IX           ; 
       .push iy                                            ; PUSH IY           ; 
       .exx                                                ; EXX               ; 
       .ex_af_af_                                          ; EX AF,AF'         ; 
       .push af                                            ; PUSH AF           ; 
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @vdpsta,a                                      ; IN A,($99)        ; acknowledge the interrupt
       movb one,a                                          ; LD A,$01          ; 
       movb a,@vblank_isr_progress_flag                    ; LD ($E91E),A      ; the handler is running
       li   hl,vblank_frame_counter                        ; LD HL,$E90B       ; 
       ab   one,*hl                                        ; INC (HL)          ; count the frame
       li   hl,vblank_subtick_counter                      ; LD HL,$F748       ; 
       ab   one,*hl                                        ; INC (HL)          ; 
       movb @hyperspace_countdown_inner,a                  ; LD A,($E91B)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _723f                                          ; JR Z,$723F        ; no hyperspace countdown
       li   hl,hyperspace_countdown_outer                  ; LD HL,$E91C       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer frame
       jne  _723d                                          ; JR NZ,$723D       ; not a whole second yet
       movb @bytes+>32,*hl                                 ; LD (HL),$32       ; 50 frames until the next second
       movb one,a                                          ; LD A,$01          ; 
       .call @play_sound_effect                            ; CALL $7468        ; beep
       li   hl,hyperspace_countdown_inner                  ; LD HL,$E91B       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer second
       jne  _723d                                          ; JR NZ,$723D       ; 
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@hyperspace_trigger                          ; LD ($E920),A      ; time to jump
_723d:                                                     ; >723d
       jmp  _7246                                          ; JR $7246          ; 
_723f:                                                     ; >723f
       movb @vram_busy_flag,a                              ; LD A,($EF9E)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; CALL Z,$73BA      ; check for acceleration unless the VRAM is busy
       .call @move_chart_cursor                            ;                   
!
_7246:                                                     ; >7246
       movb @ecm_countdown,a                               ; LD A,($E912)      ; A = ECM countdown
       socb a,a                                            ; OR A              ; 
       jeq  vblank_clock                                   ; JR Z,$7256        ; not running
       jhe  !                                              ; JP M,$7256        ; stopped
       b    @vblank_clock                                  ;                   
!
       sb   one,a                                          ; DEC A             ; 
       jne  _7253                                          ; JR NZ,$7253       ; 
       sb   one,a                                          ; DEC A             ; stop at -1
_7253:                                                     ; >7253
       movb a,@ecm_countdown                               ; LD ($E912),A      ; 
vblank_clock:                                              ; >7256
       .call @tick_clock                                   ; CALL $729D        ; tick the clock
       .call @play_sound_channels                          ; CALL $7645        ; play the sounds
       movb @alert_level,a                                 ; LD A,($E90C)      ; A = alert level
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jne  _726e                                          ; JR NZ,$726E       ; not 2
       movb @alarm_playing,a                               ; LD A,($E916)      ; alarm playing?
       socb a,a                                            ; OR A              ; 
       jne  _726e                                          ; JR NZ,$726E       ; the alarm is already playing
       movb @bytes+>05,a                                   ; LD A,$05          ; 
       .call @play_sound_effect                            ; CALL $7468        ; sound the alarm
_726e:                                                     ; >726e
       movb @vram_busy_flag,a                              ; LD A,($EF9E)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _7283                                          ; JR NZ,$7283       ; VRAM busy
       li   hl,scanner_queue_ready                         ; LD HL,$EB02       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _7280                                          ; JR Z,$7280        ; no new scanner picture
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       .call @scanner_draw                                 ; CALL $8380        ; draw the scanner
_7280:                                                     ; >7280
       .call @flash_screen                                 ; CALL $72C1        ; flash parts of the screen
_7283:                                                     ; >7283
       .call @read_keyboard                                ; CALL $347A        ; read the keyboard
       .call @read_joysticks_and_keys                      ; CALL $7312        ; read the joysticks
       sb   a,a                                            ; XOR A             ; 
       movb a,@vblank_isr_progress_flag                    ; LD ($E91E),A      ; the handler has finished
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; 
       .exx                                                ; EXX               ; 
       .ex_af_af_                                          ; EX AF,AF'         ; 
       .pop iy                                             ; POP IY            ; 
       .pop ix                                             ; POP IX            ; 
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; 
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Tick the clock
* 
* Used by the routine at #R$7202.
* .
* Called 50 times a second by #R$7202. Every 50 frames (#R$EF95), adds a
* second to the game time (#R$F742: seconds, minutes, hours, days),
* shown on the status page.
tick_clock:                                                ; >729d
       li   hl,ef95_clock_divider                          ; LD HL,$EF95       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       jeq  !                                              ; RET NZ            ; not a full second yet
       .ret                                                ;                   
!
       movb @bytes+>32,*hl                                 ; LD (HL),$32       ; reload: 50 ticks = 1 second
       li   hl,game_clock                                  ; LD HL,$F742       ; -> seconds
       ab   one,*hl                                        ; INC (HL)          ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>3c                                   ; CP $3C            ; rolled past 59?
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       inc  hl                                             ; INC HL            ; -> minutes
       ab   one,*hl                                        ; INC (HL)          ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>3c                                   ; CP $3C            ; rolled past 59?
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       inc  hl                                             ; INC HL            ; -> hours
       ab   one,*hl                                        ; INC (HL)          ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>18                                   ; CP $18            ; rolled past 23?
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       inc  hl                                             ; INC HL            ; 
       ab   one,*hl                                        ; INC (HL)          ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Flash parts of the screen
* 
* Used by the routine at #R$7202.
* .
* Every 25 frames (#R$E90D): with a space view showing (#R$E903), if bit
* 5 of #R$E914 is set and the speed (#R$F814) is at least 26, flashes the
* speed indicator (#R$35B8, from $31B3, see #R$6A59) as an overspeed
* warning. Then, every frame, on the status page (#R$E902 = 3) with an
* alert (#R$E90C), flashes the condition by toggling the colour of a
* 64-byte run of the colour table (at $2590).
flash_screen:                                              ; >72c1
       li   hl,alert_flash_countdown                       ; LD HL,$E90D       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       jeq  !                                              ; RET NZ            ; not time yet
       .ret                                                ;                   
!
       movb @bytes+>19,*hl                                 ; LD (HL),$19       ; 25 frames until the next time
       movb @space_view_showing,a                          ; LD A,($E903)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _72ee                                          ; JR Z,$72EE        ; no space view showing
       movb @options,a                                     ; LD A,($E914)      ; 
       czc  @bit5,a                                        ; BIT 5,A           ; 
       jeq  _72ee                                          ; JR Z,$72EE        ; 
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = speed
       cb   a,@bytes+>1a                                   ; CP $1A            ; 
       jl   _72ee                                          ; JR C,$72EE        ; under 26
       movb @e913_status_toggle,a                          ; LD A,($E913)      ; 
       li   r0,48*256                                      ; XOR $30           ; toggle the flash
       xor  r0,a                                           ;                   
       movb a,@e913_status_toggle                          ; LD ($E913),A      ; 
       li   hl,>31b3                                       ; LD HL,$31B3       ; HL -> the warning tile's source data
       movb a,@e                                           ; LD E,A            ; 
       li   bc,>0403                                       ; LD BC,$0403       ; 
       .call @fill_vram_rect                               ; CALL $35B8        ; flash the speed indicator
_72ee:                                                     ; >72ee
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,@bytes+>03                                   ; CP $03            ; the status page?
       jne  _7311                                          ; JR NZ,$7311       ; 
       movb @alert_level,a                                 ; LD A,($E90C)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _7311                                          ; JR Z,$7311        ; no alert
       movb @bytes+>90,a                                   ; LD A,$90          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>65,a                                   ; LD A,$65          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $2590
       li   hl,vram_flash_toggle                           ; LD HL,$E90E       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       li   r0,144*256                                     ; XOR $90           ; toggle the colour
       xor  r0,a                                           ;                   
       movb a,*hl                                          ; LD (HL),A         ; 
       movb @bytes+>40,b                                   ; LD B,$40          ; 64 bytes
_730c:                                                     ; >730c
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       nop                                                 ; NOP               ; 
       sb   one,b                                          ; DJNZ $730C        ; 
       jne  _730c                                          ;                   
_7311:                                                     ; >7311
       .ret                                                ; RET               ; 

********************************************************************************
* Read the joysticks and control keys
* 
* Used by the routine at #R$7202.
* .
* Called on every VBlank. Builds ($E8F4), the flight/cursor control bits
* (0 = pressed): bit 0 up, 1 down, 2 left, 3 right, 4 fire. Each bit
* combines either joystick (read through the PSG, ports 1 and 2), the
* cursor keys (keyboard row 8), and the classic Elite keys from the table
* at #R$73F2 - 'S' (up), 'X' (down), ',' (left), '.' (right) and 'A'
* (fire) - with SHIFT (row 6) also firing.
* 
* O:($E8F4) The control bits
read_joysticks_and_keys:                                   ; >7312
       movb @bytes+>8f,@e                                  ; LD E,$8F          ; 
       movb @b255,@c                                       ; LD C,$FF          ; 
       movb @bytes+>02,b                                   ; LD B,$02          ; 2 passes: joystick 1, then joystick 2
_7318:                                                     ; >7318
       movb @bytes+>0f,a                                   ; LD A,$0F          ; 
       ; OUT ($A0),A                                       ; OUT ($A0),A       ; TODO: check code. select PSG I/O port B
       movb @e,a                                           ; LD A,E            ; 
       ; OUT ($A1),A                                       ; OUT ($A1),A       ; TODO: check code. write it, toggling which joystick is selected
       movb @bytes+>0e,a                                   ; LD A,$0E          ; 
       ; OUT ($A0),A                                       ; OUT ($A0),A       ; TODO: check code. select PSG I/O port A
       ; IN A,($A2)                                        ; IN A,($A2)        ; TODO: check code. read the joystick data bits
       ; AND C                                             ; AND C             ; TODO: check code. 
       movb a,@c                                           ; LD C,A            ; accumulate across both passes
       movb @e,a                                           ; LD A,E            ; 
       li   r0,64*256                                      ; XOR $40           ; flip the joystick-select bit for the next pass
       xor  r0,a                                           ;                   
       movb a,@e                                           ; LD E,A            ; 
       sb   one,b                                          ; DJNZ $7318        ; 
       jne  _7318                                          ;                   
       ; IN A,($AA)                                        ; IN A,($AA)        ; TODO: check code. 
       andi a,>f000                                        ; AND $F0           ; 
       movb a,d                                            ; LD D,A            ; D = the row-select nibble (upper 4 bits), preserved
       socb @bytes+>08,a                                   ; OR $08            ; select matrix row 8
       ; OUT ($AA),A                                       ; OUT ($AA),A       ; TODO: check code. 
       ; IN A,($A9)                                        ; IN A,($A9)        ; TODO: check code. B = row 8's column byte
       movb a,b                                            ; LD B,A            ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       socb @bytes+>fb,a                                   ; OR $FB            ; cursor left -> bit 2
       movb a,@e                                           ; LD E,A            ; 
       movb b,a                                            ; LD A,B            ; 
       sra  a,1                                            ; SRA A             ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       socb @bytes+>f4,a                                   ; OR $F4            ; cursor up, down, right -> bits 0, 1, 3
       ; AND E                                             ; AND E             ; TODO: check code. 
       ; AND C                                             ; AND C             ; TODO: check code. 
       movb a,@c                                           ; LD C,A            ; fold them in
       movb d,a                                            ; LD A,D            ; 
       socb @bytes+>06,a                                   ; OR $06            ; keyboard row 6
       ; OUT ($AA),A                                       ; OUT ($AA),A       ; TODO: check code. 
       ; IN A,($A9)                                        ; IN A,($A9)        ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. SHIFT?
       joc  _7356                                          ; JR C,$7356        ; TODO: check code. no
       szcb @bit4,@c                                       ; RES 4,C           ; yes - fire
_7356:                                                     ; >7356
       li   hl,control_keys                                ; LD HL,$73F2       ; HL -> the key table
       movb @b255,@e                                       ; LD E,$FF          ; 
       movb @bytes+>05,b                                   ; LD B,$05          ; 5 keys
_735d:                                                     ; >735d
       movb *hl,a                                          ; LD A,(HL)         ; A = this entry's row-select byte
       inc  hl                                             ; INC HL            ; 
       socb d,a                                            ; OR D              ; 
       ; OUT ($AA),A                                       ; OUT ($AA),A       ; TODO: check code. 
       ; IN A,($A9)                                        ; IN A,($A9)        ; TODO: check code. 
       ; AND (HL)                                          ; AND (HL)          ; TODO: check code. test this entry's column mask
       inc  hl                                             ; INC HL            ; 
       jeq  _7369                                          ; JR Z,$7369        ; pressed (bit is 0) - shift in 0
       ; SCF                                               ; SCF               ; TODO: check code. not pressed - shift in 1
_7369:                                                     ; >7369
       ; RL E                                              ; RL E              ; TODO: check code. E = A . , X S in bits 4-0
       sb   one,b                                          ; DJNZ $735D        ; 
       jne  _735d                                          ;                   
       movb @c,a                                           ; LD A,C            ; 
       ; AND E                                             ; AND E             ; TODO: check code. combine them
       movb a,@control_bits                                ; LD ($E8F4),A      ; store the control bits
       .ret                                                ; RET               ; 

********************************************************************************
* Step one axis's cursor position, accelerating towards its limit
* 
* Used by the routine at #R$73BA.
* .
* Looks up a per-direction record in the table at $73FC (indexed by C, from
* #R$73CE): a pointer to the axis coordinate to move (#R$E709's high or low
* byte) and a limit value right after it. If already at the limit, returns
* without moving. Otherwise, depending on a flag byte one further on, moves
* down (at $7396) or up towards the limit by #R$E708 (the acceleration
* counter #R$73BA resets to 1 when no direction is held), clamping at the
* limit either way, then stores the new coordinate and moves the sprite
* there (#R$73A6).
step_axis_accelerate_towards_limit:                        ; >7373
       .ex_af_af_                                          ; EX AF,AF'         ; stash the caller's A
       .push bc                                            ; PUSH BC           ; 
       li   hl,chart_cursor_nudge_table                    ; LD HL,$73FC       ; the per-direction record table
       sb   b,b                                            ; LD B,$00          ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this direction's record
       movb *hl,@e                                         ; LD E,(HL)         ; DE -> the axis coordinate to move
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; HL -> the limit value
       movb *de,a                                          ; LD A,(DE)         ; A = the current coordinate
       cb   a,*hl                                          ; CP (HL)           ; already at the limit?
       jeq  _73a3                                          ; JR Z,$73A3        ; yes - nothing to do
       movb a,@c                                           ; LD C,A            ; C = the current coordinate
       movb @chart_cursor_step_tier,a                      ; LD A,($E708)      ; A = the acceleration counter
       inc  hl                                             ; INC HL            ; HL -> the direction flag byte
       movb *hl,r0                                         ; BIT 7,(HL)        ; which way does this axis move?
       andi r0,>8000                                       ;                   
       dec  hl                                             ; DEC HL            ; HL -> the limit value again
       jne  step_axis_accelerate_other_way                 ; JR NZ,$7396       ; the other way
       ab   @c,a                                           ; ADD A,C           ; this way: accelerate towards the limit
       joc  _7393                                          ; JR C,$7393        ; TODO: check code. overflowed - clamp to the limit
       cb   a,*hl                                          ; CP (HL)           ; past the limit?
       jl   _7394                                          ; JR C,$7394        ; no - keep the accelerated value
_7393:                                                     ; >7393
       movb *hl,a                                          ; LD A,(HL)         ; yes - clamp to the limit
_7394:                                                     ; >7394
       jmp  _739f                                          ; JR $739F          ; 
step_axis_accelerate_other_way:                            ; >7396
       neg a                                               ; NEG               ; negate the acceleration counter
       ab   @c,a                                           ; ADD A,C           ; accelerate towards the limit
       jnc  _739e                                          ; JR NC,$739E       ; TODO: check code. underflowed - clamp to the limit
       cb   a,*hl                                          ; CP (HL)           ; past the limit?
       jhe  _739f                                          ; JR NC,$739F       ; no - keep the accelerated value
_739e:                                                     ; >739e
       movb *hl,a                                          ; LD A,(HL)         ; yes - clamp to the limit
_739f:                                                     ; >739f
       movb a,*de                                          ; LD (DE),A         ; store the new coordinate
       .call @move_chart_cursor_sprite                     ; CALL $73A6        ; move the sprite there
_73a3:                                                     ; >73a3
       .ex_af_af_                                          ; EX AF,AF'         ; recover the caller's A
       .pop bc                                             ; POP BC            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Move sprite 0 to the cursor position $E709
* 
* Used by the routines at #R$540D and #R$7373.
move_chart_cursor_sprite:                                  ; >73a6
       movb @bytes+>10,a                                   ; LD A,$10          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb @bytes+>5b,a                                   ; LD A,$5B          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, write mode: $1B00 (sprite attribute table)
       mov  @chart_cursor_x,hl                             ; LD HL,($E709)     ; the cursor position
       movb h,a                                            ; LD A,H            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; sprite 0's Y
       nop                                                 ; NOP               ; 
       nop                                                 ; NOP               ; 
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; sprite 0's X
       .ret                                                ; RET               ; 

********************************************************************************
* Move the chart cursor with the direction keys
* 
* Used by the routine at #R$7202.
* .
* Does nothing unless the chart cursor is on (#R$E70B). If no direction is
* held (the low 4 bits of #R$E8F4, active low), resets the cursor's speed
* (#R$E708) to 1; otherwise (at $73CE) moves the cursor for each direction
* held (#R$7373, with C = 0, 4, 8 or 12).
move_chart_cursor:                                         ; >73ba
       movb @chart_cursor_active_flag,a                    ; LD A,($E70B)      ; A = the cursor-active flag
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; clear - nothing to do
       .ret                                                ;                   
!
       movb @control_bits,a                                ; LD A,($E8F4)      ; A = this frame's control-input byte
       andi a,>0f00                                        ; AND $0F           ; 
       cb   a,@bytes+>0f                                   ; CP $0F            ; no direction held?
       jne  move_cursor_for_each_direction_held            ; JR NZ,$73CE       ; a direction is held - move the cursor instead
       movb one,a                                          ; LD A,$01          ; 
       movb a,@chart_cursor_step_tier                      ; LD ($E708),A      ; reset the acceleration counter
       .ret                                                ; RET               ; 
move_cursor_for_each_direction_held:                       ; >73ce
       movb a,b                                            ; LD B,A            ; B = this frame's control-input byte
       sb   @c,@c                                          ; LD C,$00          ; C = the first direction's index
_73d1:                                                     ; >73d1
       sra  b,1                                            ; RR B              ; TODO: check code. test the next direction bit
       joc  _73d8                                          ; JR C,$73D8        ; TODO: check code. not held - skip it
       .call @step_axis_accelerate_towards_limit           ; CALL $7373        ; held - move that axis
_73d8:                                                     ; >73d8
       movb @c,a                                           ; LD A,C            ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; -> the next direction's index
       movb a,@c                                           ; LD C,A            ; 
       andi a,>1000                                        ; AND $10           ; all 4 directions tested?
       jeq  _73d1                                          ; JR Z,$73D1        ; no - test the next one
       li   hl,chart_cursor_countdown                      ; LD HL,$E70C       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       jne  _73f1                                          ; JR NZ,$73F1       ; 
       movb @bytes+>07,*hl                                 ; LD (HL),$07       ; 
       li   hl,chart_cursor_step_tier                      ; LD HL,$E708       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jhe  _73f1                                          ; JR NC,$73F1       ; 
       ab   one,*hl                                        ; INC (HL)          ; 
_73f1:                                                     ; >73f1
       .ret                                                ; RET               ; 

********************************************************************************
* Control keys
* 
* Five (row, column mask) pairs for the keys #R$7312 reads into the
* control bits: 'A' (fire), '.' (right), ',' (left), 'X' (down) and 'S'
* (up).
control_keys:                                              ; >73f2
       byte >02,>40,>02,>08,>02,>04,>05,>20,>05,>01

********************************************************************************
* Chart-cursor nudge table: {pointer, target, direction} per entry
* 
* Read by #R$7373 (via `ADD HL,BC` with BC = 0/4/8/12, i.e. 4 rows of
* 4 bytes), indexed by #R$73CE's per-bit loop over the directional
* nibble from ($E8F4). Each row: a word pointing at #R$E709 or
* #R$E70A, a target byte, and a direction byte (only its sign bit
* matters - negative nudges down towards the target, non-negative
* nudges up). Row 0/1 both target #R$E70A (toward $00 or $9F); row 2/3
* both target #R$E709 (toward $11 or $E0) - see #R$E708's/#R$E709's
* descriptions for the cursor mechanism this drives.
chart_cursor_nudge_table:                                  ; >73fc
       data chart_cursor_y
       byte >00,>FF
       data chart_cursor_y
       byte >9F,>01
       data chart_cursor_x
       byte >11,>FF
       data chart_cursor_x
       byte >E0,>01

********************************************************************************
* End a sound effect
* 
* Used by the routines at #R$74A6, #R$74AE, #R$773E, #R$776B, #R$7791, #R$77B4,
* #R$77DB, #R$77FB, #R$782B, #R$7881, #R$78A7, #R$78FE, #R$798A and #R$79B9.
* .
* Turns the channel's noise off, writes its volume if command 9 has just set
* up the envelope (#R$E8A1), clears its "playing" flag (#R$E89C), marks the
* channel inactive (#R$E894) and sets its tone period to 0.
end_sound_effect:                                          ; >740c
       .call @channel_noise_bit                            ; CALL $748A        ; A = the mixer, C = the channel's noise bit (#R$748A)
       socb @c,a                                           ; OR C              ; turn the channel's noise off
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>07,a                                   ; LD A,$07          ; mixer
       .call @write_psg_register                           ; CALL $751D        ; write it
       movb @sound_channel_envelope_flag,a                 ; LD A,($E8A1)      ; envelope just set up (#R$E8A1)?
       socb a,a                                            ; OR A              ; 
       jeq  _7423                                          ; JR Z,$7423        ; no
       sb   a,a                                            ; XOR A             ; 
       movb a,@sound_channel_envelope_flag                 ; LD ($E8A1),A      ; clear the flag
       .call @cache_write_channel_data_byte_sound          ; CALL $74EC        ; and write the volume (#R$74EC)
_7423:                                                     ; >7423
       mov  @sound_channel_duration,hl                     ; LD HL,($E89C)     ; HL = the address of the effect's "playing" flag
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; 
       jeq  _7431                                          ; JR Z,$7431        ; none
       sb   *hl,*hl                                        ; LD (HL),$00       ; clear the flag
       s    hl,hl                                          ; SBC HL,HL         ; 
       mov  hl,@sound_channel_duration                     ; LD ($E89C),HL     ; and forget it
_7431:                                                     ; >7431
       sb   a,a                                            ; XOR A             ; 
       movb a,@sound_channel_active                        ; LD ($E894),A      ; the channel is inactive
       b    @write_16_bit_tone_period_psg                  ; JP $74F6          ; tone period 0 (HL = 0)

********************************************************************************
* Stop all sound
* 
* Used by the routines at #R$0106 and #R$1C5C.
* .
* Called when the game ends (#R$0106) and when Y or N is pressed on the
* title screen (#R$1DB5). If sound effects are playing (($E8D6) = $FF),
* clears the "playing" flag of each effect still running - the byte that
* its script's command 1 (#R$755E) pointed at and set - so that nothing is
* left waiting for it. Then silences the PSG (#R$752C) and sets the sound
* mode ($E8D6) to 0 (no sound).
stop_all_sound:                                            ; >7438
       limi 0                                              ; DI                ; 
       movb @sound_mode,a                                  ; LD A,($E8D6)      ; A = sound mode
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$745F        ; not playing sound effects
       b    @stop_all_sound_silence                        ;                   
!
       li   ix,sound_channel_records                       ; LD IX,$E8A3       ; IX -> the 3 channels
       li   de,>000f                                       ; LD DE,$000F       ; 
       movb @bytes+>03,b                                   ; LD B,$03          ; 
_7449:                                                     ; >7449
       movb *ix,a                                          ; LD A,(IX+$00)     ; is this channel playing?
       socb a,a                                            ; OR A              ; 
       jeq  _745b                                          ; JR Z,$745B        ; no
       movb @>08(ix),@l                                    ; LD L,(IX+$08)     ; 
       movb @>09(ix),h                                     ; LD H,(IX+$09)     ; HL = address of its effect's playing flag
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; 
       jeq  _745b                                          ; JR Z,$745B        ; none
       sb   *hl,*hl                                        ; LD (HL),$00       ; clear the flag
_745b:                                                     ; >745b
       a    de,ix                                          ; ADD IX,DE         ; next channel
       sb   one,b                                          ; DJNZ $7449        ; 
       jne  _7449                                          ;                   
stop_all_sound_silence:                                    ; >745f
       .call @silence_psg                                  ; CALL $752C        ; silence the PSG
       sb   a,a                                            ; XOR A             ; 
       movb a,@sound_mode                                  ; LD ($E8D6),A      ; sound mode 0: none
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Play a sound effect
* 
* Used by the routines at #R$16FE, #R$1703, #R$193F, #R$19FC, #R$25B9, #R$26A9,
* #R$28F6, #R$2A3A, #R$2AD0, #R$2D7E, #R$3223, #R$323C, #R$329E, #R$35E7,
* #R$3A3C, #R$401C, #R$40DE, #R$46CA, #R$6CB2, #R$7202, #R$86E6, #R$8755,
* #R$894D and #R$8BA6.
* .
* Called from all over the game. Does nothing if sound is turned off (bit
* 0 of ($E914), toggled by 'S' on the pause screen). Otherwise stops any
* music by switching to sound-effect mode (#R$75C3), looks up effect A in
* the table at $7AC6 (the last 15 entries of #R$7AAE), claims a channel
* for it (#R$74AE, which takes over a busy channel in rotation if none
* is free) and starts it. Runs in the alternate register set so as not to
* disturb the caller's registers.
* .
* The effects, as far as their callers show: 0 click, 1 (#R$4735,
* #R$7202), 2 explosion, 3 laser, 4 (#R$193F, #R$323C), 5 (#R$7202), 6
* beep, 7 (#R$6CB2), 8 ECM, 9 (#R$2A3A), 10 Torus Jump Drive, 11 launch
* (missile or escape capsule), 12 hyperspace, 13 cargo scooped, 14 not
* used.
* 
* I:A Effect number (0-14)
play_sound_effect:                                         ; >7468
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb @options,a                                     ; LD A,($E914)      ; 
       andi a,>0100                                        ; AND $01           ; 
       jne  !                                              ; RET Z             ; sound off
       .ret                                                ;                   
!
       .exx                                                ; EXX               ; 
       .call @sound_effect_mode                            ; CALL $75C3        ; switch to sound-effect mode
       .ex_af_af_                                          ; EX AF,AF'         ; 
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,sound_effect_table                          ; LD HL,$7AC6       ; HL -> the effect table
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL = the effect's routine
       .push hl                                            ; PUSH HL           ; 
       .call @claim_sound_channel                          ; CALL $74AE        ; claim a channel
       .pop hl                                             ; POP HL            ; 
       .call @jump_to_hl                                   ; CALL $769A        ; start the effect
       .exx                                                ; EXX               ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Get the channel's noise bit in the PSG mixer
* 
* Used by the routines at #R$740C and #R$749C.
* .
* The channel's amplitude register ($E896) is 8, 9 or 10 for channels A,
* B and C, and its noise bit in the mixer (register 7) is bit 3, 4 or 5
* (set to turn the noise off).
* 
* O:A The mixer's value (#R$E8D7)
* O:B The noise bit's mask
* O:C The noise bit
channel_noise_bit:                                         ; >748a
       movb @sound_channel_volume_register,a               ; LD A,($E896)      ; A = amplitude register (8-10)
       sb   @bytes+>07,a                                   ; SUB $07           ; 
       movb a,b                                            ; LD B,A            ; B = 1-3
       movb @bytes+>04,a                                   ; LD A,$04          ; 
_7492:                                                     ; >7492
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $7492        ; 
       jne  _7492                                          ;                   
       movb a,@c                                           ; LD C,A            ; C = $08, $10 or $20
       inv  a                                              ; CPL               ; 
       movb a,b                                            ; LD B,A            ; B = the mask
       movb @psg_mixer_copy,a                              ; LD A,($E8D7)      ; A = the mixer's value
       .ret                                                ; RET               ; 

********************************************************************************
* Turn the channel's noise on
* 
* Used by the routines at #R$78A7 and #R$793B.
* .
* Clears the channel's noise bit (#R$748A) in the PSG mixer (register 7,
* #R$751D). Also sound command 8 (#R$7AAE).
sound_cmd_noise_on:                                        ; >749c
       .call @channel_noise_bit                            ; CALL $748A        ; 
       ; AND B                                             ; AND B             ; TODO: check code. clear the channel's noise bit
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>07,a                                   ; LD A,$07          ; mixer
       b    @write_psg_register                            ; JP $751D          ; write it

********************************************************************************
* Sound effects 0 and 1: per-frame handler
* 
* Counts #R$E897 down, and ends the effect (#R$740C) when it reaches 0.
sound_effects_0_1_handler:                                 ; >74a6
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       jne  !                                              ; JP Z,$740C        ; 
       b    @end_sound_effect                              ;                   
!
       .ret                                                ; RET               ; 

********************************************************************************
* Claim a sound channel for a sound effect
* 
* Used by the routine at #R$7468.
* .
* Looks for an inactive channel (#R$E8A3). If there isn't one, takes over
* one of the busy channels in rotation (#R$E8D5), skipping any whose effect
* has used command 11 (#R$E8A2), and ends the effect it was playing
* (#R$740C). Then copies the channel's record into the channel context at
* #R$E894, remembering its address in $E8D3 for #R$7505.
claim_sound_channel:                                       ; >74ae
       limi 0                                              ; DI                ; 
       li   hl,sound_channel_records                       ; LD HL,$E8A3       ; HL -> the first channel's record
       li   de,>000f                                       ; LD DE,$000F       ; 15 bytes a record
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 channels
_74b7:                                                     ; >74b7
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _74d9                                          ; JR Z,$74D9        ; inactive - use it
       a    de,hl                                          ; ADD HL,DE         ; next channel
       sb   one,b                                          ; DJNZ $74B7        ; 
       jne  _74b7                                          ;                   
_74be:                                                     ; >74be
       li   hl,sound_channel_rotation                      ; LD HL,$E8D5       ; all busy: HL -> the rotation counter
       movb *hl,b                                          ; LD B,(HL)         ; 
       ab   one,b                                          ; INC B             ; B = the counter + 1 (1-3)
       sb   one,*hl                                        ; DEC (HL)          ; 
       jlt  !                                              ; JP P,$74C9        ; 
       b    @claim_sound_channel_busy                      ;                   
!
       movb @bytes+>02,*hl                                 ; LD (HL),$02       ; the counter goes 2, 1, 0, 2, ...
claim_sound_channel_busy:                                  ; >74c9
       li   hl,sound_channel_active                        ; LD HL,$E894       ; 
_74cc:                                                     ; >74cc
       a    de,hl                                          ; ADD HL,DE         ; HL -> channel B's record ($E894 + 15 * B)
       sb   one,b                                          ; DJNZ $74CC        ; 
       jne  _74cc                                          ;                   
       .ex_de_hl                                           ; EX DE,HL          ; DE -> the record
       li   hl,>000e                                       ; LD HL,$000E       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = its "don't take over" flag (offset 14, #R$E8A2)
       socb a,a                                            ; OR A              ; 
       jne  _74be                                          ; JR NZ,$74BE       ; set - try the next channel
       .ex_de_hl                                           ; EX DE,HL          ; HL -> the record
_74d9:                                                     ; >74d9
       mov  hl,@active_channel_record                      ; LD ($E8D3),HL     ; remember which channel it is
       li   bc,>000f                                       ; LD BC,$000F       ; 
       li   de,sound_channel_active                        ; LD DE,$E894       ; 
       .ldir                                               ; LDIR              ; copy it into the channel context (#R$E894)
       movb @sound_channel_active,a                        ; LD A,($E894)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; CALL NZ,$740C     ; if it was playing, end its effect (#R$740C)
       .call @end_sound_effect                             ;                   
!
       .ret                                                ; RET               ; 

********************************************************************************
* Cache and write a channel data byte via #R$751D [sound]
* 
* Used by the routines at #R$740C, #R$7576, #R$758F, #R$773E, #R$77FB, #R$78A7,
* #R$78FE, #R$798A, #R$79B9 and #R$79EB.
* .
* Caches A to $E898, then writes it to PSG register ($E896) via
* #R$751D. Part of the sound-effect/music command interpreter around
* #R$753F.
cache_write_channel_data_byte_sound:                       ; >74ec
       movb a,@sound_channel_last_data                     ; LD ($E898),A      ; 
       movb a,@c                                           ; LD C,A            ; 
       movb @sound_channel_volume_register,a               ; LD A,($E896)      ; 
       b    @write_psg_register                            ; JP $751D          ; 

********************************************************************************
* Write a 16-bit tone period to PSG registers ($E895)/($E895)+1 [sound]
* 
* Used by the routines at #R$740C, #R$756A, #R$769B, #R$776B, #R$77B4, #R$77DB,
* #R$77FB, #R$782B, #R$78A7, #R$78FE, #R$793B and #R$798A.
* .
* Writes L to PSG register ($E895) via #R$751D, then H to register
* ($E895)+1 - the standard fine/coarse tone-period pair. Part of the
* sound-effect/music command interpreter around #R$753F.
write_16_bit_tone_period_psg:                              ; >74f6
       movb @sound_channel_tone_register,a                 ; LD A,($E895)      ; 
       movb @l,@c                                          ; LD C,L            ; 
       .call @write_psg_register                           ; CALL $751D        ; 
       movb @sound_channel_tone_register,a                 ; LD A,($E895)      ; 
       ab   one,a                                          ; INC A             ; 
       movb h,@c                                           ; LD C,H            ; 
       b    @write_psg_register                            ; JP $751D          ; 

********************************************************************************
* Save the active sound channel back to its record
* 
* Used by the routines at #R$770B, #R$771E, #R$772F, #R$7758, #R$777E, #R$77A2,
* #R$77CA, #R$77EE, #R$7815, #R$7872, #R$7892, #R$78ED, #R$7926, #R$7977,
* #R$79A8 and #R$79DA.
* .
* Marks the channel active ($E894 = $FF) and copies its fields at #R$E894
* back to its record (#R$E8A3), whose address #R$74AE left at #R$E8D3 when
* it copied the record the other way. Re-enables interrupts unless #R$E91E
* is set. Used by the sound effect commands (see #R$753F).
save_active_sound_channel_context_back:                    ; >7505
       movb @b255,a                                        ; LD A,$FF          ; the channel is active
       movb a,@sound_channel_active                        ; LD ($E894),A      ; 
       li   hl,sound_channel_active                        ; LD HL,$E894       ; 
       mov  @active_channel_record,de                      ; LD DE,($E8D3)     ; DE -> the channel's record (#R$E8D3)
       li   bc,>000f                                       ; LD BC,$000F       ; 
       .ldir                                               ; LDIR              ; copy the channel context back to it
       movb @vblank_isr_progress_flag,a                    ; LD A,($E91E)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; leave interrupts off if #R$E91E is set
       .ret                                                ;                   
!
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Write a PSG (AY-3-8910) sound register
* 
* Used by the routines at #R$740C, #R$749C, #R$74EC, #R$74F6, #R$752C, #R$758F,
* #R$75A8, #R$7603, #R$773E, #R$7791, #R$7881, #R$78A7, #R$78FE, #R$79B9 and
* #R$79EB.
* .
* Selects register A via port $A0, then writes C's value to it via
* port $A1 - except for register 7 (the mixer/enable register), whose
* data also gets cached at $E8D7, since PSG registers are write-only
* and can't be read back directly.
* 
* I:A PSG register number
* I:C Value to write
write_psg_register:                                        ; >751d
       .push bc                                            ; PUSH BC           ; 
       ; OUT ($A0),A                                       ; OUT ($A0),A       ; TODO: check code. select the PSG register
       cb   a,@bytes+>07                                   ; CP $07            ; the mixer?
       movb @c,a                                           ; LD A,C            ; 
       jne  _7528                                          ; JR NZ,$7528       ; no
       movb a,@psg_mixer_copy                              ; LD ($E8D7),A      ; yes: keep a copy of it
_7528:                                                     ; >7528
       ; OUT ($A1),A                                       ; OUT ($A1),A       ; TODO: check code. write the value
       .pop bc                                             ; POP BC            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Silence the PSG: zero registers 11 down to 0 (7 forced to $B8)
* 
* Used by the routines at #R$7438 and #R$75CD.
* .
* Writes 0 to PSG registers 11-0 via #R$751D, except register 7 (the
* mixer register), which gets $B8 - all three tone/noise channels
* disabled.
silence_psg:                                               ; >752c
       movb @bytes+>0b,b                                   ; LD B,$0B          ; start at register 11
silence_psg_register:                                      ; >752e
       movb b,a                                            ; LD A,B            ; 
       sb   @c,@c                                          ; LD C,$00          ; 0 for every register...
       cb   a,@bytes+>07                                   ; CP $07            ; 
       jne  _7537                                          ; JR NZ,$7537       ; 
       movb @bytes+>b8,@c                                  ; LD C,$B8          ; ...except the mixer (7), $B8: all tones and noise off
_7537:                                                     ; >7537
       .call @write_psg_register                           ; CALL $751D        ; write it (#R$751D)
       sb   one,b                                          ; DEC B             ; 
       jlt  !                                              ; JP P,$752E        ; next register, down to 0
       b    @silence_psg_register                          ;                   
!
       .ret                                                ; RET               ; 

********************************************************************************
* Sound-effect/music command interpreter loop
* 
* Used by the routines at #R$770B, #R$771E, #R$772F, #R$7758, #R$777E, #R$77A2,
* #R$77CA, #R$7815, #R$7872, #R$7892, #R$78ED, #R$7926, #R$793B, #R$7977,
* #R$79A8 and #R$79DA.
* .
* Reads a command byte from (DE), doubles it as an index into a
* jump table at #R$7AAE, and calls the looked-up handler via #R$769A -
* the dispatch core for the whole cluster of channel-write helpers
* around #R$74EC/#R$74F6/#R$751D. Loops for the next command byte.
sound_effect_music_command_interpreter_loop:               ; >753f
       .pop de                                             ; POP DE            ; DE -> the script (after the effect's CALL $753F)
_7540:                                                     ; >7540
       movb *de,a                                          ; LD A,(DE)         ; A = the next command
       inc  de                                             ; INC DE            ; 
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; BC = command * 2
* @label=*
_7546:                                                     ; >7546
       li   hl,sound_command_table                         ; LD HL,$7AAE       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> its entry in #R$7AAE
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL = the command's routine
       .call @jump_to_hl                                   ; CALL $769A        ; run it (#R$769A)
       jmp  _7540                                          ; JR $7540          ; next command

********************************************************************************
* Sound command 0: set the per-frame handler
* 
* Reads an address from the script into #R$E899: the routine #R$7645 calls
* every tick while the effect plays.
sound_cmd_handler_00:                                      ; >7553
       movb *de,a                                          ; LD A,(DE)         ; 
       inc  de                                             ; INC DE            ; 
       movb a,@sound_channel_data_pointer                  ; LD ($E899),A      ; 
       movb *de,a                                          ; LD A,(DE)         ; 
       inc  de                                             ; INC DE            ; 
       movb a,@sound_channel_handler_hi                    ; LD ($E89A),A      ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Sound command 1: set a "playing" flag
* 
* Reads an address from the script, stores it in the channel ($E89C)
* and writes $FF there. The flag is cleared when the effect ends ($7423 in
* #R$740C) or all sound is stopped (#R$7438), so that the code that set
* it off can tell when it has finished.
sound_cmd_playing_flag:                                    ; >755e
       .ex_de_hl                                           ; EX DE,HL          ; HL -> the script
       movb *hl,@e                                         ; LD E,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; DE = the flag's address
       .ex_de_hl                                           ; EX DE,HL          ; HL = the flag's address, DE -> the script
       mov  hl,@sound_channel_duration                     ; LD ($E89C),HL     ; remember it
       movb @b255,*hl                                      ; LD (HL),$FF       ; set the flag
       .ret                                                ; RET               ; 

********************************************************************************
* Sound command 2: set the tone period
* 
* Reads a word from the script into #R$E89F and writes it to the PSG
* (#R$74F6).
sound_cmd_handler_02:                                      ; >756a
       movb *de,a                                          ; LD A,(DE)         ; 
       inc  de                                             ; INC DE            ; 
       movb a,@l                                           ; LD L,A            ; 
       movb *de,a                                          ; LD A,(DE)         ; 
       inc  de                                             ; INC DE            ; 
       movb a,h                                            ; LD H,A            ; HL = the tone period from the script
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; 
       b    @write_16_bit_tone_period_psg                  ; JP $74F6          ; set it (#R$74F6)

********************************************************************************
* Sound command 3: set the volume
* 
* Reads a byte from the script and writes it to the channel's volume register
* (#R$74EC).
sound_cmd_handler_03:                                      ; >7576
       movb *de,a                                          ; LD A,(DE)         ; 
       inc  de                                             ; INC DE            ; 
       b    @cache_write_channel_data_byte_sound           ; JP $74EC          ; 

********************************************************************************
* Sound command 4: set the countdown
* 
* Reads a byte from the script into #R$E897. The entry at $757E stores the
* byte at HL, for commands 5 and 6.
sound_cmd_handler_04:                                      ; >757b
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
* This entry point is used by the routines at #R$7582 and #R$7587.
_757e:                                                     ; >757e
       movb *de,a                                          ; LD A,(DE)         ; 
       movb a,*hl                                          ; LD (HL),A         ; 
       inc  de                                             ; INC DE            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Sound command 5: set the parameter
* 
* Reads a byte from the script into #R$E89B.
sound_cmd_handler_05:                                      ; >7582
       li   hl,sound_channel_parameter                     ; LD HL,$E89B       ; 
       jmp  _757e                                          ; JR $757E          ; 

********************************************************************************
* Sound command 6: set the second parameter
* 
* Reads a byte from the script into #R$E89E.
sound_cmd_handler_06:                                      ; >7587
       li   hl,sound_channel_parameter_2                   ; LD HL,$E89E       ; 
       jmp  _757e                                          ; JR $757E          ; 

********************************************************************************
* Sound command 7: end of script
* 
* Continues with the machine code that follows the command byte, discarding
* the interpreter's return address.
sound_cmd_handler_07:                                      ; >758c
       .pop hl                                             ; POP HL            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       b    *hl                                            ; JP (HL)           ; TODO. 

********************************************************************************
* Sound command 9: set the envelope
* 
* Reads three bytes from the script into PSG registers 11-13 (the envelope
* period and shape), then sets the channel's volume to 16 so that it uses the
* envelope, and sets #R$E8A1.
sound_cmd_handler_09:                                      ; >758f
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@sound_channel_envelope_flag                 ; LD ($E8A1),A      ; the envelope has been set up (#R$E8A1)
       movb @bytes+>0b,b                                   ; LD B,$0B          ; start at register 11
_7596:                                                     ; >7596
       movb *de,a                                          ; LD A,(DE)         ; 
       inc  de                                             ; INC DE            ; 
       movb a,@c                                           ; LD C,A            ; C = the next byte of the script
       movb b,a                                            ; LD A,B            ; 
       .call @write_psg_register                           ; CALL $751D        ; write it to the register (#R$751D)
       ab   one,b                                          ; INC B             ; 
       movb b,a                                            ; LD A,B            ; 
       cb   a,@bytes+>0e                                   ; CP $0E            ; up to register 13
       jne  _7596                                          ; JR NZ,$7596       ; 
       movb @bytes+>10,a                                   ; LD A,$10          ; volume 16: use the envelope
       b    @cache_write_channel_data_byte_sound           ; JP $74EC          ; (#R$74EC)

********************************************************************************
* Sound command 10: set the noise period
* 
* Reads a byte from the script into PSG register 6.
sound_cmd_handler_10:                                      ; >75a8
       movb *de,a                                          ; LD A,(DE)         ; 
       inc  de                                             ; INC DE            ; 
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       b    @write_psg_register                            ; JP $751D          ; 

********************************************************************************
* Sound command 11: don't take this channel over
* 
* Sets #R$E8A2, so that #R$74AE won't take this channel over for another
* effect. No effect uses this command.
sound_cmd_handler_11:                                      ; >75b0
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@sound_channel_keep                          ; LD ($E8A2),A      ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Switch to music mode, unless already in it
* 
* Used by the routine at #R$7603.
* .
* Resets the channels (#R$75CD) with sound mode 1 (music), unless ($E8D6)
* is already 1.
music_mode:                                                ; >75b6
       movb @sound_mode,a                                  ; LD A,($E8D6)      ; already in music mode?
       sb   one,a                                          ; DEC A             ; 
       jne  !                                              ; RET Z             ; yes
       .ret                                                ;                   
!
       .push hl                                            ; PUSH HL           ; 
       movb one,a                                          ; LD A,$01          ; mode 1: music
       .call @reset_sound_channels                         ; CALL $75CD        ; reset the channels (#R$75CD)
       .pop hl                                             ; POP HL            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Switch to sound-effect mode, unless already in it
* 
* Used by the routine at #R$7468.
* .
* Resets the channels (#R$75CD) with sound mode $FF (sound effects),
* unless ($E8D6) is already $FF. This stops any music.
sound_effect_mode:                                         ; >75c3
       movb @sound_mode,a                                  ; LD A,($E8D6)      ; 
       ab   one,a                                          ; INC A             ; 
       jne  !                                              ; RET Z             ; 
       .ret                                                ;                   
!
       movb @b255,a                                        ; LD A,$FF          ; 
       b    @reset_sound_channels                          ; JP $75CD          ; 

********************************************************************************
* Reset the sound channels and set the sound mode
* 
* Used by the routines at #R$75B6 and #R$75C3.
* .
* Sets the sound mode ($E8D6: 0 none, 1 music, $FF sound effects), clears
* the three channel records at $E8A3, silences the PSG (#R$752C), and
* gives each channel its tone register (0, 2, 4) and volume register (8,
* 9, 10). Its EI at $7601 can let the interrupt in before #R$7603 has
* stored the new tune's pointer and channel count (see #R$7603).
* 
* I:A Sound mode
reset_sound_channels:                                      ; >75cd
       limi 0                                              ; DI                ; 
       movb a,@sound_mode                                  ; LD ($E8D6),A      ; set the sound mode
       li   hl,sound_channel_records                       ; LD HL,$E8A3       ; 
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,channel_1_tone_register                     ; LD DE,$E8A4       ; 
       li   bc,>002c                                       ; LD BC,$002C       ; 
       .ldir                                               ; LDIR              ; clear the three channel records (#R$E8A3)
       .call @silence_psg                                  ; CALL $752C        ; silence the PSG (#R$752C)
       sb   a,a                                            ; XOR A             ; 
       movb a,@channel_1_tone_register                     ; LD ($E8A4),A      ; 
       ab   @bytes+>02,a                                   ; ADD A,$02         ; 
       movb a,@channel_2_tone_register                     ; LD ($E8B3),A      ; 
       ab   @bytes+>02,a                                   ; ADD A,$02         ; 
       movb a,@channel_3_tone_register                     ; LD ($E8C2),A      ; tone registers 0, 2 and 4
       movb @bytes+>08,a                                   ; LD A,$08          ; 
       movb a,@channel_1_volume_register                   ; LD ($E8A5),A      ; 
       ab   one,a                                          ; INC A             ; 
       movb a,@channel_2_volume_register                   ; LD ($E8B4),A      ; 
       ab   one,a                                          ; INC A             ; 
       movb a,@channel_3_volume_register                   ; LD ($E8C3),A      ; volume registers 8, 9 and 10
       movb @vblank_isr_progress_flag,a                    ; LD A,($E91E)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; leave interrupts off if #R$E91E is set
       .ret                                                ;                   
!
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Start a tune
* 
* Used by the routines at #R$1C5C and #R$7645.
* .
* Switches to music mode (#R$75B6) and starts the channels in the tune
* header at HL (e.g. the title music at $7AE4): a channel count, then for
* each channel the address of its pattern list and its volume. Each
* channel starts at the first pattern in its list, and its volume is
* written to PSG registers 8, 9, 10. #R$7645 restarts the tune when it
* ends.
* .
* Bug: #R$75B6 switches to music mode and re-enables interrupts (#R$75CD)
* before the tune's address ($E8D0) and channel count ($E8D2) are stored.
* The first time the title screen starts the music, both are still 0, so if
* the interrupt arrives in that gap, #R$7645 takes the tune to have ended
* and restarts it from address 0. The channel count there is $C3 (the JP at
* #R$0000), so it sets up 195 channel records, writing over $E8A3-$F409
* (including #R$EFAB, #R$F380 and #R$F3FC) and sending 195 values to PSG
* registers 8 upwards. One of those records sets the sound mode ($E8D6) to
* 0, so when the original call carries on and sets up the title music's
* channels, they aren't played: the title music is silent. Whether it
* happens depends on when the interrupt arrives: it did in the boot that
* produced this snapshot, but not in the one that produced the in-flight
* snapshot. Once $E8D0 holds a tune's address, the same restart just replays
* the tune. This snapshot was taken on the title screen before "Load New
* Commander ?" was answered, so the bytes it wrote are still there;
* answering it unpacks the commander file (#R$A469) over the commander's
* variables, the cargo hold (#R$EB19) among them.
* 
* I:HL Address of the tune header
start_tune:                                                ; >7603
       .call @music_mode                                   ; CALL $75B6        ; conditionally run #R$75CD (no-op if $E8D6=1); HL = the source table either way
       mov  hl,@tune_address                               ; LD ($E8D0),HL     ; save the table pointer
       li   ix,sound_channel_records                       ; LD IX,$E8A3       ; IX -> the first destination record
       movb *hl,a                                          ; LD A,(HL)         ; A = record count (the table's first byte)
       inc  hl                                             ; INC HL            ; HL -> the per-record data that follows
       movb a,@tune_channels_playing                       ; LD ($E8D2),A      ; cache the record count too
       movb a,b                                            ; LD B,A            ; B = loop counter, one pass per record
       movb @bytes+>08,@c                                  ; LD C,$08          ; C = PSG register 8 (channel A volume) for the first record
_7615:                                                     ; >7615
       movb *hl,@e                                         ; LD E,(HL)         ; E = this record's pointer, low byte
       inc  hl                                             ; INC HL            ; 
       movb @e,@>03(ix)                                    ; LD (IX+$03),E     ; store it at offset +3
       movb *hl,d                                          ; LD D,(HL)         ; D = this record's pointer, high byte
       inc  hl                                             ; INC HL            ; 
       movb d,@>04(ix)                                     ; LD (IX+$04),D     ; store it at offset +4 - DE is now that pointer
       movb *de,a                                          ; LD A,(DE)         ; A = the pointed-to data's first byte
       inc  de                                             ; INC DE            ; 
       movb a,@>05(ix)                                     ; LD (IX+$05),A     ; store at offset +5
       movb *de,a                                          ; LD A,(DE)         ; A = the pointed-to data's second byte
       movb a,@>06(ix)                                     ; LD (IX+$06),A     ; store at offset +6
       .push bc                                            ; PUSH BC           ; save the loop counter and this record's PSG register number
       movb @c,a                                           ; LD A,C            ; A = PSG register number (8, then 9, then 10...)
       movb *hl,@c                                         ; LD C,(HL)         ; C = the volume/value to write, from the table
       inc  hl                                             ; INC HL            ; 
       .call @write_psg_register                           ; CALL $751D        ; write it to PSG register A (#R$751D)
       sb   @>08(ix),@>08(ix)                              ; LD (IX+$08),$00   ; zero offset +8
       sb   @>07(ix),@>07(ix)                              ; LD (IX+$07),$00   ; zero offset +7
       movb one,*ix                                        ; LD (IX+$00),$01   ; mark the record active
       .pop bc                                             ; POP BC            ; restore the loop counter and PSG register number
       ab   one,@c                                         ; INC C             ; next record's PSG register (8 -> 9 -> 10...)
       li   de,>000f                                       ; LD DE,$000F       ; DE = 15, one record's stride
       a    de,ix                                          ; ADD IX,DE         ; IX -> the next record
       sb   one,b                                          ; DJNZ $7615        ; loop for all B records
       jne  _7615                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Play the sound channels
* 
* Used by the routine at #R$7202.
* .
* Called on every tick. Unless the sound is off (($E8D6) = 0), processes
* each active one of the three channel records at $E8A3 (15 bytes each):
* copies it to #R$E894, and either continues the sound effect at the
* address in ($E899) (($E8D6) negative, at $766E) or plays the tune
* (#R$769B), then copies it back. At $7681, moves on to the next channel.
* When the tune (($E8D6) = 1) has finished on every channel (($E8D2) = 0),
* starts it again (#R$7603). If that happens while #R$7603 is still
* setting up the first tune, it restarts a "tune" at $0000 (see #R$7603).
play_sound_channels:                                       ; >7645
       movb @b255,a                                        ; LD A,$FF          ; A = $FF
       movb a,@unused_flag_e8d8                            ; LD ($E8D8),A      ; mark this tick's dispatch pass as running
       movb @sound_mode,a                                  ; LD A,($E8D6)      ; A = the sound-system mode/silence flag
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; 0 = silenced - nothing to do
       .ret                                                ;                   
!
       li   hl,sound_channel_records                       ; LD HL,$E8A3       ; HL -> the first of the 3 $E8A3-array records
       movb @bytes+>03,b                                   ; LD B,$03          ; B = 3 channels to service
_7654:                                                     ; >7654
       movb *hl,a                                          ; LD A,(HL)         ; A = this record's active flag
       socb a,a                                            ; OR A              ; 
       jeq  sound_channel_loop_advance                     ; JR Z,$7681        ; inactive - skip to the loop-advance tail
       .push bc                                            ; PUSH BC           ; save the loop counter
       .push hl                                            ; PUSH HL           ; save this record's address
       li   de,sound_channel_active                        ; LD DE,$E894       ; swap this record into the live #R$E894 context
       li   bc,>000f                                       ; LD BC,$000F       ; 
       .ldir                                               ; LDIR              ; 
       movb @sound_mode,a                                  ; LD A,($E8D6)      ; re-check the mode flag
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$766E        ; negative - resume via the deferred-continuation pointer
       b    @resume_sound_channel_continuation             ;                   
!
       .call @play_tune                                    ; CALL $769B        ; else process this channel's next pending command
       jmp  _7674                                          ; JR $7674          ; join the swap-out tail
resume_sound_channel_continuation:                         ; >766e
       mov  @sound_channel_data_pointer,hl                 ; LD HL,($E899)     ; HL = this channel's deferred-continuation address
       .call @jump_to_hl                                   ; CALL $769A        ; jump to it (#R$769A/jump_to_hl); it RETs back here when done
_7674:                                                     ; >7674
       .pop de                                             ; POP DE            ; DE = this record's address (saved at $7659)
       li   hl,sound_channel_active                        ; LD HL,$E894       ; swap the (possibly updated) context back into the record
       li   bc,>000f                                       ; LD BC,$000F       ; 
       .ldir                                               ; LDIR              ; 
       .ex_de_hl                                           ; EX DE,HL          ; HL = this record's address again
       .pop bc                                             ; POP BC            ; restore the loop counter
       jmp  _7685                                          ; JR $7685          ; join the loop-advance tail
sound_channel_loop_advance:                                ; >7681
       li   de,>000f                                       ; LD DE,$000F       ; DE = 15, one record's stride
       a    de,hl                                          ; ADD HL,DE         ; HL -> the next record
_7685:                                                     ; >7685
       sb   one,b                                          ; DJNZ $7654        ; loop for all 3 channels
       jne  _7654                                          ;                   
       movb @sound_mode,a                                  ; LD A,($E8D6)      ; re-check the mode flag
       sb   one,a                                          ; DEC A             ; 
       jne  _7699                                          ; JR NZ,$7699       ; not exactly 1 - done
       movb @tune_channels_playing,a                       ; LD A,($E8D2)      ; A = the cached source-table record count (#R$7603)
       socb a,a                                            ; OR A              ; 
       jne  _7699                                          ; JR NZ,$7699       ; still nonzero - done
       mov  @tune_address,hl                               ; LD HL,($E8D0)     ; HL = the cached source table pointer (#R$7603)
       .call @start_tune                                   ; CALL $7603        ; queue's run dry - restart it from the top
_7699:                                                     ; >7699
       .ret                                                ; RET               ; 

********************************************************************************
* Jump to the address in HL (generic tail-call helper)
* 
* Used by the routines at #R$7468, #R$753F and #R$7645.
jump_to_hl:                                                ; >769a
       b    *hl                                            ; JP (HL)           ; TODO. 

********************************************************************************
* Play the tune on a channel
* 
* Used by the routine at #R$7645.
* .
* While the current note lasts (($E89C)), counts it down (at $76EF).
* Otherwise reads the channel's next command from ($E899) (at $76B0): $91
* jumps to the next address in the list at ($E897) (at $76CD) - or, at the
* end of the list, silences the channel (at $76F4) and counts it as
* finished ($E8D2). Anything else (at $76D3) is a note - an offset into the
* tone periods at #R$7A1C, played at $76FD (#R$74F6) - and a duration: the
* note lasts twice that many ticks, and if the duration has bit 7 set, the
* last of them is silent (note $90).
play_tune:                                                 ; >769b
       movb @sound_channel_duration,a                      ; LD A,($E89C)      ; A = this channel's duration countdown (see #R$76E4)
       socb a,a                                            ; OR A              ; 
       jne  decay_sound_channel_duration                   ; JR NZ,$76EF       ; still counting down - decay it instead of reading a new command
       movb @sound_channel_parameter,a                     ; LD A,($E89B)      ; A = the pending rest (see $76DA)
       socb a,a                                            ; OR A              ; 
       jeq  read_sound_command_byte                        ; JR Z,$76B0        ; none pending - read the next command byte
       sb   a,a                                            ; XOR A             ; else consume it...
       movb a,@sound_channel_parameter                     ; LD ($E89B),A      ; ...clearing it
       movb @bytes+>90,a                                   ; LD A,$90          ; and play note $90 - lands exactly on #R$7A1C's own
       b    @play_note_via_psg                             ; JP $76FD          ; $0000 terminator, i.e. a built-in "silence" note
read_sound_command_byte:                                   ; >76b0
       mov  @sound_channel_data_pointer,hl                 ; LD HL,($E899)     ; HL = this channel's current read position
_76b3:                                                     ; >76b3
       movb *hl,a                                          ; LD A,(HL)         ; A = the next command byte
       inc  hl                                             ; INC HL            ; 
       cb   a,@bytes+>91                                   ; CP $91            ; $91 = loop/repeat command
       jne  sound_note_duration_pair                       ; JR NZ,$76D3       ; anything else - a note/duration pair instead
       mov  @sound_channel_countdown,hl                    ; LD HL,($E897)     ; HL = the loop-table pointer cached at $E897/$E898
       inc  hl                                             ; INC HL            ; 
       inc  hl                                             ; INC HL            ; HL -> that entry's target-address field
       movb *hl,@e                                         ; LD E,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; DE = the loop target address
       dec  hl                                             ; DEC HL            ; 
       movb d,a                                            ; LD A,D            ; 
       socb @e,a                                           ; OR E              ; 
       jne  sound_loop_jump_taken                          ; JR NZ,$76CD       ; nonzero - take the loop
       li   hl,tune_channels_playing                       ; LD HL,$E8D2       ; zero - the loop's exhausted: decrement the cached
       sb   one,*hl                                        ; DEC (HL)          ; source-table record count (#R$7603)...
       b    @silence_sound_channel                         ; JP $76F4          ; ...and silence this channel
sound_loop_jump_taken:                                     ; >76cd
       mov  hl,@sound_channel_countdown                    ; LD ($E897),HL     ; advance the loop-table pointer past this entry
       .ex_de_hl                                           ; EX DE,HL          ; HL = the loop target address
       jmp  _76b3                                          ; JR $76B3          ; resume reading commands from there
sound_note_duration_pair:                                  ; >76d3
       movb a,@c                                           ; LD C,A            ; C = the note byte just read (an even #R$7A1C offset)
       movb *hl,a                                          ; LD A,(HL)         ; A = the following byte - a signed duration
       inc  hl                                             ; INC HL            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$76E3        ; positive - double it directly
       b    @play_tune_double                              ;                   
!
       movb a,@sound_channel_parameter                     ; LD ($E89B),A      ; negative - stash the raw byte as a pending parameter
       andi a,>7f00                                        ; AND $7F           ; (the last tick is silent), then use its magnitude instead
       ab   a,a                                            ; ADD A,A           ; 
       sb   one,a                                          ; DEC A             ; 
       jmp  sound_duration_finalize                        ; JR $76E4          ; 
play_tune_double:                                          ; >76e3
       ab   a,a                                            ; ADD A,A           ; positive case: double the duration
sound_duration_finalize:                                   ; >76e4
       sb   one,a                                          ; DEC A             ; -1 (both paths converge here)
       movb a,@sound_channel_duration                      ; LD ($E89C),A      ; store as this channel's duration countdown
       mov  hl,@sound_channel_data_pointer                 ; LD ($E899),HL     ; save the advanced read position
       movb @c,a                                           ; LD A,C            ; A = the note byte
       b    @play_note_via_psg                             ; JP $76FD          ; play it
decay_sound_channel_duration:                              ; >76ef
       sb   one,a                                          ; DEC A             ; 
       movb a,@sound_channel_duration                      ; LD ($E89C),A      ; 
       .ret                                                ; RET               ; 
silence_sound_channel:                                     ; >76f4
       sb   a,a                                            ; XOR A             ; 
       movb a,@sound_channel_active                        ; LD ($E894),A      ; clear this channel's active flag
       movb a,h                                            ; LD H,A            ; 
       movb a,@l                                           ; LD L,A            ; HL = 0
       b    @write_16_bit_tone_period_psg                  ; JP $74F6          ; write a zero tone period to the PSG (#R$74F6)
play_note_via_psg:                                         ; >76fd
       movb a,@c                                           ; LD C,A            ; BC = the note offset, zero-extended
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,note_tone_periods                           ; LD HL,$7A1C       ; HL -> the note-to-tone-period table
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this note's entry
       movb *hl,a                                          ; LD A,(HL)         ; HL' = that entry's tone period (little-endian word)
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; 
       b    @write_16_bit_tone_period_psg                  ; JP $74F6          ; write it to the PSG (#R$74F6)

********************************************************************************
* Sound effect 0: click
* 
* Started by #R$7468 (entry 0 of the effect table at #R$7AC6). Runs the script
* that follows (#R$753F), which sets #R$74A6 as the per-frame handler.
sound_effect_0:                                            ; >770b
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >02,>64,>00                                              ; command 2: tone period 100
       byte >04,>02                                                  ; command 4: countdown 2
       byte >00,>A6,>74                                              ; command 0: per-frame handler #R$74A6
       byte >09,>C8,>00,>01                                          ; command 9: envelope period 200, shape 1
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 1
* 
* Started by #R$7468 (entry 1 of the effect table at #R$7AC6). Runs the script
* that follows (#R$753F), which sets #R$74A6 as the per-frame handler.
sound_effect_1:                                            ; >771e
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >03,>0C                                                  ; command 3: volume 12
       byte >02,>32,>00                                              ; command 2: tone period 50
       byte >04,>0A                                                  ; command 4: countdown 10
       byte >00,>A6,>74                                              ; command 0: per-frame handler #R$74A6
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 2: explosion
* 
* Started by #R$7468 (entry 2 of the effect table at #R$7AC6). Runs the script
* that follows (#R$753F), which sets #R$773E as the per-frame handler.
sound_effect_2:                                            ; >772f
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >08                                                      ; command 8: noise on
       byte >04,>14                                                  ; command 4: countdown 20
       byte >03,>0F                                                  ; command 3: volume 15
       byte >00,>3E,>77                                              ; command 0: per-frame handler #R$773E
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 2: per-frame handler
* 
* Sets a random noise period each frame (from the R register); every 20 frames
* turns the volume (#R$E898) down by one, and ends the effect (#R$740C) when
* it reaches 0.
sound_effect_2_handler:                                    ; >773e
       movb r,a                                            ; LD A,R            ; 
       movb a,@c                                           ; LD C,A            ; C = a random number
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       .call @write_psg_register                           ; CALL $751D        ; the noise period
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       movb @bytes+>14,*hl                                 ; LD (HL),$14       ; every 20 frames...
       li   hl,sound_channel_last_data                     ; LD HL,$E898       ; 
       sb   one,*hl                                        ; DEC (HL)          ; ...turn the volume down
       jne  !                                              ; JP Z,$740C        ; 0 - end the effect (#R$740C)
       b    @end_sound_effect                              ;                   
!
       movb *hl,a                                          ; LD A,(HL)         ; 
       b    @cache_write_channel_data_byte_sound           ; JP $74EC          ; write the volume (#R$74EC)

********************************************************************************
* Sound effect 3: laser
* 
* Started by #R$7468 (entry 3 of the effect table at #R$7AC6). Runs the script
* that follows (#R$753F), which sets #R$776B as the per-frame handler.
sound_effect_3:                                            ; >7758
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >09,>10,>00,>08                                          ; command 9: envelope period 16, shape 8
       byte >02,>0F,>00                                              ; command 2: tone period 15
       byte >04,>11                                                  ; command 4: countdown 17
       byte >00,>6B,>77                                              ; command 0: per-frame handler #R$776B
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 3: per-frame handler
* 
* Raises the tone period (#R$E89F) by 2 each frame, so the pitch falls, and
* ends the effect (#R$740C) when the countdown (#R$E897) runs out.
sound_effect_3_handler:                                    ; >776b
       mov  @sound_channel_position,hl                     ; LD HL,($E89F)     ; 
       inc  hl                                             ; INC HL            ; 
       inc  hl                                             ; INC HL            ; 
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; raise the tone period by 2
       .call @write_16_bit_tone_period_psg                 ; CALL $74F6        ; set it (#R$74F6)
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       b    @end_sound_effect                              ; JP $740C          ; finished - end the effect (#R$740C)

********************************************************************************
* Sound effect 4
* 
* Started by #R$7468 (entry 4 of the effect table at #R$7AC6). Runs the script
* that follows (#R$753F), which sets #R$7791 as the per-frame handler.
sound_effect_4:                                            ; >777e
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >08                                                      ; command 8: noise on
       byte >03,>0D                                                  ; command 3: volume 13
       byte >00,>91,>77                                              ; command 0: per-frame handler #R$7791
       byte >01,>15,>E9                                              ; command 1: "playing" flag at #R$E915
       byte >02,>00,>00                                              ; command 2: tone period 0
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 4: per-frame handler
* 
* Uses the low byte of #R$E89F as the noise period, raising it by one each
* frame, and ends the effect (#R$740C) when it reaches 25.
sound_effect_4_handler:                                    ; >7791
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       li   hl,sound_channel_position                      ; LD HL,$E89F       ; 
       movb *hl,@c                                         ; LD C,(HL)         ; C = the noise period (the low byte of #R$E89F)
       .call @write_psg_register                           ; CALL $751D        ; set it (#R$751D)
       ab   one,*hl                                        ; INC (HL)          ; raise it by one
       movb *hl,a                                          ; LD A,(HL)         ; 
       sb   @bytes+>19,a                                   ; SUB $19           ; 
       jeq  !                                              ; RET NZ            ; not 25 yet
       .ret                                                ;                   
!
       b    @end_sound_effect                              ; JP $740C          ; 25 - end the effect (#R$740C)

********************************************************************************
* Sound effect 5
* 
* Started by #R$7468 (entry 5 of the effect table at #R$7AC6). Runs the script
* that follows (#R$753F), which sets #R$77B4 as the per-frame handler.
sound_effect_5:                                            ; >77a2
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >03,>09                                                  ; command 3: volume 9
       byte >02,>2C,>01                                              ; command 2: tone period 300
       byte >00,>B4,>77                                              ; command 0: per-frame handler #R$77B4
_77ad:                                                     ; >77ad
       byte >01,>16,>E9                                              ; command 1: "playing" flag at #R$E916
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 5: per-frame handler
* 
* Lowers the tone period (#R$E89F) by 10 each frame, so the pitch rises, and
* ends the effect (#R$740C) when it drops below 150.
sound_effect_5_handler:                                    ; >77b4
       mov  @sound_channel_position,hl                     ; LD HL,($E89F)     ; HL = the tone period
       .call @write_16_bit_tone_period_psg                 ; CALL $74F6        ; set it (#R$74F6)
       li   de,>fff6                                       ; LD DE,$FFF6       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; lower it by 10
       li   de,>0096                                       ; LD DE,$0096       ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       joc  !                                              ; RET NC            ; TODO: check code. not below 150 yet
       .ret                                                ;                   
!
       b    @end_sound_effect                              ; JP $740C          ; below 150 - end the effect (#R$740C)

********************************************************************************
* Sound effect 6: beep
* 
* Started by #R$7468 (entry 6 of the effect table at #R$7AC6). Runs the script
* that follows (#R$753F), which sets #R$77DB as the per-frame handler.
sound_effect_6:                                            ; >77ca
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >03,>0C                                                  ; command 3: volume 12
       byte >02,>00,>02                                              ; command 2: tone period 512
       byte >04,>83                                                  ; command 4: countdown 131
       byte >00,>DB,>77                                              ; command 0: per-frame handler #R$77DB
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 6: per-frame handler
* 
* Counts #R$E897 down, ending the effect (#R$740C) when it reaches 0 (at
* $77EA). If it goes from $80 to $7F instead, it's reset to 3, with tone
* period $0300 (#R$74F6).
sound_effect_6_handler:                                    ; >77db
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       ; JP PO,$77EA                                       ; JP PO,$77EA       ; TODO: check code. 
       movb @bytes+>03,*hl                                 ; LD (HL),$03       ; 
       li   hl,>0300                                       ; LD HL,$0300       ; 
       b    @write_16_bit_tone_period_psg                  ; JP $74F6          ; 
continue_77db_expire_to_740c:                              ; >77ea
       jne  !                                              ; JP Z,$740C        ; countdown reached 0 - continue there
       b    @end_sound_effect                              ;                   
!
       .ret                                                ; RET               ; not yet - nothing more to do

********************************************************************************
* Sound effect 7: tunnel rings
* 
* Started by #R$7468 (entry 7 of the effect table at #R$7AC6) for the tunnel
* rings (#R$6CB2). Has no script: clears #R$E923 and sets #R$77FB as the per-
* frame handler directly.
sound_effect_7:                                            ; >77ee
       sb   a,a                                            ; XOR A             ; 
       movb a,@tunnel_rings_finished                       ; LD ($E923),A      ; 
       li   hl,sound_effect_7_handler                      ; LD HL,$77FB       ; 
       mov  hl,@sound_channel_data_pointer                 ; LD ($E899),HL     ; 
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 7: per-frame handler
* 
* Follows the tunnel rings (#R$6CB2): sets the volume to the radius of the
* ring being drawn (#R$E921) / 8 and the tone period to the radius + 50. Ends
* the effect (#R$740C) once #R$6CB2 has finished and set #R$E923.
sound_effect_7_handler:                                    ; >77fb
       movb @tunnel_rings_finished,a                       ; LD A,($E923)      ; the rings finished (#R$E923)?
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$740C       ; yes - end the effect (#R$740C)
       b    @end_sound_effect                              ;                   
!
       mov  @tunnel_ring_radius,hl                         ; LD HL,($E921)     ; HL = the ring's radius (#R$E921)
       movb @l,a                                           ; LD A,L            ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>0f00                                        ; AND $0F           ; A = the radius / 8
       .call @cache_write_channel_data_byte_sound          ; CALL $74EC        ; set the volume (#R$74EC)
       li   de,>0032                                       ; LD DE,$0032       ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = the radius + 50
       b    @write_16_bit_tone_period_psg                  ; JP $74F6          ; set the tone period (#R$74F6)

********************************************************************************
* Sound effect 8: ECM
* 
* Started by #R$7468 (entry 8 of the effect table at #R$7AC6). Runs the script
* that follows (#R$753F), which sets #R$782B as the per-frame handler.
* .
* Then sets the ECM counter (#R$E912) to $78.
sound_effect_8:                                            ; >7815
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >03,>0C                                                  ; command 3: volume 12
       byte >02,>64,>00                                              ; command 2: tone period 100
       byte >05,>14                                                  ; command 5: parameter 20
       byte >00,>2B,>78                                              ; command 0: per-frame handler #R$782B
       byte >07                                                      ; command 7: end of script
       movb @bytes+>78,a                                   ; LD A,$78          ; 
       movb a,@ecm_countdown                               ; LD ($E912),A      ; 
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect step: sweep the tone up and down
* 
* Nothing calls this directly. Sets the tone period to ($E89F) (#R$74F6),
* and moves it up by 50 until it's 200 or more, then (bit 7 of ($E89B) set
* at $7856) down by 50 (at $785D) until it's under 100. Each time it
* reaches the top, decrements #R$E912 and the count in ($E89B); when that
* runs out, moves on to the effect's next command (#R$740C) and sets
* #R$E912 to $FF.
sound_step_sweep:                                          ; >782b
       mov  @sound_channel_position,hl                     ; LD HL,($E89F)     ; HL = the tone period
       .call @write_16_bit_tone_period_psg                 ; CALL $74F6        ; set it (#R$74F6)
       movb @sound_channel_parameter,a                     ; LD A,($E89B)      ; 
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$785D        ; bit 7 set: going down
       b    @continue_782b_step_down_flip_at_100           ;                   
!
       li   de,>0032                                       ; LD DE,$0032       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; raise the tone period by 50
       li   de,>00c8                                       ; LD DE,$00C8       ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       joc  _785b                                          ; JR C,$785B        ; TODO: check code. not 200 yet
       li   hl,ecm_countdown                               ; LD HL,$E912       ; 
       sb   one,*hl                                        ; DEC (HL)          ; reached the top: count down the ECM (#R$E912)
       sb   one,a                                          ; DEC A             ; and the sweeps (#R$E89B)
       jne  continue_782b_flip_direction_negative          ; JR NZ,$7856       ; more sweeps to go
       .call @end_sound_effect                             ; CALL $740C        ; the last one: end the effect (#R$740C)
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@ecm_countdown                               ; LD ($E912),A      ; and switch the ECM off
       .ret                                                ; RET               ; 
continue_782b_flip_direction_negative:                     ; >7856
       socb @bytes+>80,a                                   ; OR $80            ; set the direction flag's sign bit
       movb a,@sound_channel_parameter                     ; LD ($E89B),A      ; 
_785b:                                                     ; >785b
       jmp  _7871                                          ; JR $7871          ; 
continue_782b_step_down_flip_at_100:                       ; >785d
       li   de,>ffce                                       ; LD DE,$FFCE       ; -50
       a    de,hl                                          ; ADD HL,DE         ; lower the tone period by 50
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; 
       li   de,>0064                                       ; LD DE,$0064       ; 100
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; below the lower limit?
       jnc  _7871                                          ; JR NC,$7871       ; TODO: check code. no - nothing more to do
       andi a,>7f00                                        ; AND $7F           ; yes - clear the direction flag's sign bit
       movb a,@sound_channel_parameter                     ; LD ($E89B),A      ; 
_7871:                                                     ; >7871
       .ret                                                ; RET               ; 

********************************************************************************
* Sound effect 9
