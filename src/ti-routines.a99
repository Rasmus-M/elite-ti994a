*********************************************************************
*
* Setup environment
*
ti_setup_environment:
;       mov  @rndsd,@pseudo_random_scrolling_counter
       li   one,>0100
       li   r0,>fffe
       mov  r0,@b255
       li   sp,pad_stack
       .proc
       bl   @init_bits
       bl   @clear_pad
       bl   @copy_to_pad
       bl   @graphics_mode
       .endproc
*// ti_setup_environment

*********************************************************************
*
* Init bits for bit operations
*
init_bits:
       li   r0,>0100
       li   r1,bits
       li   r2,8
init_bits_1:
       mov  r0,*r1+
       sla  r0,1
       dec  r2
       jne  init_bits_1
       rt
*// init_bits

*********************************************************************
*
* Clear scratchpad
*
clear_pad:
       li   r0,pad_vars
       li   r2,pad_max-pad_vars
clear_pad_1:
       clr  *r0+
       dect r2
       jne  clear_pad_1
       rt
*// clear_pad

*********************************************************************
*
* Copy routines to pad
*
copy_to_pad:
       li   r0,copy_bc_bytes_from_hl_to_vdp_unrolled
       li   r1,copy_to_vdp_unrolled
       li   r2,copy_bc_bytes_from_hl_to_vdp_unrolled_end-copy_bc_bytes_from_hl_to_vdp_unrolled
copy_to_pad_1:
       mov  *r0+,*r1+
       dect r2
       jne  copy_to_pad_1

       li   r0,ti_ldir
       li   r1,ldir_pad
       li   r2,ti_ldir_end-ti_ldir
copy_to_pad_2:
       mov  *r0+,*r1+
       dect r2
       jne  copy_to_pad_2
       rt
*// copy_to_pad

*********************************************************************
*
* Set graphics mode
*
graphics_mode:
       clr  r0
       li   r1,vdp_registers
       li   r2,8
graphics_mode_1:
       movb *r1+,@r0lb
       bl   @vwtr                      ; Set register
       ai   r0,>0100
       dec  r2
       jne  graphics_mode_1
*      Clear VDP RAM
       clr  r0
       clr  r1
       li   r2,>4000
       bl   @vsmw
*      Disable sprites
       li   r0,sprite_attr_table
       li   r1,>d000
       bl   @vsbw
*      Init color table
       li   r0,color_table
       li   r1,>f100
       li   r2,>1800
       bl   @vsmw
*      Init name tables
       li   r0,name_table
       bl   @vwad
       bl   @ti_init_name_table
       lwpi wrksp
       rt
*      VDP registers
vdp_registers:
       byte >02                        ; Graphics II mode
       byte >e2                        ; 16K, display on, interrupt enabled
       byte name_table/>400            ; Name table
       byte >ff                        ; Color table
       byte pattern_table/>800+>03     ; Pattern table
       byte sprite_attr_table/>80      ; Sprite attribute table
       byte sprite_pattern_table/>800  ; Sprite pattern table
       byte >00                        ; Backdrop color
*// graphics_mode

*********************************************************************************
*
* Initialize name table for bitmap drawing
*
ti_init_name_table:
       clr  r1
       li   r2,768
ti_init_name_table_1:
       movb r1,@vdpwd
       ai   r1,>0100
       dec  r2
       jne  ti_init_name_table_1
       rt
*// ti_init_name_table

