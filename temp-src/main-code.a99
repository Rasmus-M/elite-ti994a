       movb @bytes+>18,b                                   ; LD B,$18          ; 24 bits
_20c9:                                                     ; >20c9
       ; CCF                                               ; CCF               ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. shift the next quotient bit in (complemented)...
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. ...and the next dividend bit into the remainder
       sb   @bytes+>0a,a                                   ; SUB $0A           ; subtract 10
       jnc  _20d7                                          ; JR NC,$20D7       ; TODO: check code. it fits
       ab   @bytes+>0a,a                                   ; ADD A,$0A         ; it doesn't: add it back
_20d7:                                                     ; >20d7
       sb   one,b                                          ; DJNZ $20C9        ; 
       jne  _20c9                                          ;                   
       ; CCF                                               ; CCF               ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. H:L:C = the quotient
       .ret                                                ; RET               ; 

********************************************************************************
* Divide HL:DE by 100000
* 
* Used by the routine at #R$6051.
* .
* Used by #R$6051 to show the free space in the hold, which is held in
* grams, in tenths of a tonne. A restoring division by 100000 kept in the
* shadow CHL: shifts the dividend left a bit at a time into CHL, and
* subtracts 100000 from it if it can (at $210D), shifting the quotient
* bits in at the bottom of the dividend.
* 
* I:HL:DE Dividend
* O:HL:DE Quotient
divide_by_100000:                                          ; >20e1
       .exx                                                ; EXX               ; 
       sb   @c,@c                                          ; LD C,$00          ; 
       movb @c,h                                           ; LD H,C            ; 
       movb @c,@l                                          ; LD L,C            ; CHL' = 0
       .exx                                                ; EXX               ; 
       movb @bytes+>20,b                                   ; LD B,$20          ; 32 bits
_20e9:                                                     ; >20e9
       ; CCF                                               ; CCF               ; TODO: check code. carry = the last quotient bit
       ; RL E                                              ; RL E              ; TODO: check code. shift it into the dividend...
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. ...and the dividend's top bit out
       .exx                                                ; EXX               ; 
       ; RL C                                              ; RL C              ; TODO: check code. into CHL'
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. 
       .push bc                                            ; PUSH BC           ; save CHL'
       .push hl                                            ; PUSH HL           ; 
       movb @c,a                                           ; LD A,C            ; CHL' -= 100000 ($0186A0)
       sb   @bytes+>a0,a                                   ; SUB $A0           ; 
       movb a,@c                                           ; LD C,A            ; 
       movb @l,a                                           ; LD A,L            ; 
       sb   @bytes+>86,a                                   ; SBC A,$86         ; 
       movb a,@l                                           ; LD L,A            ; 
       movb h,a                                            ; LD A,H            ; 
       sb   one,a                                          ; SBC A,$01         ; 
       movb a,h                                            ; LD H,A            ; 
       jnc  keep_successful_trial_subtraction              ; JR NC,$210D       ; TODO: check code. it went: keep it (the quotient bit is 1)
       .pop hl                                             ; POP HL            ; it didn't: restore CHL' (the quotient bit is 0)
       .pop bc                                             ; POP BC            ; 
       jmp  _210f                                          ; JR $210F          ; 
keep_successful_trial_subtraction:                         ; >210d
       .pop de                                             ; POP DE            ; discard the saved CHL'
       .pop de                                             ; POP DE            ; 
_210f:                                                     ; >210f
       .exx                                                ; EXX               ; 
       sb   one,b                                          ; DJNZ $20E9        ; next bit
       jne  _20e9                                          ;                   
       ; CCF                                               ; CCF               ; TODO: check code. shift in the last quotient bit
       ; RL E                                              ; RL E              ; TODO: check code. 
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Divide DE:HL by 1000
* 
* Used by the routine at #R$5B4D.
* .
* Used by #R$5B4D to show amounts of cargo, which are held in grams, in
* kilograms or tonnes. A restoring division, like #R$20E1's, by 1000 kept
* in the shadow BC. The entry at $2134 (a single trial subtraction) is
* also the target of the unused jump-table entry at $00A0 (see
* #R$003B).
* 
* I:DE:HL The 32-bit dividend
* O:DE:HL The quotient
divide_by_1000:                                            ; >211c
       .exx                                                ; EXX               ; switch to the shadow set to load the divisor/zero the accumulator
       li   hl,>0000                                       ; LD HL,$0000       ; shadow HL' = 0, the accumulator
       li   bc,scale_3_4_table+>00e8                       ; LD BC,$03E8       ; shadow BC' = 1000, the divisor
       .exx                                                ; EXX               ; back to the main set
       movb @bytes+>20,b                                   ; LD B,$20          ; 32 bits of dividend to process
_2126:                                                     ; >2126
       ; CCF                                               ; CCF               ; TODO: check code. clear carry (the previous bit's success/fail flag)
       ; RL E                                              ; RL E              ; TODO: check code. shift the dividend one bit left...
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. ...the bit shifted out becomes the next trial bit
       .exx                                                ; EXX               ; switch to the shadow accumulator
       ; RL L                                              ; RL L              ; TODO: check code. shift that trial bit into the accumulator (HL')
       sla  h,1                                            ; RL H              ; TODO: check code. 
subtract_1000_clamped:                                     ; >2134
       socb a,a                                            ; OR A              ; clear carry ahead of the trial subtraction
       s    bc,hl                                          ; SBC HL,BC         ; trial-subtract 1000 from the accumulator
       jnc  _213a                                          ; JR NC,$213A       ; TODO: check code. no borrow - succeeded, this quotient bit is 1
       a    bc,hl                                          ; ADD HL,BC         ; borrow - undo: restore the accumulator, this bit is 0
_213a:                                                     ; >213a
       .exx                                                ; EXX               ; back to the main set
       sb   one,b                                          ; DJNZ $2126        ; 32 bits done?
       jne  _2126                                          ;                   
       ; CCF                                               ; CCF               ; TODO: check code. no - loop; yes - shift the final trial bit into the quotient
       ; RL E                                              ; RL E              ; TODO: check code. 
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. DE:HL now holds the 32-bit quotient
       .ret                                                ; RET               ; 

********************************************************************************
* Twist the seeds once
* 
* Used by the routine at #R$4CE7.
* .
* Turns the three 16-bit seeds (s0, s1, s2) at #R$E904 into (s1, s2, s0 +
* s1 + s2), as in BBC Elite.
twist_seeds:                                               ; >2147
       mov  @system_seeds,hl                               ; LD HL,($E904)     ; HL = the oldest slot
       mov  @seed_s1,de                                    ; LD DE,($E906)     ; DE = the middle slot
       mov  @seed_s2,bc                                    ; LD BC,($E908)     ; BC = the newest slot
       a    de,hl                                          ; ADD HL,DE         ; HL = oldest+middle
       a    bc,hl                                          ; ADD HL,BC         ; HL = oldest+middle+newest (the new sum)
       mov  de,@system_seeds                               ; LD ($E904),DE     ; shift: middle becomes the new oldest
       mov  bc,@seed_s1                                    ; LD ($E906),BC     ; shift: newest becomes the new middle
       mov  hl,@seed_s2                                    ; LD ($E908),HL     ; the sum becomes the new newest
       .ret                                                ; RET               ; 

********************************************************************************
* Multiply two sign-tagged logarithms
* 
* Used by the routines at #R$4464, #R$47A1, #R$66DC and #R$86DC.
* .
* Adds two logs from #R$1FCF (or the log table at $0800) and converts the
* sum back with #R$1FF2, giving the product; the result is negated if
* exactly one of the two was tagged negative (bit 6 of the high byte).
* Returns 0 if the sum overflows 16 bits ($2172).
* 
* I:HL Sign-tagged log of the first value
* I:BC Sign-tagged log of the second value
* O:HL The signed product
multiply_logs:                                             ; >2160
       movb h,a                                            ; LD A,H            ; 
       ; XOR B                                             ; XOR B             ; TODO: check code. bit 6 = product's sign
       ab   a,a                                            ; ADD A,A           ; move it to bit 7 (S flag)
       .ex_af_af_                                          ; EX AF,AF'         ; and save it
       a    bc,hl                                          ; ADD HL,BC         ; add the logs
       joc  overflow_case_return_0                         ; JR C,$2172        ; TODO: check code. overflow - return 0
       .call @antilog                                      ; CALL $1FF2        ; HL = antilog
       .ex_af_af_                                          ; EX AF,AF'         ; 
       jlt  !                                              ; RET P             ; positive - done
       .ret                                                ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       movb a,h                                            ; LD H,A            ; 
       .ret                                                ; RET               ; 
overflow_case_return_0:                                    ; >2172
       li   hl,>0000                                       ; LD HL,$0000       ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Generate a random byte
* 
* Used by the routines at #R$13FD, #R$1703, #R$193F, #R$1DDC, #R$25B9, #R$26A9,
* #R$27DF, #R$281E, #R$2859, #R$28F6, #R$2A1C, #R$2A94, #R$2B05, #R$2C21,
* #R$2C3C, #R$2D3B, #R$3326, #R$3EAD, #R$50AA, #R$64F1, #R$656B, #R$6628,
* #R$6682, #R$6882, #R$707D, #R$894D, #R$8DB9, #R$8E51 and #R$8F25.
* .
* The game's random number generator: shifts and XORs the three bytes at
* $E936-$E938, returning one of them. Seeded from the R register at startup
* (#R$6F9F).
* 
* O:A A random byte
random_byte:                                               ; >2176
       movb @rng_state_3,a                                 ; LD A,($E938)      ; 
       movb a,@l                                           ; LD L,A            ; L = the third byte
       movb @rng_state_2,a                                 ; LD A,($E937)      ; 
       movb a,@rng_state_3                                 ; LD ($E938),A      ; the second byte moves into the third
       cb   a,@bytes+>80                                   ; CP $80            ; carry = its bit 7
       ; RL L                                              ; RL L              ; TODO: check code. shift L left, with that bit
       srl  a,1                                            ; RRA               ; TODO: check code. 
       movb @prng_state,a                                  ; LD A,($E936)      ; 
       movb a,@rng_state_2                                 ; LD ($E937),A      ; the first byte moves into the second
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; XOR L                                             ; XOR L             ; TODO: check code. 
       movb a,@prng_state                                  ; LD ($E936),A      ; the new first byte
       .ret                                                ; RET               ; 

********************************************************************************
* Square a number, using logarithms
* 
* Used by the routine at #R$8515.
* .
* Doubles L's logarithm (from the log table at #R$0800) and converts it
* back (#R$21A3), giving roughly L * L - to within about 1.5% except for
* the smallest values (3 * 3 gives 8, for example). For L = 0 the log is
* $FFFF, which overflows when doubled, and 0 is returned.
* 
* I:L Number
* O:HL Its square, roughly
square:                                                    ; >2191
       sb   a,a                                            ; XOR A             ; 
       ; SLA L                                             ; SLA L             ; TODO: check code. 
       ab   @bytes+>08,a                                   ; ADC A,$08         ; page $08 or $09 of the log table
       movb a,h                                            ; LD H,A            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       ab   one,@l                                         ; INC L             ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL = log(L)
       a    hl,hl                                          ; ADD HL,HL         ; HL = log(L * L)
       joc  !                                              ; JP NC,$21A3       ; TODO: check code. convert it back
       b    @antilog16                                     ;                   
!
       li   hl,>0000                                       ; LD HL,$0000       ; L = 0: return 0
       .ret                                                ; RET               ; 

********************************************************************************
* Convert a logarithm back to a value (16-bit antilog)
* 
* Used by the routines at #R$2191, #R$46CA, #R$47F0 and #R$84A6.
* .
* Returns 2^(HL/1024) from the antilog table at #R$0400, indexed by HL / 32
* - the full 16-bit version of #R$1FF2, which returns only the high byte.
* Returns $FFFF ($21C0) if HL is $4000 or more, i.e. the result wouldn't
* fit in 16 bits.
* 
* I:HL Logarithm (log2(n) * 1024)
* O:HL The value
antilog16:                                                 ; >21a3
       movb h,a                                            ; LD A,H            ; 
       czc  @bit6,a                                        ; BIT 6,A           ; HL >= $4000?
       jne  antilog16_overflow                             ; JR NZ,$21C0       ; too big - return $FFFF
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. A:L = HL / 16
       andi a,>0300                                        ; AND $03           ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; page $04-$07 of the antilog table
       movb a,h                                            ; LD H,A            ; 
       szcb @bit0,@l                                       ; RES 0,L           ; even offset (word entries)
       movb *hl,a                                          ; LD A,(HL)         ; 
       ab   one,@l                                         ; INC L             ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL = 2^(log / 1024)
       .ret                                                ; RET               ; 
antilog16_overflow:                                        ; >21c0
       li   hl,>ffff                                       ; LD HL,$FFFF       ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Add a 4-byte number at (HL) to one at (DE)
* 
* Used by the routines at #R$5C01 and #R$8BA6.
* .
* A 32-bit add, low byte first. Used to add a unit of cargo to the hold
* (#R$5C01, #R$8BF9).
* 
* I:DE Pointer to the number to add to
* I:HL Pointer to the number to add
add_4byte_de_hl:                                           ; >21c4
       socb a,a                                            ; OR A              ; clear carry ahead of the add chain
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 bytes to process
_21c7:                                                     ; >21c7
       movb *de,a                                          ; LD A,(DE)         ; A = this byte of the accumulator
       ab   *hl,a                                          ; ADC A,(HL)        ; add this byte of the operand, with carry-in
       movb a,*de                                          ; LD (DE),A         ; store the result back
       inc  hl                                             ; INC HL            ; advance both pointers
       inc  de                                             ; INC DE            ; 
       sb   one,b                                          ; DJNZ $21C7        ; 4 bytes done?
       jne  _21c7                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Subtract a 4-byte value at (HL) from the 4-byte value at (DE)
* 
* Used by the routines at #R$5D72 and #R$63E0.
* .
* #R$21C4's subtract counterpart: DE -= HL, byte by byte with borrow
* propagation.
* 
* I:DE -> The 4-byte accumulator (updated in place)
* I:HL -> The 4-byte value to subtract
subtract_4byte_de_hl:                                      ; >21cf
       socb a,a                                            ; OR A              ; clear carry ahead of the subtract chain
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 bytes to process
_21d2:                                                     ; >21d2
       movb *de,a                                          ; LD A,(DE)         ; A = this byte of the accumulator
       sb   *hl,a                                          ; SBC A,(HL)        ; subtract this byte of the operand, with borrow-in
       movb a,*de                                          ; LD (DE),A         ; store the result back
       inc  hl                                             ; INC HL            ; advance both pointers
       inc  de                                             ; INC DE            ; 
       sb   one,b                                          ; DJNZ $21D2        ; 4 bytes done?
       jne  _21d2                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Look up the rotation coefficients for a turn rate
* 
* Used by the routines at #R$2209, #R$2212, #R$2365 and #R$23D9.
* .
* Copies the 6-byte record for turn rate |A| to DE: the cos and sin of
* |A| half-degrees from the table at #R$121B (|A| up to 40), or the
* 30-degree record at #R$2522 for |A| = 127. If A is negative, sets bit
* 7 of the copy's last byte (the top of the sin value), which makes
* #R$24A7 turn the other way. Used to set up the live roll and pitch
* tables (#R$2209, #R$2212) and objects' own turns (#R$2365, #R$23D9).
* 
* I:A Turn rate (-40 to 40, or -127/127)
* I:DE Where to copy the record
lookup_rotation_coeffs:                                    ; >21da
       socb a,a                                            ; OR A              ; 
       .push af                                            ; PUSH AF           ; save the sign
       jlt  !                                              ; JP P,$21E1        ; 
       b    @lookup_rotation_coeffs_abs                    ;                   
!
       neg a                                               ; NEG               ; A = |rate|
lookup_rotation_coeffs_abs:                                ; >21e1
       cb   a,@bytes+>7f                                   ; CP $7F            ; 127?
       jne  _21ea                                          ; JR NZ,$21EA       ; no - use the table
       li   hl,rotation_30_degrees                         ; LD HL,$2522       ; yes - use the 30-degree record
       jmp  _21f6                                          ; JR $21F6          ; 
_21ea:                                                     ; >21ea
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       movb h,b                                            ; LD B,H            ; 
       movb @l,@c                                          ; LD C,L            ; BC = |rate| * 2
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL = |rate| * 6
       li   bc,trig_table_fine                             ; LD BC,$121B       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> the record in the table
_21f6:                                                     ; >21f6
       .ldi                                                ; LDI               ; copy the 6-byte record to DE
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .pop af                                             ; POP AF            ; 
       jlt  !                                              ; RET P             ; rate positive - done
       .ret                                                ;                   
!
       dec  de                                             ; DEC DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; HL -> the copy's last byte
       socb @bit7,*hl                                      ; SET 7,(HL)        ; negative: set bit 7 to turn the other way
       .ret                                                ; RET               ; 

********************************************************************************
* Refresh the live "cos"-role rotation table from the roll rate at $F815
* 
* Used by the routines at #R$1837 and #R$6BE1.
refresh_roll_table:                                        ; >2209
       movb @roll_rate,a                                   ; LD A,($F815)      ; 
       li   de,live_roll_coeff_table                       ; LD DE,$EB76       ; #R$22C0's table
       b    @lookup_rotation_coeffs                        ; JP $21DA          ; 

********************************************************************************
* Refresh the live "cos"-role rotation table from the pitch rate at $F816
* 
* Used by the routine at #R$6BE1.
refresh_pitch_table:                                       ; >2212
       movb @pitch_rate,a                                  ; LD A,($F816)      ; 
       li   de,live_pitch_coeff_table                      ; LD DE,$EB7C       ; #R$221B's table
       b    @lookup_rotation_coeffs                        ; JP $21DA          ; 

********************************************************************************
* Apply the player's pitch to the object (its position, side and nose vectors)
* 
* Used by the routine at #R$13FD.
* .
* Uses the live coefficient table at $EB7C (refreshed from the pitch
* rate at $F816 by #R$2212) to apply one #R$2450-style rotation step to
* three separate 2D coordinate pairs:
* .
* - ($F7D0,$F7D2) always, via a plain call to #R$2450;
* - ($F7D6,$F7D8) and ($F7DC,$F7DE) as well, but only when bit 3 of
* the object status byte at $F7CD is clear - done inline here
* (repeating #R$2450's rotate-then-normalize pattern by hand,
* calling #R$24D1/#R$24A7 directly, rather than calling #R$2450
* itself) so there is no inline counterpart to #R$2450's own
* $7FFF/$8000/$7F92 overflow saturation.
* .
* #R$22C0 rotates the same three pairs' *other* halves ($F7CE, $F7D4,
* $F7DA) around a different axis, using its own table at $EB76. Since
* $F7D0 is written by both this routine and #R$22C0, (F7CE,F7D0,F7D2) is
* really one 3D vector being rotated first around one axis then the
* other - likewise (F7D4,F7D6,F7D8) and (F7DA,F7DC,F7DE). The first is the
* object's position, which is always rotated; the other two are its side
* and nose vectors (#R$F7D4, #R$F7DA). Each
* inline half is written back in sign-magnitude form (magnitude in
* the low 15 bits, sign in the high byte's bit 7) - the same
* representation #R$2450 normalizes its own BC/DE inputs into at
* entry, and #R$24D1/#R$24A7 expect throughout.
* 
* I:$F7D0/$F7D2/$F7D6/$F7D8/$F7DC/$F7DE The three vectors' second halves
* I:$F7CD Object status byte (bit 3 gates the two orientation vectors)
step_pitch_rotation:                                       ; >221b
       li   ix,live_pitch_coeff_table                      ; LD IX,$EB7C       ; IX -> the live pitch-rotation coefficient table
       mov  @object_position_y,bc                          ; LD BC,($F7D0)     ; BC = X, the always-on vector's first half
       mov  @object_position_z_lo,de                       ; LD DE,($F7D2)     ; DE = Y, its second half
       .call @rotate_pair                                  ; CALL $2450        ; rotate (X,Y) by one pitch step
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; store X'
       mov  de,@object_position_z_lo                       ; LD ($F7D2),DE     ; store Y'
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; HL -> the object status byte
       movb *hl,r0                                         ; BIT 3,(HL)        ; test whether the two orientation vectors need rotating too
       andi r0,>0800                                       ;                   
       jeq  !                                              ; RET NZ            ; bit set - skip them, we're done
       .ret                                                ;                   
!
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; the roof vector needs working out again (#R$4599)
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       ab   one,*hl                                        ; INC (HL)          ; bump the counter at $F7E8 (clamped/reset by #R$4503)
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; HL = X of the first orientation vector
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = X.cos
       .push hl                                            ; PUSH HL           ; save X.cos
       mov  @side_vector_z,hl                              ; LD HL,($F7D8)     ; HL = Y of the first orientation vector
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = Y.sin
       .pop de                                             ; POP DE            ; DE = X.cos
       .ex_de_hl                                           ; EX DE,HL          ; HL = X.cos, DE = Y.sin
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = X.cos - Y.sin = X' (before sign check)
       jlt  !                                              ; JP P,$225A        ; already positive - no conversion needed
       b    @step_pitch_side_y                             ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate L...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into H...
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...and set the sign bit (sign-magnitude form)
step_pitch_side_y:                                         ; >225a
       .push hl                                            ; PUSH HL           ; save X'
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; HL = X again
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = X.sin
       .push hl                                            ; PUSH HL           ; save X.sin
       mov  @side_vector_z,hl                              ; LD HL,($F7D8)     ; HL = Y again
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = Y.cos
       .pop de                                             ; POP DE            ; DE = X.sin
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = Y.cos + X.sin = Y' (before sign check)
       jlt  !                                              ; JP P,$2277        ; already positive - no conversion needed
       b    @step_pitch_side_z                             ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate L...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into H...
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...and set the sign bit (sign-magnitude form)
step_pitch_side_z:                                         ; >2277
       mov  hl,@side_vector_z                              ; LD ($F7D8),HL     ; store Y'
       .pop hl                                             ; POP HL            ; HL = X' (saved earlier)
       mov  hl,@side_vector_y                              ; LD ($F7D6),HL     ; store X'
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = X of the second orientation vector
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = X.cos
       .push hl                                            ; PUSH HL           ; save X.cos
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; HL = Y of the second orientation vector
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = Y.sin
       .pop de                                             ; POP DE            ; DE = X.cos
       .ex_de_hl                                           ; EX DE,HL          ; HL = X.cos, DE = Y.sin
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = X.cos - Y.sin = X' (before sign check)
       jlt  !                                              ; JP P,$229B        ; already positive - no conversion needed
       b    @step_pitch_nose_y                             ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate L...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into H...
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...and set the sign bit (sign-magnitude form)
step_pitch_nose_y:                                         ; >229b
       .push hl                                            ; PUSH HL           ; save X'
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = X again
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = X.sin
       .push hl                                            ; PUSH HL           ; save X.sin
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; HL = Y again
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = Y.cos
       .pop de                                             ; POP DE            ; DE = X.sin
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = Y.cos + X.sin = Y' (before sign check)
       jlt  !                                              ; JP P,$22B8        ; already positive - no conversion needed
       b    @step_pitch_nose_z                             ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate L...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into H...
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...and set the sign bit (sign-magnitude form)
step_pitch_nose_z:                                         ; >22b8
       mov  hl,@nose_vector_z                              ; LD ($F7DE),HL     ; store Y'
       .pop hl                                             ; POP HL            ; HL = X' (saved earlier)
       mov  hl,@nose_vector_y                              ; LD ($F7DC),HL     ; store X'
       .ret                                                ; RET               ; 

********************************************************************************
* Apply the player's roll to the object (its position, side and nose vectors)
* 
* Used by the routine at #R$13FD.
* .
* The companion to #R$221B: uses the live coefficient table at $EB76
* (refreshed from the roll rate at $F815 by #R$2209) to rotate the
* *other* half of the same three vectors #R$221B rotates - ($F7CE,
* $F7D0) always via #R$2450, plus ($F7D4,$F7D6) and ($F7DA,$F7DC) when
* bit 3 of $F7CD is clear, applied inline the same way #R$221B does.
* See that routine for the full picture: together the two calls rotate
* three 3D vectors: the object's position (always updated) and its side
* and nose vectors (#R$F7D4, #R$F7DA), unless it's the planet, the sun
* or an explosion (bit 3 of #R$F7CD).
* 
* I:$F7CE/$F7D0/$F7D4/$F7D6/$F7DA/$F7DC The three vectors' first halves
* I:$F7CD Object status byte (bit 3 gates the two orientation vectors)
step_roll_rotation:                                        ; >22c0
       li   ix,live_roll_coeff_table                       ; LD IX,$EB76       ; IX -> the live roll-rotation coefficient table
       mov  @object_position_x,bc                          ; LD BC,($F7CE)     ; BC = X, the always-on vector's first half
       mov  @object_position_y,de                          ; LD DE,($F7D0)     ; DE = Y, its second half
       .call @rotate_pair                                  ; CALL $2450        ; rotate (X,Y) by one roll step
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; store X'
       mov  de,@object_position_y                          ; LD ($F7D0),DE     ; store Y'
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; HL -> the object status byte
       movb *hl,r0                                         ; BIT 3,(HL)        ; test whether the two orientation vectors need rotating too
       andi r0,>0800                                       ;                   
       jeq  !                                              ; RET NZ            ; bit set - skip them, we're done
       .ret                                                ;                   
!
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; the roof vector needs working out again (#R$4599)
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       ab   one,*hl                                        ; INC (HL)          ; bump the counter at $F7E8 (clamped/reset by #R$4503)
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; HL = X of the first orientation vector
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = X.cos
       .push hl                                            ; PUSH HL           ; save X.cos
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; HL = Y of the first orientation vector
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = Y.sin
       .pop de                                             ; POP DE            ; DE = X.cos
       .ex_de_hl                                           ; EX DE,HL          ; HL = X.cos, DE = Y.sin
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = X.cos - Y.sin = X' (before sign check)
       jlt  !                                              ; JP P,$22FF        ; already positive - no conversion needed
       b    @step_roll_side_x                              ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate L...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into H...
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...and set the sign bit (sign-magnitude form)
step_roll_side_x:                                          ; >22ff
       .push hl                                            ; PUSH HL           ; save X'
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; HL = X again
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = X.sin
       .push hl                                            ; PUSH HL           ; save X.sin
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; HL = Y again
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = Y.cos
       .pop de                                             ; POP DE            ; DE = X.sin
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = Y.cos + X.sin = Y' (before sign check)
       jlt  !                                              ; JP P,$231C        ; already positive - no conversion needed
       b    @step_roll_side_y                              ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate L...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into H...
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...and set the sign bit (sign-magnitude form)
step_roll_side_y:                                          ; >231c
       mov  hl,@side_vector_y                              ; LD ($F7D6),HL     ; store Y'
       .pop hl                                             ; POP HL            ; HL = X' (saved earlier)
       mov  hl,@side_vector                                ; LD ($F7D4),HL     ; store X'
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; HL = X of the second orientation vector
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = X.cos
       .push hl                                            ; PUSH HL           ; save X.cos
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = Y of the second orientation vector
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = Y.sin
       .pop de                                             ; POP DE            ; DE = X.cos
       .ex_de_hl                                           ; EX DE,HL          ; HL = X.cos, DE = Y.sin
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = X.cos - Y.sin = X' (before sign check)
       jlt  !                                              ; JP P,$2340        ; already positive - no conversion needed
       b    @step_roll_nose_x                              ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate L...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into H...
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...and set the sign bit (sign-magnitude form)
step_roll_nose_x:                                          ; >2340
       .push hl                                            ; PUSH HL           ; save X'
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; HL = X again
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = X.sin
       .push hl                                            ; PUSH HL           ; save X.sin
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = Y again
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = Y.cos
       .pop de                                             ; POP DE            ; DE = X.sin
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = Y.cos + X.sin = Y' (before sign check)
       jlt  !                                              ; JP P,$235D        ; already positive - no conversion needed
       b    @step_roll_nose_y                              ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate L...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into H...
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...and set the sign bit (sign-magnitude form)
step_roll_nose_y:                                          ; >235d
       mov  hl,@nose_vector_y                              ; LD ($F7DC),HL     ; store Y'
       .pop hl                                             ; POP HL            ; HL = X' (saved earlier)
       mov  hl,@nose_vector                                ; LD ($F7DA),HL     ; store X'
       .ret                                                ; RET               ; 

********************************************************************************
* Pitch the object by angle A
* 
* Used by the routines at #R$1C5C, #R$1E5A, #R$2758 and #R$2EB2.
* .
* Sets the nose vector to nose * cos + roof * sin, using the rotation
* record for angle A (#R$21DA) at #R$E7FC. The roof vector, which is the
* cross product of the nose and side vectors, is worked out first
* (#R$4599) and marked as needing working out again afterwards (bit 7 of
* #R$F7CD). Counts the rotation in #R$F7E8, so that #R$4503 can straighten
* the orientation every so often.
* 
* I:A The angle, in half-degrees (see #R$21DA)
pitch_object:                                              ; >2365
       li   de,pitch_roll_rotation                         ; LD DE,$E7FC       ; set up the rotation record for angle A
       .call @lookup_rotation_coeffs                       ; CALL $21DA        ; (#R$21DA)
       li   ix,pitch_roll_rotation                         ; LD IX,$E7FC       ; IX -> the rotation record
       .call @work_out_roof                                ; CALL $4599        ; make sure the roof vector is up to date (#R$4599)
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; it will need working out again
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; HL = roof.x
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = roof.x * sin (#R$24A7)
       .push hl                                            ; PUSH HL           ; save it
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; HL = nose.x
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = nose.x * cos (#R$24D1)
       .pop de                                             ; POP DE            ; 
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = nose.x * cos + roof.x * sin
       jlt  !                                              ; JP P,$2393        ; positive - store it
       b    @pitch_object_nose_x                           ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
pitch_object_nose_x:                                       ; >2393
       mov  hl,@nose_vector                                ; LD ($F7DA),HL     ; store the new nose.x
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; HL = roof.y
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = roof.y * sin
       .push hl                                            ; PUSH HL           ; 
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = nose.y
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = nose.y * cos
       .pop de                                             ; POP DE            ; 
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = nose.y * cos + roof.y * sin
       jlt  !                                              ; JP P,$23B2        ; positive - store it
       b    @pitch_object_nose_y                           ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
pitch_object_nose_y:                                       ; >23b2
       mov  hl,@nose_vector_y                              ; LD ($F7DC),HL     ; store the new nose.y
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; HL = roof.z
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = roof.z * sin
       .push hl                                            ; PUSH HL           ; 
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; HL = nose.z
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = nose.z * cos
       .pop de                                             ; POP DE            ; 
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = nose.z * cos + roof.z * sin
       jlt  !                                              ; JP P,$23D1        ; positive - store it
       b    @pitch_object_nose_z                           ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
pitch_object_nose_z:                                       ; >23d1
       mov  hl,@nose_vector_z                              ; LD ($F7DE),HL     ; store the new nose.z
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       ab   one,*hl                                        ; INC (HL)          ; count the rotation
       .ret                                                ; RET               ; 

********************************************************************************
* Roll the object by angle A
* 
* Used by the routines at #R$1C5C, #R$254C, #R$2758, #R$27B3 and #R$2EB2.
* .
* Sets the side vector to side * cos - roof * sin, using the rotation
* record for angle A (#R$21DA) at #R$E7FC. Otherwise the same as #R$2365.
* 
* I:A The angle, in half-degrees (see #R$21DA)
roll_object:                                               ; >23d9
       li   de,pitch_roll_rotation                         ; LD DE,$E7FC       ; set up the rotation record for angle A
       .call @lookup_rotation_coeffs                       ; CALL $21DA        ; (#R$21DA)
       li   ix,pitch_roll_rotation                         ; LD IX,$E7FC       ; IX -> the rotation record
       .call @work_out_roof                                ; CALL $4599        ; make sure the roof vector is up to date (#R$4599)
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; it will need working out again
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; HL = side.x
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = side.x * cos (#R$24D1)
       .push hl                                            ; PUSH HL           ; save it
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; HL = roof.x
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = roof.x * sin (#R$24A7)
       .pop de                                             ; POP DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = side.x * cos - roof.x * sin
       jlt  !                                              ; JP P,$2408        ; positive - store it
       b    @roll_object_side_x                            ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
roll_object_side_x:                                        ; >2408
       mov  hl,@side_vector                                ; LD ($F7D4),HL     ; store the new side.x
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; HL = side.y
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = side.y * cos
       .push hl                                            ; PUSH HL           ; 
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; HL = roof.y
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = roof.y * sin
       .pop de                                             ; POP DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = side.y * cos - roof.y * sin
       jlt  !                                              ; JP P,$2428        ; positive - store it
       b    @roll_object_side_y                            ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
roll_object_side_y:                                        ; >2428
       mov  hl,@side_vector_y                              ; LD ($F7D6),HL     ; store the new side.y
       mov  @side_vector_z,hl                              ; LD HL,($F7D8)     ; HL = side.z
       .call @multiply_by_cos                              ; CALL $24D1        ; HL = side.z * cos
       .push hl                                            ; PUSH HL           ; 
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; HL = roof.z
       .call @multiply_by_sin                              ; CALL $24A7        ; HL = roof.z * sin
       .pop de                                             ; POP DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = side.z * cos - roof.z * sin
       jlt  !                                              ; JP P,$2448        ; positive - store it
       b    @roll_object_side_z                            ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
roll_object_side_z:                                        ; >2448
       mov  hl,@side_vector_z                              ; LD ($F7D8),HL     ; store the new side.z
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       ab   one,*hl                                        ; INC (HL)          ; count the rotation
       .ret                                                ; RET               ; 

********************************************************************************
* Rotate a pair of coordinates
* 
* Used by the routines at #R$221B and #R$22C0.
* .
* Used by #R$221B and #R$22C0. Returns X' = X.cos - Y.sin and Y' = X.sin +
* Y.cos, with the rotation's cos (IX+0 to IX+2, #R$24D1) and sin (IX+3 to
* IX+5, #R$24A7), converting the coordinates to sign-magnitude first.
* Results out of range are saturated to -32768 or +32767 - except that, by
* a bug, a Y' below -32768 becomes $7F92 (at $249F), a large positive
* number: an overflow of the addition with carry set is a negative one,
* so it should be -32768.
* 
* I:BC Signed X coordinate
* I:DE Signed Y coordinate
* I:IX Pointer to the 6-byte rotation-coefficient table
* O:HL Rotated X'
* O:DE Rotated Y'
rotate_pair:                                               ; >2450
       czc  @bit7,b                                        ; BIT 7,B           ; Normalise BC (X) to sign-magnitude form...
       jeq  _245c                                          ; JR Z,$245C        ; already positive - skip the negate
       sb   a,a                                            ; XOR A             ; negate C: A = 0-C...
       sb   @c,a                                           ; SUB C             ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into B...
       sb   b,a                                            ; SUB B             ; 
       socb @bytes+>80,a                                   ; OR $80            ; ...and force the sign bit set (magnitude form)
       movb a,b                                            ; LD B,A            ; 
_245c:                                                     ; >245c
       czc  @bit7,d                                        ; BIT 7,D           ; ...and DE (Y) the same way
       jeq  _2468                                          ; JR Z,$2468        ; already positive - skip the negate
       sb   a,a                                            ; XOR A             ; negate E: A = 0-E...
       sb   @e,a                                           ; SUB E             ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow into D...
       sb   d,a                                            ; SUB D             ; 
       socb @bytes+>80,a                                   ; OR $80            ; ...and force the sign bit set (magnitude form)
       movb a,d                                            ; LD D,A            ; 
_2468:                                                     ; >2468
       .push de                                            ; PUSH DE           ; Save Y (needed twice: for X.sin below, and for Y.cos later)
       .push bc                                            ; PUSH BC           ; Save X (needed again later, for X.sin)
       .push de                                            ; PUSH DE           ; Save Y again (consumed next, for Y.sin)
       movb b,h                                            ; LD H,B            ; 
       movb @c,@l                                          ; LD L,C            ; 
       .call @multiply_by_cos                              ; CALL $24D1        ; X.cos
       .ex_sp_hl                                           ; EX (SP),HL        ; Stash X.cos's low word; HL = the saved Y
       .call @multiply_by_sin                              ; CALL $24A7        ; Y.sin
       .pop de                                             ; POP DE            ; DE = X.cos's low word
       .ex_de_hl                                           ; EX DE,HL          ; HL = X.cos, DE = Y.sin
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; X' = X.cos - Y.sin
       ; JP PO,$2486                                       ; JP PO,$2486       ; TODO: check code. No overflow - use it as-is
       joc  clamp_rotation_x                               ; JR C,$2483        ; TODO: check code. Overflow: pick which extreme to saturate to
       li   hl,>8000                                       ; LD HL,$8000       ; -32768, the low saturate extreme
       jmp  rotate_pair_x_done                             ; JR $2486          ; join the "stash X'" path
clamp_rotation_x:                                          ; >2483
       li   hl,>7fff                                       ; LD HL,$7FFF       ; +32767, the high saturate extreme
rotate_pair_x_done:                                        ; >2486
       mov  hl,@rotate_pair_x                              ; LD ($E802),HL     ; Stash X' while computing Y'
       .pop hl                                             ; POP HL            ; HL = the saved X
       .call @multiply_by_sin                              ; CALL $24A7        ; X.sin
       .ex_sp_hl                                           ; EX (SP),HL        ; Stash X.sin's low word; HL = the saved Y
       .call @multiply_by_cos                              ; CALL $24D1        ; Y.cos
       .pop de                                             ; POP DE            ; DE = X.sin's low word
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; Y' = X.sin + Y.cos
       ; JP PO,$24A2                                       ; JP PO,$24A2       ; TODO: check code. No overflow - use it as-is
       joc  clamp_rotation_y                               ; JR C,$249F        ; TODO: check code. Overflow: positive (no carry) or negative (carry)?
       li   hl,>7fff                                       ; LD HL,$7FFF       ; +32767, the high saturate extreme
       jmp  rotate_pair_y_done                             ; JR $24A2          ; join the "combine with X'" path
clamp_rotation_y:                                          ; >249f
       li   hl,>7f92                                       ; LD HL,$7F92       ; negative: a bug - should be $8000 (-32768)
rotate_pair_y_done:                                        ; >24a2
       .ex_de_hl                                           ; EX DE,HL          ; DE = Y'
       mov  @rotate_pair_x,hl                              ; LD HL,($E802)     ; HL = the stashed X'
       .ret                                                ; RET               ; 

********************************************************************************
* Multiply by a rotation record's sine
* 
* Used by the routines at #R$221B, #R$22C0, #R$2365, #R$23D9 and #R$2450.
* .
* Returns HL * sin, where sin is the 24-bit value at IX+3 in a rotation
* record from #R$21DA (bits 0-22, with $400000 = 1), rounded to the
* nearest integer. The result's sign is the input's sign XOR bit 7 of
* IX+5, which #R$21DA sets for a negative turn rate - sin(-t) is -sin(t),
* whereas cos(-t) is cos(t), so #R$24D1 needs no such bit. The
* multiplication itself is shared with #R$24D1 (from $24F5).
* 
* I:HL Number (sign-magnitude, 15-bit magnitude)
* I:IX Pointer to the rotation record
* O:HL HL * sin, rounded (two's complement)
multiply_by_sin:                                           ; >24a7
       movb @>05(ix),a                                     ; LD A,(IX+$05)     ; 
       ; XOR H                                             ; XOR H             ; TODO: check code. combine the sign of sin with the input's
       .ex_af_af_                                          ; EX AF,AF'         ; save the result's sign
       szcb @bit7,h                                        ; RES 7,H           ; H:L -> pure magnitude
       mov  hl,@multiply_trig_workspace                    ; LD ($E804),HL     ; 
       movb @>03(ix),a                                     ; LD A,(IX+$03)     ; low byte of sin
       .call @multiply_16x8                                ; CALL $1F86        ; magnitude * coeff0
       .push af                                            ; PUSH AF           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @multiply_trig_workspace,hl                    ; LD HL,($E804)     ; 
       movb @>04(ix),a                                     ; LD A,(IX+$04)     ; middle byte
       .call @multiply_16x8                                ; CALL $1F86        ; magnitude * coeff1
       .push af                                            ; PUSH AF           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @multiply_trig_workspace,hl                    ; LD HL,($E804)     ; 
       movb @>05(ix),a                                     ; LD A,(IX+$05)     ; top byte, without the sign bit
       andi a,>7f00                                        ; AND $7F           ; 
       .call @multiply_16x8                                ; CALL $1F86        ; magnitude * coeff2
       jmp  _24f5                                          ; JR $24F5          ; 

********************************************************************************
* Multiply by a rotation record's cosine
* 
* Used by the routines at #R$221B, #R$22C0, #R$2365, #R$23D9 and #R$2450.
* .
* Returns HL * cos, where cos is the 24-bit value at IX+0 in a rotation
* record from #R$21DA ($400000 = 1), rounded to the nearest integer, with
* the input's sign. Multiplies the magnitude by each of the value's three
* bytes (#R$1F86), adds the three products at their byte positions into
* IY:HL:A, and takes bits 22-37 of the total, rounding with bit 21 - i.e.
* round(magnitude * cos / 2^22), confirmed by emulation. Note that the
* input is sign-magnitude but the result is two's complement.
* 
* I:HL Number (sign-magnitude, 15-bit magnitude)
* I:IX Pointer to the rotation record
* O:HL HL * cos, rounded (two's complement)
multiply_by_cos:                                           ; >24d1
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; 
       .ex_af_af_                                          ; EX AF,AF'         ; save the input's sign
       szcb @bit7,h                                        ; RES 7,H           ; H:L -> pure magnitude
       mov  hl,@multiply_trig_workspace                    ; LD ($E804),HL     ; 
       movb *ix,a                                          ; LD A,(IX+$00)     ; low byte of cos
       .call @multiply_16x8                                ; CALL $1F86        ; magnitude * coeff0
       .push af                                            ; PUSH AF           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @multiply_trig_workspace,hl                    ; LD HL,($E804)     ; 
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; middle byte
       .call @multiply_16x8                                ; CALL $1F86        ; magnitude * coeff1
       .push af                                            ; PUSH AF           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @multiply_trig_workspace,hl                    ; LD HL,($E804)     ; 
       movb @>02(ix),a                                     ; LD A,(IX+$02)     ; top byte
       .call @multiply_16x8                                ; CALL $1F86        ; magnitude * coeff2
* This entry point is used by the routine at #R$24A7.
_24f5:                                                     ; >24f5
       li   iy,>0000                                       ; LD IY,$0000       ; IY:HL:A accumulator := coeff2's product (the live A:HL)
       .pop bc                                             ; POP BC            ; BC = coeff1's product, low 16 bits
       .pop de                                             ; POP DE            ; DE = coeff1's product, high byte (D) + flags (discarded)
       movb b,@e                                           ; LD E,B            ; 
       movb @c,b                                           ; LD B,C            ; 
       sb   @c,@c                                          ; LD C,$00          ; Realign coeff1's 24-bit product 8 bits up (DE:BC = product1 << 8)...
       a    bc,iy                                          ; ADD IY,BC         ; 
       a    de,hl                                          ; ADC HL,DE         ; 
       ab   @c,a                                           ; ADC A,C           ; ...and add it in
       .pop bc                                             ; POP BC            ; BC = coeff0's product, low 16 bits
       .pop de                                             ; POP DE            ; DE = coeff0's product, high byte (D) + flags (discarded)
       movb d,@e                                           ; LD E,D            ; 
       sb   d,d                                            ; LD D,$00          ; Realign coeff0's product to its natural (unshifted) position...
       a    bc,iy                                          ; ADD IY,BC         ; 
       a    de,hl                                          ; ADC HL,DE         ; 
       ab   d,a                                            ; ADC A,D           ; ...and add it in too
       a    hl,hl                                          ; ADD HL,HL         ; Shift A:H:L left 2 bits (IY, the lowest 16 bits, is now
       sla  a,1                                            ; RLA               ; TODO: check code. spent - only its carry-out into HL mattered, for
       a    hl,hl                                          ; ADD HL,HL         ; rounding precision)...
       sla  a,1                                            ; RLA               ; TODO: check code. 
       ; RL L                                              ; RL L              ; TODO: check code. ...and one more bit into L, whose carry-out is the round-to-nearest bit tested below
       movb h,@l                                           ; LD L,H            ; Result := {A,H} (L is discarded - it only existed to
       movb a,h                                            ; LD H,A            ; capture that rounding bit)
       jnc  _2519                                          ; JR NC,$2519       ; TODO: check code. 
       inc  hl                                             ; INC HL            ; Round up if the dropped bit was set
_2519:                                                     ; >2519
       .ex_af_af_                                          ; EX AF,AF'         ; result negative?
       jlt  !                                              ; RET P             ; no - done
       .ret                                                ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; yes - negate it (two's complement)
       .ret                                                ; RET               ; 

********************************************************************************
* Rotation coefficients for a 30-degree turn
* 
* A 6-byte record in the same format as the table at #R$121B: cos 30
* degrees ($376CF5 / $400000 = 0.866) then sin 30 degrees ($200000 /
* $400000 = 0.5), as 24-bit values. #R$21DA uses it instead of the table
* for a turn rate of +/-127 ($7F), as used to spin the title screen's
* "ELITE" letters (#R$1E5A, #R$1E96).
rotation_30_degrees:                                       ; >2522
       byte >F5,>6C,>37                                              ; cos 30 degrees
       byte >00,>00,>20                                              ; sin 30 degrees

********************************************************************************
* Run the object's handler
* 
* Used by the routines at #R$13FD and #R$1703.
* .
* Called for each object by the main loop (#R$13FD) and the death scene
* (#R$1703). If bit 5 of the object's status byte is set, stores the
* status byte in #R$E943, which makes #R$15E7 raise the alert level.
* Then jumps to the handler for the object's handler type ($F7EE) from
* the table at #R$288D.
run_object_handler:                                        ; >2528
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = the object status byte
       andi a,>2000                                        ; AND $20           ; test bit 5
       jeq  _2532                                          ; JR Z,$2532        ; bit 5 clear
       movb a,@hostile_about                               ; LD ($E943),A      ; bit 5 set: note it for the alert level (#R$E943)
_2532:                                                     ; >2532
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = handler type
       ab   a,a                                            ; ADD A,A           ; A = type * 2 (word index)
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; HL = that word index
       li   bc,object_handler_table                        ; LD BC,$288D       ; BC -> the handler table
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this type's table entry
       movb *hl,a                                          ; LD A,(HL)         ; read the entry (little-endian word)...
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; ...HL = this type's handler address
       b    *hl                                            ; JP (HL)           ; TODO. 

********************************************************************************
* Continue the handler only on this object's turn
* 
* Used by the routines at #R$2641, #R$265E, #R$26A9, #R$27C0 and #R$27F4.
* .
* Called by several object handlers before work that only needs doing
* every third frame. Returns normally (so the handler carries on) if the
* object's turn number ($F7ED) matches the 3-2-1 counter at #R$E92E;
* otherwise returns from the handler as well. Its final RET is also the
* handler for types 0 and 13 (see #R$288D).
every_third_frame:                                         ; >2542
       movb @turn_number,a                                 ; LD A,($F7ED)      ; A = this object's turn number
       li   hl,current_turn                                ; LD HL,$E92E       ; HL -> the live cycling counter
       cb   a,*hl                                          ; CP (HL)           ; this object's frame to do extra work?
       jne  !                                              ; RET Z             ; yes - nothing more for this (no-op) handler anyway
       .ret                                                ;                   
!
       .pop hl                                             ; POP HL            ; no - skip an extra return level too
handler_none:                                              ; >254b
       .ret                                                ; RET               ; handler types 0 and 13: nothing to do

********************************************************************************
* Handler type 2: space station
* 
* Rolls the station (#R$23D9, rate 4) while it's on screen (($EF98) set by
* #R$4255).
handler_space_station:                                     ; >254c
       movb @ef98_per_object_flag,a                        ; LD A,($EF98)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; not on screen
       .ret                                                ;                   
!
       movb @bytes+>04,a                                   ; LD A,$04          ; 
       b    @roll_object                                   ; JP $23D9          ; roll

********************************************************************************
* Handler type 1: explosion
* 
* Counts ($F7EF) down; until it runs out, adds ($F7EF) / 8 to ($F7F0) each
* frame (up to $FF) - or subtracts it (at $2573) once the game is over
* (#R$F749), as in the death scene (#R$1703).
* .
* When the count runs out (at $2578), removes the object (#R$30A9). Then,
* unless bit 6 of its status byte (#R$F7CD) says there's no bounty for it
* (because it was destroyed by a collision, the ECM or the energy bomb, or
* is a missile or cargo), shows the bounty for it (($F80B), in tenths of a
* credit: "Bounty: <n> credits", #R$28AD) and adds it to the cash (#R$EB16)
* - or shows "No bounty!" (at $25B3) if it's 0.
handler_explosion:                                         ; >2556
       li   hl,handler_countdown                           ; LD HL,$F7EF       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jeq  deactivate_and_award_bounty                    ; JR Z,$2578        ; run out - remove the object, pay the bounty
       movb *hl,a                                          ; LD A,(HL)         ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; 
       movb a,@c                                           ; LD C,A            ; C = countdown / 8
* @label=*
_2563:                                                     ; >2563
       movb @game_over,a                                   ; LD A,($F749)      ; 
       socb a,a                                            ; OR A              ; game over?
       movb @per_type_parameter_block,a                    ; LD A,($F7F0)      ; 
       jne  step_f7f0_down_by_c                            ; JR NZ,$2573       ; yes - subtract instead
       ab   @c,a                                           ; ADD A,C           ; 
       jnc  _2571                                          ; JR NC,$2571       ; TODO: check code. 
       movb @b255,a                                        ; LD A,$FF          ; 
_2571:                                                     ; >2571
       jmp  _2574                                          ; JR $2574          ; 
step_f7f0_down_by_c:                                       ; >2573
       sb   @c,a                                           ; SUB C             ; A = #R$F7F0 - C
_2574:                                                     ; >2574
       movb a,@per_type_parameter_block                    ; LD ($F7F0),A      ; store the stepped value back
       .ret                                                ; RET               ; 
deactivate_and_award_bounty:                               ; >2578
       .call @remove_object                                ; CALL $30A9        ; deactivate the current object
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = its status byte
       andi a,>4000                                        ; AND $40           ; no bounty for it (bit 6)?
       jeq  !                                              ; RET NZ            ; none - done
       .ret                                                ;                   
!
       mov  @bp_bounty,hl                                  ; LD HL,($F80B)     ; HL = the bounty amount
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; is it zero?
       jeq  print_no_bounty                                ; JR Z,$25B3        ; yes - print "No bounty!" instead
       movb @l,@c                                          ; LD C,L            ; no: C = the bounty's low byte
       movb h,@l                                           ; LD L,H            ; HL = the bounty's high byte, as a byte value
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>c5,a                                   ; LD A,$C5          ; control byte: pad to width 5, decimal-point handling
       li   ix,bounty_digit_buffer                         ; LD IX,$28B4       ; IX -> the digit-format buffer
       .call @format_number                                ; CALL $3675        ; format the bounty amount into it
       szcb @bit7,@>ffffffff(ix)                           ; RES 7,(IX-$01)    ; clear the last digit's high-bit terminator flag
       li   hl,msg_bounty                                  ; LD HL,$28AD       ; HL -> "(Bounty:" + the just-formatted amount
       .call @show_view_message                            ; CALL $39C8        ; print the compound bounty message
       mov  @player_cash,hl                                ; LD HL,($EB16)     ; 
       movb @cash_2,a                                      ; LD A,($EB18)      ; 
       mov  @bp_bounty,de                                  ; LD DE,($F80B)     ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   @zero,a                                        ; ADC A,$00         ; 
       mov  hl,@player_cash                                ; LD ($EB16),HL     ; 
       movb a,@cash_2                                      ; LD ($EB18),A      ; 
       .ret                                                ; RET               ; 
print_no_bounty:                                           ; >25b3
       li   hl,msg_no_bounty                               ; LD HL,$28C1       ; HL -> "No bounty!"
       b    @show_view_message                             ; JP $39C8          ; print it

********************************************************************************
* Handler type 3: the player's missile
* 
* Steers the missile towards its target (the object in the slot in ($F7EF),
* #R$2EB2) and keeps it at speed (minimum 10). If the target's blueprint
* says it has no ECM ((IY+$13) bit 7 clear), goes on to $25FF to see
* whether it has hit. Otherwise - unless the player's ECM jammer is on and
* the target isn't the space station - the target may set off its ECM
* (always when close, else a 25/256 chance), destroying the missile: plays
* the ECM sound, sets #R$EEC0 and shows the "E" indicator (#R$6B12).
* .
* At $25FF, if the target is within its blueprint's distance (IY+$10),
* removes the missile (#R$30A9), destroys the target (#R$31AD, which also
* scores the kill), spawns #R$8DB9's objects and plays the explosion sound.
handler_player_missile:                                    ; >25b9
       movb @handler_countdown,a                           ; LD A,($F7EF)      ; 
       .call @set_reference_point                          ; CALL $2FF9        ; use the target's position as the reference point
       .call @steer_towards_point                          ; CALL $2EB2        ; steer towards it
       movb @bytes+>0a,@c                                  ; LD C,$0A          ; 
       .call @speed_up_or_slow_down                        ; CALL $2869        ; speed up or slow down
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; 
       .call @get_blueprint                                ; CALL $2FE9        ; IY -> the target's blueprint data
       movb @>13(iy),a                                     ; LD A,(IY+$13)     ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$25FF        ; no ECM - check for a hit
       b    @player_missile_hit                            ;                   
!
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; 
       cb   a,one                                          ; CP $01            ; 
       jeq  _25e1                                          ; JR Z,$25E1        ; the space station
       movb @jammer_active_flag,a                          ; LD A,($EFA8)      ; 
       socb a,a                                            ; OR A              ; 
       jne  player_missile_hit                             ; JR NZ,$25FF       ; player's jammer on - no ECM
_25e1:                                                     ; >25e1
       movb @reference_distance_hi,a                       ; LD A,($EB6F)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _25ed                                          ; JR Z,$25ED        ; close - set off the ECM
       .call @random_byte                                  ; CALL $2176        ; 
       cb   a,@bytes+>19                                   ; CP $19            ; 
       jl   !                                              ; RET NC            ; otherwise only a 25/256 chance
       .ret                                                ;                   
!
_25ed:                                                     ; >25ed
       movb @ecm_countdown,a                               ; LD A,($E912)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       movb @bytes+>08,a                                   ; LD A,$08          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 8 (ECM)
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@enemy_ecm                                   ; LD ($EEC0),A      ; 
       b    @draw_ecm_indicator                            ; JP $6B12          ; show the "E" indicator
player_missile_hit:                                        ; >25ff
       movb @>10(iy),@e                                    ; LD E,(IY+$10)     ; DE = the target's size
       sb   d,d                                            ; LD D,$00          ; 
       mov  @reference_distance,hl                         ; LD HL,($EB6E)     ; HL = distance to the target
       s    de,hl                                          ; SBC HL,DE         ; still outside the threshold?
       joc  !                                              ; RET NC            ; TODO: check code. too far
       .ret                                                ;                   
!
       .call @remove_object                                ; CALL $30A9        ; remove the missile
       .call @destroy_object                               ; CALL $31AD        ; destroy the target
       .call @spawn_cargo                                  ; CALL $8DB9        ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       b    @play_sound_effect                             ; JP $7468          ; play sound effect 2 (explosion)

********************************************************************************
* Handler type 14: a missile homing in on the player
* 
* Steers the missile towards the player (the reference point at #R$EB88
* is zeroed, #R$2EB2) and keeps it at speed (minimum 10). Once it's
* within 100, it explodes (#R$31AD) and damages the player's shields by
* 48 (#R$193F).
handler_enemy_missile:                                     ; >2618
       li   hl,reference_point_x                           ; LD HL,$EB88       ; 
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,reference_point_x+>0001                     ; LD DE,$EB89       ; 
       li   bc,>0005                                       ; LD BC,$0005       ; 
       .ldir                                               ; LDIR              ; 
       .call @steer_towards_point                          ; CALL $2EB2        ; steer towards the player
       movb @bytes+>0a,@c                                  ; LD C,$0A          ; 
       .call @speed_up_or_slow_down                        ; CALL $2869        ; speed up or slow down
       mov  @object_distance,hl                            ; LD HL,($EB8E)     ; 
       li   de,>ff9c                                       ; LD DE,$FF9C       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       jnc  !                                              ; RET C             ; TODO: check code. not within 100 yet
       .ret                                                ;                   
!
       li   ix,object_status_byte                          ; LD IX,$F7CD       ; 
       .call @destroy_object                               ; CALL $31AD        ; the missile explodes
       movb @bytes+>30,a                                   ; LD A,$30          ; 
       b    @damage_shields                                ; JP $193F          ; damage the player's shields by 48

********************************************************************************
* Handler type 5: fly on, then turn away and attack
* 
* As type 4 (#R$265E): when the ship comes close to the player, or is
* 900 or more away from the space station, it turns away (#R$281E) - but
* then flies on for a while (type 8) and attacks (type 6).
handler_turn_then_attack:                                  ; >2641
       .call @speed_up_or_slow_down                        ; CALL $2869        ; speed up or slow down
       .call @close_to_player                              ; CALL $2744        ; range-check
       joc  _2656                                          ; JR C,$2656        ; TODO: check code. close - turn away (below)
       .call @every_third_frame                            ; CALL $2542        ; every third frame only
       movb one,a                                          ; LD A,$01          ; 
       .call @distance_to_object                           ; CALL $3113        ; HL = distance to the space station
       li   de,>fc7c                                       ; LD DE,$FC7C       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  !                                              ; RET NC            ; TODO: check code. within 900
       .ret                                                ;                   
!
_2656:                                                     ; >2656
       movb @bytes+>08,a                                   ; LD A,$08          ; 
       movb a,@next_handler_type                           ; LD ($F7F3),A      ; type 8 after turning away
       b    @start_turning_away                            ; JP $281E          ; turn away (type 7)

********************************************************************************
* Handler type 4: fly on, then turn away and leave
* 
* Speeds up or slows down (#R$2869). When the ship comes close to the
* player (#R$2744), or (checked every third frame) is 900 or more away
* from the space station (#R$3113), it turns away - a single turning
* phase with a random direction - and then leaves (handler type 12).
handler_turn_then_leave:                                   ; >265e
       .call @speed_up_or_slow_down                        ; CALL $2869        ; speed up or slow down
       .call @close_to_player                              ; CALL $2744        ; range-check
       joc  _2673                                          ; JR C,$2673        ; TODO: check code. close - turn away (below)
       .call @every_third_frame                            ; CALL $2542        ; every third frame only
       movb one,a                                          ; LD A,$01          ; 
       .call @distance_to_object                           ; CALL $3113        ; HL = distance to the space station
       li   de,>fc7c                                       ; LD DE,$FC7C       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  !                                              ; RET NC            ; TODO: check code. within 900
       .ret                                                ;                   
!
_2673:                                                     ; >2673
       li   hl,>0168                                       ; LD HL,$0168       ; 
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       sb   @bytes+>0e,a                                   ; SUB $0E           ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       jnc  _2681                                          ; JR NC,$2681       ; TODO: check code. 
       li   hl,>021c                                       ; LD HL,$021C       ; 
_2681:                                                     ; >2681
       .push af                                            ; PUSH AF           ; 
       movb @bp_manoeuvrability,a                          ; LD A,($F806)      ; 
       .call @divide_hl_a                                  ; CALL $2079        ; scale HL by $F806
       movb @l,a                                           ; LD A,L            ; 
       movb a,@handler_countdown                           ; LD ($F7EF),A      ; phase 1's countdown
       .pop af                                             ; POP AF            ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       movb @bp_manoeuvrability,a                          ; LD A,($F806)      ; 
       jnc  _2695                                          ; JR NC,$2695       ; TODO: check code. 
       neg a                                               ; NEG               ; randomly sign-flip $F806's value
_2695:                                                     ; >2695
       sra  a,1                                            ; SRA A             ; halve it, keeping the sign
       movb a,@per_type_parameter_block                    ; LD ($F7F0),A      ; phase 1's rotation rate
       sb   a,a                                            ; XOR A             ; 
       movb a,@turn_phase_2_length                         ; LD ($F7F1),A      ; phase 2's countdown = 0 (already expired)
       movb @bytes+>07,a                                   ; LD A,$07          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 7: turn away
       movb @bytes+>0c,a                                   ; LD A,$0C          ; 
       movb a,@next_handler_type                           ; LD ($F7F3),A      ; type 12 after turning away
       .ret                                                ; RET               ; 

********************************************************************************
* Handler type 6: attack the player
* 
* Marks the ship as hostile (bit 5 of its status byte, see #R$2528). A
* pirate ((($F807) AND $1C) = 4) inside the space station's safe zone
* (#R$EB05) leaves instead (type 12). When the ship is within 1500 and
* speeding up, the player isn't cloaked (#R$EF9F) and a random roll beats
* its aggression (($F80A)), it fires: plays the laser sound and, with a
* 180/256 chance, damages the player's shields (#R$193F) - by 6 for a
* Constrictor (ship type $1F), otherwise by a random amount limited by the
* player's rank (#R$28CB). Then, if it has come close to the player
* (#R$2744), it turns away (type 7, then 8); otherwise it steers towards
* the player ($2723).
* .
* At $2723, every third frame (except for ship types $1E and $1F), steers
* the ship towards the player - the reference point at #R$EB88 is zeroed,
* i.e. the player's position (#R$2EB2) - then speeds up or slows down
* (#R$2869, minimum 10).
handler_attack:                                            ; >26a9
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       socb @bit5,*hl                                      ; SET 5,(HL)        ; hostile
       movb @station_in_range,a                            ; LD A,($EB05)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _26c2                                          ; JR Z,$26C2        ; not in the safe zone
       movb @bp_class,a                                    ; LD A,($F807)      ; 
       andi a,>1c00                                        ; AND $1C           ; 
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  _26c2                                          ; JR NZ,$26C2       ; not a pirate
       movb @bytes+>0c,a                                   ; LD A,$0C          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; pirate in the safe zone: leave
_26c2:                                                     ; >26c2
       mov  @object_distance,hl                            ; LD HL,($EB8E)     ; 
       li   de,>fa24                                       ; LD DE,$FA24       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _2716                                          ; JR C,$2716        ; TODO: check code. 1500 or more away - don't fire
       movb @speed_up_flag,a                               ; LD A,($F7F4)      ; A = speed-up flag
       socb a,a                                            ; OR A              ; 
       jeq  _2716                                          ; JR Z,$2716        ; slowing down - skip the cascade below
       movb @cloaking_active_flag,a                        ; LD A,($EF9F)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _2716                                          ; JR NZ,$2716       ; player cloaked
       .call @random_byte                                  ; CALL $2176        ; 
       li   hl,bp_aggression                               ; LD HL,$F80A       ; 
       cb   a,*hl                                          ; CP (HL)           ; 
       jhe  _2716                                          ; JR NC,$2716       ; roll failed
       movb @flight_controls_off,a                         ; LD A,($EF8E)      ; flight controls off?
       socb a,a                                            ; OR A              ; 
       jne  _2716                                          ; JR NZ,$2716       ; yes - don't fire
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@ship_fired                                  ; LD ($E92D),A      ; 
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 3 (laser)
       .call @random_byte                                  ; CALL $2176        ; 
       cb   a,@bytes+>b4                                   ; CP $B4            ; 
       jhe  _2716                                          ; JR NC,$2716       ; missed
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       cb   a,@bytes+>1f                                   ; CP $1F            ; a Constrictor?
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       jeq  _2713                                          ; JR Z,$2713        ; yes - damage 6
       mov  @combat_rank,hl                                ; LD HL,($EB12)     ; 
       sb   h,h                                            ; LD H,$00          ; 
       li   bc,laser_damage_by_rank                        ; LD BC,$28CB       ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb *hl,@c                                         ; LD C,(HL)         ; 
_270a:                                                     ; >270a
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>0700                                        ; AND $07           ; 
       cb   a,@c                                           ; CP C              ; 
       jhe  _270a                                          ; JR NC,$270A       ; 
       ab   one,a                                          ; INC A             ; A = 1 to the limit for the player's rank
_2713:                                                     ; >2713
       .call @damage_shields                               ; CALL $193F        ; damage the player's shields
_2716:                                                     ; >2716
       .call @close_to_player                              ; CALL $2744        ; range-check
       jnc  attack_steer                                   ; JR NC,$2723       ; TODO: check code. 
       movb @bytes+>08,a                                   ; LD A,$08          ; 
       movb a,@next_handler_type                           ; LD ($F7F3),A      ; type 8 after turning away
       b    @start_turning_away                            ; JP $281E          ; turn away (type 7)
attack_steer:                                              ; >2723
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>1f                                   ; CP $1F            ; is it $1F?
       jeq  _272f                                          ; JR Z,$272F        ; yes - skip the stagger gate
       cb   a,@bytes+>1e                                   ; CP $1E            ; is it $1E?
       jeq  !                                              ; CALL NZ,$2542     ; 
       .call @every_third_frame                            ;                   
!
_272f:                                                     ; >272f
       li   hl,reference_point_x                           ; LD HL,$EB88       ; HL -> the reference-point vector
       sb   *hl,*hl                                        ; LD (HL),$00       ; zero its first byte
       li   de,reference_point_x+>0001                     ; LD DE,$EB89       ; DE -> the rest of it
       li   bc,>0005                                       ; LD BC,$0005       ; 
       .ldir                                               ; LDIR              ; zero the remaining 5 bytes too
       .call @steer_towards_point                          ; CALL $2EB2        ; recompute the proximity delta/magnitude
       movb @bytes+>0a,@c                                  ; LD C,$0A          ; C = 10, #R$2869's step argument
       b    @speed_up_or_slow_down                         ; JP $2869          ; speed up or slow down

********************************************************************************
* Check whether the object has come close to the player
* 
* Used by the routines at #R$2641, #R$265E, #R$26A9 and #R$27C0.
* .
* Compares the object's distance ($EB8E) with 480 - 4 * ($F806), a
* distance from the ship's blueprint data.
* 
* O:F Carry set if the object is closer than that
close_to_player:                                           ; >2744
       mov  @bp_manoeuvrability,hl                         ; LD HL,($F806)     ; HL = the range-check parameter
       sb   h,h                                            ; LD H,$00          ; 
       a    hl,hl                                          ; ADD HL,HL         ; HL *= 2
       a    hl,hl                                          ; ADD HL,HL         ; DE = 4 * ($F806)
       .ex_de_hl                                           ; EX DE,HL          ; DE = that scaled value
       li   hl,>01e0                                       ; LD HL,$01E0       ; HL = $01E0 (480)
       s    de,hl                                          ; SBC HL,DE         ; HL = 480 - 4 * ($F806)
       .ex_de_hl                                           ; EX DE,HL          ; DE = the threshold
       mov  @object_distance,hl                            ; LD HL,($EB8E)     ; HL = distance
       s    de,hl                                          ; SBC HL,DE         ; carry set if closer
       .ret                                                ; RET               ; 

********************************************************************************
* Handler type 7: turn away
* 
* Objects get this handler type when they come close to the player (see
* #R$2744): from types 5, 6 and 10 via #R$281E, and type 4 by setting it
* up directly. Escape capsules also start with it. Each frame the object
* speeds up (#R$2869) and turns in two phases, which run at the same time
* while they last: for ($F7EF) frames by ($F7F0) per frame about one axis
* (#R$2365), and for ($F7F1) frames by ($F7F2) about another (#R$23D9).
* When both have run out, the object switches to the handler type waiting
* in ($F7F3), still speeding up: types 12 and 11 set up their own
* countdowns, type 8 gets a 50-81 frame countdown (#R$2859), and any other
* type a 35-frame one in ($F7EF).
handler_turn_away:                                         ; >2758
       .call @speed_up_or_slow_down                        ; CALL $2869        ; speed up
       sb   @c,@c                                          ; LD C,$00          ; C = number of phases still running
       movb @handler_countdown,a                           ; LD A,($F7EF)      ; A = phase 1's remaining countdown
       socb a,a                                            ; OR A              ; 
       jeq  _2770                                          ; JR Z,$2770        ; first phase over
       li   hl,handler_countdown                           ; LD HL,$F7EF       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one frame less
       .push bc                                            ; PUSH BC           ; 
       movb @per_type_parameter_block,a                    ; LD A,($F7F0)      ; A = phase 1's rotation rate
       .call @pitch_object                                 ; CALL $2365        ; turn about the first axis
       .pop bc                                             ; POP BC            ; 
       ab   one,@c                                         ; INC C             ; 
_2770:                                                     ; >2770
       movb @turn_phase_2_length,a                         ; LD A,($F7F1)      ; A = phase 2's remaining countdown
       socb a,a                                            ; OR A              ; 
       jeq  _2783                                          ; JR Z,$2783        ; second phase over
       li   hl,turn_phase_2_length                         ; LD HL,$F7F1       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one frame less
       .push bc                                            ; PUSH BC           ; 
       movb @turn_phase_2_rate,a                           ; LD A,($F7F2)      ; A = phase 2's rotation rate
       .call @roll_object                                  ; CALL $23D9        ; turn about the second axis
       .pop bc                                             ; POP BC            ; 
       ab   one,@c                                         ; INC C             ; 
_2783:                                                     ; >2783
       movb @c,a                                           ; LD A,C            ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; still turning
       .ret                                                ;                   
!
       ab   one,a                                          ; INC A             ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; keep speeding up
       movb @next_handler_type,a                           ; LD A,($F7F3)      ; A = the staged next type
       movb a,@handler_type                                ; LD ($F7EE),A      ; switch to the next handler type
       cb   a,@bytes+>0c                                   ; CP $0C            ; 
       jne  !                                              ; RET Z             ; type 12 - done
       .ret                                                ;                   
!
       cb   a,@bytes+>0b                                   ; CP $0B            ; 
       jne  !                                              ; RET Z             ; type 11 - done
       .ret                                                ;                   
!
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jne  !                                              ; JP Z,$2859        ; type 8 - 50-81 frame countdown
       b    @countdown_and_speed_up                        ;                   
!
       movb @bytes+>23,a                                   ; LD A,$23          ; 
       movb a,@handler_countdown                           ; LD ($F7EF),A      ; otherwise a 35-frame countdown
       .ret                                                ; RET               ; 

********************************************************************************
* Handler type 8: fly on for a while, then attack again
* 
* Counts ($F7EF) down (set by #R$2859 or #R$27DF), then switches to type
* 6 (attack) and starts slowing down.
handler_fly_then_attack:                                   ; >27a1
       .call @speed_up_or_slow_down                        ; CALL $2869        ; speed up or slow down
       li   hl,handler_countdown                           ; LD HL,$F7EF       ; 
       sb   one,*hl                                        ; DEC (HL)          ; tick the countdown down
       jeq  !                                              ; RET NZ            ; not expired yet
       .ret                                                ;                   
!
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; switch back to type 6
       sb   a,a                                            ; XOR A             ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; and start slowing down
       .ret                                                ; RET               ; 

********************************************************************************
* Handler type 9: spin, fly on and leave
* 
* As type 12 (#R$27F4), but also rolls the object (#R$23D9, rate 10)
* while it's on screen (($EF98) set by #R$4255).
handler_spin_and_leave:                                    ; >27b3
       .call @handler_leave                                ; CALL $27F4        ; run entry 12's handler
       movb @ef98_per_object_flag,a                        ; LD A,($EF98)      ; on screen?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; 
       .ret                                                ;                   
!
       movb @bytes+>0a,a                                   ; LD A,$0A          ; 
       b    @roll_object                                   ; JP $23D9          ; roll

********************************************************************************
* Handler type 10: head for the planet
* 
* When the ship comes close to the player (#R$2744) it turns away and then
* leaves (type 12). Otherwise $27CD removes it once it's within 3500 of the
* planet.
* .
* At $27CD, every third frame, speeds up or slows down, and removes the
* ship (#R$30A9) if it's within 3500 of the planet (#R$3113).
handler_head_for_planet:                                   ; >27c0
       .call @close_to_player                              ; CALL $2744        ; range-check
       jnc  head_for_planet_check                          ; JR NC,$27CD       ; TODO: check code. not tripped - fall through
       movb @bytes+>0c,a                                   ; LD A,$0C          ; 
       movb a,@next_handler_type                           ; LD ($F7F3),A      ; type 12 after turning away
       b    @start_turning_away                            ; JP $281E          ; turn away (type 7)
head_for_planet_check:                                     ; >27cd
       .call @every_third_frame                            ; CALL $2542        ; every third frame only
       .call @speed_up_or_slow_down                        ; CALL $2869        ; speed up or slow down
       sb   a,a                                            ; XOR A             ; 
       .call @distance_to_object                           ; CALL $3113        ; HL = distance to the planet
       li   de,>f254                                       ; LD DE,$F254       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       jnc  !                                              ; RET C             ; TODO: check code. 3500 or more
       .ret                                                ;                   
!
       b    @remove_object                                 ; JP $30A9          ; near the planet - remove the ship

********************************************************************************
* Handler type 11: break off briefly
* 
* Sets a 10-17 frame countdown and switches to type 8, speeding up, so
* the ship flies on briefly before attacking again.
handler_break_off:                                         ; >27df
       .call @random_byte                                  ; CALL $2176        ; A = random byte
       andi a,>0700                                        ; AND $07           ; 
       ab   @bytes+>0a,a                                   ; ADD A,$0A         ; A = 10-17
       movb a,@handler_countdown                           ; LD ($F7EF),A      ; a short countdown
       movb @bytes+>08,a                                   ; LD A,$08          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; switch straight to type 8
       movb one,a                                          ; LD A,$01          ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; and speed up
       .ret                                                ; RET               ; 

********************************************************************************
* Handler type 12: fly on and leave
* 
* Used by the routine at #R$27B3.
* .
* Clears the hostile bit (bit 5 of the status byte, see #R$2528). Every
* third frame, speeds up (#R$2869), and once the ship is $1000 or more
* away removes it (#R$30A9), cancelling any missile lock on it (#R$30EA).
* Also used by type 9 (#R$27B3).
handler_leave:                                             ; >27f4
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       szcb @bit5,*hl                                      ; RES 5,(HL)        ; not hostile
       .call @every_third_frame                            ; CALL $2542        ; every third frame only
       movb one,a                                          ; LD A,$01          ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; always speeding up
       .call @speed_up_or_slow_down                        ; CALL $2869        ; speed up or slow down
       movb @object_distance_hi,a                          ; LD A,($EB8F)      ; 
       andi a,>f000                                        ; AND $F0           ; 
       jne  !                                              ; RET Z             ; less than $1000 away
       .ret                                                ;                   
!
       .call @cancel_missile_lock_on_object                ; CALL $30EA        ; cancel any missile lock on it
       b    @remove_object                                 ; JP $30A9          ; remove the ship

********************************************************************************
* Handler type 15: the escape capsule's countdown
* 
* Entry 15 in #R$288D. The Cobra left behind by the escape capsule
* (#R$19FC) switches to this handler after turning away (handler type 7).
* Counts down ($F7EF), and when it runs out, gives the player the flight
* controls back (#R$EF8E) and docks (#R$E917): the capsule has reached
* the space station.
handler_escape_capsule:                                    ; >2810
       li   hl,handler_countdown                           ; LD HL,$F7EF       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jeq  !                                              ; RET NZ            ; not yet
       .ret                                                ;                   
!
       sb   a,a                                            ; XOR A             ; 
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ; flight controls back on
       sb   one,a                                          ; DEC A             ; 
       movb a,@docking                                     ; LD ($E917),A      ; docked
       .ret                                                ; RET               ; 

********************************************************************************
* Start turning away (handler type 7)
* 
* Used by the routines at #R$2641, #R$26A9, #R$27C0 and #R$28F6.
* .
* Called by the ship handlers when the ship comes close to the player
* (#R$2744). Sets up the two turning phases for #R$2758: each gets a
* random length ((random + 45) * 4, scaled by ($F806)) in ($F7EF) and
* ($F7F1), and a turn rate of half ($F806), with a random sign, in
* ($F7F0) and ($F7F2). Then sets handler type 7 and starts the object
* speeding up. The caller has already put the handler type to switch to
* afterwards in ($F7F3).
start_turning_away:                                        ; >281e
       li   de,handler_countdown                           ; LD DE,$F7EF       ; DE -> the first countdown to fill (F7EF)
       movb @bytes+>02,b                                   ; LD B,$02          ; 2 (countdown, rate) pairs to fill
_2823:                                                     ; >2823
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .call @random_byte                                  ; CALL $2176        ; A = random byte
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; 
       li   de,>002d                                       ; LD DE,$002D       ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = random + 45
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    hl,hl                                          ; ADD HL,HL         ; HL = (random+45)*4
       movb @bp_manoeuvrability,a                          ; LD A,($F806)      ; 
       .call @divide_hl_a                                  ; CALL $2079        ; scale by ($F806)
       movb @l,a                                           ; LD A,L            ; 
       .pop de                                             ; POP DE            ; 
       movb a,*de                                          ; LD (DE),A         ; phase length
       inc  de                                             ; INC DE            ; 
       .call @random_byte                                  ; CALL $2176        ; A = another random byte
       socb a,a                                            ; OR A              ; 
       movb @bp_manoeuvrability,a                          ; LD A,($F806)      ; 
       jlt  !                                              ; JP P,$2847        ; 
       b    @start_turning_away_rate                       ;                   
!
       neg a                                               ; NEG               ; random sign
start_turning_away_rate:                                   ; >2847
       sra  a,1                                            ; SRA A             ; halve it
       movb a,*de                                          ; LD (DE),A         ; turn rate
       inc  de                                             ; INC DE            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $2823        ; next phase
       jne  _2823                                          ;                   
       movb @bytes+>07,a                                   ; LD A,$07          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 7: turn away
       movb one,a                                          ; LD A,$01          ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; and speed up
       .ret                                                ; RET               ; 

********************************************************************************
* Set a 50-81 frame countdown and start speeding up
* 
* Used by the routines at #R$2758 and #R$2A94.
* .
* Puts a random 50-81 in ($F7EF) and sets ($F7F4) so that #R$2869 speeds
* the object up. Used when #R$2758 switches an object to type 8, and by
* #R$2A94 for the ships it spawns.
countdown_and_speed_up:                                    ; >2859
       .call @random_byte                                  ; CALL $2176        ; A = random byte
       andi a,>1f00                                        ; AND $1F           ; A &= $1F (0-31)
       ab   @bytes+>32,a                                   ; ADD A,$32         ; A += 50 - countdown range 50-81
       movb a,@handler_countdown                           ; LD ($F7EF),A      ; arm the countdown
       movb one,a                                          ; LD A,$01          ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; start speeding up
       .ret                                                ; RET               ; 

********************************************************************************
* Speed up or slow down
* 
* Used by the routines at #R$25B9, #R$2618, #R$2641, #R$265E, #R$26A9, #R$2758,
* #R$27A1, #R$27C0 and #R$27F4.
* .
* Called by most of the object handlers. If ($F7F4) is set, increases the
* object's speed ($F7E6) by 4, up to the maximum in ($F802); otherwise
* slows it down by 4 (at $287F), down to the minimum in C.
* 
* I:C Minimum speed (when slowing down)
speed_up_or_slow_down:                                     ; >2869
       movb @speed_up_flag,a                               ; LD A,($F7F4)      ; A = speed-up flag
       socb a,a                                            ; OR A              ; 
       jeq  slow_down                                      ; JR Z,$287F        ; clear - slow down
       movb @object_speed,a                                ; LD A,($F7E6)      ; A = speed
       ab   @bytes+>04,a                                   ; ADD A,$04         ; speed up by 4
       li   hl,bp_max_speed                                ; LD HL,$F802       ; HL -> maximum speed
       cb   a,*hl                                          ; CP (HL)           ; 
       jeq  _287d                                          ; JR Z,$287D        ; exactly at the cap - keep it
       joc  _287d                                          ; JR C,$287D        ; TODO: check code. under the cap - keep it
       movb *hl,a                                          ; LD A,(HL)         ; too fast - use the maximum
_287d:                                                     ; >287d
       jmp  speed_store                                    ; JR $2889          ; store the result
slow_down:                                                 ; >287f
       movb @object_speed,a                                ; LD A,($F7E6)      ; A = speed
       sb   @bytes+>04,a                                   ; SUB $04           ; slow down by 4
       cb   a,@c                                           ; CP C              ; 
       jlt  !                                              ; JP P,$2889        ; still >= the floor - keep it
       b    @speed_store                                   ;                   
!
       movb @c,a                                           ; LD A,C            ; too slow - use the minimum
speed_store:                                               ; >2889
       movb a,@object_speed                                ; LD ($F7E6),A      ; store the new speed
       .ret                                                ; RET               ; 

********************************************************************************
* Object handler table
* 
* The handler #R$2528 runs each frame for each handler type ($F7EE,
* 0-15). Types 0 and 13 do nothing (the planet, the sun, debris and the
* title screen's objects are type 0); 1 is an explosion, 2 the space
* station, 3 the player's missile and 14 a missile fired at the player;
* 15 is the Cobra left behind by the escape capsule (#R$19FC); the rest
* are ships' tactics, from attacking to turning away and leaving.
object_handler_table:                                      ; >288d
       data handler_none                                             ; 0: none
       data handler_explosion                                        ; 1: explosion
       data handler_space_station                                    ; 2: space station
       data handler_player_missile                                   ; 3: the player's missile
       data handler_turn_then_leave                                  ; 4: turn away, then leave
       data handler_turn_then_attack                                 ; 5: turn away, then attack
       data handler_attack                                           ; 6: attack
       data handler_turn_away                                        ; 7: turn away
       data handler_fly_then_attack                                  ; 8: fly on, then attack
       data handler_spin_and_leave                                   ; 9: spin, fly on and leave
       data handler_head_for_planet                                  ; 10: head for the planet
       data handler_break_off                                        ; 11: break off
       data handler_leave                                            ; 12: fly on and leave
       data handler_none                                             ; 13: none
       data handler_enemy_missile                                    ; 14: missile homing in on the player
       data handler_escape_capsule                                   ; 15: the escape capsule's countdown

********************************************************************************
* The message "Bounty: ... credits"
* 
* Shown by #R$2556 when a ship with a bounty is destroyed, after
* formatting the bounty into the digits at $28B4 (#R$3675, which sets bit
* 7 of the last digit; #R$2556 clears it again so that the message runs
* on into " credits").
msg_bounty:                                                ; >28ad
       text 'BOUNTY:'
bounty_digit_buffer:                                       ; >28b4
       byte >00,>00,>00,>00,>00                                      ; the digits
msg_credits:                                               ; >28b9
       text ' CREDIT',>f3

********************************************************************************
* The message "No bounty!"
msg_no_bounty:                                             ; >28c1
       text 'NO BOUNTY',>a1

********************************************************************************
* Maximum laser damage by combat rank
* 
* When a ship's laser hits the player (#R$26A9), the damage to the shields
* (#R$193F) is a random number from 1 up to this table's entry for the
* player's combat rank (#R$EB12), so the higher the rank, the harder ships
* hit. A Constrictor always does 6 instead.
laser_damage_by_rank:                                      ; >28cb
       byte >02,>02,>02                                              ; ranks 0-2 (Harmless to Poor): 1-2
       byte >03,>03,>03                                              ; ranks 3-5 (Average to Competent): 1-3
       byte >04,>04,>04                                              ; ranks 6-8 (Dangerous to E-L-I-T-E): 1-4

********************************************************************************
* Clear the object table
* 
* Used by the routines at #R$1703, #R$1E01, #R$894D, #R$8C94 and #R$8D2A.
* .
* Clears the object table (#R$EBA0: 20 slots of 40 bytes), the number of
* objects of each ship type (#R$E844), and the numbers of pirates and
* traders (#R$E939, #R$E93A).
clear_all_ship_slots:                                      ; >28d4
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; the object table
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,planet_position                             ; LD DE,$EBA1       ; 
       li   bc,>031f                                       ; LD BC,$031F       ; 
       .ldir                                               ; LDIR              ; clear it
       li   hl,ship_type_counts                            ; LD HL,$E844       ; the number of objects of each ship type
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,ship_type_counts+>0001                      ; LD DE,$E845       ; 
       li   bc,>001f                                       ; LD BC,$001F       ; 
       .ldir                                               ; LDIR              ; clear them
       sb   a,a                                            ; XOR A             ; 
       movb a,@pirate_count                                ; LD ($E939),A      ; no pirates
       movb a,@trader_count                                ; LD ($E93A),A      ; no traders
       .ret                                                ; RET               ; 

********************************************************************************
* Check whether the player's laser has hit the object
* 
* Used by the routine at #R$13FD.
* .
* Called for each object by the main loop (#R$13FD). Only acts in the frame
* the laser is fired (bit 7 of ($F81B), see #R$2AD0), if the object is in
* the sights (($EF99), set by #R$4735) and the shot hasn't already hit
* something (($E873) zero). Unless the ship is already attacking (type 6)
* or turning away (7), it reacts according to bits 0-1 of its class byte
* ($F807): 0 not at all, 1 by turning away and leaving (type 12), 2 or 3 by
* turning away and then attacking. Then works out the damage.
* .
* At $291E, makes the ship turn away (#R$281E) and then attack: type 11
* (break off, then attack) if it was flying on (type 8), otherwise type 6.
* At $2929, sets the handler type to switch to after turning away.
* .
* At $292F, works out the damage from the laser's power (($F81A), set by
* #R$6D82 for the current view's laser): for the space station (ship type
* 1) none - unless a mission ($E93D = $52) needs it destroyed, when it's a
* quarter - but the player's legal status worsens by 10 (#R$EB65); a
* quarter for ship types $1E and $1F; none for a cargo canister (ship type
* 3) unless ($F7EC) is negative; otherwise the full power.
* .
* At $2977, the damage is taken off the object's energy ($F7E9). If that
* leaves none, the object is destroyed: for the Constrictor (ship type $1F)
* the mission state ($E93D) advances first; for the space station, ($EFA9)
* records that it has gone (which stops #R$3187 launching ships) and the
* mission state advances. Then (at $299A) the object is removed (#R$31AD),
* the explosion sound plays, #R$8DB9 spawns its debris and any missile lock
* on it is cancelled (#R$30EA).
* .
* If the object survives (at $29AE) with at most one more shot's worth of
* energy left, there's a 10/256 chance that - if it's a trader, pirate or
* shuttle (class 0-2, see #R$A817) - its pilot ejects in an escape capsule
* (#R$2A71). Then, if it still has missiles (($F7EA)), a 20/256 chance that
* it fires one at the player (#R$2A3A) - or, for a Thargoid (ship type
* $13), releases Thargons (#R$2A94).
* .
* Finally (at $29E0, for every hit) calls the police (#R$2A1C) if the
* player is in the station's safe zone (#R$EB05), fewer than 2 Vipers (ship
* type $0C, count at $E850) are about, none are already due, and the target
* was the station itself, a trader or shuttle (class 0 or 8), or a
* Thargoid-class ship during mission state $52; then marks the shot as used
* (($E873)) and plays the hit sound (effect 9).
laser_hit_check:                                           ; >28f6
       movb @laser_state,a                                 ; LD A,($F81B)      ; A = laser state
       socb a,a                                            ; OR A              ; test its sign
       jlt  !                                              ; RET P             ; laser not fired this frame
       .ret                                                ;                   
!
       movb @in_sights,a                                   ; LD A,($EF99)      ; A = in the sights?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; not in the sights
       .ret                                                ;                   
!
       movb @laser_shot_used,a                             ; LD A,($E873)      ; A = shot used?
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; the shot has already hit something
       .ret                                                ;                   
!
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = handler type
       cb   a,@bytes+>06                                   ; CP $06            ; 
       jeq  _292f                                          ; JR Z,$292F        ; attacking - no reaction
       cb   a,@bytes+>07                                   ; CP $07            ; 
       jeq  _292f                                          ; JR Z,$292F        ; turning away - no reaction
       movb @bp_class,a                                    ; LD A,($F807)      ; A = another state byte
       andi a,>0300                                        ; AND $03           ; A = how it reacts to being shot
       jeq  _292f                                          ; JR Z,$292F        ; 0: no reaction
       sb   one,a                                          ; DEC A             ; 
       jne  laser_hit_react                                ; JR NZ,$291E       ; 2 or 3
       movb @bytes+>0c,a                                   ; LD A,$0C          ; 1: turn away, then leave (type 12)
       jmp  _2929                                          ; JR $2929          ; 
laser_hit_react:                                           ; >291e
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = the object's type
       cb   a,@bytes+>08                                   ; CP $08            ; 
       movb @bytes+>0b,a                                   ; LD A,$0B          ; 
       jeq  _2929                                          ; JR Z,$2929        ; was flying on - break off (11)
       movb @bytes+>06,a                                   ; LD A,$06          ; otherwise attack (6)
_2929:                                                     ; >2929
       movb a,@next_handler_type                           ; LD ($F7F3),A      ; handler type after turning away
       .call @start_turning_away                           ; CALL $281E        ; turn away
_292f:                                                     ; >292f
       movb @laser_power,a                                 ; LD A,($F81A)      ; C = laser power
       movb a,@c                                           ; LD C,A            ; C = that byte (stays live through the case below)
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = ship type
       cb   a,one                                          ; CP $01            ; is it ship type 1?
       jne  laser_quarter_damage                           ; JR NZ,$2959       ; not the space station
       movb @legal_status,a                                ; LD A,($EB65)      ; mode 1: A = a saturating counter at $EB65
       ab   @bytes+>0a,a                                   ; ADD A,$0A         ; station: legal status += 10...
       jnc  _2942                                          ; JR NC,$2942       ; TODO: check code. no overflow - keep the sum
       sb   a,a                                            ; SBC A,A           ; overflowed - saturate A to $FF
_2942:                                                     ; >2942
       movb a,@legal_status                                ; LD ($EB65),A      ; store the (possibly saturated) counter back
       movb a,@legal_status_copy                           ; LD ($EF97),A      ; ...and copy it to $EF97
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>52                                   ; CP $52            ; is it $52?
       jne  laser_no_damage                                ; JR NZ,$2956       ; no mission - no damage
       movb @c,a                                           ; LD A,C            ; was $52: A = the saved $F81A byte
       srl  a,1                                            ; SRL A             ; A /= 4
       srl  a,1                                            ; SRL A             ; 
       jmp  _2957                                          ; JR $2957          ; mission: a quarter of the power
laser_no_damage:                                           ; >2956
       sb   a,a                                            ; XOR A             ; A = 0 (the "no decrement" case)
_2957:                                                     ; >2957
       jmp  _2977                                          ; JR $2977          ; take the damage off
laser_quarter_damage:                                      ; >2959
       cb   a,@bytes+>1f                                   ; CP $1F            ; ship type $1F?
       jeq  _2961                                          ; JR Z,$2961        ; yes - use the quartered-C case
       cb   a,@bytes+>1e                                   ; CP $1E            ; ship type $1E?
       jne  laser_cargo_damage                             ; JR NZ,$2968       ; neither
_2961:                                                     ; >2961
       movb @c,a                                           ; LD A,C            ; A = the saved $F81A byte
       srl  a,1                                            ; SRL A             ; A /= 4
       srl  a,1                                            ; SRL A             ; 
       jmp  _2977                                          ; JR $2977          ; take the damage off
laser_cargo_damage:                                        ; >2968
       cb   a,@bytes+>03                                   ; CP $03            ; ship type 3?
       jne  laser_damage                                   ; JR NZ,$2976       ; no - full damage
       movb @cargo_type,a                                  ; LD A,($F7EC)      ; yes: A = a value at $F7EC
       socb a,a                                            ; OR A              ; test bit 7
       jlt  !                                              ; JP P,$2976        ; non-negative - full damage
       b    @laser_damage                                  ;                   
!
       sb   a,a                                            ; XOR A             ; negative - A = 0 (the "no decrement" case)
       jmp  _2977                                          ; JR $2977          ; take the damage off
laser_damage:                                              ; >2976
       movb @c,a                                           ; LD A,C            ; full damage
_2977:                                                     ; >2977
       movb a,@c                                           ; LD C,A            ; C = damage
       movb @object_energy,a                               ; LD A,($F7E9)      ; 
       sb   @c,a                                           ; SUB C             ; 
       movb a,@object_energy                               ; LD ($F7E9),A      ; take it off the energy
       jnc  laser_survived                                 ; JR NC,$29AE       ; TODO: check code. still has some
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       cb   a,@bytes+>1f                                   ; CP $1F            ; the Constrictor?
       jne  laser_destroy                                  ; JR NZ,$298E       ; 
       li   hl,mission_state                               ; LD HL,$E93D       ; 
       ab   one,*hl                                        ; INC (HL)          ; yes - advance the mission
       jmp  _299a                                          ; JR $299A          ; 
laser_destroy:                                             ; >298e
       cb   a,one                                          ; CP $01            ; ship type 1?
       jne  _299a                                          ; JR NZ,$299A       ; not the space station
       li   hl,station_destroyed                           ; LD HL,$EFA9       ; yes: extra bookkeeping -
       sb   one,*hl                                        ; DEC (HL)          ; the station has gone
       li   hl,mission_state                               ; LD HL,$E93D       ; ...and increment $E93D
       ab   one,*hl                                        ; INC (HL)          ; advance the mission
_299a:                                                     ; >299a
       li   ix,object_status_byte                          ; LD IX,$F7CD       ; IX -> the working object record
       .call @destroy_object                               ; CALL $31AD        ; destroy the object
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 2 (explosion)
       .call @spawn_cargo                                  ; CALL $8DB9        ; 
       .call @cancel_missile_lock_on_object                ; CALL $30EA        ; cancel any missile lock on it
       jmp  _29e0                                          ; JR $29E0          ; maybe call the police
laser_survived:                                            ; >29ae
       sb   @c,a                                           ; SUB C             ; would another shot destroy it?
       jnc  _29c4                                          ; JR NC,$29C4       ; TODO: check code. no
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       cb   a,@bytes+>0a                                   ; CP $0A            ; ~10-in-256 chance
       jhe  _29c4                                          ; JR NC,$29C4       ; 10/256 chance
       movb @bp_class,a                                    ; LD A,($F807)      ; A = the ship's class byte (#R$F807)
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. keep its bits 2-4...
       andi a,>0700                                        ; AND $07           ; A = class
       cb   a,@bytes+>03                                   ; CP $03            ; 
       ; CALL C,$2A71                                      ; CALL C,$2A71      ; TODO: check code. trader, pirate or shuttle: eject an escape capsule
_29c4:                                                     ; >29c4
       movb @object_missiles,a                             ; LD A,($F7EA)      ; any missiles left?
       socb a,a                                            ; OR A              ; 
       jeq  _29e0                                          ; JR Z,$29E0        ; no
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       cb   a,@bytes+>14                                   ; CP $14            ; ~20-in-256 chance
       jhe  _29e0                                          ; JR NC,$29E0       ; 20/256 chance
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>13                                   ; CP $13            ; 
       jne  laser_fire_back_and_police                     ; JR NZ,$29DD       ; not a Thargoid - fire a missile
       .call @release_thargons                             ; CALL $2A94        ; Thargoid: release Thargons
       jmp  _29e0                                          ; JR $29E0          ; maybe call the police
laser_fire_back_and_police:                                ; >29dd
       .call @enemy_fires_missile                          ; CALL $2A3A        ; fire a missile at the player
_29e0:                                                     ; >29e0
       movb @num_vipers,a                                  ; LD A,($E850)      ; A = number of Vipers
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jhe  _2a13                                          ; JR NC,$2A13       ; 2 or more - no more police
       movb @police_to_launch,a                            ; LD A,($E934)      ; A = the #R$2A1C cooldown counter
       socb a,a                                            ; OR A              ; 
       jne  _2a13                                          ; JR NZ,$2A13       ; police already due
       movb @station_in_range,a                            ; LD A,($EB05)      ; A = the status-lamp flag
       socb a,a                                            ; OR A              ; 
       jeq  _2a13                                          ; JR Z,$2A13        ; not in the safe zone
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,one                                          ; CP $01            ; 
       jeq  _2a10                                          ; JR Z,$2A10        ; shot the station - call the police
       movb @bp_class,a                                    ; LD A,($F807)      ; A = the ship's class byte (#R$F807)
       andi a,>1c00                                        ; AND $1C           ; 
       jeq  _2a10                                          ; JR Z,$2A10        ; a trader - call the police
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jeq  _2a10                                          ; JR Z,$2A10        ; a shuttle - call the police
       cb   a,@bytes+>1c                                   ; CP $1C            ; 
       jne  _2a13                                          ; JR NZ,$2A13       ; 
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       cb   a,@bytes+>52                                   ; CP $52            ; 
       jne  _2a13                                          ; JR NZ,$2A13       ; 
_2a10:                                                     ; >2a10
       .call @call_police                                  ; CALL $2A1C        ; call the police
_2a13:                                                     ; >2a13
       li   hl,laser_shot_used                             ; LD HL,$E873       ; 
       sb   one,*hl                                        ; DEC (HL)          ; the shot has hit something
       movb @bytes+>09,a                                   ; LD A,$09          ; 
       b    @play_sound_effect                             ; JP $7468          ; play sound effect 9 (hit)

********************************************************************************
* Call the police
* 
* Used by the routines at #R$28F6 and #R$2C21.
* .
* Arms the countdown for #R$315C to launch Vipers from the space station:
* ($E934) = how many (a random number from 1 to twice the player's rank
* (#R$EB12) + 2, at most 6), and a 40-frame wait until the first ($E870).
* 
* O:($E934) Number of Vipers to launch (1-6)
* O:($E870) Frames until the first
call_police:                                               ; >2a1c
       movb @combat_rank,a                                 ; LD A,($EB12)      ; A = ($EB12)
       ab   one,a                                          ; INC A             ; 
       ab   a,a                                            ; ADD A,A           ; C = (rank + 1) * 2
       movb a,@c                                           ; LD C,A            ; C = that bound
_2a22:                                                     ; >2a22
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       andi a,>1f00                                        ; AND $1F           ; keep 5 bits (0-31)
       cb   a,@c                                           ; CP C              ; 
       jhe  _2a22                                          ; JR NC,$2A22       ; >= bound - reroll (reject-sample into [0,C))
       ab   one,a                                          ; INC A             ; A = 1 to (rank + 1) * 2
       cb   a,@bytes+>07                                   ; CP $07            ; 
       jl   _2a31                                          ; JR C,$2A31        ; <7 - keep it
       movb @bytes+>06,a                                   ; LD A,$06          ; at most 6
_2a31:                                                     ; >2a31
       movb a,@police_to_launch                            ; LD ($E934),A      ; number of Vipers to launch
       movb @bytes+>28,a                                   ; LD A,$28          ; 40
       movb a,@police_launch_timer                         ; LD ($E870),A      ; 40 frames until the first
       .ret                                                ; RET               ; 

********************************************************************************
* A ship fires a missile at the player
* 
* Used by the routine at #R$28F6.
* .
* Does nothing if the ship is too close (distance under $200) or the
* player is cloaked (#R$EF9F). Otherwise, keeping the working object's
* record safe (#R$3341, #R$334D), spawns a missile (ship type 2) with
* handler type 14 (#R$2618) at speed $41, and if there was room for it
* announces "Incoming missile" and plays the launch sound. Also
* decrements the byte at $009D, in unused space, which nothing reads.
enemy_fires_missile:                                       ; >2a3a
       movb @object_distance_hi,a                          ; LD A,($EB8F)      ; A = ($EB8F)
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jhe  !                                              ; RET C             ; too close - don't fire
       .ret                                                ;                   
!
       movb @cloaking_active_flag,a                        ; LD A,($EF9F)      ; A = ($EF9F)
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; player cloaked - don't fire
       .ret                                                ;                   
!
       .call @save_working_object_to_scratch               ; CALL $3341        ; save the working object record
       movb @bytes+>41,a                                   ; LD A,$41          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed $41
       movb @bytes+>0e,a                                   ; LD A,$0E          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 14: missile homing in on the player
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@ship_type                                   ; LD ($F7E7),A      ; ship type 2: missile
       .call @add_object                                   ; CALL $3037        ; spawn it
       jnc  _2a6e                                          ; JR NC,$2A6E       ; TODO: check code. no room for it
       li   hl,msg_incoming_missile                        ; LD HL,$33B7       ; "Incoming missile"
       .call @show_view_message                            ; CALL $39C8        ; announce it
       li   hl,>009d                                       ; LD HL,$009D       ; 
       sb   one,*hl                                        ; DEC (HL)          ; (nothing reads this byte)
       movb @bytes+>0b,a                                   ; LD A,$0B          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 11 (launch)
_2a6e:                                                     ; >2a6e
       b    @restore_working_object_from_scratch           ; JP $334D          ; restore the working object record

********************************************************************************
* Eject an escape capsule
* 
* Used by the routine at #R$28F6.
* .
* Called by #R$291E when a nearly-destroyed trader, pirate or shuttle's
* pilot ejects. Spawns an escape capsule (ship type 5) near the ship
* with a random orientation (#R$8E45), at speed 1, which flies away
* (handler type 12), keeping the
* working object's record safe meanwhile (#R$3341, #R$334D).
eject_escape_capsule:                                      ; >2a71
       .call @save_working_object_to_scratch               ; CALL $3341        ; save the working object record
       movb one,a                                          ; LD A,$01          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; status: in use
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed 1
       movb @bytes+>05,a                                   ; LD A,$05          ; 
       movb a,@ship_type                                   ; LD ($F7E7),A      ; ship type 5: escape capsule
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       movb a,@cargo_type                                  ; LD ($F7EC),A      ; cargo type 3: slaves (the pilot, if scooped)
       .call @random_orientation                           ; CALL $8E45        ; point it in a random direction
       movb @bytes+>0c,a                                   ; LD A,$0C          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 12: leave
       .call @add_object                                   ; CALL $3037        ; spawn it
       b    @restore_working_object_from_scratch           ; JP $334D          ; restore the working object record

********************************************************************************
* A Thargoid releases its Thargons
* 
* Used by the routine at #R$28F6.
* .
* Called by #R$291E when a Thargoid fires back. Spawns 4-7 Thargons
* (ship type 6) at the Thargoid's position, pointing in random directions
* (#R$8E45), speeding up and then
* attacking (handler type 8, #R$2859). Each remembers its Thargoid's
* slot (#R$F7EB), so they can be sent away when it's destroyed (#R$31AD),
* and holds alien items (cargo type 16, #R$F7EC) if scooped. The
* Thargoid has none left afterwards (#R$F7EA).
release_thargons:                                          ; >2a94
       sb   a,a                                            ; XOR A             ; A = 0
       movb a,@object_missiles                             ; LD ($F7EA),A      ; no more Thargons
       .call @save_working_object_to_scratch               ; CALL $3341        ; save the Thargoid
       movb @current_slot,a                                ; LD A,($E911)      ; 
       movb a,@thargons_thargoid                           ; LD ($F7EB),A      ; remember the Thargoid's slot
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       andi a,>0300                                        ; AND $03           ; 0-3
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 4-7 Thargons
       movb a,b                                            ; LD B,A            ; B = pack size (loop counter)
       movb one,a                                          ; LD A,$01          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; status: in use
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed 1
       movb @bytes+>08,a                                   ; LD A,$08          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 8: fly on, then attack
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       movb a,@ship_type                                   ; LD ($F7E7),A      ; ship type 6: Thargon
       movb @bytes+>10,a                                   ; LD A,$10          ; 
       movb a,@cargo_type                                  ; LD ($F7EC),A      ; cargo type 16: alien items
_2ac0:                                                     ; >2ac0
       .push bc                                            ; PUSH BC           ; save the loop counter
       .call @random_orientation                           ; CALL $8E45        ; point it in a random direction
       .call @countdown_and_speed_up                       ; CALL $2859        ; speed up for a while
       .call @add_object                                   ; CALL $3037        ; add it to the object table
       .pop bc                                             ; POP BC            ; restore the loop counter
       sb   one,b                                          ; DJNZ $2AC0        ; next Thargon
       jne  _2ac0                                          ;                   
       b    @restore_working_object_from_scratch           ; JP $334D          ; restore the Thargoid

********************************************************************************
* Fire the laser (fire button or 'A')
* 
* Used by the routine at #R$401C.
* .
* Called by #R$401C while the fire control is held. Does nothing if the
* current view has no laser (($F818) negative), the laser has overheated
* (temperature ($F813) at 48) or it's still cooling down from the last
* shot (($F81B) nonzero). Otherwise fires: sets ($F81B) to $80 so that
* this frame's objects can be hit (#R$28F6) and the beams are drawn
* (#R$2DC8), clears ($E873) so that the shot can hit one object, picks
* the point the beams meet ($E867/$E868, near the centre of the view,
* randomly jittered by up to 7 pixels), raises the laser temperature by
* 2, plays the laser sound and redraws the temperature gauge (#R$6B60).
fire_laser:                                                ; >2ad0
       movb @view_laser_type,a                             ; LD A,($F818)      ; 
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; RET M             ; no laser in this view
       .ret                                                ;                   
!
       movb @laser_temp_gauge,a                            ; LD A,($F813)      ; 
       cb   a,@bytes+>30                                   ; CP $30            ; 
       jne  !                                              ; RET Z             ; overheated
       .ret                                                ;                   
!
       li   hl,laser_state                                 ; LD HL,$F81B       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; still cooling down
       .ret                                                ;                   
!
       movb a,@laser_shot_used                             ; LD ($E873),A      ; the shot hasn't hit anything yet
       movb @bytes+>80,*hl                                 ; LD (HL),$80       ; fired this frame
       movb r,a                                            ; LD A,R            ; 
       andi a,>0700                                        ; AND $07           ; 
       ab   @bytes+>55,a                                   ; ADD A,$55         ; 
       movb a,@laser_target_x                              ; LD ($E867),A      ; beams meet at X = $55-$5C...
       movb r,a                                            ; LD A,R            ; 
       andi a,>0700                                        ; AND $07           ; 
       ab   @bytes+>3d,a                                   ; ADD A,$3D         ; 
       movb a,@laser_target_y                              ; LD ($E868),A      ; ...and Y = $3D-$44
       li   hl,laser_temp_gauge                            ; LD HL,$F813       ; 
       ab   one,*hl                                        ; INC (HL)          ; 
       ab   one,*hl                                        ; INC (HL)          ; laser temperature += 2
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 3 (laser)
       b    @draw_laser_temperature                        ; JP $6B60          ; redraw the laser temperature gauge

********************************************************************************
* Spawn new ships
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). In witchspace (#R$EEC1)
* only Thargoids appear: whenever the number of Thargoids about ($E857, see
* #R$E844) isn't the number wanted (#R$EEC5), spawns another one near the
* player (#R$2D3B), attacking. Otherwise goes on to $2B24.
* .
* At $2B24, first launches any police due (#R$315C). Then, in the space
* station's safe zone (#R$EB05) - but only once the station is at least
* $300 away ($E72A, the high byte of its distance), with no Orbit Shuttle
* or Transporter already about (#R$E844) and not in mission state $52
* ($E93D) - counts #R$EF8F down, and when it runs out launches an Orbit
* Shuttle or a Transporter from the station (#R$3187), heading for the
* planet (handler type 10).
* .
* At $2B66, outside the safe zone with no asteroid about, counts #R$EF90
* down, and when it runs out spawns an asteroid $1000-$17FF away (#R$8F25),
* flying past (handler type 12). With a 26/256 chance it will break up into
* 1-4 pieces when destroyed (byte $14 of the asteroid blueprint, see
* #R$8DB9); otherwise none.
* .
* At $2BAF, if there are no traders about (#R$E93A), counts #R$EF91 down,
* and when it runs out picks a Cobra MkIII, Python, Anaconda or Cobra MK1
* (ship types $0E-$11): outside the safe zone it's spawned near the player
* (#R$2D3B), flying past (handler type 12); in the safe zone it's launched
* from the space station (#R$3187) with handler type 4 (fly on, then turn
* away and leave), unless the station is less than $300 away.
* .
* At $2BE9, in mission states $17 and $40 ($E93D), spawns the mission's
* ship (#R$2C3C: the Constrictor or the Cougar), advances the state and
* returns.
* .
* At $2BFD, outside the safe zone with fewer than 2 pirates about
* (#R$E939), counts the 16-bit #R$EF9A down, and when it runs out restarts
* it at (government + 2) * 256 frames - so pirates come more often in
* lawless systems - and spawns a pirate pack (#R$2C3C).
spawn_ships:                                               ; >2b05
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jeq  spawn_ships_normal_space                       ; JR Z,$2B24        ; not in witchspace
       movb @num_thargoids,a                               ; LD A,($E857)      ; A = number of Thargoids about
       li   hl,witchspace_thargoids                        ; LD HL,$EEC5       ; 
       cb   a,*hl                                          ; CP (HL)           ; 
       jne  !                                              ; RET Z             ; enough Thargoids already
       .ret                                                ;                   
!
       movb @bytes+>13,a                                   ; LD A,$13          ; 
       movb a,@ship_type                                   ; LD ($F7E7),A      ; ship type $13: Thargoid
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 6: attack
       sb   a,a                                            ; XOR A             ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; slowing down
       b    @spawn_near_player                             ; JP $2D3B          ; spawn it near the player
spawn_ships_normal_space:                                  ; >2b24
       .call @launch_police                                ; CALL $315C        ; launch any police due
       movb @station_in_range,a                            ; LD A,($EB05)      ; A = the status-lamp flag
       socb a,a                                            ; OR A              ; 
       jeq  _2b66                                          ; JR Z,$2B66        ; not in the safe zone
       movb @station_distance_hi,a                         ; LD A,($E72A)      ; A = high byte of the station's distance
       cb   a,@bytes+>03                                   ; CP $03            ; 
       jl   _2b66                                          ; JR C,$2B66        ; station too close
       movb @num_orbit_shuttles,a                          ; LD A,($E860)      ; any Orbit Shuttles about?
       socb a,a                                            ; OR A              ; 
       jne  _2b66                                          ; JR NZ,$2B66       ; yes
       movb @num_transporters,a                            ; LD A,($E861)      ; any Transporters about?
       socb a,a                                            ; OR A              ; 
       jne  _2b66                                          ; JR NZ,$2B66       ; yes
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       cb   a,@bytes+>52                                   ; CP $52            ; 
       jeq  _2b66                                          ; JR Z,$2B66        ; mission state $52
       li   hl,shuttle_countdown                           ; LD HL,$EF8F       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       jne  _2b66                                          ; JR NZ,$2B66       ; not time yet
       movb one,a                                          ; LD A,$01          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; status: in use
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; speeding up
       movb r,a                                            ; LD A,R            ; 
       andi a,>0100                                        ; AND $01           ; the R register's low bit (a cheap coin-flip)
       ab   @bytes+>1c,a                                   ; ADD A,$1C         ; ship type $1C (Orbit Shuttle) or $1D (Transporter)
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       movb @bytes+>0a,a                                   ; LD A,$0A          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 10: head for the planet
       .call @launch_from_station                          ; CALL $3187        ; launch it from the station
_2b66:                                                     ; >2b66
       movb @station_in_range,a                            ; LD A,($EB05)      ; in the safe zone?
       socb a,a                                            ; OR A              ; 
       jne  _2baf                                          ; JR NZ,$2BAF       ; in the safe zone - no asteroids
       movb @num_asteroids,a                               ; LD A,($E848)      ; any asteroids about?
       socb a,a                                            ; OR A              ; 
       jne  _2baf                                          ; JR NZ,$2BAF       ; yes
       li   hl,asteroid_countdown                          ; LD HL,$EF90       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       jne  _2baf                                          ; JR NZ,$2BAF       ; not time yet
       movb one,a                                          ; LD A,$01          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; status: in use
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       andi a,>0700                                        ; AND $07           ; 
       movb a,h                                            ; LD H,A            ; 
       .call @random_byte                                  ; CALL $2176        ; A = another random byte
       movb a,@l                                           ; LD L,A            ; 
       li   de,>1000                                       ; LD DE,$1000       ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = distance $1000-$17FF
       ; SCF                                               ; SCF               ; TODO: check code. in any direction
       .call @random_point                                 ; CALL $8F25        ; pick a random point at that distance
       .call @point_at_player                              ; CALL $8D8E        ; point it at the player
       movb @bytes+>04,a                                   ; LD A,$04          ; 
       movb a,@ship_type                                   ; LD ($F7E7),A      ; ship type 4: asteroid
       movb @bytes+>0c,a                                   ; LD A,$0C          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 12: fly on and leave
       .call @add_object                                   ; CALL $3037        ; add it to the object table
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       cb   a,@bytes+>1a                                   ; CP $1A            ; 26/256 chance...
       jhe  spawn_traders                                  ; JR NC,$2BAB       ; ...of breaking up
       andi a,>0300                                        ; AND $03           ; 0-3
       ab   one,a                                          ; INC A             ; into 1-4 pieces
       jmp  _2bac                                          ; JR $2BAC          ; store it
spawn_traders:                                             ; >2bab
       sb   a,a                                            ; XOR A             ; no pieces
_2bac:                                                     ; >2bac
       movb a,@>14(iy)                                     ; LD (IY+$14),A     ; number of pieces when destroyed
_2baf:                                                     ; >2baf
       movb @trader_count,a                                ; LD A,($E93A)      ; any traders about?
       socb a,a                                            ; OR A              ; 
       jne  _2be9                                          ; JR NZ,$2BE9       ; traders about already
       li   hl,trader_countdown                            ; LD HL,$EF91       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       jne  _2be9                                          ; JR NZ,$2BE9       ; not time yet
       movb one,a                                          ; LD A,$01          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; status: in use
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       andi a,>0300                                        ; AND $03           ; 0-3
       ab   @bytes+>0e,a                                   ; ADD A,$0E         ; ship type $0E-$11: a trader
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       movb @station_in_range,a                            ; LD A,($EB05)      ; in the safe zone?
       socb a,a                                            ; OR A              ; 
       jne  spawn_trader_from_station                      ; JR NZ,$2BDA       ; yes - launch it from the station
       movb @bytes+>0c,a                                   ; LD A,$0C          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 12: fly on and leave
       .call @spawn_near_player                            ; CALL $2D3B        ; spawn it near the player
       jmp  _2be9                                          ; JR $2BE9          ; go on to the mission ships
spawn_trader_from_station:                                 ; >2bda
       movb @station_distance_hi,a                         ; LD A,($E72A)      ; A = high byte of the station's distance
       cb   a,@bytes+>03                                   ; CP $03            ; 
       jl   _2be9                                          ; JR C,$2BE9        ; too close - no launch
       movb @bytes+>04,a                                   ; LD A,$04          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 4: turn away, then leave
       .call @launch_from_station                          ; CALL $3187        ; launch it from the station
_2be9:                                                     ; >2be9
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>17                                   ; CP $17            ; 
       jeq  _2bf4                                          ; JR Z,$2BF4        ; $17: spawn the Constrictor
       cb   a,@bytes+>40                                   ; CP $40            ; 
       jne  spawn_pirates                                  ; JR NZ,$2BFD       ; not $40 either
_2bf4:                                                     ; >2bf4
       .call @condition_red                                ; CALL $2C3C        ; $40: spawn the Cougar
       li   hl,mission_state                               ; LD HL,$E93D       ; 
       ab   one,*hl                                        ; INC (HL)          ; advance the mission state
       jmp  _2c20                                          ; JR $2C20          ; and return
spawn_pirates:                                             ; >2bfd
       movb @station_in_range,a                            ; LD A,($EB05)      ; in the safe zone?
       socb a,a                                            ; OR A              ; 
       jne  _2c20                                          ; JR NZ,$2C20       ; in the safe zone - no pirates
       movb @pirate_count,a                                ; LD A,($E939)      ; A = number of pirates about
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jhe  _2c20                                          ; JR NC,$2C20       ; 2 or more
       mov  @pirate_countdown,hl                           ; LD HL,($EF9A)     ; 
       dec  hl                                             ; DEC HL            ; 
       mov  hl,@pirate_countdown                           ; LD ($EF9A),HL     ; 
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; 
       jne  _2c20                                          ; JR NZ,$2C20       ; not time yet
       movb @current_system_government,a                   ; LD A,($F762)      ; A = the system's government
       ab   @bytes+>02,a                                   ; ADD A,$02         ; 
       movb a,@pirate_countdown_hi                         ; LD ($EF9B),A      ; restart the countdown
       .call @condition_red                                ; CALL $2C3C        ; Condition RED: spawn pirates
_2c20:                                                     ; >2c20
       .ret                                                ; RET               ; 

********************************************************************************
* Maybe call the police, depending on legal status and government
* 
* Used by the routine at #R$1549.
* .
* Called by #R$1549. If the player's legal status (#R$EB65) isn't clean,
* calls the police (#R$2A1C) with a chance of (legal status / 4 +
* government * 16) in 256.
maybe_call_police:                                         ; >2c21
       movb @legal_status,a                                ; LD A,($EB65)      ; A = legal status
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; clean - no police
       .ret                                                ;                   
!
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. A /= 4...
       andi a,>3f00                                        ; AND $3F           ; 
       movb a,@c                                           ; LD C,A            ; C = legal status / 4
       movb @current_system_government,a                   ; LD A,($F762)      ; A = the system's government
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; A = government * 16
       ab   @c,a                                           ; ADD A,C           ; A += the base threshold
       movb a,@c                                           ; LD C,A            ; C = the chance, out of 256
       .call @random_byte                                  ; CALL $2176        ; 
       cb   a,@c                                           ; CP C              ; 
       jl   !                                              ; RET NC            ; no police this time
       .ret                                                ;                   
!
       b    @call_police                                   ; JP $2A1C          ; call the police

********************************************************************************
* Condition RED: spawn a hostile ship
* 
* Used by the routines at #R$13FD and #R$2B05.
* .
* Announces "Condition RED!" and spawns a hostile ship, which it picks by
* mission state ($E93D): the Constrictor (ship type $1F) in state $17, a
* Thargoid ($13) in states $21 and $52, the Cougar ($1E) in state $40,
* and otherwise a random pirate (#R$3326). Called for the mission ships
* and pirates (#R$2B24), and sometimes at the end of a Torus Jump Drive
* jump (#R$13FD).
* .
* At $2C64, spawns the ship in A $0800-$0FFF away (#R$8F25), attacking
* (handler type 6), at speed 1 and slowing down. It gets escorts unless
* it's a Thargoid or the Constrictor (in mission states $21 and $52 even
* a Thargoid gets them): a random number from 0 to (rank (#R$EB12) + 3) /
* 2 - 1 of them, each an Asp MkII in mission state $40 (the Cougar's
* escorts), a Thargoid in states $21 and $52, or otherwise a random
* pirate.
* .
* At $2CEF, each escort is placed by the next record in the formation
* table at #R$343B (via the cursor at #R$E871): 700 units along the
* leader's side or roof vector, either way (#R$439D), so the escorts fly
* to its left and right, above and below it, in the same direction. Each
* is added to the object table (#R$3037).
condition_red:                                             ; >2c3c
       li   hl,msg_condition_red                           ; LD HL,$3388       ; "Condition RED!"
       .call @show_view_message                            ; CALL $39C8        ; announce "Condition RED!"
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>17                                   ; CP $17            ; 
       jne  condition_red_thargoid                         ; JR NZ,$2C4D       ; not $17
       movb @bytes+>1f,a                                   ; LD A,$1F          ; $17: the Constrictor
       jmp  _2c64                                          ; JR $2C64          ; 
condition_red_thargoid:                                    ; >2c4d
       cb   a,@bytes+>21                                   ; CP $21            ; ($E93D) = $21?
       jeq  _2c55                                          ; JR Z,$2C55        ; 
       cb   a,@bytes+>52                                   ; CP $52            ; = $52?
       jne  condition_red_cougar                           ; JR NZ,$2C59       ; 
_2c55:                                                     ; >2c55
       movb @bytes+>13,a                                   ; LD A,$13          ; ship type $13: Thargoid
       jmp  _2c64                                          ; JR $2C64          ; 
condition_red_cougar:                                      ; >2c59
       cb   a,@bytes+>40                                   ; CP $40            ; ($E93D) = $40?
       jne  condition_red_spawn                            ; JR NZ,$2C61       ; 
       movb @bytes+>1e,a                                   ; LD A,$1E          ; ship type $1E: Cougar
       jmp  _2c64                                          ; JR $2C64          ; 
condition_red_spawn:                                       ; >2c61
       .call @random_pirate                                ; CALL $3326        ; otherwise a random pirate
_2c64:                                                     ; >2c64
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 6: attack
       sb   a,a                                            ; XOR A             ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; slowing down
       ab   one,a                                          ; INC A             ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; status: in use
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed 1
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       movb a,@l                                           ; LD L,A            ; L = the random byte
       andi a,>0700                                        ; AND $07           ; 
       movb a,h                                            ; LD H,A            ; H = its low 3 bits
       li   de,>0800                                       ; LD DE,$0800       ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = distance $0800-$0FFF
       ; SCF                                               ; SCF               ; TODO: check code. in any direction
       .call @random_point                                 ; CALL $8F25        ; pick a random point at that distance
       mov  hl,@nose_vector_z                              ; LD ($F7DE),HL     ; 
       mov  @object_position_x,hl                          ; LD HL,($F7CE)     ; 
       mov  hl,@nose_vector                                ; LD ($F7DA),HL     ; 
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; 
       mov  hl,@nose_vector_y                              ; LD ($F7DC),HL     ; 
       .call @point_at_player                              ; CALL $8D8E        ; point it at the player
       .call @add_object                                   ; CALL $3037        ; add it to the object table
       joc  !                                              ; RET NC            ; TODO: check code. no room
       .ret                                                ;                   
!
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>21                                   ; CP $21            ; 
       jeq  _2cb0                                          ; JR Z,$2CB0        ; $21: escorts
       cb   a,@bytes+>52                                   ; CP $52            ; 
       jeq  _2cb0                                          ; JR Z,$2CB0        ; $52: escorts
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = ship type
       cb   a,@bytes+>13                                   ; CP $13            ; 
       jne  !                                              ; RET Z             ; a Thargoid - no escorts
       .ret                                                ;                   
!
       cb   a,@bytes+>1f                                   ; CP $1F            ; 
       jne  !                                              ; RET Z             ; the Constrictor - no escorts
       .ret                                                ;                   
!
_2cb0:                                                     ; >2cb0
       .call @work_out_roof                                ; CALL $4599        ; work out its roof vector
       .call @save_working_object_to_scratch               ; CALL $3341        ; save it as the leader
       li   hl,escort_formation                            ; LD HL,$343B       ; 
       mov  hl,@escort_table_cursor                        ; LD ($E871),HL     ; the escorts' formation (#R$343B)
       movb @combat_rank,a                                 ; LD A,($EB12)      ; 
       ab   @bytes+>03,a                                   ; ADD A,$03         ; 
       srl  a,1                                            ; RRA               ; TODO: check code. C = (rank + 3) / 2
       movb a,@c                                           ; LD C,A            ; C = the reject-sample upper bound
_2cc3:                                                     ; >2cc3
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       andi a,>1f00                                        ; AND $1F           ; keep 5 bits (0-31)
       cb   a,@c                                           ; CP C              ; 
       jhe  _2cc3                                          ; JR NC,$2CC3       ; >= bound - reroll
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no escorts
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; B = number of escorts
_2cce:                                                     ; >2cce
       .push bc                                            ; PUSH BC           ; save the loop counter
       .call @restore_working_object_from_scratch          ; CALL $334D        ; restore the leader
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>40                                   ; CP $40            ; 
       jne  condition_red_thargoid_escort                  ; JR NZ,$2CE0       ; not $40
       movb @bytes+>19,a                                   ; LD A,$19          ; $40: an Asp MkII
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       jmp  _2cef                                          ; JR $2CEF          ; 
condition_red_thargoid_escort:                             ; >2ce0
       cb   a,@bytes+>21                                   ; CP $21            ; ($E93D) = $21?
       jeq  _2ce8                                          ; JR Z,$2CE8        ; 
       cb   a,@bytes+>52                                   ; CP $52            ; = $52?
       jne  condition_red_escort                           ; JR NZ,$2CEC       ; otherwise a random pirate
_2ce8:                                                     ; >2ce8
       movb @bytes+>13,a                                   ; LD A,$13          ; ship type $13: Thargoid
       jmp  _2cef                                          ; JR $2CEF          ; 
condition_red_escort:                                      ; >2cec
       .call @random_pirate                                ; CALL $3326        ; otherwise a random pirate
_2cef:                                                     ; >2cef
       mov  @escort_table_cursor,hl                        ; LD HL,($E871)     ; the next formation record
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,b                                          ; LD B,(HL)         ; BC = the leader's side or roof vector
       inc  hl                                             ; INC HL            ; 
       .push bc                                            ; PUSH BC           ; 
       .pop ix                                             ; POP IX            ; IX = BC
       movb *hl,@e                                         ; LD E,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; DE = the distance
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = $00, or $80 to negate the vector
       inc  hl                                             ; INC HL            ; 
       mov  hl,@escort_table_cursor                        ; LD ($E871),HL     ; move on to the next record
       movb b,h                                            ; LD H,B            ; 
       movb @c,@l                                          ; LD L,C            ; HL = the vector
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 components
_2d07:                                                     ; >2d07
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       ; XOR C                                             ; XOR C             ; TODO: check code. flip the sign bit if negating
       movb a,*hl                                          ; LD (HL),A         ; 
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $2D07        ; 
       jne  _2d07                                          ;                   
       .ex_de_hl                                           ; EX DE,HL          ; HL = the distance
       .call @multiply_vector                              ; CALL $439D        ; BC, DE, HL = the offset from the leader
       .push hl                                            ; PUSH HL           ; 
       mov  @object_position_x,hl                          ; LD HL,($F7CE)     ; 
       a    bc,hl                                          ; ADD HL,BC         ; x
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; 
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; 
       a    de,hl                                          ; ADD HL,DE         ; y
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; 
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; 
       .pop de                                             ; POP DE            ; 
       a    de,hl                                          ; ADD HL,DE         ; z
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; 
       li   hl,>0087                                       ; LD HL,$0087       ; the leader's side vector (#R$3341)
       li   de,side_vector                                 ; LD DE,$F7D4       ; 
       li   bc,>0006                                       ; LD BC,$0006       ; 
       .ldir                                               ; LDIR              ; restore it, in case it was negated
       .call @add_object                                   ; CALL $3037        ; spawn the escort
       .pop bc                                             ; POP BC            ; restore the loop counter
       sb   one,b                                          ; DJNZ $2CCE        ; next escort
       jne  _2cce                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Spawn a ship near the player
* 
* Used by the routine at #R$2B05.
* .
* Spawns the ship set up in the working object (whose ship and handler
* types the caller has set) at speed 1, at a random point 2048-4095 away
* (#R$8F25), with a random orientation (#R$8E45), and adds it to the
* object table
* (#R$3037).
spawn_near_player:                                         ; >2d3b
       movb one,a                                          ; LD A,$01          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; status: in use
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed 1
       .call @random_byte                                  ; CALL $2176        ; A = a fresh random byte
       movb a,@l                                           ; LD L,A            ; L = the random byte
       andi a,>0700                                        ; AND $07           ; 
       movb a,h                                            ; LD H,A            ; H = its low 3 bits
       li   de,>0800                                       ; LD DE,$0800       ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = distance $0800-$0FFF
       ; SCF                                               ; SCF               ; TODO: check code. in any direction
       .call @random_point                                 ; CALL $8F25        ; pick a random point at that distance
       .call @random_orientation                           ; CALL $8E45        ; point it in a random direction
       b    @add_object                                    ; JP $3037          ; add it to the object table

********************************************************************************
* Key 'T': target a missile
* 
* Reached only via #R$419B's (key code, handler) table - not a literal
* CALL/JP.
* .
* Begins arming a missile lock: bails if #R$E910 (the missile
* lock-on state - 0 idle, 1 while acquiring, 2 once locked; #R$4735
* advances 1 -> 2 once #R$E911's candidate target is confirmed still
* live via #R$3016, caching it to #R$E928) is already nonzero, or if
* #R$F776 (the missile count) is 0 (nothing to fire). Otherwise
* advances #R$E910 from 0 to 1 and redraws the missile indicator.
key_handler_t:                                             ; >2d58
       .call @refuse_if_docked                             ; CALL $6DCF        ; refuse if docked
       movb @missile_state,a                               ; LD A,($E910)      ; A = the missile lock-on state
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$16FE       ; already arming/locked - beep and return
       b    @trigger_sfx_6                                 ;                   
!
       movb @missile_count,a                               ; LD A,($F776)      ; A = the missile count
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$16FE        ; none left - beep and return
       b    @trigger_sfx_6                                 ;                   
!
       li   hl,missile_state                               ; LD HL,$E910       ; 
       ab   one,*hl                                        ; INC (HL)          ; start arming (state 0 -> 1)
       b    @draw_missile_indicator                        ; JP $6B6E          ; redraw the missile indicator

********************************************************************************
* Key 'U': unarm the missile (cancel a missile lock)
* 
* Used by the routine at #R$30EA.
* .
* Bails (beeps) if #R$E910 (the missile lock-on state) is already 0;
* otherwise clears it back to 0 and redraws the missile indicator.
* #R$30EA calls this when the locked-on target object goes away.
cancel_missile_lock:                                       ; >2d70
       movb @missile_state,a                               ; LD A,($E910)      ; A = the missile lock-on state
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$16FE        ; already idle - beep and return
       b    @trigger_sfx_6                                 ;                   
!
       sb   a,a                                            ; XOR A             ; 
       movb a,@missile_state                               ; LD ($E910),A      ; back to idle
       b    @draw_missile_indicator                        ; JP $6B6E          ; redraw the missile indicator

********************************************************************************
* Key 'M': fire the missile
* 
* Reached via the key table at #R$419B. Needs the missile to be locked on
* to a target (#R$E910 = 2). Adds a missile (ship type 2, handler type 3)
* to the object table (#R$3037), at the position and orientation in #R$3429,
* with the target (#R$E928) in ($F7EF). If there's room for it, plays sound
* effect 11 and takes one off the number of missiles (#R$F776); otherwise
* (at $2DBC) shows "Missile jammed!".
key_fire_missile:                                          ; >2d7e
       movb @missile_state,a                               ; LD A,($E910)      ; A = the missile lock-on state
       sb   @bytes+>02,a                                   ; SUB $02           ; locked (exactly 2)?
       jeq  !                                              ; JP NZ,$16FE       ; no - beep and return
       b    @trigger_sfx_6                                 ;                   
!
       movb a,@missile_state                               ; LD ($E910),A      ; yes - A is 0 here, so this clears the lock state
       movb @bytes+>41,a                                   ; LD A,$41          ; status: in use, and bit 6
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; 
       li   hl,missile_launch_start                        ; LD HL,$3429       ; source: a fixed position/orientation record
       li   de,object_position_x                           ; LD DE,$F7CE       ; dest: the working object record
       li   bc,>0012                                       ; LD BC,$0012       ; 18 bytes
       .ldir                                               ; LDIR              ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; ship type 2
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       movb @bytes+>03,a                                   ; LD A,$03          ; handler type 3: the player's missile
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       movb @missile_target,a                              ; LD A,($E928)      ; the locked-on target identifier
       movb a,@handler_countdown                           ; LD ($F7EF),A      ; -> this missile's own target field
       .call @add_object                                   ; CALL $3037        ; spawn it into a free ship-object slot
       jnc  continue_2d7e_missile_jammed                   ; JR NC,$2DBC       ; TODO: check code. no free slot - report "Missile jammed!"
       movb @bytes+>0b,a                                   ; LD A,$0B          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 11 (launch)
       li   hl,missile_count                               ; LD HL,$F776       ; one fewer missile
       sb   one,*hl                                        ; DEC (HL)          ; 
       jmp  _2dc5                                          ; JR $2DC5          ; 
continue_2d7e_missile_jammed:                              ; >2dbc
       .call @trigger_sfx_6                                ; CALL $16FE        ; beep
       li   hl,msg_missile_jammed                          ; LD HL,$33A8       ; the "Missile jammed!" message
       .call @show_view_message                            ; CALL $39C8        ; display it
_2dc5:                                                     ; >2dc5
       b    @draw_missile_indicator                        ; JP $6B6E          ; redraw the missile indicator

********************************************************************************
* Draw the laser beams
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD); does nothing if the
* dashboard isn't shown (#R$6C9E). In the frame the laser fires (($F81B)
* negative, see #R$2AD0), starts the cooldown - loads ($F81B) with the
* laser's cooldown (#R$F819) - and draws four beams, from the corners of
* the view (the table at #R$3365) to the point ($E867) where they meet.
* While ($F81B) is positive, counts the cooldown down ($2DEF).
draw_laser_beams:                                          ; >2dc8
       .call @gate_dashboard_hidden                        ; CALL $6C9E        ; 
       li   hl,laser_state                                 ; LD HL,$F81B       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; laser ready - nothing to do
       .ret                                                ;                   
!
       jlt  !                                              ; JP P,$2DEF        ; cooling down
       b    @laser_cooldown_tick                           ;                   
!
       movb @laser_cooldown,a                              ; LD A,($F819)      ; fired this frame: start the cooldown
       movb a,*hl                                          ; LD (HL),A         ; 
       li   hl,laser_beam_start_points                     ; LD HL,$3365       ; the four corners of the view
       movb @bytes+>04,b                                   ; LD B,$04          ; 
_2ddd:                                                     ; >2ddd
       movb *hl,@e                                         ; LD E,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @laser_target_x,bc                             ; LD BC,($E867)     ; BC = the point where the beams meet
       .call @setup_bresenham_line                         ; CALL $3C48        ; draw a beam
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $2DDD        ; 
       jne  _2ddd                                          ;                   
       .ret                                                ; RET               ; 
laser_cooldown_tick:                                       ; >2def
       sb   one,*hl                                        ; DEC (HL)          ; one fewer cooldown frame
       .ret                                                ; RET               ; 

********************************************************************************
* Compute the signed relative position to the working object, then scale it
* 
* Used by the routine at #R$2EB2.
* .
* For each of the 3 axes, subtracts the working object's rotated
* position (#R$F7CE/#R$F7D0/#R$F7D2) from a cached reference point
* (#R$EB88/#R$EB8A/#R$EB8C) into a signed 16-bit delta (#R$EB82/#R$EB84/
* #R$EB86), also stashing that delta's sign-extended high byte at
* #R$E864/#R$E865/#R$E866. Calls #R$84A6 for the length of the delta
* vector - the distance - and caches it at #R$EB6E, then right-shifts it by #R$EB9B bits (0 = no shift) into
* #R$E86A - a scaled magnitude #R$2E7B's division uses as its divisor.
compute_relative_position_scale:                           ; >2df1
       mov  @reference_point_x,hl                          ; LD HL,($EB88)     ; HL = the reference point's X
       mov  @object_position_x,de                          ; LD DE,($F7CE)     ; DE = the working object's X
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = delta X
       movb h,a                                            ; LD A,H            ; 
       movb a,@cached_delta_x_sign                         ; LD ($E864),A      ; cache delta X's high byte
       jlt  !                                              ; JP P,$2E08        ; positive - done with this axis
       b    @relative_position_x                           ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate HL (16-bit two's complement)
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
relative_position_x:                                       ; >2e08
       mov  hl,@abs_delta_x                                ; LD ($EB82),HL     ; store delta X
       mov  @reference_point_y,hl                          ; LD HL,($EB8A)     ; HL = the reference point's Y
       mov  @object_position_y,de                          ; LD DE,($F7D0)     ; DE = the working object's Y
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = delta Y
       movb h,a                                            ; LD A,H            ; 
       movb a,@cached_delta_y_sign                         ; LD ($E865),A      ; cache delta Y's high byte
       jlt  !                                              ; JP P,$2E22        ; positive - done with this axis
       b    @relative_position_y                           ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate HL
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
relative_position_y:                                       ; >2e22
       mov  hl,@abs_delta_y                                ; LD ($EB84),HL     ; store delta Y
       mov  @reference_point_z,hl                          ; LD HL,($EB8C)     ; HL = the reference point's Z
       mov  @object_position_z_lo,de                       ; LD DE,($F7D2)     ; DE = the working object's Z
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = delta Z
       movb h,a                                            ; LD A,H            ; 
       movb a,@cached_delta_z_sign                         ; LD ($E866),A      ; cache delta Z's high byte
       jlt  !                                              ; JP P,$2E3C        ; positive - done with this axis
       b    @relative_position_z                           ;                   
!
       sb   a,a                                            ; XOR A             ; negative - negate HL
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
relative_position_z:                                       ; >2e3c
       mov  hl,@abs_delta_z                                ; LD ($EB86),HL     ; store delta Z
       .call @vector_length                                ; CALL $84A6        ; HL = the distance
       mov  hl,@reference_distance                         ; LD ($EB6E),HL     ; cache its result
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; A = a shift count
       socb a,a                                            ; OR A              ; 
       jeq  _2e52                                          ; JR Z,$2E52        ; 0 - no shift needed
       movb a,b                                            ; LD B,A            ; 
_2e4c:                                                     ; >2e4c
       srl  h,1                                            ; SRL H             ; scale the cached result right by that many bits
       ; RR L                                              ; RR L              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $2E4C        ; 
       jne  _2e4c                                          ;                   
_2e52:                                                     ; >2e52
       mov  hl,@scaled_delta_divisor                       ; LD ($E86A),HL     ; the scaled divisor for #R$2E7B
       .ret                                                ; RET               ; 

********************************************************************************
* Signed 16-bit by 8-bit multiply, 24-bit result in C:H:L
* 
* Used by the routine at #R$2EB2.
* 
* I:DE Signed 16-bit multiplicand
* I:L Unsigned 8-bit multiplier
* I:D bit 7 XORed with the caller's A beforehand encodes the result's
* .   sign (this routine RES's it, so DE's own sign bit is discarded
* .   here and must already be folded into that XOR by the caller)
* O:C:H:L Signed 24-bit product
signed_multiply_16x8_24:                                   ; >2e56
       ; XOR D                                             ; XOR D             ; TODO: check code. combine D's sign bit with the caller's A...
       .ex_af_af_                                          ; EX AF,AF'         ; ...and stash it for the sign-fixup at the end
       szcb @bit7,d                                        ; RES 7,D           ; DE -> its unsigned magnitude
       movb @l,b                                           ; LD B,L            ; B = the multiplier
       sb   a,a                                            ; XOR A             ; A:H:L = 0 (24-bit accumulator, with C below)
       movb a,h                                            ; LD H,A            ; 
       movb a,@l                                           ; LD L,A            ; 
       movb a,@c                                           ; LD C,A            ; 
_2e5f:                                                     ; >2e5f
       srl  b,1                                            ; SRL B             ; test the next bit of the multiplier...
       jnc  _2e65                                          ; JR NC,$2E65       ; TODO: check code. 
       a    de,hl                                          ; ADD HL,DE         ; ...set - accumulate the current shifted addend (C:D:E)
       ab   @c,a                                           ; ADC A,C           ; 
_2e65:                                                     ; >2e65
       ; SLA E                                             ; SLA E             ; TODO: check code. double the addend (C:D:E <<= 1) for the next bit
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       ab   one,b                                          ; INC B             ; (offsets DJNZ's decrement, so the loop tests SRL's result directly)
       sb   one,b                                          ; DJNZ $2E5F        ; 
       jne  _2e5f                                          ;                   
       movb a,@c                                           ; LD C,A            ; C = the product's high byte
       .ex_af_af_                                          ; EX AF,AF'         ; recover the combined sign
       jlt  !                                              ; RET P             ; same sign - the magnitude in C:H:L is the answer
       .ret                                                ;                   
!
       movb b,a                                            ; LD A,B            ; different signs - negate the 24-bit C:H:L (B is 0 here)
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       movb b,a                                            ; LD A,B            ; 
       sb   h,a                                            ; SBC A,H           ; 
       movb a,h                                            ; LD H,A            ; 
       movb b,a                                            ; LD A,B            ; 
       sb   @c,a                                           ; SBC A,C           ; 
       movb a,@c                                           ; LD C,A            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Signed 24-bit by 16-bit divide, 16-bit quotient in H:L
* 
* Used by the routine at #R$2EB2.
* .
* Restoring (shift-and-subtract) division of the 24-bit A:H:L dividend
* by the 16-bit divisor at #R$E86A, producing a 16-bit quotient. A's
* sign bit on entry both decides whether A:H:L is negated first (to
* work with an unsigned magnitude) and, unchanged on the stack
* throughout, is folded back into the quotient's top bit at the end -
* so the caller is expected to have already combined both operands'
* signs into that one bit, the same convention #R$2E56 uses.
* 
* I:A:H:L Signed 24-bit dividend
* I:($E86A) Unsigned 16-bit divisor
* O:H:L Signed 16-bit quotient
signed_divide_24_by_16:                                    ; >2e7b
       .push af                                            ; PUSH AF           ; stash the dividend/result sign bit
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$2E8A        ; positive - A:H:L is already a plain magnitude
       b    @signed_divide_magnitude                       ;                   
!
       movb a,@c                                           ; LD C,A            ; negative - negate the 24-bit A:H:L (via a 0-value chain)
       sb   a,a                                            ; XOR A             ; 
       movb a,b                                            ; LD B,A            ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       movb b,a                                            ; LD A,B            ; 
       sb   h,a                                            ; SBC A,H           ; 
       movb a,h                                            ; LD H,A            ; 
       movb b,a                                            ; LD A,B            ; 
       sb   @c,a                                           ; SBC A,C           ; 
signed_divide_magnitude:                                   ; >2e8a
       movb @l,@c                                          ; LD C,L            ; C:H (renamed below) = the low 16 bits of the magnitude
       movb a,@l                                           ; LD L,A            ; 
       movb h,a                                            ; LD A,H            ; 
       sb   h,h                                            ; LD H,$00          ; A:C:H(as HL) now line up as a 24-bit shift register
       mov  @scaled_delta_divisor,de                       ; LD DE,($E86A)     ; DE = the divisor
       movb @bytes+>10,b                                   ; LD B,$10          ; 16 quotient bits
_2e95:                                                     ; >2e95
       ; RL C                                              ; RL C              ; TODO: check code. shift the dividend/remainder left, quotient bit -> C
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; 
       s    de,hl                                          ; SBC HL,DE         ; trial-subtract the divisor
       jnc  _2e9f                                          ; JR NC,$2E9F       ; TODO: check code. fits - keep the subtraction (quotient bit is 1)
       a    de,hl                                          ; ADD HL,DE         ; doesn't fit - undo it (quotient bit stays 0)
_2e9f:                                                     ; >2e9f
       sb   one,b                                          ; DJNZ $2E95        ; 
       jne  _2e95                                          ;                   
       ; RL C                                              ; RL C              ; TODO: check code. shift the final quotient bit in
       sla  a,1                                            ; RLA               ; TODO: check code. 
       inv  a                                              ; CPL               ; the quotient bits collected in A/C came out inverted...
       movb a,h                                            ; LD H,A            ; ...so complement them back
       movb @c,a                                           ; LD A,C            ; 
       inv  a                                              ; CPL               ; 
       movb a,@l                                           ; LD L,A            ; H:L = the unsigned 16-bit quotient
       .pop af                                             ; POP AF            ; recover the sign bit
       andi a,>8000                                        ; AND $80           ; 
       socb h,a                                            ; OR H              ; fold it into the quotient's top bit
       movb a,h                                            ; LD H,A            ; 
       mov  hl,@steering_dot_product                       ; LD ($E86E),HL     ; store the quotient (#R$E86E)
       .ret                                                ; RET               ; 

********************************************************************************
* Steer the object towards a point
* 
* Used by the routines at #R$25B9, #R$2618 and #R$26A9.
* .
* Steers the object towards the point at #R$EB88 (the player's position
* when that's 0), much as BBC Elite's TACTICS does. Works out the direction
* to the point (#R$2DF1) and its dot products with the object's side and
* roof vectors (#R$2E56, #R$2E7B), which are near 0 when the point is in
* the object's nose-roof and nose-side planes; the tolerance for "near"
* depends on the distance (#R$33C7, indexed by #R$EB9B).
* .
* If the side dot product is outside the tolerance, rolls the object
* (#R$23D9) by its turn rate (#R$F806) - but by no more than the angle
* it is off line, in half-degrees (#R$2FBC), so the turn slows as the
* object comes into line - in the direction given by the dot product's
* sign (#R$E86E). Otherwise, at $2F2F, works out the roof dot product. If
* the point's z and the nose's z have different signs, pitches the object
* (#R$2365) by its turn rate; if the roof dot product is outside the
* tolerance (at $2F85), pitches it as for rolling. Otherwise (at $2FB4) the
* object is pointing at the point.
* .
* The object speeds up ($F7F4 set) when it's pointing at the point, or when
* the pitch is capped; otherwise it slows down.
steer_towards_point:                                       ; >2eb2
       sb   a,a                                            ; XOR A             ; A = 0
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; slow down
       .push ix                                            ; PUSH IX           ; 
       .call @compute_relative_position_scale              ; CALL $2DF1        ; work out the direction to the point
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; A = the table index/shift count
       ab   a,a                                            ; ADD A,A           ; *2 (word index)
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,steering_tolerances                         ; LD HL,$33C7       ; the tolerance table
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this size's entry
       li   de,steering_tolerance                          ; LD DE,$E86C       ; 
       .ldi                                                ; LDI               ; copy the tolerance to $E86C
       .ldi                                                ; LDI               ; 
       movb @cached_delta_x_sign,a                         ; LD A,($E864)      ; the direction's x sign
       mov  @ef92_scaled_magnitude_1,hl                    ; LD HL,($EF92)     ; its x
       mov  @side_vector,de                                ; LD DE,($F7D4)     ; side.x
       .call @signed_multiply_16x8_24                      ; CALL $2E56        ; multiply them
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @cached_delta_y_sign,a                         ; LD A,($E865)      ; the direction's y sign
       mov  @ef93_scaled_magnitude_2,hl                    ; LD HL,($EF93)     ; its y
       mov  @side_vector_y,de                              ; LD DE,($F7D6)     ; side.y
       .call @signed_multiply_16x8_24                      ; CALL $2E56        ; multiply them
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @cached_delta_z_sign,a                         ; LD A,($E866)      ; the direction's z sign
       mov  @ef94_scaled_magnitude_3,hl                    ; LD HL,($EF94)     ; its z
       mov  @side_vector_z,de                              ; LD DE,($F7D8)     ; side.z
       .call @signed_multiply_16x8_24                      ; CALL $2E56        ; multiply them
       movb @c,a                                           ; LD A,C            ; add the three products
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   @c,a                                           ; ADC A,C           ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   @c,a                                           ; ADC A,C           ; 
       .call @signed_divide_24_by_16                       ; CALL $2E7B        ; divide: the side dot product
       mov  @steering_tolerance,de                         ; LD DE,($E86C)     ; DE = the tolerance
       szcb @bit7,h                                        ; RES 7,H           ; without its sign
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       joc  retest_alignment_against_vector3               ; JR C,$2F2F        ; TODO: check code. inside it - check the roof
       .call @steering_table_lookup                        ; CALL $2FBC        ; outside it - E = its place in the table
       movb @bp_manoeuvrability,a                          ; LD A,($F806)      ; A = the turn rate
       movb a,@c                                           ; LD C,A            ; 
       ab   @e,a                                           ; ADD A,E           ; 
       cb   a,@bytes+>29                                   ; CP $29            ; rate + E over 40?
       jl   _2f1f                                          ; JR C,$2F1F        ; no - use the turn rate
       movb @bytes+>28,a                                   ; LD A,$28          ; yes - use 40 - E
       sb   @e,a                                           ; SUB E             ; 
       movb a,@c                                           ; LD C,A            ; 
_2f1f:                                                     ; >2f1f
       movb @steering_dot_product_hi,a                     ; LD A,($E86F)      ; the dot product's sign
       socb a,a                                            ; OR A              ; 
       movb @c,a                                           ; LD A,C            ; 
       jlt  !                                              ; JP P,$2F29        ; 
       b    @steer_roll                                    ;                   
!
       neg a                                               ; NEG               ; 
steer_roll:                                                ; >2f29
       .call @roll_object                                  ; CALL $23D9        ; roll
       b    @steer_done                                    ; JP $2FB9          ; 
retest_alignment_against_vector3:                          ; >2f2f
       .call @work_out_roof                                ; CALL $4599        ; work out the roof vector
       movb @cached_delta_x_sign,a                         ; LD A,($E864)      ; the direction's x sign
       mov  @ef92_scaled_magnitude_1,hl                    ; LD HL,($EF92)     ; its x
       mov  @roof_vector,de                                ; LD DE,($F7E0)     ; roof.x
       .call @signed_multiply_16x8_24                      ; CALL $2E56        ; multiply them
       .push bc                                            ; PUSH BC           ; stash this axis's result
       .push hl                                            ; PUSH HL           ; 
       movb @cached_delta_y_sign,a                         ; LD A,($E865)      ; the same for y
       mov  @ef93_scaled_magnitude_2,hl                    ; LD HL,($EF93)     ; 
       mov  @roof_vector_y,de                              ; LD DE,($F7E2)     ; roof.y
       .call @signed_multiply_16x8_24                      ; CALL $2E56        ; 
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @cached_delta_z_sign,a                         ; LD A,($E866)      ; and z
       mov  @ef94_scaled_magnitude_3,hl                    ; LD HL,($EF94)     ; 
       mov  @roof_vector_z,de                              ; LD DE,($F7E4)     ; roof.z
       .call @signed_multiply_16x8_24                      ; CALL $2E56        ; 
       movb @c,a                                           ; LD A,C            ; 
       .pop de                                             ; POP DE            ; add the three products
       .pop bc                                             ; POP BC            ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   @c,a                                           ; ADC A,C           ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   @c,a                                           ; ADC A,C           ; 
       .call @signed_divide_24_by_16                       ; CALL $2E7B        ; divide: the roof dot product
       movb @cached_delta_z_sign,a                         ; LD A,($E866)      ; the direction's z sign
       movb a,@c                                           ; LD C,A            ; 
       movb @orientation_vector_2_z_sign,a                 ; LD A,($F7DF)      ; nose.z's sign
       ; XOR C                                             ; XOR C             ; TODO: check code. compare the two signs
       jlt  !                                              ; JP P,$2F85        ; the same - check the tolerance
       b    @check_reduced_ratio_against_threshold         ;                   
!
       movb @steering_dot_product_hi,a                     ; LD A,($E86F)      ; different: the dot product's sign
       socb a,a                                            ; OR A              ; 
       movb @bp_manoeuvrability,a                          ; LD A,($F806)      ; A = the turn rate
       jlt  !                                              ; JP P,$2F80        ; 
       b    @steer_pitch_behind                            ;                   
!
       neg a                                               ; NEG               ; 
steer_pitch_behind:                                        ; >2f80
       .call @pitch_object                                 ; CALL $2365        ; pitch
       jmp  steer_done                                     ; JR $2FB9          ; 
check_reduced_ratio_against_threshold:                     ; >2f85
       mov  @steering_tolerance,de                         ; LD DE,($E86C)     ; DE = the tolerance
       szcb @bit7,h                                        ; RES 7,H           ; without its sign
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       joc  abandon_axis_flag_f7f4                         ; JR C,$2FB4        ; TODO: check code. inside it - pointing at the point
       .call @steering_table_lookup                        ; CALL $2FBC        ; outside it - E = its place in the table
       movb @bp_manoeuvrability,a                          ; LD A,($F806)      ; A = the turn rate
       movb a,@c                                           ; LD C,A            ; 
       ab   @e,a                                           ; ADD A,E           ; 
       cb   a,@bytes+>29                                   ; CP $29            ; rate + E over 40?
       jl   _2fa5                                          ; JR C,$2FA5        ; no - use the turn rate
       movb @bytes+>28,a                                   ; LD A,$28          ; yes - use 40 - E
       sb   @e,a                                           ; SUB E             ; 
       movb a,@c                                           ; LD C,A            ; 
       movb one,a                                          ; LD A,$01          ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; and speed up
_2fa5:                                                     ; >2fa5
       movb @steering_dot_product_hi,a                     ; LD A,($E86F)      ; the dot product's sign
       socb a,a                                            ; OR A              ; 
       movb @c,a                                           ; LD A,C            ; 
       jlt  !                                              ; JP P,$2FAF        ; 
       b    @steer_pitch                                   ;                   
!
       neg a                                               ; NEG               ; 
steer_pitch:                                               ; >2faf
       .call @pitch_object                                 ; CALL $2365        ; pitch
       jmp  steer_done                                     ; JR $2FB9          ; 
abandon_axis_flag_f7f4:                                    ; >2fb4
       movb one,a                                          ; LD A,$01          ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; speed up
steer_done:                                                ; >2fb9
       .pop ix                                             ; POP IX            ; restore the caller's IX
       .ret                                                ; RET               ; 

********************************************************************************
* Steering: how far is the object off line?
* 
* Used by the routine at #R$2EB2.
* .
* Looks up the dot product (#R$E86E, without its sign) in the sine table
* at #R$33D7 - sin(20 - n/2 degrees) for n = 0 to 40 - by binary search,
* finding the entry n with sin(20 - n/2) >= the dot product >
* sin(20 - (n+1)/2). So 40 - n is how far off line the object is, in
* half-degrees (up to 40, for 20 degrees or more), which #R$2EB2 uses to
* cap the turn rate. Returns at once on an exact match.
* 
* O:E 40 - the angle off line, in half-degrees (0-40)
steering_table_lookup:                                     ; >2fbc
       .exx                                                ; EXX               ; work in the shadow set for the search bounds
       mov  @steering_dot_product,de                       ; LD DE,($E86E)     ; DE' = the dot product...
       szcb @bit7,d                                        ; RES 7,D           ; ...without its sign
       li   bc,steering_sines                              ; LD BC,$33D7       ; BC' -> the sine table
       .exx                                                ; EXX               ; 
       li   bc,>0029                                       ; LD BC,$0029       ; B = 0 (low bound), C = 41 (high bound)
_2fca:                                                     ; >2fca
       movb b,a                                            ; LD A,B            ; A = B+C...
       ab   @c,a                                           ; ADD A,C           ; 
       srl  a,1                                            ; RRA               ; TODO: check code. ...halved: the midpoint index
       movb a,@e                                           ; LD E,A            ; E = midpoint index
       .exx                                                ; EXX               ; back to the shadow set
       ab   a,a                                            ; ADD A,A           ; A = midpoint index * 2 (word offset)
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> table[midpoint]
       movb *hl,a                                          ; LD A,(HL)         ; HL = the table's word there
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; 
       s    de,hl                                          ; SBC HL,DE         ; compare it with the dot product
       .exx                                                ; EXX               ; back to the main set
       jne  !                                              ; RET Z             ; exact match - E already holds the index
       .ret                                                ;                   
!
       .ex_af_af_                                          ; EX AF,AF'         ; save the comparison's flags
       movb @e,a                                           ; LD A,E            ; 
       cb   a,b                                            ; CP B              ; the midpoint is the low bound?
       jne  !                                              ; RET Z             ; yes - E holds the answer
       .ret                                                ;                   
!
       .ex_af_af_                                          ; EX AF,AF'         ; restore the comparison's flags
       jnc  binary_search_narrow_low_bound                 ; JR NC,$2FE6       ; TODO: check code. entry >= the dot product - raise the low bound
       movb @e,@c                                          ; LD C,E            ; entry < the dot product - lower the high bound
       jmp  _2fe7                                          ; JR $2FE7          ; 
binary_search_narrow_low_bound:                            ; >2fe6
       movb @e,b                                           ; LD B,E            ; B = midpoint index (new low bound)
_2fe7:                                                     ; >2fe7
       jmp  _2fca                                          ; JR $2FCA          ; retry with the narrowed [B,C] range

********************************************************************************
* Get a ship's blueprint
* 
* Used by the routines at #R$25B9, #R$3037, #R$3187 and #R$31AD.
* .
* Points IY at the blueprint for a ship type, from the table at #R$A7D7.
* 
* I:A Ship type
* O:IY The blueprint (see #R$A817 for the layout)
get_blueprint:                                             ; >2fe9
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; BC = ship type * 2
       li   hl,ship_blueprints                             ; LD HL,$A7D7       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> its entry in the blueprint table
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,b                                          ; LD B,(HL)         ; BC = the blueprint's address
       movb b,iyh                                          ; LD IYH,B          ; 
       movb @c,@iyl                                        ; LD IYL,C          ; IY = BC
       .ret                                                ; RET               ; 

********************************************************************************
* Use an object's position as the reference point
* 
* Used by the routines at #R$25B9 and #R$3113.
* .
* Copies the position (x, y and z) of the object in slot A of the object
* table (#R$EBA0) to the reference point (#R$EB88), the point that objects
* steer towards: a missile's target (#R$25B9) or the space station
* (#R$3113).
* 
* I:A Slot number (0-19)
* O:IX The object's slot
set_reference_point:                                       ; >2ff9
       movb @bytes+>28,@e                                  ; LD E,$28          ; 40 bytes to a slot
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = A * 40
       li   de,ship_object_table                           ; LD DE,$EBA0       ; 
       a    de,hl                                          ; ADD HL,DE         ; HL -> the slot
       .push hl                                            ; PUSH HL           ; 
       .pop ix                                             ; POP IX            ; IX -> the slot
       inc  hl                                             ; INC HL            ; HL -> its position (#R$F7CE)
       li   de,reference_point_x                           ; LD DE,$EB88       ; DE -> the reference point
       .ldi                                                ; LDI               ; copy x...
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; ...y...
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; ...and z
       .ldi                                                ; LDI               ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Find the missile aimed at an object
* 
* Used by the routines at #R$30EA and #R$46CA.
* .
* Looks through the object table (#R$EBA0) for a missile (ship type 2)
* whose target (byte $22 of its record, see #R$F7EF) is the object in
* slot C. Enemy missiles are checked too, though that byte isn't set for
* them (#R$2A3A).
* 
* I:C Slot number of the target
* O:F Z set if there is one
* O:IX Pointer to the missile's record
find_missile_at_object:                                    ; >3016
       li   ix,ship_object_table                           ; LD IX,$EBA0       ; IX -> the ship-object table
       li   de,>0028                                       ; LD DE,$0028       ; DE = 40, one slot's stride
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_301f:                                                     ; >301f
       movb *ix,r0                                         ; BIT 0,(IX+$00)    ; in use?
       andi r0,>0100                                       ;                   
       jeq  _3031                                          ; JR Z,$3031        ; no - skip it
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; A = ship type
       cb   a,@bytes+>02                                   ; CP $02            ; a missile?
       jne  _3031                                          ; JR NZ,$3031       ; not a missile
       movb @>22(ix),a                                     ; LD A,(IX+$22)     ; A = its target
       cb   a,@c                                           ; CP C              ; does it match the one we're looking for?
       jne  !                                              ; RET Z             ; aimed at this object
       .ret                                                ;                   
!
_3031:                                                     ; >3031
       a    de,ix                                          ; ADD IX,DE         ; next slot
       sb   one,b                                          ; DJNZ $301F        ; 
       jne  _301f                                          ;                   
       ab   one,b                                          ; INC B             ; none found: NZ
       .ret                                                ; RET               ; 

********************************************************************************
* Add an object to the object table
* 
* Used by the routines at #R$1703, #R$19FC, #R$1E01, #R$2A3A, #R$2A71, #R$2A94,
* #R$2B05, #R$2C3C, #R$2D3B, #R$2D7E, #R$3187, #R$8C94, #R$8D2A and #R$8DB9.
* .
* Copies the working object (#R$F7CD), whose ship type and handler type the
* caller has set up, into the first free slot of the 20-slot object table
* (#R$EBA0). On the way it gets its turn number (1-3, see #R$2542) from
* #R$E92F; its energy (#R$F7E9) from byte $0C of its blueprint (#R$2FE9);
* its speed (#R$F7E6) from byte $0D, unless the caller set it to 0; and its
* missiles (#R$F7EA) from bits 0-6 of byte $13. The counts of objects about
* are updated (#R$E844, #R$E93A, #R$E939).
* .
* At $3090, counts pirates (class 4) in #R$E939.
* .
* At $30A4, tries the next slot, returning with carry clear if there are no
* more.
* 
* O:F Carry set if it was added, clear if the table is full
add_object:                                                ; >3037
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; 
       li   de,>0028                                       ; LD DE,$0028       ; 
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_303f:                                                     ; >303f
       movb *hl,r0                                         ; BIT 0,(HL)        ; in use?
       andi r0,>0100                                       ;                   
       jne  add_object_next_slot                           ; JR NZ,$30A4       ; yes - try the next
       .push hl                                            ; PUSH HL           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @next_turn_number,a                            ; LD A,($E92F)      ; A = the next turn number
       movb a,@turn_number                                 ; LD ($F7ED),A      ; give it to this object
       ab   one,a                                          ; INC A             ; 
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  _3052                                          ; JR NZ,$3052       ; 
       movb one,a                                          ; LD A,$01          ; (1-3)
_3052:                                                     ; >3052
       movb a,@next_turn_number                            ; LD ($E92F),A      ; 
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       .call @get_blueprint                                ; CALL $2FE9        ; IY -> the blueprint
       movb @>0c(iy),a                                     ; LD A,(IY+$0C)     ; 
       movb a,@object_energy                               ; LD ($F7E9),A      ; energy
       li   hl,object_speed                                ; LD HL,$F7E6       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _306c                                          ; JR Z,$306C        ; speed 0 - leave it
       movb @>0d(iy),a                                     ; LD A,(IY+$0D)     ; 
       movb a,*hl                                          ; LD (HL),A         ; speed
_306c:                                                     ; >306c
       movb @>13(iy),a                                     ; LD A,(IY+$13)     ; 
       andi a,>7f00                                        ; AND $7F           ; 
       movb a,@object_missiles                             ; LD ($F7EA),A      ; missiles
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       cb   a,@bytes+>20                                   ; CP $20            ; 
       jhe  _3098                                          ; JR NC,$3098       ; the planet or the sun - not counted
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,ship_type_counts                            ; LD HL,$E844       ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       ab   one,*hl                                        ; INC (HL)          ; one more of this ship type
       movb @>12(iy),a                                     ; LD A,(IY+$12)     ; 
       andi a,>1c00                                        ; AND $1C           ; A = class
       jne  add_object_count_pirates                       ; JR NZ,$3090       ; not a trader
       li   hl,trader_count                                ; LD HL,$E93A       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more trader
       jmp  _3098                                          ; JR $3098          ; 
add_object_count_pirates:                                  ; >3090
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  _3098                                          ; JR NZ,$3098       ; not a pirate
       li   hl,pirate_count                                ; LD HL,$E939       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more pirate
_3098:                                                     ; >3098
       .pop de                                             ; POP DE            ; 
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; 
       ; SCF                                               ; SCF               ; TODO: check code. 
       .pop hl                                             ; POP HL            ; 
       .ret                                                ; RET               ; 
add_object_next_slot:                                      ; >30a4
       a    de,hl                                          ; ADD HL,DE         ; 
       sb   one,b                                          ; DJNZ $303F        ; 
       jne  _303f                                          ;                   
       socb a,a                                            ; OR A              ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Remove the working object
* 
* Used by the routines at #R$2556, #R$25B9, #R$27C0, #R$27F4 and #R$8BA6.
* .
* Marks the working object's record as unused, and updates the counts of
* objects about: the ship type's count (#R$E844); in witchspace, the number
* of kills still needed before hyperspace works (#R$EEC2); and the traders
* (#R$E93A) or pirates (#R$E939, $30D7). Removing a Cougar (ship type $1E)
* resets the mission state ($E93D) to 0.
remove_object:                                             ; >30a9
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       szcb @bit0,*hl                                      ; RES 0,(HL)        ; unused
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = its ship type
       cb   a,@bytes+>20                                   ; CP $20            ; 
       jl   !                                              ; RET NC            ; the planet or the sun
       .ret                                                ;                   
!
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; BC = the ship type
       li   hl,ship_type_counts                            ; LD HL,$E844       ; per-ship-type on-screen object counts
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this ship type's count
       sb   one,*hl                                        ; DEC (HL)          ; one fewer of this ship type
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jeq  _30ca                                          ; JR Z,$30CA        ; no
       li   hl,witchspace_kills_needed                     ; LD HL,$EEC2       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _30ca                                          ; JR Z,$30CA        ; none left to kill
       sb   one,*hl                                        ; DEC (HL)          ; one fewer to kill
_30ca:                                                     ; >30ca
       movb @bp_class,a                                    ; LD A,($F807)      ; A = class
       andi a,>1c00                                        ; AND $1C           ; test bits 2-4
       jne  remove_object_pirates                          ; JR NZ,$30D7       ; not a trader
       li   hl,trader_count                                ; LD HL,$E93A       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer trader
       jmp  _30df                                          ; JR $30DF          ; 
remove_object_pirates:                                     ; >30d7
       cb   a,@bytes+>04                                   ; CP $04            ; was $F807's AND $1C result exactly 4 (bit 2 only)?
       jne  _30df                                          ; JR NZ,$30DF       ; not a pirate
       li   hl,pirate_count                                ; LD HL,$E939       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer pirate
_30df:                                                     ; >30df
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the object's ship type
       sb   @bytes+>1e,a                                   ; SUB $1E           ; the Cougar?
       jne  _30e9                                          ; JR NZ,$30E9       ; no - done
       movb a,@mission_state                               ; LD ($E93D),A      ; yes - mission state 0
_30e9:                                                     ; >30e9
       .ret                                                ; RET               ; 

********************************************************************************
* Cancel any missile lock on the object being removed
* 
* Used by the routines at #R$27F4, #R$28F6 and #R$8755.
* .
* Called when the object in the current slot (#R$E911) is destroyed or
* leaves. If the player's missile is locked on it (#R$E910 = 2, #R$E928),
* cancels the lock (#R$2D70) and shows "Target Lost"; otherwise, if a
* missile in flight has it as its target (#R$3016), removes that missile
* and shows "Target Lost" ($3100).
* .
* At $3100, removing the missile updates the count of missiles about (see
* #R$E844). At $310D, shows "Target Lost".
cancel_missile_lock_on_object:                             ; >30ea
       li   hl,current_slot                                ; LD HL,$E911       ; 
       movb @missile_state,a                               ; LD A,($E910)      ; 
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jl   remove_missile_at_object                       ; JR C,$3100        ; no missile locked on
       movb @missile_target,a                              ; LD A,($E928)      ; A = the locked target's slot
       cb   a,*hl                                          ; CP (HL)           ; 
       jne  remove_missile_at_object                       ; JR NZ,$3100       ; not this one
       .call @cancel_missile_lock                          ; CALL $2D70        ; cancel the lock
       b    @target_lost                                   ; JP $310D          ; "Target Lost"
remove_missile_at_object:                                  ; >3100
       movb *hl,@c                                         ; LD C,(HL)         ; C = the object's slot
       .call @find_missile_at_object                       ; CALL $3016        ; find a missile aimed at it
       jeq  !                                              ; RET NZ            ; none
       .ret                                                ;                   
!
       szcb @bit0,*ix                                      ; RES 0,(IX+$00)    ; remove the missile
       li   hl,num_missiles                                ; LD HL,$E846       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer missile about
target_lost:                                               ; >310d
       li   hl,msg_target_lost                             ; LD HL,$337D       ; "Target Lost"
       b    @show_view_message                             ; JP $39C8          ; display it

********************************************************************************
* Get the distance to another object
* 
* Used by the routines at #R$2641, #R$265E and #R$27C0.
* .
* Makes the object in slot A the reference point (#R$2FF9), and works out
* the distance from the current object to it (#R$84A6), from the sizes of
* the differences in x, y and z (#R$EB82). Used by the ship handlers for
* the distance to the planet (slot 0) or the space station (slot 1).
* Unlike #R$2DF1, it doesn't keep the signs of the differences or scale the
* distance.
* .
* The subtractions for y (at $3132) and z (at $3147) don't clear the carry
* flag first, so either difference can be out by one.
* 
* I:A Slot number (0-19)
* O:HL The distance (also in #R$EB6E)
distance_to_object:                                        ; >3113
       .call @set_reference_point                          ; CALL $2FF9        ; the object in slot A is the reference point
       mov  @object_position_x,hl                          ; LD HL,($F7CE)     ; 
       mov  @reference_point_x,de                          ; LD DE,($EB88)     ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = x - the reference point's x
       jlt  !                                              ; JP P,$3128        ; 
       b    @distance_dx                                   ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; HL = -HL if it's negative
distance_dx:                                               ; >3128
       mov  hl,@abs_delta_x                                ; LD ($EB82),HL     ; store |dx|
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; 
       mov  @reference_point_y,de                          ; LD DE,($EB8A)     ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = y - the reference point's y (minus the carry)
       jlt  !                                              ; JP P,$313D        ; 
       b    @distance_dy                                   ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; HL = -HL if it's negative
distance_dy:                                               ; >313d
       mov  hl,@abs_delta_y                                ; LD ($EB84),HL     ; store |dy|
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; 
       mov  @reference_point_z,de                          ; LD DE,($EB8C)     ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = z - the reference point's z (minus the carry)
       jlt  !                                              ; JP P,$3152        ; 
       b    @distance_dz                                   ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; HL = -HL if it's negative
distance_dz:                                               ; >3152
       mov  hl,@abs_delta_z                                ; LD ($EB86),HL     ; store |dz|
       .call @vector_length                                ; CALL $84A6        ; HL = the distance
       mov  hl,@reference_distance                         ; LD ($EB6E),HL     ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Launch the police from the space station
* 
* Used by the routine at #R$2B05.
* .
* Called every frame. While Vipers are due (($E934)), counts down 100
* frames between launches ($E870), then launches one (#R$3187): a Viper
* (ship type $0C) - or, in mission state $52, a Thargoid ($13) - with
* handler type 5 (fly out, then attack).
launch_police:                                             ; >315c
       movb @police_to_launch,a                            ; LD A,($E934)      ; A = the retry-attempts-remaining counter
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no Vipers due
       .ret                                                ;                   
!
       li   hl,police_launch_timer                         ; LD HL,$E870       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer cooldown frame
       jeq  !                                              ; RET NZ            ; not time yet
       .ret                                                ;                   
!
       movb @bytes+>64,*hl                                 ; LD (HL),$64       ; 100 frames until the next
       li   hl,police_to_launch                            ; LD HL,$E934       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer due
       movb one,a                                          ; LD A,$01          ; status: in use
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>52                                   ; CP $52            ; 
       movb @bytes+>0c,a                                   ; LD A,$0C          ; ship type $0C: Viper...
       jne  _317c                                          ; JR NZ,$317C       ; 
       movb @bytes+>13,a                                   ; LD A,$13          ; ...or a Thargoid in mission state $52
_317c:                                                     ; >317c
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       movb @bytes+>05,a                                   ; LD A,$05          ; handler type 5: fly out, then attack
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       b    @launch_from_station                           ; JP $3187          ; launch it

********************************************************************************
* Launch a ship from the space station
* 
* Used by the routines at #R$2B05 and #R$315C.
* .
* Does nothing if the space station has been destroyed (($EFA9), see
* #R$291E). Otherwise gives the working object - whose ship and handler
* types the caller has set - the station's position and orientation (from
* its object-table slot, slot 1), moves it out by the station's size
* (#R$8685), sets its speed to 0 and speeding up, and adds it to the
* object table (#R$3037).
launch_from_station:                                       ; >3187
       movb @station_destroyed,a                           ; LD A,($EFA9)      ; already spawned?
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; station destroyed - no launches
       .ret                                                ;                   
!
       li   hl,station_position                            ; LD HL,$EBC9       ; HL -> the station's object-table slot (slot 1)
       li   de,object_position_x                           ; LD DE,$F7CE       ; DE -> the working object's position field
       li   bc,>0018                                       ; LD BC,$0018       ; its position and orientation
       .ldir                                               ; LDIR              ; 
       movb one,a                                          ; LD A,$01          ; type 1 (station)
       .call @get_blueprint                                ; CALL $2FE9        ; IY -> the station's blueprint
       movb @>10(iy),a                                     ; LD A,(IY+$10)     ; 
       .call @move_along_axis                              ; CALL $8685        ; move the ship out by the station's size
       sb   a,a                                            ; XOR A             ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed 0
       ab   one,a                                          ; INC A             ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; speeding up
       b    @add_object                                    ; JP $3037          ; add it to the object table

********************************************************************************
* Destroy an object
* 
* Used by the routines at #R$25B9, #R$2618, #R$28F6, #R$323C, #R$329E and
* #R$8755.
* .
* Turns the object record at IX into an explosion: handler type 1
* (#R$2556) with a 64-frame countdown and an initial ($F7F0) of 40, speed
* 0, and bits 2 and 3 of its status byte set (bit 3 marks it as
* exploding, see #R$323C). Sets #R$E869 to say something was destroyed,
* and adds the object's value to the score (#R$32E7). Unless ($EFA1) is
* set, destroying a trader or a police ship (class 0 or $10 in its
* blueprint's byte $12) worsens the player's legal status (#R$EB65) by
* 64. Destroying a Thargoid (ship type $13) also sends its Thargons
* (type 6, whose byte $1E holds the Thargoid's slot number) away, by
* switching them to handler type 12 (#R$27F4).
* .
* Called for the player's missile hitting its target (#R$25FF), a
* missile hitting the player (#R$2618), the ECM destroying missiles
* (#R$323C), the energy bomb (#R$329E), and from #R$291E and #R$8755.
* 
* I:IX Pointer to the object's record
destroy_object:                                            ; >31ad
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; 
       .push ix                                            ; PUSH IX           ; 
       movb @bytes+>40,@>22(ix)                            ; LD (IX+$22),$40   ; explosion countdown: 64 frames
       movb @bytes+>28,@>23(ix)                            ; LD (IX+$23),$28   ; ($F7F0) = 40
       sb   @>19(ix),@>19(ix)                              ; LD (IX+$19),$00   ; speed 0
       movb one,@>21(ix)                                   ; LD (IX+$21),$01   ; handler type 1: explosion
       socb @bit2,*ix                                      ; SET 2,(IX+$00)    ; 
       socb @bit3,*ix                                      ; SET 3,(IX+$00)    ; exploding
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@something_destroyed                         ; LD ($E869),A      ; something was destroyed
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; 
       .call @get_blueprint                                ; CALL $2FE9        ; IY -> the object's blueprint data
       .call @add_score                                    ; CALL $32E7        ; add its value to the score
       movb @legal_status_exempt,a                         ; LD A,($EFA1)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _31f4                                          ; JR NZ,$31F4       ; legal status unaffected
       movb @>12(iy),a                                     ; LD A,(IY+$12)     ; 
       andi a,>1c00                                        ; AND $1C           ; A = its class
       jeq  _31e9                                          ; JR Z,$31E9        ; a trader
       cb   a,@bytes+>10                                   ; CP $10            ; 
       jne  _31f4                                          ; JR NZ,$31F4       ; not police either
_31e9:                                                     ; >31e9
       movb @legal_status,a                                ; LD A,($EB65)      ; 
       ab   @bytes+>40,a                                   ; ADD A,$40         ; legal status += 64, up to $FF
       jnc  _31f1                                          ; JR NC,$31F1       ; TODO: check code. 
       sb   a,a                                            ; SBC A,A           ; 
_31f1:                                                     ; >31f1
       movb a,@legal_status                                ; LD ($EB65),A      ; 
_31f4:                                                     ; >31f4
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; 
       cb   a,@bytes+>13                                   ; CP $13            ; a Thargoid?
       jne  _321d                                          ; JR NZ,$321D       ; no
       li   ix,ship_object_table                           ; LD IX,$EBA0       ; IX -> the object table
       li   de,>0028                                       ; LD DE,$0028       ; 
       movb @current_slot,a                                ; LD A,($E911)      ; 
       movb a,@c                                           ; LD C,A            ; C = the Thargoid's slot
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_3208:                                                     ; >3208
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; 
       cb   a,@bytes+>06                                   ; CP $06            ; a Thargon?
       jne  _3219                                          ; JR NZ,$3219       ; 
       movb @>1e(ix),a                                     ; LD A,(IX+$1E)     ; 
       cb   a,@c                                           ; CP C              ; one of this Thargoid's?
       jne  _3219                                          ; JR NZ,$3219       ; 
       movb @bytes+>0c,@>21(ix)                            ; LD (IX+$21),$0C   ; yes - send it away (handler type 12)
_3219:                                                     ; >3219
       a    de,ix                                          ; ADD IX,DE         ; 
       sb   one,b                                          ; DJNZ $3208        ; next slot
       jne  _3208                                          ;                   
_321d:                                                     ; >321d
       .pop ix                                             ; POP IX            ; 
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Key 'E': set off the ECM
* 
* Reached via the key table at #R$419B; only in flight (#R$6DCF). Needs an
* ECM system (#R$F778), and doesn't work while the jammer is on (#R$EFA8) -
* #R$16FE beeps instead. Plays the ECM sound effect, which runs the ECM
* (#R$782B), and shows the "E" indicator (#R$6B12).
key_handler_e:                                             ; >3223
       .call @refuse_if_docked                             ; CALL $6DCF        ; return to the key handler's caller if docked (#R$6DCF)
       movb @item_ecm_system,a                             ; LD A,($F778)      ; 
       socb a,a                                            ; OR A              ; ECM fitted?
       jne  !                                              ; JP Z,$16FE        ; no - beep
       b    @trigger_sfx_6                                 ;                   
!
       movb @jammer_active_flag,a                          ; LD A,($EFA8)      ; 
       socb a,a                                            ; OR A              ; jammer on?
       jeq  !                                              ; JP NZ,$16FE       ; yes - beep
       b    @trigger_sfx_6                                 ;                   
!
       movb @bytes+>08,a                                   ; LD A,$08          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 8 (ECM)
       b    @draw_ecm_indicator                            ; JP $6B12          ; show the "E" indicator (#R$6B12)

********************************************************************************
* ECM: drain energy and destroy missiles while it's on
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). Does nothing unless the
* ECM countdown (#R$E912) is running; once it has run out, turns the ECM
* off ($3294). While it's running, and the countdown (decremented on every
* VBlank) happens to be odd - about half the frames - it drains the energy
* banks by 1 (#R$19EC) and plays sound effect 4 if it isn't already playing
* (#R$E915); neither happens if it was an enemy's ECM (#R$EEC0 set, see
* #R$25B9). Then destroys (#R$31AD) every missile (ship type 2) that isn't
* already exploding - the player's as well as enemies' - and plays the
* explosion sound if there were any.
* .
* At $3294, once the ECM countdown has run out, clears the countdown and
* #R$EEC0, and hides the "E" indicator (#R$6B12).
ecm_active:                                                ; >323c
       movb @ecm_countdown,a                               ; LD A,($E912)      ; A = ECM countdown
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; ECM off
       .ret                                                ;                   
!
       jhe  !                                              ; JP M,$3294        ; finished - turn it off
       b    @ecm_off                                       ;                   
!
       czc  @bit0,a                                        ; BIT 0,A           ; 
       jeq  _325e                                          ; JR Z,$325E        ; countdown even - skip the energy drain
       movb @enemy_ecm,a                                   ; LD A,($EEC0)      ; an enemy's ECM?
       socb a,a                                            ; OR A              ; 
       jne  _325e                                          ; JR NZ,$325E       ; yes - no cost to the player
       movb @sound_effect_4_playing,a                      ; LD A,($E915)      ; sound effect 4 playing?
       socb a,a                                            ; OR A              ; 
       jne  _3259                                          ; JR NZ,$3259       ; sound effect 4 already playing
       movb @bytes+>04,a                                   ; LD A,$04          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 4
_3259:                                                     ; >3259
       movb one,b                                          ; LD B,$01          ; 
       .call @decay_counter_f817                           ; CALL $19EC        ; drain the energy banks by 1
_325e:                                                     ; >325e
       sb   a,a                                            ; XOR A             ; 
       movb a,@something_destroyed                         ; LD ($E869),A      ; nothing destroyed yet
       li   ix,ship_object_table                           ; LD IX,$EBA0       ; IX -> the object table
       li   de,>0028                                       ; LD DE,$0028       ; DE = 40 (one object record)
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_326b:                                                     ; >326b
       movb *ix,r0                                         ; BIT 0,(IX+$00)    ; in use?
       andi r0,>0100                                       ;                   
       jeq  _3285                                          ; JR Z,$3285        ; no - next slot
       movb *ix,r0                                         ; BIT 3,(IX+$00)    ; already exploding?
       andi r0,>0800                                       ;                   
       jne  _3285                                          ; JR NZ,$3285       ; yes - next slot
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; A = ship type
       cb   a,@bytes+>02                                   ; CP $02            ; a missile?
       jne  _3285                                          ; JR NZ,$3285       ; no - next slot
       socb @bit6,*ix                                      ; SET 6,(IX+$00)    ; no bounty for it
       .call @destroy_object                               ; CALL $31AD        ; destroy it
_3285:                                                     ; >3285
       a    de,ix                                          ; ADD IX,DE         ; IX -> the next slot
       sb   one,b                                          ; DJNZ $326B        ; 
       jne  _326b                                          ;                   
       movb @something_destroyed,a                         ; LD A,($E869)      ; anything destroyed?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no
       .ret                                                ;                   
!
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 2 (explosion)
       .ret                                                ; RET               ; 
ecm_off:                                                   ; >3294
       sb   a,a                                            ; XOR A             ; A = 0
       movb a,@enemy_ecm                                   ; LD ($EEC0),A      ; clear the enemy-ECM flag
       movb a,@ecm_countdown                               ; LD ($E912),A      ; clear the ECM countdown
       b    @draw_ecm_indicator                            ; JP $6B12          ; hide the "E" indicator

********************************************************************************
* Key TAB: set off the energy bomb
* 
* Reached only via #R$419B's (key code, handler) table - not a literal
* CALL/JP. Beeps (#R$16FE) and returns unless an energy bomb is fitted
* (#R$F77D, entry 8 of the equipment array at #R$F775); if it is, uses it up
* and destroys (#R$31AD) every active object except Thargoids (ship type
* $13), over the 17 (or, with #R$EEC1 set, 20) slots from slot 3 onward.
key_handler_tab:                                           ; >329e
       .call @refuse_if_docked                             ; CALL $6DCF        ; refuse if docked
       movb @item_energy_bomb,a                            ; LD A,($F77D)      ; A = a one-shot arm flag for this handler
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$16FE        ; not armed - beep (sfx 6) and return
       b    @trigger_sfx_6                                 ;                   
!
       sb   a,a                                            ; XOR A             ; 
       movb a,@item_energy_bomb                            ; LD ($F77D),A      ; disarm - one-shot
       movb a,@something_destroyed                         ; LD ($E869),A      ; clear the "matched a slot" flag
       li   ix,object_slot_3                               ; LD IX,$EC18       ; IX -> object table slot 3 (#R$EBA0+3*40)
       movb @bytes+>11,b                                   ; LD B,$11          ; 17 slots (the rest of the 20-slot table)
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jeq  _32c1                                          ; JR Z,$32C1        ; clear - use the default IX/count above
       li   ix,object_slot_3                               ; LD IX,$EC18       ; set - same base, but...
       movb @bytes+>14,b                                   ; LD B,$14          ; ...scan 20 slots (3 past the table's actual end)
_32c1:                                                     ; >32c1
       li   de,>0028                                       ; LD DE,$0028       ; DE = 40 (one object record)
_32c4:                                                     ; >32c4
       movb *ix,r0                                         ; BIT 0,(IX+$00)    ; this slot active?
       andi r0,>0100                                       ;                   
       jeq  _32d8                                          ; JR Z,$32D8        ; no - next slot
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; A = this slot's ship type
       cb   a,@bytes+>13                                   ; CP $13            ; a Thargoid?
       jeq  _32d8                                          ; JR Z,$32D8        ; yes - the bomb doesn't affect it
       socb @bit6,*ix                                      ; SET 6,(IX+$00)    ; no bounty for it
       .call @destroy_object                               ; CALL $31AD        ; destroy it
_32d8:                                                     ; >32d8
       a    de,ix                                          ; ADD IX,DE         ; IX -> the next slot
       sb   one,b                                          ; DJNZ $32C4        ; 
       jne  _32c4                                          ;                   
       movb @something_destroyed,a                         ; LD A,($E869)      ; A = the "matched a slot" flag
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; none matched - done
       .ret                                                ;                   
!
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 2 (explosion)
       .ret                                                ; RET               ; 

********************************************************************************
* Add to the score, and promote the player's combat rank
* 
* Used by the routine at #R$31AD.
* .
* Called by #R$31AD when an object is destroyed. Adds its score value
* (bytes $18-$19 of its blueprint, see #R$A817) to the 24-bit score
* (#R$EB13). If that reaches the threshold for the next rank (#R$336D), the
* combat rank (#R$EB12) goes up and "Right On Commander" is shown;
* otherwise $331B.
* .
* At $331B, counts the kills that don't bring a promotion (#R$E930), and
* shows "Right On Commander" every 256 of them - as BBC Elite does every
* 256 kills. The entry at $3320 shows the message.
* 
* I:IY Pointer to the object's blueprint
add_score:                                                 ; >32e7
       mov  @score,hl                                      ; LD HL,($EB13)     ; AHL = the score
       movb @score_2,a                                     ; LD A,($EB15)      ; A = the running total's high byte
       movb @>18(iy),@e                                    ; LD E,(IY+$18)     ; DE = the object's score value
       movb @>19(iy),d                                     ; LD D,(IY+$19)     ; 
       a    de,hl                                          ; ADD HL,DE         ; add it
       ab   @zero,a                                        ; ADC A,$00         ; propagate the carry into the high byte
       mov  hl,@score                                      ; LD ($EB13),HL     ; 
       movb a,@score_2                                     ; LD ($EB15),A      ; 
       .push af                                            ; PUSH AF           ; stash the new total's high byte...
       .push hl                                            ; PUSH HL           ; ...and low word
       movb @combat_rank,a                                 ; LD A,($EB12)      ; A = combat rank
       ab   a,a                                            ; ADD A,A           ; x2 - each table entry is a (byte,byte) pair below
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,combat_rank_thresholds                      ; LD HL,$336D       ; the rank thresholds
       a    de,hl                                          ; ADD HL,DE         ; HL -> the next rank's threshold
       sb   @e,@e                                          ; LD E,$00          ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,@c                                         ; LD C,(HL)         ; CDE = the threshold
       .pop hl                                             ; POP HL            ; recover the total's low word
       .pop af                                             ; POP AF            ; recover the total's high byte
       s    de,hl                                          ; SBC HL,DE         ; 
       sb   @c,a                                           ; SBC A,C           ; 
       joc  right_on_commander                             ; JR C,$331B        ; TODO: check code. not reached it yet
       li   hl,combat_rank                                 ; LD HL,$EB12       ; 
       ab   one,*hl                                        ; INC (HL)          ; promotion
       jmp  _3320                                          ; JR $3320          ; "Right On Commander"
right_on_commander:                                        ; >331b
       li   hl,kill_count                                  ; LD HL,$E930       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more kill
       jeq  !                                              ; RET NZ            ; not a multiple of 256
       .ret                                                ;                   
!
_3320:                                                     ; >3320
       li   hl,msg_right_commander                         ; LD HL,$3396       ; "Right On Commander"
       b    @show_view_message                             ; JP $39C8          ; display it

********************************************************************************
* Pick a random pirate ship type
* 
* Used by the routine at #R$2C3C.
* .
* Picks one of the ten pirate ship types $12-$1B (Krait, Thargoid, Boa
* Class Cruiser, Gecko, Moray Star Boat, Adder, Mamba, Asp MkII,
* Sidewinder, Wolf MkII) at random - but only a Thargoid if there are no
* pirates about (#R$E939).
* 
* O:A Ship type (also in #R$F7E7)
random_pirate:                                             ; >3326
       .call @random_byte                                  ; CALL $2176        ; A = a random byte
       andi a,>0f00                                        ; AND $0F           ; 
       cb   a,@bytes+>0a                                   ; CP $0A            ; 10 or above?
       jhe  random_pirate                                  ; JR NC,$3326       ; 0-9 only
       ab   @bytes+>12,a                                   ; ADD A,$12         ; ship type $12-$1B
       movb a,@ship_type                                   ; LD ($F7E7),A      ; store as the ship type
       cb   a,@bytes+>13                                   ; CP $13            ; rolled exactly 19?
       jeq  !                                              ; RET NZ            ; not a Thargoid
       .ret                                                ;                   
!
       movb @pirate_count,a                                ; LD A,($E939)      ; A = number of pirates about
       socb a,a                                            ; OR A              ; 
       jne  random_pirate                                  ; JR NZ,$3326       ; there are some - pick again
       movb @ship_type,a                                   ; LD A,($F7E7)      ; none active - A = the chosen ship type (as the return value)
       .ret                                                ; RET               ; 

********************************************************************************
* Save the working object record to scratch ($0080)
* 
* Used by the routines at #R$2A3A, #R$2A71, #R$2A94, #R$2C3C and #R$8DB9.
* .
* Copies the full 40-byte #R$F7CD working-object record to the fixed
* scratch buffer at $0080, freeing #R$F7CD up for other use before
* #R$334D restores it.
save_working_object_to_scratch:                            ; >3341
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; source: the working object record
       li   de,>0080                                       ; LD DE,$0080       ; dest: scratch
       li   bc,>0028                                       ; LD BC,$0028       ; 40 bytes
       .ldir                                               ; LDIR              ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Restore the working object record from scratch ($0080)
* 
* Used by the routines at #R$2A3A, #R$2A71, #R$2A94, #R$2C3C and #R$8DB9.
* .
* The inverse of #R$3341: copies the 40-byte record back from $0080
* into #R$F7CD.
restore_working_object_from_scratch:                       ; >334d
       li   hl,>0080                                       ; LD HL,$0080       ; source: scratch
       li   de,object_status_byte                          ; LD DE,$F7CD       ; dest: the working object record
       li   bc,>0028                                       ; LD BC,$0028       ; 40 bytes
       .ldir                                               ; LDIR              ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Check for ships that stop the Torus Jump Drive
* 
* Used by the routine at #R$86E6.
* .
* Returns nonzero if there are any traders (#R$E93A), pirates (#R$E939)
* or Thargoids (entry $13 of #R$E844) about.
* 
* O:A Nonzero (with the zero flag reset) if there are any
any_ships_about:                                           ; >3359
       movb @trader_count,a                                ; LD A,($E93A)      ; 
       li   hl,pirate_count                                ; LD HL,$E939       ; 
       socb *hl,a                                          ; OR (HL)           ; 
       li   hl,num_thargoids                               ; LD HL,$E857       ; 
       socb *hl,a                                          ; OR (HL)           ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Laser beam start points
* 
* The (x, y) screen coordinates #R$2DC8 draws the laser beams from: two
* beams from each bottom corner of the space view.
laser_beam_start_points:                                   ; >3365
       byte >00,>7F                                                  ; bottom left
       byte >00,>76                                                  ; bottom left, a little higher
       byte >AF,>7F                                                  ; bottom right
       byte >AF,>76                                                  ; bottom right, a little higher

********************************************************************************
* Combat rank thresholds
* 
* The score (#R$EB13) needed for each promotion (#R$32E7): the middle and
* high bytes of a 24-bit number (the low byte being 0).
combat_rank_thresholds:                                    ; >336d
       byte >08,>00                                                  ; 2048: Mostly Harmless
       byte >10,>00                                                  ; 4096: Poor
       byte >20,>00                                                  ; 8192: Average
       byte >40,>00                                                  ; 16384: Above average
       byte >80,>00                                                  ; 32768: Competent
       byte >00,>02                                                  ; 131072: Dangerous
       byte >00,>0A                                                  ; 655360: Deadly
       byte >00,>19                                                  ; 1638400: E-L-I-T-E

********************************************************************************
* The message "Target Lost"
msg_target_lost:                                           ; >337d
       text 'TARGET LOS',>f4

********************************************************************************
* The message "Condition RED!"
msg_condition_red:                                         ; >3388
       text 'CONDITION RED',>a1

********************************************************************************
* The message "Right On Commander"
msg_right_commander:                                       ; >3396
       text 'RIGHT ON COMMANDE',>f2

********************************************************************************
* The message "Missile jammed!"
msg_missile_jammed:                                        ; >33a8
       text 'MISSILE JAMMED',>a1

********************************************************************************
* The message "Incoming missile"
msg_incoming_missile:                                      ; >33b7
       text 'INCOMING MISSIL',>e5

********************************************************************************
* Steering tolerances
* 
* The tolerance #R$2EB2 uses when deciding whether an object is pointing at
* its target, indexed by the depth's shift (#R$EB9B, 0-8), so the further
* away the target, the smaller the tolerance. Entry n is sin(3 + 2n degrees)
* * $4000, i.e. the dot product of two unit vectors (1.0 = $4000) that are
* that far apart; entry 8, sin(20 degrees), is the first entry of #R$33D7.
steering_tolerances:                                       ; >33c7
       data >0359                                                    ; 0: sin(3)
       data >0594                                                    ; 1: sin(5)
       data >07CD                                                    ; 2: sin(7)
       data >0A03                                                    ; 3: sin(9)
       data >0C36                                                    ; 4: sin(11)
       data >0E66                                                    ; 5: sin(13)
       data >1090                                                    ; 6: sin(15)
       data >12B6                                                    ; 7: sin(17)

********************************************************************************
* Steering sine table
* 
* sin(20 - n/2 degrees) * $4000 for n = 0-40, i.e. from 20 degrees down to 0
* in half-degree steps. #R$2FBC looks up a dot product here to find how far
* (in half degrees) an object is from pointing at its target.
steering_sines:                                            ; >33d7
       data >15E3                                                    ; 0: sin(20)
       data >155D                                                    ; 1: sin(19.5)
       data >14D6                                                    ; 2: sin(19)
       data >144E                                                    ; 3: sin(18.5)
       data >13C6                                                    ; 4: sin(18)
       data >133E                                                    ; 5: sin(17.5)
       data >12B6                                                    ; 6: sin(17)
       data >122D                                                    ; 7: sin(16.5)
       data >11A4                                                    ; 8: sin(16)
       data >111a                                                    ; 9: sin(15.5)
       data >1090                                                    ; 10: sin(15)
       data >1006                                                    ; 11: sin(14.5)
       data >0F7B                                                    ; 12: sin(14)
       data >0EF0                                                    ; 13: sin(13.5)
       data >0E65                                                    ; 14: sin(13)
       data >0dda                                                    ; 15: sin(12.5)
       data >0D4E                                                    ; 16: sin(12)
       data >0CC2                                                    ; 17: sin(11.5)
       data >0C36                                                    ; 18: sin(11)
       data >0BA9                                                    ; 19: sin(10.5)
       data >0B1D                                                    ; 20: sin(10)
       data >0A90                                                    ; 21: sin(9.5)
       data >0A03                                                    ; 22: sin(9)
       data >0975                                                    ; 23: sin(8.5)
       data >08E8                                                    ; 24: sin(8)
       data >085A                                                    ; 25: sin(7.5)
       data >07CC                                                    ; 26: sin(7)
       data >073E                                                    ; 27: sin(6.5)
       data >06B0                                                    ; 28: sin(6)
       data >0622                                                    ; 29: sin(5.5)
       data >0593                                                    ; 30: sin(5)
       data >0505                                                    ; 31: sin(4.5)
       data >0476                                                    ; 32: sin(4)
       data >03E8                                                    ; 33: sin(3.5)
       data >0359                                                    ; 34: sin(3)
       data >02CA                                                    ; 35: sin(2.5)
       data >023B                                                    ; 36: sin(2)
       data >01AC                                                    ; 37: sin(1.5)
       data >011D                                                    ; 38: sin(1)
       data >008E                                                    ; 39: sin(0.5)
       data >0000                                                    ; 40: sin(0)

********************************************************************************
* Missile launch position and orientation
* 
* Copied to #R$F7CE by #R$2D7E for a missile fired by the player: X = 0, Y =
* -50, Z = 20, then the side vector (1, 0, 0) and the nose vector (0, 0, 1).
missile_launch_start:                                      ; >3429
       data >0000,>FFCE,>0014                                        ; X, Y, Z
       data >4000,>0000,>0000                                        ; side vector
       data >0000,>0000,>4000                                        ; nose vector

********************************************************************************
* Escort formation
* 
* Where #R$2C3C puts a pirate's (or the Cougar's, or a Thargoid's)
* escorts, one 5-byte record each: the address of one of the leader's
* orientation vectors (side or roof), the distance (700), and $00 to use
* the vector as it is or $80 to negate it. So the escorts fly to the
* right of, to the left of, above and below the leader. There are at most
* 4 escorts.
escort_formation:                                          ; >343b
       data side_vector                                              ; right: +side
       data >02BC                                                    ; 
       byte >00                                                      ; 
       data side_vector                                              ; left: -side
       data >02BC                                                    ; 
       byte >80                                                      ; 
       data roof_vector                                              ; above: +roof
       data >02BC                                                    ; 
       byte >00                                                      ; 
       data roof_vector                                              ; below: -roof
       data >02BC                                                    ; 
       byte >80                                                      ; 

********************************************************************************
* Scan the keyboard
* 
* Used by the routine at #R$347A.
* .
* Selects each row of the keyboard matrix in turn, from 9 down to 0 (PPI port
* $AA), and reads its keys (port $A9, a bit reset for each key pressed),
* returning at the first row with a key pressed.
* 
* O:A The row's keys (a bit reset for each key pressed)
* O:B The row
* O:F Z set if no key is pressed
scan_keyboard:                                             ; >344f
       ; IN A,($AA)                                        ; IN A,($AA)        ; TODO: check code. 
       andi a,>f000                                        ; AND $F0           ; 
       movb a,@e                                           ; LD E,A            ; E = the other bits of port $AA
       movb @bytes+>09,b                                   ; LD B,$09          ; start at row 9
scan_keyboard_row:                                         ; >3456
       movb b,a                                            ; LD A,B            ; 
       socb @e,a                                           ; OR E              ; 
       ; OUT ($AA),A                                       ; OUT ($AA),A       ; TODO: check code. select the row
       ; IN A,($A9)                                        ; IN A,($A9)        ; TODO: check code. read its keys
       cb   a,@b255                                        ; CP $FF            ; 
       jeq  !                                              ; RET NZ            ; a key is pressed
       .ret                                                ;                   
!
       sb   one,b                                          ; DEC B             ; next row
       jlt  !                                              ; JP P,$3456        ; 
       b    @scan_keyboard_row                             ;                   
!
       ab   one,b                                          ; INC B             ; none: B = 0, with Z set
       .ret                                                ; RET               ; 

********************************************************************************
* Convert a key's row and column into its character
* 
* Used by the routine at #R$347A.
* .
* Works out the key code - row * 8 + the position of the first pressed key
* in the column byte, from bit 7 - and (at $3471) returns the character for
* that key code from the key table at #R$0A57.
* 
* I:A The column byte (a bit set for each pressed key)
* I:B The row
* O:A The character
key_row_column_to_char:                                    ; >3465
       movb a,@c                                           ; LD C,A            ; C = the column byte (one bit set per pressed key)
       movb b,a                                            ; LD A,B            ; A = the row index
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; A = row * 8
_346a:                                                     ; >346a
       ; RL C                                              ; RL C              ; TODO: check code. rotate the next column bit into carry
       joc  key_character                                  ; JR C,$3471        ; TODO: check code. found the set bit - A is the final key code
       ab   one,a                                          ; INC A             ; else advance to the next code...
       jmp  _346a                                          ; JR $346A          ; ...and keep scanning
key_character:                                             ; >3471
       li   hl,key_code_table                              ; LD HL,$0A57       ; the key table
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; BC = the key code
       a    bc,hl                                          ; ADD HL,BC         ; HL -> the key's entry
       movb *hl,a                                          ; LD A,(HL)         ; A = its character
       .ret                                                ; RET               ; 

********************************************************************************
* Read the keyboard
* 
* Used by the routine at #R$7202.
* .
* Called once per VBlank. While the key found last time (in the row in
* ($E932), with the column mask in ($E931)) is still held, does nothing, so
* that each press counts once. Otherwise scans the keyboard (#R$344F): if a
* key is pressed, remembers its row and column and stores its character
* (#R$3465) in #R$E8F5 (at $349B); if not, notes that no key is held
* (($E932) = $FF).
read_keyboard:                                             ; >347a
       movb @keyboard_debounce_cached_row,a                ; LD A,($E932)      ; A = the cached row nibble ($FF = none cached)
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$3490        ; none cached (or was $FF) - do a full scan
       b    @read_keyboard_scan                            ;                   
!
       movb a,@c                                           ; LD C,A            ; C = the cached row nibble
       ; IN A,($AA)                                        ; IN A,($AA)        ; TODO: check code. 
       andi a,>f000                                        ; AND $F0           ; 
       socb @c,a                                           ; OR C              ; 
       ; OUT ($AA),A                                       ; OUT ($AA),A       ; TODO: check code. re-strobe just that row
       ; IN A,($A9)                                        ; IN A,($A9)        ; TODO: check code. 
       li   hl,keyboard_debounce_column_mask               ; LD HL,$E931       ; 
       ; AND (HL)                                          ; AND (HL)          ; TODO: check code. still holding the same key?
       jne  !                                              ; RET Z             ; yes - nothing new
       .ret                                                ;                   
!
read_keyboard_scan:                                        ; >3490
       .call @scan_keyboard                                ; CALL $344F        ; scan the keyboard
       jne  cache_key_and_translate_to_action              ; JR NZ,$349B       ; found a key
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@keyboard_debounce_cached_row                ; LD ($E932),A      ; no key held
       .ret                                                ; RET               ; 
cache_key_and_translate_to_action:                         ; >349b
       inv  a                                              ; CPL               ; A = the column byte (a bit set for the key)
       movb a,@c                                           ; LD C,A            ; 
       mov  bc,@keyboard_debounce_column_mask              ; LD ($E931),BC     ; remember the key's row and column
       .call @key_row_column_to_char                       ; CALL $3465        ; A = its character
       movb a,@pending_debounced_keypress_byte_status      ; LD ($E8F5),A      ; 
       .ret                                                ; RET               ; 

********************************************************************************
* RST $00 target: print character A
* 
* Used by the routines at #R$0000 and #R$357A.
* .
* Copies the character's 8-byte pattern (from $099F + A * 8) to $E600,
* shifted right by the cursor's pixel offset (#R$E70E), and XORs it into
* the two character cells at the cursor (#R$E70F): the characters are 6
* pixels wide, so most straddle two 8-pixel cells. At $351C, moves on to
* the second cell, and then moves the cursor on 6 pixels (and the column,
* #R$E72C, on by one).
print_char:                                                ; >34a8
       .push af                                            ; PUSH AF           ; save registers
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; 
       movb a,@l                                           ; LD L,A            ; HL = A (the character code)
       sb   h,h                                            ; LD H,$00          ; 
       a    hl,hl                                          ; ADD HL,HL         ; HL *= 8 (this char's offset into the font table)
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       li   bc,log_table+>019f                             ; LD BC,$099F       ; the font pattern table
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this character's 8-byte glyph
       li   de,scratch_buffer                              ; LD DE,$E600       ; DE -> the staging buffer
       li   bc,>0008                                       ; LD BC,$0008       ; 8 bytes
       .ldir                                               ; LDIR              ; copy the glyph in
       .ex_de_hl                                           ; EX DE,HL          ; HL -> just past the copied glyph ($E608)
       sb   *hl,*hl                                        ; LD (HL),$00       ; zero it...
       li   de,scratch_buffer_5+>0004                      ; LD DE,$E609       ; ...and the following 7 bytes too
       movb @bytes+>07,@c                                  ; LD C,$07          ; 
       .ldir                                               ; LDIR              ; ($E608-$E60F: the buffer's "spillover" half, initially all zero)
       movb @cursor_subpixel_offset,a                      ; LD A,($E70E)      ; A = the cursor's sub-pixel shift (0-7)
       socb a,a                                            ; OR A              ; 
       jeq  _34e5                                          ; JR Z,$34E5        ; no shift needed - the buffer's ready as-is
       movb a,b                                            ; LD B,A            ; B = the shift amount
       li   hl,scratch_buffer                              ; LD HL,$E600       ; HL -> the glyph half of the buffer
       li   de,scratch_buffer_5+>0003                      ; LD DE,$E608       ; DE -> the spillover half
       movb @bytes+>08,@c                                  ; LD C,$08          ; 8 rows
_34d7:                                                     ; >34d7
       .push bc                                            ; PUSH BC           ; 
       movb *de,a                                          ; LD A,(DE)         ; A = this row's spillover byte (0 to start)
_34d9:                                                     ; >34d9
       ; SRL (HL)                                          ; SRL (HL)          ; TODO: check code. shift the glyph byte right one bit...
       srl  a,1                                            ; RRA               ; TODO: check code. ...carrying the bit shifted out into A's top bit
       sb   one,b                                          ; DJNZ $34D9        ; repeat for the full shift amount
       jne  _34d9                                          ;                   
       movb a,*de                                          ; LD (DE),A         ; store what spilled over into the next byte
       inc  hl                                             ; INC HL            ; both halves -> next row
       inc  de                                             ; INC DE            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,@c                                         ; DEC C             ; 
       jne  _34d7                                          ; JR NZ,$34D7       ; next row
_34e5:                                                     ; >34e5
       mov  @cursor_vram_addr,de                           ; LD DE,($E70F)     ; DE -> this cell's row-0 pattern-table byte
       li   hl,scratch_buffer                              ; LD HL,$E600       ; HL -> the buffer's glyph (left-tile) half
       movb @bytes+>02,@c                                  ; LD C,$02          ; two tile columns to plot: this cell, then the next
_34ee:                                                     ; >34ee
       .push de                                            ; PUSH DE           ; stash this tile's base VRAM address
       movb @bytes+>08,b                                   ; LD B,$08          ; 8 rows
_34f1:                                                     ; >34f1
       limi 0                                              ; DI                ; VDP address/data access must not be interrupted
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb d,a                                            ; LD A,D            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, read mode
       .push hl                                            ; PUSH HL           ; (timing delay - let the VDP latch the address)
       .pop hl                                             ; POP HL            ; 
       movb @vdprd,a                                       ; IN A,($98)        ; A = the current pattern byte at that address
       ; XOR (HL)                                          ; XOR (HL)          ; TODO: check code. combine with this row's buffer byte
       inc  hl                                             ; INC HL            ; buffer -> next row
       .ex_af_af_                                          ; EX AF,AF'         ; stash the combined byte
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; re-issue the address, low byte
       movb d,a                                            ; LD A,D            ; 
       socb @bytes+>40,a                                   ; OR $40            ; ...high byte, this time in write mode
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       .ex_af_af_                                          ; EX AF,AF'         ; recover the combined byte
       movb a,@vdpwd                                       ; OUT ($98),A       ; write it back (an XOR-plot, not an overwrite)
       ; EI                                                ; EI                ; TODO: check code. 
       sb   one,b                                          ; DEC B             ; one row done
       jeq  continue_34a8_advance_cursor                   ; JR Z,$351C        ; all 8 rows plotted - go advance the cursor
       ab   one,@e                                         ; INC E             ; VRAM address -> next row of this pattern
       movb @e,a                                           ; LD A,E            ; 
       andi a,>0700                                        ; AND $07           ; crossed an 8-byte pattern-table boundary?
       jne  _351a                                          ; JR NZ,$351A       ; no - carry on
       movb @e,a                                           ; LD A,E            ; 
       sb   one,a                                          ; DEC A             ; undo the wrap...
       andi a,>f800                                        ; AND $F8           ; ...and snap back to this boundary's start
       movb a,@e                                           ; LD E,A            ; 
       ab   one,d                                          ; INC D             ; move into the pattern table's next bank
_351a:                                                     ; >351a
       jmp  _34f1                                          ; JR $34F1          ; plot the next row
continue_34a8_advance_cursor:                              ; >351c
       .pop de                                             ; POP DE            ; recover this tile's base VRAM address
       movb @e,a                                           ; LD A,E            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; E += 8: the next cell's row-0 pattern byte
       movb a,@e                                           ; LD E,A            ; 
       sb   one,@c                                         ; DEC C             ; one tile done
       jne  _34ee                                          ; JR NZ,$34EE       ; plot the second tile (the buffer's spillover half)
       movb @cursor_subpixel_offset,a                      ; LD A,($E70E)      ; A = the cursor's sub-pixel shift
       cb   a,@bytes+>02                                   ; CP $02            ; shifted by 2 or more?
       jl   _3534                                          ; JR C,$3534        ; no - stay in the same screen column
       mov  @cursor_vram_addr,hl                           ; LD HL,($E70F)     ; yes - advance to the next screen column's pattern address
       movb @bytes+>08,@c                                  ; LD C,$08          ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       mov  hl,@cursor_vram_addr                           ; LD ($E70F),HL     ; 
_3534:                                                     ; >3534
       ab   @bytes+>06,a                                   ; ADD A,$06         ; advance the sub-pixel shift by the font's 6px width
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jl   _353c                                          ; JR C,$353C        ; still within 0-7 - done
       sb   @bytes+>08,a                                   ; SUB $08           ; wrap back into 0-7
_353c:                                                     ; >353c
       movb a,@cursor_subpixel_offset                      ; LD ($E70E),A      ; store the updated sub-pixel shift
       li   hl,cursor_column                               ; LD HL,$E72C       ; the on-screen column counter (see #R$3564)
       ab   one,*hl                                        ; INC (HL)          ; 
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Set the text cursor to column B, row C
* 
* Used by the routines at #R$3596, #R$3955, #R$5AF8, #R$5B4D, #R$5BBD, #R$5C8E,
* #R$5DBB, #R$60E3, #R$612D, #R$6164, #R$6276, #R$9120, #R$9A4B and #R$A30A.
* .
* Text is printed in 6-pixel-wide characters. Sets the cursor's address in the
* pattern table (#R$E70F) to that of the character cell containing pixel B * 6
* of row C, and its pixel within the cell (#R$E70E) to the rest; also sets the
* column (#R$E72C) and clears #R$E70D.
* 
* I:B Column
* I:C Row
set_cursor_position:                                       ; >3548
       .push hl                                            ; PUSH HL           ; 
       movb @c,h                                           ; LD H,C            ; H = the row
       movb b,a                                            ; LD A,B            ; 
       movb a,@cursor_column                               ; LD ($E72C),A      ; the column
       ab   a,a                                            ; ADD A,A           ; 
       ab   b,a                                            ; ADD A,B           ; 
       ab   a,a                                            ; ADD A,A           ; A = column * 6
       .push af                                            ; PUSH AF           ; 
       andi a,>f800                                        ; AND $F8           ; 
       movb a,@l                                           ; LD L,A            ; L = 8 * the character cell it's in
       mov  hl,@cursor_vram_addr                           ; LD ($E70F),HL     ; set the address in the pattern table
       .pop af                                             ; POP AF            ; 
       andi a,>0700                                        ; AND $07           ; 
       movb a,@cursor_subpixel_offset                      ; LD ($E70E),A      ; the pixel within the cell
       sb   a,a                                            ; XOR A             ; 
       movb a,@unused_counter_e70d                         ; LD ($E70D),A      ; 
       .pop hl                                             ; POP HL            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Set the text cursor to column A
* 
* Used by the routines at #R$35E7, #R$3619, #R$3631, #R$5AF8, #R$5B4D, #R$5CEE,
* #R$5DBB, #R$6066, #R$6164 and #R$6377.
* .
* Like #R$3548, but leaves the cursor on the same row (the high byte of
* #R$E70F).
* 
* I:A Column
set_cursor_position_combined:                              ; >3564
       .push bc                                            ; PUSH BC           ; 
       movb a,@cursor_column                               ; LD ($E72C),A      ; the column
       movb a,b                                            ; LD B,A            ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   b,a                                            ; ADD A,B           ; 
       ab   a,a                                            ; ADD A,A           ; A = column * 6
       .push af                                            ; PUSH AF           ; 
       andi a,>f800                                        ; AND $F8           ; 
       movb a,@cursor_vram_addr                            ; LD ($E70F),A      ; the character cell
       .pop af                                             ; POP AF            ; 
       andi a,>0700                                        ; AND $07           ; 
       movb a,@cursor_subpixel_offset                      ; LD ($E70E),A      ; the pixel within the cell
       .pop bc                                             ; POP BC            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* RST $08 target: print a tokenised string at HL
* [text]
* 
* Used by the routines at #R$0008, #R$1651 and #R$40DE.
* .
* Reads bytes from HL until a 0 byte ends the string. Each byte has its
* top bit (the tokenised-text terminator convention noted elsewhere -
* e.g. #R$39C8) stripped and, if the result is nonzero, is expanded via
* #R$34A8 (RST $00); the original byte's top bit being set ends the
* string after this character.
rst_08_target_print_tokenised_string:                      ; >357a
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; 0 - the end
       .ret                                                ;                   
!
       andi a,>7f00                                        ; AND $7F           ; 
       jeq  !                                              ; CALL NZ,$34A8     ; print the character (#R$34A8)
       .call @print_char                                   ;                   
!
       movb *hl,r0                                         ; BIT 7,(HL)        ; bit 7 set?
       andi r0,>8000                                       ;                   
       jeq  !                                              ; RET NZ            ; yes - that was the last character
       .ret                                                ;                   
!
       inc  hl                                             ; INC HL            ; 
       jmp  rst_08_target_print_tokenised_string           ; JR $357A          ; 

********************************************************************************
* RST $10 target: print the A'th tokenised string in a list at HL
* [text]
* 
* Used by the routine at #R$0010.
* .
* Skips A strings via #R$358D, then prints the one HL now points to via
* RST $08 (#R$357A).
rst_10_target_print_ath_tokenised:                         ; >3588
       .call @skip_tokenised_strings_advancing_hl_past     ; CALL $358D        ; 
       .rst >08                                            ; RST $08           ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Skip A tokenised strings, advancing HL past each one
* 
* Used by the routines at #R$193F, #R$3588 and #R$8BA6.
* .
* Each string ends at the first byte with its top bit set (the same
* terminator convention #R$357A prints by). Returns once A strings have
* been skipped (A=0 on entry does nothing).
skip_tokenised_strings_advancing_hl_past:                  ; >358d
       sb   one,a                                          ; DEC A             ; 
       jhe  !                                              ; RET M             ; 
       .ret                                                ;                   
!
_358f:                                                     ; >358f
       movb *hl,r0                                         ; BIT 7,(HL)        ; 
       andi r0,>8000                                       ;                   
       inc  hl                                             ; INC HL            ; 
       jeq  _358f                                          ; JR Z,$358F        ; 
       jmp  skip_tokenised_strings_advancing_hl_past       ; JR $358D          ; 

********************************************************************************
* RST $20 target: print a list of positioned tokenised strings
* [text]
* 
* Used by the routine at #R$0020.
* .
* Reads (column, row, tokenised-string) records from HL: a negative
* column byte ends the list; otherwise positions the cursor via #R$3548,
* prints the string via RST $08 (#R$357A), advances past it, and
* repeats.
rst_20_target_print_list_positioned:                       ; >3596
       movb *hl,a                                          ; LD A,(HL)         ; A = the column
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; RET M             ; bit 7 set - the end of the list
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,@c                                         ; LD C,(HL)         ; C = the row
       inc  hl                                             ; INC HL            ; 
       .call @set_cursor_position                          ; CALL $3548        ; put the cursor there (#R$3548)
       .rst >08                                            ; RST $08           ; print the string (#R$357A)
       inc  hl                                             ; INC HL            ; move past its last byte
       jmp  rst_20_target_print_list_positioned            ; JR $3596          ; next record

********************************************************************************
* Fill BC bytes of VRAM with a fixed byte
* 
* Used by the routine at #R$3955.
* .
* Writes E to the VDP data port BC times in a row. The caller must point the
* VDP at the target VRAM address (via port $99) before calling; each write
* auto-increments that address.
* 
* I:E Fill byte
* I:BC Number of bytes to write
fill_vram_bytes:                                           ; >35a4
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       dec  bc                                             ; DEC BC            ; 
       movb b,a                                            ; LD A,B            ; 
       socb @c,a                                           ; OR C              ; 
       jne  fill_vram_bytes                                ; JR NZ,$35A4       ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Fill up to 256*C bytes of VRAM with a fixed byte
* 
* Used by the routine at #R$70E8.
* .
* Writes A to the VDP data port in chunks of 256 bytes (the inner counter B
* is loaded with 0, so DJNZ wraps it to 256), repeated C times. Like
* #R$35A4, the caller must set the VRAM write address first.
* 
* I:A Fill byte
* I:C Number of 256-byte chunks to write
fill_vram_256:                                             ; >35ad
       sb   b,b                                            ; LD B,$00          ; 
_35af:                                                     ; >35af
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       nop                                                 ; NOP               ; 
       sb   one,b                                          ; DJNZ $35AF        ; 
       jne  _35af                                          ;                   
       sb   one,@c                                         ; DEC C             ; 
       jne  fill_vram_256                                  ; JR NZ,$35AD       ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Fill a rectangular block of a screen-2 table with one byte
* 
* Used by the routines at #R$36F1, #R$3955, #R$50CE, #R$60CA, #R$6ADC, #R$6B12,
* #R$6CA8 and #R$72C1.
* .
* Fills a C-character-wide, (B/8)-row-tall rectangle of whichever VDP table
* HL points into (pattern or colour) with byte A - used to blank a
* text-window or dashboard area.
* .
* For each column, writes A to all 8 pixel-rows of one character (the VRAM
* address auto-increments across them); after the 8th byte, instead of
* carrying on into the next character along the row it drops to the same
* character position one name-table row further down (+256 bytes = +32
* characters) and continues. After B bytes like this (i.e. B/8 rows), it
* moves one character to the right (HL+8) and repeats for C columns.
* 
* I:A Fill byte
* I:HL VRAM address of the top-left character's first pixel-row byte
* I:B Height in pixel-rows (a multiple of 8)
* I:C Width in characters
fill_vram_rect:                                            ; >35b8
       limi 0                                              ; DI                ; 
       movb a,@e                                           ; LD E,A            ; Keep the fill byte in E; A is about to be reused for
       movb @bytes+>07,d                                   ; LD D,$07          ; address bytes. D = row-within-character wrap mask
_35bc:                                                     ; >35bc
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; Remember this column's start address
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; Point the VDP at this column
_35c6:                                                     ; >35c6
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; Write the fill byte
       ab   one,@l                                         ; INC L             ; 
       movb @l,a                                           ; LD A,L            ; 
       ; AND D                                             ; AND D             ; TODO: check code. 
       jne  _35db                                          ; JR NZ,$35DB       ; Still inside this character's 8 pixel-rows
       movb @l,a                                           ; LD A,L            ; 
       sb   one,a                                          ; DEC A             ; 
       andi a,>f800                                        ; AND $F8           ; Back to this character's row 0...
       movb a,@l                                           ; LD L,A            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ab   one,h                                          ; INC H             ; ...but one name-table row down (+256 = 32 characters)
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
_35db:                                                     ; >35db
       sb   one,b                                          ; DJNZ $35C6        ; 
       jne  _35c6                                          ;                   
       .pop hl                                             ; POP HL            ; 
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; Next character along the row
       movb a,@l                                           ; LD L,A            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,@c                                         ; DEC C             ; 
       jne  _35bc                                          ; JR NZ,$35BC       ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Wait for a keypress, blinking the text-input cursor meanwhile [text]
* 
* Used by the routines at #R$3631, #R$3815 and #R$A30A.
* .
* Resets the blink-phase flag #R$E72E to 0 (erased) and the blink
* countdown #R$E72D to 1, then repeatedly calls #R$3619 (which steps
* the blink and HALTs for one VBlank each call) until #R$E8F5 (the
* polled action code, see #R$347A) becomes non-zero. Consumes that
* action code, and - only if the cursor glyph is currently showing
* (#R$E72E set) - erases it (another XOR-plot of $7F via RST $00,
* then #R$3564 to step the text cursor back the column that plot
* advanced it by). Always plays the click (#R$7468) before
* returning the consumed action code in A.
* 
* O:A The polled action code that ended the wait
wait_for_keypress_blinking_cursor:                         ; >35e7
       .push bc                                            ; PUSH BC           ; save registers
       .push hl                                            ; PUSH HL           ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@cursor_blink_phase_flag                     ; LD ($E72E),A      ; blink phase = erased
       ab   one,a                                          ; INC A             ; 
       movb a,@cursor_blink_countdown                      ; LD ($E72D),A      ; blink countdown = 1 (steps immediately)
_35f1:                                                     ; >35f1
       .call @step_cursor_blink                            ; CALL $3619        ; step the blink, HALT for one VBlank
       .halt                                               ; HALT              ; 
       movb @pending_debounced_keypress_byte_status,a      ; LD A,($E8F5)      ; A = the polled action code
       socb a,a                                            ; OR A              ; 
       jeq  _35f1                                          ; JR Z,$35F1        ; nothing pressed yet - keep blinking and waiting
       .push af                                            ; PUSH AF           ; stash the action code
       sb   a,a                                            ; XOR A             ; 
       movb a,@pending_debounced_keypress_byte_status      ; LD ($E8F5),A      ; consume it
       movb @cursor_blink_phase_flag,a                     ; LD A,($E72E)      ; A = the blink-phase flag
       socb a,a                                            ; OR A              ; 
       jeq  _3610                                          ; JR Z,$3610        ; cursor not currently shown - nothing to erase
       movb @bytes+>7f,a                                   ; LD A,$7F          ; the cursor glyph
* @label=*
_3608:                                                     ; >3608
       .rst >00                                            ; RST $00           ; XOR-plot it (erasing it, since it was showing)
       movb @cursor_column,a                               ; LD A,($E72C)      ; step the text cursor back the column that plot advanced
       sb   one,a                                          ; DEC A             ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; 
_3610:                                                     ; >3610
       sb   a,a                                            ; LD A,$00          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 0 (click)
       .pop af                                             ; POP AF            ; recover the action code
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Step #R$35E7's cursor-blink countdown and toggle the cursor glyph
* 
* Used by the routine at #R$35E7.
* .
* Decrements the countdown at #R$E72D, returning if it hasn't reached
* zero. Otherwise resets it to 30 ($1E), XOR-plots the cursor glyph
* $7F via RST $00 (toggling it on screen), steps the text cursor back
* the column that plot advanced it by (#R$3564), and complements the
* blink-phase flag #R$E72E to track which state ("on" or "erased")
* the glyph is now in.
step_cursor_blink:                                         ; >3619
       li   hl,cursor_blink_countdown                      ; LD HL,$E72D       ; HL -> the blink countdown
       sb   one,*hl                                        ; DEC (HL)          ; 
       jeq  !                                              ; RET NZ            ; not yet due - done
       .ret                                                ;                   
!
       movb @bytes+>1e,*hl                                 ; LD (HL),$1E       ; due - reset the countdown (30 ticks)
       movb @bytes+>7f,a                                   ; LD A,$7F          ; the cursor glyph
       .rst >00                                            ; RST $00           ; XOR-plot it (toggles it on screen)
       movb @cursor_column,a                               ; LD A,($E72C)      ; step the text cursor back the column that plot advanced
       sb   one,a                                          ; DEC A             ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; 
       li   hl,cursor_blink_phase_flag                     ; LD HL,$E72E       ; toggle the blink-phase flag
       movb *hl,a                                          ; LD A,(HL)         ; 
       inv  a                                              ; CPL               ; 
       movb a,*hl                                          ; LD (HL),A         ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Read a line of keyboard input into $E8F7
* 
* Used by the routines at #R$55A3, #R$5AC7, #R$5EFE and #R$A36B.
* .
* Reads keys (#R$35E7) into the buffer at $E8F7, printing them, until Enter
* or ESC is pressed, and clears the message line (#R$3955). Enter
* terminates the buffer with 0 and returns with carry set; ESC (at $3643)
* returns with carry clear. Backspace ($7F) rubs out the last character, if
* there is one. Any other character (at $3662) is only accepted if it's in
* the range D-E and the buffer holds fewer than C characters.
* 
* I:C Maximum number of characters
* I:D Lowest character code accepted
* I:E Highest character code accepted
* O:F Carry set if Enter was pressed, clear for ESC
read_line_keyboard_input:                                  ; >3631
       li   hl,keyboard_input_buffer                       ; LD HL,$E8F7       ; HL -> the input buffer
       sb   b,b                                            ; LD B,$00          ; B = characters read so far
_3636:                                                     ; >3636
       .call @wait_for_keypress_blinking_cursor            ; CALL $35E7        ; A = the next key (blocks until one is available)
       cb   a,@bytes+>0d                                   ; CP $0D            ; Enter?
       jne  continue_3631_esc_or_backspace                 ; JR NZ,$3643       ; no
       sb   *hl,*hl                                        ; LD (HL),$00       ; yes - null-terminate the buffer
       ; SCF                                               ; SCF               ; TODO: check code. carry set = Enter
       b    @clear_message_line                            ; JP $3955          ; clear the message line
continue_3631_esc_or_backspace:                            ; >3643
       cb   a,@bytes+>1b                                   ; CP $1B            ; ESC?
       jne  !                                              ; JP Z,$3955        ; clear the message line
       b    @clear_message_line                            ;                   
!
       cb   a,@bytes+>7f                                   ; CP $7F            ; backspace?
       jne  continue_3643_accept_reject_character          ; JR NZ,$3662       ; no - an ordinary character
       ab   one,b                                          ; INC B             ; test B for zero without destroying it...
       sb   one,b                                          ; DEC B             ; 
       jeq  _3660                                          ; JR Z,$3660        ; ...buffer already empty - nothing to delete
       movb @cursor_column,a                               ; LD A,($E72C)      ; step the cursor back one column...
       sb   one,a                                          ; DEC A             ; 
       .push af                                            ; PUSH AF           ; ...stashing that column for the re-set below
       .call @set_cursor_position_combined                 ; CALL $3564        ; 
       dec  hl                                             ; DEC HL            ; buffer -> the character being deleted
       movb *hl,a                                          ; LD A,(HL)         ; 
       .rst >00                                            ; RST $00           ; XOR-plot it away (it was already shown, so this erases it)
       .pop af                                             ; POP AF            ; force the cursor position back to that column...
       .call @set_cursor_position_combined                 ; CALL $3564        ; ...undoing the advance RST $00's plot just caused
       sb   one,b                                          ; DEC B             ; one fewer character in the buffer
_3660:                                                     ; >3660
       jmp  _3673                                          ; JR $3673          ; 
continue_3643_accept_reject_character:                     ; >3662
       movb a,*hl                                          ; LD (HL),A         ; provisionally store the character
       cb   a,d                                            ; CP D              ; below the lowest acceptable code?
       jl   _3673                                          ; JR C,$3673        ; yes - reject
       cb   a,@e                                           ; CP E              ; exactly the highest acceptable code?
       jeq  _366b                                          ; JR Z,$366B        ; yes - accept
       jnc  _3673                                          ; JR NC,$3673       ; TODO: check code. above it - reject
_366b:                                                     ; >366b
       movb @c,a                                           ; LD A,C            ; A = the maximum character count
       cb   a,b                                            ; CP B              ; buffer already full?
       jeq  _3673                                          ; JR Z,$3673        ; yes - reject
       movb *hl,a                                          ; LD A,(HL)         ; accepted - plot the character
       .rst >00                                            ; RST $00           ; 
       inc  hl                                             ; INC HL            ; buffer -> the next slot
       ab   one,b                                          ; INC B             ; one more character
_3673:                                                     ; >3673
       jmp  _3636                                          ; JR $3636          ; next key

********************************************************************************
* Format a number
* 
* Used by the routines at #R$1651, #R$1A8A, #R$2556 and #R$36E1.
* .
* Writes the digits of the 24-bit number H:L:C at IX, with bit 7 of the
* last one set, as tokenised text. Divides by 10 (#R$20C6) until it's 0,
* pushing each digit. If bit 7 of the control byte (kept in $E738) is set,
* pads the number to the width in bits 0-5 with #R$EF96 (normally a space).
* If bit 6 is set, the number is in tenths: it gets at least two digits,
* and (at $36C1) a decimal point before the last one. At $36B8 and $36D7,
* writes a digit.
* 
* I:A Control byte: bit 7 pads to the width in bits 0-5, bit 6 adds a
* .   decimal point
* I:H:L:C The number (C the low byte)
* I:IX Where to write it
* O:IX One past the last byte written
format_number:                                             ; >3675
       movb a,@format_control                              ; LD ($E738),A      ; cache the control byte
       sb   @e,@e                                          ; LD E,$00          ; E = digit count so far
       movb @b255,a                                        ; LD A,$FF          ; push the bottom-of-stack sentinel
       .push af                                            ; PUSH AF           ; 
_367d:                                                     ; >367d
       .call @divide_c_l_h_by_10                           ; CALL $20C6        ; A = the next digit, H:L:C = the reduced quotient
       .push af                                            ; PUSH AF           ; push this digit
       ab   one,@e                                         ; INC E             ; one more digit
       movb @c,a                                           ; LD A,C            ; 
       socb h,a                                            ; OR H              ; 
       socb @l,a                                           ; OR L              ; 
       jne  _367d                                          ; JR NZ,$367D       ; quotient not yet zero - extract another digit
       movb @format_control,a                              ; LD A,($E738)      ; A = the control byte again
       movb a,d                                            ; LD D,A            ; D = the control byte, for the bit-6 tests below
       czc  @bit6,a                                        ; BIT 6,A           ; 
       jeq  _3696                                          ; JR Z,$3696        ; clear - skip the two-digit-minimum check
       movb @e,b                                           ; LD B,E            ; was exactly one digit produced?
       ab   one,@e                                         ; INC E             ; 
       sb   one,b                                          ; DEC B             ; 
       jne  _3696                                          ; JR NZ,$3696       ; no - move on
       .push bc                                            ; PUSH BC           ; yes - push an extra placeholder digit (0)
       ab   one,@e                                         ; INC E             ; 
_3696:                                                     ; >3696
       socb a,a                                            ; OR A              ; test the control byte's sign (still in A)
       jlt  !                                              ; JP P,$36AA        ; bit 7 clear - no minimum-width padding
       b    @format_number_digits                          ;                   
!
       andi a,>3f00                                        ; AND $3F           ; A = the minimum field width
       sb   @e,a                                           ; SUB E             ; minus the digits actually produced
       jeq  format_number_digits                           ; JR Z,$36AA        ; exactly enough already - no padding needed
       movb a,b                                            ; LD B,A            ; B = the padding count
       movb @number_fill_char,a                            ; LD A,($EF96)      ; A = the fill character
_36a3:                                                     ; >36a3
       movb a,*ix                                          ; LD (IX+$00),A     ; write B fill bytes
       inc  ix                                             ; INC IX            ; 
       sb   one,b                                          ; DJNZ $36A3        ; 
       jne  _36a3                                          ;                   
format_number_digits:                                      ; >36aa
       czc  @bit6,d                                        ; BIT 6,D           ; the decimal-point/two-digit-minimum flag again
       jne  continue_3675_write_digit_decimal_point        ; JR NZ,$36C1       ; set - with a decimal point
_36ae:                                                     ; >36ae
       .pop af                                             ; POP AF            ; pop the next digit (most significant first)
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$36B8        ; a real digit - write it as ASCII
       b    @continue_3675_write_digit                     ;                   
!
       socb @bit7,@>ffffffff(ix)                           ; SET 7,(IX-$01)    ; the sentinel - flag the last byte written instead
       .ret                                                ; RET               ; 
continue_3675_write_digit:                                 ; >36b8
       ab   @bytes+>30,a                                   ; ADD A,$30         ; digit -> ASCII
       movb a,*ix                                          ; LD (IX+$00),A     ; write it
       inc  ix                                             ; INC IX            ; 
       jmp  _36ae                                          ; JR $36AE          ; next digit
continue_3675_write_digit_decimal_point:                   ; >36c1
       sb   one,@e                                         ; DEC E             ; account for the terminal $FF popped, but not written, as a "digit"
_36c2:                                                     ; >36c2
       movb @e,a                                           ; LD A,E            ; exactly one digit left to write?
       sb   one,a                                          ; DEC A             ; 
       jne  _36cd                                          ; JR NZ,$36CD       ; no - write the next digit as usual
       movb @bytes+>2e,a                                   ; LD A,$2E          ; yes - insert '.' first
       movb a,*ix                                          ; LD (IX+$00),A     ; 
       inc  ix                                             ; INC IX            ; 
_36cd:                                                     ; >36cd
       .pop af                                             ; POP AF            ; pop the next digit
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$36D7        ; a real digit - write it as ASCII
       b    @continue_36c1_write_digit                     ;                   
!
       socb @bit7,@>ffffffff(ix)                           ; SET 7,(IX-$01)    ; the sentinel - flag the last byte written instead
       .ret                                                ; RET               ; 
continue_36c1_write_digit:                                 ; >36d7
       ab   @bytes+>30,a                                   ; ADD A,$30         ; digit -> ASCII
       movb a,*ix                                          ; LD (IX+$00),A     ; write it
       inc  ix                                             ; INC IX            ; 
       sb   one,@e                                         ; DEC E             ; one fewer digit remaining
       jmp  _36c2                                          ; JR $36C2          ; check for the decimal point again

********************************************************************************
* RST $18 target: format a value into $E717 and print it [text]
* 
* Used by the routine at #R$0018.
* .
* Runs #R$3675's format-into-$E717 loop, then prints the result via
* RST $08 (#R$357A).
rst_18_target_format_value_print:                          ; >36e1
       .push ix                                            ; PUSH IX           ; 
       li   ix,text_buffer                                 ; LD IX,$E717       ; 
       .call @format_number                                ; CALL $3675        ; 
       .pop ix                                             ; POP IX            ; 
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       .rst >08                                            ; RST $08           ; 
       .ret                                                ; RET               ; 

********************************************************************************
* RST $28 target: colour a list of rectangles
* 
* Used by the routines at #R$0028 and #R$90D3.
* .
* Reads 5-byte records from IX until one starts with a byte with bit 7 set
* (usually $FF): the column, row, width and height of a rectangle (in text
* columns, 6 pixels wide, and character rows), and a colour byte. Fills
* the colour table for the rectangle with the colour (#R$35B8), from the
* character cell containing its left edge (column * 6 pixels) to the one
* containing the pixel just after its right edge ((column + width) * 6) -
* so it can reach one cell further right than the rectangle. Used for the
* frames and colour bars of the screens (e.g. #R$58BD).
* 
* I:IX The list of rectangles
rst_28_target_draw_list_tile:                              ; >36f1
       movb *ix,a                                          ; LD A,(IX+$00)     ; A = column
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; RET M             ; end of the list
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   b,a                                            ; ADD A,B           ; 
       ab   a,a                                            ; ADD A,A           ; A = column * 6 (the left edge in pixels)
       andi a,>f800                                        ; AND $F8           ; 
       movb a,@l                                           ; LD L,A            ; L = 8 * the character cell it's in
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; 
       ab   @bytes+>20,a                                   ; ADD A,$20         ; 
       movb a,h                                            ; LD H,A            ; HL = the colour table address for that cell ($2000 + 256 * row)
       movb b,a                                            ; LD A,B            ; 
       ab   @>02(ix),a                                     ; ADD A,(IX+$02)    ; 
       movb a,b                                            ; LD B,A            ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   b,a                                            ; ADD A,B           ; 
       ab   a,a                                            ; ADD A,A           ; A = (column + width) * 6 (the right edge in pixels)
       andi a,>f800                                        ; AND $F8           ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; 
       sb   @l,a                                           ; SUB L             ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; 
       movb a,@c                                           ; LD C,A            ; C = the number of character cells across
       movb @>03(ix),a                                     ; LD A,(IX+$03)     ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       movb a,b                                            ; LD B,A            ; B = height * 8 (pixel rows)
       movb @>04(ix),a                                     ; LD A,(IX+$04)     ; A = the colour
       .call @fill_vram_rect                               ; CALL $35B8        ; fill the rectangle
       ; EI                                                ; EI                ; TODO: check code. (#R$35B8 disabled interrupts)
       li   bc,>0005                                       ; LD BC,$0005       ; 
       a    bc,ix                                          ; ADD IX,BC         ; IX -> the next rectangle
       jmp  rst_28_target_draw_list_tile                   ; JR $36F1          ; 

********************************************************************************
* Draw a Bresenham line from (B,C) to (D,E), pixel-precise [line-draw]
* 
* Used by the routines at #R$37E2, #R$523A, #R$541E and #R$5584.
* .
* A second, independent Bresenham line-drawer alongside the #R$3C48 family,
* plotting via #R$3793 - which self-modifies the displacement of its own
* `OR (IX+d)` instruction to `C AND 7` before each use, so IX (fixed at
* $E700, the bit-position table $80..$01) still selects the correct single
* pixel bit within the target byte despite never being re-pointed. Caches
* the original (D,E) endpoint to #R$E730 (for #R$37E2's fan-drawing use),
* then swaps the two endpoints if needed so the row always decreases from B
* down to D, works out the column step direction and the row/column deltas,
* plots the first point, and picks $3773's steep-line loop if the row delta
* exceeds the column delta, or its own shallow-line loop (row-major vs.
* column-major Bresenham stepping) otherwise.
* .
* At $3773, the loop for a steep line, stepping the row every time and the
* column only sometimes.
draw_bresenham_line_372b:                                  ; >372b
       li   ix,pixel_bitmask_table                         ; LD IX,$E700       ; IX -> the bit-position table ($80,$40,...,$01)
       mov  de,@bresenham_cached_endpoint                  ; LD ($E730),DE     ; cache the original second endpoint
       movb d,a                                            ; LD A,D            ; 
       cb   a,b                                            ; CP B              ; first endpoint's row < second's?
       jl   _373c                                          ; JR C,$373C        ; yes - no swap needed
       movb b,d                                            ; LD D,B            ; no - swap rows...
       movb a,b                                            ; LD B,A            ; 
       movb @e,a                                           ; LD A,E            ; 
       movb @c,@e                                          ; LD E,C            ; ...and columns, so (D,E) becomes the smaller-row endpoint
       movb a,@c                                           ; LD C,A            ; 
_373c:                                                     ; >373c
       movb @e,a                                           ; LD A,E            ; 
       sb   @c,a                                           ; SUB C             ; dx = E - C (signed column delta, post-swap)
       movb one,@l                                         ; LD L,$01          ; L = +1 (default column step)
       jnc  _3746                                          ; JR NC,$3746       ; TODO: check code. dx >= 0 - keep that step
       neg a                                               ; NEG               ; dx < 0 - take the magnitude...
       movb @b255,@l                                       ; LD L,$FF          ; ...and step -1 instead
_3746:                                                     ; >3746
       movb a,@e                                           ; LD E,A            ; E = |dx|
       movb b,a                                            ; LD A,B            ; 
       sb   d,a                                            ; SUB D             ; dy = B - D (always >= 0, since D <= B after the swap)
       movb a,d                                            ; LD D,A            ; D = dy
       .push hl                                            ; PUSH HL           ; 
       .call @plot_line_pixel                              ; CALL $3793        ; plot the first point (B,C)
       .pop hl                                             ; POP HL            ; 
       movb @e,a                                           ; LD A,E            ; 
       cb   a,d                                            ; CP D              ; dx < dy (steeper than 45 degrees)?
       jl   draw_bresenham_line_372b_steep                 ; JR C,$3773        ; yes - a steep line
       movb @e,h                                           ; LD H,E            ; no - shallow (column-major): H = dx/2, the error accumulator
       srl  h,1                                            ; SRL H             ; 
       movb @e,a                                           ; LD A,E            ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; dx == 0 - a single point, already plotted above
       .ret                                                ;                   
!
       movb a,@line_points_left                            ; LD ($E734),A      ; E734 = dx, the remaining-points loop counter
_375c:                                                     ; >375c
       movb @c,a                                           ; LD A,C            ; 
       ab   @l,a                                           ; ADD A,L           ; column += step (the major axis)
       movb a,@c                                           ; LD C,A            ; 
       movb h,a                                            ; LD A,H            ; 
       sb   d,a                                            ; SUB D             ; error -= dy
       jnc  _3765                                          ; JR NC,$3765       ; TODO: check code. still >= 0 - no row step this time
       sb   one,b                                          ; DEC B             ; underflowed - row -= 1 (towards D)
       ab   @e,a                                           ; ADD A,E           ; and restore the error by += dx
_3765:                                                     ; >3765
       movb a,h                                            ; LD H,A            ; store the updated error
       .push hl                                            ; PUSH HL           ; 
       .call @plot_line_pixel                              ; CALL $3793        ; plot (B,C)
       li   hl,line_points_left                            ; LD HL,$E734       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer point to plot
       .pop hl                                             ; POP HL            ; 
       jne  _375c                                          ; JR NZ,$375C       ; more to go - next point
       jmp  _3792                                          ; JR $3792          ; done
draw_bresenham_line_372b_steep:                            ; >3773
       movb d,h                                            ; LD H,D            ; H = dy/2, the error accumulator
       srl  h,1                                            ; SRL H             ; 
       movb d,a                                            ; LD A,D            ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; dy = 0 - a single point, already plotted
       .ret                                                ;                   
!
       movb a,@line_points_left                            ; LD ($E734),A      ; E734 = dy, the remaining-points loop counter
_377c:                                                     ; >377c
       sb   one,b                                          ; DEC B             ; row -= 1 (the major axis - always decreasing, per the swap)
       movb h,a                                            ; LD A,H            ; 
       sb   @e,a                                           ; SUB E             ; error -= dx
       movb a,h                                            ; LD H,A            ; 
       jnc  _3787                                          ; JR NC,$3787       ; TODO: check code. still >= 0 - no column step this time
       ab   d,a                                            ; ADD A,D           ; underflowed - restore the error by += dy...
       movb a,h                                            ; LD H,A            ; 
       movb @c,a                                           ; LD A,C            ; 
       ab   @l,a                                           ; ADD A,L           ; ...and step the column
       movb a,@c                                           ; LD C,A            ; 
_3787:                                                     ; >3787
       .push hl                                            ; PUSH HL           ; 
       .call @plot_line_pixel                              ; CALL $3793        ; plot (B,C)
       li   hl,line_points_left                            ; LD HL,$E734       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer point to plot
       .pop hl                                             ; POP HL            ; 
       jne  _377c                                          ; JR NZ,$377C       ; more to go - next point
_3792:                                                     ; >3792
       .ret                                                ; RET               ; 

********************************************************************************
* Plot a pixel of a line
* 
* Used by the routines at #R$372B and #R$4D0B.
* .
* Sets pixel (x, y) in the pattern table in VRAM, ORing in its bit from
* the table at $E700 (by patching the displacement of an (IX+d)
* instruction). While #R$E90F is set, only plots in character cells
* coloured $F1 (white on black).
* 
* I:B y
* I:C x
plot_line_pixel:                                           ; >3793
       .call @pixel_address                                ; CALL $37D1        ; HL = the pixel's address
       movb @e90f_equip_op_flag,a                          ; LD A,($E90F)      ; only in white on black cells?
       socb a,a                                            ; OR A              ; 
       jeq  _37ad                                          ; JR Z,$37AD        ; no
       movb @l,a                                           ; LD A,L            ; 
       limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb h,a                                            ; LD A,H            ; 
       ab   @bytes+>20,a                                   ; ADD A,$20         ; its colour (at +$2000)
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       .push hl                                            ; PUSH HL           ; (timing delay - let the VDP latch the address)
       .pop hl                                             ; POP HL            ; 
       movb @vdprd,a                                       ; IN A,($98)        ; A = the current byte there
       ; EI                                                ; EI                ; TODO: check code. 
       cb   a,@bytes+>f1                                   ; CP $F1            ; white on black?
       jeq  !                                              ; RET NZ            ; no - don't plot
       .ret                                                ;                   
!
_37ad:                                                     ; >37ad
       movb @c,a                                           ; LD A,C            ; 
       andi a,>0700                                        ; AND $07           ; the column's bit position within its byte (0-7)
       movb a,@plot_pixel_op+>0002                         ; LD ($37C1),A      ; point the OR at the column's mask (#R$37BF+2)
       limi 0                                              ; DI                ; 
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb h,a                                            ; LD A,H            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, read mode
       .push hl                                            ; PUSH HL           ; (timing delay)
       .pop hl                                             ; POP HL            ; 
       movb @vdprd,a                                       ; IN A,($98)        ; A = the current byte there
       ; EI                                                ; EI                ; TODO: check code. 
plot_pixel_op:                                             ; >37bf
       socb *ix,a                                          ; OR (IX+$00)       ; combine in the pixel bit (the displacement just self-modified above)
       .push af                                            ; PUSH AF           ; 
       limi 0                                              ; DI                ; 
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; re-issue the address, low byte
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; ...high byte, this time in write mode
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       .pop af                                             ; POP AF            ; recover the combined byte
       movb a,@vdpwd                                       ; OUT ($98),A       ; write it back
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Get the address of a pixel in the pattern table
* 
* Used by the routines at #R$3793, #R$50CE, #R$512F and #R$8205.
* .
* For screen 2: (y / 8) * 256 + (x AND $F8) + (y AND 7).
* 
* I:B y
* I:C x
* O:HL Address
pixel_address:                                             ; >37d1
       movb b,a                                            ; LD A,B            ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; 
       movb a,h                                            ; LD H,A            ; H = y / 8
       movb @c,a                                           ; LD A,C            ; 
       andi a,>f800                                        ; AND $F8           ; 
       movb a,@l                                           ; LD L,A            ; L = x AND $F8
       movb b,a                                            ; LD A,B            ; 
       andi a,>0700                                        ; AND $07           ; 
       ab   @l,a                                           ; ADD A,L           ; 
       movb a,@l                                           ; LD L,A            ; L = L + (y AND 7)
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a line on from the last point
* 
* Used by the routine at #R$37E9.
* .
* Draws a line from the end of the last line (#R$E730, cached by
* #R$372B) to (D, E).
* 
* I:D y
* I:E x
draw_line_on:                                              ; >37e2
       mov  @bresenham_cached_endpoint,bc                  ; LD BC,($E730)     ; BC = the endpoint #R$372B cached last time
       b    @draw_bresenham_line_372b                      ; JP $372B          ; draw a line from there to (D,E)

********************************************************************************
* Draw lines
* 
* Used by the routine at #R$70E8.
* .
* Draws the lines in the list at HL: each group is a starting point (y, x)
* and the points (y, x) to draw lines to in turn (#R$37E2, #R$372B), ending
* with $FF; the list ends with another $FF.
* .
* At $3805, the next group.
* 
* I:HL The list
draw_lines:                                                ; >37e9
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@b255                                        ; CP $FF            ; 
       jne  !                                              ; RET Z             ; end of the list
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       mov  bc,@bresenham_cached_endpoint                  ; LD ($E730),BC     ; the starting point
_37f5:                                                     ; >37f5
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@b255                                        ; CP $FF            ; 
       jeq  draw_lines_2                                   ; JR Z,$3805        ; end of the group
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,@e                                         ; LD E,(HL)         ; DE = the next point
       inc  hl                                             ; INC HL            ; 
       .push hl                                            ; PUSH HL           ; 
       .call @draw_line_on                                 ; CALL $37E2        ; draw a line to it
       .pop hl                                             ; POP HL            ; 
       jmp  _37f5                                          ; JR $37F5          ; 
draw_lines_2:                                              ; >3805
       inc  hl                                             ; INC HL            ; HL -> past the $FF terminator
       jmp  draw_lines                                     ; JR $37E9          ; process whatever list (if any) follows

********************************************************************************
* Busy-wait delay loop (~3*65536 iterations)
* 
* Used by the routine at #R$5FFB.
busy_wait_delay:                                           ; >3808
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 outer passes
_380a:                                                     ; >380a
       li   hl,>0000                                       ; LD HL,$0000       ; 
_380d:                                                     ; >380d
       dec  hl                                             ; DEC HL            ; count HL down from 0 (i.e. 65536 iterations)...
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; 
       jne  _380d                                          ; JR NZ,$380D       ; 
       sb   one,b                                          ; DJNZ $380A        ; ...3 times over
       jne  _380a                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Y/N confirmation prompt: print " ? ", wait for Esc/Y/N
* 
* Used by the routines at #R$5CEE, #R$909F, #R$9120 and #R$A41B.
* .
* Prints " ? " (#R$382C), then loops on #R$35E7 until the key pressed is
* Esc, 'Y' or 'N'. Esc returns with carry as #R$35E7 leaves it; 'Y' or 'N'
* (at $3829) is printed, and returns with carry set.
* 
* O:A The key pressed ($1B/'Y'/'N')
* O:carry Set for 'Y'/'N', per #R$35E7 for Esc
confirm_prompt_yn:                                         ; >3815
       li   hl,msg_382c                                    ; LD HL,$382C       ; the " ? " message
       .rst >08                                            ; RST $08           ; print it
_3819:                                                     ; >3819
       .call @wait_for_keypress_blinking_cursor            ; CALL $35E7        ; A = the next key (blocks until one is available)
       cb   a,@bytes+>1b                                   ; CP $1B            ; Esc?
       jne  !                                              ; RET Z             ; yes - return as-is
       .ret                                                ;                   
!
       cb   a,@bytes+>59                                   ; CP $59            ; 'Y'?
       jeq  continue_3815_echo_confirm                     ; JR Z,$3829        ; yes - confirm
       cb   a,@bytes+>4e                                   ; CP $4E            ; 'N'?
       jeq  continue_3815_echo_confirm                     ; JR Z,$3829        ; yes - confirm
       jmp  _3819                                          ; JR $3819          ; neither - keep waiting
continue_3815_echo_confirm:                                ; >3829
       .rst >00                                            ; RST $00           ; echo the key just pressed (still in A)
       ; SCF                                               ; SCF               ; TODO: check code. carry set = confirmed (Y or N, not Esc)
       .ret                                                ; RET               ; 

********************************************************************************
* The message " ? "
* 
* Printed via RST $08 (#R$3815, at $3818). No character here has bit 7
* set, so it ends at the $00.
msg_382c:                                                  ; >382c
       text ' ? ',>00

********************************************************************************
* Write B bytes from (HL) to the VDP data port
* 
* Used by the routines at #R$4D8A, #R$6ADC and #R$6B12.
* .
* The caller must point the VDP at the target VRAM address (via port $99)
* first; each write auto-increments it. Unlike #R$35A4 this reads its
* fill data from memory rather than writing one fixed byte repeatedly.
* 
* I:HL Source address
* I:B Number of bytes to write
copy_to_vram:                                              ; >3830
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       sb   one,b                                          ; DJNZ $3830        ; 
       jne  copy_to_vram                                   ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Write BC bytes from (HL) to the VDP data port
* 
* Like #R$3830, but writes BC bytes instead of B. Nothing calls it.
write_bc_bytes_hl_vdp_data:                                ; >3837
       sb   one,b                                          ; DEC B             ; 
       ab   one,b                                          ; INC B             ; 
       jeq  _383c                                          ; JR Z,$383C        ; C is the number of 256-byte runs...
       ab   one,@c                                         ; INC C             ; ...plus one if B isn't 0
_383c:                                                     ; >383c
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; write a byte
       sb   one,b                                          ; DJNZ $383C        ; 
       jne  _383c                                          ;                   
       sb   one,@c                                         ; DEC C             ; 
       jne  _383c                                          ; JR NZ,$383C       ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Copy the space view to the screen
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C, #R$1E5A, #R$40DE, #R$6CB2
* and #R$894D.
* .
* Counts the message timer down, drawing any message into the space view
* first (#R$39F1). Then copies the space view's bitmap buffer (#R$D600) to
* the pattern table: character rows 1-16, columns 5-26 (176x128 pixels).
* Each character's 8 bytes are the same byte of 8 consecutive 32-byte rows
* of the buffer. Sets #R$EF9E while it's writing to VRAM.
copy_space_view:                                           ; >3846
       .call @count_message_timer                          ; CALL $39F1        ; count the message timer down
       li   de,>4120                                       ; LD DE,$4120       ; D = $41: VRAM $0128 for writing; E = 32
       movb @bytes+>d6,h                                   ; LD H,$D6          ; H = the buffer's first page
       movb @bytes+>98,@c                                  ; LD C,$98          ; C = the VDP data port
       movb @bytes+>10,a                                   ; LD A,$10          ; 16 character rows
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; writing to VRAM
_3855:                                                     ; >3855
       .ex_af_af_                                          ; EX AF,AF'         ; 
       limi 0                                              ; DI                ; 
       movb @bytes+>28,a                                   ; LD A,$28          ; VRAM address low byte: column 5
