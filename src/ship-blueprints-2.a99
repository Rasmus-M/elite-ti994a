* Cougar: ship-blueprint header
*
* #TABLE
* { =h Offset | =h Field }
* { $00-$01 | #R$A837 - vertex array pointer (word) }
* { $02-$03 | #R$A8A9 - edge array pointer (word) }
* { $04-$05 | #R$A8DD - faces pointer (word; see #R$F7F9) }
* { $06-$07 | #R$A831 - name text pointer (word; named ships only) }
* { $08 | Number of faces (#R$F7FD) }
* { $09 | Number of edges (#R$F7FE) }
* { $0A | Number of vertices (#R$F7FF) }
* { $0B | Targetable area (#R$F800): how close to the crosshairs it has to be to be hit by the laser (#R$46CA, #R$4735) }
* { $0C | Energy (#R$F801): the energy (#R$F7E9) it starts with (#R$3037) }
* { $0D | Maximum speed (#R$F802): the speed #R$2869 speeds up to, and the initial speed (#R$F7E6) at spawn unless the caller sets it to 0 }
* { $0E | Gun vertex (#R$F803): the vertex its laser beam is drawn from (#R$43C2) }
* { $0F | Faces have normals (#R$F804) }
* { $10 | Size (#R$F805): the distance at which a missile hits it (#R$25FF), and how close it comes on the title screen (#R$1C5C) }
* { $11 | Manoeuvrability (#R$F806): its turn rate, and how close it gets to the player before turning away (#R$2744, #R$281E) }
* { $12 | Bits 2-4: class (#R$F807): 0 trader, 4 pirate, 8 shuttle/escape capsule, $0C asteroid, $10 police, $14 bounty hunter, $18 station/missile/cargo, $1C Thargoid/Constrictor (see #R$31AD, #R$26A9) }
* { $13 | Bit 7: fitted with ECM (#R$25B9); bits 0-6 the number of missiles (#R$F7EA) }
* { $14 | Cargo (#R$F809): the low nibble the most cargo canisters it leaves, the high nibble their cargo type; $FF one canister holding the cloaking device (#R$8DB9) }
* { $15 | Aggression (#R$F80A): the chance of firing each frame (#R$26A9) }
* { $16-$17 | Bounty (#R$F80B), paid when it's destroyed (#R$2578) }
* { $18-$19 | Score value (#R$F80D), added to the score when it's destroyed (#R$32E7) }
* TABLE#
* .
* The 26-byte header of a blueprint (see #R$A7D7). The vertices (#R$A837)
* are 6 bytes each, and the edges (#R$A8A9) 2 bytes each: the numbers of
* the two vertices at its ends. The blueprints' vertices, edges, faces
* and names fill $A817-$CA61 with no gaps.
ship_cougar_header:                                        ; >a817
       data ship_cougar_vertices
       data ship_cougar_edges
       data ship_cougar_faces
       data ship_cougar_name
       byte >07,>1A,>13,>31,>FF,>28,>00,>01
       byte >43,>24,>26,>87,>FF,>96,>88,>13
       byte >E8,>03

* Cougar name text
*
* The Cougar's name, which its blueprint header points to (#R$A817), ending
* with a bit-7-set "r" like the other messages (see #R$4223).
ship_cougar_name:                                          ; >a831
       text 'Couga',>f2

* Cougar: vertex array (6 bytes/vertex)
*
* 19 vertices, each an x, y and z (words), which #R$49FD rotates into
* the view (#R$4464).
ship_cougar_vertices:                                      ; >a837
       byte >FF,>FF,>4A,>09,>44,>18,>4A,>51
       byte >FF,>FF,>4A,>15,>4A,>55,>FF,>FF
       byte >4A,>55,>FF,>FF,>3B,>0F,>4A,>55
       byte >FF,>FF,>3B,>4F,>4A,>55,>4A,>11
       byte >FF,>FF,>4A,>15,>4A,>15,>FF,>FF
       byte >4A,>55,>AE,>54,>FF,>FF,>3B,>17
       byte >A1,>57,>FF,>FF,>4A,>51,>AE,>14
       byte >FF,>FF,>3B,>17,>A1,>17,>FF,>FF
       byte >4A,>51,>FF,>FF,>3B,>0B,>84,>14
       byte >FF,>FF,>00,>0C,>93,>12,>57,>4E
       byte >00,>04,>F8,>15,>57,>0E,>00,>04
       byte >F8,>15,>4A,>4D,>57,>0A,>4A,>55
       byte >4A,>4D,>57,>4A,>4A,>55,>4A,>0D
       byte >57,>4A,>4A,>55,>4A,>0D,>57,>0A
       byte >4A,>55

* Cougar: edge array (2 bytes/edge)
*
* 26 edges, each the numbers of the two vertices at its ends. The last
* one ($FB,$01) is an invisible edge: bit 7 of its first byte is set, so
* #R$491A never draws it (and doesn't read its second byte). It is listed in
* faces 5 and 6 (#R$A8DD), closing them.
ship_cougar_edges:                                         ; >a8a9
       byte >00,>01,>01,>07,>07,>08,>08,>02
       byte >02,>03,>03,>06,>02,>04,>04,>06
       byte >06,>0A,>0A,>09,>09,>05,>05,>00
       byte >00,>03,>01,>04,>05,>04,>01,>02
       byte >05,>06,>0C,>0D,>0D,>0B,>0B,>0E
       byte >0E,>0C,>0F,>10,>10,>12,>12,>11
       byte >11,>0F,>FB,>01

* Cougar: faces (7 faces)
*
* Each face is a scale byte and a normal vector (three words), used to
* hide the faces that face away (#R$4255, #R$4873), then a count and the
* numbers of the face's edges (#R$491A). A blueprint without normals
* (#R$F804) has just the edge lists (see #R$B3CC).
* .
* The title letters (#R$C91A) and the Platlet (#R$B3CC) have no normals.
ship_cougar_faces:                                         ; >a8dd
       byte >0A,>4D,>59,>A4,>1F,>F6,>12,>09
       byte >00,>0F,>04,>0C,>01,>02,>03,>11
       byte >12,>0A,>4D,>19,>A4,>1F,>F6,>12
       byte >09,>0B,>0C,>05,>10,>08,>09,>0A
       byte >14,>13,>28,>FF,>FF,>FF,>FF,>FA
       byte >5F,>08,>05,>04,>06,>07,>15,>16
       byte >17,>18,>0A,>4D,>59,>A4,>5F,>F6
       byte >12,>06,>0D,>0F,>06,>01,>02,>03
       byte >0A,>4D,>19,>A4,>5F,>F6,>12,>06
       byte >0E,>10,>07,>08,>09,>0A,>07,>FF
       byte >FF,>EB,>5F,>B1,>14,>03,>0E,>0D
       byte >19,>07,>FF,>FF,>EB,>5F,>B1,>14
       byte >03,>0B,>00,>19

