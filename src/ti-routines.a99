;       swpb r0
;       movb r0,@vdpwa                  ; Send low byte of VDP RAM read address
;       swpb r0
;       movb r0,@vdpwa                  ; Send high byte of VDP RAM read address
;       rt
;*// vrad

;*********************************************************************
;*
;* VDP Single Byte Read
;*
;* R0:  Read address in VDP RAM
;* R1:  MSB of R1 set to byte from VDP RAM
;*
;vsbr:
;       swpb r0
;       movb r0,@vdpwa                  ; Send low byte of VDP RAM read address
;       swpb r0
;       movb r0,@vdpwa                  ; Send high byte of VDP RAM read address
;       nop
;       movb @vdprd,r1                  ; Read byte from VDP RAM
;       rt
;*// vsbr

*********************************************************************
*
* VDP Multiple Byte Read
*
* R0: Starting read address in VDP RAM
* R1: Starting write address in CPU RAM
* R2: Number of bytes to read from VDP RAM
*
* Modifies R0-R2
*
;vmbr:
;       swpb r0
;       movb  r0,@vdpwa                 ; Send low byte of VDP RAM read address
;       swpb r0
;       andi r0,>3fff                   ; Set read/write bits 14 and 15 to read (00)
;       movb r0,@vdpwa                  ; Send high byte of VDP RAM read address
;       li   r0,vdprd
;vmbr_1:
;       movb *r0,*r1+                   ; Read byte from VDP RAM
;       dec  r2                         ; Byte counter
;       jne  vmbr_1                     ; Check if finished
;       rt
;*// vmbr

*********************************************************************
*
* Check key
*
* r0: Column in MSB: >0000 - >0700, Row in LSB: >0006 - >0014
*
*       Column   0      1    2    3    4    5     6       7
*     Row
*     >0006      =      .    ,    M    N    /    Fire    Fire
*     >0008    Space    L    K    J    H    ;    Left    Left
*     >000A    Enter    O    I    U    Y    P    Right   Right
*     >000C             9    8    7    6    0    Down    Down
*     >000E    Fctn     2    3    4    5    1    Up      Up
*     >0010    Shift    S    D    F    G    A
*     >0012    Ctrl     W    E    R    T    Q
*     >0014             X    C    V    B    Z
*
* On return NEQ means that the key is pressed
*
KEY_FI EQU  >0606
KEY_LF EQU  >0608
KEY_RG EQU  >060A
KEY_DN EQU  >060C
KEY_UP EQU  >060E
KEY_CM EQU  >0206
KEY_FS EQU  >0106
KEY_SL EQU  >0506
KEY_0  EQU  >050C
KEY_1  EQU  >050E
KEY_2  EQU  >010E
KEY_3  EQU  >020E
KEY_4  EQU  >030E
KEY_5  EQU  >040E
KEY_6  EQU  >040C
KEY_7  EQU  >030C
KEY_8  EQU  >020C
KEY_9  EQU  >010C
KEY_A  EQU  >0510
KEY_B  EQU  >0414
KEY_C  EQU  >0214
KEY_D  EQU  >0210
KEY_E  EQU  >0212
KEY_F  EQU  >0310
KEY_G  EQU  >0410
KEY_H  EQU  >0408
KEY_I  EQU  >020A
KEY_J  EQU  >0308
KEY_K  EQU  >0208
KEY_L  EQU  >0108
KEY_M  EQU  >0306
KEY_N  EQU  >0406
KEY_O  EQU  >010A
KEY_P  EQU  >050A
KEY_Q  EQU  >0512
KEY_R  EQU  >0312
KEY_S  EQU  >0110
KEY_T  EQU  >0412
KEY_U  EQU  >030A
KEY_V  EQU  >0314
KEY_W  EQU  >0112
KEY_X  EQU  >0114
KEY_Y  EQU  >040A
KEY_Z  EQU  >0514
KEY_SP EQU  >0008
KEY_EN EQU  >000A
KEY_FN EQU  >000E
KEY_SH EQU  >0010
KEY_CT EQU  >0012
JOY_FI EQU  >0606
JOY_LT EQU  >0608
JOY_RT EQU  >060A
JOY_DN EQU  >060C
JOY_UP EQU  >060E
JOY_1  EQU  >0606
JOY_2  EQU  >0706
*
ti_check_key:
       li   r12,>0024                  ; CRU address of the column decoder
       ldcr r0,3                       ; Select column
       andi r0,>00ff
       mov  r0,r12                     ; Select row
       tb   0                          ; Test key, EQ if not pressed
       rt
*// ti_check_key

*********************************************************************
*
* Read the keyboard
*
* TI-specific replacement for #R$347A, called once per (MSX) frame by
* ti_poll_vblank with BLWP @keyboard_vector, in its own workspace (it uses
* R12 for the CRU, which is AF' in the main workspace).
*
* While the key found last time is still held, does nothing, so that each
* press counts once. Otherwise scans the keyboard (columns 0-5): if a key
* is pressed, remembers it and stores its character in #R$E8F5, as on the
* MSX (#R$0A57): upper case letters, digits, space, Enter (>0D). With FCTN,
* 1-5 give F1-F5 (>80->84), 6 STOP (>86), 7 TAB (>09), 8 HOME (>87),
* 9 (BACK) Esc (>1B), S (left arrow) backspace (>7F) and R "[".
*
* Workspace registers: R1 the column's rows (a bit set for each key
* pressed), R2 the column (high byte), R3 the row's bit, R4 the row,
* R7 column 0 (for FCTN), R12 CRU base.
*
keyboard_vector:
       data pad_ws,ti_read_keyboard

ti_read_keyboard:
       mov  @key_held_column,r2
       jlt  ti_read_keyboard_scan      ; no key held
       bl   @ti_read_keyboard_column
       coc  @key_held_row,r1
       jne  ti_read_keyboard_scan      ; released
       rtwp                            ; still held - nothing new
ti_read_keyboard_scan:
       clr  r2
       bl   @ti_read_keyboard_column   ; column 0: = space enter fctn shift ctrl
       mov  r1,r7
       andi r1,>0700                   ; only =, space and enter count as keys
       jne  ti_read_keyboard_found
ti_read_keyboard_next:
       ai   r2,>0100
       ci   r2,>0600
       jhe  ti_read_keyboard_none
       bl   @ti_read_keyboard_column
       mov  r1,r1
       jeq  ti_read_keyboard_next
ti_read_keyboard_found:
       li   r3,>0100                   ; find the first row pressed
       clr  r4
ti_read_keyboard_row:
       coc  r3,r1
       jeq  ti_read_keyboard_key
       sla  r3,1
       inc  r4
       jmp  ti_read_keyboard_row
ti_read_keyboard_key:
       mov  r2,@key_held_column        ; remember the key
       mov  r3,@key_held_row
       mov  r2,r5
       srl  r5,5                       ; R5 = column * 8 + row
       a    r4,r5
       coc  @key_fctn_bit,r7
       jne  ti_read_keyboard_char
       movb @key_fctn_chars(r5),r0     ; with FCTN
       jne  ti_read_keyboard_store
ti_read_keyboard_char:
       movb @key_chars(r5),r0
       jeq  ti_read_keyboard_return    ; no character
ti_read_keyboard_store:
       movb r0,@pending_debounced_keypress_byte_status
ti_read_keyboard_return:
       rtwp
ti_read_keyboard_none:
       seto @key_held_column           ; no key held
       rtwp
*// ti_read_keyboard

*********************************************************************
*
* Read a keyboard column
*
* I:R2 The column (high byte)
* O:R1 A bit set in the high byte for each row pressed (bit 8 = row 0)
*
ti_read_keyboard_column:
       li   r12,>0024                  ; CRU address of the column decoder
       ldcr r2,3                       ; select the column
       li   r12,>0006                  ; CRU address of the rows
       clr  r1
       stcr r1,8                       ; read them (0 = pressed)
       inv  r1
       andi r1,>ff00
       rt
*// ti_read_keyboard_column

*********************************************************************
*
* Read the joysticks
*
* TI-specific replacement for #R$7312, called once per (MSX) frame by
* ti_poll_vblank with BLWP @joystick_vector. Builds the control bits in
* #R$E8F4 from both joysticks, as the MSX does (0 = pressed): bit 0 up,
* 1 down, 2 left, 3 right, 4 fire; and the classic Elite keys, as the MSX
* does (#R$73F2): S up, X down, ',' left, '.' right, and A or SHIFT fire
* (the MSX's cursor keys aren't read). Also sets speed_keys from SPACE,
* '/' and J, which the MSX reads in #R$401C.
*
joystick_vector:
       data pad_ws,ti_read_joysticks

ti_read_joysticks:
       clr  r1                         ; R1 = the directions pressed on either joystick
       li   r2,>0600                   ; joystick 1 (column 6)
       bl   @ti_read_joystick_column
       li   r2,>0700                   ; joystick 2 (column 7)
       bl   @ti_read_joystick_column
       clr  r0                         ; R0 = the control bits, 1 = pressed
       coc  @joystick_up,r1
       jne  ti_read_joysticks_1
       ori  r0,>0100                   ; bit 0: up
ti_read_joysticks_1:
       coc  @joystick_down,r1
       jne  ti_read_joysticks_2
       ori  r0,>0200                   ; bit 1: down
ti_read_joysticks_2:
       coc  @joystick_left,r1
       jne  ti_read_joysticks_3
       ori  r0,>0400                   ; bit 2: left
ti_read_joysticks_3:
       coc  @joystick_right,r1
       jne  ti_read_joysticks_4
       ori  r0,>0800                   ; bit 3: right
ti_read_joysticks_4:
       coc  @joystick_fire,r1
       jne  ti_read_joysticks_5
       ori  r0,>1000                   ; bit 4: fire
ti_read_joysticks_5:
       mov  r0,r5                      ; R5 = the control bits so far
       li   r6,ti_control_keys
ti_read_joysticks_6:
       mov  *r6+,r0                    ; the next key
       jeq  ti_read_joysticks_8
       bl   @ti_check_key
       jeq  ti_read_joysticks_7        ; not pressed
       soc  *r6,r5                     ; pressed - its bit
ti_read_joysticks_7:
       inct r6
       jmp  ti_read_joysticks_6
ti_read_joysticks_8:
       clr  r6                         ; R6 = the speed keys
       li   r0,KEY_SP
       bl   @ti_check_key
       jeq  ti_read_joysticks_9
       ori  r6,>0100                   ; bit 0: SPACE
ti_read_joysticks_9:
       li   r0,KEY_SL
       bl   @ti_check_key
       jeq  ti_read_joysticks_10
       ori  r6,>0200                   ; bit 1: '/'
ti_read_joysticks_10:
       li   r0,KEY_J
       bl   @ti_check_key
       jeq  ti_read_joysticks_11
       ori  r6,>0400                   ; bit 2: J
ti_read_joysticks_11:
       movb r6,@speed_keys
       mov  r5,r0
       inv  r0                         ; 0 = pressed, as on the MSX
       movb r0,@control_bits
       rtwp
*// ti_read_joysticks

*
* Read a joystick column into R1 (a bit set in the high byte for each
* direction pressed: >0100 fire, >0200 left, >0400 right, >0800 down,
* >1000 up)
*
* I:R2 The column (high byte)
*
ti_read_joystick_column:
       li   r12,>0024                  ; CRU address of the column decoder
       ldcr r2,3                       ; select the column
       li   r12,>0006                  ; CRU address of the rows
       clr  r0
       stcr r0,5                       ; read them (0 = pressed)
       inv  r0
       andi r0,>1f00
       soc  r0,r1
       rt
*// ti_read_joystick_column

* The classic Elite keys (#R$73F2) and their control bits
ti_control_keys:
       data KEY_S,>0100                ; up
       data KEY_X,>0200                ; down
       data KEY_CM,>0400               ; left
       data KEY_FS,>0800               ; right
       data KEY_A,>1000                ; fire
       data KEY_SH,>1000               ; fire
       data 0

joystick_fire:
       data >0100
joystick_left:
       data >0200
joystick_right:
       data >0400
joystick_down:
       data >0800
joystick_up:
       data >1000

*********************************************************************
*
* Move the chart cursor with the joystick
*
* TI-specific replacement for #R$73BA and #R$7373, called once per (MSX)
* frame by ti_poll_vblank with BLWP @chart_cursor_vector, before the
* controls are read (as on the MSX). Does nothing unless the chart cursor
* is on (#R$E70B) or while the VRAM is busy (#R$EF9E). If no direction is
* held (#R$E8F4), resets the cursor's speed (#R$E708) to 1; otherwise moves
* the cursor for each direction held, by the speed, up to the edge of the
* chart, and every 7 frames speeds it up, up to 8.
*
chart_cursor_vector:
       data pad_ws,ti_move_chart_cursor

ti_move_chart_cursor:
       movb @chart_cursor_active_flag,r0
       jeq  ti_move_chart_cursor_end   ; the cursor is off
       movb @vram_busy_flag,r0
       jne  ti_move_chart_cursor_end   ; the VRAM is busy
       movb @control_bits,r1
       andi r1,>0f00
       ci   r1,>0f00
       jne  ti_move_chart_cursor_1     ; a direction is held
       movb @bytes+>01,@chart_cursor_step_tier
       rtwp                            ; none: back to speed 1
ti_move_chart_cursor_1:
       li   r4,chart_cursor_nudge_table
       li   r5,>0100                   ; the first direction's bit
ti_move_chart_cursor_2:
       coc  r5,r1
       jeq  ti_move_chart_cursor_3     ; not held
       bl   @ti_step_chart_cursor      ; held - move that axis
ti_move_chart_cursor_3:
       ai   r4,4                       ; the next direction
       sla  r5,1
       ci   r5,>1000
       jne  ti_move_chart_cursor_2
       sb   @bytes+>01,@chart_cursor_countdown
       jne  ti_move_chart_cursor_end
       movb @bytes+>07,@chart_cursor_countdown
       cb   @chart_cursor_step_tier,@bytes+>08
       jhe  ti_move_chart_cursor_end
       ab   @bytes+>01,@chart_cursor_step_tier ; faster
ti_move_chart_cursor_end:
       rtwp
*// ti_move_chart_cursor

*
* Move the cursor along one axis by its speed, towards a limit (#R$7373)
*
* I:R4 -> the direction's record in chart_cursor_nudge_table
*
ti_step_chart_cursor:
       mov  r11,r10
       mov  *r4,r6                     ; R6 -> the coordinate
       clr  r7
       movb *r6,r7
       cb   r7,@2(r4)
       jeq  ti_step_chart_cursor_end   ; already at the limit
       srl  r7,8                       ; R7 = the coordinate
       clr  r8
       movb @chart_cursor_step_tier,r8
       srl  r8,8                       ; R8 = the speed
       clr  r9
       movb @2(r4),r9
       srl  r9,8                       ; R9 = the limit
       movb @3(r4),r0
       jlt  ti_step_chart_cursor_1     ; towards a lower limit
       a    r8,r7                      ; towards a higher one
       c    r7,r9
       jl   ti_step_chart_cursor_2
       mov  r9,r7                      ; past it - clamp
       jmp  ti_step_chart_cursor_2
ti_step_chart_cursor_1:
       s    r8,r7
       jlt  ti_step_chart_cursor_clamp
       c    r7,r9
       jhe  ti_step_chart_cursor_2
ti_step_chart_cursor_clamp:
       mov  r9,r7                      ; past it - clamp
ti_step_chart_cursor_2:
       swpb r7
       movb r7,*r6                     ; the new coordinate
       bl   @move_chart_cursor_sprite  ; move the sprite there (#R$73A6)
ti_step_chart_cursor_end:
       b    *r10
*// ti_step_chart_cursor

* For each direction (up, down, left, right): the coordinate it moves,
* its limit, and whether it moves down (>FF) or up (>01) to it (#R$73FC)
chart_cursor_nudge_table:
       data chart_cursor_y
       byte >00,>ff
       data chart_cursor_y
       byte >9f,>01
       data chart_cursor_x
       byte >11,>ff
       data chart_cursor_x
       byte >e0,>01

key_held_column:                       ; The column of the key held (high byte), or -1
       data -1
key_held_row:                          ; Its row's bit (as from ti_read_keyboard_column)
       data 0
key_fctn_bit:                          ; FCTN in column 0
       data >1000

* The character for each key, by column (0-5) and row (0-7), as in #R$0A57
key_chars:
       byte '=',' ',>0d,0,0,0,0,0
       byte '.','L','O','9','2','S','W','X'
       byte ',','K','I','8','3','D','E','C'
       byte 'M','J','U','7','4','F','R','V'
       byte 'N','H','Y','6','5','G','T','B'
       byte '/',';','P','0','1','A','Q','Z'
* The same with FCTN (0 = as without)
key_fctn_chars:
       byte 0,0,0,0,0,0,0,0
       byte 0,0,0,>1b,>81,>7f,0,0      ; 9 (BACK) Esc, 2 F2, S (left) backspace
       byte 0,0,0,>87,>82,0,0,0        ; 8 HOME, 3 F3
       byte 0,0,0,>09,>83,0,'[',0      ; 7 TAB, 4 F4, R [
       byte 0,0,0,>86,>84,0,0,0        ; 6 STOP, 5 F5
       byte 0,0,0,0,>80,0,0,0          ; 1 F1
       even

;ti_read_joystick:
