********************************************************************************
* Pick a random point at a given distance
* 
* Used by the routines at #R$2B05, #R$2C3C, #R$2D3B, #R$8C94 and #R$8D2A.
* .
* Sets the object's position (#R$F7CE, #R$F7D0, #R$F7D2) to a point at
* distance r from the player, in a direction given by two angles in degrees
* (0-360): a1 (the longitude) and a2 (the latitude), with x = r * cos(a1) *
* cos(a2), y = r * sin(a2) and z = r * sin(a1) * cos(a2) (#R$8FBB,
* #R$8F94). With carry set both angles are random, so the point is anywhere
* around the player (for ships, asteroids, the planet and the station,
* #R$2B24, #R$2C3C, #R$2D3B, #R$8C94, #R$8CB1). With carry clear a1 is 0,
* so the point is on the circle z = 0, beside, above or below the player
* (for the sun on launching, #R$8D2A).
* .
* At $8F3C, sets a1 to 0; at $8F3F, picks a random a2 (0-360) and works out
* the point.
* 
* I:HL Distance (r)
* I:F Carry set for any direction
random_point:                                              ; >8f25
       mov  hl,@scratch_buffer                             ; LD ($E600),HL     ; r
       jnc  random_point_2                                 ; JR NC,$8F3C       ; TODO: check code. carry clear - a1 = 0
_8f2a:                                                     ; >8f2a
       .call @random_byte                                  ; CALL $2176        ; 
       movb a,@e                                           ; LD E,A            ; 
       .call @random_byte                                  ; CALL $2176        ; A = another random byte
       andi a,>0100                                        ; AND $01           ; 
       movb a,d                                            ; LD D,A            ; DE = a random 0-511
       li   hl,>fe97                                       ; LD HL,$FE97       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _8f2a                                          ; JR C,$8F2A        ; TODO: check code. over 360 - try again
       jmp  _8f3f                                          ; JR $8F3F          ; a1
random_point_2:                                            ; >8f3c
       li   de,>0000                                       ; LD DE,$0000       ; a1 = 0
_8f3f:                                                     ; >8f3f
       .call @sin_cos                                      ; CALL $8FBB        ; A = sin(a1), E = cos(a1)
       movb a,@circle_connector_no_prev_point_gate         ; LD ($E602),A      ; 
       movb @e,a                                           ; LD A,E            ; 
       movb a,@lineplot_scratch_vars_e603                  ; LD ($E603),A      ; 
_8f49:                                                     ; >8f49
       .call @random_byte                                  ; CALL $2176        ; 
       movb a,@e                                           ; LD E,A            ; 
       .call @random_byte                                  ; CALL $2176        ; A = another random byte
       andi a,>0100                                        ; AND $01           ; 
       movb a,d                                            ; LD D,A            ; DE = a random 0-511
       li   hl,>fe97                                       ; LD HL,$FE97       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _8f49                                          ; JR C,$8F49        ; TODO: check code. over 360 - try again
       .call @sin_cos                                      ; CALL $8FBB        ; A = sin(a2), E = cos(a2)
       movb a,@scratch_buffer_4                            ; LD ($E604),A      ; 
       movb @e,a                                           ; LD A,E            ; 
       movb a,@scratch_buffer_5                            ; LD ($E605),A      ; 
       mov  @scratch_buffer,hl                             ; LD HL,($E600)     ; HL = r
       movb @lineplot_scratch_vars_e603,a                  ; LD A,($E603)      ; A = cos(a1)
       .call @multiply_by_sine                             ; CALL $8F94        ; r * cos(a1)
       movb @scratch_buffer_5,a                            ; LD A,($E605)      ; A = cos(a2)
       .call @multiply_by_sine                             ; CALL $8F94        ; * cos(a2)
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; x
       mov  @scratch_buffer,hl                             ; LD HL,($E600)     ; HL = r
       movb @scratch_buffer_4,a                            ; LD A,($E604)      ; A = sin(a2)
       .call @multiply_by_sine                             ; CALL $8F94        ; r * sin(a2)
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; y
       mov  @scratch_buffer,hl                             ; LD HL,($E600)     ; HL = r
       movb @circle_connector_no_prev_point_gate,a         ; LD A,($E602)      ; A = sin(a1)
       .call @multiply_by_sine                             ; CALL $8F94        ; r * sin(a1)
       movb @scratch_buffer_5,a                            ; LD A,($E605)      ; A = cos(a2)
       .call @multiply_by_sine                             ; CALL $8F94        ; * cos(a2)
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; z
       .ret                                                ; RET               ; 

********************************************************************************
* Multiply by a sine or cosine
* 
* Used by the routine at #R$8F25.
* .
* Returns HL * A / 128, with A a sine or cosine from #R$8FBB (1.0 = 127,
* so this is very slightly short). Both are two's complement; the result
* is truncated.
* 
* I:A Sine or cosine
* I:HL Value
* O:HL The product
multiply_by_sine:                                          ; >8f94
       movb a,@c                                           ; LD C,A            ; Stash the scale factor (A is about to be XORed)
       ; XOR H                                             ; XOR H             ; TODO: check code. 
       .ex_af_af_                                          ; EX AF,AF'         ; Stash sign(A) ^ sign(H) (only bit 7 of this matters later)
       czc  @bit7,h                                        ; BIT 7,H           ; 
       jeq  _8fa1                                          ; JR Z,$8FA1        ; 
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; HL := |HL|
_8fa1:                                                     ; >8fa1
       movb @c,a                                           ; LD A,C            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$8FA8        ; 
       b    @multiply_by_sine_abs                          ;                   
!
       neg a                                               ; NEG               ; A := |A|
multiply_by_sine_abs:                                      ; >8fa8
       .call @multiply_16x8                                ; CALL $1F86        ; A:HL := |HL| * |A| (24-bit product)
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. Shift A:H:L left 1 bit (L only to catch a carry, discarded next)
       movb h,@l                                           ; LD L,H            ; 
       movb a,h                                            ; LD H,A            ; Keep bits 7-22 of the product as the new HL (product >> 7)
       .ex_af_af_                                          ; EX AF,AF'         ; Recover the combined sign
       jlt  !                                              ; RET P             ; Positive - return the magnitude as-is
       .ret                                                ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Get the sine and cosine of an angle
* 
* Used by the routine at #R$8F25.
* .
* Works out which quadrant the angle is in, and gets the sine and cosine
* from the sine table (#R$901C) using these identities:
* .
* #LIST
* { 0-90 degrees: sin(x), and cos(x) = sin(90 - x) }
* { 91-180 (at $8FCE): sin(x) = sin(180 - x), and cos(x) = -sin(x - 90) }
* { 181-270 (at $8FE5): sin(x) = -sin(x - 180), and cos(x) = -sin(270 - x) }
* { 271-360 (at $9004): sin(x) = -sin(360 - x), and cos(x) = sin(x - 270) }
* LIST#
* .
* Each part saves the sine in A' while it works out the cosine; the exit
* at $9019 returns them. The results are 127 times the sine and cosine,
* in two's complement.
* 
* I:DE Angle in degrees (0-360)
* O:A Sine
* O:E Cosine
sin_cos:                                                   ; >8fbb
       li   hl,>ffa5                                       ; LD HL,$FFA5       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _8fce                                          ; JR C,$8FCE        ; TODO: check code. 91 or more
       movb @e,a                                           ; LD A,E            ; A = x
       .call @look_up_sine                                 ; CALL $901C        ; A = sin(x)
       .ex_af_af_                                          ; EX AF,AF'         ; save it
       movb @bytes+>5a,a                                   ; LD A,$5A          ; 
       sb   @e,a                                           ; SUB E             ; A = 90 - x
       .call @look_up_sine                                 ; CALL $901C        ; A = sin(90 - x) = cos(x)
       jmp  _9019                                          ; JR $9019          ; 
_8fce:                                                     ; >8fce
       li   hl,>ff4b                                       ; LD HL,$FF4B       ; -181
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _8fe5                                          ; JR C,$8FE5        ; TODO: check code. 181 or more
       movb @bytes+>b4,a                                   ; LD A,$B4          ; 180
       sb   @e,a                                           ; SUB E             ; A = 180 - x
       .call @look_up_sine                                 ; CALL $901C        ; A = sin(180 - x) = sin(x)
       .ex_af_af_                                          ; EX AF,AF'         ; save it
       movb @e,a                                           ; LD A,E            ; 
       sb   @bytes+>5a,a                                   ; SUB $5A           ; A = x - 90
       .call @look_up_sine                                 ; CALL $901C        ; A = sin(x - 90)
       neg a                                               ; NEG               ; A = -sin(x - 90) = cos(x)
       jmp  _9019                                          ; JR $9019          ; 
_8fe5:                                                     ; >8fe5
       li   hl,>fef1                                       ; LD HL,$FEF1       ; -271
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _9004                                          ; JR C,$9004        ; TODO: check code. 271 or more
       li   hl,>ff4c                                       ; LD HL,$FF4C       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       movb @l,a                                           ; LD A,L            ; A = x - 180
       .call @look_up_sine                                 ; CALL $901C        ; A = sin(x - 180)
       neg a                                               ; NEG               ; A = -sin(x - 180) = sin(x)
       .ex_af_af_                                          ; EX AF,AF'         ; save it
       li   hl,>010e                                       ; LD HL,$010E       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       movb @l,a                                           ; LD A,L            ; A = 270 - x
       .call @look_up_sine                                 ; CALL $901C        ; A = sin(270 - x)
       neg a                                               ; NEG               ; A = -sin(270 - x) = cos(x)
       jmp  _9019                                          ; JR $9019          ; 
_9004:                                                     ; >9004
       li   hl,>0168                                       ; LD HL,$0168       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       movb @l,a                                           ; LD A,L            ; A = 360 - x
       .call @look_up_sine                                 ; CALL $901C        ; A = sin(360 - x)
       neg a                                               ; NEG               ; A = -sin(360 - x) = sin(x)
       .ex_af_af_                                          ; EX AF,AF'         ; save it
       li   hl,>fef2                                       ; LD HL,$FEF2       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       movb @l,a                                           ; LD A,L            ; A = x - 270
       .call @look_up_sine                                 ; CALL $901C        ; A = sin(x - 270) = cos(x)
_9019:                                                     ; >9019
       movb a,@e                                           ; LD E,A            ; E = cos(x)
       .ex_af_af_                                          ; EX AF,AF'         ; A = sin(x)
       .ret                                                ; RET               ; 

********************************************************************************
* Look up a sine
* 
* Used by the routine at #R$8FBB.
* .
* Returns sin(A) * 127 from the sine table at #R$9025.
* 
* I:A Angle in degrees (0-90)
* O:A Its sine * 127
look_up_sine:                                              ; >901c
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,sine_table                                  ; LD HL,$9025       ; the shared quarter-wave table
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Sine table
* 
* sin(n) * 127 for n = 0-90 degrees (#R$901C).
sine_table:                                                ; >9025
       byte >00,>02,>04,>07,>09,>0B,>0D,>0F
       byte >12,>14,>16,>18,>1A,>1D,>1F,>21
       byte >23,>25,>27,>29,>2B,>2E,>30,>32
       byte >34,>36,>38,>3A,>3C,>3E,>40,>41
       byte >43,>45,>47,>49,>4B,>4C,>4E,>50
       byte >52,>53,>55,>57,>58,>5A,>5B,>5D
       byte >5E,>60,>61,>63,>64,>65,>67,>68
       byte >69,>6B,>6C,>6D,>6E,>6F,>70,>71
       byte >72,>73,>74,>75,>76,>77,>77,>78
       byte >79,>79,>7A,>7B,>7B,>7C,>7C,>7D
       byte >7D,>7D,>7E,>7E,>7E,>7F,>7F,>7F
       byte >7F,>7F,>7F

********************************************************************************
* The space station's orientation at launch
* 
* Copied into the station's side and nose vectors by #R$8D2A: side (1, 0,
* 0) and nose (0, 0, 1), so its slot faces forward.
station_launch_orientation:                                ; >9080
       data >4000,>0000,>0000                                        ; side vector
       data >0000,>0000,>4000                                        ; nose vector

********************************************************************************
* Missions: start the next mission
* 
* Used by the routine at #R$894D.
* .
* Called by #R$894D every 64 hyperspace jumps while no mission is under
* way (outside the first galaxy). Sets the mission state (#R$E93D) to
* the start of the next mission (#R$E93C): $10, $20, $30, $40 and $50 for
* missions 1-5 (the default commander starts with mission 1, see
* #R$7172); after the last it does nothing.
start_next_mission:                                        ; >908c
       movb @next_mission,a                                ; LD A,($E93C)      ; A = the next mission
       cb   a,@bytes+>06                                   ; CP $06            ; 
       jne  !                                              ; RET Z             ; all missions done
       .ret                                                ;                   
!
       ab   one,a                                          ; INC A             ; 
       movb a,@next_mission                                ; LD ($E93C),A      ; 
       sb   one,a                                          ; DEC A             ; A = the counter's old value again
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; A *= 16
       movb a,@mission_state                               ; LD ($E93D),A      ; mission state = mission * 16
       .ret                                                ; RET               ; 

********************************************************************************
* Mission 3: the supernova briefing
* 
* Used by the routine at #R$1896.
* .
* Shown on docking in the system whose sun is about to go supernova (state
* $31, after the fuel leak, see #R$894D). Moves on to state $32, dumps the
* cargo (#R$9237), and asks the player to take refugees ("Our sun is going
* supernova!"). Accepting goes on to $90B8. Declining shows a curse and
* leaves the state at $32: the sun still approaches (#R$883D), and the
* mission ends at the next hyperspace jump (#R$8AC8) without a reward.
* .
* At $90B8, fills the hold's free space with refugees (the cargo entry at
* #R$EB5D), moves on to state $33 - in which the sun gets closer
* (#R$883D) until the player hyperspaces out - and thanks the player. The
* entry at $90CD shows the message at HL, then waits for a key (#R$922D).
supernova_briefing:                                        ; >909f
       li   hl,mission_state                               ; LD HL,$E93D       ; mission state
       ab   one,*hl                                        ; INC (HL)          ; state $32
       .call @clear_cargo_hold                             ; CALL $9237        ; dump the cargo
       li   hl,msg_supernova_briefing                      ; LD HL,$9272       ; "Our sun is going supernova!..."
       .call @show_mission_screen                          ; CALL $90D3        ; 
       .call @confirm_prompt_yn                            ; CALL $3815        ; wait for Y or N
       cb   a,@bytes+>59                                   ; CP $59            ; 'Y'?
       jeq  supernova_take_refugees                        ; JR Z,$90B8        ; accepted
       li   hl,msg_supernova_declined                      ; LD HL,$93FD       ; "We hope you die a horribly long..."
       jmp  _90cd                                          ; JR $90CD          ; 
supernova_take_refugees:                                   ; >90b8
       .call @work_out_free_space                          ; CALL $63BA        ; recompute the hold's free space
       li   hl,free_space                                  ; LD HL,$EB61       ; 
       li   de,cargo_refugees                              ; LD DE,$EB5D       ; refugees fill it
       li   bc,>0004                                       ; LD BC,$0004       ; 
       .ldir                                               ; LDIR              ; 
       li   hl,mission_state                               ; LD HL,$E93D       ; mission state
       ab   one,*hl                                        ; INC (HL)          ; state $33
       li   hl,msg_supernova_accepted                      ; LD HL,$935A       ; "Thank you! ... drop us off at the nearest system"
_90cd:                                                     ; >90cd
       .call @show_mission_screen                          ; CALL $90D3        ; show it
       b    @mission_wait_key                              ; JP $922D          ; 

********************************************************************************
* Missions: show a mission screen
* 
* Used by the routines at #R$909F, #R$90FB, #R$9120, #R$9190, #R$91AA, #R$91DB,
* #R$91F0, #R$920F and #R$9220.
* .
* Clears the screen and draws a frame with "Mission No." and the mission
* number (the high nibble of the mission state, #R$E93D), "Attn:
* Commander" and the commander's name (#R$EB06), then the message at HL.
* The messages are printed with RST $20, which handles their embedded
* control codes (position and colour).
* 
* I:HL The message
show_mission_screen:                                       ; >90d3
       .push hl                                            ; PUSH HL           ; stash the caller's message
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide the sprites
       li   ix,mission_screen_frame                        ; LD IX,$9267       ; 
       .call @rst_28_target_draw_list_tile                 ; CALL $36F1        ; draw a frame
       li   hl,mission_no_text                             ; LD HL,$9245       ; "Mission No."
       .rst >20                                            ; RST $20           ; print it
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>0f00                                        ; AND $0F           ; C = mission number
       movb a,@c                                           ; LD C,A            ; 
       sb   a,a                                            ; XOR A             ; 
       s    hl,hl                                          ; SBC HL,HL         ; 
       .rst >18                                            ; RST $18           ; print it
       li   hl,attn_commander_text                         ; LD HL,$9254       ; "Attn: Commander"
       .rst >20                                            ; RST $20           ; print it
       li   hl,commander_name                              ; LD HL,$EB06       ; commander_name
       .rst >08                                            ; RST $08           ; print the commander's name
       .pop hl                                             ; POP HL            ; recover the caller's message
       .rst >20                                            ; RST $20           ; print the message
       .ret                                                ; RET               ; 

********************************************************************************
* Mission 3: the refugees delivered
* 
* Used by the routine at #R$1896.
* .
* On docking in another system (state $34, see #R$8AC8): thanks the
* player, unloads the refugees (#R$EB5D), and puts 50 grams of gem-stones
* in the hold (#R$EB55, from #R$9A46). The mission is over.
supernova_complete:                                        ; >90fb
       li   hl,msg_supernova_complete                      ; LD HL,$92E3       ; "TASK COMPLETE - CONGRATULATIONS..."
       .call @show_mission_screen                          ; CALL $90D3        ; show it
       li   hl,cargo_refugees                              ; LD HL,$EB5D       ; 
       sb   *hl,*hl                                        ; LD (HL),$00       ; unload the refugees
       li   de,cargo_refugees+>0001                        ; LD DE,$EB5E       ; 
       li   bc,>0003                                       ; LD BC,$0003       ; 
       .ldir                                               ; LDIR              ; 
       li   hl,mission_3_gem_stones                        ; LD HL,$9A46       ; 
       li   de,cargo_gem_stones                            ; LD DE,$EB55       ; load the gem-stones
       li   bc,>0004                                       ; LD BC,$0004       ; 
       .ldir                                               ; LDIR              ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@mission_state                               ; LD ($E93D),A      ; no mission
       b    @mission_wait_key                              ; JP $922D          ; 

********************************************************************************
* Missions 1 and 2: the briefing
* 
* Used by the routine at #R$1896.
* .
* Shown on docking in state $10 or $20. For mission 1 first shows the
* Constrictor on the title screen until a key is pressed (#R$1C5C). Then
* picks the system furthest from the current one (#R$5325) - the navy
* research centre the Constrictor was stolen from (mission 1), or the naval
* base the Thargoid documents must be taken to (mission 2) - and remembers
* it (#R$EFA2). Shows the briefing with that system's name and asks the
* player to accept the mission: 'N' ends it.
* .
* At $916C, moves on to state $11 (mission 1: go to the research centre) or
* $21 (mission 2: carry the documents to the naval base, which also sets
* #R$F785), and (at $917D) shows the follow-up message with the system's
* name.
mission_briefing:                                          ; >9120
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>10                                   ; CP $10            ; mission 1?
       jne  _912e                                          ; JR NZ,$912E       ; no - skip the one-time setup
       .call @title_screen                                 ; CALL $1C5C        ; show the Constrictor
       sb   a,a                                            ; XOR A             ; 
       movb a,@e940_gate_flag                              ; LD ($E940),A      ; clear the search-cascade gate flag
_912e:                                                     ; >912e
       mov  @current_system_x,bc                           ; LD BC,($F760)     ; the current system's coordinates
       .call @nearest_and_furthest_systems                 ; CALL $5325        ; find the furthest system
       movb a,@mission_system                              ; LD ($EFA2),A      ; remember it
       li   hl,empty_mission_message                       ; LD HL,$9A4A       ; an empty message
       .call @show_mission_screen                          ; CALL $90D3        ; show the mission screen
       li   bc,>0f0b                                       ; LD BC,$0F0B       ; the default message's position
       li   hl,msg_constrictor_briefing                    ; LD HL,$9483       ; "A prototype of the new military ship, the CONSTRICTOR..."
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>20                                   ; CP $20            ; mission 2?
       jne  _9151                                          ; JR NZ,$9151       ; no - use the default message
       li   bc,>050b                                       ; LD BC,$050B       ; yes: an alternate position
       li   hl,msg_documents_briefing                      ; LD HL,$96DA       ; "The navy has managed to obtain blueprints of a Thargoid..."
_9151:                                                     ; >9151
       .push hl                                            ; PUSH HL           ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       movb @mission_system,a                              ; LD A,($EFA2)      ; the affected system
       .call @generate_system_name                         ; CALL $4CAF        ; 
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       .rst >08                                            ; RST $08           ; print the system's name
       .pop hl                                             ; POP HL            ; recover the chosen message
       .rst >20                                            ; RST $20           ; print the briefing
       .call @confirm_prompt_yn                            ; CALL $3815        ; wait for Y or N
       sb   @bytes+>4e,a                                   ; SUB $4E           ; 'N'?
       jne  mission_accept                                 ; JR NZ,$916C       ; accepted
       movb a,@mission_state                               ; LD ($E93D),A      ; declined: no mission
       .ret                                                ; RET               ; 
mission_accept:                                            ; >916c
       li   hl,mission_state                               ; LD HL,$E93D       ; mission state
       ab   one,*hl                                        ; INC (HL)          ; next state
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       cb   a,@bytes+>21                                   ; CP $21            ; mission 2?
       jne  continue_916c_show_followup_message            ; JR NZ,$917D       ; 
       movb one,a                                          ; LD A,$01          ; yes - arm the flag
       movb a,@carrying_documents                          ; LD ($F785),A      ; carrying the Thargoid documents
       .ret                                                ; RET               ; 
continue_916c_show_followup_message:                       ; >917d
       li   hl,msg_report_to_station                       ; LD HL,$955F       ; a follow-up message
       .call @show_mission_screen                          ; CALL $90D3        ; show it
       movb @mission_system,a                              ; LD A,($EFA2)      ; the affected system
       .call @generate_system_name                         ; CALL $4CAF        ; generate and format its name
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       .rst >08                                            ; RST $08           ; print it
       b    @mission_wait_key                              ; JP $922D          ; wait for a key, then redraw

********************************************************************************
* Mission 1: arrive at the research centre
* 
* Used by the routine at #R$6164.
* .
* Called by 'Data on System' (#R$6164) in state $11. If the player is at
* the research centre (#R$EFA2), shows "Intelligence reports that the
* Constrictor made a galactic jump out of this system" and moves on to
* state $12 - until the player makes a galactic jump too (#R$894D).
constrictor_at_research_centre:                            ; >9190
       movb @docked,a                                      ; LD A,($E90A)      ; docked?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; not docked
       .ret                                                ;                   
!
       movb @current_system,a                              ; LD A,($EB67)      ; A = the current system
       li   hl,mission_system                              ; LD HL,$EFA2       ; the affected system
       cb   a,*hl                                          ; CP (HL)           ; do they match?
       jeq  !                                              ; RET NZ            ; not the research centre
       .ret                                                ;                   
!
       li   hl,msg_constrictor_jumped                      ; LD HL,$9593       ; "...the Constrictor made a galactic jump..."
       .call @show_mission_screen                          ; CALL $90D3        ; show it
       li   hl,mission_state                               ; LD HL,$E93D       ; 
       ab   one,*hl                                        ; INC (HL)          ; state $12
       b    @mission_wait_key                              ; JP $922D          ; wait for a key, then redraw

********************************************************************************
* Mission 1: follow the Constrictor's trail
* 
* Used by the routine at #R$6164.
* .
* Called by 'Data on System' (#R$6164) in state $13. If the player is at
* the system the Constrictor was last heard of (#R$EFA2), moves on to
* state $14 and picks the next system on its trail, somewhere nearby
* (#R$50AA): "the Constrictor left this system, destination is system of
* ...". After five systems (#R$EFA3) moves on to state $15, and the
* Constrictor is waiting in the last one (#R$1896). State $14 goes back
* to $13 at the next hyperspace jump (#R$8AC8).
constrictor_trail:                                         ; >91aa
       movb @docked,a                                      ; LD A,($E90A)      ; docked?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; not docked
       .ret                                                ;                   
!
       movb @current_system,a                              ; LD A,($EB67)      ; A = the current system
       li   hl,mission_system                              ; LD HL,$EFA2       ; the affected system
       cb   a,*hl                                          ; CP (HL)           ; do they match?
       jeq  !                                              ; RET NZ            ; not on the trail
       .ret                                                ;                   
!
       li   hl,mission_state                               ; LD HL,$E93D       ; 
       ab   one,*hl                                        ; INC (HL)          ; state $14
       .call @pick_random_nearby_system_not_target         ; CALL $50AA        ; pick the next system on the trail
       li   hl,msg_constrictor_trail                       ; LD HL,$95F6       ; "...the Constrictor left this system, destination is..."
       .call @show_mission_screen                          ; CALL $90D3        ; show it
       movb @mission_system,a                              ; LD A,($EFA2)      ; the affected system
       .call @generate_system_name                         ; CALL $4CAF        ; 
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       .rst >08                                            ; RST $08           ; print the next system's name
       li   hl,constrictor_trail_count                     ; LD HL,$EFA3       ; systems left on the trail
       sb   one,*hl                                        ; DEC (HL)          ; one fewer system to go
       jne  _91d8                                          ; JR NZ,$91D8       ; 
       li   hl,mission_state                               ; LD HL,$E93D       ; 
       ab   one,*hl                                        ; INC (HL)          ; state $15: the Constrictor is in the next one
_91d8:                                                     ; >91d8
       b    @mission_wait_key                              ; JP $922D          ; wait for a key, then redraw

********************************************************************************
* Mission 2: the Thargoid documents delivered
* 
* Used by the routine at #R$1896.
* .
* Thanks the player and fits a naval energy unit (#R$F77E = 2). The
* mission is over.
documents_delivered:                                       ; >91db
       li   hl,msg_documents_reward                        ; LD HL,$97E2       ; "We are (again) forever in your debt..."
       .call @show_mission_screen                          ; CALL $90D3        ; show it
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@item_energy_unit                            ; LD ($F77E),A      ; fit a naval energy unit
       sb   a,a                                            ; XOR A             ; 
       movb a,@mission_state                               ; LD ($E93D),A      ; no mission
       movb a,@carrying_documents                          ; LD ($F785),A      ; no longer carrying the documents
       b    @mission_wait_key                              ; JP $922D          ; wait for a key, then redraw

********************************************************************************
* Mission 1: the reward
* 
* Used by the routine at #R$1896.
* .
* Thanks the player for destroying the Constrictor and pays 10,000
* credits (100000 in tenths of a credit, see #R$EB16). The mission is
* over.
constrictor_reward:                                        ; >91f0
       li   hl,msg_constrictor_reward                      ; LD HL,$9666       ; "The Navy are forever in your debt..."
       .call @show_mission_screen                          ; CALL $90D3        ; show it
       mov  @player_cash,hl                                ; LD HL,($EB16)     ; the player's cash
       movb @cash_2,a                                      ; LD A,($EB18)      ; 
       li   de,>86a0                                       ; LD DE,$86A0       ; plus 100000
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   one,a                                          ; ADC A,$01         ; ...plus the high byte
       mov  hl,@player_cash                                ; LD ($EB16),HL     ; 
       movb a,@cash_2                                      ; LD ($EB18),A      ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@mission_state                               ; LD ($E93D),A      ; no mission
       b    @mission_wait_key                              ; JP $922D          ; wait for a key, then redraw

********************************************************************************
* Mission 5: the reward
* 
* Used by the routine at #R$1896.
* .
* Thanks the player for destroying the Thargoid base and fits the ECM
* jammer, activated by the L key (#R$F783). The mission is over.
thargoid_base_reward:                                      ; >920f
       li   hl,msg_thargoid_base_reward                    ; LD HL,$997A       ; "Thanks for destroying the Thargoid base..."
       .call @show_mission_screen                          ; CALL $90D3        ; show it
       sb   a,a                                            ; XOR A             ; 
       movb a,@mission_state                               ; LD ($E93D),A      ; no mission
       ab   one,a                                          ; INC A             ; 
       movb a,@ecm_jammer_fitted                           ; LD ($F783),A      ; fit the ECM jammer
       b    @mission_wait_key                              ; JP $922D          ; wait for a key, then redraw

********************************************************************************
* Mission 5: the briefing
* 
* Used by the routine at #R$1896.
* .
* Warns that a nearby system has been invaded by the Thargoids, and moves
* on to state $51. At the next hyperspace jump (#R$8AC8) the state
* becomes $52: the system arrived at has been invaded - its space station
* launches Thargoids instead of police (#R$315C), can't be docked with
* (#R$1692, #R$8755), and can be destroyed (#R$291E).
thargoid_base_briefing:                                    ; >9220
       li   hl,msg_thargoid_base_briefing                  ; LD HL,$98B4       ; "Intellegence reports that a nearby system has been invaded..."
       .call @show_mission_screen                          ; CALL $90D3        ; show it
       li   hl,mission_state                               ; LD HL,$E93D       ; 
       ab   one,*hl                                        ; INC (HL)          ; state $51
       b    @mission_wait_key                              ; JP $922D          ; wait for a key, then redraw

********************************************************************************
* Missions: wait for a key and go back
* 
* Used by the routines at #R$909F, #R$90FB, #R$9120, #R$9190, #R$91AA, #R$91DB,
* #R$91F0, #R$920F and #R$9220.
* .
* Prints "Press any key to continue.", waits for a key (#R$3A3C) and
* clears the message line (#R$3955).
mission_wait_key:                                          ; >922d
       li   hl,msg_press_any_key                           ; LD HL,$933D       ; "Press any key to continue."
       .rst >20                                            ; RST $20           ; print it
       .call @block_until_key_action_no_cursor             ; CALL $3A3C        ; wait for a key
       b    @clear_message_line                            ; JP $3955          ; clear the message line

********************************************************************************
* Clear the cargo hold
* 
* Used by the routines at #R$193F, #R$19FC and #R$909F.
* .
* Empties the cargo hold (#R$EB19): used when the player dies (#R$193F),
* ejects in the escape capsule (#R$19FC), or takes on the supernova
* refugees (#R$909F).
clear_cargo_hold:                                          ; >9237
       li   hl,cargo_hold                                  ; LD HL,$EB19       ; the scratch area
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,cargo_hold+>0001                            ; LD DE,$EB1A       ; 
       li   bc,>0047                                       ; LD BC,$0047       ; 18 entries of 4 bytes
       .ldir                                               ; LDIR              ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Mission screen: "Mission No."
* 
* The first line of every mission screen, printed by #R$90D3 (RST $20) and
* followed by the mission number. Like all the mission messages, it is a list
* of (column, row, string) records ending with $FF (see #R$3596).
mission_no_text:                                           ; >9245
       text >0e,>01,'MISSION NO.',>a0
       byte >FF

********************************************************************************
* Mission screen: "Attn: Commander"
* 
* Printed by #R$90D3 (RST $20) and followed by the commander's name.
attn_commander_text:                                       ; >9254
       text >05,>04,'ATTN: COMMANDER',>a0
       byte >FF

********************************************************************************
* Mission screen frame
* 
* Two (RST $28) rectangles that #R$90D3 draws on every mission screen (see
* #R$36F1).
mission_screen_frame:                                      ; >9267
       byte >0E,>01,>0D,>01,>71
       byte >05,>04,>20,>01,>D1
       byte >FF

********************************************************************************
* Mission 3: the briefing
