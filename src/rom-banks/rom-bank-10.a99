* ROM bank 10: the math tables, and code: the title screen
* Assembled for real by code-bank-10.a99, and DORG in the other builds for its labels
       .ifdef code_bank_10
       aorg >6000
       .else
       dorg >6000
       .endif
       bss  >40
       .ifdef code_bank_10
       bcopy "../../bin/math-tables.bin" ; the math tables, as in the other banks
       .else
       bss  math_tables_end-math_tables
       .endif

* The title screen (TI: in a ROM bank, as it is only used between games; its
* view messages stay in RAM, as they are printed later from any bank)

********************************************************************************
* Title screen
*
* Used by the routines at #R$0106 and #R$9120.
* .
* Called by the main loop (#R$0106), and by #R$9120 for a mission briefing.
* Switches to the front view (#R$64A1), which also draws the cockpit
* screen, and marks the game as in flight (($E903)) with the main loop's
* per-frame pass off (($E90A)).
* .
* Normally, turns sound effects off, starts the title music (#R$7603), and
* shows the spinning "ELITE" letters (#R$1E01). Then shows each of the 14
* ships in #R$1F40 in turn: each one flies in from a distance of 2000 to a
* distance that depends on its size, turns this way and that for 150
* frames, then flies off, with its name and "Load New Commander ?" shown
* underneath. After the last ship it starts again with the letters. It only
* leaves when Y or N is pressed ($1DB5), jumping to the load commander
* screen or the docked screen.
* .
* For a mission briefing (($E93D) = $10, from #R$9120) it shows just the
* ship in #R$1F4F, with "Hit key for mission", and returns when any key is
* pressed.
* .
* At $1D3D, moves the ship in by 120 each frame until it reaches the
* distance in ($E888), then turns it about two axes by angles that swing
* back and forth (#R$1DDC). Counts down the 150 frames in ($E88B), and then
* starts the ship flying off (($E88C)). Then checks for a key (($E8F5)):
* for a mission briefing any key returns; otherwise Y or N goes to $1DB5,
* and anything else is ignored. Loops back for the next frame at #R$1CF4.
* .
* At $1DB5, stops the music (#R$7438), sets up the commander record
* (#R$A469), turns sound effects back on, and clears $EEC1, $E940, $EF8E
* and $E90C. Then Y ($E924 = $FF) goes to the load commander screen
* (#R$A30A), and N to the docked screen (#R$6276), starting with the
* default commander.
title_screen:                                              ; >1c5c
;      limi 0                                              ; DI                ; backdrop colour 1 (black)
       movb one,a                                          ; LD A,$01          ;
       movb a,@vdpwa                                       ; OUT ($99),A       ;
       movb @bytes+>87,a                                   ; LD A,$87          ;
       movb a,@vdpwa                                       ; OUT ($99),A       ;
       ; EI                                                ; EI                ;
       sb   a,a                                            ; XOR A             ;
       movb a,@docked                                      ; LD ($E90A),A      ;
       sb   one,a                                          ; DEC A             ;
       movb a,@e940_gate_flag                              ; LD ($E940),A      ; $E940 = $FF
       bl   @switch_to_front_view                          ; CALL $64A1        ; switch to the front view (drawing the cockpit screen)
       movb @b255,a                                        ; LD A,$FF          ;
       movb a,@space_view_showing                          ; LD ($E903),A      ; space view showing...
       movb a,@docked                                      ; LD ($E90A),A      ; ...and docked
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       jeq  title_screen_mission                           ; JR Z,$1C93        ; mission briefing - #R$1C93
       li   hl,options                                     ; LD HL,$E914       ;
       szcb @bit0,*hl                                      ; RES 0,(HL)        ; turn sound effects off (see #R$7468)
       li   hl,title_music                                 ; LD HL,$7AE4       ;
       blwp @music_start_vector                            ; CALL $7603        ; start the music
_1c8b:                                                     ; >1c8b
       bl   @title_screen_letters                          ; CALL $1E01        ; show the spinning "ELITE" letters
       li   hl,title_ships                                 ; LD HL,$1F40       ; HL -> the list of title screen ships
       jmp  _1c96                                          ; JR $1C96          ;
title_screen_mission:                                      ; >1c93
       li   hl,mission_briefing_ship                       ; LD HL,$1F4F       ; HL -> the mission briefing ship
_1c96:                                                     ; >1c96
       movb hl,@title_ship_ptr+1                           ; LD ($E890),HL     ; point at the first ship
       movb @l,@title_ship_ptr                             ;                   ;
       movb @bytes+>71,a                                   ; LD A,$71          ;
       bl   @colour_space_view                             ; CALL $3A4D        ; colour the space view ($71)
title_screen_next_ship:                                    ; >1c9e
       movb @title_ship_ptr+1,hl                           ; LD HL,($E890)     ; HL -> next ship in the list
       movb @title_ship_ptr,@l                             ;                   ;
       movb *hl,a                                          ; LD A,(HL)         ; A = this step's view-type byte
       socb a,a                                            ; OR A              ;
       jeq  _1c8b                                          ; JR Z,$1C8B        ; end of the list - start again with the letters
       movb *hl,a                                          ; LD A,(HL)         ;
       movb a,@ship_type                                   ; LD ($F7E7),A      ; set the object's type
       inc  hl                                             ; INC HL            ;
       movb hl,@title_ship_ptr+1                           ; LD ($E890),HL     ;
       movb @l,@title_ship_ptr                             ;                   ;
       movb one,a                                          ; LD A,$01          ;
       movb a,@title_wobble_target_1                       ; LD ($E886),A      ; wobble targets start at 1
       movb a,@title_wobble_target_2                       ; LD ($E887),A      ;
       movb a,@object_status_byte                          ; LD ($F7CD),A      ;
       li   hl,title_ship_start                            ; LD HL,$1F2E       ; set its position (Z = 2000) and orientation
       li   de,object_position_x                           ; LD DE,$F7CE       ;
       li   bc,>0012                                       ; LD BC,$0012       ;
       .ldir                                               ; LDIR              ;
       bl   @get_blueprint_data                            ; CALL $16E3        ; set the object up for its type (#R$16E3)
       sb   a,a                                            ; XOR A             ;
       movb a,@title_ship_arrived                          ; LD ($E88A),A      ; not arrived yet
       movb a,@title_ship_flying_off                       ; LD ($E88C),A      ; not flying off yet
       movb a,@title_wobble                                ; LD ($E884),A      ; wobble angles start at 0
       movb a,@title_wobble_angle_2                        ; LD ($E885),A      ;
       movb a,@object_status_byte                          ; LD ($F7CD),A      ;
       movb a,@handler_type                                ; LD ($F7EE),A      ;
       movb @bytes+>96,a                                   ; LD A,$96          ;
       movb a,@title_ship_frames                           ; LD ($E88B),A      ; stay for 150 frames
       movb @bp_size,a                                     ; LD A,($F805)      ; A = the ship's size
       movb a,h                                            ; LD H,A            ;
       sb   @l,@l                                          ; LD L,$00          ; HL = A:$00
       srl  h,1                                            ; SRL H             ;
       ; RR L                                              ; RR L              ; HL = HL >> 2 (done by the SRL H above, which shifts all of HL)
       srl  h,1                                            ; SRL H             ;
       ; RR L                                              ; RR L              ; (done by the SRL H above, which shifts all of HL)
       movb @bytes+>2c,a                                   ; LD A,$2C          ;
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = size * 64 / 44
       movb hl,@title_ship_distance+1                      ; LD ($E888),HL     ; the distance to fly in to
       movb @l,@title_ship_distance                        ;                   ;
title_screen_next_frame:                                   ; >1cf4
       bl   @clear_space_view                              ; CALL $388F        ; next frame: clear the space view
       movb @bytes+>d6,a                                   ; LD A,$D6          ;
       movb a,@message_row                                 ; LD ($E92C),A      ; the ship's name at the top of the view
       movb @bp_name,hl                                    ; LD HL,($F7FB)     ;
       movb @bp_name+1,@l                                  ;                   ;
       bl   @show_view_message                             ; CALL $39C8        ; print the ship's name
_1d02:                                                     ; >1d02
       bl   @count_message_timer                           ; CALL $39F1        ;
       movb @bytes+>e4,a                                   ; LD A,$E4          ;
       movb a,@message_row                                 ; LD ($E92C),A      ; the prompt at the bottom
       li   hl,msg_load_new_commander                      ; LD HL,$1ED7       ; HL = "Load New Commander ?"
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       jne  _1d17                                          ; JR NZ,$1D17       ;
       li   hl,msg_hit_key_mission                         ; LD HL,$1EF9       ; mission briefing: "Hit key for mission"
_1d17:                                                     ; >1d17
       bl   @show_view_message                             ; CALL $39C8        ; print it
       bl   @draw_object                                   ; CALL $422E        ; draw the ship
       bl   @copy_space_view                               ; CALL $3846        ; copy the space view to the screen
       movb @title_ship_flying_off,a                       ; LD A,($E88C)      ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_frame                             ; JR Z,$1D3D        ; not flying off
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; else HL = #R$EB9E (cached_range_value)
       li   de,>0005                                       ; LD DE,$0005       ;
       s    de,hl                                          ; SBC HL,DE         ;
       joc  !                                              ; JP C,$1C9E        ; flown out of sight - next ship
       b    @title_screen_next_ship                        ;
!
       mov  @object_position_z,hl                          ; LD HL,($F7D2)     ; else nudge $F7D2 towards +200...
       li   de,>00c8                                       ; LD DE,$00C8       ;
       a    de,hl                                          ; ADD HL,DE         ;
       mov  hl,@object_position_z                          ; LD ($F7D2),HL     ; fly off: Z += 200
       jmp  _1d62                                          ; JR $1D62          ;
title_screen_frame:                                        ; >1d3d
       movb @title_ship_arrived,a                          ; LD A,($E88A)      ; has the ship arrived?
       socb a,a                                            ; OR A              ;
       jne  _1d62                                          ; JR NZ,$1D62       ; yes
       mov  @object_position_z,hl                          ; LD HL,($F7D2)     ; no: move it closer
       li   de,>ff88                                       ; LD DE,$FF88       ;
       a    de,hl                                          ; ADC HL,DE         ;
       mov  hl,@object_position_z                          ; LD ($F7D2),HL     ; 
       movb @title_ship_distance+1,de                      ; LD DE,($E888)     ; DE = distance to stop at
       movb @title_ship_distance,@e                        ;                   ;
       mov  hl,hl                                          ;                   ; test the sign of the new distance (the MOVs above changed the status)
       jgt  !                                              ; JP M,$1D5A        ;
       jeq  !                                              ;                   ; 
       b    @title_screen_ship_arrived                     ;
!
       socb a,a                                            ; OR A              ;
       s    de,hl                                          ; SBC HL,DE         ;
       joc  _1d62                                          ; JR NC,$1D62       ; not there yet
title_screen_ship_arrived:                                 ; >1d5a
       mov  de,@object_position_z                          ; LD ($F7D2),DE     ; there: stop at that distance
       li   hl,title_ship_arrived                          ; LD HL,$E88A       ;
       sb   one,*hl                                        ; DEC (HL)          ; and flag it as arrived
_1d62:                                                     ; >1d62
       li   hl,title_wobble                                ; LD HL,$E884       ;
       li   ix,title_wobble_target_1                       ; LD IX,$E886       ;
       bl   @title_screen_swing                            ; CALL $1DDC        ; swing the first angle
       li   hl,title_wobble_angle_2                        ; LD HL,$E885       ;
       li   ix,title_wobble_target_2                       ; LD IX,$E887       ;
       bl   @title_screen_swing                            ; CALL $1DDC        ; and the second
       movb @title_wobble,a                                ; LD A,($E884)      ;
       sra  a,1                                            ; SRA A             ;
       bl   @pitch_object                                  ; CALL $2365        ; turn the ship
       movb @title_wobble_angle_2,a                        ; LD A,($E885)      ;
       sra  a,1                                            ; SRA A             ;
       bl   @roll_object                                   ; CALL $23D9        ; about both axes
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       jeq  _1d97                                          ; JR Z,$1D97        ; mission briefing - the ship stays
       li   hl,title_ship_frames                           ; LD HL,$E88B       ;
       sb   one,*hl                                        ; DEC (HL)          ;
       jne  _1d97                                          ; JR NZ,$1D97       ;
       sb   one,a                                          ; DEC A             ;
       movb a,@title_ship_flying_off                       ; LD ($E88C),A      ; time's up: start flying off
_1d97:                                                     ; >1d97
       bl   @straighten_orientation                        ; CALL $4503        ; re-orthogonalise the ship's axes
       li   hl,pending_debounced_keypress_byte_status      ; LD HL,$E8F5       ;
       movb *hl,a                                          ; LD A,(HL)         ;
       socb a,a                                            ; OR A              ;
       jeq  _1db2                                          ; JR Z,$1DB2        ; no key pressed
       movb *hl,a                                          ; LD A,(HL)         ;
       sb   *hl,*hl                                        ; LD (HL),$00       ;
       cb   @mission_state,@bytes+>10                      ; LD A,($E93D)      ; (compared after the loads, which change
       ;                                                   ; CP $10            ; the status on the TI)
       jne  !                                              ; RET Z             ; mission briefing: any key returns
       .ret                                                ;
!
       cb   a,@bytes+>59                                   ; CP $59            ;
       jeq  title_screen_key                               ; JR Z,$1DB5        ; Y
       cb   a,@bytes+>4e                                   ; CP $4E            ;
       jeq  title_screen_key                               ; JR Z,$1DB5        ; N
_1db2:                                                     ; >1db2
       b    @title_screen_next_frame                       ; JP $1CF4          ; next frame
title_screen_key:                                          ; >1db5
       .push af                                            ; PUSH AF           ;
       blwp @music_stop_vector                             ; CALL $7438        ; stop the music
       bl   @unpack_commander                              ; CALL $A469        ; set up the commander record
       li   hl,options                                     ; LD HL,$E914       ;
       socb @bit0,*hl                                      ; SET 0,(HL)        ; sound effects on
       sb   a,a                                            ; XOR A             ;
       movb a,@in_witchspace                               ; LD ($EEC1),A      ;
       movb a,@e940_gate_flag                              ; LD ($E940),A      ;
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ;
       movb a,@alert_level                                 ; LD ($E90C),A      ;
       .pop af                                             ; POP AF            ;
       cb   a,@bytes+>59                                   ; CP $59            ;
       jeq  !                                              ; JP NZ,$6276       ; N - the docked screen
       sb   a,a                                            ;                   ; (TI: the title screen jumps to the status page,
       movb a,@current_screen                              ;                   ; in ROM bank 7, which returns to the main loop)
       .far_call code_bank_7_select,status_page            ; JP NZ,$6276       ; N - the docked screen
       b    @main_loop_wait_tick                           ;                   ; 
!
       movb @b255,a                                        ; LD A,$FF          ;
       movb a,@load_new_commander                          ; LD ($E924),A      ;
       .far_call code_bank_7_select,commander_menu         ; JP $A30A          ; Y - load a commander (TI: the menu in ROM bank 7)
       b    @main_loop_wait_tick                           ;                   ; (TI: "5. Exit" shows the status page and returns)

********************************************************************************
* Title screen: swing an angle back and forth
*
* Used by the routine at #R$1C5C.
* .
* Steps the angle at HL by 1 towards its target at IX. On reaching it,
* picks a new random target of 20-35 with the opposite sign, so the angle
* swings back and forth by varying amounts. $1DF3 handles a negative
* target.
*
* I:HL Pointer to the angle
* I:IX Pointer to its target
title_screen_swing:                                        ; >1ddc
       movb *ix,a                                          ; LD A,(IX+$00)     ;
       socb a,a                                            ; OR A              ; the target negative?
       jgt  !                                              ; JP M,$1DF3        ; yes
       jeq  !                                              ;                   ; 
       b    @title_screen_swing_down                       ;
!
       ab   one,*hl                                        ; INC (HL)          ; swing up
       cb   a,*hl                                          ; CP (HL)           ; reached the target?
       jeq  !                                              ; RET NZ            ; no
       rt                                                  ;
!
       .proc
       bl   @random_byte                                   ; CALL $2176        ;
       andi a,>0f00                                        ; AND $0F           ;
       ab   @bytes+>14,a                                   ; ADD A,$14         ;
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ;
       movb a,*ix                                          ; LD (IX+$00),A     ; new target: -(20 to 35)
       .endproc                                            ; RET               ;
title_screen_swing_down:                                   ; >1df3
       sb   one,*hl                                        ; DEC (HL)          ; swing down
       cb   a,*hl                                          ; CP (HL)           ; reached the target?
       jeq  !                                              ; RET NZ            ; no
       rt                                                  ;
!
       .proc
       bl   @random_byte                                   ; CALL $2176        ;
       andi a,>0f00                                        ; AND $0F           ;
       ab   @bytes+>14,a                                   ; ADD A,$14         ;
       movb a,*ix                                          ; LD (IX+$00),A     ; new target: 20 to 35
       .endproc                                            ; RET               ;

********************************************************************************
* Title screen: the spinning "ELITE" letters
*
* Used by the routine at #R$1C5C.
* .
* Clears the object table (#R$28D4), colours the space view ($D1), and
* adds the five letters from #R$1F0C one by one, each at its X position
* with the orientation from #R$1F1E (#R$3037). After each one it runs
* #R$1E5A for 24 frames, in which the newest letter turns one way and
* comes 7 closer per frame, while the ones before it turn the other way
* and move 7 further away. After the fifth, a short pause, then 24 more
* frames of all five turning and moving away. A keypress at any point
* ends the letters. The entry at $1E32, which adds a single object, is
* the target of the unused jump-table entry at $0088 (see #R$003B).
title_screen_letters:                                      ; >1e01
       .proc
       bl   @clear_all_ship_slots                          ; CALL $28D4        ;
       movb @bytes+>d1,a                                   ; LD A,$D1          ;
       bl   @colour_space_view                             ; CALL $3A4D        ; colour the space view
       movb @b255,a                                        ; LD A,$FF          ;
       movb a,@title_letter_being_added                    ; LD ($E892),A      ; a letter is being added
       movb @bytes+>e4,a                                   ; LD A,$E4          ;
       movb a,@message_row                                 ; LD ($E92C),A      ; messages at the bottom of the view
       li   hl,title_letters                               ; LD HL,$1F0C       ; HL -> the letters
       movb @bytes+>05,b                                   ; LD B,$05          ; 5 letters
* This entry point is used by the routine at #R$1E48.
title_screen_add_letter:                                   ; >1e18
       movb *hl,a                                          ; LD A,(HL)         ;
       inc  hl                                             ; INC HL            ;
       movb a,@ship_type                                   ; LD ($F7E7),A      ; set the letter's ship type
       movb *hl,@e                                         ; LD E,(HL)         ;
       inc  hl                                             ; INC HL            ;
       movb *hl,d                                          ; LD D,(HL)         ;
       inc  hl                                             ; INC HL            ;
       mov  de,@object_position_x                          ; LD ($F7CE),DE     ; set its X position
       .push bc                                            ; PUSH BC           ;
       .push hl                                            ; PUSH HL           ;
       li   hl,title_letters_orientation                   ; LD HL,$1F1E       ;
       li   de,object_position_y                           ; LD DE,$F7D0       ;
       li   bc,>0010                                       ; LD BC,$0010       ;
       .ldir                                               ; LDIR              ; set its Y, Z and orientation
spawn_fresh_ship:                                          ; >1e32
       sb   a,a                                            ; XOR A             ;
       movb a,@handler_type                                ; LD ($F7EE),A      ;
       ab   one,a                                          ; INC A             ;
       movb a,@object_status_byte                          ; LD ($F7CD),A      ;
       bl   @add_object                                    ; CALL $3037        ; add it to the object table
       movb hl,@title_letter_slot+1                        ; LD ($E88E),HL     ; remember which slot it's in
       movb @l,@title_letter_slot                          ;                   ;
       bl   @title_screen_letter_frames                    ; CALL $1E5A        ; run 24 frames
       jnc  title_screen_next_letter                       ; JR NC,$1E48       ; no key pressed
       .pop hl                                             ; POP HL            ;
       .pop hl                                             ; POP HL            ;
       .endproc                                            ; RET               ; key pressed - end the letters

********************************************************************************
* Title screen: next letter
*
* Used by the routine at #R$1E01.
* .
* Continues #R$1E01 with the next letter; after the fifth, pauses briefly,
* clears ($E892), and runs 24 more frames (#R$1E5A) with all five letters
* turning and moving away.
title_screen_next_letter:                                  ; >1e48
       .pop hl                                             ; POP HL            ;
       .pop bc                                             ; POP BC            ;
       sb   one,b                                          ; DEC B             ;
       jeq  !                                              ; JP NZ,$1E18       ; next letter
       b    @title_screen_add_letter                       ;
!
       sb   a,a                                            ;                   ; (TI: wait 24 frames, polling for VBlank, instead of
       movb a,@vblank_subtick_counter                      ;                   ; counting BC down to 0 - about as long on the MSX,
_1e4e:                                                     ; >1e4e
       bl   @ti_poll_vblank                                ; DEC BC            ; where the music plays on in the interrupt)
       cb   @vblank_subtick_counter,@bytes+>18             ; LD A,B / OR C     ; 
       jl   _1e4e                                          ; JR NZ,$1E4E       ; a short pause
       sb   a,a                                            ; XOR A             ;
       movb a,@title_letter_being_added                    ; LD ($E892),A      ; no letter being added any more
       b    @title_screen_letter_frames_jmp                ; JP $1E5A          ; 24 more frames

********************************************************************************
* Title screen: run 24 frames of the "ELITE" letters
*
* Used by the routines at #R$1E01 and #R$1E48.
* .
* Each frame clears the space view, and turns and moves each letter: the
* one being added (the slot in ($E88E), while ($E892) is set) turns one way
* (#R$2365, A=$7F) and comes 7 closer; the others ($1E96) turn the other
* way and move 7 away. Then prints "(c)1987 Firebird" and waits for the
* frame to end ($1EB3).
* .
* At $1E96, turns the letter (#R$2365, A=$81), moves it 7 further away,
* draws it (#R$422E) and copies its record back to the object table.
* .
* At $1EB3, prints "(c)1987 Firebird" (#R$1EEB), copies the space view to
* the screen, and waits until 7 VBlanks have passed since the frame
* started. If a key has been pressed, returns (from #R$1E5A) with carry
* set.
* .
* At $1ED0, loops back to #R$1E5C until the 24 frames are done, then
* returns with carry clear.
*
* O:F Carry set if a key was pressed
title_screen_letter_frames:                                ; >1e5a
       .proc
title_screen_letter_frames_jmp:
       movb @bytes+>18,b                                   ; LD B,$18          ; 24 frames
title_screen_letter_slot:                                  ; >1e5c
       .push bc                                            ; PUSH BC           ;
       bl   @clear_space_view                              ; CALL $388F        ; clear the space view
       sb   a,a                                            ; XOR A             ;
       movb a,@vblank_subtick_counter                      ; LD ($F748),A      ; start timing the frame
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; HL -> the object table
_1e67:                                                     ; >1e67
       movb *hl,a                                          ; LD A,(HL)         ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_letter_frame_end                  ; JR Z,$1EB3        ; no more letters - end of the frame
       .push hl                                            ; PUSH HL           ;
       .push hl                                            ; PUSH HL           ;
       li   de,object_status_byte                          ; LD DE,$F7CD       ;
       li   bc,>0028                                       ; LD BC,$0028       ;
       .ldir                                               ; LDIR              ; copy the letter's record to the workspace
       bl   @get_blueprint_data                            ; CALL $16E3        ;
       movb @title_letter_being_added,a                    ; LD A,($E892)      ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_letter_away                       ; JR Z,$1E96        ; no letter being added
       .pop de                                             ; POP DE            ;
       movb @title_letter_slot+1,hl                        ; LD HL,($E88E)     ;
       movb @title_letter_slot,@l                          ;                   ;
       socb a,a                                            ; OR A              ;
       s    de,hl                                          ; SBC HL,DE         ;
       jne  _1e94                                          ; JR NZ,$1E94       ; not the one being added
       movb @bytes+>7f,a                                   ; LD A,$7F          ;
       bl   @pitch_object                                  ; CALL $2365        ; turn it 30 degrees
       movb @object_position_z+1,a                         ; LD A,($F7D2)      ;
       sb   @bytes+>07,a                                   ; SUB $07           ;
       movb a,@object_position_z+1                         ; LD ($F7D2),A      ; and move it 7 closer
_1e94:                                                     ; >1e94
       jmp  _1ea4                                          ; JR $1EA4          ;
title_screen_letter_away:                                  ; >1e96
       .pop de                                             ; POP DE            ;
       movb @bytes+>81,a                                   ; LD A,$81          ;
       bl   @pitch_object                                  ; CALL $2365        ; turn it 30 degrees the other way
       movb @object_position_z+1,a                         ; LD A,($F7D2)      ;
       ab   @bytes+>07,a                                   ; ADD A,$07         ;
       movb a,@object_position_z+1                         ; LD ($F7D2),A      ; and move it 7 away
_1ea4:                                                     ; >1ea4
       bl   @draw_object                                   ; CALL $422E        ; draw it
       .pop de                                             ; POP DE            ;
       li   hl,object_status_byte                          ; LD HL,$F7CD       ;
       li   bc,>0028                                       ; LD BC,$0028       ;
       .ldir                                               ; LDIR              ; copy the record back
       .ex_de_hl                                           ; EX DE,HL          ;
       jmp  _1e67                                          ; JR $1E67          ;
title_screen_letter_frame_end:                             ; >1eb3
       li   hl,msg_copyright_1987_firebird                 ; LD HL,$1EEB       ;
       bl   @show_view_message                             ; CALL $39C8        ; print "(c)1987 Firebird"
       bl   @copy_space_view                               ; CALL $3846        ; copy the space view to the screen
_1ebc:                                                     ; >1ebc
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, interrupts are off)
       movb @vblank_subtick_counter,a                      ; LD A,($F748)      ;
       cb   a,@bytes+>07                                   ; CP $07            ;
       jl   _1ebc                                          ; JR C,$1EBC        ; wait for 7 VBlanks
       movb @pending_debounced_keypress_byte_status,a      ; LD A,($E8F5)      ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_letter_next_frame                 ; JR Z,$1ED0        ; no key
       sb   a,a                                            ; XOR A             ;
       movb a,@pending_debounced_keypress_byte_status      ; LD ($E8F5),A      ; forget the key
       .pop hl                                             ; POP HL            ;
       .retc                                               ; RET               ; return with carry set
title_screen_letter_next_frame:                            ; >1ed0
       .pop bc                                             ; POP BC            ; recover the slot counter
       sb   one,b                                          ; DEC B             ;
       jeq  !                                              ; JP NZ,$1E5C       ; slots remain - render the next one
       b    @title_screen_letter_slot                      ;
!
       socb a,a                                            ; OR A              ; none left - carry clear (no key pressed)
       .retnc                                              ; RET               ;

********************************************************************************
* Title screen "ELITE" letters
*
* 3 bytes per letter, for #R$1E01: the ship type (8, 9, 10, 11 and 8
* again - E, L, I, T, E), then the X position (-30, -15, 0, 15, 30).
       .msxalign >1f0c
title_letters:                                             ; >1f0c
       byte >08,>E2,>FF,>09,>F1,>FF,>0A,>00
       byte >00,>0B,>0F,>00,>08,>1E,>00,>0A
       byte >18,>FC

********************************************************************************
* Title screen letters' starting position and orientation
*
* Copied to $F7D0 for each letter by #R$1E01: Y = 0, Z = 192, then the
* orientation vectors.
       .msxalign >1f1e
* (TI: big-endian words, as in the object workspace at #R$F7CD)
title_letters_orientation:                                 ; >1f1e
       byte >00,>00,>00,>C0,>40,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>40,>00

********************************************************************************
* Title screen ships' starting position and orientation
*
* Copied to $F7CE by #R$1C5C for each ship: X = 0, Y = 0, Z = 2000, then
* the orientation vectors.
       .msxalign >1f2e
* (TI: big-endian words, as in the object workspace at #R$F7CD)
title_ship_start:                                          ; >1f2e
       byte >00,>00,>00,>00,>07,>D0,>C0,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >C0,>00

********************************************************************************
* Title screen ships
*
* The ship types (14, 27, 1, 4, 17, 21, 18, 24, 22, 28, 26, 29, 12, 5)
* of the ships #R$1C5C shows in turn, ending with 0.
       .msxalign >1f40
title_ships:                                               ; >1f40
       byte >0E,>1B,>01,>04,>11,>15,>12,>18
       byte >16,>1C,>1A,>1D,>0C,>05,>00

********************************************************************************
* Mission briefing ship
* 
* The ship type (31) of the ship #R$1C5C shows for a mission briefing,
* ending with 0.
       .msxalign >1f4f
mission_briefing_ship:                                     ; >1f4f
       byte >1F,>00


* Launching (TI: in this bank, as it is run once per launch)

********************************************************************************
* Key '1' when docked: launch
* 
* Used by the routine at #R$4173.
* .
* Reached from #R$4173. Refuses in flight (#R$6393). Places the planet, the
* space station and the sun (#R$8D2A), resets the flight variables
* (#R$707D), and starts the ship rolling with the station (roll rate 4,
* #R$F815, #R$2209). Suppresses the police check on entering the safe zone
* ($EF9C, see #R$1549), since the ship starts in it. Switches to the front
* view (#R$64A1), showing the tunnel rings (#R$E8F6). In mission state $16
* (#R$E93D) moves on to $17, so the Constrictor appears (#R$2B24);
* otherwise goes on to $1868.
* .
* At $1868, during mission 3 (#R$E93D = $3x), resets how far the sun has
* come (#R$E93E), so the supernova's approach starts again on each launch.
launch:                                                    ; >1837
       .proc                                               ;                   ; 
* TI: no CALL $6393 (refuse in flight): #R$4173 only calls this when docked
       bl   @launch_place_planet_station_and_sun           ; CALL $8D2A        ; place the planet, station and sun
       bl   @reset_flight                                  ; CALL $707D        ; reset the flight variables
       seto r0                                             ; LD A,$FF          ; 
       movb r0,@launch_roll                                ; LD ($E929),A      ; the ship starts rolling
       movb r0,@safe_zone_entry_latch                      ; LD ($EF9C),A      ; no police check on entering the safe zone
       movb @bytes+>04,@roll_rate                          ; LD A,$04 / LD ($F815),A; roll rate 4
       bl   @refresh_roll_table                            ; CALL $2209        ; set up the roll
       seto r0                                             ; LD A,$FF          ; 
       movb r0,@show_tunnel                                ; LD ($E8F6),A      ; show the tunnel rings
       bl   @switch_to_front_view                          ; CALL $64A1        ; switch to the front view
       sb   @show_tunnel,@show_tunnel                      ; XOR A / LD ($E8F6),A; 
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>16                                   ; CP $16            ; 
       jne  continue_1837_clear_e93e                       ; JR NZ,$1868       ; not that state
       ab   one,@mission_state                             ; INC A / LD ($E93D),A; advance the state machine
       .endproc                                            ; RET               ; 
continue_1837_clear_e93e:                                  ; >1868
       andi a,>f000                                        ; AND $F0           ; keep the high nibble
       cb   a,@bytes+>30                                   ; CP $30            ; state $30-$3F?
       jne  _1872                                          ; RET NZ            ; no - nothing to do
       sb   @supernova_offset,@supernova_offset            ; SBC HL,HL / LD ($E93E),HL; yes - reset the running total
       sb   @supernova_offset+1,@supernova_offset+1        ;                   ; 
_1872:                                                     ; >1872
       .endproc                                            ; RET               ; 

********************************************************************************
* Key '1': launch, or switch to the front view
* 
* Reached via the key table at #R$419B.
key_handler_1:                                             ; >4173
       movb @docked,a                                      ; LD A,($E90A) / OR A; 
       jeq  _417a                                          ; JP NZ,$1837       ; 
       b    @launch                                        ;                   ; docked - launch
_417a:                                                     ; >417a
       b    @switch_to_front_view                          ; JP $64A1          ; in flight - front view

********************************************************************************
* Reset the flight variables
* 
* Used by the routines at #R$1837 and #R$894D.
* .
* Called on launching (#R$1837) and on arriving in a system (#R$894D).
* Clears the flags and countdowns of the last flight: the station
* destroyed (#R$EFA9), the ECM jammer (#R$EFA8), the cloaking device
* (#R$EF9F), identify (#R$EF9D), shooting at the station ($EF97), the
* Torus jump ($EF8E, #R$E918), the police (#R$E934), the hyperspace
* countdown (#R$E91B, #R$E920), docking (#R$E917), docked (#R$E90A),
* the missile (#R$E910), the laser temperature (#R$F813), the roll and
* pitch (#R$F815, #R$F816), and more. Starts the shuttle, asteroid and
* trader countdowns (#R$EF8F-#R$EF91) at random values from 128 to 255,
* and the pirate countdown (#R$EF9A) at (government + 2) * 256. Sets the
* speed to 22 (#R$F814), the energy to 96 (#R$F817) and the shields to
* 24 (#R$F80F, #R$F810), and scatters new stardust (#R$6882).
reset_flight:                                              ; >707d
       .proc                                               ;                   ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@station_destroyed                           ; LD ($EFA9),A      ; the station is back
       movb a,@jammer_active_flag                          ; LD ($EFA8),A      ; ECM jammer off
       movb a,@cloaking_active_flag                        ; LD ($EF9F),A      ; cloaking device off
       movb a,@identify_target                             ; LD ($EF9D),A      ; 
       movb a,@legal_status_copy                           ; LD ($EF97),A      ; the player hasn't shot at the station
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ; 
       movb a,@police_to_launch                            ; LD ($E934),A      ; no police to launch
       movb a,@message_timer                               ; LD ($E919),A      ; 
       movb a,@jump_in_progress                            ; LD ($E722),A      ; 
       movb a,@torus_jump_countdown                        ; LD ($E918),A      ; 
       movb a,@hyperspace_countdown_inner                  ; LD ($E91B),A      ; no hyperspace countdown
       movb a,@unused_flag_e91f                            ; LD ($E91F),A      ; 
       movb a,@hyperspace_trigger                          ; LD ($E920),A      ; 
       movb a,@docking                                     ; LD ($E917),A      ; not docking
       movb a,@docked                                      ; LD ($E90A),A      ; not docked
       movb a,@missile_state                               ; LD ($E910),A      ; missile unarmed
       movb a,@laser_temp_gauge                            ; LD ($F813),A      ; laser cool
       movb a,@roll_rate                                   ; LD ($F815),A      ; roll rate = 0
       movb a,@pitch_rate                                  ; LD ($F816),A      ; pitch rate = 0
       movb a,@launch_roll                                 ; LD ($E929),A      ; not rolling after launching
       movb a,@safe_zone_entry_latch                       ; LD ($EF9C),A      ; 
       li   de,shuttle_countdown                           ; LD DE,$EF8F       ; the shuttle, asteroid and trader countdowns
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 bytes
_70c2:                                                     ; >70c2
       bl   @random_byte                                   ; CALL $2176        ; 
       socb @bytes+>80,a                                   ; OR $80            ; 128-255
       movb a,*de+                                         ; LD (DE),A / INC DE; 
       sb   one,b                                          ; DJNZ $70C2        ; 
       jne  _70c2                                          ;                   ; 
       movb @current_system_government,a                   ; LD A,($F762)      ; A = government
       ab   @bytes+>02,a                                   ; ADD A,$02         ; 
       movb a,@pirate_countdown_hi                         ; LD ($EF9B),A      ; the pirate countdown
       movb @bytes+>16,@speed_gauge_value                  ; LD A,$16 / LD ($F814),A; speed 22
       movb @bytes+>60,@energy_gauge                       ; LD A,$60 / LD ($F817),A; energy 96
       movb @bytes+>18,a                                   ; LD A,$18          ; 
       movb a,@fore_shield                                 ; LD ($F80F),A      ; shields 24
       movb a,@aft_shield                                  ; LD ($F810),A      ; 
       .pop r11                                            ;                   ; 
       b    @scatter_stardust                              ; JP $6882          ; scatter the stardust

********************************************************************************
* Launch from the station: place the planet, station and sun
* 
* Used by the routine at #R$1837.
* .
* Called when launching (#R$1837). Clears the object table (#R$28D4) and
* adds (#R$3037), at speed 0 and with handler types 0, 2 and 0:
* .
* #LIST
* { the planet (ship type $64) in slot 0, 7000 straight ahead }
* { the space station (ship type 1) in slot 1, 500 behind the player, 7500
* from the planet as on arriving in a system (#R$8CB1), facing forward
* (#R$9080), so the player has just come out of its slot }
* { the sun (ship type $65) in slot 2, 24500 away, somewhere beside, above
* or below the player (#R$8F25 with carry clear) }
* LIST#
* .
* The planet and sun can't be shot and don't collide (status $0D, see
* #R$F7CD); the station can (status 1).
launch_place_planet_station_and_sun:                       ; >8d2a
       .proc                                               ;                   ; 
       bl   @clear_all_ship_slots                          ; CALL $28D4        ; clear the object table
       movb @bytes+>0d,@object_status_byte                 ; LD A,$0D / LD ($F7CD),A; status: in use, can't be shot, no collisions
       clr  @object_position_x                             ; LD HL,$0000 / LD ($F7CE),HL; x = 0, y = 0...
       clr  @object_position_y                             ; LD ($F7D0),HL     ; 
       li   r0,7000                                        ; LD HL,$1B58       ; ...z = 7000: straight ahead
       mov  r0,@object_position_z                          ; LD ($F7D2),HL     ; 
       sb   @handler_type,@handler_type                    ; LD A,$00 / LD ($F7EE),A; handler type 0
       movb @bytes+>64,@ship_type                          ; LD A,$64 / LD ($F7E7),A; ship type $64: the planet
       sb   @object_speed,@object_speed                    ; XOR A / LD ($F7E6),A; speed 0
       bl   @add_object                                    ; CALL $3037        ; add the planet (slot 0)
       movb one,@object_status_byte                        ; LD A,$01 / LD ($F7CD),A; status: in use
       li   r0,-500                                        ; LD HL,$FE0C       ; z = -500: just behind the player
       mov  r0,@object_position_z                          ; LD ($F7D2),HL     ; 
       li   hl,station_launch_orientation                  ; LD HL,$9080       ; the station's orientation at launch...
       li   de,side_vector                                 ; LD DE,$F7D4       ; ...into its side and nose vectors
       li   bc,>000c                                       ; LD BC,$000C       ; 
       .ldir                                               ; LDIR              ; 
       movb one,@ship_type                                 ; LD A,$01 / LD ($F7E7),A; ship type 1: the station
       movb @bytes+>02,@handler_type                       ; LD A,$02 / LD ($F7EE),A; handler type 2: space station
       bl   @add_object                                    ; CALL $3037        ; add the station (slot 1)
       movb @bytes+>0d,@object_status_byte                 ; LD A,$0D / LD ($F7CD),A; status: in use, can't be shot, no collisions
       li   hl,>5fb4                                       ; LD HL,$5FB4       ; 24500 away...
       bl   @random_point_beside                           ; OR A / CALL $8F25 ; ...beside, above or below the player
       sb   @handler_type,@handler_type                    ; LD A,$00 / LD ($F7EE),A; handler type 0
       movb @bytes+>65,@ship_type                          ; LD A,$65 / LD ($F7E7),A; ship type $65: the sun
       .pop r11                                            ;                   ; 
       b    @add_object                                    ; JP $3037          ; add the sun (slot 2)

********************************************************************************
* Pick a random point at a given distance
* 
* Used by the routines at #R$2B05, #R$2C3C, #R$2D3B, #R$8C94 and #R$8D2A.
* .
* Sets the object's position (#R$F7CE, #R$F7D0, #R$F7D2) to a point at
* distance r from the player, in a direction given by two angles in degrees
* (0-360): a1 (the longitude) and a2 (the latitude), with x = r * cos(a1) *
* cos(a2), y = r * sin(a2) and z = r * sin(a1) * cos(a2) (#R$8FBB,
* #R$8F94). With carry set both angles are random, so the point is anywhere
* around the player (for ships, asteroids, the planet and the station,
* #R$2B24, #R$2C3C, #R$2D3B, #R$8C94, #R$8CB1). With carry clear a1 is 0,
* so the point is on the circle z = 0, beside, above or below the player
* (for the sun on launching, #R$8D2A).
* .
* At $8F3C, sets a1 to 0; at $8F3F, picks a random a2 (0-360) and works out
* the point.
* 
* I:HL Distance (r)
* I:F Carry set for any direction
* TI: two entry points rather than the carry: random_point for any direction,
* random_point_beside (at $8F3C) for a1 = 0. The distance is kept on the
* stack rather than at $E600.
random_point:                                              ; >8f25
       .proc                                               ;                   ; 
       .push hl                                            ; LD ($E600),HL     ; r
       bl   @random_angle                                  ; CALL $2176 ...    ; DE = a1
       jmp  _8f3f                                          ; JR $8F3F          ; 
random_point_beside:                                       ; >8f3c
       .proc                                               ;                   ; 
       .push hl                                            ; LD ($E600),HL     ; r
       clr  de                                             ; LD DE,$0000       ; a1 = 0
_8f3f:                                                     ; >8f3f
       bl   @sin_cos                                       ; CALL $8FBB        ; A = sin(a1), B = cos(a1)
       movb a,@circle_connector_no_prev_point_gate         ; LD ($E602),A      ; 
       movb b,@lineplot_scratch_vars_e603                  ; LD A,E / LD ($E603),A; 
       bl   @random_angle                                  ; CALL $2176 ...    ; DE = a2
       bl   @sin_cos                                       ; CALL $8FBB        ; A = sin(a2), B = cos(a2)
       movb a,@scratch_buffer_4                            ; LD ($E604),A      ; 
       movb b,@scratch_buffer_5                            ; LD A,E / LD ($E605),A; 
       mov  @-2(sp),hl                                     ; LD HL,($E600)     ; HL = r
       movb @lineplot_scratch_vars_e603,a                  ; LD A,($E603)      ; A = cos(a1)
       bl   @multiply_by_sine                              ; CALL $8F94        ; r * cos(a1)
       movb @scratch_buffer_5,a                            ; LD A,($E605)      ; A = cos(a2)
       bl   @multiply_by_sine                              ; CALL $8F94        ; * cos(a2)
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; x
       mov  @-2(sp),hl                                     ; LD HL,($E600)     ; HL = r
       movb @scratch_buffer_4,a                            ; LD A,($E604)      ; A = sin(a2)
       bl   @multiply_by_sine                              ; CALL $8F94        ; r * sin(a2)
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; y
       mov  @-2(sp),hl                                     ; LD HL,($E600)     ; HL = r
       movb @circle_connector_no_prev_point_gate,a         ; LD A,($E602)      ; A = sin(a1)
       bl   @multiply_by_sine                              ; CALL $8F94        ; r * sin(a1)
       movb @scratch_buffer_5,a                            ; LD A,($E605)      ; A = cos(a2)
       bl   @multiply_by_sine                              ; CALL $8F94        ; * cos(a2)
       mov  hl,@object_position_z                          ; LD ($F7D2),HL     ; z
       dect sp                                             ;                   ; drop r
       .endproc                                            ; RET               ; 
* TI: pick a random angle, 0-360 degrees (#R$8F25, at $8F2A and $8F49)
*
* O:DE The angle
random_angle:                                              
       .proc                                               ;                   ; 
random_angle_1:                                            
       bl   @random_byte                                   ; CALL $2176        ; 
       movb a,r2                                           ; LD E,A            ; 
       bl   @random_byte                                   ; CALL $2176        ; A = another random byte
       swpb r2                                             ;                   ; 
       andi a,>0100                                        ; AND $01           ; 
       movb a,r2                                           ; LD D,A            ; a random 0-511
       ci   r2,361                                         ; LD HL,$FE97 / ADD HL,DE; 
       jhe  random_angle_1                                 ; JR C,$8F2A        ; over 360 - try again
       mov  r2,de                                          ;                   ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Multiply by a sine or cosine
* 
* Used by the routine at #R$8F25.
* .
* Returns HL * A / 128, with A a sine or cosine from #R$8FBB (1.0 = 127,
* so this is very slightly short). Both are two's complement; the result
* is truncated.
* 
* I:A Sine or cosine
* I:HL Value
* O:HL The product
multiply_by_sine:                                          ; >8f94
       clr  r0                                             ; LD C,A            ; 
       movb a,r0                                           ;                   ; 
       sra  r0,8                                           ;                   ; R0 = the sine
       mov  hl,a                                           ; XOR H / EX AF,AF' ; A bit 15 = the product's sign
       xor  r0,a                                           ;                   ; 
       abs  r0                                             ; NEG               ; the size of the sine
       mov  hl,r1                                          ;                   ; 
       abs  r1                                             ; XOR A / SUB L ... ; the size of HL
       mpy  r0,r1                                          ; CALL $1F86        ; R1:R2 = the product
       sla  r1,9                                           ; RL L / RL H / RLA ; HL = the product >> 7
       srl  r2,7                                           ; LD L,H / LD H,A   ; 
       soc  r2,r1                                          ;                   ; 
       mov  r1,hl                                          ;                   ; 
       mov  a,a                                            ; EX AF,AF'         ; the product's sign
       jlt  multiply_by_sine_negative                      ; RET P             ; positive - done
       rt                                                  ;                   ; 
multiply_by_sine_negative:                                 
       neg  hl                                             ; XOR A / SUB L ... ; negate it
       rt                                                  ; RET               ; 

********************************************************************************
* Get the sine and cosine of an angle
* 
* Used by the routine at #R$8F25.
* .
* Works out which quadrant the angle is in, and gets the sine and cosine
* from the sine table (#R$901C) using these identities:
* .
* #LIST
* { 0-90 degrees: sin(x), and cos(x) = sin(90 - x) }
* { 91-180 (at $8FCE): sin(x) = sin(180 - x), and cos(x) = -sin(x - 90) }
* { 181-270 (at $8FE5): sin(x) = -sin(x - 180), and cos(x) = -sin(270 - x) }
* { 271-360 (at $9004): sin(x) = -sin(360 - x), and cos(x) = sin(x - 270) }
* LIST#
* .
* Each part saves the sine in A' while it works out the cosine; the exit
* at $9019 returns them. The results are 127 times the sine and cosine,
* in two's complement.
* 
* I:DE Angle in degrees (0-360)
* O:A Sine
* O:E Cosine
* TI: returns the cosine in B, not E.
sin_cos:                                                   ; >8fbb
       mov  de,r1                                          ;                   ; 
       ci   r1,91                                          ; LD HL,$FFA5 / ADD HL,DE; 
       jhe  _8fce                                          ; JR C,$8FCE        ; 91 or more
       movb @sine_table(r1),a                              ; LD A,E / CALL $901C; A = sin(x)
       li   r2,90                                          ; LD A,$5A          ; 
       s    r1,r2                                          ; SUB E             ; 90 - x
       movb @sine_table(r2),b                              ; CALL $901C        ; B = sin(90 - x) = cos(x)
       rt                                                  ; RET               ; 
_8fce:                                                     ; >8fce
       ci   r1,181                                         ; LD HL,$FF4B / ADD HL,DE; 
       jhe  _8fe5                                          ; JR C,$8FE5        ; 181 or more
       li   r2,180                                         ; LD A,$B4          ; 
       s    r1,r2                                          ; SUB E             ; 180 - x
       movb @sine_table(r2),a                              ; CALL $901C        ; A = sin(180 - x) = sin(x)
       clr  r0                                             ;                   ; 
       movb @sine_table-90(r1),r0                          ; LD A,E / SUB $5A / CALL $901C; sin(x - 90)
       neg  r0                                             ; NEG               ; 
       movb r0,b                                           ;                   ; B = -sin(x - 90) = cos(x)
       rt                                                  ; RET               ; 
_8fe5:                                                     ; >8fe5
       ci   r1,271                                         ; LD HL,$FEF1 / ADD HL,DE; 
       jhe  _9004                                          ; JR C,$9004        ; 271 or more
       clr  r0                                             ;                   ; 
       movb @sine_table-180(r1),r0                         ; LD HL,$FF4C / ADD HL,DE / LD A,L / CALL $901C; sin(x - 180)
       neg  r0                                             ; NEG               ; 
       movb r0,a                                           ;                   ; A = -sin(x - 180) = sin(x)
       li   r2,270                                         ; LD HL,$010E       ; 
       s    r1,r2                                          ; OR A / SBC HL,DE  ; 270 - x
       clr  r0                                             ;                   ; 
       movb @sine_table(r2),r0                             ; CALL $901C        ; sin(270 - x)
       neg  r0                                             ; NEG               ; 
       movb r0,b                                           ;                   ; B = -sin(270 - x) = cos(x)
       rt                                                  ; RET               ; 
_9004:                                                     ; >9004
       li   r2,360                                         ; LD HL,$0168       ; 
       s    r1,r2                                          ; OR A / SBC HL,DE  ; 360 - x
       clr  r0                                             ;                   ; 
       movb @sine_table(r2),r0                             ; CALL $901C        ; sin(360 - x)
       neg  r0                                             ; NEG               ; 
       movb r0,a                                           ;                   ; A = -sin(360 - x) = sin(x)
       movb @sine_table-270(r1),b                          ; LD HL,$FEF2 / ADD HL,DE / LD A,L / CALL $901C; B = sin(x - 270) = cos(x)
       rt                                                  ; RET               ; 

********************************************************************************
* Sine table
* 
* sin(n) * 127 for n = 0-90 degrees (#R$901C).
sine_table:                                                ; >9025
       byte >00,>02,>04,>07,>09,>0B,>0D,>0F                       ; 
       byte >12,>14,>16,>18,>1A,>1D,>1F,>21                       ; 
       byte >23,>25,>27,>29,>2B,>2E,>30,>32                       ; 
       byte >34,>36,>38,>3A,>3C,>3E,>40,>41                       ; 
       byte >43,>45,>47,>49,>4B,>4C,>4E,>50                       ; 
       byte >52,>53,>55,>57,>58,>5A,>5B,>5D                       ; 
       byte >5E,>60,>61,>63,>64,>65,>67,>68                       ; 
       byte >69,>6B,>6C,>6D,>6E,>6F,>70,>71                       ; 
       byte >72,>73,>74,>75,>76,>77,>77,>78                       ; 
       byte >79,>79,>7A,>7B,>7B,>7C,>7C,>7D                       ; 
       byte >7D,>7D,>7E,>7E,>7E,>7F,>7F,>7F                       ; 
       byte >7F,>7F,>7F                                           ; 

********************************************************************************
* The space station's orientation at launch
* 
* Copied into the station's side and nose vectors by #R$8D2A: side (1, 0,
* 0) and nose (0, 0, 1), so its slot faces forward.
* (TI: big-endian words, as in the object workspace at #R$F7CD)
station_launch_orientation:                                ; >9080
       byte >40,>00,>00,>00,>00,>00                               ; side vector
       byte >00,>00,>00,>00,>40,>00                               ; nose vector


rom_bank_10_end:
       equ  $
       bss  >8000-$
