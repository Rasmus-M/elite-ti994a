ship_asp_mkii_name:                                        ; >ac65
       text 'Asp MkI',>c9

* Asp MkII: vertex array (6 bytes/vertex)
ship_asp_mkii_vertices:                                    ; >ac6d
       byte >FF,>FF,>AE,>50,>FF,>FF,>FF,>FF
       byte >AE,>4C,>F8,>55,>B4,>15,>FF,>FF
       byte >F8,>55,>6F,>18,>57,>46,>FF,>FF
