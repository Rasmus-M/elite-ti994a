* ROM bank 14: the math tables, and code: the sound effects and the disk operations
* Assembled for real by code-bank-14.a99, and DORG in the other builds for its labels
       .ifdef code_bank_14
       aorg >6000
       .else
       dorg >6000
       .endif
       bss  >40
       .ifdef code_bank_14
       bcopy "../../bin/math-tables.bin" ; the math tables, as in the other banks
       .else
       bss  math_tables_end-math_tables
       .endif

* The sound effects (TI-specific: a native SN76489 player)
*
* The MSX plays its sound effects on the AY-3-8910 with a script
* interpreter (#R$753F) and a per-frame handler for each effect (#R$7645).
* This is a native player for the TI's SN76489 that does the same: the
* effects (#R$7AC6), their handlers and their numbers are the MSX's, as are
* the three channels and taking over a busy channel in rotation (#R$74AE).
*
* The routines here run in their own workspace (pad_ws), called through
* the BLWP vectors in RAM (lower-memory.a99), which select this bank:
* sound_effect_vector (the .sfx macro: the effect number follows the BLWP),
* sound_tick_vector (once per MSX frame, from ti_poll_vblank) and
* sound_stop_vector. So they change none of the caller's registers or its
* status.
*
* The differences from the MSX:
* - A tone period is the same on both chips, but the SN76489's has 10 bits:
*   longer periods are played as 1023, and period 0 is silent.
* - The AY's envelopes (the click, the laser and hyperspace) are played at a
*   fixed volume.
* - The SN76489 has one noise channel with three rates rather than noise on
*   each channel with 32: a channel with its noise on sets the noise's
*   volume, and the noise period picks the nearest rate.
* - The ECM sound (effect 8) lasts as long as the ECM (#R$E912), which
*   ti_poll_vblank counts down, rather than counting it down itself.
*
* The three channel records are at #R$E894 (the MSX's sound variables,
* which nothing else uses on the TI), 16 bytes each:
sfx_active:                            ; >FF while the channel is playing
       equ  0
sfx_noise:                             ; Nonzero if its noise is on
       equ  1
sfx_handler:                           ; Its per-frame handler (#R$E899)
       equ  2
sfx_count:                             ; Its countdown (#R$E897)
       equ  4
sfx_volume:                            ; Its volume, 0-15 (#R$E898)
       equ  5
sfx_param:                             ; Its parameter (#R$E89B)
       equ  6
sfx_param2:                            ; Its second parameter (#R$E89E)
       equ  7
sfx_flag:                              ; The address of its "playing" flag, or 0 (#R$E89C)
       equ  8
sfx_period:                            ; Its tone period (#R$E89F)
       equ  10
sfx_tone:                              ; The SN76489 command for its tone generator
       equ  12
sfx_counter:                           ; A counter (where the MSX uses #R$E89F as one)
       equ  14
sfx_size:
       equ  16
sfx_channels:
       equ  sound_channel_active
sfx_noise_rate:                        ; The noise rate written last (#R$E8D6)
       equ  sound_mode
sfx_seed:                              ; The random number of the explosion (#R$E8D0)
       equ  tune_address

*********************************************************************
*
* Start a sound effect (#R$7468)
*
* Claims a channel (#R$74AE): a free one, or else one of the busy ones in
* rotation (#R$E8D5), ending its effect. Then sets the channel up from the
* effect's entry in sfx_effects.
*
* I:R4 Effect number (0-13)
*
sfx_start:
       mov  r11,r10
       ci   r4,13
       jh   sfx_start_3
       ci   r4,7                       ; The tunnel rings (#R$77EE)?
       jne  sfx_start_0
       sb   @tunnel_rings_finished,@tunnel_rings_finished ; They aren't finished yet (#R$E923)
sfx_start_0:
       li   r9,sfx_channels
       li   r2,3
sfx_start_1:
       movb *r9,r0
       jeq  sfx_start_2                ; A free channel
       ai   r9,sfx_size
       dec  r2
       jne  sfx_start_1
       clr  r1                         ; All busy: take the next one in rotation
       movb @sound_channel_rotation,r1
       swpb r1
       mov  r1,r9
       sla  r9,4
       ai   r9,sfx_channels
       dec  r1                         ; The counter goes 2, 1, 0, 2...
       jgt  !
       jeq  !
       li   r1,2
!      swpb r1
       movb r1,@sound_channel_rotation
       bl   @sfx_end                   ; End the effect it was playing
sfx_start_2:
       mov  r9,r0                      ; The channel's tone generator: >80, >A0 or >C0
       ai   r0,-sfx_channels
       sla  r0,1
       ai   r0,>0080
       swpb r0
       movb r0,@sfx_tone(r9)
       sla  r4,2                       ; R1 -> the effect's entry (12 bytes each)
       mov  r4,r1
       sla  r4,1
       a    r4,r1
       ai   r1,sfx_effects
       li   r0,>ff00
       movb r0,@sfx_active(r9)
       mov  *r1+,@sfx_handler(r9)
       mov  *r1+,r2
       mov  r2,@sfx_flag(r9)
       jeq  !
       movb r0,*r2                     ; Set its "playing" flag
!      mov  *r1+,r2
       mov  r2,@sfx_period(r9)
       mov  r2,@sfx_counter(r9)
       mov  *r1+,@sfx_count(r9)        ; The countdown and the volume
       mov  *r1+,@sfx_param(r9)        ; The two parameters
       movb *r1,@sfx_noise(r9)
       bl   @sfx_update
sfx_start_3:
       b    *r10
*// sfx_start

*********************************************************************
*
* Play one tick of the sound effects (#R$7645)
*
* Runs the per-frame handler of each channel that is playing, then writes
* the channel's tone period and volume to the sound chip.
*
sfx_tick:
       mov  r11,r10
       li   r9,sfx_channels
       li   r7,3
sfx_tick_1:
       movb @sfx_active(r9),r0
       jeq  sfx_tick_2
       mov  @sfx_handler(r9),r1
       bl   *r1
       movb @sfx_active(r9),r0
       jeq  sfx_tick_2                 ; The effect has ended
       bl   @sfx_update
sfx_tick_2:
       ai   r9,sfx_size
       dec  r7
       jne  sfx_tick_1
       b    *r10
*// sfx_tick

*********************************************************************
*
* Stop all sound effects (#R$7438)
*
sfx_stop:
       mov  r11,r10
       li   r9,sfx_channels
       li   r7,3
sfx_stop_1:
       movb @sfx_active(r9),r0
       jeq  sfx_stop_2
       bl   @sfx_end
sfx_stop_2:
       ai   r9,sfx_size
       dec  r7
       jne  sfx_stop_1
       b    *r10
*// sfx_stop

*********************************************************************
*
* End a channel's sound effect (#R$740C)
*
* Turns its tone and its noise off, clears its "playing" flag and marks
* the channel as free.
*
* I:R9 The channel
*
sfx_end:
       movb @sfx_noise(r9),r0
       jeq  sfx_end_1
       li   r0,>ff00                   ; Noise off
       movb r0,@sound
       sb   @sfx_noise(r9),@sfx_noise(r9)
sfx_end_1:
       mov  @sfx_flag(r9),r1
       jeq  sfx_end_2
       sb   *r1,*r1                    ; Clear the "playing" flag
       clr  @sfx_flag(r9)
sfx_end_2:
       sb   @sfx_active(r9),@sfx_active(r9)
       movb @sfx_tone(r9),r0           ; Tone off
       ori  r0,>1f00
       movb r0,@sound
       rt
*// sfx_end

*********************************************************************
*
* Write a channel's tone period and volume to the sound chip
* (#R$74F6, #R$74EC)
*
* The tone is silent if its period is 0, or over 1023 with the noise on;
* otherwise a period over 1023 is played as 1023. A volume over 15 (16 on
* the MSX: use the envelope) is played as 13. With the noise on, the noise
* gets the same volume.
*
* I:R9 The channel
*
sfx_update:
       mov  @sfx_period(r9),r0
       movb @sfx_tone(r9),r3
       clr  r2
       movb @sfx_volume(r9),r2
       swpb r2
       ci   r2,15
       jle  sfx_update_1
       li   r2,13
sfx_update_1:
       mov  r0,r0
       jeq  sfx_update_3
       ci   r0,1023
       jle  sfx_update_2
       movb @sfx_noise(r9),r1
       jne  sfx_update_3
       li   r0,1023
sfx_update_2:
       mov  r0,r1                      ; The period's low 4 bits, then its high 6
       andi r1,>000f
       swpb r1
       socb r3,r1
       movb r1,@sound
       sla  r0,4
       movb r0,@sound
       li   r1,15                      ; The attenuation: 15 - the volume
       s    r2,r1
       jmp  sfx_update_4
sfx_update_3:
       li   r1,15                      ; Silent
sfx_update_4:
       swpb r1
       socb r3,r1
       ori  r1,>1000
       movb r1,@sound
       movb @sfx_noise(r9),r1
       jeq  sfx_update_5
       li   r1,15
       s    r2,r1
       swpb r1
       ori  r1,>f000
       movb r1,@sound
sfx_update_5:
       rt
*// sfx_update

*********************************************************************
*
* Set the noise period (PSG register 6 on the MSX)
*
* Picks the nearest of the SN76489's three white noise rates, and writes it
* only when it changes, as writing it restarts the noise.
*
* I:R0 The noise period (in the high byte; its low 5 bits are used)
*
sfx_set_noise:
       andi r0,>1f00
       li   r1,>e400                   ; 0-7: the highest rate
       ci   r0,>0800
       jl   sfx_set_noise_1
       li   r1,>e500                   ; 8-15
       ci   r0,>1000
       jl   sfx_set_noise_1
       li   r1,>e600                   ; 16-31: the lowest
sfx_set_noise_1:
       cb   r1,@sfx_noise_rate
       jeq  sfx_set_noise_2
       movb r1,@sfx_noise_rate
       movb r1,@sound
sfx_set_noise_2:
       rt
*// sfx_set_noise

*********************************************************************
*
* The sound effects (#R$7AC6)
*
* For each effect: its per-frame handler, the address of its "playing"
* flag (or 0), its tone period, its countdown and volume, its two
* parameters, and whether its noise is on - from the MSX's scripts
* (#R$770B-#R$7977). Volume 16 is the MSX's "use the envelope".
*
sfx_effects:
       data sfx_h_count,0,100          ; 0: click (#R$770B)
       byte 2,16,0,0,0,0
       data sfx_h_count,0,50           ; 1: beep (#R$771E)
       byte 10,12,0,0,0,0
       data sfx_h_explosion,0,0        ; 2: explosion (#R$772F)
       byte 20,15,0,0,>ff,0
       data sfx_h_laser,0,15           ; 3: laser (#R$7758)
       byte 17,16,0,0,0,0
       data sfx_h_hit,sound_effect_4_playing,0 ; 4: shields hit, energy drained (#R$777E)
       byte 0,13,0,0,>ff,0
       data sfx_h_alarm,alarm_playing,300 ; 5: alarm (#R$77A2)
       byte 0,9,0,0,0,0
       data sfx_h_beep,0,512           ; 6: beep when something is refused (#R$77CA)
       byte 131,12,0,0,0,0
       data sfx_h_tunnel,0,0           ; 7: tunnel rings (#R$77EE)
       byte 0,0,0,0,0,0
       data sfx_h_ecm,0,100            ; 8: ECM (#R$7815)
       byte 0,12,20,0,0,0
       data sfx_h_incoming,0,0         ; 9: incoming missile (#R$7872)
       byte 31,14,0,0,>ff,0
       data sfx_h_torus,0,18           ; 10: Torus Jump Drive (#R$7892)
       byte 6,0,2,10,0,0
       data sfx_h_launch,0,0           ; 11: launch (#R$78ED)
       byte 30,15,15,0,>ff,0
       data sfx_h_hyperspace,0,170     ; 12: hyperspace (#R$7926)
       byte 85,16,38,0,0,0
       data sfx_h_scoop,0,80           ; 13: cargo scooped (#R$7977)
       byte 15,12,2,0,0,0

*********************************************************************
*
* The effects' per-frame handlers
*
* I:R9 The channel
*
* Effects 0 and 1 (#R$74A6): end when the countdown runs out.
sfx_h_count:
       sb   @bytes+1,@sfx_count(r9)
       jeq  sfx_h_end
       rt
sfx_h_end:
       b    @sfx_end

* Effect 2, the explosion (#R$773E): a random noise period each frame;
* every 20 frames the volume goes down by one, ending at 0.
sfx_h_explosion:
       mov  r11,r8
       mov  @sfx_seed,r0               ; A random number (the R register on the MSX)
       sla  r0,2
       a    @sfx_seed,r0
       inc  r0
       mov  r0,@sfx_seed
       bl   @sfx_set_noise
       mov  r8,r11
       sb   @bytes+1,@sfx_count(r9)
       jne  sfx_h_explosion_1
       movb @bytes+20,@sfx_count(r9)
       sb   @bytes+1,@sfx_volume(r9)
       jeq  sfx_h_end
sfx_h_explosion_1:
       rt

* Effect 3, the laser (#R$776B): the tone period goes up by 2 each frame.
sfx_h_laser:
       inct @sfx_period(r9)
       sb   @bytes+1,@sfx_count(r9)
       jeq  sfx_h_end
       rt

* Effect 4 (#R$7791): the noise period goes up by one each frame, to 25.
sfx_h_hit:
       mov  r11,r8
       movb @sfx_param2(r9),r0
       bl   @sfx_set_noise
       mov  r8,r11
       ab   @bytes+1,@sfx_param2(r9)
       cb   @sfx_param2(r9),@bytes+25
       jeq  sfx_h_end
       rt

* Effect 5, the alarm (#R$77B4): the tone period goes down by 10 each
* frame, ending below 150.
sfx_h_alarm:
       mov  @sfx_period(r9),r0
       ai   r0,-10
       mov  r0,@sfx_period(r9)
       ci   r0,150
       jl   sfx_h_end
       rt

* Effect 6, the beep (#R$77DB): three frames at tone period 512, then
* three at 768 (when the countdown goes from >80 to >7F).
sfx_h_beep:
       sb   @bytes+1,@sfx_count(r9)
       jno  sfx_h_beep_1
       movb @bytes+3,@sfx_count(r9)
       li   r0,>0300
       mov  r0,@sfx_period(r9)
       rt
sfx_h_beep_1:
       jeq  sfx_h_end
       rt

* Effect 7, the tunnel rings (#R$77FB): follows the ring being drawn
* (#R$E921): volume = radius / 8, tone period = radius + 50, until the
* rings have finished (#R$E923).
sfx_h_tunnel:
       movb @tunnel_rings_finished,r0
       jne  sfx_h_end
       clr  r0
       movb @tunnel_ring_radius+1,r0
       swpb r0
       clr  r1
       movb @tunnel_ring_radius,r1
       a    r0,r1
       ai   r1,50
       mov  r1,@sfx_period(r9)
       srl  r0,3
       andi r0,>000f
       swpb r0
       movb r0,@sfx_volume(r9)
       rt

* Effect 8, the ECM (#R$782B): sweeps the tone period up by 50 a frame to
* 200, then down to under 100, and so on, while the ECM is on (#R$E912).
sfx_h_ecm:
       movb @ecm_countdown,r0
       jgt  sfx_h_ecm_1
       jmp  sfx_h_end_2
sfx_h_ecm_1:
       mov  @sfx_period(r9),r0
       movb @sfx_param(r9),r1
       jlt  sfx_h_ecm_2
       ai   r0,50                      ; Going up
       mov  r0,@sfx_period(r9)
       ci   r0,200
       jl   sfx_h_ecm_3
       socb @bit7,@sfx_param(r9)
       rt
sfx_h_ecm_2:
       ai   r0,-50                     ; Going down
       mov  r0,@sfx_period(r9)
       ci   r0,100
       jhe  sfx_h_ecm_3
       szcb @bit7,@sfx_param(r9)
sfx_h_ecm_3:
       rt

* Effect 9 (#R$7881): the noise period is the countdown, which goes down
* by 4 each frame until it would go below 0.
sfx_h_incoming:
       sb   @bytes+4,@sfx_count(r9)
       joc  sfx_h_incoming_1
       jmp  sfx_h_end_2
sfx_h_incoming_1:
       movb @sfx_count(r9),r0
       b    @sfx_set_noise

sfx_h_end_2:
       b    @sfx_end

* Effect 10, the Torus Jump Drive (#R$78A7): first 6 frames of tone period
* 110 with the volume going up by 2 a frame; then 160 frames of noise with
* a rising period, and a tone with that period. The volume goes down by
* one every 14 frames.
sfx_h_torus:
       mov  r11,r8
       cb   @sfx_param(r9),@bytes+2
       jne  sfx_h_torus_1
       ab   @bytes+2,@sfx_volume(r9)
       li   r0,110
       mov  r0,@sfx_period(r9)
       jmp  sfx_h_torus_2
sfx_h_torus_1:
       inc  @sfx_counter(r9)
       mov  @sfx_counter(r9),r0
       mov  r0,@sfx_period(r9)
       swpb r0
       bl   @sfx_set_noise
       movb @b255,@sfx_noise(r9)
sfx_h_torus_2:
       mov  r8,r11
       sb   @bytes+1,@sfx_param2(r9)
       jne  sfx_h_torus_3
       movb @bytes+14,@sfx_param2(r9)
       sb   @bytes+1,@sfx_volume(r9)
sfx_h_torus_3:
       sb   @bytes+1,@sfx_count(r9)
       jne  sfx_h_torus_4
       movb @bytes+160,@sfx_count(r9)
       sb   @bytes+1,@sfx_param(r9)
       jeq  sfx_h_end_2
sfx_h_torus_4:
       rt

* Effect 11, the launch (#R$78FE), and the end of effect 12: the noise
* period is the countdown; every 5 frames (30 the first time) the volume is
* set to the parameter, which goes down by one, ending at 0.
sfx_h_launch:
       mov  r11,r8
       movb @sfx_count(r9),r0
       bl   @sfx_set_noise
       mov  r8,r11
       sb   @bytes+1,@sfx_count(r9)
       jne  sfx_h_launch_1
       movb @bytes+5,@sfx_count(r9)
       movb @sfx_param(r9),@sfx_volume(r9)
       sb   @bytes+1,@sfx_param(r9)
       jeq  sfx_h_end_2
sfx_h_launch_1:
       rt

* Effect 12, hyperspace (#R$793B): the tone period goes up by one each
* frame; when the countdown runs out it starts again from the parameter,
* which goes down by 2 each time, at tone period 60. When that reaches 0:
* tone period 255 with the noise on, fading out as effect 11 does.
sfx_h_hyperspace:
       inc  @sfx_period(r9)
       sb   @bytes+1,@sfx_count(r9)
       jne  sfx_h_hyperspace_1
       movb @sfx_param(r9),@sfx_count(r9)
       li   r0,60
       mov  r0,@sfx_period(r9)
       sb   @bytes+2,@sfx_param(r9)
       jne  sfx_h_hyperspace_1
       li   r0,255
       mov  r0,@sfx_period(r9)
       movb @b255,@sfx_noise(r9)
       movb @bytes+5,@sfx_count(r9)
       movb @bytes+15,@sfx_param(r9)
       li   r0,sfx_h_launch
       mov  r0,@sfx_handler(r9)
sfx_h_hyperspace_1:
       rt

* Effect 13, cargo scooped (#R$798A): the volume is the countdown, so each
* blip fades out; two blips, the second at tone period 120.
sfx_h_scoop:
       movb @sfx_count(r9),@sfx_volume(r9)
       sb   @bytes+1,@sfx_count(r9)
       jne  sfx_h_scoop_1
       li   r0,120
       mov  r0,@sfx_period(r9)
       movb @bytes+15,@sfx_count(r9)
       sb   @bytes+1,@sfx_param(r9)
       jeq  sfx_h_end_2
sfx_h_scoop_1:
       rt

* The disk operations (TI-specific: see ti-disk.a99, which has their entry
* point and their data, in low RAM)

*********************************************************************
*
* Save the console's scratchpad and the DSR's part of the color table
*
* Called once, as the first thing the program does (lower-memory.a99), before
* anything is written to the scratchpad or to the VDP RAM. Runs in disk_ws
* (LWPI), with this bank selected.
*
ti_save_console_state:
       li   r0,wrksp
       li   r1,console_pad
       li   r2,>80
ti_save_console_state_1:
       mov  *r0+,*r1+
       dec  r2
       jne  ti_save_console_state_1
       mov  @console_pad+>70,r0        ; R0 = the first address of the DSR's buffers:
       inc  r0                         ; one after the top of the free VDP RAM (>8370)
       li   r2,color_table+>1800       ; R2 = how many bytes of the color table they cover
       s    r0,r2
       jgt  ti_save_console_state_2
       clr  r2                         ; none (no disk controller)
ti_save_console_state_2:
       ci   r2,dsr_color_max
       jle  ti_save_console_state_3
       li   r2,dsr_color_max           ; (more than three files: only the last 40 bytes are kept)
       li   r0,color_table+>1800-dsr_color_max
ti_save_console_state_3:
       mov  r0,@dsr_color_address
       mov  r2,@dsr_color_length
       jeq  ti_save_console_state_5
       li   r1,dsr_color_bytes
       swpb r0                         ; read them from the VDP RAM
       movb r0,@vdpwa
       swpb r0
       movb r0,@vdpwa
ti_save_console_state_4:
       movb @vdprd,*r1+
       dec  r2
       jne  ti_save_console_state_4
ti_save_console_state_5:
       rt
*// ti_save_console_state

*********************************************************************
*
* Load or save the commander record
*
* Called with BLWP @disk_vector, through disk_entry (ti-disk.a99), which
* selects this bank. Loads the file disk_name into the record
* at #R$D606, or saves the record as that file. Gives the DSR the console's
* scratchpad and its part of the color table back, calls it, and then puts
* the game's back and sets up the name table and the sprite attribute table
* again (all sprites off the screen), as the DSR's buffers are under them.
*
* I:disk_opcode disk_load or disk_save (the high byte)
* I:disk_name The file's name, with the device ("DSK1.JAMESON")
* I:disk_name_length Its length
* O:disk_error 0 if it went well
*
ti_disk_operation:
       mov  r11,r10
       li   r0,disk_pab+>4000          ; The PAB:
       bl   @ti_disk_vdp_address
       clr  r1
       movb @disk_opcode,@vdpwd        ; 0: the operation
       movb r1,@vdpwd                  ; 1: the flags, and the error code afterwards
       li   r2,disk_buffer
       movb r2,@vdpwd                  ; 2-3: the buffer's address
       swpb r2
       movb r2,@vdpwd
       movb r1,@vdpwd                  ; 4-5: not used
       movb r1,@vdpwd
       li   r2,disk_record_size        ; 6-7: the size of the file (when loading, the most
       movb r2,@vdpwd                  ; to load)
       swpb r2
       movb r2,@vdpwd
       movb r1,@vdpwd                  ; 8: not used
       movb @disk_name_length,r2       ; 9: the length of the name
       movb r2,@vdpwd
       srl  r2,8
       li   r3,disk_name               ; 10: the name
ti_disk_operation_1:
       movb *r3+,@vdpwd
       dec  r2
       jne  ti_disk_operation_1
       cb   @disk_opcode,@disk_save_byte
       jne  ti_disk_operation_3
       li   r0,disk_buffer+>4000       ; Saving: copy the record to the buffer
       bl   @ti_disk_vdp_address
       li   r3,tape_record
       li   r2,disk_record_size
ti_disk_operation_2:
       movb *r3+,@vdpwd
       dec  r2
       jne  ti_disk_operation_2
ti_disk_operation_3:
       bl   @ti_swap_pad               ; The console's scratchpad
       bl   @ti_swap_dsr_colors        ; and the DSR's part of the color table
       mov  @dsr_color_length,r2
       jeq  ti_disk_operation_5        ; (no disk controller)
       li   r0,name_table+>4000        ; Clear the DSR's buffers that are under the name table
       bl   @ti_disk_vdp_address       ; and the sprite attribute table, so that it finds none
       clr  r1                         ; of its files open
       li   r2,>0380
ti_disk_operation_4:
       movb r1,@vdpwd
       dec  r2
       jne  ti_disk_operation_4
ti_disk_operation_5:
       bl   @ti_dsrlnk                 ; Call the DSR
       bl   @ti_swap_dsr_colors        ; The game's colors
       bl   @ti_swap_pad               ; and its scratchpad
       movb @disk_error,r1
       jne  ti_disk_operation_7
       cb   @disk_opcode,@disk_save_byte
       jeq  ti_disk_operation_7
       li   r0,disk_buffer             ; Loaded: copy the buffer to the record
       bl   @ti_disk_vdp_address
       li   r3,tape_record
       li   r2,disk_record_size
ti_disk_operation_6:
       movb @vdprd,*r3+
       dec  r2
       jne  ti_disk_operation_6
ti_disk_operation_7:
       li   r0,name_table+>4000        ; The name table: characters 0-255, three times
       bl   @ti_disk_vdp_address
       clr  r1
       li   r2,>0300
ti_disk_operation_8:
       movb r1,@vdpwd
       ai   r1,>0100
       dec  r2
       jne  ti_disk_operation_8
       li   r0,sprite_attr_table+>4000 ; The sprite attribute table: all 32 sprites off the
       bl   @ti_disk_vdp_address       ; screen (y = >DF, as #R$3942 does), and transparent
       li   r1,>df00
       clr  r3
       li   r2,32
ti_disk_operation_9:
       movb r1,@vdpwd
       movb r3,@vdpwd
       movb r3,@vdpwd
       movb r3,@vdpwd
       dec  r2
       jne  ti_disk_operation_9
       b    *r10
*// ti_disk_operation

*********************************************************************
*
* Set the VDP address
*
* I:R0 The address (+ >4000 to write)
*
ti_disk_vdp_address:
       swpb r0
       movb r0,@vdpwa
       swpb r0
       movb r0,@vdpwa
       rt
*// ti_disk_vdp_address

*********************************************************************
*
* Call the DSR of the device in the PAB
*
* A DSRLNK: looks for the device of disk_name ("DSK1") in the DSR ROMs of
* the cards (CRU >1000->1F00), and calls its routine, in the GPL workspace
* (>83E0) and with the scratchpad set up as DSRs expect: the device name's
* length in >8354, the VDP address of the "." after it in the PAB in >8356,
* the card's CRU address in >83D0 and the DSR's entry in its ROM in >83D2.
* Must be called with the console's scratchpad in place.
*
* O:disk_error 0 if it went well; >FF if there is no such device;
* .           otherwise the error code from the PAB (in bits 7-5)
*
ti_dsrlnk:
       seto r0
       movb r0,@disk_error             ; (no such device, until it's found)
       li   r1,disk_name               ; Copy the device name, up to the ".", to >834A
       li   r3,>834a
       clr  r2
ti_dsrlnk_1:
       cb   *r1,@disk_period
       jeq  ti_dsrlnk_2
       movb *r1+,*r3+
       inc  r2
       ci   r2,7
       jl   ti_dsrlnk_1
ti_dsrlnk_2:
       mov  r2,@>8354                  ; its length
       ai   r2,disk_pab+10
       mov  r2,@>8356                  ; the VDP address of the "."
       sb   @>837c,@>837c              ; clear the GPL status
       lwpi >83e0                      ; The GPL workspace (R13-R15 are the console's)
       clr  r1
       li   r12,>0f00
ti_dsrlnk_3:
       sbz  0                          ; The next card: turn the last one's ROM off
       ai   r12,>0100
       ci   r12,>2000
       jeq  ti_dsrlnk_8                ; no more cards
       mov  r12,@>83d0
       sbo  0                          ; turn its ROM on
       li   r2,>4000
       cb   *r2,@disk_valid            ; a DSR ROM?
       jne  ti_dsrlnk_3
       ai   r2,8                       ; its list of devices
       jmp  ti_dsrlnk_5
ti_dsrlnk_4:
       mov  @>83d2,r2                  ; The next device in the list
       sbo  0
ti_dsrlnk_5:
       mov  *r2,r2
       jeq  ti_dsrlnk_3                ; the end of the list
       mov  r2,@>83d2
       inct r2
       mov  *r2+,r9                    ; R9 = its routine
       movb @>8355,r5
       cb   r5,*r2+                    ; the same length?
       jne  ti_dsrlnk_4
       srl  r5,8
       li   r6,>834a
ti_dsrlnk_6:
       cb   *r6+,*r2+                  ; the same name?
       jne  ti_dsrlnk_4
       dec  r5
       jne  ti_dsrlnk_6
       inc  r1
       bl   *r9                        ; Call it. It returns here if it isn't its device,
       jmp  ti_dsrlnk_4                ; and one instruction on if it is
       sbz  0
       lwpi disk_ws
       li   r0,disk_pab+1              ; The error code in the PAB
       swpb r0
       movb r0,@vdpwa
       swpb r0
       movb r0,@vdpwa
       movb @vdprd,r1
       andi r1,>e000
       movb r1,@disk_error
       rt
ti_dsrlnk_8:
       lwpi disk_ws
       rt
*// ti_dsrlnk

*********************************************************************
*
* Swap the scratchpad with its copy
*
* The first time this puts the console's scratchpad back, keeping the
* game's in console_pad; the second time the other way round.
*
ti_swap_pad:
       li   r0,wrksp
       li   r1,console_pad
       li   r2,>80
ti_swap_pad_1:
       mov  *r0,r3
       mov  *r1,*r0+
       mov  r3,*r1+
       dec  r2
       jne  ti_swap_pad_1
       rt
*// ti_swap_pad

*********************************************************************
*
* Swap the DSR's part of the color table with its copy
*
* The first time this puts the DSR's bytes back in the VDP RAM, keeping the
* game's colors in dsr_color_bytes; the second time the other way round
* (keeping the bytes as the DSR left them).
*
ti_swap_dsr_colors:
       mov  @dsr_color_length,r2
       jeq  ti_swap_dsr_colors_4
       mov  @dsr_color_address,r0      ; read what is in the VDP RAM now
       swpb r0
       movb r0,@vdpwa
       swpb r0
       movb r0,@vdpwa
       li   r1,dsr_color_temp
ti_swap_dsr_colors_1:
       movb @vdprd,*r1+
       dec  r2
       jne  ti_swap_dsr_colors_1
       ori  r0,>4000                   ; write the copy there
       swpb r0
       movb r0,@vdpwa
       swpb r0
       movb r0,@vdpwa
       li   r1,dsr_color_bytes
       mov  @dsr_color_length,r2
ti_swap_dsr_colors_2:
       movb *r1+,@vdpwd
       dec  r2
       jne  ti_swap_dsr_colors_2
       li   r0,dsr_color_temp          ; and keep what was there as the copy
       li   r1,dsr_color_bytes
       mov  @dsr_color_length,r2
ti_swap_dsr_colors_3:
       movb *r0+,*r1+
       dec  r2
       jne  ti_swap_dsr_colors_3
ti_swap_dsr_colors_4:
       rt
*// ti_swap_dsr_colors

disk_save_byte:
       byte disk_save/256
disk_period:
       text '.'
disk_valid:
       byte >aa
       even

rom_bank_14_end:
       equ  $
       bss  >8000-$
