* The math tables, at the same address (right after the header) in every data bank
math_tables:
       equ  $
********************************************************************************
* Bit-length table
* 
* Entry n (0-255) is the number of bits needed to hold n, i.e. the
* position of its highest set bit plus one (with entry 0 = 1): 1 for
* 0-1, 2 for 2-3, 3 for 4-7, and so on up to 8 for 128-255. Page-aligned
* so that it can be read with `LD H,$02 / LD L,n / LD A,(HL)` (or through BC
* or DE). Used as a loop or shift count - how many times to halve something
* until it fits - by the multiply routines (#R$1F5E, #R$1F73, #R$200A), the
* drawing of an object (#R$422E, for its normals' scale) and its size on
* screen (#R$46CA), the projection of points (#R$47C4, #R$47F0), the
* stardust (#R$64F1, #R$656B, #R$6805), the length of a vector (#R$84A6) and
* the compass (#R$8570).
bit_length_table:                                          ; >0200
       byte >01,>01,>02,>02,>03,>03,>03,>03,>04,>04,>04,>04,>04,>04,>04,>04
       byte >05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05
       byte >06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06
       byte >06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06
       byte >07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07
       byte >07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07
       byte >07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07
       byte >07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
