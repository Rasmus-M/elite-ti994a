* ROM bank 7: the math tables, and code: the status page and the commander menu
* Assembled for real by code-banks.a99, and DORG in elite.a99 for its labels
       .ifdef code_banks
       aorg >6000
       .else
       dorg >6000
       .endif
       bss  >40
       .ifdef code_banks
       bcopy "../../bin/math-tables.bin" ; the math tables, as in the other banks
       .else
       bss  math_tables_end-math_tables
       .endif

* The status page (a pilot for code in ROM banks), with its own data

********************************************************************************
* The message "FBLR ? "
msg_fblr:                                                  ; >57dd
       text 'FBLR'                                                ; the laser mounts (TI: without the " ?" that follows on the MSX)

********************************************************************************
* Status page headings
* 
* Printed by #R$6276. A list of (column, row, string) records ending with $FF
* (see #R$3596).
status_page_headings:                                      ; >59e0
       text >05,>03,'Present System    ',>ba                      ; 
       text >05,>04,'Hyperspace System ',>ba                      ; 
       text >05,>05,'Condition         ',>ba                      ; 
       text >05,>06,'Fuel',>ba                                    ; 
       text >05,>07,'Cash',>ba                                    ; 
       text >05,>08,'Legal Status',>ba                            ; 
       text >05,>09,'Rating',>ba                                  ; 
       text >05,>0b,'Equipment',>ba                               ; 
       byte >FF                                                   ; 

********************************************************************************
* Status page frame
* 
* Drawn by #R$6276. A list of (RST $28) rectangles ending with $FF (see
* #R$36F1).
status_page_frame:                                         ; >5a52
       byte >05,>01,>20,>01,>91                                   ; 
       byte >05,>03,>13,>09,>21                                   ; 
       byte >18,>03,>0A,>02,>71                                   ; 
       byte >0B,>06,>14,>02,>71                                   ; 
       byte >13,>08,>08,>01,>71                                   ; 
       byte >0D,>09,>14,>01,>71                                   ; 
       byte >05,>0C,>21,>08,>D1                                   ; 
       byte >FF                                                   ; 

********************************************************************************
* The message "Green"
msg_green_5a9f:                                            ; >5a9f
       text 'Gree',>ee                                            ; the conditions, printed with RST $10
msg_red_5aa4:                                              ; >5aa4
       text 'Re',>e4                                              ; 
msg_red_5aa7:                                              ; >5aa7
       text 'Re',>e4                                              ; 

********************************************************************************
* The message "Clean"
msg_clean:                                                 ; >5aaa
       text 'Clea',>ee                                            ; the legal statuses, printed with RST $10
msg_offender:                                              ; >5aaf
       text 'Offende',>f2                                         ; 
msg_fugitive:                                              ; >5ab7
       text 'Fugitiv',>e5                                         ; 

********************************************************************************
* Show the status page
* 
* Used by the routines at #R$1873, #R$1C5C and #R$5DBB.
* .
* Does nothing if it's already showing (#R$E902 = 3). Hides the sprites,
* draws the frame and labels, and prints "Commander" and the name
* (#R$6377); then the present system - or "Witchspace" (#R$EEC1) - and the
* rest ($629C).
* .
* At $629C, prints the present system (#R$EB67), the hyperspace system
* (#R$E72B), the condition (#R$E90C, coloured green or red), the fuel, the
* cash, the legal status (#R$EB65), the rating (#R$EB12), and the equipment
* fitted (#R$F777 onwards, two columns), with the mounts of each laser
* ($6355) and "Naval Energy Unit" for the naval energy unit (#R$F77E = 2).
* .
* At $6355, prints the name of equipment item A (from the list at #R$10A7).
* At $6359, for a laser (bit 7 of E set), prints the letters of the mounts
* it's fitted to ("F", "B", "L" and "R", bits 0-3). At $636D moves on to
* the next item, and marks the status page as showing (#R$E902 = 3) after
* the last.
status_page:                                               ; >6276
       .proc                                               ;                   ; 
       cb   @current_screen,@bytes+>03                     ; LD A,($E902) / CP $03; 
       jne  !                                              ; RET Z             ; already showing
       b    @status_page_end                               ;                   ; 
!
       bl   @hide_sprites_clear_page                       ; CALL $608C        ; hide the sprites
       li   ix,status_page_frame                           ; LD IX,$5A52       ; 
       bl   @rst_28_target_draw_list_tile                  ; RST $28           ; draw the frame
       li   hl,status_page_headings                        ; LD HL,$59E0       ; the labels
       bl   @rst_20_target_print_list_positioned           ; RST $20           ; print them
       bl   @print_commander_name                          ; CALL $6377        ; print "Commander" and the name
       li   bc,>1903                                       ; LD BC,$1903       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; 
       movb @in_witchspace,a                               ; LD A,($EEC1) / OR A; 
       jeq  status_page_2                                  ; JR Z,$629C        ; not in witchspace
       li   hl,msg_witchspace                              ; LD HL,$57C9       ; "Witchspace"
       jmp  _62a5                                          ; JR $62A5          ; 
status_page_2:                                             ; >629c
       movb @current_system,a                              ; LD A,($EB67)      ; A = present system
       bl   @generate_system_name                          ; CALL $4CAF        ; generate its name
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
_62a5:                                                     ; >62a5
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       li   bc,>1904                                       ; LD BC,$1904       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; 
       movb @selected_system,a                             ; LD A,($E72B)      ; A = hyperspace system
       bl   @generate_system_name                          ; CALL $4CAF        ; generate its name
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       li   bc,>1905                                       ; LD BC,$1905       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; 
       movb @alert_level,a                                 ; LD A,($E90C)      ; A = alert level
       li   hl,msg_green_5a9f                              ; LD HL,$5A9F       ; "Green", "Red" or "Red"
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print the condition
       movb @bytes+>90,@vdpwa                              ; LD A,$90 / OUT ($99),A; 
       movb @bytes+>65,@vdpwa                              ; LD A,$65 / OUT ($99),A; VRAM address $2590
       movb @bytes+>31,a                                   ; LD A,$31          ; green...
       movb @alert_level,r0                                ; OR A              ; (TI: tested before the load)
       jeq  _62d8                                          ; JR Z,$62D8        ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; ...or red
       movb a,@vram_flash_toggle                           ; LD ($E90E),A      ; 
_62d8:                                                     ; >62d8
       movb @bytes+>40,b                                   ; LD B,$40          ; 
_62da:                                                     ; >62da
       movb a,@vdpwd                                       ; OUT ($98),A       ; colour the condition
       sb   one,b                                          ; DJNZ $62DA        ; 
       jne  _62da                                          ;                   ; 
       li   bc,>0b06                                       ; LD BC,$0B06       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; 
       bl   @print_fuel                                    ; CALL $6042        ; print the fuel
       li   bc,>0b07                                       ; LD BC,$0B07       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; 
       bl   @format_print_current_cash_total               ; CALL $6037        ; print the cash
       li   hl,msg_credits_5851                            ; LD HL,$5851       ; " Credits"
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; 
       li   bc,>1308                                       ; LD BC,$1308       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; 
       movb @legal_status,a                                ; LD A,($EB65) / OR A; A = legal status
       jeq  _6309                                          ; JR Z,$6309        ; 0: Clean
       cb   a,@bytes+>32                                   ; CP $32            ; 
       jhe  status_page_fugitive                           ; JR NC,$6309       ; (TI: CB sets no carry - JHE straight after it)
       movb one,a                                          ; LD A,$02 / DEC A  ; 1-49: Offender
       jmp  _6309                                          ;                   ; 
status_page_fugitive:                                      
       movb @bytes+>02,a                                   ;                   ; 50 or more: Fugitive
_6309:                                                     ; >6309
       li   hl,msg_clean                                   ; LD HL,$5AAA       ; "Clean", "Offender" or "Fugitive"
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print the legal status
       li   bc,>0d09                                       ; LD BC,$0D09       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; 
       movb @combat_rank,a                                 ; LD A,($EB12)      ; A = combat rank
       li   hl,msg_harmless_0f25                           ; LD HL,$0F25       ; "Harmless" ...
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print the rank
       li   hl,>050c                                       ; LD HL,$050C       ; the first equipment column
       movb hl,@status_equipment_position+1                ; LD ($E74B),HL     ; 
       movb @l,@status_equipment_position                  ;                   ; 
       li   hl,item_large_cargo_bay                        ; LD HL,$F777       ; the equipment, from the large cargo bay
       movb @bytes+>0f,b                                   ; LD B,$0F          ; 15 items
_6325:                                                     ; >6325
       .push hl                                            ; PUSH HL           ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@e                                           ; LD E,A            ; 
       andi a,>7f00                                        ; AND $7F           ; 
       jeq  _636d                                          ; JR Z,$636D        ; not fitted
       .push bc                                            ; PUSH BC           ; 
       movb @status_equipment_position+1,bc                ; LD BC,($E74B)     ; 
       movb @status_equipment_position,@c                  ;                   ; 
       bl   @set_cursor_position                           ; CALL $3548        ; 
       movb b,a                                            ; LD A,B            ; 
       ab   @bytes+>11,a                                   ; ADD A,$11         ; 
       movb a,b                                            ; LD B,A            ; 
       cb   a,@bytes+>27                                   ; CP $27            ; 
       jne  _633f                                          ; JR NZ,$633F       ; 
       movb @bytes+>05,b                                   ; LD B,$05          ; the second column
       ab   one,@c                                         ; INC C             ; 
_633f:                                                     ; >633f
       movb bc,@status_equipment_position+1                ; LD ($E74B),BC     ; 
       movb @c,@status_equipment_position                  ;                   ; 
       .pop bc                                             ; POP BC            ; 
       movb @bytes+>11,a                                   ; LD A,$11          ; 
       sb   b,a                                            ; SUB B             ; 
       cb   a,@bytes+>09                                   ; CP $09            ; the energy unit?
       jne  status_page_equipment                          ; JR NZ,$6355       ; 
       movb @e,r0                                          ; BIT 1,E           ; a naval one?
       andi r0,>0200                                       ;                   ; 
       jeq  status_page_equipment                          ; JR Z,$6355        ; 
       li   hl,msg_naval_energy_unt                        ; LD HL,$114C       ; "Naval Energy Unit"
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       jmp  _6359                                          ; JR $6359          ; 
status_page_equipment:                                     ; >6355
       li   hl,equipment_name_list2_empty_slots            ; LD HL,$10A7       ; the equipment names
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print it
_6359:                                                     ; >6359
       movb @e,r0                                          ; BIT 7,E           ; a laser?
       andi r0,>8000                                       ;                   ; 
       jeq  _636d                                          ; JR Z,$636D        ; no - nothing more to show
       .push bc                                            ; PUSH BC           ; 
       li   hl,msg_fblr                                    ; LD HL,$57DD       ; "FBLR"
       movb @bytes+>04,b                                   ; LD B,$04          ; 
_6363:                                                     ; >6363
       movb @e,r0                                          ; RR E              ; fitted to this mount?
       srl  r0,9                                           ;                   ; (TI: the bit shifted out is E's bit 0, in the carry)
       swpb r0                                             ;                   ; 
       movb r0,@e                                          ;                   ; (SWPB and MOVB leave the carry alone)
       jnc  _6369                                          ; JR NC,$6369       ; clear - not fitted, skip its letter
       movb *hl,a                                          ; LD A,(HL)         ; print its letter
       bl   @print_char                                    ; RST $00           ; 
_6369:                                                     ; >6369
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $6363        ; next sub-option bit
       jne  _6363                                          ;                   ; 
       .pop bc                                             ; POP BC            ; 
_636d:                                                     ; >636d
       .pop hl                                             ; POP HL            ; recover the pointer
       inc  hl                                             ; INC HL            ; -> the next slot
       sb   one,b                                          ; DJNZ $6325        ; next item
       jne  _6325                                          ;                   ; 
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       movb a,@current_screen                              ; LD ($E902),A      ; the status page is showing
status_page_end:                                           
       .endproc                                            ; RET               ; 

********************************************************************************
* Print "Commander" and the commander's name
* 
* Used by the routines at #R$6276 and #R$A30A.
* .
* Centred on the line: at column (42 - (10 + the length of the name,
* #R$EB11)) / 2.
print_commander_name:                                      ; >6377
       .proc                                               ;                   ; 
       movb one,@cursor_vram_addr_row                      ; LD A,$01 / LD ($E710),A; text row 1
       movb @name_length,a                                 ; LD A,($EB11)      ; A = length of the name
       ab   @bytes+>0a,a                                   ; ADD A,$0A         ; 
       sb   @bytes+>2a,a                                   ; SUB $2A           ; 
       andi a,>ff00                                        ; NEG               ; 
       neg  a                                              ;                   ; 
       srl  a,1                                            ; SRL A             ; 
       bl   @set_cursor_position_combined                  ; CALL $3564        ; 
       li   hl,msg_commander                               ; LD HL,$57D3       ; "Commander "
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       li   hl,commander_name                              ; LD HL,$EB06       ; the commander's name
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       .endproc                                            ; RET               ; 

* The commander menu (only the Default JAMESON option so far), with its own data

********************************************************************************
* "JAMESON" default-commander-name string
* 
* Elite's traditional default commander name, plain ASCII and
* null-terminated.
* .
* Copied into the commander's name by #R$A433.
jameson_default_commander_name_string:                     ; >1337
       text 'JAMESON',>00                                         ; (TI: with the 3 bytes after it that #R$A433 copies, as zeros)
       byte >00,>00,>00                                           ; 

********************************************************************************
* Default commander file
* 
* Used by the routine at #R$A433.
* .
* The commander file for the default commander, JAMESON: copied into the
* commander file buffer by #R$A433, and then into the variables listed
* at #R$A551 (#R$A469).
default_commander_file:                                    ; >7172
       byte >00                                                   ; galaxy number: 0
       byte >4A,>5A,>48,>02,>53,>B7                               ; galaxy seeds
       byte >07                                                   ; current system: 7 (Lave)
       byte >03                                                   ; options: sound on, D
       byte >E8,>03,>00                                           ; cash: 1000 (100.0 credits)
       byte >00                                                   ; market random byte
       byte >2D,>31,>01,>FF                                       ; scratch buffer
       byte >46,>03,>00,>00,>81,>80,>00,>00,>00,>00               ; fuel 70, 3 missiles, the equipment
       byte >00,>00,>80,>80,>00,>00,>00,>00,>00,>00               ; 
       bss  72                                                    ; cargo: none
       byte >00                                                   ; legal status: clean
       byte >00,>00,>00                                           ; score
       byte >00                                                   ; combat rank: Harmless
       byte >00                                                   ; scratch buffer
       byte >00                                                   ; Constrictor's trail
       byte >00                                                   ; kills
       byte >01                                                   ; next mission: 1
       byte >00                                                   ; mission state: none
       byte >00                                                   ; mission system
       byte >40                                                   ; jumps to the next mission: 64
       byte >00,>00,>00,>00                                       ; game time
       byte >00,>00,>00                                           ; unused

********************************************************************************
* Show the commander menu
* 
* Used by the routines at #R$1C5C, #R$A377, #R$A3E0, #R$A41B and #R$A542.
* .
* Reached from the title screen (#R$1DB5) and after each menu option.
* Refuses in flight (#R$6393). Packs the commander's data into the
* commander file (#R$A44F), and works out the length of the name (#R$EB06,
* into #R$EB11). Then $A31D shows the menu.
* .
* At $A31D, draws the menu: "1. Load new Commander", "2. Save Commander",
* "3. Catalog tape", "4. Default JAMESON", and the commander's name. The
* entry at $A33A goes straight to option 1 if "Load New Commander" was
* chosen on the title screen (#R$E924), and otherwise asks "Select option
* ?" ($A348).
* .
* At $A348, prints the menu prompt ($A5FD), then waits (#R$35E7) for a key
* in the range '1'-'5', rejecting anything else, before falling to $A359.
* .
* At $A359, redraws the dashboard, then (at $A35C) converts the '1'-'5' key
* to a 0-4 index and jumps to the option's routine from the table at $A6A4.
commander_menu:                                            ; >a30a
       .proc                                               ;                   ; 
commander_menu_jmp:                                        
       movb @docked,a                                      ; CALL $6393        ; refuse in flight (#R$6393)
       jne  commander_menu_docked                          ;                   ; 
       .endproc                                            ;                   ; (TI: back to the caller, without the beep, as no sound effects yet)
commander_menu_docked:                                     
       bl   @pack_commander                                ; CALL $A44F        ; pack the commander file
       li   hl,commander_name                              ; LD HL,$EB06       ; the commander's name
       sb   b,b                                            ; LD B,$00          ; 
_a315:                                                     ; >a315
       movb *hl+,a                                         ; LD A,(HL) / OR A / INC HL; 
       jeq  commander_menu_2                               ; JR Z,$A31D        ; 
       ab   one,b                                          ; INC B             ; count its letters
       jmp  _a315                                          ; JR $A315          ; 
commander_menu_2:                                          ; >a31d
       movb b,@name_length                                 ; LD A,B / LD ($EB11),A; the length of the name
       bl   @hide_sprites_clear_page                       ; CALL $608C        ; hide the sprites
       li   ix,commander_menu_frame                        ; LD IX,$A5ED       ; 
       bl   @rst_28_target_draw_list_tile                  ; RST $28           ; draw a frame
       li   hl,commander_menu_text                         ; LD HL,$A58F       ; the menu
       bl   @rst_20_target_print_list_positioned           ; RST $20           ; print it
       bl   @print_commander_name                          ; CALL $6377        ; 
       li   bc,>1706                                       ; LD BC,$1706       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; 
       li   hl,commander_name                              ; LD HL,$EB06       ; 
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print the commander's name
commander_menu_ask:                                        ; >a33a
       movb @load_new_commander,a                          ; LD A,($E924) / OR A; from the title screen?
       jeq  commander_menu_wait_for_choice                 ; JR Z,$A348        ; no - ask
       sb   @load_new_commander,@load_new_commander        ; XOR A / LD ($E924),A; 
       movb @bytes+>31,a                                   ; LD A,$31          ; yes - option '1'
       jmp  _a35c                                          ; JR $A35C          ; 
commander_menu_wait_for_choice:                            ; >a348
       li   hl,msg_select_option                           ; LD HL,$A5FD       ; "Select option ? "
       bl   @rst_20_target_print_list_positioned           ; RST $20           ; print it
_a34c:                                                     ; >a34c
       bl   @wait_for_keypress_blinking_cursor             ; CALL $35E7        ; wait for a key
       cb   a,@bytes+>31                                   ; CP $31            ; below '1'?
       jl   _a34c                                          ; JR C,$A357        ; yes - reject
       cb   a,@bytes+>36                                   ; CP $36            ; '6' or above?
       jhe  _a34c                                          ; JR C,$A359        ; yes - reject
continue_a348_dispatch_menu_choice:                        ; >a359
       bl   @clear_message_line                            ; CALL $3955        ; clear the message line
_a35c:                                                     ; >a35c
       sb   @bytes+>31,a                                   ; SUB $31           ; convert '1'-'5' to a 0-4 index
       clr  r1                                             ;                   ; 
       movb a,r1                                           ;                   ; 
       srl  r1,7                                           ; ADD HL,BC x 2     ; R1 = the index * 2
       ci   r1,8                                           ;                   ; (TI: '5' shows the status page and returns, as its RET does on the MSX)
       jne  _a35c_jump                                     ;                   ; 
       bl   @status_page                                   ;                   ; 
       .endproc                                            ;                   ; 
_a35c_jump:                                                
       mov  @commander_menu_options(r1),r1                 ; LD HL,$A6A4 / LD A,(HL) ...; the option's handler
       b    *r1                                            ; JP (HL)           ; dispatch to it

********************************************************************************
* Commander menu option '4': default JAMESON
* 
* Reached via the menu's jump table ($A6A4, #R$A359). Asks "Are you
* sure"; if 'Y', gives the player the default commander, JAMESON
* (#R$A433, #R$A469). Back to the menu (#R$A30A).
menu_default_commander:                                    ; >a41b
       li   hl,msg_are_you_sure                            ; LD HL,$A611       ; "Are you sure"
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       bl   @confirm_prompt_yn                             ; CALL $3815        ; wait for Y, N or ESC
       bl   @clear_message_line                            ; CALL $3955        ; clear the message line
       cb   a,@bytes+>59                                   ; CP $59            ; 
       jeq  _a42a                                          ; JP NZ,$A33A       ; not 'Y' - ask again
       b    @commander_menu_ask                            ;                   ; 
_a42a:                                                     ; >a42a
       bl   @default_commander                             ; CALL $A433        ; the default commander file
       bl   @unpack_commander                              ; CALL $A469        ; unpack it
       b    @commander_menu_jmp                            ; JP $A30A          ; back to the menu

********************************************************************************
* TI: options 1-3 use the tape (#R$A377, #R$A3E0, #R$A3C7), which isn't
* converted yet: they say so and go back to the menu, as after a tape error
* (#R$A542).
menu_tape_not_available:                                   
       bl   @clear_message_line                            ; CALL $3955        ; clear the message line
       li   hl,msg_tape_not_available                      ;                   ; 
       bl   @show_message                                  ; CALL $5FFB        ; show it for a while
       b    @commander_menu_jmp                            ; JP $A30A          ; back to the menu
menu_load_commander:                                       
       equ  menu_tape_not_available                               ; 
menu_save_commander:                                       
       equ  menu_tape_not_available                               ; 
menu_catalog_tape:                                         
       equ  menu_tape_not_available                               ; 
msg_tape_not_available:                                    
       text 'Tape not available on the T',>c9                     ; 

********************************************************************************
* Load the default commander
* 
* Used by the routines at #R$6F9F and #R$A41B.
* .
* Copies the default commander file (#R$7172) into the commander file
* buffer ($F6C0), and the name "JAMESON" (#R$1337) into the commander's
* name (#R$EB06), 7 letters long (#R$EB11). Used at startup (#R$6F9F)
* and for menu option '4' (#R$A41B).
default_commander:                                         ; >a433
       .proc                                               ;                   ; 
       li   hl,default_commander_file                      ; LD HL,$7172       ; 
       li   de,commander_menu_buffer                       ; LD DE,$F6C0       ; the commander file buffer
       li   bc,>0080                                       ; LD BC,$0080       ; 
       .ldir                                               ; LDIR              ; copy the default commander file
       li   hl,jameson_default_commander_name_string       ; LD HL,$1337       ; "JAMESON"
       li   de,commander_name                              ; LD DE,$EB06       ; the commander's name
       li   bc,>000b                                       ; LD BC,$000B       ; 
       .ldir                                               ; LDIR              ; 
       movb @bytes+>07,@name_length                        ; LD A,$07 / LD ($EB11),A; 7 letters
       .endproc                                            ; RET               ; 

********************************************************************************
* Pack the commander file
* 
* Used by the routine at #R$A30A.
* .
* Copies the commander's data - the variables listed at #R$A551 - into
* the commander file buffer at $F6C0, for saving.
pack_commander:                                            ; >a44f
       .proc                                               ;                   ; 
       li   ix,commander_file_variables                    ; LD HL,$A551       ; the list of variables
       li   de,commander_menu_buffer                       ; LD DE,$F6C0       ; the commander file buffer
_a455:                                                     ; >a455
       mov  *ix+,hl                                        ; LD C,(HL) / LD A,(HL) / OR A; HL -> the next variable
       jeq  _a455_end                                      ; RET Z             ; all done
       mov  *ix+,bc                                        ; LD A,(HL)         ; BC = its length
       .ldir                                               ; LDIR              ; copy it into the buffer
       jmp  _a455                                          ; JR $A455          ; 
_a455_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Commander menu
* 
* Printed by #R$A30A (RST $20): a list of (column, row, string) records ending
* with $FF (see #R$3596).
commander_menu_text:                                       ; >a58f
       text >05,>04,'1. Load new Commander',>00                   ; 
       text >05,>06,'2. Save Commander',>00                       ; 
       text >05,>08,'3. Catalog tape',>00                         ; 
       text >05,>0a,'4. Default JAMESON',>00                      ; 
       text >05,>0c,'5. Exit',>00                                 ; 
       byte >FF                                                   ; 

********************************************************************************
* Commander menu frame
* 
* Three (RST $28) rectangles that #R$A30A draws around the commander menu (see
* #R$36F1).
commander_menu_frame:                                      ; >a5ed
       byte >05,>01,>20,>01,>91                                   ; 
       byte >05,>04,>02,>09,>D1                                   ; 
       byte >08,>04,>19,>09,>21                                   ; 
       byte >FF                                                   ; 

********************************************************************************
* Commander menu: "Select option ?"
* 
* Printed by #R$A30A.
msg_select_option:                                         ; >a5fd
       text >05,>16,'Select option ? ',>00                        ; 
       byte >FF                                                   ; 

********************************************************************************
* The message "Are you sure"
msg_are_you_sure:                                          ; >a611
       text 'Are you sur',>e5                                     ; 

********************************************************************************
* Pointer table
commander_menu_options:                                    ; >a6a4
       even                                                       ; 
       data menu_load_commander                                   ; 1 (TI: words)
       data menu_save_commander                                   ; 2
       data menu_catalog_tape                                     ; 3
       data menu_default_commander                                ; 4
       data status_page                                           ; 5 (TI: not used - see #R$A35C)

rom_bank_7_end:
       equ  $
       bss  >8000-$
