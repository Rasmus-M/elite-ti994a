********************************************************************************
* Letter pairs for names
* 
* The 32 two-letter pairs system names are made from (#R$4CB8), as in BBC
* Elite. Spaces are left out, so pair 0 adds nothing and pair 15 just
* "a".
name_letter_pairs:                                         ; >0e41
       text '  '                                                  ; 0
       text 'le'                                                  ; 1
       text 'xe'                                                  ; 2
       text 'ge'                                                  ; 3
       text 'za'                                                  ; 4
       text 'ce'                                                  ; 5
       text 'bi'                                                  ; 6
       text 'so'                                                  ; 7
       text 'us'                                                  ; 8
       text 'es'                                                  ; 9
       text 'ar'                                                  ; 10
       text 'ma'                                                  ; 11
       text 'in'                                                  ; 12
       text 'di'                                                  ; 13
       text 'Re'                                                  ; 14
       text 'a '                                                  ; 15
       text 'er'                                                  ; 16
       text 'at'                                                  ; 17
       text 'en'                                                  ; 18
       text 'be'                                                  ; 19
       text 'ra'                                                  ; 20
       text 'la'                                                  ; 21
       text 've'                                                  ; 22
       text 'ti'                                                  ; 23
       text 'ed'                                                  ; 24
       text 'or'                                                  ; 25
       text 'qu'                                                  ; 26
       text 'an'                                                  ; 27
       text 'te'                                                  ; 28
       text 'is'                                                  ; 29
       text 'ri'                                                  ; 30
       text 'on'                                                  ; 31

********************************************************************************
* Equipment-name list: 2 leading empty entries
* 
* A separate, independently-addressed RST $10 list head from
* #R$0FFC's - #R$19A1 (at $19BB) and #R$6355 both `LD HL,$10A7`
* directly, walking
* it as its own list rather than continuing #R$0FFC's. These 2 empty
* entries (indices 0-1, skipping Fuel/Missiles) let the same physical
* strings from #R$10A9 ("Large Cargo Bay") onward serve as indices 2+
* here, reusing #R$0FFC's text under a second, differently-numbered
* entry point rather than duplicating it.
equipment_name_list2_empty_slots:                          ; >10a7
       byte >80,>80                                               ; two empty entries, then the equipment names
msg_large_cargo_bay_10a9:                                  ; >10a9
       text 'Large Cargo Ba',>f9                                  ; 
msg_ecm_system_10b8:                                       ; >10b8
       text 'ECM Syste',>ed                                       ; 
msg_pulse:                                                 ; >10c2
       text 'Pulse',>a0                                           ; 
msg_beam:                                                  ; >10c8
       text 'Beam',>a0                                            ; 
msg_fuel_scoop_10cd:                                       ; >10cd
       text 'Fuel Scoo',>f0                                       ; 
msg_escape_capsule_10d7:                                   ; >10d7
       text 'Escape Capsul',>e5                                   ; 
msg_energy_bomb_10e5:                                      ; >10e5
       text 'Energy Bom',>e2                                      ; 
msg_energy_unit:                                           ; >10f0
       text 'Energy Uni',>f4                                      ; 
msg_docking_computer_10fb:                                 ; >10fb
       text 'Docking Compute',>f2                                 ; 
msg_gal_hyperdrive:                                        ; >110b
       text 'Gal. Hyperdriv',>e5                                  ; 
msg_mining:                                                ; >111a
       text 'Mining',>a0                                          ; 
msg_military:                                              ; >1121
       text 'Military',>a0                                        ; 
msg_ecm_jammer:                                            ; >112a
       text 'ECM Jamme',>f2                                       ; 
msg_cloaking_device:                                       ; >1134
       text 'Cloaking Devic',>e5                                  ; 
msg_documents:                                             ; >1143
       text 'Document',>f3                                        ; 

********************************************************************************
* "FRONT VIEW" bitmap
* 
* The view name shown when switching to the front view (#R$64A1): 7
* characters of 5 pixel rows each, one character per line, which #R$645B
* copies into rows 1-5 of the character patterns at VRAM $0060-$0097.
       .msxalign >118f
view_name_front:                                           ; >118f
       byte >FB,>C3,>F3,>C3,>C3
       byte >C7,>6D,>CD,>4D,>27
       byte >26,>B6,>BE,>B6,>32
       byte >F0,>60,>60,>60,>60
       byte >6D,>6C,>6C,>28,>11
       byte >EF,>CC,>CF,>CC,>EF
       byte >B6,>36,>36,>3E,>94

********************************************************************************
* Select the ROM bank with the blueprint for the object's ship type
*
* TI-specific. Ship types below blueprints_2_first_type are in bank 4, the rest in bank 5.
*
* I:($F7E7) Ship type
select_blueprint_bank:
       cb   @ship_type,@bytes+blueprints_2_first_type
       jhe  !
       .select_bank blueprints_1_bank_select
       rt
!
       .select_bank blueprints_2_bank_select
       rt

********************************************************************************
* Main loop: move and draw everything for one frame
* 
* Used by the routine at #R$0106.
* .
* Called by the main loop (#R$0106) once per frame, both in flight and
* while docked (the space view steps are skipped while docked). Moves and
* plots the stardust, then runs each active object in the 20-slot object
* table at $EBA0 through the per-object pipeline, working on a copy of
* its 40-byte record in the workspace at $F7CD. After that come the
* per-frame checks: laser beams, the Torus Jump Drive countdown, the
* dashboard gauges and alerts, hyperspace and docking. Finally copies
* the space view to the screen and waits until 5 VBlank interrupts have
* passed since the previous frame, which caps the frame rate.
process_frame:                                             ; >13fd
       .proc                                               ;                   ; 
       movb @space_view_showing,a                          ; LD A,($E903) / OR A; A = space view showing?
       jeq _1409                                           ; JR Z,$1409        ; no - don't draw it
       bl   @clear_space_view                              ; CALL $388F        ; clear the space view's bitmap buffer
       bl   @update_stardust                               ; CALL $872E        ; move and plot the stardust
_1409:                                                     ; >1409
       movb @hyperspace_countdown_inner,r0                 ;                   ; (TI: only while a countdown is running)
       jeq  !                                              ;                   ; 
       .far_call code_bank_13_select,show_countdown        ; CALL $1651        ; show the hyperspace countdown
!
       bl   @settle_roll_pitch                             ; CALL $6BE1        ; stop the roll and pitch if their keys are released
       movb @cloaking_active_flag,r0                       ;                   ; (TI: only while the cloaking device...)
       socb @jammer_active_flag,r0                         ;                   ; (...or the jammer is on)
       jeq  !                                              ;                   ; 
       .far_call code_bank_13_select,cloak_and_jammer_frame;                   ; the cloaking device and the jammer ($140F-$1434)
!
* TI: no waiting for the VBlank handler to draw the scanner ($1437-$143C), as
* it is drawn at the end of this pass (#R$8380).
       sb   @scanner_queue_count,@scanner_queue_count      ; LD ($E948),A      ; empty the scanner queue: no records...
       sb   @hostile_about,@hostile_about                  ; LD ($E943),A      ; (and clear the HUD warning trigger, see #R$E943)
       li   r0,scanner_queue                               ; LD HL,$E94A       ; 
       mov  r0,@scanner_queue_ptr                          ; LD ($E946),HL     ; ...write pointer back at the start (TI: a big-endian word)...
       li   r0,>2c01                                       ; LD HL,$012C       ; (R0 holds it byte-swapped)
       movb r0,@scanner_background_space                   ; LD ($EB03),HL     ; ...and 300 bytes free for saving the background
       movb @r0lb,@scanner_background_space+1              ;                   ; 
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; HL -> the object table
       movb @bytes+>14,b                                   ; LD B,$14          ; B = 20 slots
process_frame_object:                                      ; >1455
       movb *hl,r0                                         ; BIT 0,(HL)        ; is this slot in use?
       andi r0,>0100                                       ;                   ; 
       jeq  process_frame_next_object                      ; JP Z,$14AD        ; no - skip it
       movb @bytes+>14,a                                   ; LD A,$14          ; 
       sb   b,a                                            ; SUB B             ; 
       movb a,@current_slot                                ; LD ($E911),A      ; save the slot number (0-19)
       .push bc                                            ; PUSH BC           ; save the slot counter
       .push hl                                            ; PUSH HL           ; save the slot address
       li   de,object_status_byte                          ; LD DE,$F7CD       ; DE -> the object workspace
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the object's 40-byte record into the workspace
       bl   @get_blueprint_data                            ; CALL $16E3        ; set the object up for its type
       sb   @ship_fired,@ship_fired                        ; XOR A / LD ($E92D),A; the ship hasn't fired
       bl   @work_out_distance                             ; CALL $883D        ; work out its distance
       .far_call code_bank_11_select,check_collision       ; CALL $8755        ; ship-type gates and range checks (incl. docking, #R$87DD)
       bl   @scanner_add_object                            ; CALL $8205        ; add the object to the scanner
       bl   @compass                                       ; CALL $85FB        ; position the compass dot, if this is its target
       bl   @move_past_player                              ; CALL $8B00        ; move it by the player's speed
       bl   @move_object                                   ; CALL $866D        ; move it forward by its own speed
       bl   @draw_object                                   ; CALL $422E        ; draw it
       .far_call code_bank_11_select,run_object_handler    ; CALL $2528        ; run the object's handler
       movb @laser_state,r0                                ;                   ; (TI: only if the laser has fired this frame)
       jgt  !                                              ;                   ; 
       jeq  !                                              ;                   ; 
       .far_call code_bank_12_select,laser_hit_check       ; CALL $28F6        ; check whether the laser hit the object
!
       movb @ship_fired,r0                                 ;                   ; (TI: only if the ship has fired)
       jeq  !                                              ;                   ; 
       .far_call code_bank_12_select,draw_ship_laser       ; CALL $43C2        ; draw the ship's laser beam
!
       movb @roll_rate,a                                   ; LD A,($F815) / OR A; A = roll rate
       jeq  _1496                                          ; CALL NZ,$22C0     ; rolling - rotate the object's position and axes
       bl   @step_roll_rotation                            ;                   ; 
_1496:                                                     ; >1496
       movb @pitch_rate,a                                  ; LD A,($F816) / OR A; A = pitch rate
       jeq  _149d                                          ; CALL NZ,$221B     ; pitching - rotate the object's position and axes
       bl   @step_pitch_rotation                           ;                   ; 
_149d:                                                     ; >149d
       bl   @straighten_orientation                        ; CALL $4503        ; re-orthogonalise the object's axes now and then
       .pop de                                             ; POP DE            ; DE = the slot address
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; HL -> the object workspace
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the updated record back into its slot
       mov  de,hl                                          ; EX DE,HL          ; HL -> the next slot
       .pop bc                                             ; POP BC            ; restore the slot counter
       jmp  _14b1                                          ; JR $14B1          ; 
process_frame_next_object:                                 ; >14ad
       ai   hl,>0028                                       ; LD DE,$0028 / ADD HL,DE; HL -> the next slot
_14b1:                                                     ; >14b1
       sb   one,b                                          ; DEC B             ; 
       jne  process_frame_object                           ; JP NZ,$1455       ; loop for all 20 slots
       movb @space_view_showing,a                          ; LD A,($E903)      ; if the space view is showing, draw this frame's
       jeq  _14bb                                          ; LD ($EB02),A      ; scanner queue
       bl   @scanner_draw                                  ;                   ; (TI: now, rather than in the VBlank handler, #R$7202)
_14bb:                                                     ; >14bb
       .far_call code_bank_12_select,draw_laser_beams      ; CALL $2DC8        ; draw the laser beams if the laser was just fired
       movb @torus_jump_countdown,r0                       ; LD A,($E918) / OR A; (TI: only while a Torus jump is in progress...)
       socb @secondary_flag_counter_pair,r0                ; LD A,($E933) / OR A; (...or being cut short)
       jeq  !                                              ;                   ; 
       .far_call code_bank_12_select,torus_jump_frame      ;                   ; the Torus jump ($14BE-$1500)
!
       li   hl,current_turn                                ; LD HL,$E92E       ; cycle the counter at $E92E: 3, 2, 1, 3...
       sb   one,*hl                                        ; DEC (HL)          ; 
       jne  _150b                                          ; JR NZ,$150B       ; 
       movb @bytes+>03,*hl                                 ; LD (HL),$03       ; 
_150b:                                                     ; >150b
       movb @in_witchspace,a                               ; LD A,($EEC1) / OR A; 
       jne  _1517                                          ; JR NZ,$1517       ; drive malfunction - skip the two gauge updates
       .far_call code_bank_11_select,check_safe_zone       ; CALL $1549        ; update the space station safe-zone flag
       .far_call code_bank_12_select,update_altitude_and_temperature; CALL $1577        ; update the altitude and cabin temperature, fuel scoop
_1517:                                                     ; >1517
       .far_call code_bank_11_select,spawn_ships           ; CALL $2B05        ; spawn new ships
       .far_call code_bank_13_select,set_alert_level       ; CALL $15E7        ; set the alert level
       .far_call code_bank_12_select,check_for_death       ; CALL $16BA        ; check for death
       movb @hyperspace_trigger,r0                         ;                   ; (TI: only once the countdown has run out)
       jeq  !                                              ;                   ; 
       .far_call code_bank_13_select,hyperspace_jump       ; CALL $894D        ; hyperspace
!
       movb @ecm_countdown,r0                              ;                   ; (TI: only while the ECM is on)
       jeq  !                                              ;                   ; 
       .far_call code_bank_12_select,ecm_active            ; CALL $323C        ; run the ECM
!
       movb @docking,a                                     ; LD A,($E917) / OR A; docking?
       jeq  _1531                                          ; JR Z,$1531        ; no
       .far_call code_bank_11_select,dock                  ; CALL $1873        ; yes - dock
       jmp  _1548                                          ; JR $1548          ; 
_1531:                                                     ; >1531
       .far_call code_bank_12_select,recharge              ; CALL $18E6        ; cool the laser, charge energy/shields
       movb @space_view_showing,a                          ; LD A,($E903) / OR A; 
       jeq  _1540                                          ; JR Z,$1540        ; no space view showing
       bl   @copy_space_view                               ; CALL $3846        ; copy the space view's bitmap buffer to VRAM
_1540:                                                     ; >1540
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, as interrupts are off)
       cb   @vblank_subtick_counter,@bytes+>05             ; LD HL,$F748 / LD A,(HL) / CP $05; 5 VBlanks since the last frame?
       jl   _1540                                          ; JR C,$1543        ; no - wait
_1548:                                                     ; >1548
       .endproc                                            ; RET               ; 

********************************************************************************
* Get the object's blueprint data
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C and #R$1E5A.
* .
* Copies the 26-byte header of the blueprint for the object's ship type
* ($F7E7), found via the table at #R$A7D7, to $F7F5-$F80E (see #R$A817
* for the layout). Does nothing for ship types $64 and above (the planet
* and the sun), which have no blueprint.
get_blueprint_data:                                        ; >16e3
       .proc
       .save_bank                                          ;                   ; (TI: select the caller's bank again on return)
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = ship type
       bl   @select_blueprint_bank                         ;                   ; select its ROM bank
       cb   a,@bytes+>64                                   ; CP $64            ; 
       jl   !                                              ; RET NC            ; the planet or the sun - no blueprint
       .restore_bank                                       ;                   ; 
       jmp  get_blueprint_data_exit                        ;                   ; 
!
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; HL = that word index
       li   bc,ship_blueprints                             ; LD BC,$A7D7       ; BC -> the blueprint table
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this ship type's table entry
       movb *hl,a                                          ; LD A,(HL)         ; read the entry (little-endian word)...
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL -> the blueprint header
       li   de,bp_vertices                                 ; LD DE,$F7F5       ; 
       li   bc,>001a                                       ; LD BC,$001A       ; 26 bytes
       .ldir                                               ; LDIR              ; copy the header to $F7F5
       movb @bp_name,r1                                    ;                   ; (TI: copy the name to RAM, so the message routines
       movb @bp_name+1,@r1lb                               ;                   ; can read it whichever bank is selected)
       li   r2,bp_name_buffer                              ;                   ; 
       movb r2,@bp_name                                    ;                   ; bp_name -> the copy
       movb @r2lb,@bp_name+1                               ;                   ; 
!
       movb *r1+,r0                                        ;                   ; 
       movb r0,*r2+                                        ;                   ; 
       jlt  +!                                             ;                   ; up to the last character (bit 7 set),
       ci   r2,bp_name_buffer+20                           ;                   ; or 20 bytes (the title letters have no name:
       jl   -!                                             ;                   ; their name pointer points at their vertices)
!
       .restore_bank                                       ;                   ; 
get_blueprint_data_exit:
       .endproc                                            ; RET               ; 

* TI-specific. The object's name, copied from its blueprint (bp_name) by
* get_blueprint_data, so it can be read with any ROM bank selected.
bp_name_buffer:
       bss  20
       even

