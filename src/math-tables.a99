       byte >15,>5C,>3E,>99,>65,>0E
       byte >4F,>3B,>3E,>C5,>F0,>0E
       byte >54,>19,>3E,>A6,>7B,>0F
       byte >22,>F6,>3D,>3A,>06,>10
       byte >BB,>D1,>3D,>7E,>90,>10
       byte >1F,>AC,>3D,>6F,>1A,>11
       byte >50,>85,>3D,>0B,>A4,>11
