********************************************************************************
* Market prices
* 
* The goods' prices and availability, as in BBC Elite (QQ23), 5 bytes
* each: the base price; the economic factor (bit 7 its sign, bits 0-4
* its size) and the units (bits 5-6: 0 tonnes, 1 kilograms, 2 grams);
* the base quantity; a mask for the random variation (#R$EFAA); and how
* illegal the goods are. #R$4BA8 works out each system's market from
* them (#R$F789).
market_prices:                                             ; >0a02
       byte >13,>82,>06,>01,>00                                      ; Food
       byte >14,>81,>0A,>03,>00                                      ; Textiles
       byte >41,>83,>02,>07,>00                                      ; Radioactives
       byte >28,>85,>E2,>1F,>04                                      ; Slaves
       byte >53,>85,>FB,>0F,>00                                      ; Liquor/Wines
       byte >C4,>08,>36,>03,>00                                      ; Luxuries
       byte >EB,>1D,>08,>78,>04                                      ; Narcotics
       byte >9A,>0E,>38,>03,>00                                      ; Computers
       byte >75,>06,>28,>07,>00                                      ; Machinery
       byte >4E,>01,>11,>1F,>00                                      ; Alloys
       byte >9C,>0D,>1D,>07,>02                                      ; Firearms
       byte >B0,>89,>DC,>3F,>00                                      ; Furs
       byte >18,>A1,>60,>03,>00                                      ; Minerals
       byte >61,>A1,>42,>07,>00                                      ; Gold
       byte >AB,>A2,>37,>1F,>00                                      ; Platinum
       byte >2D,>C1,>FA,>0F,>00                                      ; Gem-Stones
       byte >35,>0F,>F8,>07,>00                                      ; Alien Items

********************************************************************************
* Keyboard key-code table
* 
* One byte per key, indexed by the linear (row*8+column) code that
* #R$3471 builds from the keyboard-matrix scan at #R$344F, for matrix
* rows 0-8 (codes $00-$47); each row is listed from column 7 down to 0.
* Mostly ASCII ("76543210", "JIHGFEDC", "RQPONMLK", ...), with control
* codes $0D/$09/$1B/$7F and the non-ASCII key bytes that #R$419B's
* dispatch table uses ($5B at code $0A, $80-$87 at codes $30-$46).
* #R$344F also scans row 9, but that row always reads $FF, so no code
* past $47 is ever looked up.
key_code_table:                                            ; >0a57
       byte >37,>36,>35,>34,>33,>32,>31,>30                          ; row 0
       byte >3B,>5D,>5B,>5C,>3F,>2D,>39,>38                          ; row 1
       byte >42,>41,>2D,>2F,>2E,>2C,>27,>60                          ; row 2
       byte >4A,>49,>48,>47,>46,>45,>44,>43                          ; row 3
       byte >52,>51,>50,>4F,>4E,>4D,>4C,>4B                          ; row 4
       byte >5A,>59,>58,>57,>56,>55,>54,>53                          ; row 5
       byte >82,>81,>80,>00,>00,>00,>00,>00                          ; row 6
       byte >0D,>85,>7F,>86,>09,>1B,>84,>83                          ; row 7
       byte >8A,>8B,>8C,>8D,>89,>88,>87,>20                          ; row 8

********************************************************************************
* Font: 8x8 character bitmaps for codes $20-$7F
* 
* 96 glyphs of 8 bytes each (one byte per pixel row, top row first, bit
* 7 leftmost), running from $0A9F to $0D9E, directly before the
* commodity name table at #R$0D9F. Most are standard ASCII shapes, but
* codes $5E-$60 hold an up arrow, a pound sign and a copyright sign, and
* codes $7E-$7F a checkerboard and a solid block. No code loads the
* table's address directly.
font:                                                      ; >0a9f
       byte >00,>00,>00,>00,>00,>00,>00,>00                          ; space
       byte >20,>20,>20,>20,>20,>00,>20,>00                          ; "!"
       byte >50,>50,>50,>00,>00,>00,>00,>00                          ; """
       byte >50,>50,>F8,>50,>F8,>50,>50,>00                          ; "#"
       byte >20,>78,>A0,>70,>28,>F0,>20,>00                          ; "$"
       byte >C0,>C8,>10,>20,>40,>98,>18,>00                          ; "%"
       byte >40,>A0,>A0,>40,>A8,>90,>68,>00                          ; "&"
       byte >20,>20,>20,>00,>00,>00,>00,>00                          ; "'"
       byte >20,>40,>80,>80,>80,>40,>20,>00                          ; "("
       byte >20,>10,>08,>08,>08,>10,>20,>00                          ; ")"
       byte >20,>A8,>70,>20,>70,>A8,>20,>00                          ; "*"
       byte >00,>20,>20,>F8,>20,>20,>00,>00                          ; "+"
       byte >00,>00,>00,>00,>00,>20,>20,>40                          ; ","
       byte >00,>00,>00,>F8,>00,>00,>00,>00                          ; "-"
       byte >00,>00,>00,>00,>00,>10,>00,>00                          ; "."
       byte >00,>08,>10,>20,>40,>80,>00,>00                          ; "/"
       byte >70,>88,>98,>A8,>C8,>88,>70,>00                          ; "0"
       byte >20,>60,>20,>20,>20,>20,>70,>00                          ; "1"
       byte >70,>88,>08,>10,>20,>40,>F8,>00                          ; "2"
