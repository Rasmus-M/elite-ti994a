**
* Macros
*
       .defm call
       li   r11,$+10
       mov  r11,*sp+
       b    #1
       .endm

       .defm ret
       dect sp
       mov  *sp,r11
       b    *r11
       .endm

       .defm proc
       mov  r11,*sp+
       .endm

       .defm endproc
       dect sp
       mov  *sp,r11
       b    *r11
       .endm

       .defm push
       mov  #1,*sp+
       .endm

       .defm pop
       dect sp
       mov  *sp,#1
       .endm

       .defm peek
       mov  @-2(sp),#1
       .endm

       .defm ldi
       movb *hl+,*de+
       dec  bc
       .endm

       .defm ldir
       bl   @ldir_pad
;!      movb *hl+,*de+
;       dec  bc
;       jne  -!
       .endm

       .defm lddr
!      movb *hl,*de
       dec  hl
       dec  de
       dec  bc
       jne  -!
       .endm

       .defm exx
       bl   @exx_routine
       .endm

       .defm ex_de_hl
       mov  de,r0
       mov  hl,de
       mov  r0,hl
       .endm

       .defm ex_af_af_
       mov  af,r0
       mov  af_,af
       mov  r0,af_
       .endm

       .defm ex_sp_hl
       mov  hl,r0
       mov  @-2(sp),hl
       mov  r0,@-2(sp)
       .endm

       .defm daa
       bl   @daa_routine
       .endm

       .defm halt
       nop
       .endm

       .defm rst
       .ifeq #1,>00
       .call @print_char                           ; JP $34A8          ; print character A
       .endif
       .ifeq #1,>08
       .call @rst_08_target_print_tokenised_string ; JP $357A          ; print a tokenised string at HL
       .endif
       .ifeq #1,>10
       .call @rst_10_target_print_ath_tokenised    ; JP $3588          ; print the A'th tokenised string in a list at HL
       .endif
       .ifeq #1,>18
       .call @rst_18_target_format_value_print     ; JP $36E1          ; format a value into $E717 and print it
       .endif
       .ifeq #1,>20
       .call @rst_20_target_print_list_positioned  ; JP $3596          ; print a list of positioned tokenised strings
       .endif
       .ifeq #1,>28
       .call @rst_28_target_draw_list_tile         ; JP $36F1          ; colour a list of rectangles
       .endif
       .ifeq #1,>30
       .call @ask_for_number                       ; JP $5AC7          ; ask for a number
       .endif
       .ifeq #1,>38
       .call @vblank_handler                       ; JP $7202          ; VBlank interrupt handler
       .endif
       .endm
