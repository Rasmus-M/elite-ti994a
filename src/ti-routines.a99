;       movb  r0,@vdpwa                 ; Send low byte of VDP RAM read address
;       swpb r0
;       andi r0,>3fff                   ; Set read/write bits 14 and 15 to read (00)
;       movb r0,@vdpwa                  ; Send high byte of VDP RAM read address
;       li   r0,vdprd
