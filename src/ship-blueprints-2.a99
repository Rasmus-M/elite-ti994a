       byte >3B,>4B,>C2,>18,>FF,>FF,>3B,>4B
       byte >80,>19

* Asp MkII: edge array (2 bytes/edge)
*
* 30 edges, each the numbers of the two vertices at its ends. The last two
* ($FE,$0A and $FB,$0B) are invisible edges: bit 7 of their first bytes is
* set, so #R$491A never draws them (and doesn't read their second bytes).
* They are listed in faces 5, 6, 12 and 13 (#R$AD1B), closing them.
ship_asp_mkii_edges:                                       ; >acdf
       byte >00,>01,>00,>04,>00,>07,>01,>02
       byte >02,>03,>03,>08,>08,>09,>06,>09
       byte >05,>06,>01,>05,>03,>04,>04,>08
