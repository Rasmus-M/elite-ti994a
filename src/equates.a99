**
* Memory mapped addresses
*
vdpwd:                                 ; VDP write data
       equ  >8c00
vdpwa:                                 ; VDP set read/write address
       equ  >8c02
vdprd:                                 ; VDP read data
       equ  >8800
vdpsta:                                ; VDP status
       equ  >8802
sound:                                 ; Sound
       equ  >8400
spchwt:
       equ  >9400
spchrd:
       equ  >9000
rndsd:
       equ  >83c0                      ; Random number seed
kscan:
       equ  >02b2

**
* Scratch pad
*
wrksp:
       equ  >8300
r0lb:
       equ  wrksp+1
r1lb:
       equ  wrksp+3
r2lb:
       equ  wrksp+5
bits:
       equ  wrksp+>20
bit0:
       equ  wrksp+>20
bit1:
       equ  bit0+2
bit2:
       equ  bit1+2
bit3:
       equ  bit2+2
bit4:
       equ  bit3+2
bit5:
       equ  bit4+2
bit6:
       equ  bit5+2
bit7:
       equ  bit6+2
b255:
       equ  bit7+2
b254:
       equ  b255+1
pad_vars:
       equ  b254+1
copy_space_view_row_pad:
       equ  pad_vars
clear_space_view_rows_pad:
       equ  copy_space_view_row_pad+>26   ; the size of copy_space_view_row
line_loops_pad:
       equ  clear_space_view_rows_pad+>20 ; the size of clear_space_view_rows
pad_max:
       equ  line_loops_pad+>48   ; the size of line_loops
pad_ws:                                ; The workspace of the music, sound effects, keyboard and joystick routines
       equ  pad_max
pad_ws_end:
       equ  pad_ws+>20
* The last 32 bytes of the scratchpad: the ship drawing routines' data, which is
* read and written faster there (no wait states)
rotation_matrix:                       ; The orientation, cached by cache_orientation: 9 words
       equ  pad_ws_end
face_q:                                ; The ship's position in its own frame, halved (face_setup): 3 words
       equ  rotation_matrix+18
face_p:                                ; and out of the view (x, y, 2 * z): 3 words
       equ  face_q+6
face_scale4:                           ; The face's scale * 4 (face_visible): a word. The scratchpad ends here
       equ  face_p+6

**
* Z80 register mapping
*
* r0-r2 scratch registers
*
one    requ 3                          ; >0100
zero   equ wrksp+7
af     requ 4
a      requ 4
f      equ wrksp+9
bc     requ 5
b      requ 5
c      equ wrksp+11
de     requ 6
d      requ 6
e      equ wrksp+13
hl     requ 7
h      requ 7
l      equ wrksp+15
ix     requ 8
ixh    requ 8
ixl    equ wrksp+17
iy     requ 9
iyh    requ 9
iyl    equ wrksp+19
sp     requ 10                         ; Stack pointer. Stack grows up.
splb   equ wrksp+21                    ; low byte of SP
af_    requ 12
a_     requ 12
bc_    requ 13
b_     requ 13
c_     equ wrksp+27
de_    requ 14
d_     requ 14
e_     equ wrksp+29
hl_    requ 15
h_     requ 15
l_     equ wrksp+31
r      requ 0

**
* VDP memory map
*
* As on the MSX (screen 2), but for the name table and the sprite tables: the
* disk controller's DSR keeps its buffers at the top of the VDP RAM (from
* >37D8, or >37D2 with a CF7 or a NanoPEB), so the two tables that are easy to set up again (the name table
* and the sprite attribute table) are there, and the sprite patterns are
* where the MSX has those two. The MSX addresses in the comments of the
* converted code ($1800, $1B00 and $3800) are the MSX's.
pattern_table:                         ; Pattern table
       equ  >0000
sprite_pattern_table:                  ; Sprite pattern table (MSX: $3800). Patterns 0-31 are used;
       equ  >1800                      ; the font for the view messages is at >1B80->1E7F (#R$3A03)
color_table:                           ; Color table
       equ  >2000
name_table:                            ; Name table (MSX: $1800)
       equ  >3800
sprite_attr_table:                     ; Sprite attribute table (MSX: $1B00)
       equ  >3b00
sprite_pattern_write_hi:               ; The high bytes of their addresses for writing (MSX: $78 and $5B)
       equ  sprite_pattern_table/256+>40
sprite_attr_write_hi:
       equ  sprite_attr_table/256+>40

**
* ROM bank selection
*
blueprints_1_bank_select:
       equ  >6008
blueprints_2_bank_select:
       equ  >600a
blueprints_2_first_type:               ; Ship types from here on are in bank 5
       equ  23
cockpit_picture_bank_select:
       equ  >600c
font_bank_select:
       equ  >600c
view_font_bank_select:                 ; The view messages' font (view-font.a99)
       equ  >600a
music_bank_select:
       equ  >600c
code_bank_7_select:                    ; Code (rom-bank-7.a99)
       equ  >600e
code_bank_8_select:                    ; Code (rom-bank-8.a99)
       equ  >6010
code_bank_9_select:                    ; Code (rom-bank-9.a99)
       equ  >6012
code_bank_10_select:                   ; Code (rom-bank-10.a99)
       equ  >6014
code_bank_11_select:                   ; Code (rom-bank-11.a99)
       equ  >6016
code_bank_12_select:                   ; Code (rom-bank-12.a99)
       equ  >6018
code_bank_13_select:                   ; Code (rom-bank-13.a99)
       equ  >601a
code_bank_14_select:                   ; Code (rom-bank-14.a99)
       equ  >601c

* The radius on screen below which a ship is drawn as a disc rather than in
* full (#R$4255), in flight and on the title screen: 4 on the MSX
small_ship_radius:
       equ  6
title_ship_radius:
       equ  2
* The most small ships shown as sprites at a time (ship_sprite)
ship_sprite_max:
       equ  8
