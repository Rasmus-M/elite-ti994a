*********************************************************************
*
* Faster replacement for LDIR
*
ti_ldir:
       mov  hl,r0                      ; Check source
       srl  r0,1
       joc  ti_ldir_3
       mov  de,r0                      ; Check destination
       srl  r0,1
       joc  ti_ldir_4
*      Source and destination are word aligned - use word copy
ti_ldir_1
       mov  bc,r0
       srl  r0,2
       jeq  ti_ldir_8
ti_ldir_2:
       mov  *hl+,*de+
       mov  *hl+,*de+
       dec  r0
       jne  ti_ldir_2
       jmp  ti_ldir_8                  ; Copy remainder as bytes
*      Source is not aligned
ti_ldir_3:
       mov  de,r0                      ; Check destination
       srl  r0,1
       jnc  ti_ldir_6
       jmp  ti_ldir_5
*      Destination is not aligned
ti_ldir_4:
       mov  hl,r0                      ; Check source
       srl  r0,1
       jnc  ti_ldir_6
*      Neither source or destination are aligned
ti_ldir_5:
       movb *hl+,*de+                  ; Write first byte, now both are aligned
       dec  bc
       jmp  ti_ldir_1
*      One of destination or source is not aligned - use an unrolled byte copy loop
ti_ldir_6:
       mov  bc,r0
       srl  r0,2
       jeq  ti_ldir_9
ti_ldir_7:
       movb *hl+,*de+
       movb *hl+,*de+
       movb *hl+,*de+
       movb *hl+,*de+
       dec  r0
       jne  ti_ldir_7
ti_ldir_8:
       andi bc,>0003
       jeq  ti_ldir_10
ti_ldir_9:
       movb *hl+,*de+
       dec  bc
       jne  ti_ldir_9
ti_ldir_10:
       rt
ti_ldir_end:
       equ  $
*// ti_ldir

