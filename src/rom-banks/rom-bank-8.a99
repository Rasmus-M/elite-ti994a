********************************************************************************
* Data on System: "There's a mean, nasty, vicious ship out there!"
* 
* Printed by #R$6164 instead of the system's description when the Constrictor
* is in the system (mission state $16, #R$E93D). A list of (column, row,
* string) records ending with $FF (see #R$3596).
msg_mean_nasty_vicious_ship:                               ; >585d
       text >05,>0f,'There''s a mean, nasty, viciou',>f3          ; 
       text >05,>10,'ship out there',>a1                          ; 
       byte >FF                                                   ; 

********************************************************************************
* Data on System headings
* 
* Printed by #R$6164. A list of (column, row, string) records ending with $FF
* (see #R$3596).
data_on_system_headings:                                   ; >5953
       text >05,>03,'Distance',>ba                                ; 
       text >05,>05,'Economy',>ba                                 ; 
       text >05,>06,'Government',>ba                              ; 
       text >05,>07,'Tech. Level',>ba                             ; 
       text >05,>09,'Population',>ba                              ; 
       text >05,>0c,'Gross Productivity',>ba                      ; 
       text >05,>0d,'Average Radius',>ba                          ; 
       byte >FF                                                   ; 

********************************************************************************
