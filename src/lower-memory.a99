       limi 0
       lwpi disk_ws                    ; (a workspace outside the scratchpad)
       li   r0,code_bank_14_select     ; (it is in ROM bank 14)
       seto *r0
       bl   @ti_save_console_state     ; keep the scratchpad as the console left it, for the disk DSR
       lwpi wrksp
       bl   @ti_setup_environment
       .select_bank code_bank_10_select ; the title screen is in ROM bank 10
       bl   @fill_explosion_random_numbers ; (from the MSX's one-time startup code, #R$6F9F)
       b    @title_screen

       copy "ti-routines.a99"
       copy "ti-tables.a99"
       copy "music-player.a99"
       copy "ti-disk.a99"

* The stack (TI-specific): 256 bytes, growing up (see the .push macro). It is in
* RAM rather than scratchpad (pad_stack, 48 bytes), since the system
* description (#R$9AB9) recurses up to 10 levels deep.
ram_stack:
       bss  >100

* The list of systems the chart routines (#R$502C) build (TI-specific: on the
* MSX it goes at ($EFA4), in memory freed by the startup code, which is not
* free on the TI): the systems, then 25 bytes on, their marker sizes.
chart_system_list:
       bss  >80

* Nonzero while #R$3793 XORs pixels rather than ORing them in (TI-specific: the
* MSX patches the OR opcode there, #R$541E).
plot_pixel_xor:
       byte 0

* The speed keys held (TI-specific: the MSX reads them in #R$401C), set by
* ti_read_joysticks: bit 0 SPACE (speed up), bit 1 '/' (slow down), bit 2 J
* (the Torus jump drive).
speed_keys:
       byte 0

* The working object saved by #R$3341 (TI-specific: the MSX uses $0080)
object_scratch:
       bss  >28

* The number of pieces an asteroid breaks up into (TI-specific: the MSX
* stores it in the asteroid blueprint, #R$2BAC, which is in ROM on the TI)
asteroid_pieces:
       byte 0
       even

* Space view bitmap buffer
*
* 128 rows of 32 bytes (256 pixels), one bit per pixel, of which the first
* 22 bytes (176 pixels) of each row are the space view. Everything in the
* view is drawn here, at $D600 + row * 32 + column / 8 (#R$3CEC): lines
* (#R$3C48), circles (#R$3D0E), discs (#R$3DF4), the stardust (#R$3CFD)
* and messages (#R$3A03). #R$388F clears it and #R$3846 copies it to the
* screen.
* .
* It's also used as scratch space: for the fuel range circle's sprite
* image (128 bytes at $D600, #R$4DAB); for the slot IDs #R$A511 saves at
* $D604 and $D605; and for a commander file read from tape (#R$A492,
* #R$A4CA): the name at $D606 (11 bytes) and the file at $D611 (128 bytes).
* The startup code (#R$6F9F) clears it, with everything up to $EFA9.
       even
space_view_buffer:                                         ; >d600
       equ  $
* TI: the buffer isn't part of the program image, as it would take 4K of the
* 32K cartridge the program is packed into, and it is cleared before it's
* used (#R$388F). So nothing may be assembled after this in low RAM.
tape_slot_page0:                                           ; >d604
       equ  space_view_buffer+>04                                    ; slot ID of page 0, during tape I/O (#R$A511; not used on the TI)
tape_slot_page1:                                           ; >d605
       equ  space_view_buffer+>05                                    ; slot ID of page 1, during tape I/O
tape_record:                                               ; >d606
       equ  space_view_buffer+>06                                    ; the commander record read from or written to disk: the name (11 bytes)
tape_record_data:                                          ; >d611
       equ  space_view_buffer+>11                                    ; its data, after the name (128 bytes)

lower_memory_max:
       equ  space_view_buffer+>1000
