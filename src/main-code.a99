********************************************************************************
* The message "Game Time: dd:hh:mm"
* 
* Shown by #R$1A8A, which first formats the days, hours and minutes of the
* game time (#R$F742) into the digits at $1BB1. The last digit ends the
* message (#R$3675 sets its bit 7).
msg_game_time:                                             ; >1ba6
       text 'Game Time: '                                         ; 
game_time_digits:                                          ; >1bb1
       text '00:00:00'                                            ; days, hours, minutes

********************************************************************************
* The message "Cargo lost"
msg_cargo_lost:                                            ; >1bb9
       text 'Cargo los',>f4                                       ; 

