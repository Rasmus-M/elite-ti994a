sound_effect_9:                                            ; >7872
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >08                                                      ; command 8: noise on
       byte >03,>0E                                                  ; command 3: volume 14
       byte >04,>1F                                                  ; command 4: countdown 31
       byte >00,>81,>78                                              ; command 0: per-frame handler #R$7881
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 9: per-frame handler
* 
* Uses #R$E897 as the noise period, lowering it by 4 each frame, and ends the
* effect (#R$740C) when it would drop below 0.
sound_effect_9_handler:                                    ; >7881
       movb @sound_channel_countdown,a                     ; LD A,($E897)      ; 
       sb   @bytes+>04,a                                   ; SUB $04           ; 
       jnc  !                                              ; JP C,$740C        ; TODO: check code. 
       b    @end_sound_effect                              ;                   
!
       movb a,@sound_channel_countdown                     ; LD ($E897),A      ; 
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       b    @write_psg_register                            ; JP $751D          ; 

********************************************************************************
* Sound effect 10: Torus Jump Drive
* 
* Started by #R$7468 (entry 10 of the effect table at #R$7AC6). Runs the
* script that follows (#R$753F), which sets #R$78A7 as the per-frame handler.
sound_effect_10:                                           ; >7892
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >02,>12,>00                                              ; command 2: tone period 18
       byte >04,>06                                                  ; command 4: countdown 6
       byte >06,>0A                                                  ; command 6: second parameter 10
       byte >05,>02                                                  ; command 5: parameter 2
       byte >03,>00                                                  ; command 3: volume 0
       byte >00,>A7,>78                                              ; command 0: per-frame handler #R$78A7
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect step: noise
* 
* Nothing calls this directly. If ($E89B) is 2, adds 2 to ($E898) and uses
* tone period $006E; otherwise (at $78B8) adds 1 to ($E89F), uses it as the
* noise period (PSG register 6, #R$751D) and turns the noise on (#R$749C).
* Then (at $78C9) sets the tone period (#R$74F6) and counts ($E89E) down.
sound_step_noise:                                          ; >78a7
       movb @sound_channel_parameter,a                     ; LD A,($E89B)      ; 
       cb   a,@bytes+>02                                   ; CP $02            ; the first stage (#R$E89B counts down from 2)?
       jne  continue_78a7_step_up_issue_command            ; JR NZ,$78B8       ; no
       li   hl,sound_channel_last_data                     ; LD HL,$E898       ; 
       ab   one,*hl                                        ; INC (HL)          ; 
       ab   one,*hl                                        ; INC (HL)          ; yes: turn the volume up by 2
       li   hl,>006e                                       ; LD HL,$006E       ; with tone period 110
       jmp  _78c9                                          ; JR $78C9          ; 
continue_78a7_step_up_issue_command:                       ; >78b8
       mov  @sound_channel_position,hl                     ; LD HL,($E89F)     ; no: raise #R$E89F by one...
       inc  hl                                             ; INC HL            ; 
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; 
       movb @l,a                                           ; LD A,L            ; ...and use it as the noise period
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       .call @write_psg_register                           ; CALL $751D        ; set the noise period (PSG register 6)
       .call @sound_cmd_noise_on                           ; CALL $749C        ; turn the noise on
_78c9:                                                     ; >78c9
       .call @write_16_bit_tone_period_psg                 ; CALL $74F6        ; set the tone period to HL (#R$74F6)
       li   hl,sound_channel_parameter_2                   ; LD HL,$E89E       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jne  _78d8                                          ; JR NZ,$78D8       ; 
       movb @bytes+>0e,*hl                                 ; LD (HL),$0E       ; every 14 frames...
       li   hl,sound_channel_last_data                     ; LD HL,$E898       ; 
       sb   one,*hl                                        ; DEC (HL)          ; ...turn the volume down by one
_78d8:                                                     ; >78d8
       movb @sound_channel_last_data,a                     ; LD A,($E898)      ; 
       .call @cache_write_channel_data_byte_sound          ; CALL $74EC        ; write the volume (#R$74EC)
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down the stage
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       movb @bytes+>a0,*hl                                 ; LD (HL),$A0       ; 160 frames a stage
       li   hl,sound_channel_parameter                     ; LD HL,$E89B       ; 
       sb   one,*hl                                        ; DEC (HL)          ; next stage
       jne  !                                              ; JP Z,$740C        ; the last - end the effect (#R$740C)
       b    @end_sound_effect                              ;                   
!
       .ret                                                ; RET               ; 

********************************************************************************
* Sound effect 11: launch
* 
* Started by #R$7468 (entry 11 of the effect table at #R$7AC6). Runs the
* script that follows (#R$753F), which sets #R$78FE as the per-frame handler.
sound_effect_11:                                           ; >78ed
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >03,>0F                                                  ; command 3: volume 15
       byte >04,>1E                                                  ; command 4: countdown 30
       byte >05,>0F                                                  ; command 5: parameter 15
       byte >08                                                      ; command 8: noise on
       byte >00,>FE,>78                                              ; command 0: per-frame handler #R$78FE
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 11: per-frame handler
* 
* Uses the countdown (#R$E897) as the noise period. Every 5 frames sets the
* volume to #R$E89B and lowers it by one, lowering the tone period (#R$E89F)
* by one too, and ends the effect (#R$740C) when the volume reaches 0. Also
* used by the second part of sound effect 12 (#R$793B).
sound_effect_11_handler:                                   ; >78fe
       movb @sound_channel_countdown,a                     ; LD A,($E897)      ; 
       movb a,@c                                           ; LD C,A            ; C = the countdown
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       .call @write_psg_register                           ; CALL $751D        ; as the noise period
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       movb @bytes+>05,*hl                                 ; LD (HL),$05       ; every 5 frames:
       movb @sound_channel_parameter,a                     ; LD A,($E89B)      ; 
       .call @cache_write_channel_data_byte_sound          ; CALL $74EC        ; set the volume to #R$E89B
       mov  @sound_channel_position,hl                     ; LD HL,($E89F)     ; 
       dec  hl                                             ; DEC HL            ; 
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; lower the tone period by one
       .call @write_16_bit_tone_period_psg                 ; CALL $74F6        ; set it
       li   hl,sound_channel_parameter                     ; LD HL,$E89B       ; 
       sb   one,*hl                                        ; DEC (HL)          ; turn the volume down
       jne  !                                              ; JP Z,$740C        ; 0 - end the effect (#R$740C)
       b    @end_sound_effect                              ;                   
!
       .ret                                                ; RET               ; 

********************************************************************************
* Sound effect 12: hyperspace
* 
* Started by #R$7468 (entry 12 of the effect table at #R$7AC6). Runs the
* script that follows (#R$753F), which sets #R$793B as the per-frame handler.
sound_effect_12:                                           ; >7926
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >09,>07,>00,>08                                          ; command 9: envelope period 7, shape 8
       byte >02,>AA,>00                                              ; command 2: tone period 170
       byte >04,>55                                                  ; command 4: countdown 85
       byte >05,>26                                                  ; command 5: parameter 38
       byte >00,>3B,>79                                              ; command 0: per-frame handler #R$793B
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 12: per-frame handler
* 
* Raises the tone period (#R$E89F) by one each frame, so the pitch falls. When
* the countdown (#R$E897) runs out, restarts it from #R$E89B, which goes down
* by 2 each time, with tone period 60. When that reaches 0, sets the tone
* period to 255, turns the noise on and runs the script at $796B, which
* switches to #R$78FE to fade the noise out.
sound_effect_12_handler:                                   ; >793b
       mov  @sound_channel_position,hl                     ; LD HL,($E89F)     ; 
       inc  hl                                             ; INC HL            ; 
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; raise the tone period by one
       .call @write_16_bit_tone_period_psg                 ; CALL $74F6        ; set it (#R$74F6)
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       movb @sound_channel_parameter,a                     ; LD A,($E89B)      ; 
       movb a,@sound_channel_countdown                     ; LD ($E897),A      ; restart the countdown from #R$E89B
       li   hl,>003c                                       ; LD HL,$003C       ; 
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; with tone period 60
       .call @write_16_bit_tone_period_psg                 ; CALL $74F6        ; 
       li   hl,sound_channel_parameter                     ; LD HL,$E89B       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       sb   one,*hl                                        ; DEC (HL)          ; lower #R$E89B by 2
       jeq  !                                              ; RET NZ            ; not 0 yet
       .ret                                                ;                   
!
       li   hl,>00ff                                       ; LD HL,$00FF       ; 
       mov  hl,@sound_channel_position                     ; LD ($E89F),HL     ; 
       .call @write_16_bit_tone_period_psg                 ; CALL $74F6        ; tone period 255
       .call @sound_cmd_noise_on                           ; CALL $749C        ; noise on (#R$749C)
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >04,>05                                                  ; command 4: countdown 5
       byte >05,>0F                                                  ; command 5: parameter 15
       byte >00,>FE,>78                                              ; command 0: per-frame handler #R$78FE
       byte >07                                                      ; command 7: end of script
       .ret                                                ; RET               ; 

********************************************************************************
* Sound effect 13: cargo scooped
* 
