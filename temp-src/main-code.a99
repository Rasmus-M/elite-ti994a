********************************************************************************
* Scale #R$3D0E's magnitude by one #R$1311 trig byte
* 
* Used by the routine at #R$3D0E.
* .
* Multiplies the mantissa #R$3D0E cached at $EB9C by the trig-table byte
* in E (#R$1F60: HL = A*E), then shifts the 16-bit product right by (7
* minus the shift count #R$3D0E cached at $EB9B) to restore the
* original magnitude's scale - undoing #R$1311's $80=1.0 fixed-point
* format and #R$3D0E's own mantissa-reducing shift in a single pass. A
* shift count of exactly 7 needs no further shift at all (#R$1F60's
* product is already correctly scaled) and returns immediately. A shift
* count over 8 (magnitude >= $8000, since #R$3D0E's count is the
* original high byte's bit length) makes A wrap negative here, so B
* becomes a large positive value and the DJNZ loop shifts far past
* zero - silently collapsing the result to 0 rather than clamping; not
* confirmed whether #R$3D0E's callers ever reach that far.
* 
* I:E A trig-table byte (cos or sin, #R$1311's format)
* O:HL The magnitude, scaled by E/$80
scale_by_trig_byte:                                        ; >3d76
       movb @shared_normalize_mantissa,a                   ; LD A,($EB9C)      ; A = the cached mantissa
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = mantissa * E (the trig byte)
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; A = the cached shift count
       sb   @bytes+>07,a                                   ; SUB $07           ; 
       neg a                                               ; NEG               ; A = 7 - shift count
       jne  !                                              ; RET Z             ; already correctly scaled - done
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; B = the remaining shift count
_3d85:                                                     ; >3d85
       srl  h,1                                            ; SRL H             ; shift HL right...
       ; RR L                                              ; RR L              ; TODO: check code. ...one bit at a time
       sb   one,b                                          ; DJNZ $3D85        ; 
       jne  _3d85                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a circle: a point
* 
* Used by the routine at #R$3D0E.
* .
* Adds the offset (DE, BC) to the centre ($E81F, $E821). On the first step
* (($E80C) set) just stores the point in the 4-byte slot below HL;
* otherwise (at $3DAC) draws the line (#R$3AC2) to it from the point stored
* there - the same quadrant's point from the step before - and stores the
* new one. Uses SP to read and write the slot.
* 
* I:BC y offset
* I:DE x offset
* I:HL The slot
* O:HL The next slot
draw_circle_point:                                         ; >3d8c
       limi 0                                              ; DI                ; repurposing SP - no interrupts while it's not a real stack pointer
       mov  sp,@circle_saved_sp                            ; LD ($E81D),SP     ; stash the real SP
       mov  hl,sp                                          ; LD SP,HL          ; SP = this call's slot cursor
       movb @circle_first_step,a                           ; LD A,($E80C)      ; still the first step (nothing in the slot to connect to yet)?
       socb a,a                                            ; OR A              ; 
       jeq  write_vertex_and_draw_edge                     ; JR Z,$3DAC        ; no - read the slot and draw the line
       mov  @circle_centre_x,hl                            ; LD HL,($E81F)     ; HL = the cached centre X
       a    de,hl                                          ; ADD HL,DE         ; + this step's cos-scaled offset
       .push hl                                            ; PUSH HL           ; write the vertex's X, 2 bytes below the cursor
       mov  @circle_centre_y,hl                            ; LD HL,($E821)     ; HL = the cached centre Y
       a    bc,hl                                          ; ADD HL,BC         ; + this step's sin-scaled offset
       .push hl                                            ; PUSH HL           ; write the vertex's Y, 4 bytes below the cursor
       li   hl,>0000                                       ; LD HL,$0000       ; 
       a    sp,hl                                          ; ADD HL,SP         ; HL = the new cursor (old cursor - 4), for next step's call to this slot
       mov  @circle_saved_sp,sp                            ; LD SP,($E81D)     ; restore the real SP
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 
write_vertex_and_draw_edge:                                ; >3dac
       .pop hl                                             ; POP HL            ; HL = the slot's old Y (this call's vertex from last step)
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; -> point 2's Y
       .pop hl                                             ; POP HL            ; HL = the slot's old X (this call's vertex from last step)
       mov  hl,@clip_point2_x                              ; LD ($EB96),HL     ; -> point 2's X
       mov  @circle_centre_x,hl                            ; LD HL,($E81F)     ; HL = the cached centre X
       a    de,hl                                          ; ADD HL,DE         ; + this step's cos-scaled offset
       mov  hl,@clip_point1_x                              ; LD ($EB92),HL     ; -> point 1's X
       .push hl                                            ; PUSH HL           ; also overwrite the slot with it, for next step's call to this slot
       mov  @circle_centre_y,hl                            ; LD HL,($E821)     ; HL = the cached centre Y
       a    bc,hl                                          ; ADD HL,BC         ; + this step's sin-scaled offset
       mov  hl,@clip_point1_y                              ; LD ($EB94),HL     ; -> point 1's Y
       .push hl                                            ; PUSH HL           ; also overwrite the slot with it, for next step's call to this slot
       li   hl,>fffc                                       ; LD HL,$FFFC       ; 
       a    sp,hl                                          ; ADD HL,SP         ; HL = the new cursor (old cursor - 4)
       mov  @circle_saved_sp,sp                            ; LD SP,($E81D)     ; restore the real SP
       ; EI                                                ; EI                ; TODO: check code. 
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; save this call's live registers across the line-draw call
       .call @clip_and_draw_line                           ; CALL $3AC2        ; clip and draw the edge from point 1 to point 2
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Clip-test and plot a single point [line-draw]
* 
* Used by the routine at #R$4AEC.
* .
* The single-point counterpart of #R$3AC2's line-clip pipeline: biases
* DE/HL into #R$3A72's unsigned comparison range and tests the outcode;
* if the point fails any true boundary, it's off-screen and this returns
* without drawing. Otherwise converts it to screen space the same way
* #R$3C29 does for its first endpoint (the $0300 column-lookup table
* plus $57, and the $40-row mirror) and plots it via #R$3CFD.
* 
* I:D/E Raw X, high/low byte (D gets biased by #R$3A72's own convention)
* I:H/L Raw Y, high/low byte (H gets biased likewise)
clip_test_and_plot_single_point:                           ; >3dd7
       movb d,a                                            ; LD A,D            ; A = X's high byte
       ab   @bytes+>80,a                                   ; ADD A,$80         ; bias it into the unsigned comparison range
       movb a,d                                            ; LD D,A            ; 
       movb h,a                                            ; LD A,H            ; A = Y's high byte
       ab   @bytes+>80,a                                   ; ADD A,$80         ; bias it likewise
       movb a,h                                            ; LD H,A            ; 
       .call @outcode                                      ; CALL $3A72        ; C = this point's outcode
       movb @c,a                                           ; LD A,C            ; 
       andi a,>0f00                                        ; AND $0F           ; keep only the true outcode bits
       jeq  !                                              ; RET NZ            ; off-screen - nothing to plot
       .ret                                                ;                   
!
       movb @bytes+>40,a                                   ; LD A,$40          ; 
       sb   @l,a                                           ; SUB L             ; A = $40 - raw row (the same row mirror #R$3C29 uses)
       movb a,b                                            ; LD B,A            ; B = screen-space row
       movb @e,@l                                          ; LD L,E            ; L = raw column (X's low byte)
       movb @bytes+>03,h                                   ; LD H,$03          ; H = $03 - point HL at the $0300 column-lookup table
       movb *hl,a                                          ; LD A,(HL)         ; A = table[column]
       ab   @bytes+>57,a                                   ; ADD A,$57         ; 
       movb a,@c                                           ; LD C,A            ; C = screen-space column
       b    @plot_single_pixel                             ; JP $3CFD          ; plot the pixel at (B,C)

********************************************************************************
* Draw a filled disc
* 
* Used by the routine at #R$4A86.
* .
* Draws the sun, or any other object too small or far away to draw as a
* wireframe (#R$4A86), as a filled disc of radius HL (under 256) around
* (IX, IY), with a ragged edge: up to 2 pixels for the sun (ship type $65),
* 1 otherwise ($E604). Takes 10 steps of 10 degrees through the cos/sin
* table at #R$1311, scaling each (cos, sin) by the radius (#R$1F60), and
* (at $3E58) fills the part of the disc between each step's point and the
* one before (#R$3E6A).
* 
* I:HL Radius (#R$EB9E)
* I:IX Centre x
* I:IY Centre y
draw_disc:                                                 ; >3df4
       movb h,a                                            ; LD A,H            ; A = the magnitude's high byte
       socb a,a                                            ; OR A              ; fits in a byte?
       jeq  !                                              ; RET NZ            ; no - out of range for this routine, do nothing
       .ret                                                ;                   
!
       movb a,@scratch_buffer                              ; LD ($E600),A      ; A=0: reset the row-fill countdown (see prose)
       movb a,@lineplot_scratch_vars_e603                  ; LD ($E603),A      ; and the running sign-accumulator
       movb @l,a                                           ; LD A,L            ; A = the magnitude (fits in a byte)
       movb a,@shared_normalize_mantissa                   ; LD ($EB9C),A      ; cache it as the mantissa for #R$1F60's multiply
       movb a,@circle_first_step                           ; LD ($E80C),A      ; also seed the "first step" flag with it
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>65                                   ; CP $65            ; is it mode $65?
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       jeq  _3e0e                                          ; JR Z,$3E0E        ; yes - type 2
       sb   one,a                                          ; DEC A             ; no - type 1
_3e0e:                                                     ; >3e0e
       movb a,@scratch_buffer_4                            ; LD ($E604),A      ; cache the type
       li   bc,>8000                                       ; LD BC,$8000       ; 
       a    bc,ix                                          ; ADD IX,BC         ; bias the centre X into clip-space convention
       mov  ix,@circle_centre_x                            ; LD ($E81F),IX     ; cache it
       a    bc,iy                                          ; ADD IY,BC         ; bias the centre Y likewise
       mov  iy,@circle_centre_y                            ; LD ($E821),IY     ; cache it
       li   iy,partial_byte_right_mask_table_8             ; LD IY,$4014       ; IY -> #R$4014's partial-byte mask table (fixed for the whole call tree)
       li   hl,trig_table_coarse                           ; LD HL,$1311       ; HL -> #R$1311's trig table
       movb @bytes+>0a,b                                   ; LD B,$0A          ; 10 steps
_3e29:                                                     ; >3e29
       .push bc                                            ; PUSH BC           ; save the outer step counter
       movb *hl,@c                                         ; LD C,(HL)         ; C = this step's cos byte
       inc  hl                                             ; INC HL            ; 
       movb *hl,@e                                         ; LD E,(HL)         ; E = this step's sin byte
       inc  hl                                             ; INC HL            ; HL now points past this step's record
       .push hl                                            ; PUSH HL           ; save the table pointer
       movb @shared_normalize_mantissa,a                   ; LD A,($EB9C)      ; A = the cached mantissa
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = mantissa * sin byte
       movb h,a                                            ; LD A,H            ; fold the 16-bit product into an 8-bit scaled value...
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       .ex_af_af_                                          ; EX AF,AF'         ; ...and stash it
       movb @shared_normalize_mantissa,a                   ; LD A,($EB9C)      ; A = the cached mantissa again
       movb @c,@e                                          ; LD E,C            ; E = this step's cos byte
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = mantissa * cos byte
       movb h,a                                            ; LD A,H            ; fold it the same way...
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       movb a,@c                                           ; LD C,A            ; C = the scaled cos value
       .ex_af_af_                                          ; EX AF,AF'         ; A = the scaled sin value (stashed above)
       movb a,b                                            ; LD B,A            ; B = the scaled sin value
       movb @circle_first_step,a                           ; LD A,($E80C)      ; still the first step (nothing to connect to yet)?
       socb a,a                                            ; OR A              ; 
       jeq  fill_disc_connect_to_previous_step             ; JR Z,$3E58        ; no - go connect to the previous step
       mov  bc,@circle_previous_points                     ; LD ($E80D),BC     ; yes - just cache this (scaled cos, scaled sin) pair for next step
       sb   a,a                                            ; XOR A             ; 
       movb a,@circle_first_step                           ; LD ($E80C),A      ; clear the "first step" flag
       jmp  _3e63                                          ; JR $3E63          ; nothing to connect to yet
fill_disc_connect_to_previous_step:                        ; >3e58
       mov  @circle_previous_points,de                     ; LD DE,($E80D)     ; DE = the previous step's scaled (cos,sin) pair
       mov  bc,@circle_previous_points                     ; LD ($E80D),BC     ; cache this step's pair for next time
       .call @draw_disc_fill_between_steps                 ; CALL $3E6A        ; fill the band between the two points
_3e63:                                                     ; >3e63
       .pop hl                                             ; POP HL            ; HL = the table pointer
       .pop bc                                             ; POP BC            ; BC = the outer step counter
       inc  hl                                             ; INC HL            ; advance past this step's 2-byte record
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $3E29        ; loop for the next step
       jne  _3e29                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a filled disc: fill between two steps
* 
* Used by the routine at #R$3DF4.
* .
* Walks the rows between the previous step's point and this one's, as a
* Bresenham line (a steep one at $3E92), filling each row's span (#R$3EAD).
draw_disc_fill_between_steps:                              ; >3e6a
       movb @e,a                                           ; LD A,E            ; A = the previous step's scaled sin (dy-ish component)
       sb   @c,a                                           ; SUB C             ; A -= this step's scaled sin
       movb one,@l                                         ; LD L,$01          ; 
       movb a,@e                                           ; LD E,A            ; E = the row delta
       movb b,a                                            ; LD A,B            ; A = the previous step's scaled cos
       sb   d,a                                            ; SUB D             ; A -= this step's scaled cos
       movb a,d                                            ; LD D,A            ; D = the column delta
       movb @e,a                                           ; LD A,E            ; A = the row delta
       cb   a,d                                            ; CP D              ; compare against the column delta
       jl   fill_disc_span_walk_y_major                    ; JR C,$3E92        ; row delta smaller - a steep line
       movb @e,h                                           ; LD H,E            ; H = row delta (Bresenham error term init)
       srl  h,1                                            ; SRL H             ; H = row delta / 2
       movb @e,a                                           ; LD A,E            ; A = the row delta (also the loop count)
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; nothing to fill
       .ret                                                ;                   
!
       movb a,@ixl                                         ; LD IXL,A          ; IXl = loop count
draw_disc_next_row:                                        ; >3e7e
       movb @c,a                                           ; LD A,C            ; A = the column so far
       ab   @l,a                                           ; ADD A,L           ; step it by 1 (L=1)
       movb a,@c                                           ; LD C,A            ; 
       movb h,a                                            ; LD A,H            ; error term
       sb   d,a                                            ; SUB D             ; -= column delta
       jnc  _3e87                                          ; JR NC,$3E87       ; TODO: check code. still non-negative - no row step this iteration
       sb   one,b                                          ; DEC B             ; underflowed - step the row
       ab   @e,a                                           ; ADD A,E           ; and correct the error term
_3e87:                                                     ; >3e87
       movb a,h                                            ; LD H,A            ; H = corrected error term
       .call @draw_disc_fill_row                           ; CALL $3EAD        ; fill this row's span at (B,C)
       sb   one,@ixl                                       ; DEC IXL           ; one fewer column to go
       jeq  !                                              ; JP NZ,$3E7E       ; loop
       b    @draw_disc_next_row                            ;                   
!
       jmp  _3eac                                          ; JR $3EAC          ; done
fill_disc_span_walk_y_major:                               ; >3e92
       movb d,h                                            ; LD H,D            ; H = column delta (Bresenham error term init)
       srl  h,1                                            ; SRL H             ; H = column delta / 2
       movb d,a                                            ; LD A,D            ; A = column delta (also the loop count)
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; nothing to fill
       .ret                                                ;                   
!
       movb a,@ixl                                         ; LD IXL,A          ; IXl = loop count
_3e9a:                                                     ; >3e9a
       sb   one,b                                          ; DEC B             ; step the row (every time)
       movb h,a                                            ; LD A,H            ; error term
       sb   @e,a                                           ; SUB E             ; -= row delta
       movb a,h                                            ; LD H,A            ; 
       jnc  _3ea5                                          ; JR NC,$3EA5       ; TODO: check code. still non-negative - no column step this iteration
       ab   d,a                                            ; ADD A,D           ; underflowed - correct the error term
       movb a,h                                            ; LD H,A            ; 
       movb @c,a                                           ; LD A,C            ; column so far
       ab   @l,a                                           ; ADD A,L           ; step it by 1
       movb a,@c                                           ; LD C,A            ; 
_3ea5:                                                     ; >3ea5
       .call @draw_disc_fill_row                           ; CALL $3EAD        ; fill this row's span at (B,C)
       sb   one,@ixl                                       ; DEC IXL           ; one fewer row to go
       jne  _3e9a                                          ; JR NZ,$3E9A       ; loop
_3eac:                                                     ; >3eac
       .ret                                                ; RET               ; done

********************************************************************************
* Draw a filled disc: fill a row
* 
* Used by the routine at #R$3E6A.
* .
* Makes the disc's edge ragged: every 16 rows, picks new random bits
* (#R$2176); otherwise (at $3EC4) shifts the old ones ($E601). Each bit
* moves the edge's offset ($E603) out or in by a pixel, between 0 and the
* maximum in $E604. At $3EE4, works out the row's span from the centre
* plus and minus the half-width and that offset, clipped to the space view,
* and fills it (#R$3F68).
draw_disc_fill_row:                                        ; >3ead
       .push bc                                            ; PUSH BC           ; save (row, column)
       .push de                                            ; PUSH DE           ; save (row delta, column delta)
       .push hl                                            ; PUSH HL           ; 
       movb @scratch_buffer,a                              ; LD A,($E600)      ; A = the row-fill countdown
       socb a,a                                            ; OR A              ; 
       jne  fill_disc_decay_dither_value                   ; JR NZ,$3EC4       ; not time to reseed - decay the existing value
       .push bc                                            ; PUSH BC           ; time to reseed: save (row, column) again across the RNG calls
       .call @random_byte                                  ; CALL $2176        ; A = a random byte
       movb a,@l                                           ; LD L,A            ; L = it
       .call @random_byte                                  ; CALL $2176        ; A = another random byte
       movb a,h                                            ; LD H,A            ; H = it - (H,L) is the fresh jitter seed
       .pop bc                                             ; POP BC            ; restore (row, column)
       movb @bytes+>10,a                                   ; LD A,$10          ; reset the countdown to 16
       jmp  _3ec7                                          ; JR $3EC7          ; join the shared tail
fill_disc_decay_dither_value:                              ; >3ec4
       mov  @scratch_buffer_1,hl                           ; LD HL,($E601)     ; HL = the previous jitter seed
_3ec7:                                                     ; >3ec7
       sb   one,a                                          ; DEC A             ; one fewer call before the next reseed
       movb a,@scratch_buffer                              ; LD ($E600),A      ; store the countdown back
       movb @scratch_buffer_4,a                            ; LD A,($E604)      ; A = #R$3DF4's "type" value (1 or 2)
       movb a,@e                                           ; LD E,A            ; E = it
       sra  h,1                                            ; RR H              ; TODO: check code. shift the jitter seed right by one bit...
       ; RR L                                              ; RR L              ; TODO: check code. ...(fresh or decayed, either way)
       mov  hl,@scratch_buffer_1                           ; LD ($E601),HL     ; store the decayed seed back for next time
       sb   a,a                                            ; SBC A,A           ; A = 0 or $FF, from the shift's final carry
       jne  _3eda                                          ; JR NZ,$3EDA       ; $FF - keep it
       ab   one,a                                          ; INC A             ; 0 - bump to 1 (never a zero jitter step)
_3eda:                                                     ; >3eda
       li   hl,lineplot_scratch_vars_e603                  ; LD HL,$E603       ; -> the running sign-accumulator
       ab   *hl,a                                          ; ADD A,(HL)        ; add this step's +-1 jitter to it
       jlt  !                                              ; JP P,$3EE4        ; still non-negative - go compute the span
       b    @fill_disc_row_span_bounds                     ;                   
!
       sb   a,a                                            ; XOR A             ; negative - clamp to 0
       jmp  _3ee8                                          ; JR $3EE8          ; 
fill_disc_row_span_bounds:                                 ; >3ee4
       cb   a,@e                                           ; CP E              ; does the jittered value exactly hit the "type" value?
       jne  _3ee8                                          ; JR NZ,$3EE8       ; no - keep it
       sb   one,a                                          ; DEC A             ; yes - nudge it down by one
_3ee8:                                                     ; >3ee8
       movb a,*hl                                          ; LD (HL),A         ; store the clamped jitter value back to $E603
       ab   @c,a                                           ; ADD A,C           ; A = jitter + column
       movb a,@c                                           ; LD C,A            ; 
       mov  bc,@disc_row_half_width                        ; LD ($E823),BC     ; cache this row's (jitter+column, row) offset pair
       sb   b,b                                            ; LD B,$00          ; 
       mov  @circle_centre_x,hl                            ; LD HL,($E81F)     ; HL = the cached centre X
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; HL = centre X - offset (left bound, raw)
       .ex_de_hl                                           ; EX DE,HL          ; DE = left bound
       li   hl,>7f8a                                       ; LD HL,$7F8A       ; clip window test (near side)...
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _3f64                                          ; JR C,$3F64        ; TODO: check code. out of range - skip this bound
       li   hl,>8074                                       ; LD HL,$8074       ; ...and far side
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _3f06                                          ; JR C,$3F06        ; TODO: check code. in range
       movb @bytes+>8c,@e                                  ; LD E,$8C          ; clamp to the boundary
_3f06:                                                     ; >3f06
       movb @bytes+>03,d                                   ; LD D,$03          ; D=$03 - point DE at the $0300 column-lookup table
       movb *de,a                                          ; LD A,(DE)         ; A = table[column]
       ab   @bytes+>57,a                                   ; ADD A,$57         ; 
       movb a,@clip_point1_x                               ; LD ($EB92),A      ; cache the left bound's screen column
       mov  @circle_centre_x,hl                            ; LD HL,($E81F)     ; HL = the cached centre X again
       mov  @disc_row_half_width,bc                        ; LD BC,($E823)     ; BC = the offset pair
       sb   b,b                                            ; LD B,$00          ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL = centre X + offset (right bound, raw)
       dec  hl                                             ; DEC HL            ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = right bound
       li   hl,>8074                                       ; LD HL,$8074       ; clip window test (far side)...
       a    de,hl                                          ; ADD HL,DE         ; 
       jnc  _3f64                                          ; JR NC,$3F64       ; TODO: check code. out of range - skip
       li   hl,>7f8a                                       ; LD HL,$7F8A       ; ...and near side
       a    de,hl                                          ; ADD HL,DE         ; 
       jnc  _3f28                                          ; JR NC,$3F28       ; TODO: check code. in range
       movb @bytes+>75,@e                                  ; LD E,$75          ; clamp to the boundary
_3f28:                                                     ; >3f28
       movb @bytes+>03,d                                   ; LD D,$03          ; D=$03 - point DE at the $0300 column-lookup table
       movb *de,a                                          ; LD A,(DE)         ; A = table[column]
       ab   @bytes+>57,a                                   ; ADD A,$57         ; 
       movb a,@clip_point2_x                               ; LD ($EB96),A      ; cache the right bound's screen column
       mov  @disc_row_offset,bc                            ; LD BC,($E824)     ; BC = this row's row offset
       mov  @circle_centre_y,hl                            ; LD HL,($E821)     ; HL = the cached centre Y
       a    bc,hl                                          ; ADD HL,BC         ; HL = centre Y + row offset (one edge's row)
       movb @l,a                                           ; LD A,L            ; test it against the vertical clip window...
       sb   @bytes+>c1,a                                   ; SUB $C1           ; 
       movb h,a                                            ; LD A,H            ; 
       sb   @bytes+>7f,a                                   ; SBC A,$7F         ; 
       joc  _3f49                                          ; JR C,$3F49        ; TODO: check code. below it - skip this edge's draw
       movb @l,a                                           ; LD A,L            ; 
       sb   @bytes+>41,a                                   ; SUB $41           ; 
       movb h,a                                            ; LD A,H            ; 
       sb   @bytes+>80,a                                   ; SBC A,$80         ; 
       ; CALL C,$3F68                                      ; CALL C,$3F68      ; TODO: check code. in range - draw the left/right span at this row
_3f49:                                                     ; >3f49
       mov  @disc_row_offset,bc                            ; LD BC,($E824)     ; BC = this row's row offset again
       mov  @circle_centre_y,hl                            ; LD HL,($E821)     ; HL = the cached centre Y
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; HL = centre Y - row offset (the other edge's row)
       movb @l,a                                           ; LD A,L            ; test it against the same window...
       sb   @bytes+>c1,a                                   ; SUB $C1           ; 
       movb h,a                                            ; LD A,H            ; 
       sb   @bytes+>7f,a                                   ; SBC A,$7F         ; 
       joc  _3f64                                          ; JR C,$3F64        ; TODO: check code. below it - skip
       movb @l,a                                           ; LD A,L            ; 
       sb   @bytes+>41,a                                   ; SUB $41           ; 
       movb h,a                                            ; LD A,H            ; 
       sb   @bytes+>80,a                                   ; SBC A,$80         ; 
       ; CALL C,$3F68                                      ; CALL C,$3F68      ; TODO: check code. in range - draw the span at this row too
_3f64:                                                     ; >3f64
       .pop hl                                             ; POP HL            ; restore (row delta, column delta)
       .pop de                                             ; POP DE            ; restore (row, column)
       .pop bc                                             ; POP BC            ; restore the outer step counter/loop state
       .ret                                                ; RET               ; 

********************************************************************************
* Fill one row's span in the #R$D600 bitmap, left-partial-byte end
* 
* Used by the routine at #R$3EAD.
* .
* Converts (B,C) - a row and a starting column - to a buffer address via
* #R$3CEC, then fills from that column to the end of the span (B = the
* span's byte-length beyond the first byte). If the span fits inside one
* byte (the "C AND $07 = 0" case at $3F82), jumps straight to #R$3FAA to
* handle it as a whole-byte run instead. Otherwise ORs in a partial mask
* from #R$E700 (the same single-bit-position table #R$3CFD/#R$3C48 use)
* combined with #R$4014's partial-byte mask (patched in via IY's
* self-modified displacement, see #R$4014's own comment) for this byte's
* leading partial coverage, then falls into $3F9F to fill the remaining
* whole/trailing bytes.
* .
* At $3F9F, once the span crosses into further bytes, ORs in the leading
* byte's remaining coverage (#R$4014's mask via the patched (IY+d)
* displacement), steps to the next buffer byte, then falls into the shared
* tail at #R$3FAA to fill the rest.
* 
* I:HL The row's row-offset/column pair, from #R$3EE4's arithmetic
* I:B/C Row / starting column
fill_disc_row_span_left_byte:                              ; >3f68
       li   bc,>7fc0                                       ; LD BC,$7FC0       ; bias the row into #R$3CEC's row range
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb @l,a                                           ; LD A,L            ; 
       neg a                                               ; NEG               ; 
       movb a,b                                            ; LD B,A            ; B = the biased row
       movb @clip_point1_x,a                               ; LD A,($EB92)      ; A = the left bound's screen column
       movb a,@c                                           ; LD C,A            ; 
       movb @clip_point2_x,a                               ; LD A,($EB96)      ; A = the right bound's screen column
       movb a,d                                            ; LD D,A            ; 
       .call @row_column_to_buffer_address                 ; CALL $3CEC        ; HL = buffer address for (B, left column)
       movb d,a                                            ; LD A,D            ; A = right column
       sb   @c,a                                           ; SUB C             ; A -= left column
       ab   one,a                                          ; INC A             ; A = span length in pixels
       movb a,b                                            ; LD B,A            ; B = remaining pixel count
       movb @c,a                                           ; LD A,C            ; A = left column
       andi a,>0700                                        ; AND $07           ; bit position within the byte
       jeq  _3faa                                          ; JR Z,$3FAA        ; span starts on a byte boundary - whole-byte path (#R$3FAA)
       movb a,@c                                           ; LD C,A            ; C = bit position
       movb b,a                                            ; LD A,B            ; A = remaining pixel count
       ab   @c,a                                           ; ADD A,C           ; + bit position
       sb   @bytes+>08,a                                   ; SUB $08           ; - 8 (does the span cross into a further byte?)
       jnc  fill_disc_row_span_remaining_bytes             ; JR NC,$3F9F       ; TODO: check code. yes - fill the rest
       ab   @bytes+>07,a                                   ; ADD A,$07         ; no - the whole span fits in this one partial byte
       movb a,@fill_span_start_mask+>0001                  ; LD ($3F91),A      ; patch the mask lookup's address (#R$3F90+1)
fill_span_start_mask:                                      ; >3f90
       movb @pixel_bitmask_table,a                         ; LD A,($E700)      ; A = the single-bit mask for the starting position
       movb a,b                                            ; LD B,A            ; B = it
       movb @c,a                                           ; LD A,C            ; A = the bit position again
       movb a,@fill_span_one_byte_mask+>0002               ; LD ($3F9A),A      ; patch the displacement (#R$3F98+2)
fill_span_one_byte_mask:                                   ; >3f98
       movb *iy,a                                          ; LD A,(IY+$00)     ; A = #R$4014's mask for that displacement
       ; AND B                                             ; AND B             ; TODO: check code. combine the two masks (span confined to this byte)
       socb *hl,a                                          ; OR (HL)           ; OR into the buffer byte
       movb a,*hl                                          ; LD (HL),A         ; 
       .ret                                                ; RET               ; 
fill_disc_row_span_remaining_bytes:                        ; >3f9f
       movb a,b                                            ; LD B,A            ; B = the remaining pixel count minus the leading byte's share
       movb @c,a                                           ; LD A,C            ; A = the bit position within the leading byte
       movb a,@fill_span_first_byte_mask+>0002             ; LD ($3FA6),A      ; patch the displacement (#R$3FA4+2)
fill_span_first_byte_mask:                                 ; >3fa4
       movb *iy,a                                          ; LD A,(IY+$00)     ; A = #R$4014's mask for that displacement
       socb *hl,a                                          ; OR (HL)           ; OR into the leading byte
       movb a,*hl                                          ; LD (HL),A         ; 
       ab   one,@l                                         ; INC L             ; step to the next buffer byte
_3faa:                                                     ; >3faa
       movb b,a                                            ; LD A,B            ; A = the remaining pixel count
       srl  a,1                                            ; RRA               ; TODO: check code. divide by 8 (whole bytes left)...
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; ...keeping 5 bits (up to 31 whole bytes)
       jne  !                                              ; JP Z,$4007        ; none left - go handle just the trailing partial byte (#R$4007)
       b    @fill_disc_row_span_trailing_byte              ;                   
!
       ab   a,a                                            ; ADD A,A           ; double it back to a byte count
       movb a,@c                                           ; LD C,A            ; 
       sb   @bytes+>40,a                                   ; SUB $40           ; work out how far into #R$3FC7 to jump
       neg a                                               ; NEG               ; 
       movb a,@fill_span_jump+>0001                        ; LD ($3FC6),A      ; patch the JR (#R$3FC5+1)
       movb @c,a                                           ; LD A,C            ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       sb   b,a                                            ; SUB B             ; 
       neg a                                               ; NEG               ; 
       movb a,b                                            ; LD B,A            ; 
       movb @b255,a                                        ; LD A,$FF          ; fill with all pixels set
fill_span_jump:                                            ; >3fc5
       jmp  fill_span_jump                                 ; JR $3FC5          ; jump into #R$3FC7 (patched above)

********************************************************************************
* Fill one row's span: whole bytes
* 
* Thirty-two copies of `LD (HL),A / INC L`. #R$3F68 (at $3FB9) patches the
* JR at $3FC5 to jump to the copy that leaves the number of whole bytes
* still to fill, so that they are filled with A ($FF); then #R$4007 fills
* the trailing partial byte.
fill_disc_row_span_whole_bytes:                            ; >3fc7
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 
       movb a,*hl                                          ; LD (HL),A         ; fill the next byte
       ab   one,@l                                         ; INC L             ; 

********************************************************************************
* Fill one row's span, trailing partial byte
* 
* Used by the routine at #R$3F68.
* .
* #R$3F9F/#R$3F68's final step: B holds the trailing byte's own pixel
* count (0 if the span ended exactly on a byte boundary, nothing to
* do). Otherwise looks up #R$4014's partial-byte mask for that count,
* complements it (CPL - #R$4014's table masks bits from the LEFT, so
* complementing turns it into a right-hand mask for this trailing edge)
* and ORs it into the last buffer byte.
fill_disc_row_span_trailing_byte:                          ; >4007
       movb b,a                                            ; LD A,B            ; A = the trailing byte's pixel count
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; none - span ended on a byte boundary, done
       .ret                                                ;                   
!
       movb a,@fill_span_last_byte_mask+>0002              ; LD ($400F),A      ; patch the displacement (#R$400D+2)
fill_span_last_byte_mask:                                  ; >400d
       movb *iy,a                                          ; LD A,(IY+$00)     ; A = #R$4014's mask for that count
       inv  a                                              ; CPL               ; complement it into a right-hand mask
       socb *hl,a                                          ; OR (HL)           ; OR into the trailing buffer byte
       movb a,*hl                                          ; LD (HL),A         ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Partial-byte right-mask table (8 entries)
* 
* #R$3DF4 loads IY with this address at $3E20 and never reloads it -
* every routine it calls (#R$1F60, #R$2176, #R$3CEC, and the rest of
* this call tree down through #R$3EAD/#R$3EE4/#R$3F68/#R$3F9F) leaves
* IY untouched, so IY stays fixed at $4014 throughout. #R$3F68 and
* #R$3F9F each self-modify the `d` operand of a following `(IY+d)`
* read ($3F95 patches $3F98's displacement, $3FA1 patches $3FA4's,
* within #R$3F68 and #R$3F9F respectively) with a column-within-byte
* index (0-7, from `AND $07` on a screen column), then OR the byte
* read into a pixel-
* plot buffer byte - the same role as the already-documented #R$E700
* pixel-bitmask table (see #R$3CFD), but masking a whole trailing run
* of bits rather than a single bit. Index i clears the top i bits and
* leaves the low (8-i) bits set: $FF,$7F,$3F,$1F,$0F,$07,$03,$01.
partial_byte_right_mask_table_8:                           ; >4014
       byte >FF,>7F,>3F,>1F,>0F,>07,>03,>01

********************************************************************************
* Read the flight controls and dispatch key presses
* 
* Used by the routine at #R$0106.
* .
* Called by the main loop (#R$0106) every pass. In flight ($E903 set), and
* unless the flight controls are off (#R$EF8E), it reads the flight
* controls: SPACE speeds up (#R$6956) and '/' ('?') slows down (#R$699C),
* both read straight from the keyboard matrix; then the control bits from
* #R$40A6 roll left or right (#R$69E5, #R$69F8), pitch (#R$69FD climb,
* #R$6A10 dive) and fire the laser (#R$2AD0); and 'J' engages the Torus Jump
* Drive (#R$86E6). All the matrix keys are active low.
* .
* Then, if a key has been typed (($E8F5), from the keyboard scan), looks it
* up in the 33-entry table at #R$419B and jumps to its handler via $409B.
* While ($EF8E) is set, only the pause key ($86) is accepted.
* .
* At $409B, with HL pointing at the matching entry in the key table, plays
* a click (#R$7468, event 0) and jumps to the handler address in the entry.
read_controls:                                             ; >401c
       movb @flight_controls_off,a                         ; LD A,($EF8E)      ; flight controls off?
       socb a,a                                            ; OR A              ; 
       jne  _4077                                          ; JR NZ,$4077       ; yes - skip them
       movb @space_view_showing,a                          ; LD A,($E903)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _4077                                          ; JR Z,$4077        ; not in flight - skip them too
       limi 0                                              ; DI                ; 
       ; IN A,($AA)                                        ; IN A,($AA)        ; TODO: check code. 
       andi a,>f000                                        ; AND $F0           ; 
       socb @bytes+>08,a                                   ; OR $08            ; keyboard row 8
       ; OUT ($AA),A                                       ; OUT ($AA),A       ; TODO: check code. 
       ; IN A,($A9)                                        ; IN A,($A9)        ; TODO: check code. 
       andi a,>0100                                        ; AND $01           ; SPACE?
       ; EI                                                ; EI                ; TODO: check code. 
       jne  !                                              ; CALL Z,$6956      ; yes - speed up
       .call @speed_up                                     ;                   
!
       limi 0                                              ; DI                ; 
       ; IN A,($AA)                                        ; IN A,($AA)        ; TODO: check code. 
       andi a,>f000                                        ; AND $F0           ; 
       socb @bytes+>02,a                                   ; OR $02            ; keyboard row 2
       ; OUT ($AA),A                                       ; OUT ($AA),A       ; TODO: check code. 
       ; IN A,($A9)                                        ; IN A,($A9)        ; TODO: check code. 
       andi a,>1000                                        ; AND $10           ; '/'?
       ; EI                                                ; EI                ; TODO: check code. 
       jne  !                                              ; CALL Z,$699C      ; yes - slow down
       .call @speed_down                                   ;                   
!
       .call @get_control_bits                             ; CALL $40A6        ; A = control bits (#R$40A6)
       czc  @bit2,a                                        ; BIT 2,A           ; 
       jne  !                                              ; CALL Z,$69E5      ; left: roll left
       .call @roll_left                                    ;                   
!
       czc  @bit3,a                                        ; BIT 3,A           ; 
       jne  !                                              ; CALL Z,$69F8      ; right: roll right
       .call @roll_right                                   ;                   
!
       czc  @bit1,a                                        ; BIT 1,A           ; 
       jne  !                                              ; CALL Z,$69FD      ; down: climb
       .call @pitch_climb                                  ;                   
!
       czc  @bit0,a                                        ; BIT 0,A           ; 
       jne  !                                              ; CALL Z,$6A10      ; up: dive
       .call @pitch_dive                                   ;                   
!
       czc  @bit4,a                                        ; BIT 4,A           ; 
       jne  !                                              ; CALL Z,$2AD0      ; fire: fire the laser
       .call @fire_laser                                   ;                   
!
       limi 0                                              ; DI                ; 
       ; IN A,($AA)                                        ; IN A,($AA)        ; TODO: check code. 
       andi a,>f000                                        ; AND $F0           ; 
       socb @bytes+>03,a                                   ; OR $03            ; keyboard row 3
       ; OUT ($AA),A                                       ; OUT ($AA),A       ; TODO: check code. 
       ; IN A,($A9)                                        ; IN A,($A9)        ; TODO: check code. 
       andi a,>8000                                        ; AND $80           ; 'J'?
       ; EI                                                ; EI                ; TODO: check code. 
       jne  !                                              ; CALL Z,$86E6      ; yes - engage the Torus Jump Drive
       .call @engage_torus_jump_drive                      ;                   
!
_4077:                                                     ; >4077
       movb @pending_debounced_keypress_byte_status,a      ; LD A,($E8F5)      ; A = key typed, if any
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; none
       .ret                                                ;                   
!
       movb a,@c                                           ; LD C,A            ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@pending_debounced_keypress_byte_status      ; LD ($E8F5),A      ; consume it
       movb @flight_controls_off,a                         ; LD A,($EF8E)      ; flight controls off?
       socb a,a                                            ; OR A              ; 
       jeq  _408b                                          ; JR Z,$408B        ; no
       movb @c,a                                           ; LD A,C            ; 
       cb   a,@bytes+>86                                   ; CP $86            ; 
       jeq  !                                              ; RET NZ            ; yes: only the pause key is accepted
       .ret                                                ;                   
!
_408b:                                                     ; >408b
       li   hl,key_table                                   ; LD HL,$419B       ; HL -> the key table
       li   de,>0003                                       ; LD DE,$0003       ; 
       movb @c,a                                           ; LD A,C            ; 
       movb @bytes+>21,b                                   ; LD B,$21          ; 33 keys
_4094:                                                     ; >4094
       cb   a,*hl                                          ; CP (HL)           ; 
       jeq  run_key_handler                                ; JR Z,$409B        ; found
       a    de,hl                                          ; ADD HL,DE         ; next entry
       sb   one,b                                          ; DJNZ $4094        ; 
       jne  _4094                                          ;                   
       .ret                                                ; RET               ; not one of them
run_key_handler:                                           ; >409b
       sb   a,a                                            ; LD A,$00          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 0 (click)
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; 
       b    *hl                                            ; JP (HL)           ; TODO. 

********************************************************************************
* Get the control bits, applying the reverse-controls options
* 
* Used by the routine at #R$401C.
* .
* Returns the control bits from ($E8F4) (see #R$7312): bit 0 up, 1 down,
* 2 left, 3 right, 4 fire, each 0 while pressed. If bit 3 of ($E914) is
* set (pause menu option 'B'), up/down and left/right are swapped; if
* bit 4 is set (option 'Y'), up/down are swapped again - so 'Y' reverses
* pitch, and 'B' reverses both pitch and roll (both together reverse just
* roll).
* 
* O:A The control bits
get_control_bits:                                          ; >40a6
       movb @control_bits,a                                ; LD A,($E8F4)      ; A = control bits
       movb a,@c                                           ; LD C,A            ; 
       li   hl,options                                     ; LD HL,$E914       ; 
       movb *hl,r0                                         ; BIT 3,(HL)        ; option 'B' on?
       andi r0,>0800                                       ;                   
       jeq  _40ca                                          ; JR Z,$40CA        ; no
       movb @bytes+>02,b                                   ; LD B,$02          ; 
_40b3:                                                     ; >40b3
       ; RR C                                              ; RR C              ; TODO: check code. 
       .ex_af_af_                                          ; EX AF,AF'         ; 
       ; RR C                                              ; RR C              ; TODO: check code. 
       ; RR E                                              ; RR E              ; TODO: check code. 
       .ex_af_af_                                          ; EX AF,AF'         ; 
       ; RR E                                              ; RR E              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $40B3        ; swap up/down and left/right
       jne  _40b3                                          ;                   
       ; RR C                                              ; RR C              ; TODO: check code. 
       ; RR E                                              ; RR E              ; TODO: check code. 
       movb @e,@c                                          ; LD C,E            ; 
       ; RR C                                              ; RR C              ; TODO: check code. 
       ; RR C                                              ; RR C              ; TODO: check code. 
       ; RR C                                              ; RR C              ; TODO: check code. 
_40ca:                                                     ; >40ca
       movb *hl,r0                                         ; BIT 4,(HL)        ; option 'Y' on?
       andi r0,>1000                                       ;                   
       jeq  _40dc                                          ; JR Z,$40DC        ; no
       ; RR C                                              ; RR C              ; TODO: check code. 
       .ex_af_af_                                          ; EX AF,AF'         ; 
       ; RR C                                              ; RR C              ; TODO: check code. 
       ; RR E                                              ; RR E              ; TODO: check code. 
       .ex_af_af_                                          ; EX AF,AF'         ; 
       ; RL C                                              ; RL C              ; TODO: check code. 
       ; RL E                                              ; RL E              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. swap up and down
_40dc:                                                     ; >40dc
       movb @c,a                                           ; LD A,C            ; A = control bits
       .ret                                                ; RET               ; 

********************************************************************************
* Key STOP: freeze the game
* 
* Reached via the key table at #R$419B. Stops any hyperspace countdown
* (#R$E91B) for the time being, and shows "Game Frozen" - over the space
* view if it's showing (#R$E903), or on the dashboard otherwise ($40F9).
* Then waits for one of the keys at #R$41FE (#R$4102).
* .
* At $40F9, when docked, shows "Game Frozen" on the dashboard. The entry at
* $4102 waits for one of the keys at #R$41FE, with a click: STOP unfreezes
* the game, restarting any hyperspace countdown; the others are options
* ($412C), after which it waits for another key.
* .
* At $412C, '1' ends the game (#R$F749) with cause 3, so the main loop
* (#R$0106) skips the death scene and goes back to the title screen; the
* `POP AF` discards the saved hyperspace countdown. Any other key goes on
* to $413C.
* .
* At $413C, sets bit 0 of the options (#R$E914), unless muted (bit 6).
* .
* At $414B, clears bit 0 of the options (#R$E914), unless muted (bit 6).
* .
* At $4157, toggles bit 6 of the options (#R$E914); unmuting also turns the
* sound on (bit 0).
* .
* At $4165, toggles the key's bit of the options (#R$E914), from the table
* at #R$4208. The entry at $4171 waits for another key.
freeze_game:                                               ; >40de
       li   hl,hyperspace_countdown_inner                  ; LD HL,$E91B       ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = hyperspace countdown
       .push af                                            ; PUSH AF           ; save it
       sb   *hl,*hl                                        ; LD (HL),$00       ; stop it
       movb @space_view_showing,a                          ; LD A,($E903)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  freeze_game_2                                  ; JR Z,$40F9        ; no space view showing
       li   hl,msg_game_frozen                             ; LD HL,$420D       ; "Game Frozen"
       .call @show_view_message                            ; CALL $39C8        ; show it
       .call @copy_space_view                              ; CALL $3846        ; copy the space view to the screen
       .call @do_nothing                                   ; CALL $0151        ; 
       jmp  _4102                                          ; JR $4102          ; 
freeze_game_2:                                             ; >40f9
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       li   hl,msg_game_frozen_4223                        ; LD HL,$4223       ; "Game Frozen"
       .call @rst_08_target_print_tokenised_string         ; CALL $357A        ; show it
_4102:                                                     ; >4102
       li   hl,pending_debounced_keypress_byte_status      ; LD HL,$E8F5       ; 
_4105:                                                     ; >4105
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _4105                                          ; JR Z,$4105        ; wait for a key
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   hl,frozen_keys                                 ; LD HL,$41FE       ; the keys for the frozen game
       li   bc,>000a                                       ; LD BC,$000A       ; 
       ; CPIR                                              ; CPIR              ; TODO: check code. search for a match
       jne  _4102                                          ; JR NZ,$4102       ; not one of them
       .push af                                            ; PUSH AF           ; stash the matched key
       sb   a,a                                            ; LD A,$00          ; 
       .call @play_sound_effect                            ; CALL $7468        ; click
       .pop af                                             ; POP AF            ; recover the matched key
       cb   a,@bytes+>86                                   ; CP $86            ; STOP?
       jne  pause_quit                                     ; JR NZ,$412C       ; no - an option
       movb @space_view_showing,a                          ; LD A,($E903)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; CALL Z,$3955      ; clear the message line
       .call @clear_message_line                           ;                   
!
       .pop af                                             ; POP AF            ; restart the hyperspace countdown
       movb a,@hyperspace_countdown_inner                  ; LD ($E91B),A      ; 
       .ret                                                ; RET               ; 
pause_quit:                                                ; >412c
       cb   a,@bytes+>31                                   ; CP $31            ; 
       jne  pause_sound_on                                 ; JR NZ,$413C       ; 
       .pop af                                             ; POP AF            ; 
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@game_over                                   ; LD ($F749),A      ; game over...
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       movb a,@game_over_cause                             ; LD ($F74A),A      ; ...because the player quit
       .ret                                                ; RET               ; 
pause_sound_on:                                            ; >413c
       li   hl,options                                     ; LD HL,$E914       ; the options
       cb   a,@bytes+>53                                   ; CP $53            ; 'S'?
       jne  pause_sound_off                                ; JR NZ,$414B       ; no - try the next key
       movb *hl,r0                                         ; BIT 6,(HL)        ; muted?
       andi r0,>4000                                       ;                   
       jne  _4149                                          ; JR NZ,$4149       ; yes
       socb @bit0,*hl                                      ; SET 0,(HL)        ; sound on
_4149:                                                     ; >4149
       jmp  _4171                                          ; JR $4171          ; wait for another key
pause_sound_off:                                           ; >414b
       cb   a,@bytes+>51                                   ; CP $51            ; 'Q'?
       jne  pause_mute                                     ; JR NZ,$4157       ; no - try the next key
       movb *hl,r0                                         ; BIT 6,(HL)        ; muted?
       andi r0,>4000                                       ;                   
       jne  _4155                                          ; JR NZ,$4155       ; yes
       szcb @bit0,*hl                                      ; RES 0,(HL)        ; sound off
_4155:                                                     ; >4155
       jmp  _4171                                          ; JR $4171          ; wait for another key
pause_mute:                                                ; >4157
       cb   a,@bytes+>4d                                   ; CP $4D            ; 'M'?
       jne  pause_toggle_option                            ; JR NZ,$4165       ; no - try the remaining keys
       movb *hl,a                                          ; LD A,(HL)         ; yes - toggle bit 6
       li   r0,64*256                                      ; XOR $40           ; toggle mute
       xor  r0,a                                           ;                   
       movb a,*hl                                          ; LD (HL),A         ; 
       jne  _4163                                          ; JR NZ,$4163       ; muted
       socb @bit0,*hl                                      ; SET 0,(HL)        ; unmuted - sound on
_4163:                                                     ; >4163
       jmp  _4171                                          ; JR $4171          ; wait for another key
pause_toggle_option:                                       ; >4165
       .ex_de_hl                                           ; EX DE,HL          ; DE -> the settings flags byte
       movb @bytes+>09,a                                   ; LD A,$09          ; 
       sb   @c,a                                           ; SUB C             ; A = the key's position
       movb a,@c                                           ; LD C,A            ; 
       li   hl,option_bits                                 ; LD HL,$4208       ; the option bits
       a    bc,hl                                          ; ADD HL,BC         ; HL -> the key's bit
       movb *de,a                                          ; LD A,(DE)         ; 
       ; XOR (HL)                                          ; XOR (HL)          ; TODO: check code. toggle it
       movb a,*de                                          ; LD (DE),A         ; 
_4171:                                                     ; >4171
       jmp  _4102                                          ; JR $4102          ; wait for another key

********************************************************************************
* Key '1': launch, or switch to the front view
* 
* Reached via the key table at #R$419B.
key_handler_1:                                             ; >4173
       movb @docked,a                                      ; LD A,($E90A)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$1837       ; docked - launch
       b    @launch                                        ;                   
!
       b    @switch_to_front_view                          ; JP $64A1          ; in flight - front view

********************************************************************************
* Key '2': buy cargo, or switch to the rear view
* 
* Reached via the key table at #R$419B.
key_handler_2:                                             ; >417d
       movb @docked,a                                      ; LD A,($E90A)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$5BBD       ; docked - buy cargo
       b    @buy_cargo                                     ;                   
!
       b    @switch_to_rear_view                           ; JP $64B5          ; in flight - rear view

********************************************************************************
* Key '3': sell cargo, or switch to the left view
* 
* Reached via the key table at #R$419B.
key_handler_3:                                             ; >4187
       movb @docked,a                                      ; LD A,($E90A)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$5CEE       ; 
       b    @sell_cargo                                    ;                   
!
       b    @switch_to_left_view                           ; JP $64C9          ; 

********************************************************************************
* Key '4': equip ship, or switch to the right view
* 
* Reached via the key table at #R$419B.
key_handler_4:                                             ; >4191
       movb @docked,a                                      ; LD A,($E90A)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$5DBB       ; 
       b    @equip_ship                                    ;                   
!
       b    @switch_to_right_view                          ; JP $64DD          ; 

********************************************************************************
* Key table
* 
* 33 entries of 3 bytes - a key code (as produced by the key-code table at
* #R$0A57) and the address of its handler - searched by #R$401C, which
* runs the matching handler via #R$409B. Keys 1-4 (and F1-F4) switch
* view in flight but launch, buy, sell and equip when docked (see their
* handlers). Most keys match the manual's key lists; F5 and 'F' aren't
* in it.
key_table:                                                 ; >419b
       byte >31                                                      ; '1': launch / front view (#R$4173)
       data key_handler_1
       byte >32                                                      ; '2': buy cargo / rear view (#R$417D)
       data key_handler_2
       byte >33                                                      ; '3': sell cargo / left view (#R$4187)
       data key_handler_3
       byte >34                                                      ; '4': equip ship / right view (#R$4191)
       data key_handler_4
       byte >38                                                      ; '8': market prices (#R$5B99)
       data key_handler_8
       byte >5B                                                      ; '[': load/save commander menu (#R$A30A)
       data commander_menu
       byte >37                                                      ; '7': data on system (#R$6164)
       data key_data_on_system
       byte >30                                                      ; '0': inventory (#R$5C8E)
       data show_cargo_manifest_screen
       byte >39                                                      ; '9': commander status (#R$6276)
       data status_page
       byte >35                                                      ; '5': galactic chart (#R$4D0B)
       data galactic_chart
       byte >87                                                      ; HOME: bring back the cursor, as 'B' (#R$527F)
       data update_chart_cursor
       byte >42                                                      ; 'B': bring back the cursor (#R$527F)
       data update_chart_cursor
       byte >44                                                      ; 'D': distance to the system (#R$52CE)
       data key_distance
       byte >36                                                      ; '6': local chart (#R$4F64)
       data local_chart
       byte >80                                                      ; F1: front view (#R$64A1)
       data switch_to_front_view
       byte >81                                                      ; F2: rear view (#R$64B5)
       data switch_to_rear_view
       byte >82                                                      ; F3: left view (#R$64C9)
       data switch_to_left_view
       byte >83                                                      ; F4: right view (#R$64DD)
       data switch_to_right_view
       byte >86                                                      ; STOP: freeze the game (#R$40DE)
       data freeze_game
       byte >46                                                      ; 'F': find a system by name (#R$55A3)
       data key_find_system
       byte >54                                                      ; 'T': target a missile (#R$2D58)
       data key_handler_t
       byte >55                                                      ; 'U': unarm the missile (#R$2D70)
       data cancel_missile_lock
       byte >4D                                                      ; 'M': fire the missile (#R$2D7E)
       data key_fire_missile
       byte >48                                                      ; 'H': hyperspace (#R$88AC)
       data key_handler_h
       byte >43                                                      ; 'C': docking computer (#R$1692)
       data key_handler_c
       byte >45                                                      ; 'E': ECM (#R$3223)
       data key_handler_e
       byte >09                                                      ; TAB: energy bomb (#R$329E)
       data key_handler_tab
       byte >47                                                      ; 'G': galactic hyperdrive (#R$8926)
       data key_handler_g
       byte >1B                                                      ; Esc: escape capsule (#R$19FC)
       data key_escape_capsule
       byte >84                                                      ; F5: time, score and credits (#R$1A8A)
       data key_f5_info
       byte >49                                                      ; 'I': identify the target (#R$1B0D)
       data key_handler_i
       byte >59                                                      ; 'Y': cloaking device on/off (#R$1B13)
       data key_handler_y
       byte >4C                                                      ; 'L': ECM jammer on/off (#R$1B25)
       data key_handler_l

********************************************************************************
* Keys for the frozen game
* 
* Used by the routine at #R$40DE.
* .
* The keys #R$4102 waits for while the game is frozen: 'R', 'D', 'Y',
* 'B' and 'F' toggle options (#R$4165, #R$4208), 'M' mutes (#R$4157),
* 'S' and 'Q' turn the sound on and off (#R$413C, #R$414B), '1' quits
* (#R$412C), and STOP ($86) unfreezes the game.
frozen_keys:                                               ; >41fe
       byte >52,>44,>59,>42,>46,>4D,>53,>51
       byte >31,>86

********************************************************************************
* Option bits
* 
* The bit of the options (#R$E914) toggled by each of 'R', 'D', 'Y', 'B'
* and 'F' while the game is frozen (#R$4165).
option_bits:                                               ; >4208
       byte >04,>02,>10,>08,>20

********************************************************************************
* The message "     Game Frozen     "
msg_game_frozen:                                           ; >420d
       text '     GAME FROZEN     ',>a0

********************************************************************************
* The message "Game Frozen"
msg_game_frozen_4223:                                      ; >4223
       text 'GAME FROZE',>ee

********************************************************************************
* Draw the object
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C and #R$1E5A.
* .
* Called for each object by the main loop (#R$13FD). Clears the flags for
* the laser sights (#R$EF99), the object being on screen ($EF98), the
* orientation cache (#R$E6F0) and not drawing it (#R$E6F3), then draws it
* ($4255) - except the Cougar (ship type $1E), which is cloaked: unless
* it's exploding, it's only drawn while bit 5 of the frame counter
* (#R$F746) is set, so it flickers.
* .
* At $4255, projects the object's position (#R$44CE) into $E6D8/$E6DC,
* giving up if it's behind the player, and works out its scale (#R$46CA).
* An explosion (handler type 1) is drawn by #R$4AEC, with its size
* (#R$F7F0) in #R$F800. Anything else must be on screen (#R$4A99); if it
* can't be drawn in full (bit 3 of #R$F7CD) or is too far away (#R$EB9E
* under 4), #R$4A86 draws it small. Otherwise it's drawn as a wireframe
* with hidden faces removed: the flags for the vertices already projected
* (#R$E784, #R$F7FF of them) and the edges already drawn (#R$E7B6, #R$F7FE of
* them) are cleared, and for each face in the blueprint's faces (#R$F7F9,
* #R$F7FD of them): if the faces have normals (#R$F804), the face's scale
* byte and 6-byte normal are read and the face skipped if it faces away
* (#R$4873, $4336); otherwise its edges are drawn (#R$491A).
* .
* At $4336, skips the face's list of edges (a count, then the edges). The
* entry at $433B moves on to the next face.
draw_object:                                               ; >422e
       sb   a,a                                            ; XOR A             ; A = 0
       movb a,@in_sights                                   ; LD ($EF99),A      ; not in the sights
       movb a,@ef98_per_object_flag                        ; LD ($EF98),A      ; not on screen
       movb a,@vector_cache_valid_flag                     ; LD ($E6F0),A      ; orientation not cached
       movb a,@nothing_changed_flag                        ; LD ($E6F3),A      ; 
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>1e                                   ; CP $1E            ; is it mode 30?
       jne  draw_ship                                      ; JR NZ,$4255       ; not the Cougar
       movb @handler_type,a                                ; LD A,($F7EE)      ; mode 30: A = the object's type
       cb   a,one                                          ; CP $01            ; is it type 1?
       jeq  draw_ship                                      ; JR Z,$4255        ; exploding
       movb @main_loop_tick_counter,a                      ; LD A,($F746)      ; else A = the tick/frame counter's low byte
       andi a,>2000                                        ; AND $20           ; test bit 5
       jne  draw_ship                                      ; JR NZ,$4255       ; its turn to be seen
       sb   one,a                                          ; DEC A             ; clear: A = $FF (from 0)
       movb a,@nothing_changed_flag                        ; LD ($E6F3),A      ; don't draw it this frame
       .ret                                                ; RET               ; and return without drawing it
draw_ship:                                                 ; >4255
       mov  @object_position_x,de                          ; LD DE,($F7CE)     ; DE = the object's world position, first half
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; HL = ...second half
       .call @convert_to_view                              ; CALL $44CE        ; project the object's position
       mov  de,@view_x                                     ; LD ($E6D8),DE     ; store the projected first half
       mov  hl,@view_z                                     ; LD ($E6DC),HL     ; store the projected second half
       movb h,a                                            ; LD A,H            ; A = the projected second half's high byte
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; RET M             ; behind the player
       .ret                                                ;                   
!
       socb @l,a                                           ; OR L              ; 
       jne  !                                              ; RET Z             ; 
       .ret                                                ;                   
!
       a    hl,hl                                          ; ADD HL,HL         ; HL = the projected second half, doubled
       mov  hl,@view_z2                                    ; LD ($E6DA),HL     ; store it - a depth scale used below
* @label=*
_426f:                                                     ; >426f
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = handler type
       cb   a,one                                          ; CP $01            ; is it type 1?
       jne  _427c                                          ; JR NZ,$427C       ; not an explosion
       movb @per_type_parameter_block,a                    ; LD A,($F7F0)      ; 
       movb a,@bp_targetable_area                          ; LD ($F800),A      ; the explosion's size
_427c:                                                     ; >427c
       .call @ship_screen_size                             ; CALL $46CA        ; work out the scale
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = the object's type again
       cb   a,one                                          ; CP $01            ; is it type 1?
       jeq  _42bc                                          ; JR Z,$42BC        ; an explosion
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; else HL = the cached value at $EB9E (see #R$4A99)
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; 
       jne  !                                              ; RET Z             ; zero - bail out
       .ret                                                ;                   
!
       mov  @view_x,de                                     ; LD DE,($E6D8)     ; DE = the projected first half
       mov  @object_position_y,bc                          ; LD BC,($F7D0)     ; BC = the vector's shared middle component
       mov  @view_z2,hl                                    ; LD HL,($E6DA)     ; HL = the doubled depth value
       .call @project_point                                ; CALL $47C4        ; scale (DE,BC) against it via #R$47C4
       movb b,ixh                                          ; LD IXH,B          ; IX = the scaled first pair
       movb @c,@ixl                                        ; LD IXL,C          ; 
       movb d,iyh                                          ; LD IYH,D          ; IY = the scaled second pair
       movb @e,@iyl                                        ; LD IYL,E          ; 
       .call @on_screen                                    ; CALL $4A99        ; is it on screen?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no
       .ret                                                ;                   
!
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = the object status byte
       andi a,>0800                                        ; AND $08           ; 
       jeq  !                                              ; JP NZ,$4A86       ; can't be drawn in full - draw it small
       b    @draw_small                                    ;                   
!
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; clear: HL = the cached value at $EB9E
       li   de,>fffc                                       ; LD DE,$FFFC       ; DE = -4
       a    de,hl                                          ; ADD HL,DE         ; HL -= 4 (carry reflects whether HL was >= 4)
       joc  !                                              ; JP NC,$4A86       ; TODO: check code. too far away - draw it small
       b    @draw_small                                    ;                   
!
       movb @ship_type,a                                   ; LD A,($F7E7)      ; else A = the current ship type
_42bc:                                                     ; >42bc
       .call @work_out_roof                                ; CALL $4599        ; work out the third orientation vector
       .call @cache_orientation                            ; CALL $433F        ; refresh the cached, quantized object vectors
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = the object's type
       cb   a,one                                          ; CP $01            ; is it type 1?
       jne  !                                              ; JP Z,$4AEC        ; an explosion - #R$4AEC
       b    @draw_explosion                                ;                   
!
       movb @b255,a                                        ; LD A,$FF          ; else: A = $FF
       movb a,@ef98_per_object_flag                        ; LD ($EF98),A      ; on screen
       li   hl,vertex_flags                                ; LD HL,$E784       ; HL -> the $E784 buffer
       li   de,vertex_flags+>0001                          ; LD DE,$E785       ; DE -> one byte past it
       mov  @bp_vertex_count,bc                            ; LD BC,($F7FF)     ; C = number of vertices
       sb   b,b                                            ; LD B,$00          ; keep only the low byte (C)
       movb b,*hl                                          ; LD (HL),B         ; seed the first byte with 0
       sb   one,@c                                         ; DEC C             ; one fewer byte to fill
       .ldir                                               ; LDIR              ; clear the vertex flags
       li   hl,edge_flags                                  ; LD HL,$E7B6       ; HL -> the $E7B6 buffer
       li   de,edge_flags+>0001                            ; LD DE,$E7B7       ; DE -> one byte past it
       mov  @bp_edge_count,bc                              ; LD BC,($F7FE)     ; C = number of edges
       sb   b,b                                            ; LD B,$00          ; keep only the low byte (C)
       movb b,*hl                                          ; LD (HL),B         ; seed the first byte with 0
       sb   one,@c                                         ; DEC C             ; one fewer byte to fill
       .ldir                                               ; LDIR              ; clear the edge flags
       movb @bytes+>e6,a                                   ; LD A,$E6          ; A = $E6
       movb a,@vertex_cache_slot_hi                        ; LD ($E6C9),A      ; the vertex cache is in page $E6
       li   ix,edge_flags                                  ; LD IX,$E7B6       ; IX -> the $E7B6 buffer
       li   iy,vertex_flags                                ; LD IY,$E784       ; IY -> the $E784 buffer
       mov  @bp_faces,hl                                   ; LD HL,($F7F9)     ; HL -> the faces
       movb @bp_face_count,a                               ; LD A,($F7FD)      ; B = number of faces
       movb a,b                                            ; LD B,A            ; B = the loop count
_4303:                                                     ; >4303
       .push bc                                            ; PUSH BC           ; save the loop counter
       movb @bp_face_normals,a                             ; LD A,($F804)      ; A = faces have normals?
       socb a,a                                            ; OR A              ; 
       jeq  _4325                                          ; JR Z,$4325        ; no
       movb *hl,a                                          ; LD A,(HL)         ; else: A = the next data byte
       inc  hl                                             ; INC HL            ; 
       movb a,@face_scale                                  ; LD ($E7E8),A      ; the normal's scale
       movb a,@e                                           ; LD E,A            ; E = that byte, used as a table index
       movb @bytes+>02,d                                   ; LD D,$02          ; 
       movb *de,a                                          ; LD A,(DE)         ; A = the scale's bit length (#R$0200)
       movb a,@face_scale_bits                             ; LD ($E7E9),A      ; 
       li   de,rotated_vector                              ; LD DE,$E7EA       ; DE -> the $E7EA staging buffer
       .ldi                                                ; LDI               ; copy 6 bytes from (HL) into the staging buffer...
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; copy the normal
_4325:                                                     ; >4325
       movb @bp_face_normals,a                             ; LD A,($F804)      ; A = the per-entry mode/flag byte again
       socb a,a                                            ; OR A              ; 
       jeq  _4331                                          ; JR Z,$4331        ; clear - skip #R$4873's combine step
       .call @face_visible                                 ; CALL $4873        ; does the face face the player?
       jlt  !                                              ; JP P,$4336        ; no - skip it
       b    @draw_ship_skip_face                           ;                   
!
_4331:                                                     ; >4331
       .call @draw_face_edges                              ; CALL $491A        ; yes - draw its edges
       jmp  _433b                                          ; JR $433B          ; join the shared loop-advance tail
draw_ship_skip_face:                                       ; >4336
       movb *hl,@c                                         ; LD C,(HL)         ; C = a length-prefix byte
       inc  hl                                             ; INC HL            ; 
       sb   b,b                                            ; LD B,$00          ; B = 0 (widen C to BC)
       a    bc,hl                                          ; ADD HL,BC         ; HL += C, skipping that many bytes
_433b:                                                     ; >433b
       .pop bc                                             ; POP BC            ; restore the loop counter
       sb   one,b                                          ; DJNZ $4303        ; one entry done - loop for the next
       jne  _4303                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Cache the object's orientation as logarithms
* 
* Used by the routines at #R$422E and #R$43C2.
* .
* Converts the object's orientation vectors - side (#R$F7D4), roof
* (#R$F7E0) and nose (#R$F7DA) - to sign-tagged logarithms (#R$1FCF), for
* #R$4464's multiplications: the side and roof vectors at $E6CC and
* $E6D2, and the nose vector (unless bit 4 of #R$F7CD is set) at
* #R$EB68. Marks the cache valid (#R$E6F0).
cache_orientation:                                         ; >433f
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; HL = a position/axis word
       .call @log_sign_tagged                              ; CALL $1FCF        ; side vector's x
       mov  hl,@side_vector_logs                           ; LD ($E6CC),HL     ; cache the result
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; side y
       .call @log_sign_tagged                              ; CALL $1FCF        ; quantize it
       mov  hl,@side_vector_log_y                          ; LD ($E6CE),HL     ; cache the result
       mov  @side_vector_z,hl                              ; LD HL,($F7D8)     ; side z
       .call @log_sign_tagged                              ; CALL $1FCF        ; quantize it
       mov  hl,@side_vector_log_z                          ; LD ($E6D0),HL     ; cache the result
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; roof x
       .call @log_sign_tagged                              ; CALL $1FCF        ; quantize it
       mov  hl,@roof_vector_logs                           ; LD ($E6D2),HL     ; cache the result
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; roof y
       .call @log_sign_tagged                              ; CALL $1FCF        ; quantize it
       mov  hl,@roof_vector_log_y                          ; LD ($E6D4),HL     ; cache the result
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; roof z
       .call @log_sign_tagged                              ; CALL $1FCF        ; quantize it
       mov  hl,@roof_vector_log_z                          ; LD ($E6D6),HL     ; cache the result
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = the object status byte
       andi a,>1000                                        ; AND $10           ; test bit 4
       jne  _4397                                          ; JR NZ,$4397       ; skip the nose vector
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; nose x
       .call @log_sign_tagged                              ; CALL $1FCF        ; quantize it
       mov  hl,@nose_vector_logs                           ; LD ($EB68),HL     ; cache the result
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; nose y
       .call @log_sign_tagged                              ; CALL $1FCF        ; quantize it
       mov  hl,@nose_vector_log_y                          ; LD ($EB6A),HL     ; cache the result
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; nose z
       .call @log_sign_tagged                              ; CALL $1FCF        ; quantize it
       mov  hl,@nose_vector_log_z                          ; LD ($EB6C),HL     ; cache the result
_4397:                                                     ; >4397
       movb @b255,a                                        ; LD A,$FF          ; A = $FF
       movb a,@vector_cache_valid_flag                     ; LD ($E6F0),A      ; the cache is valid
       .ret                                                ; RET               ; 

********************************************************************************
* Multiply a vector by a number
* 
* Used by the routines at #R$2C3C and #R$43C2.
* .
* Multiplies each component of the vector at IX by HL (#R$200A).
* 
* I:HL The number
* I:IX The vector (three words)
* O:DE,BC,HL x, y and z
multiply_vector:                                           ; >439d
       .push hl                                            ; PUSH HL           ; save HL
       .ex_de_hl                                           ; EX DE,HL          ; swap HL/DE
       movb *ix,@l                                         ; LD L,(IX+$00)     ; L = the vector's first word, low byte
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; ...high byte
       .call @multiply_components                          ; CALL $200A        ; multiply
       .ex_sp_hl                                           ; EX (SP),HL        ; swap HL with the saved value on the stack
       .push hl                                            ; PUSH HL           ; save the result again
       .ex_de_hl                                           ; EX DE,HL          ; swap HL/DE
       movb @>02(ix),@l                                    ; LD L,(IX+$02)     ; L = the vector's second word, low byte
       movb @>03(ix),h                                     ; LD H,(IX+$03)     ; ...high byte
       .call @multiply_components                          ; CALL $200A        ; combine via #R$200A
       .ex_sp_hl                                           ; EX (SP),HL        ; swap HL with the saved value on the stack
       .ex_de_hl                                           ; EX DE,HL          ; swap HL/DE
       movb @>04(ix),@l                                    ; LD L,(IX+$04)     ; L = the vector's third word, low byte
       movb @>05(ix),h                                     ; LD H,(IX+$05)     ; ...high byte
       .call @multiply_components                          ; CALL $200A        ; combine via #R$200A
       .pop bc                                             ; POP BC            ; restore a saved value into BC
       .pop de                                             ; POP DE            ; restore another saved value into DE
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a ship's laser beam
* 
* Used by the routine at #R$13FD.
* .
* Called by the main loop (#R$13FD) when a ship has fired at the player
* (#R$E92D, see #R$26A9) and is drawn this frame (#R$E6F3). Draws a line
* from the ship's gun (vertex #R$F803) to a point 3000 ahead along its nose
* vector (#R$439D, #R$F7DA). If that point is in front of the player, $442A
* draws the beam; otherwise, if the gun is, the beam is clipped where it
* passes the player (#R$4B22).
* .
* At $442A, projects the far end (#R$47C4); then the gun vertex (#R$4A5C)
* is projected too if it's in front of the player (at $4455), otherwise the
* beam is clipped (#R$4B22). Draws the line (#R$3AC2).
draw_ship_laser:                                           ; >43c2
       movb @ship_fired,a                                  ; LD A,($E92D)      ; has the ship fired?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no
       .ret                                                ;                   
!
       movb @nothing_changed_flag,a                        ; LD A,($E6F3)      ; A = the "nothing changed" flag (see #R$422E)
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; not drawn this frame
       .ret                                                ;                   
!
       movb @vector_cache_valid_flag,a                     ; LD A,($E6F0)      ; A = the vector-cache-valid flag
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; CALL Z,$433F      ; cache the orientation
       .call @cache_orientation                            ;                   
!
       mov  @view_z,hl                                     ; LD HL,($E6DC)     ; 
       a    hl,hl                                          ; ADD HL,HL         ; double it
       mov  hl,@view_z2                                    ; LD ($E6DA),HL     ; twice the ship's z
       li   hl,>0bb8                                       ; LD HL,$0BB8       ; 3000...
       li   ix,nose_vector                                 ; LD IX,$F7DA       ; ...along the nose vector
       .call @multiply_vector                              ; CALL $439D        ; combine (HL against IX's vector) via #R$439D
       .call @convert_to_view                              ; CALL $44CE        ; convert to the view
       .call @add_object_position                          ; CALL $44D2        ; add the ship's position
       mov  de,@line_end_1_x                               ; LD ($F769),DE     ; the far end
       mov  bc,@line_end_1_y                               ; LD ($F76B),BC     ; 
       mov  hl,@line_end_1_z                               ; LD ($F76D),HL     ; 
       jeq  _43fc                                          ; JR Z,$43FC        ; 
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$442A        ; in front of the player
       b    @draw_ship_laser_2                             ;                   
!
_43fc:                                                     ; >43fc
       movb @bp_gun_vertex,a                               ; LD A,($F803)      ; the gun vertex
       movb a,@e                                           ; LD E,A            ; E = that index
       .call @vertex_relative                              ; CALL $4A5C        ; relative to the player
       jnc  _4428                                          ; JR NC,$4428       ; TODO: check code. behind the player too
       mov  de,@line_end_2_x                               ; LD ($F76F),DE     ; the gun
       mov  bc,@line_end_2_y                               ; LD ($F771),BC     ; 
       mov  hl,@line_end_2_z                               ; LD ($F773),HL     ; 
       .call @project_point                                ; CALL $47C4        ; project the gun
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; cache the scaled result
       mov  de,@clip_point1_y                              ; LD ($EB94),DE     ; 
       .call @clip_line_at_player                          ; CALL $4B22        ; clip the beam at the far end's side
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; cache the interpolated result
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; 
       .call @clip_and_draw_line                           ; CALL $3AC2        ; draw the line
_4428:                                                     ; >4428
       jmp  _4463                                          ; JR $4463          ; join the shared exit at #R$4463
draw_ship_laser_2:                                         ; >442a
       .call @project_point                                ; CALL $47C4        ; quantize/scale via #R$47C4
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; cache the scaled result
       mov  de,@clip_point1_y                              ; LD ($EB94),DE     ; 
       movb @bp_gun_vertex,a                               ; LD A,($F803)      ; A = a per-object index
       movb a,@e                                           ; LD E,A            ; E = that index
       .call @vertex_relative                              ; CALL $4A5C        ; copy the indexed vector record via #R$4A5C
       joc  draw_ship_laser_3                              ; JR C,$4455        ; TODO: check code. carry set - skip ahead
       mov  de,@line_end_2_x                               ; LD ($F76F),DE     ; cache the result
       mov  bc,@line_end_2_y                               ; LD ($F771),BC     ; 
       mov  hl,@line_end_2_z                               ; LD ($F773),HL     ; 
       .call @clip_line_at_player                          ; CALL $4B22        ; interpolate a clip point via #R$4B22
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; cache the interpolated result
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; 
       jmp  _4460                                          ; JR $4460          ; draw the line
draw_ship_laser_3:                                         ; >4455
       .call @project_point                                ; CALL $47C4        ; quantize/scale via #R$47C4
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; cache the scaled result directly
       mov  de,@clip_point2_y                              ; LD ($EB98),DE     ; 
_4460:                                                     ; >4460
       .call @clip_and_draw_line                           ; CALL $3AC2        ; run the clip test (#R$3AC2)
_4463:                                                     ; >4463
       .ret                                                ; RET               ; 

********************************************************************************
* Rotate a vertex into the view
* 
* Used by the routines at #R$4873, #R$49FD and #R$4A5C.
* .
* Multiplies the vertex (or normal) at #R$E7EA - x, y and z as sign-tagged
* logarithms, as the blueprints store them - by the object's orientation
* (cached as logarithms by #R$433F), multiplying via logs (#R$2160):
* x' = x * side.x + y * roof.x + z * nose.x, and likewise for y' and z'.
* Then, at $44CE, turns (DE, BC, HL) = (x', y', z') into the coordinates
* of the current view (#R$44E5, #R$44E6, #R$44F3 or #R$44FB, patched in
* by the view selectors at #R$64A1).
* 
* O:DE x
* O:BC y
* O:HL z
rotate_vertex:                                             ; >4464
       mov  @rotated_vector,hl                             ; LD HL,($E7EA)     ; x * side.x
       mov  @side_vector_logs,bc                           ; LD BC,($E6CC)     ; BC = row 1's first coefficient
       .call @multiply_logs                                ; CALL $2160        ; combine it via #R$2160
       .ex_de_hl                                           ; EX DE,HL          ; DE = that combine's result
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; y * roof.x
       mov  @roof_vector_logs,bc                           ; LD BC,($E6D2)     ; BC = row 1's second coefficient
       .call @multiply_logs                                ; CALL $2160        ; combine it
       a    de,hl                                          ; ADD HL,DE         ; HL = the running sum for row 1
       .ex_de_hl                                           ; EX DE,HL          ; DE = that sum
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; z * nose.x
       mov  @nose_vector_logs,bc                           ; LD BC,($EB68)     ; BC = row 1's third coefficient
       .call @multiply_logs                                ; CALL $2160        ; combine it
       a    de,hl                                          ; ADD HL,DE         ; x'
       .push hl                                            ; PUSH HL           ; save it
       mov  @rotated_vector,hl                             ; LD HL,($E7EA)     ; x * side.y
       mov  @side_vector_log_y,bc                          ; LD BC,($E6CE)     ; 
       .call @multiply_logs                                ; CALL $2160        ; combine
       .ex_de_hl                                           ; EX DE,HL          ; DE = that result
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; y * roof.y
       mov  @roof_vector_log_y,bc                          ; LD BC,($E6D4)     ; BC = row 2's second coefficient
       .call @multiply_logs                                ; CALL $2160        ; combine
       a    de,hl                                          ; ADD HL,DE         ; running sum for row 2
       .ex_de_hl                                           ; EX DE,HL          ; DE = that sum
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; z * nose.y
       mov  @nose_vector_log_y,bc                          ; LD BC,($EB6A)     ; BC = row 2's third coefficient
       .call @multiply_logs                                ; CALL $2160        ; combine
       a    de,hl                                          ; ADD HL,DE         ; y'
       .push hl                                            ; PUSH HL           ; save it
       mov  @rotated_vector,hl                             ; LD HL,($E7EA)     ; x * side.z
       mov  @side_vector_log_z,bc                          ; LD BC,($E6D0)     ; BC = row 3's first coefficient
       .call @multiply_logs                                ; CALL $2160        ; combine
       .ex_de_hl                                           ; EX DE,HL          ; DE = that result
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; y * roof.z
       mov  @roof_vector_log_z,bc                          ; LD BC,($E6D6)     ; BC = row 3's second coefficient
       .call @multiply_logs                                ; CALL $2160        ; combine
       a    de,hl                                          ; ADD HL,DE         ; running sum for row 3
       .ex_de_hl                                           ; EX DE,HL          ; DE = that sum
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; z * nose.z
       mov  @nose_vector_log_z,bc                          ; LD BC,($EB6C)     ; BC = row 3's third coefficient
       .call @multiply_logs                                ; CALL $2160        ; combine
       a    de,hl                                          ; ADD HL,DE         ; z'
       .pop bc                                             ; POP BC            ; BC = the second output component
       .pop de                                             ; POP DE            ; DE = the first output component
* This entry point is used by the routines at #R$422E and #R$43C2.
convert_to_view:                                           ; >44ce
       .call @view_front                                   ; CALL $44E5        ; convert to the current view
       .ret                                                ; RET               ; 

********************************************************************************
* Add the object's position
* 
* Used by the routines at #R$43C2, #R$4873, #R$49FD, #R$4A5C and #R$4AEC.
* .
* Adds the object's position in the view - x from #R$E6D8, y from #R$F7D0
* and z from #R$E6DA (twice the object's z) - to a rotated vertex.
* 
* I:DE,BC,HL The vertex's x, y and z
* O:DE,BC,HL x, y and z relative to the player
add_object_position:                                       ; >44d2
       .push hl                                            ; PUSH HL           ; save the caller's HL (the "value on the stack")
       mov  @view_x,hl                                     ; LD HL,($E6D8)     ; HL = the projected first half (see #R$4255)
       a    de,hl                                          ; ADD HL,DE         ; HL += DE
       .ex_de_hl                                           ; EX DE,HL          ; DE = the combined result
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; HL = the vector's shared middle component
       a    bc,hl                                          ; ADD HL,BC         ; HL += BC
       .ex_sp_hl                                           ; EX (SP),HL        ; swap HL with the saved value on the stack
       mov  @view_z2,bc                                    ; LD BC,($E6DA)     ; BC = the depth scale (see #R$4255/#R$43C2)
       a    bc,hl                                          ; ADC HL,BC         ; HL += BC, with carry
       .pop bc                                             ; POP BC            ; BC = the earlier ($F7D0)+original combine
       .ret                                                ; RET               ; 

********************************************************************************
* Convert to the view: front
* 
* Used by the routine at #R$4464.
* .
* The front view's version of the call at #R$44CE: x and z are
* unchanged.
view_front:                                                ; >44e5
       .ret                                                ; RET               ; 

********************************************************************************
* Convert to the view: rear
* 
* The rear view's version of the call at #R$44CE (patched in by #R$64B5):
* x and z are negated.
* 
* I:DE x
* I:HL z
view_rear:                                                 ; >44e6
       sb   a,a                                            ; XOR A             ; 
       sb   @e,a                                           ; SUB E             ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   d,a                                            ; SUB D             ; 
       movb a,d                                            ; LD D,A            ; DE = -x
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; HL = -z
       .ret                                                ; RET               ; 

********************************************************************************
* Convert to the view: left
* 
* The left view's version of the call at #R$44CE (patched in by #R$64C9):
* the view's x is z, and its z is -x.
* 
* I:DE x
* I:HL z
view_left:                                                 ; >44f3
       .ex_de_hl                                           ; EX DE,HL          ; DE = z, HL = x
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; HL = -x
       .ret                                                ; RET               ; 

********************************************************************************
* Convert to the view: right
* 
* The right view's version of the call at #R$44CE (patched in by #R$64DD):
* the view's x is -z, and its z is x.
* 
* I:DE x
* I:HL z
view_right:                                                ; >44fb
       .ex_de_hl                                           ; EX DE,HL          ; DE = z, HL = x
       sb   a,a                                            ; XOR A             ; 
       sb   @e,a                                           ; SUB E             ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   d,a                                            ; SUB D             ; 
       movb a,d                                            ; LD D,A            ; DE = -z
       .ret                                                ; RET               ; 

********************************************************************************
* Straighten out the orientation
* 
* Used by the routines at #R$13FD and #R$1C5C.
* .
* Called for each object by the main loop (#R$13FD) and on the title
* screen (#R$1D3D). The orientation vectors drift from being unit length
* and at right angles as they're rotated, so after 200 rotations (counted
* in #R$F7E8 by the rotation routines at #R$221B and #R$22C0) this
* normalises the side and nose vectors (#R$4642), works out the roof
* vector as nose x side (#R$4599), and then the nose vector as side x
* roof.
straighten_orientation:                                    ; >4503
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = the counter
       cb   a,@bytes+>c8                                   ; CP $C8            ; 200 rotations yet?
       jhe  !                                              ; RET C             ; no
       .ret                                                ;                   
!
       sb   *hl,*hl                                        ; LD (HL),$00       ; start counting again
       li   hl,side_vector                                 ; LD HL,$F7D4       ; HL -> vector 1
       .call @normalise_vector                             ; CALL $4642        ; normalise the side vector
       li   hl,nose_vector                                 ; LD HL,$F7DA       ; HL -> vector 2
       .call @normalise_vector                             ; CALL $4642        ; normalise the nose vector
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; HL -> the "third vector already derived" guard byte
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; 
       .call @work_out_roof                                ; CALL $4599        ; roof = nose x side
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; side.y * roof.z
       mov  @roof_vector_z,de                              ; LD DE,($F7E4)     ; DE = vector3.z
       .call @multiply_components                          ; CALL $200A        ; HL = vector1.y * vector3.z
       .push hl                                            ; PUSH HL           ; save it
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; roof.y * side.z
       mov  @side_vector_z,de                              ; LD DE,($F7D8)     ; DE = vector1.z
       .call @multiply_components                          ; CALL $200A        ; HL = vector3.y * vector1.z
       .ex_de_hl                                           ; EX DE,HL          ; DE = that product
       .pop hl                                             ; POP HL            ; HL = the first product (vector1.y * vector3.z)
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; nose.x = the difference
       jlt  !                                              ; JP P,$4545        ; non-negative - keep it
       b    @straighten_nose_x                             ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...H:L = abs(HL)
       socb @bit7,h                                        ; SET 7,H           ; ...and tag it negative, sign-magnitude style
straighten_nose_x:                                         ; >4545
       mov  hl,@nose_vector                                ; LD ($F7DA),HL     ; 
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; roof.x * side.z
       mov  @side_vector_z,de                              ; LD DE,($F7D8)     ; DE = vector1.z
       .call @multiply_components                          ; CALL $200A        ; HL = vector3.x * vector1.z
       .push hl                                            ; PUSH HL           ; save it
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; side.x * roof.z
       mov  @roof_vector_z,de                              ; LD DE,($F7E4)     ; DE = vector3.z
       .call @multiply_components                          ; CALL $200A        ; HL = vector1.x * vector3.z
       .ex_de_hl                                           ; EX DE,HL          ; DE = that product
       .pop hl                                             ; POP HL            ; HL = the first product (vector3.x * vector1.z)
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; nose.y
       jlt  !                                              ; JP P,$456D        ; non-negative - keep it
       b    @straighten_nose_y                             ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...H:L = abs(HL)
       socb @bit7,h                                        ; SET 7,H           ; ...and tag it negative, sign-magnitude style
straighten_nose_y:                                         ; >456d
       mov  hl,@nose_vector_y                              ; LD ($F7DC),HL     ; 
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; side.x * roof.y
       mov  @roof_vector_y,de                              ; LD DE,($F7E2)     ; DE = vector3.y
       .call @multiply_components                          ; CALL $200A        ; HL = vector1.x * vector3.y
       .push hl                                            ; PUSH HL           ; save it
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; roof.x * side.y
       mov  @side_vector_y,de                              ; LD DE,($F7D6)     ; DE = vector1.y
       .call @multiply_components                          ; CALL $200A        ; HL = vector3.x * vector1.y
       .ex_de_hl                                           ; EX DE,HL          ; DE = that product
       .pop hl                                             ; POP HL            ; HL = the first product (vector1.x * vector3.y)
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; nose.z
       jlt  !                                              ; JP P,$4595        ; non-negative - keep it
       b    @straighten_nose_z                             ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...H:L = abs(HL)
       socb @bit7,h                                        ; SET 7,H           ; ...and tag it negative, sign-magnitude style
straighten_nose_z:                                         ; >4595
       mov  hl,@nose_vector_z                              ; LD ($F7DE),HL     ; store as the new vector2.z
       .ret                                                ; RET               ; 

********************************************************************************
* Work out the roof vector
* 
* Used by the routines at #R$2365, #R$23D9, #R$2C3C, #R$2EB2, #R$422E and
* #R$4503.
* .
* Sets the roof vector (#R$F7E0) to nose x side (#R$F7DA, #R$F7D4),
* multiplying with #R$200A - unless it's already been worked out since
* the orientation last changed (bit 7 of #R$F7CD, which this sets).
work_out_roof:                                             ; >4599
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       movb *hl,r0                                         ; BIT 7,(HL)        ; roof vector already worked out?
       andi r0,>8000                                       ;                   
       jeq  !                                              ; RET NZ            ; already worked out
       .ret                                                ;                   
!
       socb @bit7,*hl                                      ; SET 7,(HL)        ; it soon will be
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; nose.y * side.z
       mov  @side_vector_z,de                              ; LD DE,($F7D8)     ; 
       .call @multiply_components                          ; CALL $200A        ; (#R$200A)
       .push hl                                            ; PUSH HL           ; save it
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; side.y * nose.z
       mov  @nose_vector_z,de                              ; LD DE,($F7DE)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = the second product
       .pop hl                                             ; POP HL            ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; roof.x = the difference
       jlt  !                                              ; JP P,$45C6        ; positive - store it
       b    @work_out_roof_x                               ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; (sign-magnitude)
work_out_roof_x:                                           ; >45c6
       mov  hl,@roof_vector                                ; LD ($F7E0),HL     ; store roof.x
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; side.x * nose.z
       mov  @nose_vector_z,de                              ; LD DE,($F7DE)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .push hl                                            ; PUSH HL           ; save it
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; nose.x * side.z
       mov  @side_vector_z,de                              ; LD DE,($F7D8)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = the second product
       .pop hl                                             ; POP HL            ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; roof.y
       jlt  !                                              ; JP P,$45EE        ; positive - store it
       b    @work_out_roof_y                               ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
work_out_roof_y:                                           ; >45ee
       mov  hl,@roof_vector_y                              ; LD ($F7E2),HL     ; store roof.y
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; nose.x * side.y
       mov  @side_vector_y,de                              ; LD DE,($F7D6)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .push hl                                            ; PUSH HL           ; save it
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; side.x * nose.y
       mov  @nose_vector_y,de                              ; LD DE,($F7DC)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = the second product
       .pop hl                                             ; POP HL            ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; roof.z
       jlt  !                                              ; JP P,$4616        ; positive - store it
       b    @work_out_roof_z                               ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
work_out_roof_z:                                           ; >4616
       mov  hl,@roof_vector_z                              ; LD ($F7E4),HL     ; store roof.z
       .ret                                                ; RET               ; 

********************************************************************************
* Square a vector component
* 
* Used by the routine at #R$4642.
* .
* Part of #R$4642. Multiplies the component's magnitude by itself.
* 
* I:DE Component (sign-magnitude)
* O:HL,IX The square (HL the high word)
square_component:                                          ; >461a
       szcb @bit7,d                                        ; RES 7,D           ; DE = |component|
       .push de                                            ; PUSH DE           ; 
       sb   a,a                                            ; XOR A             ; 
       s    hl,hl                                          ; SBC HL,HL         ; 
       li   ix,>0000                                       ; LD IX,$0000       ; 
       movb a,b                                            ; LD B,A            ; 
       movb a,@c                                           ; LD C,A            ; HL:IX = 0, the square; BC:DE = |component|, which is shifted left
       .exx                                                ; EXX               ; 
       .pop bc                                             ; POP BC            ; BC = |component|, the multiplier
       movb b,a                                            ; LD A,B            ; 
       movb @bytes+>0f,b                                   ; LD B,$0F          ; 15 bits
_462b:                                                     ; >462b
       srl  a,1                                            ; RRA               ; TODO: check code. shift the next bit out of the multiplier
       ; RR C                                              ; RR C              ; TODO: check code. 
       .exx                                                ; EXX               ; 
       jnc  _4635                                          ; JR NC,$4635       ; TODO: check code. 0 - don't add
       a    de,ix                                          ; ADD IX,DE         ; 1: add BC:DE to the square
       a    bc,hl                                          ; ADC HL,BC         ; 
_4635:                                                     ; >4635
       ; SLA E                                             ; SLA E             ; TODO: check code. shift BC:DE left
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       sla  b,1                                            ; RL B              ; TODO: check code. 
       .exx                                                ; EXX               ; 
       sb   one,b                                          ; DJNZ $462B        ; next bit
       jne  _462b                                          ;                   
       .exx                                                ; EXX               ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Normalise a vector
* 
* Used by the routines at #R$4503 and #R$8E62.
* .
* Works out the length of the vector at HL - the square root (at $466B,
* two bits at a time) of the sum of the squares of its components
* (#R$461A) - and divides each component by it (#R$46A1), so that the
* vector's length is $4000 (1.0).
* 
* I:HL The vector (three sign-magnitude words)
normalise_vector:                                          ; >4642
       .push hl                                            ; PUSH HL           ; save the vector's address
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 components
_4645:                                                     ; >4645
       movb *hl,@e                                         ; LD E,(HL)         ; DE = the next component
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       .push hl                                            ; PUSH HL           ; save the pointer
       .push bc                                            ; PUSH BC           ; 
       .call @square_component                             ; CALL $461A        ; square it
       .pop bc                                             ; POP BC            ; 
       .ex_sp_hl                                           ; EX (SP),HL        ; put the square's high word on the stack...
       .push ix                                            ; PUSH IX           ; ...and its low word
       sb   one,b                                          ; DJNZ $4645        ; next component
       jne  _4645                                          ;                   
       li   ix,>0000                                       ; LD IX,$0000       ; 
       movb b,h                                            ; LD H,B            ; 
       movb b,@l                                           ; LD L,B            ; HL:IX = 0
       movb @bytes+>03,b                                   ; LD B,$03          ; add up the squares
_465c:                                                     ; >465c
       .pop de                                             ; POP DE            ; 
       a    de,ix                                          ; ADD IX,DE         ; 
       .pop de                                             ; POP DE            ; 
       a    de,hl                                          ; ADC HL,DE         ; HL:IX = the sum of the squares
       sb   one,b                                          ; DJNZ $465C        ; 
       jne  _465c                                          ;                   
       movb h,a                                            ; LD A,H            ; 
       movb @l,@c                                          ; LD C,L            ; A:C:IX = the sum
       sb   d,d                                            ; LD D,$00          ; 
       movb d,@e                                           ; LD E,D            ; DE = 0, the root so far
       movb d,h                                            ; LD H,D            ; HL = 0, the remainder
       movb d,@l                                           ; LD L,D            ; 
       movb @bytes+>10,b                                   ; LD B,$10          ; square root
_466d:                                                     ; >466d
       sb   @bytes+>40,a                                   ; SUB $40           ; subtract the trial value (DE with binary 01 appended)...
       s    de,hl                                          ; SBC HL,DE         ; ...from the remainder
       jnc  _4677                                          ; JR NC,$4677       ; TODO: check code. it fits
       ab   @bytes+>40,a                                   ; ADD A,$40         ; it doesn't: add it back
       a    de,hl                                          ; ADC HL,DE         ; 
_4677:                                                     ; >4677
       ; CCF                                               ; CCF               ; TODO: check code. the next bit of the root is 1 if it fitted
       ; RL E                                              ; RL E              ; TODO: check code. 
       sla  d,1                                            ; RL D              ; TODO: check code. shift it into the root
       a    ix,ix                                          ; ADD IX,IX         ; bring the next two bits of the sum...
       ; RL C                                              ; RL C              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; 
       a    ix,ix                                          ; ADD IX,IX         ; 
       ; RL C                                              ; RL C              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; ...into the remainder
       sb   one,b                                          ; DJNZ $466D        ; 16 bits of root
       jne  _466d                                          ;                   
       .pop hl                                             ; POP HL            ; HL -> the vector
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 components
_468f:                                                     ; >468f
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; save the pointer
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL = the component
       .call @divide_by_length                             ; CALL $46A1        ; divide it by the length
       .pop hl                                             ; POP HL            ; 
       movb @c,*hl                                         ; LD (HL),C         ; store it
       inc  hl                                             ; INC HL            ; 
       movb a,*hl                                          ; LD (HL),A         ; 
       inc  hl                                             ; INC HL            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $468F        ; next component
       jne  _468f                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Divide a component by the vector's length
* 
* Used by the routine at #R$4642.
* .
* Part of #R$4642. Returns the component * $4000 / length, keeping its
* sign (bit 7 of A).
* 
* I:DE Length
* I:HL Component (sign-magnitude)
* O:A,C The result (sign-magnitude)
divide_by_length:                                          ; >46a1
       .push hl                                            ; PUSH HL           ; save the component (for its sign)
       szcb @bit7,h                                        ; RES 7,H           ; HL = |component|
       sb   a,a                                            ; XOR A             ; 
       movb a,@c                                           ; LD C,A            ; 
       srl  h,1                                            ; SRL H             ; 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  h,1                                            ; SRL H             ; 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. HL:A:C = |component| * $4000
       movb @bytes+>10,b                                   ; LD B,$10          ; 16 bits of quotient
_46b2:                                                     ; >46b2
       ; CCF                                               ; CCF               ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. shift the next quotient bit in (complemented)...
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; ...and shift the dividend left
       s    de,hl                                          ; SBC HL,DE         ; subtract the length
       jnc  _46bd                                          ; JR NC,$46BD       ; TODO: check code. it fits
       a    de,hl                                          ; ADD HL,DE         ; it doesn't: add it back
_46bd:                                                     ; >46bd
       sb   one,b                                          ; DJNZ $46B2        ; 
       jne  _46b2                                          ;                   
       ; CCF                                               ; CCF               ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. A:C = the quotient
       .pop hl                                             ; POP HL            ; 
       czc  @bit7,h                                        ; BIT 7,H           ; component positive?
       jne  !                                              ; RET Z             ; yes - done
       .ret                                                ;                   
!
       socb @bytes+>80,a                                   ; OR $80            ; no: set the sign bit
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a ship: work out its size on screen
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Caches the logarithm of the object's depth - twice its z
* ($E6DA), or its distance (#R$EB8E) for the planet and sun (bit 3 of
* #R$F7CD) - for projecting (#R$EB9B, #R$E6F1). Then projects (#R$47F0) its
* targetable area (#R$F800) into $E6EF, for the laser sights ($4735), and
* its size (#R$F805) into #R$EB9E, its radius on screen (at $4738). The
* planet and sun are done by $4714.
* .
* At $4714, the radius on screen is 2 ^ ((K - log(distance)) / 1024), with
* K = $4C00 for the planet and $4800 for the sun (#R$21A3); 0 if that's too
* small ($4735).
* .
* At $4735, the radius is 0; at $4738, it's stored in #R$EB9E. Then, if the
* current view has a laser ($F818) and the object's X and Y coordinates
* ($E6D8, $F7D0), scaled by its distance (#R$47F0), are both within $E6EF,
* and it isn't exploding (bit 2 of #R$F7CD), it's in the sights: if the 'I'
* key has been pressed (#R$EF9D), shows its name (($F7FB), from its
* blueprint); marks it as in the sights for the laser (#R$EF99); and if the
* player's missile is armed (#R$E910 = 1), locks it onto the object -
* unless a missile is already on its way to it (#R$3016) - and shows
* "Missile Locked".
ship_screen_size:                                          ; >46ca
       mov  @view_z2,de                                    ; LD DE,($E6DA)     ; DE = depth
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = the object status byte
       andi a,>0800                                        ; AND $08           ; test bit 3 (the orientation-vector gate, as elsewhere)
       jeq  _46d9                                          ; JR Z,$46D9        ; not the planet or sun
       mov  @object_distance,de                            ; LD DE,($EB8E)     ; their distance
_46d9:                                                     ; >46d9
       movb d,a                                            ; LD A,D            ; A = DE's high byte
       socb a,a                                            ; OR A              ; 
       jeq  _46e7                                          ; JR Z,$46E7        ; zero - skip the normalize loop below
       movb a,@l                                           ; LD L,A            ; else: L = that high byte
       movb @bytes+>02,h                                   ; LD H,$02          ; H = $02 (bit-length table page)
       movb *hl,b                                          ; LD B,(HL)         ; B = table[D]'s bit length (shift count)
_46e1:                                                     ; >46e1
       srl  a,1                                            ; RRA               ; TODO: check code. shift DE right...
       ; RR E                                              ; RR E              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $46E1        ; ...B times (normalizing D:E)
       jne  _46e1                                          ;                   
       movb *hl,a                                          ; LD A,(HL)         ; A = the table's own stored exponent value
_46e7:                                                     ; >46e7
       movb a,@depth_shift                                 ; LD ($EB9B),A      ; the depth's exponent
       sb   a,a                                            ; XOR A             ; 
       ; SLA E                                             ; SLA E             ; TODO: check code. E doubled (word index)
       ab   @bytes+>08,a                                   ; ADC A,$08         ; A = 8 + carry (table page)
       movb a,h                                            ; LD H,A            ; HL -> the $0800-$0BFF scaled-word table
       movb @e,@l                                          ; LD L,E            ; 
       movb *hl,@e                                         ; LD E,(HL)         ; read the table entry (little-endian word)...
       ab   one,@l                                         ; INC L             ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       mov  de,@log_depth                                  ; LD ($E6F1),DE     ; log of the depth
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = the object status byte again
       andi a,>0800                                        ; AND $08           ; test bit 3 again
       jne  planet_screen_size                             ; JR NZ,$4714       ; the planet or sun
       mov  @bp_targetable_area,hl                         ; LD HL,($F800)     ; the targetable area
       sb   h,h                                            ; LD H,$00          ; keep only the low byte
       .call @project_coordinate                           ; CALL $47F0        ; project it
       mov  hl,@targetable_area                            ; LD ($E6EF),HL     ; for the laser sights
       mov  @bp_size,hl                                    ; LD HL,($F805)     ; the size
       sb   h,h                                            ; LD H,$00          ; keep only the low byte
       .call @project_coordinate                           ; CALL $47F0        ; project it
       jmp  _4738                                          ; JR $4738          ; its radius on screen
planet_screen_size:                                        ; >4714
       li   hl,>4c00                                       ; LD HL,$4C00       ; K for the planet
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>65                                   ; CP $65            ; is it mode $65?
       jne  _4721                                          ; JR NZ,$4721       ; no - keep the $4C00 base
       li   hl,>4800                                       ; LD HL,$4800       ; K for the sun
_4721:                                                     ; >4721
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; K - log(distance)
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; A = the shift count
       neg a                                               ; NEG               ; A = -exponent
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; A = -exponent * 4
       ab   h,a                                            ; ADD A,H           ; A += HL's high byte
       jhe  !                                              ; JP M,$4735        ; too small
       b    @check_sights                                  ;                   
!
       movb a,h                                            ; LD H,A            ; else: H = the combined high byte
       .call @antilog16                                    ; CALL $21A3        ; antilog
