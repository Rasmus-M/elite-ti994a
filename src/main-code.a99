       bl   @clip_and_draw_line                            ; CALL $3AC2        ; clip and draw
_49f9:                                                     ; >49f9
       .pop ix                                             ; POP IX            ; restore the caller's IX
       .pop bc                                             ; POP BC            ; and BC
       .endproc                                            ; RET               ; 

********************************************************************************
* Project a vertex
* 
* Used by the routine at #R$496D.
* .
* Each vertex is projected at most once per frame: if its flag in the table
* at IY (#R$E784, read by patching the displacement of an (IY+d) instruction)
* is set, its screen position is read back from the vertex cache (#R$E61D, at $4A4C). Otherwise the vertex (6 bytes, from #R$F7F5) is rotated into
* the view (#R$4464), added to the ship's position (#R$44D2) and, if it's
* in front of the player, projected (#R$47C4) and cached.
* .
* At $4A4C, reads the cached position from $E6C8 + E * 4, and returns with
* carry set (only vertices in front of the player are cached).
* 
* I:E Vertex number
* O:F Carry set if it's in front of the player
* O:BC,HL Its screen position
project_vertex:                                            ; >49fd
       .proc
       movb @e,a                                           ; LD A,E            ; A = the vertex index
       movb a,@project_vertex_flag+>0003                   ; LD ($4A03),A      ; patch the (IY+d) read to (IY+E) (#R$4A01+2)
project_vertex_flag:                                       ; >4a01
       movb @>00(iy),a                                     ; LD A,(IY+$00) / OR A; A = this vertex's cache flag
       jne  project_vertex_from_cache                      ; JR NZ,$4A4C       ; already cached - read it back
       movb @e,a                                           ; LD A,E            ; not cached: A = the vertex index again
       movb a,@project_vertex_set_flag+>0005               ; LD ($4A0D),A      ; patch the (IY+d) write to (IY+E) (#R$4A0B+2)
project_vertex_set_flag:                                   ; >4a0b
       movb @b255,@>05(iy)                                 ; LD (IY+$05),$FF   ; set a second, fixed-offset flag
       .exx                                                ; EXX               ; (scratch use of the shadow set)
       movb @bp_vertices,hl                                ; LD HL,($F7F5)     ; HL = the vector-record table's base pointer
       movb @bp_vertices+1,@l                              ;                   ;
       ab   a,a                                            ; ADD A,A           ; A = index * 2
       movb a,@c                                           ; LD C,A            ; C = it
       sb   b,b                                            ; LD B,$00          ; BC = index * 2, widened
       ab   a,a                                            ; ADD A,A           ; A = index * 4
       movb a,r0                                           ; LD ($E6C8),A      ; the vertex's cache slot: $E600 + index * 4 on the MSX...
       srl  r0,8                                           ;                   ; 
       ai   r0,scratch_buffer                              ;                   ; ...the same offset from scratch_buffer on the TI
       mov  r0,@vertex_cache_slot                          ;                   ; 
       ab   @l,a                                           ; ADD A,L           ; A += table base low byte
       movb a,@l                                           ; LD L,A            ; L = table base low byte + index*4
       jnc  project_vertex_record                          ; JP NC,$4A21       ; no carry - skip the high-byte bump
!
       ab   one,h                                          ; INC H             ; carry into the high byte
project_vertex_record:                                     ; >4a21
       a    bc,hl                                          ; ADD HL,BC         ; HL = table base + index*4 + index*2 = + index*6 (6 bytes/record)
       movb *hl+,@rotated_vector+1                         ; LD DE,$E7EA       ; copy the 6-byte vector, swapping each little-endian word
       movb *hl+,@rotated_vector                           ; LDI               ; to big-endian for word access
       movb *hl+,@rotated_vector_y+1                       ; LDI               ; 
       movb *hl+,@rotated_vector_y                         ; LDI               ; 
       movb *hl+,@rotated_vector_z+1                       ; LDI               ; 
       movb *hl+,@rotated_vector_z                         ; LDI x 2           ; (DE and BC are not used afterwards)
       bl   @rotate_vertex                                 ; CALL $4464        ; combine via #R$4464
       bl   @add_object_position                           ; CALL $44D2        ; combine that result via #R$44D2
       movb h,a                                            ; LD A,H / OR A     ; test the combined result's sign
       jgt  !                                              ; RET M             ; negative - no valid projection, carry clear
       jeq  !                                              ;                   ; 
       .retnc                                              ;                   
!
       socb @l,a                                           ; OR L              ; exactly zero?
       jne  !                                              ; RET Z             ; yes - no valid projection, carry clear
       .retnc                                              ;                   
!
       bl   @project_point                                 ; CALL $47C4        ; finish the projection
       mov  @vertex_cache_slot,hl                          ; LD HL,($E6C8)     ; HL -> this vertex's cache slot
       movb @c,*hl                                         ; LD (HL),C         ; cache (C,B,E,D) - the projected point
       inc  hl                                             ; INC L             ; 
       movb b,*hl                                          ; LD (HL),B         ; 
       inc  hl                                             ; INC L             ; 
       movb @e,*hl                                         ; LD (HL),E         ; 
       inc  hl                                             ; INC L             ; 
       movb d,*hl                                          ; LD (HL),D         ; 
       .ex_de_hl                                           ; EX DE,HL          ; HL = the projected point's second word
       .retc                                               ; RET               ; 
project_vertex_from_cache:                                 ; >4a4c
       movb @e,a                                           ; LD A,E            ; A = the vertex index
       ab   a,a                                            ; ADD A,A           ; A *= 4 (2 doublings)...
       ab   a,a                                            ; ADD A,A           ; 
       movb a,r0                                           ; LD L,A            ; HL -> this vertex's cache slot...
       srl  r0,8                                           ; LD H,$E6          ; 
       ai   r0,scratch_buffer                              ;                   ; ...index * 4 from scratch_buffer ($E600 on the MSX)
       mov  r0,hl                                          ;                   ; 
       movb *hl,@c                                         ; LD C,(HL)         ; C = the slot's first byte
       inc  hl                                             ; INC L             ; 
       movb *hl,b                                          ; LD B,(HL)         ; B = the second byte - BC is the first cached word
       inc  hl                                             ; INC L             ; 
       movb *hl,@e                                         ; LD E,(HL)         ; E = the third byte
       inc  hl                                             ; INC L             ; 
       movb *hl,d                                          ; LD D,(HL)         ; D = the fourth byte - DE is the second cached word
       .ex_de_hl                                           ; EX DE,HL          ; HL = the second cached word (DE becomes a leftover pointer, unused)
       .retc                                               ; RET               ; 

********************************************************************************
* TI: the gun vertex relative to the player
*
* For #R$43C2 (in ROM bank 12), as the vertices are in the blueprint's bank.
*
* O:DE,BC,HL x, y and z
* O:F Carry set if it's in front of the player (z positive)
gun_vertex_relative:                                       
       .proc                                               ;                   ; 
       .save_bank                                          ;                   ; 
       bl   @select_blueprint_bank                         ;                   ; select the blueprint's bank
       movb @bp_gun_vertex,a                               ; LD A,($F803)      ; the gun vertex
       bl   @vertex_relative                               ; CALL $4A5C        ; relative to the player
       jnc  gun_vertex_relative_1                          ;                   ; 
       .restore_bank                                       ;                   ; 
       .retc                                               ;                   ; 
gun_vertex_relative_1:                                     
       .restore_bank                                       ;                   ; 
       .retnc                                              ;                   ; 

********************************************************************************
* Get a vertex relative to the player
* 
* Used by the routines at #R$43C2 and #R$496D.
* .
* Copies vertex A (6 bytes, from #R$F7F5) to #R$E7EA, rotates it into the
* view (#R$4464) and adds the object's position (#R$44D2).
* 
* I:A Vertex number
* O:DE,BC,HL x, y and z
* O:F Carry set if it's in front of the player (z positive)
vertex_relative:                                           ; >4a5c
       .proc
       movb @bp_vertices,hl                                ; LD HL,($F7F5)     ; HL = the vector-record table's base pointer
       movb @bp_vertices+1,@l                              ;                   ;
       ab   a,a                                            ; ADD A,A           ; A = the record index * 2
       movb a,@c                                           ; LD C,A            ; C = that doubled index
       sb   b,b                                            ; LD B,$00          ; B = 0 (widen to BC)
       ab   a,a                                            ; ADD A,A           ; A = the index * 4
       ab   @l,a                                           ; ADD A,L           ; A += the table base's low byte
       movb a,@l                                           ; LD L,A            ; L = table base low byte + index*4
       jnc  vertex_relative_record                         ; JP NC,$4A6A       ; no carry from that add - skip the high-byte bump
!
       ab   one,h                                          ; INC H             ; else carry into the high byte
vertex_relative_record:                                    ; >4a6a
       a    bc,hl                                          ; ADD HL,BC         ; HL = table base + index*4 + index*2 = table base + index*6
       movb *hl+,@rotated_vector+1                         ; LD DE,$E7EA       ; copy the 6-byte vector, swapping each little-endian word
       movb *hl+,@rotated_vector                           ; LDI               ; to big-endian for word access
       movb *hl+,@rotated_vector_y+1                       ; LDI               ; 
       movb *hl+,@rotated_vector_y                         ; LDI               ; 
       movb *hl+,@rotated_vector_z+1                       ; LDI               ; 
       movb *hl+,@rotated_vector_z                         ; LDI x 2           ; (DE and BC are not used afterwards)
       bl   @rotate_vertex                                 ; CALL $4464        ; combine the copied vector via #R$4464
       bl   @add_object_position                           ; CALL $44D2        ; combine that result with cached deltas via #R$44D2
       mov  hl,hl                                          ;                   ; (the RET changed the status)
       jne  !                                              ; RET Z             ; zero (from #R$44D2's result) - return with its data-dependent carry
       .retc                                               ; (the add's carry can't survive the return on the TI - treat zero as valid)
!
       movb h,a                                            ; LD A,H / OR A     ; A = the combined result's high byte
       jgt  !                                              ; RET M             ; negative - return with carry clear
       jeq  !                                              ;                   ; 
       .retnc                                              ;                   
!
       .retc                                               ; RET               ; and return with carry set

********************************************************************************
* Draw a ship: too small or far away
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Draws the object as a circle of its radius on screen
* (#R$EB9E): the planet as an outline (#R$3D0E), anything else - the sun,
* or a distant ship - as a filled disc (#R$3DF4).
draw_small:                                                ; >4a86
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; HL = the cached range value (see #R$4735/#R$4738)
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>64                                   ; CP $64            ; is it mode $64?
       jeq  !                                              ; JP NZ,$3DF4       ; no - dispatch to #R$3DF4
       b    @draw_disc                                     ;                   
!
       li   de,>0002                                       ; LD DE,$0002       ; yes: DE = 2
       movb @bytes+>0a,b                                   ; LD B,$0A          ; B = 10
       b    @draw_circle_jmp                               ; JP $3D0E          ; dispatch to #R$3D0E instead

********************************************************************************
* Draw a ship: is it on screen?
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Checks whether the object's circle on screen - its
* position (BC, DE) and radius (#R$EB9E) - overlaps the view, which runs
* from x = -116 to 118 and y = -63 to 65 (the edges at $E6E0-$E6E6 are
* biased by $8000).
* 
* I:BC x on screen
* I:DE y on screen
* O:A $FF if it's on screen, 0 if not
on_screen:                                                 ; >4a99
       movb @bytes+>80,a                                   ; LD A,$80          ; A = $80
       ab   d,a                                            ; ADD A,D           ; sign-flip D (of DE, the second scaled result)...
       movb a,d                                            ; LD D,A            ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; A = $80 again
       ab   b,a                                            ; ADD A,B           ; sign-flip B (of BC, the first scaled result)...
       movb a,b                                            ; LD B,A            ; 
       .push de                                            ; PUSH DE           ; save the sign-flipped D and original E
       mov  @screen_radius,de                              ; LD DE,($EB9E)     ; DE = the cached range value (see #R$4735/#R$4738)
       movb b,h                                            ; LD H,B            ; HL = the sign-flipped B, original C
       movb @c,@l                                          ; LD L,C            ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = (flipped-B:C) - range
       mov  hl,@on_screen_left                             ; LD ($E6E0),HL     ; store the lower bound
       movb b,h                                            ; LD H,B            ; HL = (flipped-B:C) again
       movb @c,@l                                          ; LD L,C            ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = (flipped-B:C) + range
       mov  hl,@on_screen_right                            ; LD ($E6E2),HL     ; store the upper bound
       .pop bc                                             ; POP BC            ; BC = the sign-flipped D, original E (saved above)
       movb b,h                                            ; LD H,B            ; HL = that pair
       movb @c,@l                                          ; LD L,C            ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = (flipped-D:E) - range
       mov  hl,@on_screen_bottom                           ; LD ($E6E6),HL     ; store a second lower bound
       movb b,h                                            ; LD H,B            ; HL = (flipped-D:E) again
       movb @c,@l                                          ; LD L,C            ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = (flipped-D:E) + range
       mov  hl,@on_screen_top                              ; LD ($E6E4),HL     ; store a second upper bound
       sb   a,a                                            ; XOR A             ; A = 0 (the "out of range" return value)
       mov  @on_screen_left,hl                             ; LD HL,($E6E0)     ; HL = the first lower bound
       li   de,>8076                                       ; LD DE,$8076       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $8076
       jnc  !                                              ; RET NC            ; still >= - out of range, return with A=0
       rt                                                  ;                   
!
       mov  @on_screen_right,hl                            ; LD HL,($E6E2)     ; HL = the first upper bound
       li   de,>7f8c                                       ; LD DE,$7F8C       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $7F8C
       joc  !                                              ; RET C             ; below it - out of range, return with A=0
       rt                                                  ;                   
!
       mov  @on_screen_top,hl                              ; LD HL,($E6E4)     ; HL = the second upper bound
       li   de,>7fc1                                       ; LD DE,$7FC1       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $7FC1
       joc  !                                              ; RET C             ; below it - out of range, return with A=0
       rt                                                  ;                   
!
       mov  @on_screen_bottom,hl                           ; LD HL,($E6E6)     ; HL = the second lower bound
       li   de,>8041                                       ; LD DE,$8041       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $8041
       jnc  !                                              ; RET NC            ; still >= - out of range, return with A=0
       rt                                                  ;                   
!
       sb   one,a                                          ; DEC A             ; all four checks passed - A = $FF (in range)
       rt                                                  ; RET               ; return with A nonzero

********************************************************************************
* Draw an explosion
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Draws a cloud of dots: one for each of the next
* ($F7EF + 1, at most 50) random offsets in the table at $EEC6 (#R$47A1),
* each multiplied by the explosion's size (#R$F7F0, as a logarithm at
* #R$EB90), added to its position (#R$44D2), projected (#R$47C4) and
* plotted (#R$3DD7). As the explosion's countdown runs out there are
* fewer dots, and they spread as the size grows (#R$2556).
draw_explosion:                                            ; >4aec
       movb @per_type_parameter_block,r1                   ; LD A,($F7F0)      ; A = the table index at $F7F0
       srl  r1,7                                           ; ADD A,A           ; A *= 2 - 2 bytes per entry
       andi r1,>01fe                                       ;                   ; 
       ai   r1,log_table                                   ; ADC A,$08         ; HL -> the entry in the log table
       mov  *r1,r0                                         ; LD DE,$EB90 / LDI x 2; R0 = the entry (TI: log_table is big-endian)...
       movb r0,@perentry_loop_pointer+1                    ;                   ; ...stored little-endian at $EB90 for #R$47A1
       swpb r0                                             ;                   ; 
       movb r0,@perentry_loop_pointer                      ;                   ; 
       li   hl,explosion_random_numbers                    ; LD HL,$EEC6       ; HL = $EEC6 - the list #R$47A1 walks
       movb hl,@explosion_random_pointer+1                 ; LD ($E6DE),HL     ; store it to $E6DE
       movb @l,@explosion_random_pointer                   ;                   ;
       movb @handler_countdown,a                           ; LD A,($F7EF)      ; A = a count at $F7EF
       ab   one,a                                          ; INC A             ; A += 1
       cb   a,@bytes+>32                                   ; CP $32            ; compare against 50
       jl   _4b0d                                          ; JR C,$4B0D        ; below 50 - keep it
       movb @bytes+>32,a                                   ; LD A,$32          ; else clamp to 50
_4b0d:                                                     ; >4b0d
       movb a,b                                            ; LD B,A            ; B = the clamped loop count
_4b0e:                                                     ; >4b0e
       .push bc                                            ; PUSH BC           ; save BC across this iteration's calls
       bl   @explosion_dot                                 ; CALL $47A1        ; the next dot's offset (#R$47A1)
       bl   @add_object_position                           ; CALL $44D2        ; add the explosion's position (#R$44D2)
       bl   @project_point                                 ; CALL $47C4        ; project it (#R$47C4)
       .ex_de_hl                                           ; EX DE,HL          ; HL = y on screen
       movb b,d                                            ; LD D,B            ; 
       movb @c,@e                                          ; LD E,C            ; DE = x on screen
       bl   @clip_test_and_plot_single_point               ; CALL $3DD7        ; plot the dot (#R$3DD7)
       .pop bc                                             ; POP BC            ; restore the loop counter
       sb   one,b                                          ; DJNZ $4B0E        ; loop
       jne  _4b0e                                          ;                   
       .ret                                                ; RET               ; done

********************************************************************************
* Clip a line where it passes the player
* 
* Used by the routines at #R$43C2 and #R$496D.
* .
* For a line from a point behind the player (#R$F769) to one in front
* (#R$F76F), finds where it crosses z = 1 - a fraction (1 - z1) / (z2 - z1)
* of the way along (#R$4B76) - and projects that point.
* 
* O:BC,HL The point on screen
clip_line_at_player:                                       ; >4b22
       .proc
       movb @line_end_2_z+1,hl                             ; LD HL,($F773)     ; HL = the front end's z
       movb @line_end_2_z,@l                               ;                   ;
       movb @line_end_1_z+1,de                             ; LD DE,($F76D)     ; DE = the back end's z
       movb @line_end_1_z,@e                               ;                   ;
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = z2 - z1
       jgt  clip_line_dz                                   ; JP P,$4B35        ; non-negative - keep it
       jeq  clip_line_dz                                   ;                   ; 
!
       neg  hl                                             ; SUB L             ; ...HL = |z2 - z1|
clip_line_dz:                                              ; >4b35
       .ex_de_hl                                           ; EX DE,HL          ; DE = that absolute difference
       li   hl,>0001                                       ; LD HL,$0001       ; HL = 1
       movb @line_end_1_z+1,bc                             ; LD BC,($F76D)     ; BC = z1
       movb @line_end_1_z,@c                               ;                   ;
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; HL = 1 - z1
       jgt  clip_line_divide                               ; JP P,$4B49        ; non-negative - keep it
       jeq  clip_line_divide                               ;                   ; 
!
       neg  hl                                             ; SUB L             ; ...HL = |1 - z1|
clip_line_divide:                                          ; >4b49
       mov  hl,r1                                          ; LD C,H            ; 
       srl  r1,8                                           ;                   ; 
       mov  hl,r2                                          ; SUB L             ; 
       sla  r2,8                                           ; SBC HL,BC         ; R1:R2 = |1 - z1| * 256
       div  de,r1                                          ; SBC HL,DE         ; R1 = R1:R2 / |z2 - z1| (the restoring division on the Z80)
       swpb r1                                             ;                   ; 
       movb r1,a                                           ; CPL               ; A = 256 * |1 - z1| / |z2 - z1|, the fraction of the way along
       movb @line_end_2_y+1,hl                             ; LD HL,($F771)     ; HL = y2
       movb @line_end_2_y,@l                               ;                   ;
       movb @line_end_1_y+1,de                             ; LD DE,($F76B)     ; DE = y1
       movb @line_end_1_y,@e                               ;                   ;
       bl   @lerp_towards                                  ; CALL $4B76        ; HL = y1 + (y2 - y1) * A / 256 (#R$4B76)
       .push hl                                            ; PUSH HL           ; save it
       movb @line_end_2_x+1,hl                             ; LD HL,($F76F)     ; HL = x2
       movb @line_end_2_x,@l                               ;                   ;
       movb @line_end_1_x+1,de                             ; LD DE,($F769)     ; DE = x1
       movb @line_end_1_x,@e                               ;                   ;
       bl   @lerp_towards                                  ; CALL $4B76        ; HL = x1 + (x2 - x1) * A / 256
       movb h,b                                            ; LD B,H            ; BC = x
       movb @l,@c                                          ; LD C,L            ; 
       .pop hl                                             ; POP HL            ; HL = y
       .endproc                                            ; RET               ; 

********************************************************************************
* Linear interpolation: DE + (HL-DE) * A/256
* 
* Used by the routine at #R$4B22.
* .
* Moves A/256 of the way from DE towards HL - a standard lerp/easing
* step. A is an unsigned 0-255 fraction (0 leaves DE unchanged, 255
* lands one 256th short of HL); the sign of (HL-DE) is preserved
* through the #R$1F86 multiply by working in sign-magnitude form and
* only truncating (not rounding) the low byte of the product, unlike
* #R$24D1/#R$848D's rounded scaling.
* 
* I:A Unsigned interpolation fraction, 0-255 (0=DE, 255~HL)
* I:HL Target value
* I:DE Starting value
* O:HL Interpolated result
lerp_towards:                                              ; >4b76
       .proc
       .push af                                            ; PUSH AF           ; Save the caller's A/flags for the final RET
       .push de                                            ; PUSH DE           ; Save DE (the starting value) for the final add
       .ex_af_af_                                          ; EX AF,AF'         ; Stash the interpolation fraction
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL := HL - DE
       movb h,a                                            ;                   ; A = the difference's high byte, so the PUSH/POP AF below keep its sign
       .push af                                            ; PUSH AF           ; Save the difference's sign for later
       jgt  lerp_multiply                                  ; JP P,$4B86        ; 
       jeq  lerp_multiply                                  ;                   ; 
!
       neg  hl                                             ; SUB L             ; HL := |HL-DE|
lerp_multiply:                                             ; >4b86
       .ex_af_af_                                          ; EX AF,AF'         ; Recover the interpolation fraction
       bl   @multiply_16x8                                 ; CALL $1F86        ; A:HL := |HL-DE| * A (24-bit product)
       movb h,@l                                           ; LD L,H            ; 
       movb a,h                                            ; LD H,A            ; Keep the product's top 16 bits (product >> 8), truncated
       .pop af                                             ; POP AF            ; Recover the difference's sign
       jgt  lerp_add                                       ; JP P,$4B96        ; 
       jeq  lerp_add                                       ;                   ; 
!
       neg  hl                                             ; SUB L             ; Reapply the sign of (HL-DE)
lerp_add:                                                  ; >4b96
       .pop de                                             ; POP DE            ; DE := the original starting value
       a    de,hl                                          ; ADD HL,DE         ; HL := DE + (HL-DE)*A/256
       .pop af                                             ; POP AF            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* The message "Missile Locked"
       .msxalign >4b9a
msg_missile_locked:                                        ; >4b9a
       text 'Missile Locke',>e4

********************************************************************************
* Arrive in a system: its data and market
* 
* Used by the routines at #R$894D and #R$A469.
* .
* Generates the data for the current system (#R$EB67, #R$4C9B) and copies
* it to #R$F75A. Sets the price of fuel ($E724) to s0_lo AND 15. Then works
* out the market (#R$F789) from the market prices (#R$0A02), as BBC Elite
* does, with E = 7 - the economy (#R$F754) and a random byte (#R$EFAA) for
* the variation: for each of the goods, the price is the base price +
* (random AND mask) + E * factor, and the quantity the base quantity +
* (random AND mask) - E * factor (0-63, or 0 if negative).
arrive_in_system:                                          ; >4ba8
       .proc                                               ;                   ; 
       movb @current_system,a                              ; LD A,($EB67)      ; A = the current system
       bl   @generate_system                               ; CALL $4C9B        ; generate the current system
       li   hl,system_s0_lo                                ; LD HL,$F74B       ; 
       li   de,current_system_seeds                        ; LD DE,$F75A       ; 
       li   bc,>000f                                       ; LD BC,$000F       ; 15 bytes
       .ldir                                               ; LDIR              ; copy its data to $F75A
       movb @system_economy,a                              ; LD A,($F754)      ; A = economy
       li   r0,>0700                                       ; XOR $07           ; E = 7 - economy (0 for Rich Industrial, 7 for Poor Agricultural)
       xor  a,r0                                           ;                   ; 
       movb r0,@e                                          ; LD E,A            ; 
       movb @system_seeds,a                                ; LD A,($E904)      ; rotating_accumulator's low byte
       andi a,>0f00                                        ; AND $0F           ; 
       movb a,@fuel_price                                  ; LD ($E724),A      ; the price of fuel
       li   ix,market_prices                               ; LD IX,$0A02       ; IX -> the market prices
       li   iy,market                                      ; LD IY,$F789       ; IY -> the market
       movb @bytes+>11,b                                   ; LD B,$11          ; 17 goods
_4bd5:                                                     ; >4bd5
       movb @3(ix),r0                                      ; LD A,(IX+$03)     ; 
       movb @market_price_roll,r1                          ; AND C             ; (C = the random byte, #R$EFAA)
       inv  r1                                             ;                   ; 
       szcb r1,r0                                          ;                   ; 
       srl  r0,8                                           ; LD L,A / LD H,B   ; R0 = random AND mask
       movb @1(ix),r1                                      ; LD A,(IX+$01)     ; 
       andi r1,>1f00                                       ; AND $1F           ; 
       srl  r1,8                                           ; LD D,A            ; R1 = factor
       movb @e,r2                                          ;                   ; 
       srl  r2,8                                           ;                   ; 
       mpy  r2,r1                                          ; CALL $1F51        ; (TI: MPY instead of #R$1F51)
       andi r2,>00ff                                       ; LD C,A            ; R2 = E * factor (8 bits, as on the MSX)
       mov  r0,hl                                          ; PUSH HL / ADD HL,BC; 
       a    r2,hl                                          ; EX DE,HL          ; (here HL =) random AND mask + E * factor
       mov  r0,de                                          ; POP HL / SBC HL,BC; 
       s    r2,de                                          ;                   ; (and DE =) random AND mask - E * factor
       movb @1(ix),r1                                      ; BIT 7,(IX+$01)    ; this record's sign bit?
       jlt  _4bf4                                          ; JR NZ,$4BF4       ; a negative factor: the price goes down, the quantity up
       .ex_de_hl                                           ;                   ; (TI: with HL and DE the other way round from the MSX)
_4bf4:                                                     ; >4bf4
       movb *ix,r1                                         ; LD C,(IX+$00)     ; 
       srl  r1,8                                           ;                   ; 
       a    r1,de                                          ; ADD HL,BC         ; add the base price
       movb @e,*iy                                         ; LD (IY+$00),L     ; price
       movb @2(ix),r1                                      ; LD C,(IX+$02)     ; 
       srl  r1,8                                           ; EX DE,HL          ; 
       a    hl,r1                                          ; ADD HL,BC         ; add the base quantity
       swpb r1                                             ; LD A,L / OR A     ; 
       movb r1,r1                                          ;                   ; 
       jgt  arrive_in_system_2                             ; JP P,$4C08        ; 
       jeq  arrive_in_system_2                             ;                   ; 
       clr  r1                                             ; XOR A             ; negative - none
       jmp  _4c0a                                          ; JR $4C0A          ; 
arrive_in_system_2:                                        ; >4c08
       andi r1,>3f00                                       ; AND $3F           ; 0-63
_4c0a:                                                     ; >4c0a
       movb r1,@1(iy)                                      ; LD (IY+$01),A     ; quantity
       movb @1(ix),r1                                      ; LD A,(IX+$01)     ; 
       srl  r1,5                                           ; RLCA x 3          ; 
       andi r1,>0300                                       ; AND $03           ; 
       movb r1,@2(iy)                                      ; LD (IY+$02),A     ; units
       movb @4(ix),@3(iy)                                  ; LD A,(IX+$04) / LD (IY+$03),A; how illegal
       ai   ix,5                                           ; ADD IX,BC         ; next of the goods
       ai   iy,4                                           ; ADD IY,BC         ; 
       sb   one,b                                          ; DJNZ $4BD5        ; 
       jne  _4bd5                                          ;                   ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Work out a system's data from its seeds
* 
* Used by the routines at #R$4C9B and #R$55A3.
* .
* Copies the seeds (#R$E904) to #R$F74B, and works out the system's
* coordinates (#R$F751, #R$F752), government (#R$F753), economy
* (#R$F754) and tech level (#R$F755), then its name (#R$4CE7).
system_data_from_seeds:                                    ; >4c2b
       .proc                                               ;                   ; 
       li   hl,system_seeds                                ; LD HL,$E904       ; source: rotating_accumulator
       li   de,system_s0_lo                                ; LD DE,$F74B       ; 
       li   bc,>0006                                       ; LD BC,$0006       ; 6 bytes
       .ldir                                               ; LDIR              ; copy the seeds
       movb @seed_s0_hi,a                                  ; LD A,($E905)      ; A = s0_hi
       srl  a,1                                            ; SRL A             ; 
       movb a,@system_y                                    ; LD ($F752),A      ; y = s0_hi / 2
       movb @seed_s1_hi,a                                  ; LD A,($E907)      ; A = s1_hi
       movb @bytes+>fc,@e                                  ; LD E,$FC          ; 
       bl   @multiply_a_e_16bit                            ; CALL $1F60        ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       ab   h,a                                            ; ADD A,H           ; 
       movb a,@system_x                                    ; LD ($F751),A      ; x = 2 + s1_hi * 252 / 256
       movb @seed_s1,a                                     ; LD A,($E906)      ; A = s1_lo
       srl  a,3                                            ; RRCA x 3          ; 
       andi a,>0700                                        ; AND $07           ; 
       movb a,@system_government                           ; LD ($F753),A      ; government = bits 3-5 of s1_lo
       sb   @c,@c                                          ;                   ; 
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jhe  _4c58                                          ; SBC A,A / AND $02 ; 
       movb @bytes+>02,@c                                  ; LD C,A            ; C = 2 for Anarchy or Feudal, 0 otherwise
_4c58:                                                     
       movb @seed_s0_hi,a                                  ; LD A,($E905)      ; 
       andi a,>0700                                        ; AND $07           ; 
       socb @c,a                                           ; OR C              ; 
       li   r0,>0700                                       ; XOR $07           ; 
       xor  a,r0                                           ;                   ; 
       movb r0,a                                           ;                   ; 
       movb a,@system_economy                              ; LD ($F754),A      ; economy
       ab   @bytes+>03,a                                   ; ADD A,$03         ; 
       movb @seed_s1_hi,r0                                 ; LD HL,$E907 / AND (HL); 
       inv  r0                                             ;                   ; 
       szcb r0,a                                           ;                   ; 
       movb @seed_s2,r0                                    ; LD A,($E908) / RRA; bit 0 of s2_lo...
       andi r0,>0100                                       ;                   ; 
       ab   r0,a                                           ; LD A,B / ADC A,$00; ...added in
       movb a,@system_tech_level                           ; LD ($F755),A      ; tech level
       li   ix,system_name                                 ; LD IX,$F756       ; 
       bl   @system_name_from_seeds                        ; JP $4CE7          ; work out the name
       .endproc                                            ;                   ; 

********************************************************************************
* Generate the data for a system
* 
* Used by the routines at #R$4BA8, #R$4CAF, #R$4DAB, #R$4F64, #R$538B, #R$53ED,
* #R$53FD, #R$6141 and #R$894D.
* .
* As in BBC Elite, each system's seeds are those of the one before,
* twisted four times: starts from the galaxy's seeds (#R$5607), twists
* them 4 * A times (#R$5613), and works out the system's data from the
* result (#R$4C2B). Preserves BC, DE and HL.
* 
* I:A System number (0-255)
generate_system:                                           ; >4c9b
       .proc                                               ;                   ; 
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, as interrupts are off, so the sound effects play on)
       .exx                                                ; EXX               ; 
       bl   @galaxy_seeds_to_system                        ; CALL $5607        ; start from the galaxy's seeds
       movb a,a                                            ; OR A              ; 
       jeq  _4caa                                          ; JR Z,$4CAA        ; system 0
_4ca2:                                                     ; >4ca2
       .push af                                            ; EX AF,AF'         ; 
       bl   @next_system_seeds                             ; CALL $5613        ; move on to the next system
       .pop af                                             ; EX AF,AF'         ; 
       sb   one,a                                          ; DEC A             ; 
       jne  _4ca2                                          ; JR NZ,$4CA2       ; 
_4caa:                                                     ; >4caa
       bl   @system_data_from_seeds                        ; CALL $4C2B        ; work out the system's data
       .exx                                                ; EXX               ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Generate a system's name
* 
* Used by the routines at #R$4F64, #R$52CE, #R$6066, #R$6164, #R$6276, #R$9120,
* #R$91AA, #R$9A4B, #R$9B43 and #R$9B7C.
* .
* Generates the data for system A (#R$4C9B), then expands its name from
* the digram indices at $F756 into #R$E717 (#R$4CB8).
* 
* I:A System number
* O:A Length of the name
generate_system_name:                                      ; >4caf
       .proc                                               ;                   ; 
       bl   @generate_system                               ; CALL $4C9B        ; 
       li   hl,system_name                                 ; LD HL,$F756       ; 
       bl   @expand_name                                   ; JP $4CB8          ; 
       .endproc                                            ;                   ; 

********************************************************************************
* Expand a name from its letter pairs
* 
* Used by the routines at #R$4CAF, #R$55A3 and #R$9B7C.
* .
* Builds a name in #R$E717 from the four letter-pair indices at HL (0-31,
* into the table at #R$0E41), leaving out spaces (so index 0 adds
* nothing), and capitalises its first letter. Used for system names
* (#R$4CAF, #R$55D2) and the random names in descriptions (#R$9B7C).
* 
* I:HL The four indices
* O:A The name's length
expand_name:                                               ; >4cb8
       li   de,text_buffer                                 ; LD DE,$E717       ; DE -> the output buffer
       sb   @c,@c                                          ; LD C,$00          ; C = output character count
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 index bytes
_4cbf:                                                     ; >4cbf
       movb *hl+,r1                                        ; LD A,(HL) / INC HL; the next index byte
       srl  r1,8                                           ;                   ; 
       sla  r1,1                                           ; ADD A,A           ; (TI: indexed, not built from the page $0E)
       movb @name_letter_pairs(r1),r0                      ; LD A,(HL)         ; the pair's first character
       cb   r0,@bytes+>20                                  ; CP $20            ; a space (padding, not a real letter)?
       jeq  _4cd7                                          ; JR Z,$4CD7        ; yes - skip it
       movb r0,*de+                                        ; LD (DE),A / INC DE; no - append it
       ab   one,@c                                         ; INC C             ; 
_4cd7:                                                     ; >4cd7
       movb @name_letter_pairs+1(r1),r0                    ; LD A,(HL)         ; and the second
       cb   r0,@bytes+>20                                  ; CP $20            ; 
       jeq  _4cd7_2                                        ; JR Z,$4CD7        ; 
       movb r0,*de+                                        ; LD (DE),A / INC DE; 
       ab   one,@c                                         ; INC C             ; 
_4cd7_2:                                                   
       sb   one,b                                          ; DJNZ $4CBF        ; next index byte
       jne  _4cbf                                          ;                   ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,*de                                          ; LD (DE),A         ; null-terminate the name
       szcb @bit5,@text_buffer                             ; RES 5,(HL)        ; force the first character to uppercase
       movb @c,a                                           ; LD A,C            ; A = the character count
       rt                                                  ; RET               ; 

********************************************************************************
* Work out a system's name
* 
* Used by the routines at #R$4C2B and #R$9B7C.
* .
* Stores four indices (0-31) into the letter pairs at #R$0E41, from the
* seeds (#R$E904), twisting them between each (#R$2147). As in BBC Elite,
* the name has only three pairs (the fourth index being 0) if bit 6 of
* s0_lo is clear.
* 
* I:IX Where to store them (#R$F756)
system_name_from_seeds:                                    ; >4ce7
       .proc                                               ;                   ; 
       movb @system_seeds,a                                ; LD A,($E904)      ; A = s0_lo
       .push af                                            ; PUSH AF           ; 
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 bytes
_4ced:                                                     ; >4ced
       movb @seed_s2_hi,a                                  ; LD A,($E909)      ; A = s2_hi
       andi a,>1f00                                        ; AND $1F           ; 0-31
       movb a,*ix                                          ; LD (IX+$00),A     ; store the index
       .push bc                                            ; PUSH BC           ; 
       bl   @twist_seeds                                   ; CALL $2147        ; twist the seeds
       .pop bc                                             ; POP BC            ; 
       cb   b,one                                          ; LD A,B / DEC A    ; was this the last iteration?
       jne  _4d06                                          ; JR NZ,$4D06       ; not the fourth pair
       .pop af                                             ; POP AF            ; yes - recover the original #R$E904 byte
       andi a,>4000                                        ; AND $40           ; bit 6 of s0_lo set?
       jne  _4d06                                          ; JR NZ,$4D06       ; yes - four pairs
       movb a,*ix                                          ; LD (IX+$00),A     ; no - three
_4d06:                                                     ; >4d06
       inc  ix                                             ; INC IX            ; 
       sb   one,b                                          ; DJNZ $4CED        ; 
       jne  _4ced                                          ;                   ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Start from the galaxy's seeds
* 
* Used by the routines at #R$4C9B, #R$4D0B, #R$502C, #R$5325 and #R$55A3.
* .
* Copies the galaxy's seeds (#R$E711) to the seeds of the system being
* generated (#R$E904): the seeds of system 0.
galaxy_seeds_to_system:                                    ; >5607
       .proc
       li   hl,galaxy_seeds                                ; LD HL,$E711       ; source: the galaxy's seeds
       li   de,system_seeds                                ; LD DE,$E904       ; dest: rotating_accumulator
       li   bc,>0006                                       ; LD BC,$0006       ; 6 bytes
       .ldir                                               ; LDIR              ; 
       .endproc                                            ; RET               ; (TI: .proc, since .ldir is a BL)

********************************************************************************
* Move on to the next system: twist the seeds four times
* 
* Used by the routines at #R$4C80 and #R$4C9B.
* .
* Each twist, as in BBC Elite, turns the three 16-bit seeds (s0, s1, s2)
* at #R$E904 into (s1, s2, s0 + s1 + s2).
next_system_seeds:                                         ; >5613
       movb @system_seeds+1,hl                             ; LD HL,($E904)     ; HL = s0
       movb @system_seeds,@l                               ;                   ; 
       movb @seed_s1+1,de                                  ; LD DE,($E906)     ; DE = s1
       movb @seed_s1,@e                                    ;                   ; 
       movb @seed_s2+1,bc                                  ; LD BC,($E908)     ; BC = s2
       movb @seed_s2,@c                                    ;                   ; 
       li   r2,4                                           ;                   ; (TI: a loop for the four twists)
_5613_twist:                                               
       a    de,hl                                          ; ADD HL,DE         ; HL = s0 + s1 + s2
       a    bc,hl                                          ; ADD HL,BC         ; 
       mov  de,r0                                          ; EX DE,HL / LD A,B / LD B,D ...; HL = s1, DE = s2, BC = the sum
       mov  bc,de                                          ;                   ; 
       mov  hl,bc                                          ;                   ; 
       mov  r0,hl                                          ;                   ; 
       dec  r2                                             ;                   ; 
       jne  _5613_twist                                    ;                   ; 
       movb hl,@system_seeds+1                             ; LD ($E904),DE     ; store the new seeds
       movb @l,@system_seeds                               ;                   ; 
       movb de,@seed_s1+1                                  ; LD ($E906),BC     ; 
       movb @e,@seed_s1                                    ;                   ; 
       movb bc,@seed_s2+1                                  ; LD ($E908),HL     ; 
       movb @c,@seed_s2                                    ;                   ; 
       mov  bc,r0                                          ;                   ; (TI: the registers as the MSX leaves them:
       mov  de,bc                                          ;                   ; DE = s0, BC = s1, HL = s2)
       mov  hl,de                                          ;                   ; 
       mov  r0,hl                                          ;                   ; 
       rt                                                  ; RET               ; 

********************************************************************************
msg_query:                                                 ; >57e1
       text ' ?',>a0                                              ; " ? ", also printed on its own (#R$5AC7)

********************************************************************************
* The message " Light Years"
msg_light_years_5845:                                      ; >5845
       text ' Light Year',>f3                                     ; 

********************************************************************************
* Sizes of units of cargo
* 
* In grams, 4 bytes each (#R$639C).
cargo_unit_sizes:                                          ; >5a8b
       byte >40,>42,>0F,>00                                       ; tonne: 1000000
unit_size_kilogram:                                        ; >5a8f
       byte >E8,>03,>00,>00                                       ; kilogram: 1000
unit_size_gram:                                            ; >5a93
       byte >01,>00,>00,>00                                       ; gram: 1

********************************************************************************
* Cargo hold capacities
* 
* In grams, 4 bytes each (#R$63BA).
cargo_hold_capacities:                                     ; >5a97
       byte >00,>2D,>31,>01                                       ; 20 tonnes
hold_capacity_large:                                       ; >5a9b
       byte >C0,>0E,>16,>02                                       ; 35 tonnes, with a large cargo bay

********************************************************************************
* Show a message for a while
* 
* Used by the routines at #R$1683, #R$5C01, #R$5CEE, #R$5D72, #R$5DBB, #R$5E6B,
* #R$5ED1, #R$5EE4, #R$5EFE, #R$6002, #R$6DCF, #R$A377, #R$A3C7 and #R$A542.
* .
* Prints the message at HL (RST $08), waits (#R$3808), and clears the
* message line again (#R$3955).
* 
* I:HL The message
show_message:                                              ; >5ffb
       .proc
       .rst >08                                            ; RST $08           ; 
       bl   @busy_wait_delay                               ; CALL $3808        ; 
       b    @clear_message_line_jmp                        ; JP $3955          ; clear the message line

********************************************************************************
* Hide the sprites and clear the page
* 
* Used by the routines at #R$4D0B, #R$4F64, #R$5B99, #R$5BBD, #R$5C8E, #R$5CEE,
* #R$5DBB, #R$6164, #R$6276, #R$90D3 and #R$A30A.
* .
* Used before showing one of the text pages. If the space view is showing
* (#R$E903), leaves it (#R$60B1), hiding all 32 sprites. Otherwise (at
* $6097), if the chart cursor is on (#R$E70B), turns it off and hides the
* first 5 sprites; then clears the page (#R$60CA) and the message line
* (#R$3955).
hide_sprites_clear_page:                                   ; >608c
       .proc                                               ;                   ; 
       movb @space_view_showing,a                          ; LD A,($E903) / OR A; space view showing?
       jeq  hide_few_sprites                               ; JR Z,$6097        ; no
       bl   @hide_all_sprites                              ; CALL $60B1        ; yes: leave it (#R$60B1)
       jmp  _60b0                                          ; JR $60B0          ; 
hide_few_sprites:                                          ; >6097
       movb @chart_cursor_active_flag,a                    ; LD HL,$E70B / LD A,(HL) / OR A; chart cursor on?
       jeq  _60aa                                          ; JR Z,$60AA        ; no
       sb   @chart_cursor_active_flag,@chart_cursor_active_flag; LD (HL),$00       ; turn it off
       li   hl,sprite_attr_table                           ; LD HL,$1B00       ; 
       movb @bytes+>05,b                                   ; LD B,$05          ; 
       bl   @hide_sprites                                  ; CALL $3942        ; hide sprites 0-4 (#R$3942)
_60aa:                                                     ; >60aa
       bl   @clear_page                                    ; CALL $60CA        ; clear the page (#R$60CA)
       bl   @clear_message_line                            ; CALL $3955        ; clear the message line
_60b0:                                                     ; >60b0
       .endproc                                            ; RET               ; 

********************************************************************************
* Hide all the sprites and leave the space view
* 
* Used by the routine at #R$608C.
* .
* Resets $EB02 (the scanner-queue-ready flag #R$8380 checks),
* hides all 32 sprites via #R$3942, calls #R$70E8, clears the message
* line (#R$3955),
* then clears #R$E903 - the space view is no longer showing.
hide_all_sprites:                                          ; >60b1
       .proc                                               ;                   ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@scanner_queue_ready                         ; LD ($EB02),A      ; no scanner to erase (#R$EB02)
       movb @bytes+>20,b                                   ; LD B,$20          ; 32 sprites
       li   hl,sprite_attr_table                           ; LD HL,$1B00       ; 
       bl   @hide_sprites                                  ; CALL $3942        ; hide them (#R$3942)
       bl   @clear_screen_draw_frame                       ; CALL $70E8        ; clear the screen and draw its frame (#R$70E8)
       bl   @clear_message_line                            ; CALL $3955        ; clear the message line
       sb   a,a                                            ; XOR A             ; 
       movb a,@space_view_showing                          ; LD ($E903),A      ; the space view isn't showing
       .endproc                                            ; RET               ; 

********************************************************************************
* Clear the page
* 
* Used by the routine at #R$608C.
* .
* Clears the page area of a text screen - character rows 1-20, columns 3-28
* (#R$35B8) - with white on black, and sets the current screen (#R$E902) to 0.
clear_page:                                                ; >60ca
       .proc                                               ;                   ; 
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, as interrupts are off, so the sound effects play on)
       sb   a,a                                            ; XOR A             ; 
       movb a,@current_screen                              ; LD ($E902),A      ; the current screen
       li   hl,>0118                                       ; LD HL,$0118       ; HL = $0118: the pattern table at row 1, column 3
       li   bc,>a01a                                       ; LD BC,$A01A       ; 160 pixel rows (20 character rows), 26 characters
       sb   a,a                                            ; XOR A             ; 
       bl   @fill_vram_rect                                ; CALL $35B8        ; clear the patterns (#R$35B8)
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, as interrupts are off, so the sound effects play on)
       li   hl,>2118                                       ; LD HL,$2118       ; HL = $2118: the colours
       li   bc,>a01a                                       ; LD BC,$A01A       ; 
       movb @bytes+>f1,a                                   ; LD A,$F1          ; white on black
       bl   @fill_vram_rect                                ; JP $35B8          ; 
       .endproc                                            ;                   ; 

********************************************************************************
* Distance to the selected system
* 
* Used by the routines at #R$52CE, #R$6164 and #R$88AC.
* .
* Works out the distance (#R$2054) from the current system (#R$EB67) - or,
* in witchspace (#R$EEC1), from the ship's position (at $6153) - to the
* selected system (#R$E72B).
distance_to_selected_system:                               ; >6141
       .proc                                               ;                   ; 
       movb @in_witchspace,a                               ; LD A,($EEC1) / OR A; in witchspace?
       jne  distance_from_witchspace                       ; JR NZ,$6153       ; yes - from the ship's position
       movb @current_system,a                              ; LD A,($EB67)      ; the current system
       bl   @generate_system                               ; CALL $4C9B        ; generate its name-seed coordinates
       movb @system_y,d                                    ; LD DE,($F751)     ; DE = its (X, Y)
       movb @system_x,@e                                   ;                   ; 
       jmp  _6157                                          ; JR $6157          ; 
distance_from_witchspace:                                  ; >6153
       movb @witchspace_position+1,d                       ; LD DE,($EEC3)     ; DE = the ship's position in witchspace
       movb @witchspace_position,@e                        ;                   ; 
_6157:                                                     ; >6157
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       bl   @generate_system                               ; CALL $4C9B        ; generate its name-seed coordinates
       movb @system_y,b                                    ; LD BC,($F751)     ; BC = its (X, Y)
       movb @system_x,@c                                   ;                   ; 
       bl   @distance_between_two_2d_points_d              ; JP $2054          ; compute the distance between them
       .endproc                                            ;                   ; 

********************************************************************************
* Get the size of a unit of cargo
* 
* Used by the routines at #R$5C01, #R$5D72 and #R$8BA6.
* .
* Points HL at the size in grams (#R$5A8B) of a tonne, a kilogram or a
* gram.
* 
* I:A Units (0 tonnes, 1 kilograms, 2 grams)
* O:HL Pointer to the size (4 bytes)
unit_size:                                                 ; >639c
       li   hl,cargo_unit_sizes                            ; LD HL,$5A8B       ; tonnes
       movb a,a                                            ; OR A              ; 
       jeq  _639c_end                                      ; RET Z             ; 
       li   hl,unit_size_kilogram                          ; LD HL,$5A8F       ; kilograms
       cb   a,one                                          ; DEC A             ; (TI: A is left alone)
       jeq  _639c_end                                      ; RET Z             ; 
       li   hl,unit_size_gram                              ; LD HL,$5A93       ; grams
_639c_end:                                                 
       rt                                                  ; RET               ; 

********************************************************************************
* Illegal goods: worsen the legal status
* 
* Used by the routines at #R$5C01 and #R$8BA6.
* .
* Adds the quantity * how illegal the goods are (byte 3 of their entry in
* the market, see #R$0A02) to the legal status (#R$EB65), up to $FF.
* Called when buying or scooping cargo.
* 
* I:A Quantity
* I:IX Pointer to the goods' entry in the market (#R$F789)
illegal_goods:                                             ; >63aa
       movb a,r1                                           ; LD D,A            ; the quantity
       srl  r1,8                                           ;                   ; 
       movb @3(ix),r0                                      ; LD E,(IX+$03)     ; how illegal
       srl  r0,8                                           ;                   ; 
       mpy  r0,r1                                          ; CALL $1F51        ; (TI: MPY instead of #R$1F51)
       swpb r2                                             ;                   ; the product's low byte (8 bits, as on the MSX)
       ab   r2,@legal_status                               ; LD HL,$EB65 / ADD A,(HL); add it to the legal status
       jnc  _63b8                                          ; JR NC,$63B8       ; no overflow - keep it
       movb @b255,@legal_status                            ; SBC A,A / LD (HL),A; up to $FF
_63b8:                                                     ; >63b8
       rt                                                  ; RET               ; 

********************************************************************************
* Work out the free space in the hold
* 
* Used by the routines at #R$5C01, #R$6051, #R$8BA6 and #R$909F.
* .
* Starts with the hold's capacity (#R$5A97: 20 tonnes, or 35 with a large
* cargo bay, #R$F777), and takes the size of each of the 18 goods in the
* hold (#R$EB19) off it (#R$63E0).
work_out_free_space:                                       ; >63ba
       .proc                                               ;                   ; 
       li   hl,cargo_hold_capacities                       ; LD HL,$5A97       ; 20 tonnes
       movb @item_large_cargo_bay,a                        ; LD A,($F777) / OR A; large cargo bay?
       jeq  _63c6                                          ; JR Z,$63C6        ; no
       li   hl,hold_capacity_large                         ; LD HL,$5A9B       ; yes: 35 tonnes
_63c6:                                                     ; >63c6
       li   de,free_space                                  ; LD DE,$EB61       ; the free space
       li   bc,>0004                                       ; LD BC,$0004       ; 4 bytes
       .ldir                                               ; LDIR              ; 
       li   hl,cargo_hold                                  ; LD HL,$EB19       ; the goods in the hold
       movb @bytes+>12,a                                   ; LD A,$12          ; 18 of them
_63d3:                                                     ; >63d3
       .push af                                            ; EX AF,AF'         ; 
       li   bc,>0001                                       ; LD BC,$0001       ; one of them
       bl   @take_off_free_space                           ; CALL $63E0        ; take it off the free space
       .ex_de_hl                                           ; EX DE,HL          ; next
       .pop af                                             ; EX AF,AF'         ; 
       sb   one,a                                          ; DEC A             ; 
       jne  _63d3                                          ; JR NZ,$63D3       ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Take cargo off the free space in the hold
* 
* Used by the routines at #R$5C01, #R$63BA and #R$8BA6.
* .
* Subtracts BC units of the size at HL from the free space (#R$EB61).
* 
* I:BC Number of units
* I:HL Pointer to the size of a unit
take_off_free_space:                                       ; >63e0
* TI: a native 32-bit subtraction instead of #R$21CF, leaving the registers
* as on the MSX: HL unchanged, DE = HL + 4, BC = 0
       movb @1(hl),r0                                      ; LD DE,$EB61 / CALL $21CF; R0 = the size's low word
       movb *hl,@r0lb                                      ;                   ; 
       movb @free_space+1,r1                               ;                   ; R1 = the free space's low word
       movb @free_space,@r1lb                              ;                   ; 
       s    r0,r1                                          ;                   ; (carry clear = a borrow)
       movb @r1lb,@free_space                              ;                   ; (MOVB leaves the carry alone)
       movb r1,@free_space+1                               ;                   ; 
       movb @free_hold_space_2+1,r1                        ;                   ; R1 = the free space's high word
       movb @free_hold_space_2,@r1lb                       ;                   ; 
       joc  _63e0_no_borrow                                ;                   ; 
       dec  r1                                             ;                   ; 
_63e0_no_borrow:                                           
       movb @3(hl),r0                                      ;                   ; R0 = the size's high word
       movb @2(hl),@r0lb                                   ;                   ; 
       s    r0,r1                                          ;                   ; 
       movb @r1lb,@free_hold_space_2                       ;                   ; 
       movb r1,@free_hold_space_2+1                        ;                   ; 
       dec  bc                                             ; DEC BC / LD A,B / OR C; 
       jne  take_off_free_space                            ; JR NZ,$63E0       ; more units - repeat
       mov  hl,de                                          ; EX DE,HL / POP HL ; 
       ai   de,4                                           ;                   ; DE -> past the size, as on the MSX
       rt                                                  ; RET               ; 

********************************************************************************
* Enter flight mode: set up the cockpit screen
* 
* Used by the routine at #R$645B.
* .
* Clears $E70B, $E902 and $E949 (so there are no scanner blips to
* erase), sets $EF9E and #R$E903 (space view showing), hides all 32 sprites
* (#R$3942), uploads the missile and compass dot sprite patterns (#R$39B9,
* #R$6EC7), unpacks the cockpit screen picture (#R$7139, see
* #R$CAD7) and draws all the gauges (#R$6433). #R$60B1 is the "leave
* flight" counterpart.
enter_flight_mode:                                         ; >63f1
       .proc
       bl   @view_mark_all                                 ;                   ; (TI: the whole space view has to be cleared and copied)
       sb   a,a                                            ; XOR A             ; 
       movb a,@chart_cursor_active_flag                    ; LD ($E70B),A      ; 
       movb a,@current_screen                              ; LD ($E902),A      ; 
       movb a,@scanner_drawn_count                         ; LD ($E949),A      ; no scanner blips to erase
       sb   one,a                                          ; DEC A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; 
       movb a,@space_view_showing                          ; LD ($E903),A      ; space view showing
       li   hl,sprite_attr_table                           ; LD HL,$1B00       ; hide all 32 sprites
       movb @bytes+>20,b                                   ; LD B,$20          ; 
;      limi 0                                              ; DI                ; 
       bl   @hide_sprites                                  ; CALL $3942        ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+sprite_pattern_write_hi,a               ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $3880 (sprite patterns)
       li   hl,flight_sprite_patterns                      ; LD HL,$6EC7       ; 
       bl   @write_run_length_encoded_byte_stream          ; CALL $39B9        ; upload the missile patterns
       movb @bytes+>c0,a                                   ; LD A,$C0          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+sprite_pattern_write_hi,a               ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $38C0
       li   hl,compass_dot_pattern                         ; LD HL,$6ED4       ; 
       bl   @write_run_length_encoded_byte_stream          ; CALL $39B9        ; upload the compass dot pattern
       ; EI                                                ; EI                ;
       bl   @blank_screen_decompress_picture_recolour      ; CALL $7139        ; unpack the cockpit screen picture
       bl   @redraw_all_dashboard_gauges                   ; CALL $6433        ; draw all the gauges
       sb   a,a                                            ; XOR A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Redraw all dashboard gauges
* 
* Used by the routines at #R$63F1 and #R$894D.
* .
* Calls all 13 dashboard-gauge-drawing routines in turn - the same set
* gated by #R$6C9E (gate_dashboard_hidden), which each of them calls
* first to skip the work when the dashboard is hidden.
redraw_all_dashboard_gauges:                               ; >6433
       .proc
       bl   @draw_speed_gauge                              ; CALL $6A59        ; the speed gauge
       bl   @draw_roll_dial                                ; CALL $6BB3        ; the roll dial
       bl   @draw_pitch_dial                               ; CALL $6BCA        ; the pitch dial
       bl   @draw_energy_banks                             ; CALL $6A88        ; the energy banks
       bl   @draw_gauge_dashboard_6b48                     ; CALL $6B48        ; the fore shield
       bl   @draw_gauge_dashboard_6b54                     ; CALL $6B54        ; the aft shield
       bl   @draw_laser_temperature                        ; CALL $6B60        ; the laser temperature
       bl   @draw_fuel_gauge                               ; CALL $6AAD        ; the fuel
       bl   @draw_missile_indicator                        ; CALL $6B6E        ; the missiles
       bl   @draw_altitude                                 ; CALL $6AC4        ; the altitude
       bl   @draw_cabin_temperature                        ; CALL $6AD0        ; the cabin temperature
       bl   @draw_station_indicator                        ; CALL $6ADC        ; the "S" indicator
       bl   @draw_ecm_indicator                            ; CALL $6B12        ; the "E" indicator
       .endproc                                            ; RET               ; 

********************************************************************************
* Switch to a new space view
* 
* Used by the routines at #R$64A1, #R$64B5, #R$64C9 and #R$64DD.
* .
* Shared tail of the four view selectors. Patches the CALL at $6944 in
* the stardust loop (#R$6911) to the view's stardust move handler. When
* not in flight, first calls #R$63F1 and sets the current view ($EB9A)
* to $FF so the view always counts as changed. If the view has changed,
* stores the new view number and copies the view's name (#R$118F: 7
* characters of 5 pixel rows) from DE into rows 1-5 of the character
* patterns at VRAM $0060-$0097 on the dashboard, then scatters a
* fresh stardust field for the new view (#R$6882). Finally shows the
* tunnel rings if launching ($E8F6, #R$6CB2), and sets up the view's
* laser (#R$6D24).
* 
* I:B New view number (0=front, 1=rear, 2=left, 3=right)
* I:DE Source data for the VRAM copy
* I:HL The view's stardust move handler
switch_view:                                               ; >645b
       mov  hl,@stardust_move_handler+>0002                ; LD ($6945),HL     ; patch the stardust move handler (#R$6944+1)
       .push de                                            ; PUSH DE           ; save DE
       movb @space_view_showing,a                          ; LD A,($E903) / OR A; in flight?
       jne  _646f                                          ; JR NZ,$646F       ; yes
       .push bc                                            ; PUSH BC           ; 
       bl   @enter_flight_mode                             ; CALL $63F1        ; no: set up the cockpit screen (#R$63F1)
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@current_view                                ; LD ($EB9A),A      ; and make sure the view counts as changed
       .pop bc                                             ; POP BC            ; 
_646f:                                                     ; >646f
       .pop de                                             ; POP DE            ; DE -> the view's name
       movb b,a                                            ; LD A,B            ; A = the new view
       li   hl,current_view                                ; LD HL,$EB9A       ; 
       cb   a,*hl                                          ; CP (HL)           ; the same as the current view?
       jeq  _6496                                          ; JR Z,$6496        ; yes - skip
       movb a,*hl                                          ; LD (HL),A         ; set the current view
       movb @bytes+>61,a                                   ; LD A,$61          ; A = $61, the VRAM address's low byte for the name's first character
       movb @bytes+>07,@c                                  ; LD C,$07          ; 7 characters
_647c:                                                     ; >647c
       .push af                                            ; PUSH AF           ; 
;      limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $0061 + 8n: rows 1-5 of the character's pattern
       movb @bytes+>05,b                                   ; LD B,$05          ; 5 pixel rows
_6486:                                                     ; >6486
       movb *de,a                                          ; LD A,(DE)         ; copy a row of the name's pattern
       inc  de                                             ; INC DE            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       sb   one,b                                          ; DJNZ $6486        ; 
       jne  _6486                                          ;                   
       ; EI                                                ; EI                ;
       .pop af                                             ; POP AF            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; next character
       sb   one,@c                                         ; DEC C             ; 
       jne  _647c                                          ; JR NZ,$647C       ; 
       bl   @scatter_stardust                              ; CALL $6882        ; scatter the stardust for the new view (#R$6882)
_6496:                                                     ; >6496
       movb @show_tunnel,a                                 ; LD A,($E8F6) / OR A; launching?
       jeq  !                                              ; CALL NZ,$6CB2     ; yes - show the tunnel rings (#R$6CB2)
       bl   @tunnel_rings                                  ;                   
!
       bl   @view_laser                                    ; CALL $6D24        ; set up the view's laser (#R$6D24)
       .ret                                                ; RET               ; 

********************************************************************************
* Switch to the front view
* 
* Used by the routines at #R$1703, #R$1837, #R$1873, #R$19FC, #R$1C5C, #R$4173
* and #R$894D.
* .
* The first of four near-identical view selectors (see also #R$64B5,
* #R$64C9 and #R$64DD). Each points ($44CF) - the self-modified
* negate-target operand inside #R$4464 - at the view's own target, then
* passes the view number, its stardust move handler and its VRAM data to
* #R$645B.
switch_to_front_view:                                      ; >64a1
       .proc
       bl   @refuse_if_docked                              ; CALL $6DCF        ; 
       li   hl,view_front                                  ; LD HL,$44E5       ; front view's negate-target inside #R$4464
       mov  hl,@convert_to_view+>0002                      ; LD ($44CF),HL     ; patch the view conversion (#R$44CE+1)
       sb   b,b                                            ; LD B,$00          ; B = 0 (front view)
       li   hl,stardust_front_view                         ; LD HL,$64F1       ; HL = front view stardust handler (#R$64F1)
       li   de,view_name_front                             ; LD DE,$118F       ; DE = front view's VRAM data
       b    @switch_view                                   ; JP $645B          ; switch view

********************************************************************************
* Stardust: move or respawn a particle in the front view
* 
* Used by the routine at #R$68CD.
* .
* The front view's stardust move handler (the default operand of the
* patched CALL at $6944). A particle flagged for respawning is given a
* random position within 63 pixels of the centre on each axis, and #R$6805
* sets its velocity to point straight out from the centre. Otherwise it is
* moved (at $6520).
* .
* At $6520, adds the particle's velocity to its position several times
* over, the number of times depending on how far the particle already is
* from the centre on that axis (the bit length of |offset|/4, minimum 1,
* from the table at $0200), so particles speed up as they fly outwards. X
* and Y are done independently.
* 
* I:F Z set to move the particle, clear to respawn it
* I:IX Pointer to the particle
stardust_front_view:                                       ; >64f1
       jeq  stardust_move_outwards                         ; JR Z,$6520        ; not flagged for respawning - go move it
       .proc
       bl   @random_byte                                   ; CALL $2176        ; A = random byte
       movb a,@l                                           ; LD L,A            ; 
       andi a,>3f00                                        ; AND $3F           ; C = |X| = 0-63
       movb a,@c                                           ; LD C,A            ; 
       movb @l,r0                                          ; RL L              ; 
       sla  r0,1                                           ;                   ; carry = bit 7 of the random byte (the sign)
       jnc  _6500                                          ; JR NC,$6500       ; 
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
_6500:                                                     ; >6500
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb a,@>01(ix)                                     ; LD (IX+$01),A     ; set X
       bl   @random_byte                                   ; CALL $2176        ; A = random byte
       movb a,@l                                           ; LD L,A            ; 
       andi a,>3f00                                        ; AND $3F           ; B = |Y| = 0-63
       movb a,b                                            ; LD B,A            ; 
       movb @l,r0                                          ; RL L              ; 
       sla  r0,1                                           ;                   ; carry = bit 7 of the random byte (the sign)
       jnc  _6514                                          ; JR NC,$6514       ; 
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
_6514:                                                     ; >6514
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb a,@>03(ix)                                     ; LD (IX+$03),A     ; set Y
       bl   @stardust_set_velocity                         ; CALL $6805        ; set the velocity, pointing away from the centre
       .endproc                                            ; JR $656A          ; 
stardust_move_outwards:                                    ; >6520
       movb *ix,@l                                         ; LD L,(IX+$00)     ; 
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; HL = X
       movb @>04(ix),@e                                    ; LD E,(IX+$04)     ; 
       movb @>05(ix),d                                     ; LD D,(IX+$05)     ; DE = X velocity
       movb h,a                                            ; LD A,H / OR A     ; 
       jgt  stardust_front_x                               ; JP P,$6533        ; 
       jeq  stardust_front_x                               ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = |X|
stardust_front_x:                                          ; >6533
       srl  a,2                                            ; SRL A             ; 
       ;                                                   ; SRL A             ; A = |X| / 4
       movb a,@c                                           ; LD C,A            ; 
       movb a,r1                                           ; LD B,$02          ; 
       srl  r1,8                                           ;                   ; 
       movb @bit_length_table(r1),a                        ; LD A,(BC)         ; B = number of steps from the bit length table
       movb a,b                                            ; LD B,A            ; 
_653c:                                                     ; >653c
       a    de,hl                                          ; ADD HL,DE         ; move along X...
       sb   one,b                                          ; DJNZ $653C        ; ...that many times
       jne  _653c                                          ;                   
       movb @l,*ix                                         ; LD (IX+$00),L     ; 
       movb h,@>01(ix)                                     ; LD (IX+$01),H     ; store the new X
       movb @>02(ix),@l                                    ; LD L,(IX+$02)     ; 
       movb @>03(ix),h                                     ; LD H,(IX+$03)     ; HL = Y
       movb @>06(ix),@e                                    ; LD E,(IX+$06)     ; 
       movb @>07(ix),d                                     ; LD D,(IX+$07)     ; DE = Y velocity
       movb h,a                                            ; LD A,H / OR A     ; 
       jgt  stardust_front_y                               ; JP P,$6558        ; 
       jeq  stardust_front_y                               ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = |Y|
stardust_front_y:                                          ; >6558
       srl  a,2                                            ; SRL A             ; 
       ;                                                   ; SRL A             ; A = |Y| / 4
       movb a,@c                                           ; LD C,A            ; 
       movb a,r1                                           ; LD B,$02          ; 
       srl  r1,8                                           ;                   ; 
       movb @bit_length_table(r1),a                        ; LD A,(BC)         ; B = number of steps from the bit length table
       movb a,b                                            ; LD B,A            ; 
_6561:                                                     ; >6561
       a    de,hl                                          ; ADD HL,DE         ; move along Y...
       sb   one,b                                          ; DJNZ $6561        ; ...that many times
       jne  _6561                                          ;                   
       movb @l,@>02(ix)                                    ; LD (IX+$02),L     ; 
       movb h,@>03(ix)                                     ; LD (IX+$03),H     ; store the new Y
_656a:                                                     ; >656a
       rt                                                  ; RET               ; 

********************************************************************************
* Stardust: move or respawn a particle in the rear view
* 
* Called by the CALL at $6944 in #R$68CD, which #R$645B patches for the
* rear view (#R$64B5).
* .
* In the rear view the stardust flies in from the edges towards the centre.
* A particle flagged for respawning is placed at a random point on the
* bottom edge (Y=64) or top edge (Y=-63), or at X=88 (the right edge) or
* X=-63 (rather than the left edge at -87) with a random Y (at $6594). At
* $65AE, #R$6805 then sets its velocity pointing away from the centre,
* which is subtracted to move the particle back towards the centre.
* .
* At $65C1, subtracts the particle's (outward-pointing) velocity from its X
* coordinate several times over, the number of times depending on its
* distance from the centre as in #R$6520, so particles slow down as they
* approach the centre. If X changes sign, the particle has passed the
* centre and is flagged for respawning (and X isn't updated). Then (at
* $65EE) does the same for Y, storing it at $6621.
* 
* I:F Z set to move the particle, clear to respawn it
* I:IX Pointer to the particle
stardust_rear_view:                                        ; >656b
       jeq  stardust_move_inwards                          ; JR Z,$65C1        ; not flagged for respawning - go move it
       .proc                                               ;                   ; 
       bl   @random_byte                                   ; CALL $2176        ; 
       andi a,>0300                                        ; AND $03           ; A = random edge selector, 0-3
       movb a,r2                                           ; LD C,A / EX AF,AF'; (TI: kept in R2)
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jhe  stardust_rear_view_respawn_side                ; JR NC,$6594       ; 2 or 3 - put it at the side instead
_6578:                                                     ; >6578
       bl   @random_byte                                   ; CALL $2176        ; pick a random X...
       movb a,@l                                           ; LD L,A            ; 
       jgt  stardust_rear_random_x                         ; OR A / JP P,$6582 ; 
       jeq  stardust_rear_random_x                         ;                   ; 
       andi a,>ff00                                        ; NEG               ; 
       neg  a                                              ;                   ; 
stardust_rear_random_x:                                    ; >6582
       cb   a,@bytes+>58                                   ; CP $58            ; 
       jhe  _6578                                          ; JR NC,$6578       ; ...within 87 of the centre
       movb a,@c                                           ; LD C,A            ; C = abs X
       movb @bytes+>40,h                                   ; LD H,$40          ; Y = 64 (bottom edge)
       movb h,b                                            ; LD B,H            ; B = abs Y
       movb r2,r2                                          ; EX AF,AF' / OR A  ; 
       jeq  _65ae                                          ; JR Z,$6592        ; 0 - bottom edge
       movb @bytes+>c1,h                                   ; LD H,$C1          ; 1 - top edge: Y = -63
       movb @bytes+>3f,b                                   ; LD B,$3F          ; B = abs Y
       jmp  _65ae                                          ; JR $65AE          ; 
stardust_rear_view_respawn_side:                           ; >6594
       bl   @random_byte                                   ; CALL $2176        ; pick a random Y...
       movb a,h                                            ; LD H,A            ; 
       jgt  stardust_rear_random_y                         ; OR A / JP P,$659F ; 
       jeq  stardust_rear_random_y                         ;                   ; 
       andi a,>ff00                                        ; NEG               ; 
       neg  a                                              ;                   ; 
stardust_rear_random_y:                                    ; >659f
       cb   a,@bytes+>40                                   ; CP $40            ; 
       jhe  stardust_rear_view_respawn_side                ; JR NC,$6595       ; ...within 63 of the centre
       movb a,b                                            ; LD B,A            ; B = abs Y
       movb @bytes+>58,@l                                  ; LD L,$58          ; X = 88 (right edge)
       movb @l,@c                                          ; LD C,L            ; C = abs X
       cb   r2,@bytes+>03                                  ; EX AF,AF'         ; 
       jeq  _65ae                                          ; JR NZ,$65AE       ; 3 - right edge
       movb @bytes+>c1,@l                                  ; LD L,$C1          ; 2 - X = -63
       movb @bytes+>3f,@c                                  ; LD C,$3F          ; C = abs X
_65ae:                                                     ; >65ae
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb @l,@>01(ix)                                    ; LD (IX+$01),L     ; set X
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb h,@>03(ix)                                     ; LD (IX+$03),H     ; set Y
       bl   @stardust_set_velocity                         ; CALL $6805        ; set the velocity, pointing away from the centre
       .endproc                                            ; JR $6627          ; 
stardust_move_inwards:                                     ; >65c1
       .proc                                               ;                   ; 
       movb *ix,@l                                         ; LD L,(IX+$00)     ; 
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; HL = X
       movb @>04(ix),@e                                    ; LD E,(IX+$04)     ; 
       movb @>05(ix),d                                     ; LD D,(IX+$05)     ; DE = X velocity
       bl   @stardust_move_back                            ;                   ; (TI: shared with Y)
       jlt  stardust_rear_flag_x                           ; JP P,$65EE        ; X changed sign?
       movb @l,*ix                                         ; LD (IX+$00),L     ; no -
       movb h,@>01(ix)                                     ; LD (IX+$01),H     ; store the new X
       jmp  _65f4                                          ;                   ; 
stardust_rear_flag_x:                                      
       movb @b255,@>08(ix)                                 ; LD (IX+$08),$FF   ; yes - passed the centre, flag it for respawning
_65f4:                                                     ; >65f4
       movb @>02(ix),@l                                    ; LD L,(IX+$02)     ; 
       movb @>03(ix),h                                     ; LD H,(IX+$03)     ; HL = Y
       movb @>06(ix),@e                                    ; LD E,(IX+$06)     ; 
       movb @>07(ix),d                                     ; LD D,(IX+$07)     ; DE = Y velocity
       bl   @stardust_move_back                            ;                   ; 
       jlt  stardust_rear_flag_y                           ; JP P,$6621        ; Y changed sign?
       movb @l,@>02(ix)                                    ; LD (IX+$02),L     ; no -
       movb h,@>03(ix)                                     ; LD (IX+$03),H     ; store the new Y
       jmp  _6627                                          ;                   ; 
stardust_rear_flag_y:                                      
       movb @b255,@>08(ix)                                 ; LD (IX+$08),$FF   ; yes - passed the centre, flag it for respawning
_6627:                                                     ; >6627
       .endproc                                            ; RET               ; 
* TI: moves HL back by the velocity DE a number of times depending on abs H
* (#R$6520), returning the status of HL xor its old value, so negative if it
* changed sign (from $65C5-$65E9 and $65F8-$661C).
stardust_move_back:                                        
       movb h,a                                            ; LD C,H / LD A,H   ; 
       mov  hl,r2                                          ;                   ; R2 = the old value
       jgt  stardust_move_back_1                           ; OR A / JP P,$65CF ; 
       jeq  stardust_move_back_1                           ;                   ; 
       andi a,>ff00                                        ; NEG               ; A = abs H
       neg  a                                              ;                   ; 
stardust_move_back_1:                                      
       srl  a,2                                            ; SRL A / SRL A     ; abs H / 4
       movb a,r1                                           ; LD E,A / LD D,$02 ; 
       srl  r1,8                                           ;                   ; 
       movb @bit_length_table(r1),b                        ; LD A,(DE) / LD B,A; B = number of steps from the bit length table
stardust_move_back_2:                                      
       s    de,hl                                          ; OR A / SBC HL,DE  ; move back...
       sb   one,b                                          ; DJNZ $65DE        ; ...that many times
       jne  stardust_move_back_2                           ;                   ; 
       mov  hl,r0                                          ; LD A,H / XOR C    ; 
       xor  r2,r0                                          ;                   ; negative if it changed sign
       rt                                                  ;                   ; 

********************************************************************************
* Stardust: move or respawn a particle in the left view
* 
* Called by the CALL at $6944 in #R$68CD, which #R$645B patches for the
* left view (#R$64C9).
* .
* In the left view the stardust streams from right to left. A particle
* flagged for respawning is placed on the right edge (X=88) at a random
* height within 63 of the centre, and given a random speed by passing
* #R$6805 a random direction (both components 4-7). Otherwise (at $665C)
* it's moved left by four times the size of its Y velocity, which serves as
* its speed here (at $6677 for a negative velocity); its Y doesn't change.
* 
* I:F Z set to move the particle, clear to respawn it
* I:IX Pointer to the particle
stardust_left_view:                                        ; >6628
       jeq  stardust_move_left                             ; JR Z,$665C        ; not flagged for respawning - go move it
       li   r2,>5800                                       ; LD (IX+$01),$58   ; X = 88 (right edge)
       jmp  stardust_side_respawn                          ;                   ; 
stardust_move_left:                                        ; >665c
       movb *ix,@l                                         ; LD L,(IX+$00)     ; 
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; HL = X
       movb @>06(ix),@e                                    ; LD E,(IX+$06)     ; 
       movb @>07(ix),d                                     ; LD D,(IX+$07)     ; DE = Y velocity (the speed)
       abs  de                                             ; BIT 7,D / JP M,$6677; 
       sla  de,2                                           ;                   ; 
       s    de,hl                                          ; SBC HL,DE x 4 / ADD HL,DE x 4; X = X - 4 * abs speed
       jmp  stardust_side_store                            ; JR $667B          ; 

********************************************************************************
* Stardust: move or respawn a particle in the right view
* 
* Called by the CALL at $6944 in #R$68CD, which #R$645B patches for the
* right view (#R$64DD).
* .
* The mirror image of #R$6628: in the right view the stardust streams from
* left to right, so particles respawn on the left edge (X=-87) and are
* moved right (at $66B6, and $66CD for a negative velocity).
* 
* I:F Z set to move the particle, clear to respawn it
* I:IX Pointer to the particle
stardust_right_view:                                       ; >6682
       jeq  stardust_move_right                            ; JR Z,$66B6        ; not flagged for respawning - go move it
       li   r2,>a900                                       ; LD (IX+$01),$A9   ; X = -87 (left edge)
* TI: the respawning is shared with the left view (#R$6628, at $662A)
stardust_side_respawn:                                     
       .proc                                               ;                   ; 
stardust_side_respawn_1:                                   
       bl   @random_byte                                   ; CALL $2176        ; pick a random Y...
       movb a,@l                                           ; LD L,A            ; 
       jgt  stardust_side_random_y                         ; OR A / JP P,$6634 ; 
       jeq  stardust_side_random_y                         ;                   ; 
       andi a,>ff00                                        ; NEG               ; 
       neg  a                                              ;                   ; 
stardust_side_random_y:                                    
       cb   a,@bytes+>40                                   ; CP $40            ; 
       jhe  stardust_side_respawn_1                        ; JR NC,$662A       ; ...within 63 of the centre
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb @l,@>03(ix)                                    ; LD (IX+$03),L     ; set Y
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb r2,@>01(ix)                                    ; LD (IX+$01),$58   ; set X
       bl   @random_byte                                   ; CALL $2176        ; 
       andi a,>0300                                        ; AND $03           ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 
       movb a,b                                            ; LD B,A            ; B = random 4-7
       bl   @random_byte                                   ; CALL $2176        ; 
       andi a,>0300                                        ; AND $03           ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 
       movb a,@c                                           ; LD C,A            ; C = random 4-7
       bl   @stardust_set_velocity                         ; CALL $6805        ; set a random velocity
       .endproc                                            ; JR $6681          ; 
stardust_move_right:                                       ; >66b6
       movb *ix,@l                                         ; LD L,(IX+$00)     ; 
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; HL = X
       movb @>06(ix),@e                                    ; LD E,(IX+$06)     ; 
       movb @>07(ix),d                                     ; LD D,(IX+$07)     ; DE = Y velocity (the speed)
       abs  de                                             ; BIT 7,D / JP M,$66CD; 
       sla  de,2                                           ;                   ; 
       a    de,hl                                          ; ADD HL,DE x 4 / SBC HL,DE x 4; X = X + 4 * abs speed
stardust_side_store:                                       
       movb @l,*ix                                         ; LD (IX+$00),L     ; 
       movb h,@>01(ix)                                     ; LD (IX+$01),H     ; store the new X
       rt                                                  ; RET               ; 

********************************************************************************
* Stardust: rotate about the centre of the view
* 
* Used by the routines at #R$67B5, #R$67C3, #R$67ED and #R$67F7.
* .
* Used for roll in the front and rear views, and for pitch in the side
* views. Rotates every particle's pixel position (X,Y) about the centre
* of the view by the angle whose cosine and sine are given in HL and DE:
* X' = X*cos - Y*sin, Y' = X*sin + Y*cos. The multiplications are done
* with logarithms: #R$1FCF converts cos and sin to logs, X and Y are
* converted using the log table at $0800 (tagging the sign into bit 6 of
* the high byte), and #R$2160 adds a pair of logs to give the product.
* Then #R$6805 sets the particle's velocity from its new position.
* 
* I:HL Cosine (sign-magnitude, from the roll or pitch coefficients)
* I:DE Sine (sign-magnitude)
stardust_rotate:                                           ; >66dc
       .proc
       bl   @log_sign_tagged                               ; CALL $1FCF        ; convert cos to a log
       movb hl,@stardust_log_cos+1                         ; LD ($E779),HL     ; and save it
       movb @l,@stardust_log_cos                           ;                   ;
       .ex_de_hl                                           ; EX DE,HL          ; 
       bl   @log_sign_tagged                               ; CALL $1FCF        ; convert sin to a log
       movb hl,@stardust_log_sin+1                         ; LD ($E77B),HL     ; and save it
       movb @l,@stardust_log_sin                           ;                   ;
       movb @reclaimed_range_start+1,ix                    ; LD IX,($EFA6)     ; IX -> the stardust table
       movb @reclaimed_range_start,@ixl                    ;                   ;
       movb @bytes+>0f,b                                   ; LD B,$0F          ; B = 15 particles
stardust_rotate_particle:                                  ; >66ef
       .push bc                                            ; PUSH BC           ; 
       movb @>01(ix),a                                     ; LD A,(IX+$01) / OR A; A = X
       .push af                                            ; PUSH AF           ; save its sign
       jgt  stardust_rotate_log_x                          ; JP P,$66FA        ; 
       jeq  stardust_rotate_log_x                          ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = |X|
stardust_rotate_log_x:                                     ; >66fa
       ab   a,a                                            ; ADD A,A           ; 
       mov  a,r1                                           ; LD ($66FF),A      ; index the table with A (instead of patching the operand)
       srl  r1,8                                           ;                   ;
stardust_log_x_lookup:                                     ; >66fe
       mov  @log_table(r1),hl                              ; LD HL,($0800)     ; HL = log |X|
       .pop af                                             ; POP AF            ; 
       jgt  stardust_rotate_save_log_x                     ; JP P,$6707        ; 
       jeq  stardust_rotate_save_log_x                     ;                   ; 
!
       socb @bit6,h                                        ; SET 6,H           ; tag the sign of X
stardust_rotate_save_log_x:                                ; >6707
       movb hl,@stardust_log_x+1                           ; LD ($E77D),HL     ; save log X
       movb @l,@stardust_log_x                             ;                   ;
       movb @>03(ix),a                                     ; LD A,(IX+$03) / OR A; A = Y
       .push af                                            ; PUSH AF           ; save its sign
       jgt  stardust_rotate_log_y                          ; JP P,$6714        ; 
       jeq  stardust_rotate_log_y                          ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = |Y|
stardust_rotate_log_y:                                     ; >6714
       ab   a,a                                            ; ADD A,A           ; 
       mov  a,r1                                           ; LD ($6719),A      ; index the table with A (instead of patching the operand)
       srl  r1,8                                           ;                   ;
stardust_log_y_lookup:                                     ; >6718
       mov  @log_table(r1),hl                              ; LD HL,($0800)     ; HL = log |Y|
       .pop af                                             ; POP AF            ; 
       jgt  stardust_rotate_save_log_y                     ; JP P,$6721        ; 
       jeq  stardust_rotate_save_log_y                     ;                   ; 
!
       socb @bit6,h                                        ; SET 6,H           ; tag the sign of Y
stardust_rotate_save_log_y:                                ; >6721
       movb hl,@stardust_log_y+1                           ; LD ($E77F),HL     ; save log Y
       movb @l,@stardust_log_y                             ;                   ;
       movb @stardust_log_sin+1,bc                         ; LD BC,($E77B)     ; 
       movb @stardust_log_sin,@c                           ;                   ;
       bl   @multiply_logs                                 ; CALL $2160        ; HL = Y * sin
       .ex_de_hl                                           ; EX DE,HL          ; 
       movb @stardust_log_x+1,hl                           ; LD HL,($E77D)     ; 
       movb @stardust_log_x,@l                             ;                   ;
       movb @stardust_log_cos+1,bc                         ; LD BC,($E779)     ; 
       movb @stardust_log_cos,@c                           ;                   ;
       bl   @multiply_logs                                 ; CALL $2160        ; HL = X * cos
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; X' = X * cos - Y * sin
       movb @l,@>01(ix)                                    ; LD (IX+$01),L     ; store the new X
       movb @stardust_log_x+1,hl                           ; LD HL,($E77D)     ; 
       movb @stardust_log_x,@l                             ;                   ;
       movb @stardust_log_sin+1,bc                         ; LD BC,($E77B)     ; 
       movb @stardust_log_sin,@c                           ;                   ;
       bl   @multiply_logs                                 ; CALL $2160        ; HL = X * sin
       .ex_de_hl                                           ; EX DE,HL          ; 
       movb @stardust_log_y+1,hl                           ; LD HL,($E77F)     ; 
       movb @stardust_log_y,@l                             ;                   ;
       movb @stardust_log_cos+1,bc                         ; LD BC,($E779)     ; 
       movb @stardust_log_cos,@c                           ;                   ;
       bl   @multiply_logs                                 ; CALL $2160        ; HL = Y * cos
       a    de,hl                                          ; ADD HL,DE         ; Y' = X * sin + Y * cos
       movb @l,@>03(ix)                                    ; LD (IX+$03),L     ; store the new Y
       movb @l,a                                           ; LD A,L / OR A     ; 
       jgt  stardust_rotate_abs_y                          ; JP P,$675C        ; 
       jeq  stardust_rotate_abs_y                          ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
stardust_rotate_abs_y:                                     ; >675c
       movb a,b                                            ; LD B,A            ; B = |Y|
       movb @>01(ix),a                                     ; LD A,(IX+$01) / OR A; 
       jgt  stardust_rotate_abs_x                          ; JP P,$6766        ; 
       jeq  stardust_rotate_abs_x                          ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
stardust_rotate_abs_x:                                     ; >6766
       movb a,@c                                           ; LD C,A            ; C = |X|
       bl   @stardust_set_velocity                         ; CALL $6805        ; set the velocity, pointing away from the centre
       li   de,>000b                                       ; LD DE,$000B       ; 
       a    de,ix                                          ; ADD IX,DE         ; IX -> next particle
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DEC B             ; 
       jeq  !                                              ; JP NZ,$66EF       ; loop for all 15 particles
       b    @stardust_rotate_particle                      ;                   
!
       .endproc                                            ; RET               ; 

********************************************************************************
* Stardust: move up or down
* 
* Used by the routines at #R$67CD, #R$67D3, #R$67DD and #R$67E3.
* .
* Used for pitch in the front and rear views, and for roll in the side
* views. Converts the sine in HL to a signed pixel count and adds it to
* every particle's Y, then sets its velocity from its new position
* (#R$6805).
* 
* I:HL Sine (sign-magnitude, from the roll or pitch coefficients)
stardust_move_vertically:                                  ; >6775
       .proc
       mov  hl,r0                                          ; LD A,H            ; 
       sla  r0,1                                           ; RL L              ; 
       movb r0,a                                           ; RLA               ; A = magnitude, carry = the sign
       jnc  _677d                                          ; JR NC,$677D       ; 
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
_677d:                                                     ; >677d
       movb a,@c                                           ; LD C,A            ; C = signed distance to move
       movb @reclaimed_range_start+1,ix                    ; LD IX,($EFA6)     ; IX -> the stardust table
       movb @reclaimed_range_start,@ixl                    ;                   ;
       movb @bytes+>0f,b                                   ; LD B,$0F          ; B = 15 particles
_6784:                                                     ; >6784
       movb @>03(ix),a                                     ; LD A,(IX+$03)     ; 
       ab   @c,a                                           ; ADD A,C           ; move the particle up or down
       movb a,@>03(ix)                                     ; LD (IX+$03),A     ; 
       .push bc                                            ; PUSH BC           ; 
       movb a,a                                            ;                   ; (the PUSH changed the status)
       jgt  stardust_move_abs_y                            ; JP P,$6791        ; 
       jeq  stardust_move_abs_y                            ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
stardust_move_abs_y:                                       ; >6791
       movb a,b                                            ; LD B,A            ; B = |Y|
       movb @>01(ix),a                                     ; LD A,(IX+$01) / OR A; 
       jgt  stardust_move_abs_x                            ; JP P,$679B        ; 
       jeq  stardust_move_abs_x                            ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
stardust_move_abs_x:                                       ; >679b
       movb a,@c                                           ; LD C,A            ; C = |X|
       bl   @stardust_set_velocity                         ; CALL $6805        ; set the velocity, pointing away from the centre
       li   de,>000b                                       ; LD DE,$000B       ; 
       a    de,ix                                          ; ADD IX,DE         ; IX -> next particle
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6784        ; loop for all 15 particles
       jne  _6784                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Jump to the entry for the current view in a table of handlers
* 
* Used by the routine at #R$68CD.
* .
* Used by #R$68CD to roll and pitch the stardust with the right handler
* for the current view ($EB9A).
* 
* I:HL Address of a table of 4 handler addresses (front, rear, left,
* .    right)
jump_to_view_handler:                                      ; >67a8
       movb @current_view,a                                ; LD A,($EB9A)      ; A = current view
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this view's entry
       mov  *hl,hl                                         ; LD A,(HL)         ; HL = the handler (TI data words are big-endian)
;      inc  hl                                             ; INC HL            ; 
;      movb *hl,h                                          ; LD H,(HL)         ; 
;      movb a,@l                                           ; LD L,A            ; 
       b    *hl                                            ; JP (HL)           ;

********************************************************************************
* Stardust: roll in the front view
* 
* Entry 0 of the roll handler table at #R$6EDD (see #R$67A8). Rotates the
* stardust (#R$66DC) by the negative of the roll angle.
stardust_roll_front:                                       ; >67b5
       movb @roll_cos+1,hl                                 ; LD HL,($EB77)     ; HL = cos (roll)
       movb @roll_cos,@l                                   ;                   ;
       movb @roll_sin+1,de                                 ; LD DE,($EB7A)     ; DE = sin (roll)
       movb @roll_sin,@e                                   ;                   ;
       movb d,a                                            ; LD A,D            ; 
       li   r0,128*256                                     ; XOR $80           ; 
       xor  r0,a                                           ;                   
       movb a,d                                            ; LD D,A            ; negate sin
       b    @stardust_rotate                               ; JP $66DC          ; rotate the stardust

********************************************************************************
* Stardust: roll in the rear view
* 
* Entry 1 of the roll handler table at #R$6EDD (see #R$67A8). Rotates the
* stardust (#R$66DC) by the roll angle.
stardust_roll_rear:                                        ; >67c3
       movb @roll_cos+1,hl                                 ; LD HL,($EB77)     ; HL = cos (roll)
       movb @roll_cos,@l                                   ;                   ;
       movb @roll_sin+1,de                                 ; LD DE,($EB7A)     ; DE = sin (roll)
       movb @roll_sin,@e                                   ;                   ;
       b    @stardust_rotate                               ; JP $66DC          ; rotate the stardust

********************************************************************************
* Stardust: roll in the left view
* 
* Entry 2 of the roll handler table at #R$6EDD (see #R$67A8). Moves the
* stardust vertically (#R$6775).
stardust_roll_left:                                        ; >67cd
       movb @roll_sin+1,hl                                 ; LD HL,($EB7A)     ; HL = sin (roll)
       movb @roll_sin,@l                                   ;                   ;
       b    @stardust_move_vertically                      ; JP $6775          ; move the stardust up or down

********************************************************************************
* Stardust: roll in the right view
* 
* Entry 3 of the roll handler table at #R$6EDD (see #R$67A8). Moves the
* stardust vertically (#R$6775), the opposite way to the left view.
stardust_roll_right:                                       ; >67d3
       movb @roll_sin+1,hl                                 ; LD HL,($EB7A)     ; HL = sin (roll)
       movb @roll_sin,@l                                   ;                   ;
       movb h,a                                            ; LD A,H            ; 
       li   r0,128*256                                     ; XOR $80           ; 
       xor  r0,a                                           ;                   
       movb a,h                                            ; LD H,A            ; negate it
       b    @stardust_move_vertically                      ; JP $6775          ; move the stardust up or down

********************************************************************************
* Stardust: pitch in the front view
* 
* Entry 0 of the pitch handler table at #R$6EE5 (see #R$67A8). Moves the
* stardust vertically (#R$6775).
stardust_pitch_front:                                      ; >67dd
       movb @pitch_sin+1,hl                                ; LD HL,($EB80)     ; HL = sin (pitch)
       movb @pitch_sin,@l                                  ;                   ;
       b    @stardust_move_vertically                      ; JP $6775          ; move the stardust up or down

********************************************************************************
* Stardust: pitch in the rear view
* 
* Entry 1 of the pitch handler table at #R$6EE5 (see #R$67A8). Moves the
* stardust vertically (#R$6775), the opposite way to the front view.
stardust_pitch_rear:                                       ; >67e3
       movb @pitch_sin+1,hl                                ; LD HL,($EB80)     ; HL = sin (pitch)
       movb @pitch_sin,@l                                  ;                   ;
       movb h,a                                            ; LD A,H            ; 
       li   r0,128*256                                     ; XOR $80           ; 
       xor  r0,a                                           ;                   
       movb a,h                                            ; LD H,A            ; negate it
       b    @stardust_move_vertically                      ; JP $6775          ; move the stardust up or down

********************************************************************************
* Stardust: pitch in the left view
* 
* Entry 2 of the pitch handler table at #R$6EE5 (see #R$67A8). Rotates the
* stardust (#R$66DC) by the pitch angle.
stardust_pitch_left:                                       ; >67ed
       movb @pitch_cos+1,hl                                ; LD HL,($EB7D)     ; HL = cos (pitch)
       movb @pitch_cos,@l                                  ;                   ;
       movb @pitch_sin+1,de                                ; LD DE,($EB80)     ; DE = sin (pitch)
       movb @pitch_sin,@e                                  ;                   ;
       b    @stardust_rotate                               ; JP $66DC          ; rotate the stardust

********************************************************************************
* Stardust: pitch in the right view
* 
* Entry 3 of the pitch handler table at #R$6EE5 (see #R$67A8). Rotates the
* stardust (#R$66DC) by the negative of the pitch angle.
stardust_pitch_right:                                      ; >67f7
       movb @pitch_cos+1,hl                                ; LD HL,($EB7D)     ; HL = cos (pitch)
       movb @pitch_cos,@l                                  ;                   ;
       movb @pitch_sin+1,de                                ; LD DE,($EB80)     ; DE = sin (pitch)
       movb @pitch_sin,@e                                  ;                   ;
       movb d,a                                            ; LD A,D            ; 
       li   r0,128*256                                     ; XOR $80           ; 
       xor  r0,a                                           ;                   
       movb a,d                                            ; LD D,A            ; negate sin
       b    @stardust_rotate                               ; JP $66DC          ; rotate the stardust

********************************************************************************
* Stardust: set a particle's velocity
* 
* Used by the routines at #R$64F1, #R$656B, #R$6628, #R$6682, #R$66DC, #R$6775
* and #R$6882.
* .
* Points the particle's velocity in direction (C,B) - normally its own
* distance from the centre (|X|,|Y|) - with the signs of X and Y, i.e.
* away from the centre. First scales C and B down together, keeping their
* ratio, until both fit in 3 bits; then looks up the 8x8 table at #R$6F1F,
* which holds a direction vector of length 63 for each (C,B) pair. With
* v = one component of that vector and b = v/4, the velocity component is
* set to v + b * speed ($F814), so the stardust moves faster the faster
* the ship is flying. b is also stored at +9/+10, as the amount by which
* #R$6956/#R$699C adjust the velocity when the speed goes up or down by
* one. Finally clears the respawn flag.
* 
* I:B |Y| (or a random 4-7 in the side views)
* I:C |X| (or a random 4-7 in the side views)
* I:IX Pointer to the particle
* O:B |Y| scaled down to 3 bits
* O:C |X| scaled down to 3 bits
stardust_set_velocity:                                     ; >6805
       movb @c,a                                           ; LD A,C            ; 
       socb b,a                                            ; OR B              ; 
       movb a,r1                                           ; LD L,A            ; 
       srl  r1,8                                           ; LD H,$02          ; 
       movb @bit_length_table(r1),a                        ; LD A,(HL)         ; A = bit length of (C OR B)
       sb   @bytes+>04,a                                   ; SUB $04           ; 
       jlt  stardust_set_velocity_lookup                   ; JP M,$6818        ; both already fit in 3 bits
!
       ab   one,a                                          ; INC A             ; A = number of bits to shift out
_6811:                                                     ; >6811
       srl  bc,1                                           ; SRL C             ; 
       andi bc,>7f7f                                       ; SRL B             ; scale C and B down (separately)...
       sb   one,a                                          ; DEC A             ; 
       jne  _6811                                          ; JR NZ,$6811       ; ...until both fit in 3 bits
stardust_set_velocity_lookup:                              ; >6818
       .push bc                                            ; PUSH BC           ; 
       movb @c,a                                           ; LD A,C            ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   b,a                                            ; ADD A,B           ; 
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,stardust_directions                         ; LD HL,$6F1F       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> direction vector for (C,B)
       movb *hl,a                                          ; LD A,(HL)         ; A = X component
       inc  hl                                             ; INC HL            ; 
       movb *hl,@c                                         ; LD C,(HL)         ; C = Y component
       movb @>01(ix),r0                                    ; BIT 7,(IX+$01)    ; 
       andi r0,>8000                                       ;                   
       jeq  _6831                                          ; JR Z,$6831        ; 
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; give it the sign of X
_6831:                                                     ; >6831
       movb a,r0                                           ; LD L,A            ; 
       sra  r0,8                                           ; RLA               ; 
       mov  r0,hl                                          ; SBC A,A           ; 
       movb h,a                                            ; LD H,A            ; HL = v, sign-extended
       movb h,d                                            ; LD D,H            ; 
       movb @l,@e                                          ; LD E,L            ; 
       sra  d,1                                            ; SRA D             ; 
       ; RR E                                              ; RR E              ; (done by the SRA D above, which shifts all of DE)
       sra  d,1                                            ; SRA D             ; 
       ; RR E                                              ; RR E              ; DE = b = v / 4 (done by the SRA D above, which shifts all of DE)
       movb @speed_gauge_value,a                           ; LD A,($F814) / OR A; A = speed
       jeq  _6849                                          ; JR Z,$6849        ; stationary - velocity is just v
       movb a,b                                            ; LD B,A            ; 
_6846:                                                     ; >6846
       a    de,hl                                          ; ADD HL,DE         ; add b once for each unit of speed
       sb   one,b                                          ; DJNZ $6846        ; 
       jne  _6846                                          ;                   
_6849:                                                     ; >6849
       movb @l,@>04(ix)                                    ; LD (IX+$04),L     ; 
       movb h,@>05(ix)                                     ; LD (IX+$05),H     ; set the X velocity
       movb @e,@>09(ix)                                    ; LD (IX+$09),E     ; save b for speed changes
       movb @c,a                                           ; LD A,C            ; A = Y component
       movb @>03(ix),r0                                    ; BIT 7,(IX+$03)    ; 
       andi r0,>8000                                       ;                   
       jeq  _685b                                          ; JR Z,$685B        ; 
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; give it the sign of Y
_685b:                                                     ; >685b
       movb a,r0                                           ; LD L,A            ; 
       sra  r0,8                                           ; RLA               ; 
       mov  r0,hl                                          ; SBC A,A           ; 
       movb h,a                                            ; LD H,A            ; HL = v, sign-extended
       movb h,d                                            ; LD D,H            ; 
       movb @l,@e                                          ; LD E,L            ; 
       sra  d,1                                            ; SRA D             ; 
       ; RR E                                              ; RR E              ; (done by the SRA D above, which shifts all of DE)
       sra  d,1                                            ; SRA D             ; 
       ; RR E                                              ; RR E              ; DE = b = v / 4 (done by the SRA D above, which shifts all of DE)
       movb @speed_gauge_value,a                           ; LD A,($F814) / OR A; A = speed
       jeq  _6873                                          ; JR Z,$6873        ; stationary - velocity is just v
       movb a,b                                            ; LD B,A            ; 
_6870:                                                     ; >6870
       a    de,hl                                          ; ADD HL,DE         ; add b once for each unit of speed
       sb   one,b                                          ; DJNZ $6870        ; 
       jne  _6870                                          ;                   
_6873:                                                     ; >6873
       movb @l,@>06(ix)                                    ; LD (IX+$06),L     ; 
       movb h,@>07(ix)                                     ; LD (IX+$07),H     ; set the Y velocity
       movb @e,@>0a(ix)                                    ; LD (IX+$0A),E     ; save b for speed changes
       sb   @>08(ix),@>08(ix)                              ; LD (IX+$08),$00   ; clear the respawn flag
       .pop bc                                             ; POP BC            ; restore the scaled-down C and B
       rt                                                  ; RET               ; 

********************************************************************************
* Stardust: scatter a fresh stardust field
* 
* Used by the routines at #R$645B and #R$707D.
* .
* Gives every particle a random position within 87 pixels of the centre
* horizontally and 63 vertically, and sets its velocity (#R$6805). The
* position is rerolled if either of the scaled-down |X| and |Y| values
* returned by #R$6805 is below 4 - i.e. if the particle is too near the
* centre, or much nearer one axis than the other.
scatter_stardust:                                          ; >6882
       .proc
       movb @reclaimed_range_start+1,ix                    ; LD IX,($EFA6)     ; IX -> the stardust table
       movb @reclaimed_range_start,@ixl                    ;                   ;
       movb @bytes+>0f,b                                   ; LD B,$0F          ; B = 15 particles
_6888:                                                     ; >6888
       .push bc                                            ; PUSH BC           ; 
_6889:                                                     ; >6889
       bl   @random_byte                                   ; CALL $2176        ; pick a random X...
       movb a,@l                                           ; LD L,A / OR A     ; 
       jgt  scatter_stardust_x                             ; JP P,$6893        ; 
       jeq  scatter_stardust_x                             ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
scatter_stardust_x:                                        ; >6893
       cb   a,@bytes+>58                                   ; CP $58            ; 
       jhe  _6889                                          ; JR NC,$6889       ; ...within 87 of the centre
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb @l,@>01(ix)                                    ; LD (IX+$01),L     ; set X
       .ex_af_af_                                          ; EX AF,AF'         ; save |X|
_689f:                                                     ; >689f
       bl   @random_byte                                   ; CALL $2176        ; pick a random Y...
       movb a,@l                                           ; LD L,A / OR A     ; 
       jgt  scatter_stardust_y                             ; JP P,$68A9        ; 
       jeq  scatter_stardust_y                             ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
scatter_stardust_y:                                        ; >68a9
       cb   a,@bytes+>40                                   ; CP $40            ; 
       jhe  _689f                                          ; JR NC,$689F       ; ...within 63 of the centre
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb @l,@>03(ix)                                    ; LD (IX+$03),L     ; set Y
       movb a,b                                            ; LD B,A            ; B = |Y|
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb a,@c                                           ; LD C,A            ; C = |X|
       bl   @stardust_set_velocity                         ; CALL $6805        ; set the velocity, pointing away from the centre
       movb @c,a                                           ; LD A,C            ; 
       cb   a,@bytes+>04                                   ; CP $04            ; scaled-down |X| below 4?
       jl   _68c2                                          ; JR C,$68C2        ; yes - reroll
       movb b,a                                            ; LD A,B            ; 
       cb   a,@bytes+>04                                   ; CP $04            ; scaled-down |Y| below 4?
_68c2:                                                     ; >68c2
       jl   _6889                                          ; JR C,$6889        ; yes - reroll
       li   de,>000b                                       ; LD DE,$000B       ; 
       a    de,ix                                          ; ADD IX,DE         ; IX -> next particle
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6888        ; loop for all 15 particles
       jne  _6888                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Move and plot the stardust
* 
* Used by the routine at #R$872E.
* .
* The stardust is 15 particles held in an 11-byte-per-particle table at
* ($EFA6) (the reclaimed startup code at #R$6F9F). Each particle's position
* is relative to the centre of the 176x128 space view: +0/+1 is X and +2/+3
* is Y, both signed 8.8 fixed point (the high byte is the pixel offset);
* +4/+5 and +6/+7 are its X and Y velocities (same format); +8 is the
* respawn flag (nonzero means the particle has left the view and the move
* handler should respawn it); +9/+10 are the velocity increments applied
* per step of speed change (see #R$6805).
* .
* First applies the ship's roll and pitch, through the jump tables at #R$6EDD
* (roll) and #R$6EE5 (pitch), indexed by the current view ($EB9A: 0=front,
* 1=rear, 2=left, 3=right). In the front and rear views roll rotates the
* stardust about the centre (#R$66DC) and pitch moves it up or down
* (#R$6775); in the side views it's the other way round. Then each particle
* that's inside the view is plotted as a single pixel (#R$3CFD) and moved
* by the current view's move handler: #R$64F1 (front, particles fly out
* from the centre), #R$656B (rear, fly in from the edges), #R$6628 (left,
* right to left) or #R$6682 (right, left to right). The handler is selected
* by #R$645B patching the CALL at $6944 when the view changes. A particle
* outside the view isn't plotted, and is flagged for respawning instead (at
* $6950).
* .
* At $6902, checks X against the left edge (X < -87 is outside), then Y
* against the bottom (Y > 64) and top ($6911) edges.
* .
* At $6911, checks Y against the top edge (Y < -63 is outside). In the rear
* view, where the particles converge on the centre, a particle within 10
* pixels of the centre on both axes is respawned rather than plotted.
* Otherwise plots the particle and calls the current view's move handler,
* then loops back to #R$68CD for the next particle.
* .
* At $6950, a particle that has left the view (or, in the rear view,
* reached the centre) is flagged for respawning, and the move handler is
* called (at $6940) without plotting it, so it gets a new position.
move_and_plot_stardust:                                    ; >68cd
       .proc
       movb @in_witchspace,a                               ; LD A,($EEC1) / OR A; no stardust after a drive malfunction (set by #R$894D)
       jne  move_and_plot_stardust_exit                    ; RET NZ            ; 
!
       movb @roll_rate,a                                   ; LD A,($F815) / OR A; A = roll rate
       jeq  _68de                                          ; JR Z,$68DE        ; not rolling - skip the roll
       li   hl,stardust_roll_handlers                      ; LD HL,$6EDD       ; HL -> the per-view roll handlers
       bl   @jump_to_view_handler                          ; CALL $67A8        ; roll the stardust for this view
_68de:                                                     ; >68de
       movb @pitch_rate,a                                  ; LD A,($F816) / OR A; A = pitch rate
       jeq  _68ea                                          ; JR Z,$68EA        ; not pitching - skip the pitch
       li   hl,stardust_pitch_handlers                     ; LD HL,$6EE5       ; HL -> the per-view pitch handlers
       bl   @jump_to_view_handler                          ; CALL $67A8        ; pitch the stardust for this view
_68ea:                                                     ; >68ea
       movb @reclaimed_range_start+1,ix                    ; LD IX,($EFA6)     ; IX -> the stardust table
       movb @reclaimed_range_start,@ixl                    ;                   ;
       movb @bytes+>0f,b                                   ; LD B,$0F          ; B = 15 particles
_68f0:                                                     ; >68f0
       .push bc                                            ; PUSH BC           ; save the particle counter
       movb @>01(ix),@e                                    ; LD E,(IX+$01)     ; E = X pixel offset
       movb @>03(ix),d                                     ; LD D,(IX+$03)     ; D = Y pixel offset
       movb @e,a                                           ; LD A,E / OR A     ; 
       jlt  stardust_check_left_edge                       ; JP M,$6902        ; X negative - check the left edge instead
!
       cb   a,@bytes+>59                                   ; CP $59            ; X > 88?
       jhe  stardust_flag_respawn                          ; JR NC,$6950       ; yes - off the right edge, respawn it
       jmp  _6906                                          ; JR $6906          ; go check Y
stardust_check_left_edge:                                  ; >6902
       cb   a,@bytes+>a9                                   ; CP $A9            ; X < -87?
       jl   stardust_flag_respawn                          ; JR C,$6950        ; yes - off the left edge, respawn it
_6906:                                                     ; >6906
       movb d,a                                            ; LD A,D / OR A     ; A = Y pixel offset
       jlt  stardust_check_top_edge_and_plot               ; JP M,$6911        ; Y negative - check the top edge instead
!
       cb   a,@bytes+>41                                   ; CP $41            ; Y > 64?
       jhe  stardust_flag_respawn                          ; JR NC,$6950       ; yes - off the bottom edge, respawn it
       jmp  _6915                                          ; JR $6915          ; inside the view - go plot it
stardust_check_top_edge_and_plot:                          ; >6911
       cb   a,@bytes+>c1                                   ; CP $C1            ; Y < -63?
       jl   stardust_flag_respawn                          ; JR C,$6950        ; yes - off the top edge, respawn it
_6915:                                                     ; >6915
       movb @current_view,a                                ; LD A,($EB9A)      ; A = current view
       sb   one,a                                          ; DEC A             ; 
       jne  _6931                                          ; JR NZ,$6931       ; not the rear view - go plot it
       movb @e,a                                           ; LD A,E / OR A     ; 
       jgt  stardust_check_centre_x                        ; JP P,$6922        ; 
       jeq  stardust_check_centre_x                        ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = |X|
stardust_check_centre_x:                                   ; >6922
       cb   a,@bytes+>0a                                   ; CP $0A            ; 
       jhe  _6931                                          ; JR NC,$6931       ; |X| >= 10 - go plot it
       movb d,a                                            ; LD A,D / OR A     ; 
       jgt  stardust_check_centre_y                        ; JP P,$692D        ; 
       jeq  stardust_check_centre_y                        ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = |Y|
stardust_check_centre_y:                                   ; >692d
       cb   a,@bytes+>0a                                   ; CP $0A            ; 
       jl   stardust_flag_respawn                          ; JR C,$6950        ; |Y| < 10 too - reached the centre, respawn it
_6931:                                                     ; >6931
       movb @e,a                                           ; LD A,E            ; 
       ab   @bytes+>57,a                                   ; ADD A,$57         ; C = screen column (view centre is column 87)
       movb a,@c                                           ; LD C,A            ; 
       movb d,a                                            ; LD A,D            ; 
       ab   @bytes+>3f,a                                   ; ADD A,$3F         ; B = screen row (view centre is row 63)
       movb a,b                                            ; LD B,A            ; 
       .push ix                                            ; PUSH IX           ; 
       bl   @plot_single_pixel                             ; CALL $3CFD        ; plot the particle
       .pop ix                                             ; POP IX            ; 
_6940:                                                     ; >6940
       movb @>08(ix),a                                     ; LD A,(IX+$08) / OR A; Z flag = particle doesn't need respawning
stardust_move_handler:                                     ; >6944
       bl   @stardust_front_view                           ; CALL $64F1        ; move or respawn it (operand patched per view by #R$645B)
       li   de,>000b                                       ; LD DE,$000B       ; 
       a    de,ix                                          ; ADD IX,DE         ; IX -> next particle
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $68F0        ; loop for all 15 particles
       jne  _68f0                                          ;                   
move_and_plot_stardust_exit:
       .endproc                                            ; RET               ; 
stardust_flag_respawn:                                     ; >6950
       movb @b255,@>08(ix)                                 ; LD (IX+$08),$FF   ; flag the particle for respawning
       jmp  _6940                                          ; JR $6940          ; go call the move handler

********************************************************************************
* Increase the speed by one
* 
* Used by the routines at #R$401C and #R$8B8F.
* .
* Increments the speed at $F814 (up to a maximum of 30) and updates the
* speed gauge (#R$6A59), then adds each stardust particle's per-unit-speed
* velocity increment (+9/+10, see #R$6805) to its velocity. See #R$699C
* for the downward counterpart.
speed_up:                                                  ; >6956
       .proc                                               ; PUSH AF           ; 
       cb   @speed_gauge_value,@bytes+>1e                  ; LD HL,$F814 / LD A,(HL) / CP $1E; 
       jhe  _699a                                          ; JR NC,$699A       ; already 30 - done
       ab   one,@speed_gauge_value                         ; INC (HL)          ; speed up
       bl   @draw_speed_gauge                              ; CALL $6A59        ; update the speed gauge
       movb @reclaimed_range_start+1,r1                    ; LD IX,($EFA6)     ; R1 -> the stardust table
       movb @reclaimed_range_start,@r1lb                   ;                   ; 
       li   r2,15                                          ; LD DE,$000B / LD B,$0F; 15 particles
_696c:                                                     ; >696c
       movb @9(r1),r0                                      ; LD A,(IX+$09) / LD C,A; 
       sra  r0,8                                           ; RLA / SBC A,A / LD B,A; R0 = the X velocity's increment (sign-extended)
       movb @5(r1),hl                                      ; LD L,(IX+$04) / LD H,(IX+$05); 
       movb @4(r1),@l                                      ;                   ; 
       a    r0,hl                                          ; ADD HL,BC         ; 
       movb hl,@5(r1)                                      ; LD (IX+$04),L / LD (IX+$05),H; add it to the X velocity
       movb @l,@4(r1)                                      ;                   ; 
       movb @10(r1),r0                                     ; LD A,(IX+$0A) / LD C,A; 
       sra  r0,8                                           ; RLA / SBC A,A / LD B,A; R0 = the Y velocity's increment
       movb @7(r1),hl                                      ; LD L,(IX+$06) / LD H,(IX+$07); 
       movb @6(r1),@l                                      ;                   ; 
       a    r0,hl                                          ; ADD HL,BC         ; 
       movb hl,@7(r1)                                      ; LD (IX+$06),L / LD (IX+$07),H; add it to the Y velocity
       movb @l,@6(r1)                                      ;                   ; 
       ai   r1,11                                          ; ADD IX,DE         ; next particle
       dec  r2                                             ; DJNZ $696C        ; 
       jne  _696c                                          ;                   ; 
_699a:                                                     ; >699a
       .endproc                                            ; POP AF / RET      ; 

********************************************************************************
* Decrease the speed by one
* 
* Used by the routines at #R$401C and #R$8B7B.
* .
* The downward counterpart to #R$6956: decrements the speed (down to a
* minimum of 0) and subtracts each stardust particle's per-unit-speed
* velocity increment from its velocity.
speed_down:                                                ; >699c
       .proc                                               ; PUSH AF           ; 
       movb @speed_gauge_value,r0                          ; LD HL,$F814 / LD A,(HL) / OR A; 
       jeq  _69e3                                          ; JR Z,$69E3        ; already 0 - done
       sb   one,@speed_gauge_value                         ; DEC (HL)          ; slow down
       bl   @draw_speed_gauge                              ; CALL $6A59        ; update the speed gauge
       movb @reclaimed_range_start+1,r1                    ; LD IX,($EFA6)     ; R1 -> the stardust table
       movb @reclaimed_range_start,@r1lb                   ;                   ; 
       li   r2,15                                          ; LD DE,$000B / LD B,$0F; 15 particles
_69b1:                                                     ; >69b1
       movb @9(r1),r0                                      ; LD A,(IX+$09) / LD C,A; 
       sra  r0,8                                           ; RLA / SBC A,A / LD B,A; R0 = the X velocity's increment (sign-extended)
       movb @5(r1),hl                                      ; LD L,(IX+$04) / LD H,(IX+$05); 
       movb @4(r1),@l                                      ;                   ; 
       s    r0,hl                                          ; OR A / SBC HL,BC  ; 
       movb hl,@5(r1)                                      ; LD (IX+$04),L / LD (IX+$05),H; subtract it from the X velocity
       movb @l,@4(r1)                                      ;                   ; 
       movb @10(r1),r0                                     ; LD A,(IX+$0A) / LD C,A; 
       sra  r0,8                                           ; RLA / SBC A,A / LD B,A; R0 = the Y velocity's increment
       movb @7(r1),hl                                      ; LD L,(IX+$06) / LD H,(IX+$07); 
       movb @6(r1),@l                                      ;                   ; 
       s    r0,hl                                          ; OR A / SBC HL,BC  ; 
       movb hl,@7(r1)                                      ; LD (IX+$06),L / LD (IX+$07),H; subtract it from the Y velocity
       movb @l,@6(r1)                                      ;                   ; 
       ai   r1,11                                          ; ADD IX,DE         ; next particle
       dec  r2                                             ; DJNZ $69B1        ; 
       jne  _69b1                                          ;                   ; 
_69e3:                                                     ; >69e3
       .endproc                                            ; POP AF / RET      ; 

********************************************************************************
* Key held: roll left
* 
* Used by the routine at #R$401C.
* .
* Ramps the roll rate (#R$F815) towards -16 (#R$6A15). The entry at $69E7
* ramps it towards the target in E.
* 
* I:E The target (at $69E7)
roll_left:                                                 ; >69e5
       li   r0,>f000                                       ; LD E,$F0          ; -16
* This entry point is used by the routine at #R$69F8.
roll_key:                                                  ; >69e7
       .proc                                               ;                   ; 
       .push a                                             ; PUSH AF           ; (TI: saved here rather than in #R$6A15)
       li   r1,roll_rate                                   ; LD HL,$F815       ; the roll rate
       li   r2,roll_key_held                               ; LD BC,$E774       ; the roll key is held
       bl   @ramp_rate                                     ; JP $6A15          ; ramp it
       jeq  roll_key_end                                   ;                   ; unchanged
       bl   @draw_roll_dial                                ; LD IX,$6BB3       ; draw the roll dial
       bl   @refresh_roll_table                            ; LD IY,$2209       ; set up the roll
roll_key_end:                                              
       .pop a                                              ; POP AF            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Key held: roll right
* 
* Used by the routine at #R$401C.
* .
* Ramps the roll rate (#R$F815) towards +16 (#R$69E7).
roll_right:                                                ; >69f8
       li   r0,>1000                                       ; LD E,$10          ; +16
       jmp  roll_key                                       ; JP $69E7          ; 

********************************************************************************
* Key held: climb
* 
* Used by the routine at #R$401C.
* .
* Ramps the pitch rate (#R$F816) towards +16 (#R$6A15). The entry at
* $69FF ramps it towards the target in E.
* 
* I:E The target (at $69FF)
pitch_climb:                                               ; >69fd
       li   r0,>1000                                       ; LD E,$10          ; +16
* This entry point is used by the routine at #R$6A10.
pitch_key:                                                 ; >69ff
       .proc                                               ;                   ; 
       .push a                                             ; PUSH AF           ; (TI: saved here rather than in #R$6A15)
       li   r1,pitch_rate                                  ; LD HL,$F816       ; the pitch rate
       li   r2,pitch_key_held                              ; LD BC,$E775       ; the pitch key is held
       bl   @ramp_rate                                     ; JP $6A15          ; ramp it
       jeq  pitch_key_end                                  ;                   ; unchanged
       bl   @draw_pitch_dial                               ; LD IX,$6BCA       ; draw the pitch dial
       bl   @refresh_pitch_table                           ; LD IY,$2212       ; set up the pitch
pitch_key_end:                                             
       .pop a                                              ; POP AF            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Key held: dive
* 
* Used by the routine at #R$401C.
* .
* Ramps the pitch rate (#R$F816) towards -16 (#R$69FF).
pitch_dive:                                                ; >6a10
       li   r0,>f000                                       ; LD E,$F0          ; -16
       jmp  pitch_key                                      ; JP $69FF          ; 

********************************************************************************
* Ramp the roll or pitch rate towards a key's target
* 
* Used by the routines at #R$69E5 and #R$69FD.
* .
* While a roll or pitch key is held: marks the key as held, and moves the
* rate 2 towards the target (+16 or -16).
* With option R (bit 2 of #R$E914), a rate on the other side of 0 is
* stopped (set to 0) first. If the rate has changed, redraws its dial and
* sets up the rotation from it (via #R$6A58).
* 
* I:BC The key-held flag (#R$E774 or #R$E775)
* I:E The target
* I:HL The rate (#R$F815 or #R$F816)
* I:IX The routine that draws the dial (#R$6BB3 or #R$6BCA)
* I:IY The routine that sets up the rotation (#R$2209 or #R$2212)
* TI: the caller draws the dial and sets up the rotation, if this returns
* with NE (the rate has changed).
*
* I:R0 The target (high byte)
* I:R1 -> The rate (#R$F815 or #R$F816)
* I:R2 -> The key-held flag (#R$E774 or #R$E775)
* O:F EQ if the rate is unchanged
ramp_rate:                                                 ; >6a15
       movb @b255,*r2                                      ; LD A,$FF / LD (BC),A; the key is held
       cb   *r1,r0                                         ; LD A,(HL) / CP E  ; at the target?
       jne  _6a1d                                          ; JR Z,$6A56        ; 
       rt                                                  ;                   ; yes - done (EQ)
_6a1d:                                                     ; >6a1d
       mov  r0,r0                                          ; BIT 7,E           ; going down?
       jlt  ramp_step_down_check                           ; JR NZ,$6A36       ; yes
       movb *r1,r0                                         ; OR A              ; going up: is the rate negative?
       jgt  ramp_step_up                                   ; JP P,$6A30        ; no - speed up
       jeq  ramp_step_up                                   ;                   ; 
       movb @options,r0                                    ; LD A,($E914)      ; option R?
       czc  @bit2,r0                                       ; AND $04           ; 
       jeq  ramp_step_up                                   ; JR Z,$6A30        ; no - speed up
       sb   *r1,*r1                                        ; LD (HL),$00       ; yes - stop first
       jmp  _6a4a                                          ; JR $6A34 / JR $6A4A; 
ramp_step_up:                                              ; >6a30
       ab   @bytes+>02,*r1                                 ; LD A,(HL) / ADD A,$02 / LD (HL),A; rate + 2
       jmp  _6a4a                                          ; JR $6A4A          ; 
ramp_step_down_check:                                      ; >6a36
       movb *r1,r0                                         ; CP $01            ; going down: is the rate positive?
       jlt  ramp_step_down                                 ; JP M,$6A46        ; no - slow down
       jeq  ramp_step_down                                 ;                   ; 
       movb @options,r0                                    ; LD A,($E914)      ; option R?
       czc  @bit2,r0                                       ; AND $04           ; 
       jeq  ramp_step_down                                 ; JR Z,$6A46        ; no - slow down
       sb   *r1,*r1                                        ; LD (HL),$00       ; yes - stop first
       jmp  _6a4a                                          ; JR $6A4A          ; 
ramp_step_down:                                            ; >6a46
       sb   @bytes+>02,*r1                                 ; LD A,(HL) / ADD A,$FE / LD (HL),A; rate - 2
_6a4a:                                                     ; >6a4a
       movb one,r0                                         ; CALL $6A58 ...    ; changed (NE): the caller redraws the dial and sets up the rotation
       rt                                                  ; POP AF / RET      ; 

********************************************************************************
* Draw the speed gauge
* 
* Used by the routines at #R$6433, #R$6956 and #R$699C.
* .
* Does nothing while the redrawing is off (#R$E92B). Otherwise draws the
* speed indicator at $31B3 - which changes above speed 26, and flashes
* (#R$72C1) - and the speed gauge's bar at $11B3 (#R$6C37), from the
* speed (#R$F814, 0-30).
draw_speed_gauge:                                          ; >6a59
       .proc
       movb @redraw_speed_gauge,a                          ; LD A,($E92B) / OR A; 
       jne  !                                              ; RET Z             ; redrawing off (#R$E92B)
       .endproc                                            ;                   
!
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = the speed
       cb   a,@bytes+>1a                                   ; CP $1A            ; over 26?
       jl   !                                              ; JR C,$6A69        ; no (CB doesn't set carry on the TI - test before loading A)
       movb @bytes+>81,a                                   ; LD A,$81          ; yes: colour $81
       jmp  _6a69                                          ;                   ; 
!
       movb @bytes+>b1,a                                   ; LD A,$B1          ; colour $B1
_6a69:                                                     ; >6a69
       movb a,@e913_status_toggle                          ; LD ($E913),A      ; the colour the indicator flashes with (#R$E913)
       movb @bytes+>03,@c                                  ; LD C,$03          ; 3 cells
       li   hl,>31b3                                       ; LD HL,$31B3       ; at $31B3, the indicator's colours
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; colour it (#R$6CA8)
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; 
       movb @bytes+>18,@e                                  ; LD E,$18          ; 
       bl   @multiply_a_e_16bit                            ; CALL $1F60        ; HL = the speed * 24
       movb @bytes+>1e,a                                   ; LD A,$1E          ; 
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = the speed * 24 / 30 (#R$2079)
       movb @l,a                                           ; LD A,L            ; A = the bar's length (0-24)
       li   hl,>11b3                                       ; LD HL,$11B3       ; the speed gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the energy banks
* 
* Used by the routines at #R$190D, #R$19EC and #R$6433.
* .
* Does nothing if the dashboard isn't shown (#R$6C9E). Draws the energy
* (#R$F817) as four bars (#R$6C37) of up to 24 each, one above the other,
* filling the bottom one first (at $6A9C for the bar that isn't full).
draw_energy_banks:                                         ; >6a88
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       li   hl,>17b0                                       ; LD HL,$17B0       ; HL = $17B0, the bottom bar's VRAM address
       movb @energy_gauge,a                                ; LD A,($F817)      ; A = the energy
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 bars
_6a93:                                                     ; >6a93
       cb   a,@bytes+>19                                   ; CP $19            ; 
       jl   continuation_rows_value_under_per_row          ; JR C,$6A9C        ; less than a full bar left
       movb @bytes+>18,@c                                  ; LD C,$18          ; 
       sb   @c,a                                           ; SUB C             ; a full bar (24)
       jmp  _6a9e                                          ; JR $6A9E          ; 
continuation_rows_value_under_per_row:                     ; >6a9c
       movb a,@c                                           ; LD C,A            ; a partial bar...
       sb   a,a                                            ; XOR A             ; ...and nothing left for the ones above
_6a9e:                                                     ; >6a9e
       .push af                                            ; PUSH AF           ; 
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @c,a                                           ; LD A,C            ; 
       bl   @draw_bar_gauge                                ; CALL $6C37        ; draw the bar (#R$6C37)
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; 
       sb   one,h                                          ; DEC H             ; 
       ab   one,@l                                         ; INC L             ; the next bar up (a character row up and a pixel row down)
       sb   one,b                                          ; DJNZ $6A93        ; 
       jne  _6a93                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw the fuel gauge [dashboard]
* 
* Used by the routines at #R$1577, #R$6433 and #R$894D.
* .
* Draws the fuel (#R$F775, 0-70) as a bar of 0-24 pixels (#R$6C37). Does
* nothing if the dashboard isn't shown (#R$6C9E).
draw_fuel_gauge:                                           ; >6aad
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @fuel_level,a                                  ; LD A,($F775)      ; A = the fuel
       movb @bytes+>18,@e                                  ; LD E,$18          ; 
       bl   @multiply_a_e_16bit                            ; CALL $1F60        ; HL = fuel * 24 (#R$1F60)
       movb @bytes+>46,a                                   ; LD A,$46          ; 
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = fuel * 24 / 70 (#R$2079)
       movb @l,a                                           ; LD A,L            ; 
       li   hl,>1339                                       ; LD HL,$1339       ; the fuel gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the altitude gauge [dashboard]
* 
* Used by the routines at #R$1577 and #R$6433.
* .
* Draws the altitude (#R$F812) as a bar (#R$6C37). Does nothing if the
* dashboard isn't shown (#R$6C9E).
draw_altitude:                                             ; >6ac4
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @altitude_gauge,a                              ; LD A,($F812)      ; A = the altitude
       li   hl,>1639                                       ; LD HL,$1639       ; the altitude gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the cabin temperature gauge [dashboard]
* 
* Used by the routines at #R$1577 and #R$6433.
* .
* Draws the cabin temperature (#R$F811) as a bar (#R$6C37). Does nothing if
* the dashboard isn't shown (#R$6C9E).
draw_cabin_temperature:                                    ; >6ad0
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @cabin_temperature,a                           ; LD A,($F811)      ; A = the cabin temperature
       li   hl,>1439                                       ; LD HL,$1439       ; the cabin temperature gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the "S" (space station in range) indicator
* 
* Used by the routines at #R$1549 and #R$6433.
* .
* Draws the console's "S" (#R$6EFF) if ($EB05) is 1, i.e. the ship is
* inside the space station's safe zone (see #R$1549); otherwise blanks it
* (at $6B05). Does nothing if the dashboard isn't shown (#R$6C9E).
draw_station_indicator:                                    ; >6adc
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @station_in_range,a                            ; LD A,($EB05)      ; 
       sb   one,a                                          ; DEC A             ; the space station in range?
       jne  continuation_blank_status_lamp_tile            ; JR NZ,$6B05       ; no - blank the indicator
;      limi 0                                              ; DI                ; 
       movb @bytes+>a0,a                                   ; LD A,$A0          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>56,a                                   ; LD A,$56          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $16A0: the pattern of row 22, column 20
       li   hl,station_indicator_glyph                     ; LD HL,$6EFF       ; HL -> the "S" glyph (#R$6EFF)
       movb @bytes+>08,b                                   ; LD B,$08          ; its first 8 rows
       bl   @copy_to_vram                                  ; CALL $3830        ; write them (#R$3830)
       movb @bytes+>a0,a                                   ; LD A,$A0          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>57,a                                   ; LD A,$57          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $17A0: row 23, column 20
       movb @bytes+>04,b                                   ; LD B,$04          ; its last 4 rows
       bl   @copy_to_vram                                  ; CALL $3830        ; write them
       jmp  _6b10                                          ; JR $6B10          ; 
continuation_blank_status_lamp_tile:                       ; >6b05
       li   hl,>16a0                                       ; LD HL,$16A0       ; HL = $16A0 again
       movb @bytes+>0c,b                                   ; LD B,$0C          ; 12 pixel rows
       movb one,@c                                         ; LD C,$01          ; 1 character
       sb   a,a                                            ; XOR A             ; of 0
       bl   @fill_vram_rect                                ; CALL $35B8        ; blank the indicator (#R$35B8)
_6b10:                                                     ; >6b10
       ; EI                                                ; EI                ;
       .endproc                                            ; RET               ; 

********************************************************************************
* Show or hide the "E" (ECM) indicator
* 
* Used by the routines at #R$25B9, #R$3223, #R$323C and #R$6433.
* .
* Shows the console's "E" (#R$6F0B) while the ECM is on (#R$E912
* nonzero), otherwise blanks it (at $6B3B). Does nothing if the dashboard
* isn't shown (#R$6C9E).
draw_ecm_indicator:                                        ; >6b12
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @ecm_countdown,a                               ; LD A,($E912) / OR A; ECM on?
       jeq  continuation_blank_status_lamp_tile_6b3b       ; JR Z,$6B3B        ; no - blank the indicator
;      limi 0                                              ; DI                ; 
       movb @bytes+>50,a                                   ; LD A,$50          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>56,a                                   ; LD A,$56          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1650: the pattern of row 22, column 10
       li   hl,ecm_indicator_glyph                         ; LD HL,$6F0B       ; HL -> the "E" glyph (#R$6F0B)
       movb @bytes+>08,b                                   ; LD B,$08          ; its first 8 rows
       bl   @copy_to_vram                                  ; CALL $3830        ; write them (#R$3830)
       movb @bytes+>50,a                                   ; LD A,$50          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>57,a                                   ; LD A,$57          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1750: row 23, column 10
       movb @bytes+>04,b                                   ; LD B,$04          ; its last 4 rows
       bl   @copy_to_vram                                  ; CALL $3830        ; write them
       jmp  _6b46                                          ; JR $6B46          ; 
continuation_blank_status_lamp_tile_6b3b:                  ; >6b3b
       li   hl,>1650                                       ; LD HL,$1650       ; HL = $1650 again
       movb @bytes+>0c,b                                   ; LD B,$0C          ; 12 pixel rows
       movb one,@c                                         ; LD C,$01          ; 1 character
       sb   a,a                                            ; XOR A             ; of 0
       bl   @fill_vram_rect                                ; CALL $35B8        ; blank the indicator (#R$35B8)
_6b46:                                                     ; >6b46
       ; EI                                                ; EI                ;
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw the fore shield gauge [dashboard]
