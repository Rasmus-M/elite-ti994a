********************************************************************************
* Antilog table
* 
* 512 words: entry i is 2^(i/32), rounded (1 up to $FA83). With the log
* table at #R$0800 (log2(n)*1024), multiplying two numbers is a matter
* of adding their logs and looking up the sum here: #R$1FF2 uses the
* sum's top 9 bits as the index and returns the high byte of the entry,
* which is the product divided by 256. See #R$2160.
antilog_table:                                             ; >0400
       data >0001,>0001,>0001,>0001,>0001,>0001,>0001,>0001          ; i = 0-7
       data >0001,>0001,>0001,>0001,>0001,>0001,>0001,>0001          ; i = 8-15
       data >0001,>0001,>0001,>0001,>0001,>0001,>0001,>0001          ; i = 16-23
