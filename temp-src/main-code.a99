********************************************************************************
* Fine-grained trig-coefficient table, 0-20 degrees in 0.5-degree steps
* 
* 41 6-byte records (base $121B + index*6, index 0-40), read and copied
* live by #R$21DA (which loads the base with "LD BC,$121B"). Each record is two 24-bit little-endian
* fixed-point values - bytes 0-2 the #R$24D1 "cos" role, bytes 3-5 the
* #R$24A7 "sin" role - in a $400000-scaled (UQ2.22-ish) format: record i
* is (cos(i*0.5 deg)*$400000, sin(i*0.5 deg)*$400000), rounded to the
* nearest integer.
* .
* The table ends at record 40, where a second, coarser table starts
* (#R$1311). Every turn rate #R$21DA is given is within +-40, or 127 for
* the 30-degree record at #R$2522: the player's roll and pitch are limited
* to +-16 (#R$69E5/#R$69F8/#R$69FD/#R$6A10), a ship's turn rate (#R$F806)
* is at most 40 and half that when it turns away (#R$281E), the steering
* limits its rate to 40 (#R$2EB2), the title screen's ship turns by at most
* 18 (#R$1C5C, at $1D7B and $1D83), the space station rolls at 4 (#R$254C)
* and a ship spinning away at 10 (#R$27B3).
trig_table_fine:                                           ; >121b
       byte >00,>00,>40,>00,>00,>00
       byte >61,>FF,>3F,>FA,>8E,>00
       byte >82,>FD,>3F,>F1,>1D,>01
       byte >63,>FA,>3F,>E2,>AC,>01
       byte >06,>F6,>3F,>CB,>3B,>02
       byte >68,>F0,>3F,>A9,>CA,>02
       byte >8D,>E9,>3F,>79,>59,>03
       byte >71,>E1,>3F,>38,>E8,>03
       byte >17,>D8,>3F,>E4,>76,>04
       byte >7F,>CD,>3F,>79,>05,>05
       byte >A8,>C1,>3F,>F6,>93,>05
       byte >93,>B4,>3F,>56,>22,>06
       byte >40,>A6,>3F,>98,>B0,>06
       byte >AF,>96,>3F,>B9,>3E,>07
       byte >E1,>85,>3F,>B5,>CC,>07
       byte >D6,>73,>3F,>8B,>5A,>08
       byte >8E,>60,>3F,>36,>E8,>08
       byte >09,>4C,>3F,>B6,>75,>09
       byte >49,>36,>3F,>06,>03,>0A
       byte >4E,>1F,>3F,>24,>90,>0A
       byte >17,>07,>3F,>0D,>1D,>0B
       byte >A6,>ED,>3E,>BF,>A9,>0B
       byte >FB,>D2,>3E,>37,>36,>0C
       byte >17,>B7,>3E,>72,>C2,>0C
       byte >F9,>99,>3E,>6D,>4E,>0D
       byte >A3,>7B,>3E,>26,>DA,>0D
       byte >15,>5C,>3E,>99,>65,>0E
       byte >4F,>3B,>3E,>C5,>F0,>0E
       byte >54,>19,>3E,>A6,>7B,>0F
       byte >22,>F6,>3D,>3A,>06,>10
       byte >BB,>D1,>3D,>7E,>90,>10
       byte >1F,>AC,>3D,>6F,>1A,>11
       byte >50,>85,>3D,>0B,>A4,>11
       byte >4E,>5D,>3D,>4F,>2D,>12
       byte >19,>34,>3D,>38,>B6,>12
       byte >B3,>09,>3D,>C4,>3E,>13
       byte >1D,>DE,>3C,>EF,>C6,>13
       byte >56,>B1,>3C,>B8,>4E,>14
       byte >61,>83,>3C,>1C,>D6,>14
       byte >3D,>54,>3C,>18,>5D,>15
       byte >ED,>23,>3C,>A9,>E3,>15

********************************************************************************
* Coarse trig-coefficient table, 0-90 degrees in 5-degree steps
* 
* 19 2-byte records (base $1311 + index*2, index 0-18): a plain unsigned
* (cos,sin) byte pair scaled to $80 (half the precision of #R$121B's
* table). Record i is (round(cos(i*5 deg)*$80), round(sin(i*5 deg)*$80));
* the records are palindromic about i=9 ($1323: $5A,$5A, i.e. 45 degrees),
* running from i=0's ($80,$00) at 0 degrees to i=18's ($00,$80) at 90
* degrees. Read as (C,E)=(cos,sin) pairs to draw circles: the planet
* (#R$3D0E), the sun (#R$3DF4) and the fuel-range circle on the local
* chart (#R$5524).
* .
* The table ends cleanly at $1336; #R$1337's "JAMESON" string follows
* immediately, with no gap.
trig_table_coarse:                                         ; >1311
       byte >80,>00
       byte >7F,>0B
       byte >7E,>16
       byte >7B,>21
       byte >78,>2B
       byte >74,>36
       byte >6E,>40
       byte >68,>49
       byte >62,>52
       byte >5A,>5A
       byte >52,>62
       byte >49,>68
       byte >3F,>6E
       byte >36,>74
       byte >2B,>78
       byte >21,>7B
       byte >16,>7E
       byte >0B,>7F
       byte >00,>80

********************************************************************************
* "JAMESON" default-commander-name string
* 
* Elite's traditional default commander name, plain ASCII and
* null-terminated.
* .
* Copied into the commander's name by #R$A433.
jameson_default_commander_name_string:                     ; >1337
       text 'JAMESON',>00

********************************************************************************
* Circle point lists
* 
* Eight lists of the points in one quadrant of a circle, for radii 0, 2, 4,
* ..., 14 pixels. Each list is the number of points, then each point's (x,
* y) offset from the centre; the routines that draw the circles plot each
* point in all four quadrants. Used for the fuel range circle on the
* galactic chart (#R$4DAB), with a radius of the fuel / 10, and for the
* systems on the local chart (#R$5204), with a radius of 2-8.
circle_points:                                             ; >133f
       byte >01                                                      ; radius 0
       byte >00,>00                                                  ; 
circle_points_r2:                                          ; >1342
       byte >04                                                      ; radius 2
       byte >00,>02,>01,>02,>02,>00,>02,>01                          ; 
circle_points_r4:                                          ; >134b
       byte >06                                                      ; radius 4
       byte >00,>04,>01,>04,>02,>02,>02,>03,>03,>00,>03,>01          ; 
circle_points_r6:                                          ; >1358
       byte >09                                                      ; radius 6
       byte >00,>06,>01,>06,>02,>05,>02,>06,>03,>04,>04,>03,>05,>00,>05,>01 ; 
       byte >05,>02                                                  ; 
circle_points_r8:                                          ; >136b
       byte >0C                                                      ; radius 8
       byte >00,>08,>01,>08,>02,>07,>02,>08,>03,>07,>04,>06,>05,>05,>06,>00 ; 
       byte >06,>01,>06,>02,>06,>03,>06,>04                          ; 
circle_points_r10:                                         ; >1384
       byte >0E                                                      ; radius 10
       byte >00,>0A,>01,>0A,>02,>0A,>03,>09,>04,>09,>05,>08,>06,>06,>06,>07 ; 
       byte >07,>04,>07,>05,>08,>00,>08,>01,>08,>02,>08,>03          ; 
circle_points_r12:                                         ; >13a1
       byte >11                                                      ; radius 12
       byte >00,>0C,>01,>0C,>02,>0C,>03,>0B,>04,>0B,>05,>0A,>06,>09,>06,>0A ; 
       byte >07,>08,>08,>06,>08,>07,>09,>04,>09,>05,>0A,>00,>0A,>01,>0A,>02 ; 
       byte >0A,>03                                                  ; 
circle_points_r14:                                         ; >13c4
       byte >14                                                      ; radius 14
       byte >00,>0E,>01,>0E,>02,>0E,>03,>0D,>04,>0D,>05,>0D,>06,>0B,>06,>0C ; 
       byte >07,>0B,>08,>0A,>09,>08,>09,>09,>0A,>04,>0A,>05,>0A,>06,>0A,>07 ; 
       byte >0B,>00,>0B,>01,>0B,>02,>0B,>03                          ; 

********************************************************************************
* Circle point list addresses
* 
* The address of each list in #R$133F, indexed by radius / 2.
circle_point_lists:                                        ; >13ed
       data circle_points                                            ; radius 0
       data circle_points_r2                                         ; radius 2
       data circle_points_r4                                         ; radius 4
       data circle_points_r6                                         ; radius 6
       data circle_points_r8                                         ; radius 8
       data circle_points_r10                                        ; radius 10
       data circle_points_r12                                        ; radius 12
       data circle_points_r14                                        ; radius 14

********************************************************************************
* Main loop: move and draw everything for one frame
* 
* Used by the routine at #R$0106.
* .
* Called by the main loop (#R$0106) once per frame, both in flight and
* while docked (the space view steps are skipped while docked). Moves and
* plots the stardust, then runs each active object in the 20-slot object
* table at $EBA0 through the per-object pipeline, working on a copy of
* its 40-byte record in the workspace at $F7CD. After that come the
* per-frame checks: laser beams, the Torus Jump Drive countdown, the
* dashboard gauges and alerts, hyperspace and docking. Finally copies
* the space view to the screen and waits until 5 VBlank interrupts have
* passed since the previous frame, which caps the frame rate.
process_frame:                                             ; >13fd
       movb @space_view_showing,a                          ; LD A,($E903)      ; A = space view showing?
       socb a,a                                            ; OR A              ; 
       jeq  _1409                                          ; JR Z,$1409        ; no - don't draw it
       .call @clear_space_view                             ; CALL $388F        ; clear the space view's bitmap buffer
       .call @update_stardust                              ; CALL $872E        ; move and plot the stardust
_1409:                                                     ; >1409
       .call @show_countdown                               ; CALL $1651        ; per-frame setup gated by counter $E91B
       .call @settle_roll_pitch                            ; CALL $6BE1        ; stop the roll and pitch if their keys are released
       movb @main_loop_tick_counter,a                      ; LD A,($F746)      ; A = frame counter's low byte
       srl  a,1                                            ; RRA               ; TODO: check code. odd frame?
       jnc  _1437                                          ; JR NC,$1437       ; TODO: check code. no - skip the cloak and jammer checks
       movb @cloaking_active_flag,a                        ; LD A,($EF9F)      ; A = cloaking-device-active flag
       socb a,a                                            ; OR A              ; 
       jeq  _1426                                          ; JR Z,$1426        ; cloak off - check the jammer
       movb one,b                                          ; LD B,$01          ; 
       .call @decay_counter_f817                           ; CALL $19EC        ; drain the energy banks by 1
       li   hl,msg_cloaking_active                         ; LD HL,$1BE7       ; HL = "Cloaking active"
       .call @show_view_message_if_free                    ; CALL $39E9        ; show it unless another message is on screen
_1426:                                                     ; >1426
       movb @jammer_active_flag,a                          ; LD A,($EFA8)      ; A = jammer-active flag
       socb a,a                                            ; OR A              ; 
       jeq  _1437                                          ; JR Z,$1437        ; jammer off
       movb one,b                                          ; LD B,$01          ; 
       .call @decay_counter_f817                           ; CALL $19EC        ; drain the energy banks by 1
       li   hl,msg_jammer_active                           ; LD HL,$1BF6       ; HL = "Jammer active"
       .call @show_view_message_if_free                    ; CALL $39E9        ; show it unless another message is on screen
_1437:                                                     ; >1437
       li   hl,scanner_queue_ready                         ; LD HL,$EB02       ; HL -> the scanner-queue-ready flag
_143a:                                                     ; >143a
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jne  _143a                                          ; JR NZ,$143A       ; wait until #R$8380 has drawn last frame's scanner queue
       movb a,@scanner_queue_count                         ; LD ($E948),A      ; empty the scanner queue: no records...
       movb a,@hostile_about                               ; LD ($E943),A      ; (and clear the HUD warning trigger, see #R$E943)
       li   hl,scanner_queue                               ; LD HL,$E94A       ; 
       mov  hl,@scanner_queue_ptr                          ; LD ($E946),HL     ; ...write pointer back at the start...
       li   hl,>012c                                       ; LD HL,$012C       ; 
       mov  hl,@scanner_background_space                   ; LD ($EB03),HL     ; ...and 300 bytes free for saving the background
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; HL -> the object table
       movb @bytes+>14,b                                   ; LD B,$14          ; B = 20 slots
process_frame_object:                                      ; >1455
       movb *hl,r0                                         ; BIT 0,(HL)        ; is this slot in use?
       andi r0,>0100                                       ;                   
       jne  !                                              ; JP Z,$14AD        ; no - skip it
       b    @process_frame_next_object                     ;                   
!
       movb @bytes+>14,a                                   ; LD A,$14          ; 
       sb   b,a                                            ; SUB B             ; 
       movb a,@current_slot                                ; LD ($E911),A      ; save the slot number (0-19)
       .push bc                                            ; PUSH BC           ; save the slot counter
       .push hl                                            ; PUSH HL           ; save the slot address
       li   de,object_status_byte                          ; LD DE,$F7CD       ; DE -> the object workspace
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the object's 40-byte record into the workspace
       .call @get_blueprint_data                           ; CALL $16E3        ; dispatch by the current ship type
       sb   a,a                                            ; XOR A             ; 
       movb a,@ship_fired                                  ; LD ($E92D),A      ; clear the "position changed" flag
       .call @work_out_distance                            ; CALL $883D        ; work out its distance
       .call @check_collision                              ; CALL $8755        ; ship-type gates and range checks (incl. docking, #R$87DD)
       .call @scanner_add_object                           ; CALL $8205        ; add the object to the scanner
       .call @compass                                      ; CALL $85FB        ; position the compass dot, if this is its target
       .call @move_past_player                             ; CALL $8B00        ; per-ship-type coordinate source
       .call @move_object                                  ; CALL $866D        ; move the object forward
       .call @draw_object                                  ; CALL $422E        ; clear per-object flags; ship-type-gated setup
       .call @run_object_handler                           ; CALL $2528        ; run the object's handler
       .call @laser_hit_check                              ; CALL $28F6        ; gate on the laser having just fired ($F81B/$EF99)
       .call @draw_ship_laser                              ; CALL $43C2        ; skip the rest if nothing has changed
       movb @roll_rate,a                                   ; LD A,($F815)      ; A = roll rate
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; CALL NZ,$22C0     ; rolling - rotate the object's position and axes
       .call @step_roll_rotation                           ;                   
!
       movb @pitch_rate,a                                  ; LD A,($F816)      ; A = pitch rate
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; CALL NZ,$221B     ; pitching - rotate the object's position and axes
       .call @step_pitch_rotation                          ;                   
!
       .call @straighten_orientation                       ; CALL $4503        ; re-orthogonalise the object's axes now and then
       .pop de                                             ; POP DE            ; DE = the slot address
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; HL -> the object workspace
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the updated record back into its slot
       .ex_de_hl                                           ; EX DE,HL          ; HL -> the next slot
       .pop bc                                             ; POP BC            ; restore the slot counter
       jmp  _14b1                                          ; JR $14B1          ; 
process_frame_next_object:                                 ; >14ad
       li   de,>0028                                       ; LD DE,$0028       ; 
       a    de,hl                                          ; ADD HL,DE         ; HL -> the next slot
_14b1:                                                     ; >14b1
       sb   one,b                                          ; DEC B             ; 
       jeq  !                                              ; JP NZ,$1455       ; loop for all 20 slots
       b    @process_frame_object                          ;                   
!
       movb @space_view_showing,a                          ; LD A,($E903)      ; if the space view is showing, let #R$8380 draw this frame's
       movb a,@scanner_queue_ready                         ; LD ($EB02),A      ; scanner queue
       .call @draw_laser_beams                             ; CALL $2DC8        ; draw the laser beams if the laser was just fired
       movb @torus_jump_countdown,a                        ; LD A,($E918)      ; A = Torus jump countdown
       socb a,a                                            ; OR A              ; 
       jeq  _14ea                                          ; JR Z,$14EA        ; no jump in progress
       sb   one,a                                          ; DEC A             ; 
       movb a,@torus_jump_countdown                        ; LD ($E918),A      ; count down one frame
       jne  _14ea                                          ; JR NZ,$14EA       ; jump not over yet
       movb a,@jump_in_progress                            ; LD ($E722),A      ; jump over: clear the jump-in-progress flag
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ; and turn the flight controls back on
       .call @restore_speed                                ; CALL $8B8F        ; restore the speed from before the jump
       .call @random_byte                                  ; CALL $2176        ; the jump may end near a hostile ship:
       movb a,@c                                           ; LD C,A            ; C = random 0-255
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       sb   @bytes+>21,a                                   ; SUB $21           ; 
       jeq  _14e6                                          ; JR Z,$14E6        ; ($E93D)=$21 - A = 0, so almost certainly a hostile
       movb @current_system_government,a                   ; LD A,($F762)      ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; A = ($F762) * 32 (mod 256)
_14e6:                                                     ; >14e6
       cb   a,@c                                           ; CP C              ; random number above A?
       ; CALL C,$2C3C                                      ; CALL C,$2C3C      ; TODO: check code. yes - "Condition RED!" and spawn a hostile ship
_14ea:                                                     ; >14ea
       movb @secondary_flag_counter_pair,a                 ; LD A,($E933)      ; jump being cut short? (($E933), see #R$8B00)
       socb a,a                                            ; OR A              ; 
       jeq  _1503                                          ; JR Z,$1503        ; no
       sb   a,a                                            ; XOR A             ; 
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ; turn the flight controls back on
       movb a,@secondary_flag_counter_pair                 ; LD ($E933),A      ; and this flag
       movb a,@torus_jump_countdown                        ; LD ($E918),A      ; end the jump
       movb a,@jump_in_progress                            ; LD ($E722),A      ; 
       .call @trigger_sfx_6                                ; CALL $16FE        ; beep
       .call @restore_speed                                ; CALL $8B8F        ; restore the speed from before the jump
_1503:                                                     ; >1503
       li   hl,current_turn                                ; LD HL,$E92E       ; cycle the counter at $E92E: 3, 2, 1, 3...
       sb   one,*hl                                        ; DEC (HL)          ; 
       jne  _150b                                          ; JR NZ,$150B       ; 
       movb @bytes+>03,*hl                                 ; LD (HL),$03       ; 
_150b:                                                     ; >150b
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _1517                                          ; JR NZ,$1517       ; drive malfunction - skip the two gauge updates
       .call @check_safe_zone                              ; CALL $1549        ; update the space station safe-zone flag
       .call @update_altitude_and_temperature              ; CALL $1577        ; update the altitude and cabin temperature, fuel scoop
_1517:                                                     ; >1517
       .call @spawn_ships                                  ; CALL $2B05        ; spawn new ships
       .call @set_alert_level                              ; CALL $15E7        ; set the alert level
       .call @check_for_death                              ; CALL $16BA        ; check for death
       .call @hyperspace_jump                              ; CALL $894D        ; hyperspace, if it has been triggered
       .call @ecm_active                                   ; CALL $323C        ; #R$E912 countdown (see #R$323C)
       movb @docking,a                                     ; LD A,($E917)      ; docking?
       socb a,a                                            ; OR A              ; 
       jeq  _1531                                          ; JR Z,$1531        ; no
       .call @dock                                         ; CALL $1873        ; yes - dock
       jmp  _1548                                          ; JR $1548          ; 
_1531:                                                     ; >1531
       .call @recharge                                     ; CALL $18E6        ; cool the laser, charge energy/shields
       movb @space_view_showing,a                          ; LD A,($E903)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _1540                                          ; JR Z,$1540        ; no space view showing
       .call @copy_space_view                              ; CALL $3846        ; copy the space view's bitmap buffer to VRAM
       .call @do_nothing                                   ; CALL $0151        ; (does nothing)
_1540:                                                     ; >1540
       li   hl,vblank_subtick_counter                      ; LD HL,$F748       ; HL -> VBlank count since the last frame
_1543:                                                     ; >1543
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>05                                   ; CP $05            ; 
       jl   _1543                                          ; JR C,$1543        ; wait until it reaches 5
_1548:                                                     ; >1548
       .ret                                                ; RET               ; 

********************************************************************************
* Check for entering the space station's safe zone
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). The ship is in the safe
* zone when it's less than 9000 from the planet ($E727); otherwise $156D
* handles leaving it. On entering, sets #R$EB05 - lighting the "S" on the
* console (#R$6ADC) and turning the compass to the station (#R$85FB) - and
* the first time after arriving in a system ($EF9C, set on launching),
* maybe calls the police (#R$2C21).
* .
* At $156D, the ship is outside the safe zone: if #R$EB05 is set, clears it
* - the compass goes back to the planet (slot 0) - and turns off the "S"
* indicator (#R$6ADC).
check_safe_zone:                                           ; >1549
       mov  @planet_distance,hl                            ; LD HL,($E727)     ; HL = distance from the planet
       li   de,>2328                                       ; LD DE,$2328       ; DE = 9000
       socb a,a                                            ; OR A              ; clear carry ahead of the compare
       s    de,hl                                          ; SBC HL,DE         ; HL - 9000; carry set if inside the safe zone
       li   hl,station_in_range                            ; LD HL,$EB05       ; 
       jnc  station_safe_zone_leave                        ; JR NC,$156D       ; TODO: check code. 9000 or more - outside
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jne  _156b                                          ; JR NZ,$156B       ; already in the safe zone
       movb one,*hl                                        ; LD (HL),$01       ; in the safe zone
       .call @draw_station_indicator                       ; CALL $6ADC        ; light the "S"
       li   hl,safe_zone_entry_latch                       ; LD HL,$EF9C       ; HL -> the one-shot latch
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jne  _156b                                          ; JR NZ,$156B       ; not just arrived
       sb   one,*hl                                        ; DEC (HL)          ; 
       .call @maybe_call_police                            ; CALL $2C21        ; maybe call the police
_156b:                                                     ; >156b
       jmp  _1576                                          ; JR $1576          ; done
station_safe_zone_leave:                                   ; >156d
       movb *hl,a                                          ; LD A,(HL)         ; A = station-in-range flag
       socb a,a                                            ; OR A              ; 
       jeq  _1576                                          ; JR Z,$1576        ; already clear
       sb   *hl,*hl                                        ; LD (HL),$00       ; clear it: compass tracks the planet (slot 0)
       .call @draw_station_indicator                       ; CALL $6ADC        ; turn off the "S" indicator
_1576:                                                     ; >1576
       .ret                                                ; RET               ; 

********************************************************************************
* Update the altitude and cabin temperature gauges, then maybe scoop fuel
* 
* Used by the routine at #R$13FD.
* .
* Quantizes the distance from the planet ($E727, offset +1000) via
* #R$15CB into #R$F812 (the altitude gauge), redrawing it with #R$6AC4
* only when it changes. Does the same for the distance from the sun
* (#R$E725, offset +2048, then negated and rebiased by $18) into #R$F811
* (the cabin temperature gauge, which rises as the sun gets closer),
* redrawn via #R$6AD0. If #R$F811 is then below $15 (21), stops there. Otherwise, only with #R$F77B (the Fuel Scoop, see
* #R$F775's own header for the equipment array) fitted and #R$F814 at
* least $0F: bumps #R$F775 (fuel) up
* by one tenth-of-a-light-year (capped at 70 - a no-op once full),
* redraws the fuel dial (#R$6AAD) and prints "Fuel Scoop Activated"
* ($1B59) - the sun-scooping mechanic, gated on being close enough to
* the sun (#R$F811 high) and going fast enough (speed #R$F814).
update_altitude_and_temperature:                           ; >1577
       mov  @planet_distance,hl                            ; LD HL,($E727)     ; HL = the $E727 magnitude
       li   de,>03e8                                       ; LD DE,$03E8       ; DE = 1000
       a    de,hl                                          ; ADD HL,DE         ; HL = magnitude+1000
       li   bc,>04e0                                       ; LD BC,$04E0       ; BC = #R$15CB's overflow mask/loop-count pair
       li   de,>f000                                       ; LD DE,$F000       ; DE = -4096, #R$15CB's baseline
       .call @distance_to_gauge                            ; CALL $15CB        ; A = the quantized altitude value (0-$18)
       li   hl,altitude_gauge                              ; LD HL,$F812       ; HL -> the altitude gauge
       cb   a,*hl                                          ; CP (HL)           ; changed since last frame?
       movb a,*hl                                          ; LD (HL),A         ; store the new value regardless
       jeq  !                                              ; CALL NZ,$6AC4     ; redraw only if it changed
       .call @draw_altitude                                ;                   
!
       mov  @sun_distance,hl                               ; LD HL,($E725)     ; HL = distance to the sun
       li   bc,>03f0                                       ; LD BC,$03F0       ; BC = #R$15CB's overflow mask/loop-count pair
       li   de,>f800                                       ; LD DE,$F800       ; DE = -2048, #R$15CB's baseline
       .call @distance_to_gauge                            ; CALL $15CB        ; A = the quantized value (0-$18)
       sb   @bytes+>18,a                                   ; SUB $18           ; rebias it...
       neg a                                               ; NEG               ; ...and flip its sense (24 - quantized value)
       li   hl,cabin_temperature                           ; LD HL,$F811       ; HL -> #R$F811's gauge
       cb   a,*hl                                          ; CP (HL)           ; changed since last frame?
       movb a,*hl                                          ; LD (HL),A         ; store the new value regardless
       jeq  !                                              ; CALL NZ,$6AD0     ; redraw only if it changed
       .call @draw_cabin_temperature                       ;                   
!
       movb @cabin_temperature,a                           ; LD A,($F811)      ; A = the (freshly stored) gauge value
       cb   a,@bytes+>15                                   ; CP $15            ; is it below 21?
       jhe  !                                              ; RET C             ; yes - too far/weak a reading, nothing more to do
       .ret                                                ;                   
!
       movb @item_fuel_scoop,a                             ; LD A,($F77B)      ; A = the Fuel Scoop equipment flag
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; not fitted - nothing more to do
       .ret                                                ;                   
!
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = #R$F814 (speed? see #R$6805's hedge)
       cb   a,@bytes+>0f                                   ; CP $0F            ; at least 15?
       jhe  !                                              ; RET C             ; no - too slow, nothing more to do
       .ret                                                ;                   
!
       movb @fuel_level,a                                  ; LD A,($F775)      ; A = the current fuel level
       cb   a,@bytes+>46                                   ; CP $46            ; already at the cap (70)?
       jne  !                                              ; RET Z             ; yes - nothing more to do
       .ret                                                ;                   
!
       ab   one,a                                          ; INC A             ; no - scoop one tenth of a light year
       movb a,@fuel_level                                  ; LD ($F775),A      ; 
       .call @draw_fuel_gauge                              ; CALL $6AAD        ; redraw the fuel dial
       li   hl,msg_fuel_scoop_activated                    ; LD HL,$1B59       ; HL -> "Fuel Scoop Activated"
       b    @show_view_message_if_free                     ; JP $39E9          ; print it

********************************************************************************
* Convert a distance into a dashboard gauge value
* 
* Used by the routine at #R$1577.
* .
* Used by #R$1577 for the altitude and cabin temperature gauges. Returns
* (HL - baseline) * 24 / 2^B / 256, which is 0-24 for a distance from the
* baseline to twice the baseline: 0 for a distance below the baseline (at
* $15D2), and 24 for one with any of C's bits set in its high byte.
* 
* I:B Shift count (so that twice the baseline gives 24)
* I:C Mask for the high byte of a distance that's out of range
* I:DE Baseline (negated)
* I:HL Distance
* O:A The gauge value (0-24)
distance_to_gauge:                                         ; >15cb
       movb h,a                                            ; LD A,H            ; A = the magnitude's high byte
       ; AND C                                             ; AND C             ; TODO: check code. test it against the overflow mask
       jeq  subtract_baseline_then_scale                   ; JR Z,$15D2        ; in range - do the real scaling
       movb @bytes+>18,a                                   ; LD A,$18          ; out of range - clamp to the maximum (24)
       .ret                                                ; RET               ; 
subtract_baseline_then_scale:                              ; >15d2
       a    de,hl                                          ; ADD HL,DE         ; HL -= baseline (DE is the negated baseline)
       joc  scale_remainder_by_1_5                         ; JR C,$15D7        ; TODO: check code. still >= 0 - scale the remainder
       sb   a,a                                            ; XOR A             ; below the baseline - clamp to 0
       .ret                                                ; RET               ; 
scale_remainder_by_1_5:                                    ; >15d7
       a    hl,hl                                          ; ADD HL,HL         ; HL *= 2
       a    hl,hl                                          ; ADD HL,HL         ; HL *= 4
       a    hl,hl                                          ; ADD HL,HL         ; HL *= 8
       movb h,d                                            ; LD D,H            ; DE = HL (the x8 copy)
       movb @l,@e                                          ; LD E,L            ; 
       a    hl,hl                                          ; ADD HL,HL         ; HL *= 16
       a    de,hl                                          ; ADD HL,DE         ; HL = x16 + x8 = x24
       ab   a,a                                            ; ADC A,A           ; fold the x24 multiply's overflow bit into A (was 0)
_15df:                                                     ; >15df
       srl  a,1                                            ; SRL A             ; shift the 17-bit A:H value right...
       sra  h,1                                            ; RR H              ; TODO: check code. ...by one bit, four times (loop below)
       sb   one,b                                          ; DJNZ $15DF        ; four iterations total: >>4 overall
       jne  _15df                                          ;                   
       movb h,a                                            ; LD A,H            ; A = the final scaled/clamped byte
       .ret                                                ; RET               ; 

********************************************************************************
* Set the alert level
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). Works out the alert level
* (#R$E90C), shown on the status page as the condition: 1 if there's a
* hostile ship about (#R$E943); 2 if the energy is low (#R$F817 under 24:
* "Energy Low"), or - outside witchspace (#R$EEC1) - the altitude is low
* (#R$F812 under 4: "Altitude Low") or the cabin is hot (#R$F811 at least
* 16); then checks for "Drive repaired" and the supernova ($162E).
* .
* At $162E, in witchspace (#R$EEC1), shows "Drive repaired" once enough
* ships have been destroyed (#R$EEC2) for hyperspace to work again. At
* $163A, shows "Danger: Supernova" and raises the alert level ($E90C) in
* mission states $22 and $33 (the supernova, see #R$909F).
set_alert_level:                                           ; >15e7
       sb   a,a                                            ; XOR A             ; A = 0
       movb a,@alert_level                                 ; LD ($E90C),A      ; alert level 0
       movb @hostile_about,a                               ; LD A,($E943)      ; any hostile ships about?
       socb a,a                                            ; OR A              ; 
       jeq  _15f6                                          ; JR Z,$15F6        ; no
       movb one,a                                          ; LD A,$01          ; 
       movb a,@alert_level                                 ; LD ($E90C),A      ; alert level 1
_15f6:                                                     ; >15f6
       movb @energy_gauge,a                                ; LD A,($F817)      ; A = energy
       cb   a,@bytes+>18                                   ; CP $18            ; below 24?
       jhe  _1608                                          ; JR NC,$1608       ; not low
       li   hl,msg_energy_low                              ; LD HL,$1B37       ; "Energy Low"
       .call @show_view_message_if_free                    ; CALL $39E9        ; show it
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@alert_level                                 ; LD ($E90C),A      ; alert level 2
_1608:                                                     ; >1608
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; 
       socb a,a                                            ; OR A              ; 
       jne  drive_repaired_supernova_warning               ; JR NZ,$162E       ; in witchspace - no planet or sun
       movb @altitude_gauge,a                              ; LD A,($F812)      ; A = altitude
       cb   a,@bytes+>04                                   ; CP $04            ; below 4?
       jhe  _1620                                          ; JR NC,$1620       ; not low
       li   hl,msg_altitude_low                            ; LD HL,$1B41       ; "Altitude Low"
       .call @show_view_message_if_free                    ; CALL $39E9        ; show it
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@alert_level                                 ; LD ($E90C),A      ; alert level 2
_1620:                                                     ; >1620
       movb @cabin_temperature,a                           ; LD A,($F811)      ; A = cabin temperature
       cb   a,@bytes+>10                                   ; CP $10            ; at least 16?
       jl   _162c                                          ; JR C,$162C        ; not hot
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@alert_level                                 ; LD ($E90C),A      ; alert level 2
_162c:                                                     ; >162c
       jmp  _163a                                          ; JR $163A          ; "Danger: Supernova"?
drive_repaired_supernova_warning:                          ; >162e
       movb @witchspace_kills_needed,a                     ; LD A,($EEC2)      ; A = ships still to kill
       socb a,a                                            ; OR A              ; 
       jne  _163a                                          ; JR NZ,$163A       ; some left
       li   hl,msg_drive_repaired                          ; LD HL,$1BD9       ; "Drive repaired"
       .call @show_view_message_if_free                    ; CALL $39E9        ; print it
_163a:                                                     ; >163a
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>22                                   ; CP $22            ; one supernova-countdown threshold?
       jeq  _1645                                          ; JR Z,$1645        ; 
       cb   a,@bytes+>33                                   ; CP $33            ; the other one?
       jne  _1650                                          ; JR NZ,$1650       ; no supernova
_1645:                                                     ; >1645
       li   hl,msg_danger_supernova                        ; LD HL,$1B86       ; "Danger: Supernova"
       .call @show_view_message_if_free                    ; CALL $39E9        ; print it
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@alert_level                                 ; LD ($E90C),A      ; alert level 2
_1650:                                                     ; >1650
       .ret                                                ; RET               ; 

********************************************************************************
* Show the hyperspace countdown
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). While a hyperspace
* countdown is running (#R$E91B), formats the seconds left into the buffer
* at #R$1B57 (#R$3675), which follows "Countdown:" (#R$1B4D), and shows it:
* over the space view if it's showing (#R$E903), otherwise on the message
* line when the number changes ($1670).
* .
* At $1670, when the number of seconds left (#R$E91B) has changed since
* last time (#R$E91D), clears the message line (#R$3955) and prints
* "Countdown:" and the seconds.
show_countdown:                                            ; >1651
       movb @hyperspace_countdown_inner,a                  ; LD A,($E91B)      ; A = seconds left
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no countdown
       .ret                                                ;                   
!
       li   ix,countdown_digit_buffer                      ; LD IX,$1B57       ; the digits buffer
       movb @hyperspace_countdown_inner,a                  ; LD A,($E91B)      ; 
       movb a,@c                                           ; LD C,A            ; C = seconds left
       sb   a,a                                            ; XOR A             ; 
       s    hl,hl                                          ; SBC HL,HL         ; 
       .call @format_number                                ; CALL $3675        ; format them
       movb @space_view_showing,a                          ; LD A,($E903)      ; A = space view showing?
       socb a,a                                            ; OR A              ; 
       jeq  show_countdown_message_line                    ; JR Z,$1670        ; no space view
       li   hl,msg_countdown                               ; LD HL,$1B4D       ; "Countdown:" and the digits
       b    @show_view_message                             ; JP $39C8          ; show it
show_countdown_message_line:                               ; >1670
       movb @hyperspace_countdown_inner,a                  ; LD A,($E91B)      ; 
       li   hl,countdown_shown                             ; LD HL,$E91D       ; 
       cb   a,*hl                                          ; CP (HL)           ; 
       jne  !                                              ; RET Z             ; not changed
       .ret                                                ;                   
!
       movb a,*hl                                          ; LD (HL),A         ; 
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       li   hl,msg_countdown                               ; LD HL,$1B4D       ; "Countdown:" and the digits
       .halt                                               ; HALT              ; 
       b    @rst_08_target_print_tokenised_string          ; JP $357A          ; print it

********************************************************************************
* Show a message
* 
* Used by the routine at #R$88AC.
* .
* With a space view showing (#R$E903), shows the message at HL over it
* (#R$39C8); otherwise on the message line for a while (#R$3955,
* #R$5FFB).
* 
* I:HL The message
show_message_anywhere:                                     ; >1683
       movb @space_view_showing,a                          ; LD A,($E903)      ; A = space view showing?
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$39C8       ; over the space view
       b    @show_view_message                             ;                   
!
       .push hl                                            ; PUSH HL           ; 
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       .pop hl                                             ; POP HL            ; 
       b    @show_message                                  ; JP $5FFB          ; show it for a while

********************************************************************************
* Key 'C': dock using the docking computer
* 
* Reached via the key table at #R$419B. Beeps unless a docking computer
* is fitted (#R$F77F), the player is in the space station's safe zone
* (#R$EB05) and hasn't shot at the station ($EF97, see #R$291E), and the
* station hasn't been taken over by the Thargoids (mission state $52).
* Does nothing in witchspace (#R$EEC1). Otherwise docks at once (#R$E917).
key_handler_c:                                             ; >1692
       movb @item_docking_computer,a                       ; LD A,($F77F)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$16FE        ; no docking computer
       b    @trigger_sfx_6                                 ;                   
!
       movb @station_in_range,a                            ; LD A,($EB05)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$16FE        ; not in the safe zone
       b    @trigger_sfx_6                                 ;                   
!
       movb @legal_status_copy,a                           ; LD A,($EF97)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$16FE       ; the player has shot at the station
       b    @trigger_sfx_6                                 ;                   
!
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; in witchspace
       .ret                                                ;                   
!
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       cb   a,@bytes+>52                                   ; CP $52            ; 
       jne  !                                              ; JP Z,$16FE        ; the Thargoids' station
       b    @trigger_sfx_6                                 ;                   
!
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@docking                                     ; LD ($E917),A      ; dock
       .ret                                                ; RET               ; 

********************************************************************************
* Check whether the ship has been destroyed, crashed or burned up
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop's per-frame pass (#R$13FD). Ends the
* game (($F749) = $FF, with the cause in ($F74A)) if the altitude gauge
* ($F812) has reached 0 (crashed into the planet: cause 0), the energy
* banks ($F817) are empty (destroyed: cause 1, via $16C9), or the cabin
* temperature ($F811) is at its maximum of 24 (burned up: cause 2, via
* $16D4).
* .
* At $16DE, stores the flag and the cause.
check_for_death:                                           ; >16ba
       mov  @game_over,bc                                  ; LD BC,($F749)     ; BC = current game-over flag and cause
       movb @altitude_gauge,a                              ; LD A,($F812)      ; 
       socb a,a                                            ; OR A              ; 
       jne  check_for_death_energy                         ; JR NZ,$16C9       ; altitude not zero
       li   bc,>00ff                                       ; LD BC,$00FF       ; crashed: cause 0
       jmp  _16de                                          ; JR $16DE          ; 
check_for_death_energy:                                    ; >16c9
       movb @energy_gauge,a                                ; LD A,($F817)      ; 
       socb a,a                                            ; OR A              ; 
       jne  check_for_death_heat                           ; JR NZ,$16D4       ; energy left
       li   bc,>01ff                                       ; LD BC,$01FF       ; destroyed: cause 1
       jmp  _16de                                          ; JR $16DE          ; 
check_for_death_heat:                                      ; >16d4
       movb @cabin_temperature,a                           ; LD A,($F811)      ; 
       cb   a,@bytes+>18                                   ; CP $18            ; 
       jne  _16de                                          ; JR NZ,$16DE       ; not too hot
       li   bc,>02ff                                       ; LD BC,$02FF       ; burned up: cause 2
_16de:                                                     ; >16de
       mov  bc,@game_over                                  ; LD ($F749),BC     ; set the game-over flag and cause
       .ret                                                ; RET               ; 

********************************************************************************
* Get the object's blueprint data
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C and #R$1E5A.
* .
* Copies the 26-byte header of the blueprint for the object's ship type
* ($F7E7), found via the table at #R$A7D7, to $F7F5-$F80E (see #R$A817
* for the layout). Does nothing for ship types $64 and above (the planet
* and the sun), which have no blueprint.
get_blueprint_data:                                        ; >16e3
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = ship type
       cb   a,@bytes+>64                                   ; CP $64            ; 
       jl   !                                              ; RET NC            ; the planet or the sun - no blueprint
       .ret                                                ;                   
!
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; HL = that word index
       li   bc,ship_blueprints                             ; LD BC,$A7D7       ; BC -> the blueprint table
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this ship type's table entry
       movb *hl,a                                          ; LD A,(HL)         ; read the entry (little-endian word)...
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL -> the blueprint header
       li   de,bp_vertices                                 ; LD DE,$F7F5       ; 
       li   bc,>001a                                       ; LD BC,$001A       ; 26 bytes
       .ldir                                               ; LDIR              ; copy the header to $F7F5
       .ret                                                ; RET               ; 

********************************************************************************
* Play the beep (sound effect 6)
* 
* Used by the routines at #R$13FD, #R$1692, #R$19FC, #R$1B13, #R$1B25, #R$2D58,
* #R$2D70, #R$2D7E, #R$3223, #R$329E, #R$5E6B, #R$6393, #R$6DCF, #R$86E6,
* #R$88AC, #R$8926 and #R$A542.
* .
* Used whenever an action is refused (#R$7468, effect 6 is #R$77CA).
trigger_sfx_6:                                             ; >16fe
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       b    @play_sound_effect                             ; JP $7468          ; 

********************************************************************************
* Death scene
* 
* Used by the routine at #R$0106.
* .
* Called by the main loop (#R$0106) when the game is over because the ship
* was destroyed, crashed into the planet or burned up in the sun (($F74A)
* = 0-2, see #R$16BA), but not when the player quit (($F74A) = 3).
* .
* Switches to the front view and clears the object table. Adds four
* pieces of debris ("Platlet", ship type 7) at a distance of 200, each
* at a random orientation, then two explosions (handler type 1, see
* #R$2556) at distances of 250 and 150, and plays sound effect 2
* (the explosion). Then, each frame, runs each object's handler
* and draws it, with "Game Over" underneath (the debris slowing down
* every 4th frame), and gives the space
* view random colours on the first frame (#R$180B). Stops once the last
* explosion's 64-frame countdown has run out and it has been removed.
death_scene:                                               ; >1703
