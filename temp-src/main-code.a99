********************************************************************************
* Equipment item numbers of the four lasers
* 
* Each is also the offset of the laser's entry in the equipment (#R$F775),
* which has a bit for each mount it's fitted to. They're in the order of
* the laser types 0-3 (#R$F818). When a laser is bought, #R$5EFE checks
* the other three for one fitted to the same mount, and removes it.
laser_items:                                               ; >5ac3
       byte >04                                                      ; pulse laser (#R$F779)
       byte >0C                                                      ; mining laser (#R$F781)
       byte >05                                                      ; beam laser (#R$F77A)
       byte >0D                                                      ; military laser (#R$F782)

********************************************************************************
* Ask for a number
* 
* Used by the routine at #R$0030.
* .
* Called via RST $30 (#R$0030), from #R$5BBD and #R$5DD9. Prints " ? " and
* reads up to 4 digits (#R$3631), and works out the number.
* 
* O:F Carry clear if ESC was pressed; otherwise carry set, with zero set
* .if nothing or 0 was typed
* O:HL The number
ask_for_number:                                            ; >5ac7
       li   hl,msg_query                                   ; LD HL,$57E1       ; " ? "
       .rst >08                                            ; RST $08           ; print it
       li   de,>3039                                       ; LD DE,$3039       ; digits only...
       movb @bytes+>04,@c                                  ; LD C,$04          ; ...up to 4 of them
       .call @read_line_keyboard_input                     ; CALL $3631        ; read them into $E8F7
       joc  !                                              ; RET NC            ; TODO: check code. ESC
       .ret                                                ;                   
!
       li   de,keyboard_input_buffer                       ; LD DE,$E8F7       ; DE -> the buffer
       movb *de,a                                          ; LD A,(DE)         ; A = its first byte
       socb a,a                                            ; OR A              ; empty (just Enter, no digits)?
       ; SCF                                               ; SCF               ; TODO: check code. 
       jne  !                                              ; RET Z             ; yes - return with carry and zero both set
       .ret                                                ;                   
!
       li   hl,>0000                                       ; LD HL,$0000       ; HL = the running total
_5ade:                                                     ; >5ade
       movb *de,a                                          ; LD A,(DE)         ; A = the next buffer byte
       socb a,a                                            ; OR A              ; the terminator?
       jeq  tail_set_carry_zero_reflecting_hl              ; JR Z,$5AF4        ; yes - done; go set the return flags
       movb @bytes+>0a,a                                   ; LD A,$0A          ; 
       .push de                                            ; PUSH DE           ; 
       .call @multiply_a_hl_16bit                          ; CALL $1F73        ; HL *= 10
       .pop de                                             ; POP DE            ; 
       movb *de,a                                          ; LD A,(DE)         ; A = the digit character
       sb   @bytes+>30,a                                   ; SUB $30           ; A = its value (0-9)
       inc  de                                             ; INC DE            ; DE -> the next character
       ab   @l,a                                           ; ADD A,L           ; 
       movb a,@l                                           ; LD L,A            ; HL += the digit's value
       jnc  _5af2                                          ; JR NC,$5AF2       ; TODO: check code. 
       ab   one,h                                          ; INC H             ; propagate the carry
_5af2:                                                     ; >5af2
       jmp  _5ade                                          ; JR $5ADE          ; loop for the next character
tail_set_carry_zero_reflecting_hl:                         ; >5af4
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; HL = 0?
       ; SCF                                               ; SCF               ; TODO: check code. carry set
       .ret                                                ; RET               ; 

********************************************************************************
* Show the price and quantity for sale of some goods
* 
* Used by the routines at #R$5BB4 and #R$5BBD.
* .
* Prints the name of goods A on row A + 4, then its price (* 4, in credits
* to one decimal place) and quantity for sale with its units from the
* market (#R$F789) - or "-" (at $5B46) if there are none for sale.
* 
* I:A Goods (0-16)
* O:IX Pointer to its entry in the market
show_market_row:                                           ; >5af8
       movb a,@e                                           ; LD E,A            ; E = the item index
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 
       movb a,@c                                           ; LD C,A            ; C = the row (index+4)
       movb @bytes+>05,b                                   ; LD B,$05          ; B = the column (fixed)
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       movb @e,a                                           ; LD A,E            ; 
       li   hl,msg_food                                    ; LD HL,$0D9F       ; the item-name list
       .rst >10                                            ; RST $10           ; print this item's name
       movb @bytes+>15,a                                   ; LD A,$15          ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; position the cursor for the value column
       movb @e,a                                           ; LD A,E            ; 
       ab   a,a                                            ; ADD A,A           ; *4 (4-byte records)
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,market                                      ; LD HL,$F789       ; the per-item record table
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this item's record
       .push hl                                            ; PUSH HL           ; 
       .push hl                                            ; PUSH HL           ; 
       movb *hl,@l                                         ; LD L,(HL)         ; L = the record's first byte (the value)
       movb b,h                                            ; LD H,B            ; 
       a    hl,hl                                          ; ADD HL,HL         ; *4
       a    hl,hl                                          ; ADD HL,HL         ; 
       movb @l,@c                                          ; LD C,L            ; 
       movb h,@l                                           ; LD L,H            ; 
       movb b,h                                            ; LD H,B            ; 
       movb @bytes+>c5,a                                   ; LD A,$C5          ; control byte: pad to width 5
       .push de                                            ; PUSH DE           ; 
       .rst >18                                            ; RST $18           ; format and print it
       .pop de                                             ; POP DE            ; 
       .pop hl                                             ; POP HL            ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = the record's second byte
       socb a,a                                            ; OR A              ; 
       movb @bytes+>1f,a                                   ; LD A,$1F          ; 
       jne  _5b2c                                          ; JR NZ,$5B2C       ; nonzero - use this cursor position
       ab   one,a                                          ; INC A             ; zero - use the next column instead
_5b2c:                                                     ; >5b2c
       .call @set_cursor_position_combined                 ; CALL $3564        ; position the cursor
       movb *hl,a                                          ; LD A,(HL)         ; A = the record's second byte again
       socb a,a                                            ; OR A              ; 
       jeq  continue_5af8_print_unavailable                ; JR Z,$5B46        ; zero - print "-" (unavailable) instead
       movb a,@c                                           ; LD C,A            ; C = the second byte's value
       .push hl                                            ; PUSH HL           ; 
       li   hl,>0000                                       ; LD HL,$0000       ; 
       movb @bytes+>82,a                                   ; LD A,$82          ; control byte: pad to width 2
       .push de                                            ; PUSH DE           ; 
       .rst >18                                            ; RST $18           ; format and print it
       .pop de                                             ; POP DE            ; 
       .pop hl                                             ; POP HL            ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = the record's third byte
       li   hl,mass_unit_suffix_t                          ; LD HL,$5ABF       ; a unit-string list
       .rst >10                                            ; RST $10           ; print this item's unit string
       jmp  _5b49                                          ; JR $5B49          ; 
continue_5af8_print_unavailable:                           ; >5b46
       movb @bytes+>2d,a                                   ; LD A,$2D          ; '-'
       .rst >00                                            ; RST $00           ; print it
_5b49:                                                     ; >5b49
       movb @e,a                                           ; LD A,E            ; restore the item index
       .pop ix                                             ; POP IX            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Print the name and quantity of some cargo
* 
* Used by the routines at #R$5C8E and #R$5CEE.
* .
* Prints the name of goods B (from $0D9F) at column 5 of row C, and then
* the quantity in the largest unit - grams, kilograms or tonnes - that
* keeps the number under 1000 (dividing by 1000 with #R$211C). At $5B81,
* prints the number (#R$E73E) and the unit (#R$E73D, from $5ABF).
* 
* I:B Goods
* I:C Row
* I:HL:DE Quantity, in grams
print_cargo_quantity:                                      ; >5b4d
       movb b,a                                            ; LD A,B            ; A = the item index
       .push af                                            ; PUSH AF           ; stash it (twice - see below)
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; stash the value
       .push hl                                            ; PUSH HL           ; 
       .push af                                            ; PUSH AF           ; 
       movb @bytes+>05,b                                   ; LD B,$05          ; column 5
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor (row from the caller's C)
       .pop af                                             ; POP AF            ; recover the item index
       li   hl,msg_food                                    ; LD HL,$0D9F       ; the item-name list
       .rst >10                                            ; RST $10           ; print this item's name
       movb @bytes+>12,a                                   ; LD A,$12          ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; position the cursor for the value column
       .pop hl                                             ; POP HL            ; recover the value
       .pop de                                             ; POP DE            ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; up to 2 divisions allowed (millions, then thousands)
_5b66:                                                     ; >5b66
       .push hl                                            ; PUSH HL           ; stash the value (this check mustn't disturb it)
       .push de                                            ; PUSH DE           ; 
       socb a,a                                            ; OR A              ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       li   bc,>03e8                                       ; LD BC,$03E8       ; 1000
       s    bc,hl                                          ; SBC HL,BC         ; is the low word still >= 1000?
       .ex_de_hl                                           ; EX DE,HL          ; 
       li   bc,>0000                                       ; LD BC,$0000       ; 
       s    bc,hl                                          ; SBC HL,BC         ; propagate the borrow into the high word
       .pop de                                             ; POP DE            ; restore the value (the check above was read-only)
       .pop hl                                             ; POP HL            ; 
       joc  continue_5b4d_print_scaled_value               ; JR C,$5B81        ; TODO: check code. already under 1000 - done scaling
       .push af                                            ; PUSH AF           ; 
       .call @divide_by_1000                               ; CALL $211C        ; still >= 1000 - actually divide by 1000
       .pop af                                             ; POP AF            ; 
       sb   one,a                                          ; DEC A             ; one fewer division allowed
       jmp  _5b66                                          ; JR $5B66          ; check again
continue_5b4d_print_scaled_value:                          ; >5b81
       movb a,@remaining_divisions_count                   ; LD ($E73D),A      ; cache the remaining-divisions count
       mov  de,@scaled_cargo_value                         ; LD ($E73E),DE     ; cache the scaled value
       .push af                                            ; PUSH AF           ; 
       movb @e,@c                                          ; LD C,E            ; 
       movb d,@l                                           ; LD L,D            ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>83,a                                   ; LD A,$83          ; control byte: pad to width 3
       .rst >18                                            ; RST $18           ; format and print it
       .pop af                                             ; POP AF            ; 
       li   hl,mass_unit_suffix_t                          ; LD HL,$5ABF       ; the unit-string list
       .rst >10                                            ; RST $10           ; print the matching unit suffix
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; 
       ab   one,@c                                         ; INC C             ; -> the next row
       .ret                                                ; RET               ; 

********************************************************************************
* Key '8': show the market prices
* 
* Reached only via #R$419B's (key code, handler) table - not a literal
* CALL/JP.
* .
* Bails if already showing the prices (#R$E902=2) or if #R$EEC1 is set;
* otherwise hides sprites, draws the frame with the system's name
* (#R$6066), prints the price of each commodity (#R$5BB4) and marks the
* mode.
key_handler_8:                                             ; >5b99
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,@bytes+>02                                   ; CP $02            ; already showing the equipment list?
       jne  !                                              ; RET Z             ; yes - nothing to do
       .ret                                                ;                   
!
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; yes - no market
       .ret                                                ;                   
!
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide sprites
       .call @draw_frame_centred_target_name               ; CALL $6066        ; draw a frame with the current system's name centred
       sb   a,a                                            ; XOR A             ; start at item 0
       .call @print_all_equipment_rows                     ; CALL $5BB4        ; print all 17 rows
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@current_screen                              ; LD ($E902),A      ; mark the mode
       .ret                                                ; RET               ; 

********************************************************************************
* Print the market prices of all 17 commodities
* 
* Used by the routine at #R$5B99.
* .
* I:A The first item index to print (0-based)
print_all_equipment_rows:                                  ; >5bb4
       cb   a,@bytes+>11                                   ; CP $11            ; all 17 done?
       jne  !                                              ; RET Z             ; yes - done
       .ret                                                ;                   
!
       .call @show_market_row                              ; CALL $5AF8        ; no - print this row
       ab   one,a                                          ; INC A             ; next item
       jmp  print_all_equipment_rows                       ; JR $5BB4          ; 

********************************************************************************
* Key '2' when docked: buy cargo
* 
* Used by the routine at #R$417D.
* .
* Reached from #R$417D. Refuses in flight (#R$6393). Goes through the 17
* goods in turn (#R$E73C), showing each one's price and quantity for
* sale (#R$5AF8), and for those on sale asks "Quantity of <goods>" and
* reads a number: ESC stops, 0 or nothing moves on to the next, and
* anything else is bought if possible (#R$5C01) or asked again. Ends on
* the cargo screen (#R$5C8E).
buy_cargo:                                                 ; >5bbd
       .call @refuse_unless_docked                         ; CALL $6393        ; refuse in flight
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide the sprites
       .call @draw_frame_centred_target_name               ; CALL $6066        ; draw a frame with the current system's name centred
       sb   a,a                                            ; XOR A             ; 
       movb a,@equipment_buying_item_index                 ; LD ($E73C),A      ; start with food
_5bca:                                                     ; >5bca
       movb @equipment_buying_item_index,a                 ; LD A,($E73C)      ; A = the current item index
       .call @show_market_row                              ; CALL $5AF8        ; show its price and quantity
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; A = quantity for sale
       socb a,a                                            ; OR A              ; 
       jeq  _5bf5                                          ; JR Z,$5BF5        ; none - next
_5bd6:                                                     ; >5bd6
       li   bc,>0516                                       ; LD BC,$0516       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       li   hl,msg_quantity                                ; LD HL,$56DD       ; "Quantity of "
       .rst >08                                            ; RST $08           ; print it
       movb @equipment_buying_item_index,a                 ; LD A,($E73C)      ; 
       li   hl,msg_food                                    ; LD HL,$0D9F       ; the item-name list
       .rst >10                                            ; RST $10           ; print the goods' name
       .rst >30                                            ; RST $30           ; read a number
       joc  !                                              ; JP NC,$5C8E       ; TODO: check code. ESC - the cargo screen
       b    @show_cargo_manifest_screen                    ;                   
!
       jne  buy_cargo_2                                    ; JR NZ,$5BF0       ; try to buy that many
       ; SCF                                               ; SCF               ; TODO: check code. none - next
       jmp  _5bf3                                          ; JR $5BF3          ; 
buy_cargo_2:                                               ; >5bf0
       .call @buy_goods                                    ; CALL $5C01        ; buy it
_5bf3:                                                     ; >5bf3
       jnc  _5bd6                                          ; JR NC,$5BD6       ; TODO: check code. not bought - ask again
_5bf5:                                                     ; >5bf5
       li   hl,equipment_buying_item_index                 ; LD HL,$E73C       ; 
       ab   one,*hl                                        ; INC (HL)          ; next
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>11                                   ; CP $11            ; 
       jne  _5bca                                          ; JR NZ,$5BCA       ; no - do the next one
       b    @show_cargo_manifest_screen                    ; JP $5C8E          ; all done - the cargo screen

********************************************************************************
* Buy goods
* 
* Used by the routine at #R$5BBD.
* .
* Buys the quantity of the current goods (#R$E73C) entered at #R$5BBD, if
* there are that many for sale ("Insufficient stock!"), the player can
* pay for them ("Insufficient credits!") and there's room for them in
* the hold ("Insufficient cargo space!"). The cost is the price * 4 (in
* tenths of a credit) * the quantity; the room is the quantity * the size
* of a unit (tonne, kilogram or gram, #R$639C) out of the free space
* (#R$63BA).
* .
* At $5C55, takes the quantity off the quantity for sale, adds it to the
* hold (#R$EB19), worsens the legal status if the goods are illegal
* (#R$63AA), takes the cost off the cash and shows the cash and free
* space (#R$612D). At $5C88, shows the message at HL for a while
* (#R$5FFB), keeping the carry flag.
* 
* I:HL Quantity
* I:IX Pointer to the goods' entry in the market (#R$F789)
* O:F Carry set if they were bought
buy_goods:                                                 ; >5c01
       movb h,a                                            ; LD A,H            ; 256 or more?
       socb a,a                                            ; OR A              ; 
       jne  _5c0b                                          ; JR NZ,$5C0B       ; too many
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; A = quantity for sale
       cb   a,@l                                           ; CP L              ; 
       jhe  buy_cargo_check_cash                           ; JR NC,$5C12       ; enough
_5c0b:                                                     ; >5c0b
       li   hl,msg_insufficient_stock                      ; LD HL,$582A       ; "Insufficient stock!"
       socb a,a                                            ; OR A              ; 
       b    @buy_goods_show_message                        ; JP $5C88          ; show it
buy_cargo_check_cash:                                      ; >5c12
       movb @l,a                                           ; LD A,L            ; 
       movb a,@equipment_prerefund_cash_hi_or_qty          ; LD ($E752),A      ; the quantity
       movb *ix,@l                                         ; LD L,(IX+$00)     ; L = price
       a    hl,hl                                          ; ADD HL,HL         ; *4
       a    hl,hl                                          ; ADD HL,HL         ; 
       .call @multiply_a_hl_16bit                          ; CALL $1F73        ; HL = price * 4 * quantity
       .ex_de_hl                                           ; EX DE,HL          ; DE = cost
       mov  @player_cash,hl                                ; LD HL,($EB16)     ; AHL = cash
       movb @cash_2,a                                      ; LD A,($EB18)      ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; cash -= cost
       sb   @zero,a                                        ; SBC A,$00         ; minus the cost
       jnc  buy_cargo_check_space                          ; JR NC,$5C33       ; TODO: check code. enough
       li   hl,msg_insufficient_credits                    ; LD HL,$57E4       ; "Insufficient credits!"
       socb a,a                                            ; OR A              ; 
       b    @buy_goods_show_message                        ; JP $5C88          ; show it
buy_cargo_check_space:                                     ; >5c33
       .push af                                            ; PUSH AF           ; save the cash left
       .push hl                                            ; PUSH HL           ; 
       .call @work_out_free_space                          ; CALL $63BA        ; work out the free space
       movb @>02(ix),a                                     ; LD A,(IX+$02)     ; A = units
       .call @unit_size                                    ; CALL $639C        ; HL -> the size of a unit
       mov  @equipment_prerefund_cash_hi_or_qty,bc         ; LD BC,($E752)     ; BC = quantity
       .call @take_off_free_space                          ; CALL $63E0        ; take their size off the free space
       movb @free_space_hi,a                               ; LD A,($EB64)      ; A = high byte of what's left
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$5C55        ; room for them
       b    @buy_cargo_done                                ;                   
!
       .pop hl                                             ; POP HL            ; no room
       .pop af                                             ; POP AF            ; 
       li   hl,msg_insufficient_cargo_space                ; LD HL,$5811       ; "Insufficient cargo space!"
       socb a,a                                            ; OR A              ; 
       b    @buy_goods_show_message                        ; JP $5C88          ; show it
buy_cargo_done:                                            ; >5c55
       .ex_de_hl                                           ; EX DE,HL          ; DE -> the size of a unit
       movb @equipment_buying_item_index,a                 ; LD A,($E73C)      ; 
       ab   a,a                                            ; ADD A,A           ; *4
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       li   hl,cargo_hold                                  ; LD HL,$EB19       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> the goods in the hold
       .ex_de_hl                                           ; EX DE,HL          ; DE -> the goods in the hold, HL -> the size of a unit
       movb @equipment_prerefund_cash_hi_or_qty,a          ; LD A,($E752)      ; C = quantity
       movb a,@c                                           ; LD C,A            ; 
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; 
       sb   @c,a                                           ; SUB C             ; 
       movb a,@>01(ix)                                     ; LD (IX+$01),A     ; take it off the quantity for sale
_5c6c:                                                     ; >5c6c
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; 
       .call @add_4byte_de_hl                              ; CALL $21C4        ; add a unit to the hold
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       sb   one,@c                                         ; DEC C             ; 
       jne  _5c6c                                          ; JR NZ,$5C6C       ; 
       movb @equipment_prerefund_cash_hi_or_qty,a          ; LD A,($E752)      ; A = the quantity bought
       .call @illegal_goods                                ; CALL $63AA        ; illegal goods worsen the legal status
       .pop hl                                             ; POP HL            ; recover the remaining cash
       .pop af                                             ; POP AF            ; AHL = cash left
       mov  hl,@player_cash                                ; LD ($EB16),HL     ; update the cash total
       movb a,@cash_2                                      ; LD ($EB18),A      ; 
       .call @show_cash_and_space                          ; CALL $612D        ; show the cash and free space
       ; SCF                                               ; SCF               ; TODO: check code. bought
buy_goods_show_message:                                    ; >5c88
       .push af                                            ; PUSH AF           ; preserve the carry (success/failure) flag
       .call @show_message                                 ; CALL $5FFB        ; show the message for a while
       .pop af                                             ; POP AF            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Show the cargo-hold manifest screen
* 
* Used by the routines at #R$5BBD and #R$5CEE.
* .
* Bails if already showing it (#R$E902=5). Otherwise hides sprites,
* draws a frame (RST $28/$20), prints the fuel level and its label
* (#R$6042), the cash total (#R$6037) and a label, and the hold's free
* space and its label (#R$6051), then walks 18 4-byte records from the
* cargo-hold table at #R$EB19 (the same table #R$5C01 updates),
* printing each non-empty one's name and quantity (#R$5B4D - B is the
* item index for the name lookup, and C, fixed at 7 on entry, is the
* print row #R$5B4D itself advances per call). Marks the mode.
show_cargo_manifest_screen:                                ; >5c8e
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,@bytes+>05                                   ; CP $05            ; already showing the manifest?
       jne  !                                              ; RET Z             ; yes - nothing to do
       .ret                                                ;                   
!
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide sprites
       li   ix,inventory_screen_frame                      ; LD IX,$58F8       ; 
       .rst >28                                            ; RST $28           ; draw a frame
       li   hl,inventory_screen_headings                   ; LD HL,$58D7       ; 
       .rst >20                                            ; RST $20           ; print the "Fuel:"/"Cash:"/"Hold:" field list
       li   bc,>0b03                                       ; LD BC,$0B03       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       .call @print_fuel                                   ; CALL $6042        ; print the fuel level and its label
       li   bc,>0b04                                       ; LD BC,$0B04       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       .call @format_print_current_cash_total              ; CALL $6037        ; print the cash total
       li   hl,msg_credits_5851                            ; LD HL,$5851       ; a fixed label
       .rst >08                                            ; RST $08           ; print it
       li   bc,>0b05                                       ; LD BC,$0B05       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       .call @print_free_space                             ; CALL $6051        ; print the hold's free space and its label
       li   hl,msg_tonnes                                  ; LD HL,$583D       ; a fixed label
       .rst >08                                            ; RST $08           ; print it
       li   ix,cargo_hold                                  ; LD IX,$EB19       ; the cargo-hold table
       li   bc,>0007                                       ; LD BC,$0007       ; B = item index (0), C = the print row (7)
_5cca:                                                     ; >5cca
       movb *ix,@e                                         ; LD E,(IX+$00)     ; DE:HL = this item's 4-byte record
       movb @>01(ix),d                                     ; LD D,(IX+$01)     ; 
       movb @>02(ix),@l                                    ; LD L,(IX+$02)     ; 
       movb @>03(ix),h                                     ; LD H,(IX+$03)     ; 
       movb @e,a                                           ; LD A,E            ; 
       socb d,a                                            ; OR D              ; 
       socb @l,a                                           ; OR L              ; 
       socb h,a                                            ; OR H              ; 
       jeq  !                                              ; CALL NZ,$5B4D     ; non-empty - print its name and quantity
       .call @print_cargo_quantity                         ;                   
!
       li   de,>0004                                       ; LD DE,$0004       ; 
       a    de,ix                                          ; ADD IX,DE         ; -> the next record
       ab   one,b                                          ; INC B             ; -> the next item index
       movb b,a                                            ; LD A,B            ; 
       cb   a,@bytes+>12                                   ; CP $12            ; all 18 done?
       jne  _5cca                                          ; JR NZ,$5CCA       ; no - do the next one
       movb @bytes+>05,a                                   ; LD A,$05          ; 
       movb a,@current_screen                              ; LD ($E902),A      ; mark the mode
       .ret                                                ; RET               ; 

********************************************************************************
* Key '3' when docked: sell cargo
* 
* Used by the routine at #R$4187.
* .
* Reached from #R$4187. Refuses in flight (#R$6393). Shows "* No Cargo To
* Sell *" if the hold is empty, otherwise $5D07.
* .
* At $5D07, for each of the goods in the hold, shows how much there is
* (#R$5B4D) and the price it sells for (#R$F789, * 4), and asks "Sell": ESC
* stops, 'Y' sells all of it (#R$5D72). Ends on the cargo screen (#R$5C8E).
sell_cargo:                                                ; >5cee
       .call @refuse_unless_docked                         ; CALL $6393        ; refuse in flight
       li   hl,cargo_hold                                  ; LD HL,$EB19       ; the cargo hold
       sb   a,a                                            ; XOR A             ; 
       movb @bytes+>44,b                                   ; LD B,$44          ; 
_5cf7:                                                     ; >5cf7
       socb *hl,a                                          ; OR (HL)           ; 
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $5CF7        ; 
       jne  _5cf7                                          ;                   
       socb a,a                                            ; OR A              ; 
       jne  sell_cargo_2                                   ; JR NZ,$5D07       ; not empty
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       li   hl,msg_no_cargo_sell                           ; LD HL,$570F       ; "* No Cargo To Sell *"
       b    @show_message                                  ; JP $5FFB          ; show it for a while
sell_cargo_2:                                              ; >5d07
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide sprites
       li   ix,sell_cargo_screen_frame                     ; LD IX,$5939       ; 
       .rst >28                                            ; RST $28           ; draw a frame
       li   hl,sell_cargo_screen_headings                  ; LD HL,$5912       ; 
       .rst >20                                            ; RST $20           ; print the "Product"/"Cargo Price" header list
       li   ix,cargo_hold                                  ; LD IX,$EB19       ; the cargo-hold table
       li   bc,>0005                                       ; LD BC,$0005       ; B = item index (0), C = the print row (5)
_5d1a:                                                     ; >5d1a
       movb *ix,@e                                         ; LD E,(IX+$00)     ; DE:HL = this item's 4-byte record
       movb @>01(ix),d                                     ; LD D,(IX+$01)     ; 
       movb @>02(ix),@l                                    ; LD L,(IX+$02)     ; 
       movb @>03(ix),h                                     ; LD H,(IX+$03)     ; 
       movb @e,a                                           ; LD A,E            ; 
       socb d,a                                            ; OR D              ; 
       socb @l,a                                           ; OR L              ; 
       socb h,a                                            ; OR H              ; 
       jeq  _5d64                                          ; JR Z,$5D64        ; none - next
       .call @print_cargo_quantity                         ; CALL $5B4D        ; show how much there is
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>18,a                                   ; LD A,$18          ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; position the cursor for the sell value
       movb b,a                                            ; LD A,B            ; 
       ab   a,a                                            ; ADD A,A           ; *4 (4-byte records)
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,market                                      ; LD HL,$F789       ; the market
       a    de,hl                                          ; ADD HL,DE         ; HL -> this item's value
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; 
       movb d,h                                            ; LD H,D            ; 
       a    hl,hl                                          ; ADD HL,HL         ; *4
       a    hl,hl                                          ; ADD HL,HL         ; 
       mov  hl,@cached_cargo_sell_value                    ; LD ($E740),HL     ; the price
       movb @l,@c                                          ; LD C,L            ; 
       movb h,@l                                           ; LD L,H            ; 
       movb d,h                                            ; LD H,D            ; 
       movb @bytes+>c5,a                                   ; LD A,$C5          ; control byte: pad to width 5
       .rst >18                                            ; RST $18           ; format and print it
       movb @bytes+>1e,a                                   ; LD A,$1E          ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; position the cursor for the prompt
       li   hl,msg_sell                                    ; LD HL,$5859       ; "Sell"
       .rst >08                                            ; RST $08           ; print it
       .call @confirm_prompt_yn                            ; CALL $3815        ; wait for Y, N or ESC
       .pop bc                                             ; POP BC            ; 
       joc  !                                              ; JP NC,$5C8E       ; TODO: check code. ESC - the cargo screen
       b    @show_cargo_manifest_screen                    ;                   
!
       .push bc                                            ; PUSH BC           ; 
       cb   a,@bytes+>59                                   ; CP $59            ; 'Y'?
       jne  !                                              ; CALL Z,$5D72      ; 'Y' - sell it all
       .call @sell_all                                     ;                   
!
       .pop bc                                             ; POP BC            ; 
_5d64:                                                     ; >5d64
       li   de,>0004                                       ; LD DE,$0004       ; 
       a    de,ix                                          ; ADD IX,DE         ; -> the next record
       ab   one,b                                          ; INC B             ; -> the next item index
       movb b,a                                            ; LD A,B            ; 
       cb   a,@bytes+>11                                   ; CP $11            ; all 17 done?
       jne  _5d1a                                          ; JR NZ,$5D1A       ; no - do the next one
       b    @show_cargo_manifest_screen                    ; JP $5C8E          ; all done - the cargo screen

********************************************************************************
* Sell cargo: sell it all
* 
* Used by the routine at #R$5CEE.
* .
* Pays 19/20 of the price (#R$E740) for each unit held (#R$E73E), and
* takes the units (#R$E73D, #R$639C) out of the hold.
* 
* I:IX Pointer to the goods in the hold (#R$EB19)
sell_all:                                                  ; >5d72
       mov  @cached_cargo_sell_value,hl                    ; LD HL,($E740)     ; HL = price
       movb @bytes+>13,a                                   ; LD A,$13          ; 
       .call @multiply_a_hl_16bit                          ; CALL $1F73        ; * 19
       movb @bytes+>14,a                                   ; LD A,$14          ; 
       .call @divide_hl_a                                  ; CALL $2079        ; / 20
       mov  hl,@per_unit_cargo_payout                      ; LD ($E742),HL     ; 
       mov  @scaled_cargo_value,bc                         ; LD BC,($E73E)     ; BC = quantity
       .push bc                                            ; PUSH BC           ; 
       mov  @per_unit_cargo_payout,de                      ; LD DE,($E742)     ; 
_5d8b:                                                     ; >5d8b
       mov  @player_cash,hl                                ; LD HL,($EB16)     ; add it to the cash
       movb @cash_2,a                                      ; LD A,($EB18)      ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   @zero,a                                        ; ADC A,$00         ; 
       mov  hl,@player_cash                                ; LD ($EB16),HL     ; 
       movb a,@cash_2                                      ; LD ($EB18),A      ; 
       dec  bc                                             ; DEC BC            ; 
       movb b,a                                            ; LD A,B            ; 
       socb @c,a                                           ; OR C              ; 
       jne  _5d8b                                          ; JR NZ,$5D8B       ; for each unit
       movb @remaining_divisions_count,a                   ; LD A,($E73D)      ; A = units
       .call @unit_size                                    ; CALL $639C        ; HL -> the size of a unit
       .pop bc                                             ; POP BC            ; BC = the quantity held again
_5da6:                                                     ; >5da6
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       .push ix                                            ; PUSH IX           ; 
       .pop de                                             ; POP DE            ; 
       .call @subtract_4byte_de_hl                         ; CALL $21CF        ; take it out of the hold
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       dec  bc                                             ; DEC BC            ; 
       movb b,a                                            ; LD A,B            ; 
       socb @c,a                                           ; OR C              ; 
       jne  _5da6                                          ; JR NZ,$5DA6       ; for each unit
       .call @show_cash_and_space                          ; CALL $612D        ; show the cash and free space
       b    @show_message                                  ; JP $5FFB          ; show it for a while

********************************************************************************
* Equip Ship screen
* 
* Used by the routine at #R$4191.
* .
* Reached from #R$4191 (the '4' key) while docked ($E90A set). Hides the
* sprites (#R$608C) and draws the screen's frame (RST $28, from $5A76) and
* headings (RST $20, from $57AA). Then works out how many items of
* equipment are on sale: the number of entries in #R$115C (each item's
* minimum tech level) that are no higher than the system's tech level
* ($F764) - 3 for tech level 0 or 1, then one more per level, up to all 14.
* Falls into $5DD9 with that count.
* .
* At $5DD9, saves the number of items on sale (B) at $E744, then prints one
* line per item from row 3 down: its number, the item's name from #R$0FFC,
* and its price from #R$116B (for fuel, whose table entry is 0, the price
* per light year at ($E724)).
* .
* Then, at $5E1F, prints the prompt (#R$575C) and reads a number (RST $30,
* see #R$5AC7). ESC or an empty or zero entry leaves the screen (#R$6276);
* a number outside 1 to the number of items on sale shows "Invalid item."
* (at $5E63) and asks again. Otherwise it's dispatched by item: 1 (fuel) to
* #R$5E6B, 2 (missiles, at $5E43) to #R$5ED1, and the rest (at $5E4C) to
* #R$5EFE for a laser (its entry in the equipment array at #R$F775 is
* negative) or #R$5EE4 for anything else (at $5E5E). Then it asks again (at
* $5E69).
equip_ship:                                                ; >5dbb
       .call @refuse_unless_docked                         ; CALL $6393        ; refuse in flight
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide sprites
       li   ix,equip_ship_screen_frame                     ; LD IX,$5A76       ; IX -> the screen's frame
       .rst >28                                            ; RST $28           ; draw it
       li   hl,equip_ship_title                            ; LD HL,$57AA       ; HL -> the screen's headings
       .rst >20                                            ; RST $20           ; print them
       sb   b,b                                            ; LD B,$00          ; B = items on sale
       li   hl,equipment_tech_levels                       ; LD HL,$115C       ; HL -> the minimum tech levels
       movb @tech_level,a                                  ; LD A,($F764)      ; A = the system's tech level
_5dd2:                                                     ; >5dd2
       cb   a,*hl                                          ; CP (HL)           ; is the next item's minimum tech level higher?
       jl   equip_ship_list                                ; JR C,$5DD9        ; yes - B items are on sale
       ab   one,b                                          ; INC B             ; no - one more item
       inc  hl                                             ; INC HL            ; 
       jmp  _5dd2                                          ; JR $5DD2          ; 
equip_ship_list:                                           ; >5dd9
       movb b,a                                            ; LD A,B            ; 
       movb a,@equip_items_on_sale                         ; LD ($E744),A      ; save the number of items on sale
       li   ix,equipment_prices                            ; LD IX,$116B       ; IX -> the equipment prices
       movb @bytes+>03,@c                                  ; LD C,$03          ; C = row 3 for the first item
_5de3:                                                     ; >5de3
       .push bc                                            ; PUSH BC           ; save the item count and row
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>05,b                                   ; LD B,$05          ; B = column 5
       .call @set_cursor_position                          ; CALL $3548        ; move the cursor to (row C, column 5)
       .pop bc                                             ; POP BC            ; undo the second save
       sb   one,@c                                         ; DEC C             ; 
       sb   one,@c                                         ; DEC C             ; C = item number (row - 2)
       movb @c,a                                           ; LD A,C            ; 
       .push af                                            ; PUSH AF           ; save it for the RST $10 index below
       li   hl,>0000                                       ; LD HL,$0000       ; the number is in C
       movb @bytes+>82,a                                   ; LD A,$82          ; control byte: pad to width 2
       .rst >18                                            ; RST $18           ; print the item number
       li   hl,msg_decimal_point                           ; LD HL,$5723       ; ". "
       .rst >08                                            ; RST $08           ; print it
       .pop af                                             ; POP AF            ; A = item number
       sb   one,a                                          ; DEC A             ; A = item index (0-13)
       li   hl,msg_fuel                                    ; LD HL,$0FFC       ; HL -> the equipment names
       .rst >10                                            ; RST $10           ; print this item's name
       movb @bytes+>1e,a                                   ; LD A,$1E          ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; move the cursor to the price column
       movb *ix,@c                                         ; LD C,(IX+$00)     ; price, low byte
       movb @>01(ix),@l                                    ; LD L,(IX+$01)     ; price, high byte
       movb @c,a                                           ; LD A,C            ; 
       socb @l,a                                           ; OR L              ; is it 0 (fuel)?
       jne  _5e12                                          ; JR NZ,$5E12       ; no - use it as read
       movb @fuel_price,a                                  ; LD A,($E724)      ; yes - use the price of fuel instead
       movb a,@c                                           ; LD C,A            ; 
_5e12:                                                     ; >5e12
       sb   h,h                                            ; LD H,$00          ; HL = the (possibly substituted) value
       movb @bytes+>c6,a                                   ; LD A,$C6          ; control byte: pad to width 6, decimal-point handling
       .rst >18                                            ; RST $18           ; print the price
       .pop bc                                             ; POP BC            ; restore the item count and row
       inc  ix                                             ; INC IX            ; 
       inc  ix                                             ; INC IX            ; IX -> the next price
       ab   one,@c                                         ; INC C             ; next row
       sb   one,b                                          ; DJNZ $5DE3        ; loop for each item on sale
       jne  _5de3                                          ;                   
_5e1f:                                                     ; >5e1f
       li   hl,msg_item_to_purchase                        ; LD HL,$575C       ; HL -> a positioned-string list
       .rst >20                                            ; RST $20           ; print it
       .rst >30                                            ; RST $30           ; prompt and read a number (see #R$5AC7) - NC on ESC; else HL=the value, Z if it was 0/empty
       joc  !                                              ; JP NC,$6276       ; TODO: check code. ESC - abandon the selection
       b    @status_page                                   ;                   
!
       jne  !                                              ; JP Z,$6276        ; empty input or a typed 0 - same
       b    @status_page                                   ;                   
!
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; value >= 256?
       jne  selector_out_range_cancelled_case_redraw       ; JR NZ,$5E63       ; yes - out of range, redraw and try again
       movb @l,a                                           ; LD A,L            ; 
       socb a,a                                            ; OR A              ; (H=0 and HL<>0 here, so L is never 0 - this never branches)
       jeq  selector_out_range_cancelled_case_redraw       ; JR Z,$5E63        ; (never taken: L can't be 0 here)
       li   hl,equip_items_on_sale                         ; LD HL,$E744       ; HL -> number of items on sale
       cb   a,*hl                                          ; CP (HL)           ; 
       jeq  _5e3a                                          ; JR Z,$5E3A        ; 
       jnc  selector_out_range_cancelled_case_redraw       ; JR NC,$5E63       ; TODO: check code. not on sale here - ask again
_5e3a:                                                     ; >5e3a
       sb   one,a                                          ; DEC A             ; A = selection - 1
       jne  selector_item_2_case_else_fall                 ; JR NZ,$5E43       ; not item 1 - continue down the chain
       .call @equip_buy_fuel                               ; CALL $5E6B        ; item 1 (fuel)
       b    @equip_ship_next                               ; JP $5E69          ; then loop back to *$5E1F
selector_item_2_case_else_fall:                            ; >5e43
       sb   one,a                                          ; DEC A             ; A = selection - 2
       jne  selector_items_3_case_split_n                  ; JR NZ,$5E4C       ; not item 2
       .call @buy_missile                                  ; CALL $5ED1        ; item 2 (missiles)
       b    @equip_ship_next                               ; JP $5E69          ; then loop back to *$5E1F
selector_items_3_case_split_n:                             ; >5e4c
       ab   one,a                                          ; INC A             ; A = selection - 1 (0-based item index)
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,fuel_level                                  ; LD HL,$F775       ; HL -> the equipment
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this item's entry
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; a laser (bit 7)?
       jlt  !                                              ; JP P,$5E5E        ; no
       b    @non_negative_case_call_rejoin_selector        ;                   
!
       .call @buy_laser                                    ; CALL $5EFE        ; yes - buy a laser
       jmp  _5e61                                          ; JR $5E61          ; then loop back to *$5E1F
non_negative_case_call_rejoin_selector:                    ; >5e5e
       .call @buy_other_item                               ; CALL $5EE4        ; buy it
_5e61:                                                     ; >5e61
       jmp  equip_ship_next                                ; JR $5E69          ; loop back to *$5E1F
selector_out_range_cancelled_case_redraw:                  ; >5e63
       li   hl,msg_invalid_item                            ; LD HL,$579D       ; HL -> a fixed string
       .call @show_message                                 ; CALL $5FFB        ; show it for a while
equip_ship_next:                                           ; >5e69
       jmp  _5e1f                                          ; JR $5E1F          ; loop back to *$5E1F

********************************************************************************
* Equip Ship: buy fuel
* 
* Used by the routine at #R$5DBB.
* .
* During mission 3 (#R$E93D = $3x), when the sun is going supernova,
* there's "No fuel available!". Otherwise (at $5E7D), the fuel wanted is
* what it takes to fill the tank to 70 (7.0 light years, #R$F775) - or if
* that's none, "Tank Already Full.".
* .
* At $5E8B, the cost of A tenths of a light year of fuel is A * the fuel
* price (#R$E724) / 10 credits. If the player can pay for it, buys it (at
* $5EBB): takes the cost off the cash, adds the fuel to the tank, and shows
* the cash (#R$6037) and " credits left". Otherwise works out how much the
* cash will buy - (low byte of the cash, #R$EB16) * 10 / fuel price - and
* tries again, which always succeeds (though if that comes to more than
* 255, only the low byte of it is bought).
equip_buy_fuel:                                            ; >5e6b
       movb @mission_state,a                               ; LD A,($E93D)      ; A = the state byte
       andi a,>f000                                        ; AND $F0           ; 
       cb   a,@bytes+>30                                   ; CP $30            ; mission 3?
       jne  buy_fuel                                       ; JR NZ,$5E7D       ; no - buy fuel
       .call @trigger_sfx_6                                ; CALL $16FE        ; beep
       li   hl,msg_no_fuel_available                       ; LD HL,$57B7       ; "No fuel available!"
       b    @show_message                                  ; JP $5FFB          ; show it for a while
buy_fuel:                                                  ; >5e7d
       movb @fuel_level,a                                  ; LD A,($F775)      ; A = the current fuel level
       sb   @bytes+>46,a                                   ; SUB $46           ; 
       neg a                                               ; NEG               ; A = 70 - current level (the deficit to a full tank)
       jne  buy_fuel_2                                     ; JR NZ,$5E8B       ; nonzero - go buy fuel
       li   hl,msg_tank_already_full                       ; LD HL,$5725       ; zero - HL -> "Tank Already Full"
       jmp  _5ecd                                          ; JR $5ECD          ; print it and return
buy_fuel_2:                                                ; >5e8b
       .push af                                            ; PUSH AF           ; save the units wanted this pass
       mov  @fuel_price,de                                 ; LD DE,($E724)     ; DE = the per-unit price (only E is used below)
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = units * price
       movb @l,@c                                          ; LD C,L            ; 
       movb h,@l                                           ; LD L,H            ; 
       sb   h,h                                            ; LD H,$00          ; C:L:H = that product, ready for #R$20C6
       .call @divide_c_l_h_by_10                           ; CALL $20C6        ; strip a decimal place - quotient in C:L:H, remainder (unused) in A
       movb @c,@e                                          ; LD E,C            ; 
       movb @l,d                                           ; LD D,L            ; DE = the whole-credit cost
       mov  @player_cash,hl                                ; LD HL,($EB16)     ; 
       movb @cash_2,a                                      ; LD A,($EB18)      ; HL:A = the cash total
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       sb   @zero,a                                        ; SBC A,$00         ; cash -= cost
       jnc  continuation_commit_fuel_purchase              ; JR NC,$5EBB       ; TODO: check code. affordable - go commit the purchase
       .pop af                                             ; POP AF            ; not affordable - discard the units-wanted value, rebalancing the stack
       movb @player_cash,a                                 ; LD A,($EB16)      ; A = the cash total's low byte alone
       movb @bytes+>0a,@e                                  ; LD E,$0A          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = that low byte * 10
       movb @fuel_price,a                                  ; LD A,($E724)      ; 
       .call @divide_hl_a                                  ; CALL $2079        ; HL = HL / price - a smaller, hopefully-affordable unit count
       movb @l,a                                           ; LD A,L            ; A = that new unit count
       jmp  buy_fuel_2                                     ; JR $5E8B          ; re-price it
continuation_commit_fuel_purchase:                         ; >5ebb
       mov  hl,@player_cash                                ; LD ($EB16),HL     ; commit the new cash total
       movb a,@cash_2                                      ; LD ($EB18),A      ; 
       .pop af                                             ; POP AF            ; A = the unit count that was actually affordable
       li   hl,fuel_level                                  ; LD HL,$F775       ; 
       ab   *hl,a                                          ; ADD A,(HL)        ; 
       movb a,*hl                                          ; LD (HL),A         ; add it to the fuel level
       .call @format_print_current_cash_total              ; CALL $6037        ; refresh the cash readout
       li   hl,msg_credits_left                            ; LD HL,$5803       ; HL -> " credits left"
_5ecd:                                                     ; >5ecd
       .call @show_message                                 ; CALL $5FFB        ; show it for a while
       .ret                                                ; RET               ; 

********************************************************************************
* Equip Ship: buy a missile
* 
* Used by the routine at #R$5DBB.
* .
* Shows "Missile launcher full." if there are 4 missiles already (#R$F776);
* otherwise (at $5EDF) buys one (#R$6002).
buy_missile:                                               ; >5ed1
       li   hl,missile_count                               ; LD HL,$F776       ; HL -> a state byte, adjacent to the $F775 array
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  fallback_buy_item_1_missiles_flat              ; JR NZ,$5EDF       ; not 4
       li   hl,msg_missile_launcher_full                   ; LD HL,$5737       ; 4 - HL -> a fixed string
       b    @show_message                                  ; JP $5FFB          ; show it for a while
fallback_buy_item_1_missiles_flat:                         ; >5edf
       movb one,a                                          ; LD A,$01          ; A = item index 1 - Missiles, by #R$0FFC's order
       b    @buy_equipment                                 ; JP $6002          ; 

********************************************************************************
* Equip Ship: buy an item other than fuel, missiles or a laser
* 
* Used by the routine at #R$5DBB.
* .
* Buys item C (#R$6002), unless it's fitted already, when it shows "Only 1
* <item> allowed" (at $5EEF, with the name from #R$0FFC).
* 
* I:C Item
* I:HL Pointer to its entry in the equipment (#R$F775)
buy_other_item:                                            ; >5ee4
       movb *hl,a                                          ; LD A,(HL)         ; A = the item's $F775 entry again
       socb a,a                                            ; OR A              ; 
       jne  confirm_special_item_purchase                  ; JR NZ,$5EEF       ; nonzero
       .push bc                                            ; PUSH BC           ; 
       movb @c,a                                           ; LD A,C            ; A = the 0-based item index
       .call @buy_equipment                                ; CALL $6002        ; 
       .pop bc                                             ; POP BC            ; 
       .ret                                                ; RET               ; 
confirm_special_item_purchase:                             ; >5eef
       li   hl,msg_only_1                                  ; LD HL,$574D       ; a fixed lead-in message
       .rst >08                                            ; RST $08           ; print it
       movb @c,a                                           ; LD A,C            ; 
       li   hl,msg_fuel                                    ; LD HL,$0FFC       ; the Fuel/Missiles name list
       .rst >10                                            ; RST $10           ; print this item's name
       li   hl,msg_allowed                                 ; LD HL,$5754       ; a fixed trailer message
       b    @show_message                                  ; JP $5FFB          ; show it for a while

********************************************************************************
* Equip Ship: buy a laser
* 
* Used by the routine at #R$5DBB.
* .
* A laser's entry in the equipment (#R$F775) has bit 7 set, and bits 0-3
* for the mounts it's fitted to (front, back, left and right). Shows "All
* lasers mounted." if it's fitted to all four already. Otherwise counts the
* mounts it's fitted to (at $5F0D); if there's only one left (at $5F18),
* that's the one. If not (at $5F28), asks "Position (" with the letters of
* the free mounts from "FBLR" ($57DD) and ") ? " (at $5F3F), and reads a
* letter (#R$3631): ESC or nothing cancels, and a letter that isn't offered
* shows "Invalid position." and asks again.
* .
* At $5F85, a mount can only have one laser: if another type of laser
* (items 4, 12, 5 and 13, from $5AC3) is fitted to it, that one is removed
* and its price refunded (keeping the old values in #R$E74D, #R$E74E and
* #R$E750 in case they need putting back). Then (at $5FD0) buys the laser
* (#R$6002, the item number kept in $F818) and fits it to the mount; if the
* player can't pay for it (at $5FE4), puts back any laser that was removed,
* and the cash.
* 
* I:C Item
* I:HL Pointer to its entry in the equipment (#R$F775)
buy_laser:                                                 ; >5efe
       mov  hl,@equipment_install_flags_ptr                ; LD ($E749),HL     ; cache the entry's address
       andi a,>0f00                                        ; AND $0F           ; 
       cb   a,@bytes+>0f                                   ; CP $0F            ; 
       jne  popcount_a_kernighan                           ; JR NZ,$5F0D       ; not all set
       li   hl,msg_all_lasers_mounted                      ; LD HL,$576F       ; all set - HL -> a fixed string
       b    @show_message                                  ; JP $5FFB          ; show it for a while
popcount_a_kernighan:                                      ; >5f0d
       sb   b,b                                            ; LD B,$00          ; B = 0 (bits counted so far)
_5f0f:                                                     ; >5f0f
       socb a,a                                            ; OR A              ; 
       jeq  single_remaining_slot_or_menu                  ; JR Z,$5F18        ; no bits left - B is the final count
       ab   one,b                                          ; INC B             ; one more set bit
       movb a,@e                                           ; LD E,A            ; 
       sb   one,a                                          ; DEC A             ; 
       ; AND E                                             ; AND E             ; TODO: check code. clear the lowest set bit
       jmp  _5f0f                                          ; JR $5F0F          ; 
single_remaining_slot_or_menu:                             ; >5f18
       movb @c,a                                           ; LD A,C            ; 
       movb a,@view_laser_type                             ; LD ($F818),A      ; keep the item number of the laser being bought
       movb b,a                                            ; LD A,B            ; 
       cb   a,@bytes+>03                                   ; CP $03            ; exactly 3 installed?
       jne  offer_free_slots_menu                          ; JR NZ,$5F28       ; no - offer a menu of the free slots
       movb *hl,a                                          ; LD A,(HL)         ; yes: find the one bit that's still clear
       inv  a                                              ; CPL               ; 
       andi a,>0f00                                        ; AND $0F           ; 
       movb a,@c                                           ; LD C,A            ; 
       jmp  auto_sell_conflict_buy_install                 ; JR $5F85          ; install it directly
offer_free_slots_menu:                                     ; >5f28
       movb *hl,@c                                         ; LD C,(HL)         ; C = the original flags byte
       movb @bytes+>04,a                                   ; LD A,$04          ; 
       sb   b,a                                            ; SUB B             ; B = 4 - (installed count) = free-slot count
       movb a,b                                            ; LD B,A            ; 
_5f2d:                                                     ; >5f2d
       .push bc                                            ; PUSH BC           ; stash the flags byte and free-slot count
       li   hl,msg_position                                ; LD HL,$5782       ; a header message
       .rst >08                                            ; RST $08           ; print it
       li   hl,msg_fblr                                    ; LD HL,$57DD       ; the 4-letter option array
       li   de,offered_mount_letters                       ; LD DE,$E745       ; the buffer of offered letters
_5f38:                                                     ; >5f38
       ; RR C                                              ; RR C              ; TODO: check code. test the next bit
       jnc  continue_5f28_offer_letter_read_choice         ; JR NC,$5F3F       ; TODO: check code. clear (not installed) - offer it
       inc  hl                                             ; INC HL            ; set (already installed) - skip its letter
       jmp  _5f38                                          ; JR $5F38          ; test the next bit
continue_5f28_offer_letter_read_choice:                    ; >5f3f
       movb *hl,a                                          ; LD A,(HL)         ; A = this slot's letter
       inc  hl                                             ; INC HL            ; 
       movb a,*de                                          ; LD (DE),A         ; record it as offered
       inc  de                                             ; INC DE            ; 
       .rst >00                                            ; RST $00           ; print it
       movb b,a                                            ; LD A,B            ; the last one to offer?
       sb   one,a                                          ; DEC A             ; 
       movb @bytes+>2c,a                                   ; LD A,$2C          ; ','
       jne  _5f4c                                          ; JR NZ,$5F4C       ; no - separate with a comma
       movb @bytes+>29,a                                   ; LD A,$29          ; ')' - yes, close the list
_5f4c:                                                     ; >5f4c
       .rst >00                                            ; RST $00           ; print the separator/closer
       sb   one,b                                          ; DJNZ $5F38        ; more free slots to offer
       jne  _5f38                                          ;                   
       li   hl,msg_query                                   ; LD HL,$57E1       ; a prompt message
       .rst >08                                            ; RST $08           ; print it
       li   de,>415a                                       ; LD DE,$415A       ; accepted character-code range
       movb @bytes+>05,@c                                  ; LD C,$05          ; up to 5 characters
       .call @read_line_keyboard_input                     ; CALL $3631        ; read a line of keyboard input
       .pop bc                                             ; POP BC            ; recover the flags byte and free-slot count
       joc  !                                              ; RET NC            ; TODO: check code. Esc - cancel
       .ret                                                ;                   
!
       movb @keyboard_input_buffer,a                       ; LD A,($E8F7)      ; A = the typed character
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; empty - cancel
       .ret                                                ;                   
!
       .push bc                                            ; PUSH BC           ; 
       li   hl,offered_mount_letters                       ; LD HL,$E745       ; the offered-letters buffer
       movb b,@c                                           ; LD C,B            ; C = how many were offered
       sb   b,b                                            ; LD B,$00          ; 
       ; CPIR                                              ; CPIR              ; TODO: check code. search for the typed letter
       jeq  _5f75                                          ; JR Z,$5F75        ; found - use it
       .push af                                            ; PUSH AF           ; not found - report and re-offer
       li   hl,msg_invalid_position                        ; LD HL,$578C       ; the "invalid"-style message
       .call @show_message                                 ; CALL $5FFB        ; show it for a while
       .pop af                                             ; POP AF            ; 
_5f75:                                                     ; >5f75
       .pop bc                                             ; POP BC            ; recover the flags byte and free-slot count
       jne  _5f2d                                          ; JR NZ,$5F2D       ; no match - re-offer the menu
       li   hl,msg_fblr                                    ; LD HL,$57DD       ; matched: find which bit this letter is
       movb one,@c                                         ; LD C,$01          ; C = the bitmask, starting at bit 0
_5f7d:                                                     ; >5f7d
       cb   a,*hl                                          ; CP (HL)           ; this slot's letter?
       jeq  auto_sell_conflict_buy_install                 ; JR Z,$5F85        ; yes - C is the matching bitmask
       inc  hl                                             ; INC HL            ; no - try the next slot
       ; SLA C                                             ; SLA C             ; TODO: check code. 
       jmp  _5f7d                                          ; JR $5F7D          ; 
auto_sell_conflict_buy_install:                            ; >5f85
       li   hl,laser_items                                 ; LD HL,$5AC3       ; the four lasers' item numbers
       sb   a,a                                            ; XOR A             ; 
       movb a,@equipment_prerefund_flag                    ; LD ($E74D),A      ; no laser removed yet
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 lasers
_5f8e:                                                     ; >5f8e
       movb @view_laser_type,a                             ; LD A,($F818)      ; A = the laser being bought
       cb   a,*hl                                          ; CP (HL)           ; is it this one?
       jeq  _5fcd                                          ; JR Z,$5FCD        ; yes - skip it
       .push hl                                            ; PUSH HL           ; 
       movb *hl,@e                                         ; LD E,(HL)         ; DE = the other laser's item number
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,fuel_level                                  ; LD HL,$F775       ; 
       a    de,hl                                          ; ADD HL,DE         ; HL -> its entry in the equipment
       movb *hl,a                                          ; LD A,(HL)         ; 
       ; AND C                                             ; AND C             ; TODO: check code. is it fitted to this mount?
       jeq  continue_5f85_buy_install_or_rollback          ; JR Z,$5FCC        ; no - try the next laser
       mov  hl,@equipment_conflict_flags_ptr               ; LD ($E74E),HL     ; yes: remember the entry's address...
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@equipment_prerefund_flag                    ; LD ($E74D),A      ; ...and its old value, in case they need putting back
       movb @c,a                                           ; LD A,C            ; 
       inv  a                                              ; CPL               ; 
       ; AND (HL)                                          ; AND (HL)          ; TODO: check code. remove it from the mount
       movb a,*hl                                          ; LD (HL),A         ; 
_5fab:                                                     ; >5fab
       li   hl,equipment_prices                            ; LD HL,$116B       ; its price
       a    de,hl                                          ; ADD HL,DE         ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       movb *hl,@e                                         ; LD E,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       mov  @player_cash,hl                                ; LD HL,($EB16)     ; remember the cash, in case it needs putting back
       movb @cash_2,a                                      ; LD A,($EB18)      ; 
       mov  hl,@equipment_prerefund_cash_lo                ; LD ($E750),HL     ; 
       movb a,@equipment_prerefund_cash_hi_or_qty          ; LD ($E752),A      ; 
       a    de,hl                                          ; ADD HL,DE         ; refund the removed laser's price
       ab   @zero,a                                        ; ADC A,$00         ; 
       mov  hl,@player_cash                                ; LD ($EB16),HL     ; 
       movb a,@cash_2                                      ; LD ($EB18),A      ; 
       .pop hl                                             ; POP HL            ; 
       b    @buy_laser_install                             ; JP $5FD0          ; buy and fit the new laser
continue_5f85_buy_install_or_rollback:                     ; >5fcc
       .pop hl                                             ; POP HL            ; 
_5fcd:                                                     ; >5fcd
       inc  hl                                             ; INC HL            ; the next laser
       sb   one,b                                          ; DJNZ $5F8E        ; 
       jne  _5f8e                                          ;                   
buy_laser_install:                                         ; >5fd0
       mov  @equipment_install_flags_ptr,hl                ; LD HL,($E749)     ; HL -> the new laser's entry in the equipment
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @view_laser_type,a                             ; LD A,($F818)      ; A = its item number
       .call @buy_equipment                                ; CALL $6002        ; buy it
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       joc  rollback_conflict_refund_on_failure            ; JR C,$5FE4        ; TODO: check code. can't pay for it
       movb *hl,a                                          ; LD A,(HL)         ; fit it to the mount
       socb @c,a                                           ; OR C              ; 
       movb a,*hl                                          ; LD (HL),A         ; 
       jmp  _5ffa                                          ; JR $5FFA          ; 
rollback_conflict_refund_on_failure:                       ; >5fe4
       movb @equipment_prerefund_flag,a                    ; LD A,($E74D)      ; A = the removed laser's old entry
       socb a,a                                            ; OR A              ; 
       jeq  _5ffa                                          ; JR Z,$5FFA        ; no laser was removed
       mov  @equipment_conflict_flags_ptr,hl               ; LD HL,($E74E)     ; put the removed laser back
       movb a,*hl                                          ; LD (HL),A         ; 
       mov  @equipment_prerefund_cash_lo,hl                ; LD HL,($E750)     ; and the cash
       movb @equipment_prerefund_cash_hi_or_qty,a          ; LD A,($E752)      ; 
       mov  hl,@player_cash                                ; LD ($EB16),HL     ; 
       movb a,@cash_2                                      ; LD ($EB18),A      ; 
_5ffa:                                                     ; >5ffa
       .ret                                                ; RET               ; 

********************************************************************************
* Show a message for a while
* 
* Used by the routines at #R$1683, #R$5C01, #R$5CEE, #R$5D72, #R$5DBB, #R$5E6B,
* #R$5ED1, #R$5EE4, #R$5EFE, #R$6002, #R$6DCF, #R$A377, #R$A3C7 and #R$A542.
* .
* Prints the message at HL (RST $08), waits (#R$3808), and clears the
* message line again (#R$3955).
* 
* I:HL The message
show_message:                                              ; >5ffb
       .rst >08                                            ; RST $08           ; 
       .call @busy_wait_delay                              ; CALL $3808        ; 
       b    @clear_message_line                            ; JP $3955          ; clear the message line

********************************************************************************
* Equip Ship: buy an item
* 
* Used by the routines at #R$5ED1, #R$5EE4 and #R$5EFE.
* .
* Buys item A for its price (#R$116B): "Insufficient credits!" if the
* player can't pay for it, otherwise $601E.
* .
* At $601E, pays for the item, adds 1 to its entry in the equipment (fitting
* it, or adding a missile) unless it's a laser, whose mount the caller fits,
* and shows the cash left. The entry at
* $6031 shows the message at HL for a while (#R$5FFB), keeping the carry
* flag.
* 
* I:A Item (see #R$0FFC)
* I:HL Pointer to the item's entry in the equipment (#R$F775)
* O:F Carry clear if it was bought
buy_equipment:                                             ; >6002
       .exx                                                ; EXX               ; shield the caller's BC/DE/HL
_6003:                                                     ; >6003
       li   hl,equipment_prices                            ; LD HL,$116B       ; HL -> #R$116B
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; BC = the item's byte offset (index * 2)
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this item's price record
       movb *hl,@e                                         ; LD E,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; DE = the price
       mov  @player_cash,hl                                ; LD HL,($EB16)     ; 
       movb @cash_2,a                                      ; LD A,($EB18)      ; HL:A = the current cash total
       s    de,hl                                          ; SBC HL,DE         ; 
       sb   b,a                                            ; SBC A,B           ; cash -= price (B=0 here)
       jnc  buy_equipment_2                                ; JR NC,$601E       ; TODO: check code. enough cash - go commit the purchase
       li   hl,msg_insufficient_credits                    ; LD HL,$57E4       ; not enough - HL -> "Insufficient credits"
       jmp  _6031                                          ; JR $6031          ; go print it and return
buy_equipment_2:                                           ; >601e
       mov  hl,@player_cash                                ; LD ($EB16),HL     ; commit the new cash total
       movb a,@cash_2                                      ; LD ($EB18),A      ; 
       .exx                                                ; EXX               ; restore the caller's own BC/DE/HL
       movb *hl,r0                                         ; BIT 7,(HL)        ; a laser?
       andi r0,>8000                                       ;                   
       jne  _602a                                          ; JR NZ,$602A       ; yes - the caller fits it
       ab   one,*hl                                        ; INC (HL)          ; no - fit it, or add a missile
_602a:                                                     ; >602a
       .call @format_print_current_cash_total              ; CALL $6037        ; refresh the cash readout
       li   hl,msg_credits_left                            ; LD HL,$5803       ; HL -> " credits left"
       socb a,a                                            ; OR A              ; clear carry - success
_6031:                                                     ; >6031
       .push af                                            ; PUSH AF           ; 
       .call @show_message                                 ; CALL $5FFB        ; show it for a while
       .pop af                                             ; POP AF            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Format and print the current cash total
* 
* Used by the routines at #R$5C8E, #R$5E6B, #R$6002, #R$612D and #R$6276.
* .
* Reassembles the 24-bit cash total from $EB16 (low byte, via A/C),
* $EB17/$EB18 (the upper 16 bits, loaded together as HL) and prints it
* via RST $18 with format byte $40.
format_print_current_cash_total:                           ; >6037
       movb @player_cash,a                                 ; LD A,($EB16)      ; A = the cash total's low byte
       mov  @cash_1,hl                                     ; LD HL,($EB17)     ; HL = its upper 16 bits
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; control byte: decimal-point handling, no width padding
       .rst >18                                            ; RST $18           ; format and print the cash total
       .ret                                                ; RET               ; 

********************************************************************************
* Print the fuel level, then a fixed label
* 
* Used by the routines at #R$5C8E and #R$6276.
print_fuel:                                                ; >6042
       movb @fuel_level,a                                  ; LD A,($F775)      ; A = the fuel level
       movb a,@c                                           ; LD C,A            ; 
       li   hl,>0000                                       ; LD HL,$0000       ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; control byte: pad to width 0, decimal-point handling
       .rst >18                                            ; RST $18           ; format and print it
       li   hl,msg_light_years_5845                        ; LD HL,$5845       ; a fixed label
       .rst >08                                            ; RST $08           ; print it
       .ret                                                ; RET               ; 

********************************************************************************
* Print the free space in the hold
* 
* Used by the routines at #R$5C8E and #R$612D.
* .
* Works out the free space in the hold (#R$63BA), and prints it in tonnes
* to one decimal place (grams / 100000, #R$20E1).
print_free_space:                                          ; >6051
       .call @work_out_free_space                          ; CALL $63BA        ; work out the free space
       mov  @free_space,de                                 ; LD DE,($EB61)     ; HL:DE = the free space in grams
       mov  @free_hold_space_2,hl                          ; LD HL,($EB63)     ; 
       .call @divide_by_100000                             ; CALL $20E1        ; / 100000: tenths of a tonne
       movb @e,@c                                          ; LD C,E            ; 
       movb d,@l                                           ; LD L,D            ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; with a decimal point
       .rst >18                                            ; RST $18           ; print it
       .ret                                                ; RET               ; 

********************************************************************************
* Show the market screen's title
* 
* Used by the routines at #R$5B99 and #R$5BBD.
* .
* Generates the current system's name (#R$4CAF) and prints it followed by
* " Market Prices" ($56CF), centred on text row 1 (#R$E710, #R$3564), then
* draws the frame and column headings (RST $28/$20).
draw_frame_centred_target_name:                            ; >6066
       movb one,a                                          ; LD A,$01          ; 
       movb a,@cursor_vram_addr_row                        ; LD ($E710),A      ; text row 1
       movb @current_system,a                              ; LD A,($EB67)      ; the current system
       .call @generate_system_name                         ; CALL $4CAF        ; generate and format its name
       sb   @bytes+>1c,a                                   ; SUB $1C           ; compute a centering column from the character count
       neg a                                               ; NEG               ; 
       srl  a,1                                            ; SRL A             ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; position the cursor there
       li   hl,text_buffer                                 ; LD HL,$E717       ; the generated name
       .rst >08                                            ; RST $08           ; print it
       li   hl,msg_market_prices                           ; LD HL,$56CF       ; a fixed suffix
       .rst >08                                            ; RST $08           ; print it
       li   ix,market_screen_frame                         ; LD IX,$58BD       ; 
       .rst >28                                            ; RST $28           ; draw a frame
       li   hl,market_screen_headings                      ; LD HL,$588F       ; 
       .rst >20                                            ; RST $20           ; print the "Price   For Sale" header list
       .ret                                                ; RET               ; 

********************************************************************************
* Hide the sprites and clear the page
* 
* Used by the routines at #R$4D0B, #R$4F64, #R$5B99, #R$5BBD, #R$5C8E, #R$5CEE,
* #R$5DBB, #R$6164, #R$6276, #R$90D3 and #R$A30A.
* .
* Used before showing one of the text pages. If the space view is showing
* (#R$E903), leaves it (#R$60B1), hiding all 32 sprites. Otherwise (at
* $6097), if the chart cursor is on (#R$E70B), turns it off and hides the
* first 5 sprites; then clears the page (#R$60CA) and the message line
* (#R$3955).
hide_sprites_clear_page:                                   ; >608c
       movb @space_view_showing,a                          ; LD A,($E903)      ; space view showing?
       socb a,a                                            ; OR A              ; 
       jeq  hide_few_sprites                               ; JR Z,$6097        ; no
       .call @hide_all_sprites                             ; CALL $60B1        ; yes: leave it (#R$60B1)
       jmp  _60b0                                          ; JR $60B0          ; 
hide_few_sprites:                                          ; >6097
       li   hl,chart_cursor_active_flag                    ; LD HL,$E70B       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; chart cursor on?
       jeq  _60aa                                          ; JR Z,$60AA        ; no
       sb   *hl,*hl                                        ; LD (HL),$00       ; turn it off
       li   hl,>1b00                                       ; LD HL,$1B00       ; 
       movb @bytes+>05,b                                   ; LD B,$05          ; 
       limi 0                                              ; DI                ; 
       .call @hide_sprites                                 ; CALL $3942        ; hide sprites 0-4 (#R$3942)
       ; EI                                                ; EI                ; TODO: check code. 
_60aa:                                                     ; >60aa
       .call @clear_page                                   ; CALL $60CA        ; clear the page (#R$60CA)
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
_60b0:                                                     ; >60b0
       .ret                                                ; RET               ; 

********************************************************************************
* Hide all the sprites and leave the space view
* 
* Used by the routine at #R$608C.
* .
* Resets $EB02 (the scanner-queue-ready flag #R$8380 checks),
* hides all 32 sprites via #R$3942, calls #R$70E8, clears the message
* line (#R$3955),
* then clears #R$E903 - the space view is no longer showing.
hide_all_sprites:                                          ; >60b1
       sb   a,a                                            ; XOR A             ; 
       movb a,@scanner_queue_ready                         ; LD ($EB02),A      ; no scanner to erase (#R$EB02)
       movb @bytes+>20,b                                   ; LD B,$20          ; 32 sprites
       li   hl,>1b00                                       ; LD HL,$1B00       ; 
       limi 0                                              ; DI                ; 
       .call @hide_sprites                                 ; CALL $3942        ; hide them (#R$3942)
       ; EI                                                ; EI                ; TODO: check code. 
       .call @clear_screen_draw_frame                      ; CALL $70E8        ; clear the screen and draw its frame (#R$70E8)
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       sb   a,a                                            ; XOR A             ; 
       movb a,@space_view_showing                          ; LD ($E903),A      ; the space view isn't showing
       .ret                                                ; RET               ; 

********************************************************************************
* Clear the page
* 
* Used by the routine at #R$608C.
* .
* Clears the page area of a text screen - character rows 1-20, columns 3-28
* (#R$35B8) - with white on black, and sets the current screen (#R$E902) to 0.
clear_page:                                                ; >60ca
       sb   a,a                                            ; XOR A             ; 
       movb a,@current_screen                              ; LD ($E902),A      ; the current screen
       li   hl,>0118                                       ; LD HL,$0118       ; HL = $0118: the pattern table at row 1, column 3
       li   bc,>a01a                                       ; LD BC,$A01A       ; 160 pixel rows (20 character rows), 26 characters
       sb   a,a                                            ; XOR A             ; 
       .call @fill_vram_rect                               ; CALL $35B8        ; clear the patterns (#R$35B8)
       li   hl,>2118                                       ; LD HL,$2118       ; HL = $2118: the colours
       li   bc,>a01a                                       ; LD BC,$A01A       ; 
       movb @bytes+>f1,a                                   ; LD A,$F1          ; white on black
       b    @fill_vram_rect                                ; JP $35B8          ; 

********************************************************************************
* Show the Data on System screen: the inhabitants
* 
* Used by the routine at #R$6164.
* .
* Part of #R$6189. Prints "(" and then, as BBC Elite does, "Human
* Colonial)" (#R$0E81) if bit 7 of the seed s2_lo (#R$F74F) is clear;
* otherwise a description of the inhabitants ($60F8).
* .
* At $60F8, as BBC Elite does, builds the species from up to four words,
* picked by bits of the seeds s2_hi (#R$F750), s1_hi (#R$F74E) and s0_hi
* (#R$F74C) from the lists at $0E91, $0EA9, $0ECF and $0EF6, and then
* prints the closing ")".
show_inhabitants:                                          ; >60e3
       li   bc,>050a                                       ; LD BC,$050A       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       movb @bytes+>28,a                                   ; LD A,$28          ; '('
       .rst >00                                            ; RST $00           ; print it
       movb @system_s2_lo,a                                ; LD A,($F74F)      ; A = s2_lo
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$60F8        ; bit 7 set - describe them
       b    @build_object_description_words                ;                   
!
       li   hl,msg_human_colonial                          ; LD HL,$0E81       ; "Human Colonial)"
       .rst >08                                            ; RST $08           ; print it
       .ret                                                ; RET               ; 
build_object_description_words:                            ; >60f8
       movb @system_s2_hi,a                                ; LD A,($F750)      ; s2_hi
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       .push af                                            ; PUSH AF           ; 
       andi a,>0700                                        ; AND $07           ; bits 2-4
       li   hl,msg_large                                   ; LD HL,$0E91       ; 
       .rst >10                                            ; RST $10           ; print the first word
       .pop af                                             ; POP AF            ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>0700                                        ; AND $07           ; bits 5-7
       li   hl,msg_green                                   ; LD HL,$0EA9       ; 
       .rst >10                                            ; RST $10           ; print the second word
       movb @system_s1_hi,a                                ; LD A,($F74E)      ; s1_hi
       li   hl,system_s0_hi                                ; LD HL,$F74C       ; 
       ; XOR (HL)                                          ; XOR (HL)          ; TODO: check code. XOR s0_hi
       andi a,>0700                                        ; AND $07           ; bits 0-2
       .push af                                            ; PUSH AF           ; 
       li   hl,msg_slimy                                   ; LD HL,$0ECF       ; 
       .rst >10                                            ; RST $10           ; print the third word
       movb @system_s2_hi,a                                ; LD A,($F750)      ; s2_hi
       andi a,>0300                                        ; AND $03           ; bits 0-1
       .pop bc                                             ; POP BC            ; 
       ab   b,a                                            ; ADD A,B           ; + the third word's number
       andi a,>0700                                        ; AND $07           ; 
       li   hl,msg_rodent                                  ; LD HL,$0EF6       ; 
       .rst >10                                            ; RST $10           ; print the fourth word
       movb @bytes+>29,a                                   ; LD A,$29          ; ')'
       .rst >00                                            ; RST $00           ; print it
       .ret                                                ; RET               ; 

********************************************************************************
* Show the cash and the free space in the hold
* 
* Used by the routines at #R$5C01 and #R$5D72.
* .
* Prints "<cash> credits, <free space>" on the message line, and returns
* with HL pointing at " tonnes." for the caller to finish the message with
* (#R$5FFB).
* 
* O:HL " tonnes." (#R$583D)
show_cash_and_space:                                       ; >612d
       li   bc,>0516                                       ; LD BC,$0516       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor on the message line
       .call @format_print_current_cash_total              ; CALL $6037        ; print the cash total
       li   hl,msg_credits_57f9                            ; LD HL,$57F9       ; " credits, "
       .rst >08                                            ; RST $08           ; print it
       .call @print_free_space                             ; CALL $6051        ; print the free space
       li   hl,msg_tonnes                                  ; LD HL,$583D       ; " tonnes." (the caller prints it)
       .ret                                                ; RET               ; 

********************************************************************************
* Distance to the selected system
* 
* Used by the routines at #R$52CE, #R$6164 and #R$88AC.
* .
* Works out the distance (#R$2054) from the current system (#R$EB67) - or,
* in witchspace (#R$EEC1), from the ship's position (at $6153) - to the
* selected system (#R$E72B).
distance_to_selected_system:                               ; >6141
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jne  distance_from_witchspace                       ; JR NZ,$6153       ; yes - from the ship's position
       movb @current_system,a                              ; LD A,($EB67)      ; the current system
       .call @generate_system                              ; CALL $4C9B        ; generate its name-seed coordinates
       mov  @system_x,de                                   ; LD DE,($F751)     ; DE = its (X, Y)
       jmp  _6157                                          ; JR $6157          ; 
distance_from_witchspace:                                  ; >6153
       mov  @witchspace_position,de                        ; LD DE,($EEC3)     ; DE = the ship's position in witchspace
_6157:                                                     ; >6157
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       .call @generate_system                              ; CALL $4C9B        ; generate its name-seed coordinates
       mov  @system_x,bc                                   ; LD BC,($F751)     ; BC = its (X, Y)
       b    @distance_between_two_2d_points_d              ; JP $2054          ; compute the distance between them

********************************************************************************
* Key '7': Data on System
* 
* Reached via the key table at #R$419B. First checks for mission 1's events
* (states $11 and $13: #R$9190, #R$91AA). Then, unless the screen is
* already showing, selects the system nearest the cursor on a chart
* (#R$5314 on the galactic chart, #R$538B on the local chart) and shows the
* data on the selected system ($6189).
* .
* At $6189, for the selected system: hides the sprites, draws a frame, and
* prints its name (as #R$6066 does) and distance (#R$6141), then its data
* from #R$4C9B: economy (#R$F754, from the words at #R$0F75), government
* (#R$F753, #R$0FA7), tech level (#R$F755), population (tech level *
* economy / 2 + 20 + bits 3-5 of s1_lo, in billions) and species (#R$60E3),
* gross productivity ((government + 8)^2 * population / 4, in M CR) and
* average radius (s2_lo, in km). In mission state $16 (#R$E93D), adds
* "There's a mean, nasty, vicious ship out there!"; otherwise the system's
* description.
* .
* At $626D, adds the system's description (#R$9A4B). At $6270, marks the
* Data on System screen as showing (#R$E902 = 1).
key_data_on_system:                                        ; >6164
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>11                                   ; CP $11            ; mission 1, state $11?
       jne  key_data_on_system_2                           ; JR NZ,$6170       ; no
       .call @constrictor_at_research_centre               ; CALL $9190        ; at the research centre?
       jmp  _6175                                          ; JR $6175          ; 
key_data_on_system_2:                                      ; >6170
       cb   a,@bytes+>13                                   ; CP $13            ; mission 1, state $13?
       jne  !                                              ; CALL Z,$91AA      ; yes - on the Constrictor's trail?
       .call @constrictor_trail                            ;                   
!
_6175:                                                     ; >6175
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,one                                          ; CP $01            ; Data on System showing?
       jne  !                                              ; RET Z             ; yes - nothing to do
       .ret                                                ;                   
!
       cb   a,@bytes+>04                                   ; CP $04            ; the galactic chart?
       jne  key_data_on_system_3                           ; JR NZ,$6184       ; no
       .call @galactic_chart_select                        ; CALL $5314        ; select the system nearest the cursor
       jmp  show_system_data_screen                        ; JR $6189          ; 
key_data_on_system_3:                                      ; >6184
       cb   a,@bytes+>06                                   ; CP $06            ; the local chart?
       jne  !                                              ; CALL Z,$538B      ; yes - select the system nearest the cursor
       .call @local_chart_select                           ;                   
!
show_system_data_screen:                                   ; >6189
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide sprites
       li   ix,data_on_system_frame                        ; LD IX,$59B7       ; 
       .rst >28                                            ; RST $28           ; draw a frame
       li   hl,data_on_system_headings                     ; LD HL,$5953       ; 
       .rst >20                                            ; RST $20           ; print the Distance/Economy/.../Present System field list
       movb one,a                                          ; LD A,$01          ; 
       movb a,@cursor_vram_addr_row                        ; LD ($E710),A      ; text row 1
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       .call @generate_system_name                         ; CALL $4CAF        ; generate and format its name
       sb   @bytes+>22,a                                   ; SUB $22           ; compute a centering column from the character count
       neg a                                               ; NEG               ; 
       srl  a,1                                            ; SRL A             ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; position the cursor there
       li   hl,msg_data                                    ; LD HL,$56F7       ; a fixed label
       .rst >08                                            ; RST $08           ; print it
       li   hl,text_buffer                                 ; LD HL,$E717       ; the generated name
       .rst >08                                            ; RST $08           ; print it
       li   bc,>0f03                                       ; LD BC,$0F03       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       .call @distance_to_selected_system                  ; CALL $6141        ; compute the distance to it
       movb @l,@c                                          ; LD C,L            ; 
       movb h,@l                                           ; LD L,H            ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; control byte: pad to width 0, decimal-point handling
       .rst >18                                            ; RST $18           ; format and print the distance
       li   hl,msg_light_years_5845                        ; LD HL,$5845       ; a fixed label
       .rst >08                                            ; RST $08           ; print it
       li   bc,>1205                                       ; LD BC,$1205       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       li   de,msg_agricultural                            ; LD DE,$0F8D       ; the economy word-list, lower half
       movb @system_economy,a                              ; LD A,($F754)      ; A = the economy code
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jl   _61da                                          ; JR C,$61DA        ; below 4 - use the lower half
       sb   @bytes+>04,a                                   ; SUB $04           ; above - use the upper half instead
       li   de,msg_industrial                              ; LD DE,$0F9B       ; 
_61da:                                                     ; >61da
       li   hl,msg_poor_0f75                               ; LD HL,$0F75       ; the economy word-list, first word
       .rst >10                                            ; RST $10           ; print it
       .ex_de_hl                                           ; EX DE,HL          ; 
       .rst >08                                            ; RST $08           ; print the second word
       li   bc,>1206                                       ; LD BC,$1206       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       movb @system_government,a                           ; LD A,($F753)      ; A = the government code
       li   hl,msg_anarchy                                 ; LD HL,$0FA7       ; the government-name list
       .rst >10                                            ; RST $10           ; print it
       li   bc,>1207                                       ; LD BC,$1207       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       movb @system_tech_level,a                           ; LD A,($F755)      ; A = tech level
       movb a,@c                                           ; LD C,A            ; 
       sb   a,a                                            ; XOR A             ; 
       s    hl,hl                                          ; SBC HL,HL         ; 
       .rst >18                                            ; RST $18           ; format and print it
       li   bc,>1109                                       ; LD BC,$1109       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       movb @system_tech_level,a                           ; LD A,($F755)      ; population:
       movb a,@e                                           ; LD E,A            ; 
       movb @system_economy,a                              ; LD A,($F754)      ; 
       movb a,d                                            ; LD D,A            ; 
       .call @multiply_d_e_8bit                            ; CALL $1F51        ; tech level * economy
       srl  a,1                                            ; SRL A             ; / 2
       ab   @bytes+>14,a                                   ; ADD A,$14         ; + 20
       movb a,@c                                           ; LD C,A            ; 
       movb @system_s1_lo,a                                ; LD A,($F74D)      ; + bits 3-5 of s1_lo
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>0700                                        ; AND $07           ; 
       ab   @c,a                                           ; ADD A,C           ; 
       .push af                                            ; PUSH AF           ; stash it (needed again below for the radius calc)
       movb a,@c                                           ; LD C,A            ; 
       s    hl,hl                                          ; SBC HL,HL         ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; control byte: pad to width 0, decimal-point handling
       .rst >18                                            ; RST $18           ; print the population
       li   hl,msg_billion                                 ; LD HL,$56FF       ; a fixed label
       .rst >08                                            ; RST $08           ; print it
       .call @show_inhabitants                             ; CALL $60E3        ; print the species
       li   bc,>190c                                       ; LD BC,$190C       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       movb @system_government,a                           ; LD A,($F753)      ; productivity: (government + 8)^2...
       ab   @bytes+>08,a                                   ; ADD A,$08         ; 
       movb a,@e                                           ; LD E,A            ; 
       movb a,d                                            ; LD D,A            ; 
       .call @multiply_d_e_8bit                            ; CALL $1F51        ; ...via an 8x8 multiply
       movb a,@e                                           ; LD E,A            ; 
       .pop af                                             ; POP AF            ; recover the earlier combined value
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; ...* population
       srl  h,1                                            ; SRL H             ; /4
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  h,1                                            ; SRL H             ; 
       ; RR L                                              ; RR L              ; TODO: check code. 
       movb @l,@c                                          ; LD C,L            ; 
       movb h,@l                                           ; LD L,H            ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,h                                            ; LD H,A            ; 
       .rst >18                                            ; RST $18           ; print the productivity
       li   hl,msg_m_cr                                    ; LD HL,$5707       ; a fixed label
       .rst >08                                            ; RST $08           ; print it
       li   bc,>190d                                       ; LD BC,$190D       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       mov  @system_s1_hi,bc                               ; LD BC,($F74E)     ; radius: s2_lo
       movb b,@l                                           ; LD L,B            ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,h                                            ; LD H,A            ; 
       .rst >18                                            ; RST $18           ; print the radius
_625c:                                                     ; >625c
       li   hl,msg_km                                      ; LD HL,$570C       ; a fixed label
       .rst >08                                            ; RST $08           ; print it
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>16                                   ; CP $16            ; the Constrictor is here?
       jne  show_system_data_2                             ; JR NZ,$626D       ; 
       li   hl,msg_mean_nasty_vicious_ship                 ; LD HL,$585D       ; 
       .rst >20                                            ; RST $20           ; print "There's a mean, nasty, vicious ship out there!"
       jmp  _6270                                          ; JR $6270          ; 
show_system_data_2:                                        ; >626d
       .call @show_system_description                      ; CALL $9A4B        ; the system's description
_6270:                                                     ; >6270
       movb one,a                                          ; LD A,$01          ; 
       movb a,@current_screen                              ; LD ($E902),A      ; Data on System is showing
       .ret                                                ; RET               ; 

********************************************************************************
* Show the status page
* 
* Used by the routines at #R$1873, #R$1C5C and #R$5DBB.
* .
* Does nothing if it's already showing (#R$E902 = 3). Hides the sprites,
* draws the frame and labels, and prints "Commander" and the name
* (#R$6377); then the present system - or "Witchspace" (#R$EEC1) - and the
* rest ($629C).
* .
* At $629C, prints the present system (#R$EB67), the hyperspace system
* (#R$E72B), the condition (#R$E90C, coloured green or red), the fuel, the
* cash, the legal status (#R$EB65), the rating (#R$EB12), and the equipment
* fitted (#R$F777 onwards, two columns), with the mounts of each laser
* ($6355) and "Naval Energy Unit" for the naval energy unit (#R$F77E = 2).
* .
* At $6355, prints the name of equipment item A (from the list at #R$10A7).
* At $6359, for a laser (bit 7 of E set), prints the letters of the mounts
* it's fitted to ("F", "B", "L" and "R", bits 0-3). At $636D moves on to
* the next item, and marks the status page as showing (#R$E902 = 3) after
* the last.
status_page:                                               ; >6276
       movb @current_screen,a                              ; LD A,($E902)      ; 
       cb   a,@bytes+>03                                   ; CP $03            ; 
       jne  !                                              ; RET Z             ; already showing
       .ret                                                ;                   
!
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide the sprites
       li   ix,status_page_frame                           ; LD IX,$5A52       ; 
       .rst >28                                            ; RST $28           ; draw the frame
       li   hl,status_page_headings                        ; LD HL,$59E0       ; the labels
       .rst >20                                            ; RST $20           ; print them
       .call @print_commander_name                         ; CALL $6377        ; print "Commander" and the name
       li   bc,>1903                                       ; LD BC,$1903       ; 
       .call @set_cursor_position                          ; CALL $3548        ; 
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  status_page_2                                  ; JR Z,$629C        ; not in witchspace
       li   hl,msg_witchspace                              ; LD HL,$57C9       ; "Witchspace"
       jmp  _62a5                                          ; JR $62A5          ; 
status_page_2:                                             ; >629c
       movb @current_system,a                              ; LD A,($EB67)      ; A = present system
       .call @generate_system_name                         ; CALL $4CAF        ; generate its name
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
_62a5:                                                     ; >62a5
       .rst >08                                            ; RST $08           ; print it
       li   bc,>1904                                       ; LD BC,$1904       ; 
       .call @set_cursor_position                          ; CALL $3548        ; 
       movb @selected_system,a                             ; LD A,($E72B)      ; A = hyperspace system
       .call @generate_system_name                         ; CALL $4CAF        ; generate its name
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       .rst >08                                            ; RST $08           ; print it
       li   bc,>1905                                       ; LD BC,$1905       ; 
       .call @set_cursor_position                          ; CALL $3548        ; 
       movb @alert_level,a                                 ; LD A,($E90C)      ; A = alert level
       li   hl,msg_green_5a9f                              ; LD HL,$5A9F       ; "Green", "Red" or "Red"
       .push af                                            ; PUSH AF           ; 
       .rst >10                                            ; RST $10           ; print the condition
       limi 0                                              ; DI                ; 
       movb @bytes+>90,a                                   ; LD A,$90          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>65,a                                   ; LD A,$65          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $2590
       .pop af                                             ; POP AF            ; 
       socb a,a                                            ; OR A              ; 
       movb @bytes+>31,a                                   ; LD A,$31          ; green...
       jeq  _62d8                                          ; JR Z,$62D8        ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; ...or red
       movb a,@vram_flash_toggle                           ; LD ($E90E),A      ; 
_62d8:                                                     ; >62d8
       movb @bytes+>40,b                                   ; LD B,$40          ; 
_62da:                                                     ; >62da
       movb a,@vdpwd                                       ; OUT ($98),A       ; colour the condition
       nop                                                 ; NOP               ; 
       sb   one,b                                          ; DJNZ $62DA        ; 
       jne  _62da                                          ;                   
       ; EI                                                ; EI                ; TODO: check code. 
       li   bc,>0b06                                       ; LD BC,$0B06       ; 
       .call @set_cursor_position                          ; CALL $3548        ; 
       .call @print_fuel                                   ; CALL $6042        ; print the fuel
       li   bc,>0b07                                       ; LD BC,$0B07       ; 
       .call @set_cursor_position                          ; CALL $3548        ; 
       .call @format_print_current_cash_total              ; CALL $6037        ; print the cash
       li   hl,msg_credits_5851                            ; LD HL,$5851       ; " Credits"
       .rst >08                                            ; RST $08           ; 
       li   bc,>1308                                       ; LD BC,$1308       ; 
       .call @set_cursor_position                          ; CALL $3548        ; 
       movb @legal_status,a                                ; LD A,($EB65)      ; A = legal status
       socb a,a                                            ; OR A              ; 
       jeq  _6309                                          ; JR Z,$6309        ; 0: Clean
       cb   a,@bytes+>32                                   ; CP $32            ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       jnc  _6309                                          ; JR NC,$6309       ; TODO: check code. 50 or more: Fugitive
       sb   one,a                                          ; DEC A             ; 1-49: Offender
_6309:                                                     ; >6309
       li   hl,msg_clean                                   ; LD HL,$5AAA       ; "Clean", "Offender" or "Fugitive"
       .rst >10                                            ; RST $10           ; print the legal status
       li   bc,>0d09                                       ; LD BC,$0D09       ; 
       .call @set_cursor_position                          ; CALL $3548        ; 
       movb @combat_rank,a                                 ; LD A,($EB12)      ; A = combat rank
       li   hl,msg_harmless_0f25                           ; LD HL,$0F25       ; "Harmless" ...
       .rst >10                                            ; RST $10           ; print the rank
       li   hl,>050c                                       ; LD HL,$050C       ; the first equipment column
       mov  hl,@status_equipment_position                  ; LD ($E74B),HL     ; 
       li   hl,item_large_cargo_bay                        ; LD HL,$F777       ; the equipment, from the large cargo bay
       movb @bytes+>0f,b                                   ; LD B,$0F          ; 15 items
_6325:                                                     ; >6325
       .push hl                                            ; PUSH HL           ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@e                                           ; LD E,A            ; 
       andi a,>7f00                                        ; AND $7F           ; 
       jeq  _636d                                          ; JR Z,$636D        ; not fitted
       .push bc                                            ; PUSH BC           ; 
       mov  @status_equipment_position,bc                  ; LD BC,($E74B)     ; 
       .call @set_cursor_position                          ; CALL $3548        ; 
       movb b,a                                            ; LD A,B            ; 
       ab   @bytes+>11,a                                   ; ADD A,$11         ; 
       movb a,b                                            ; LD B,A            ; 
       cb   a,@bytes+>27                                   ; CP $27            ; 
       jne  _633f                                          ; JR NZ,$633F       ; 
       movb @bytes+>05,b                                   ; LD B,$05          ; the second column
       ab   one,@c                                         ; INC C             ; 
_633f:                                                     ; >633f
       mov  bc,@status_equipment_position                  ; LD ($E74B),BC     ; 
       .pop bc                                             ; POP BC            ; 
       movb @bytes+>11,a                                   ; LD A,$11          ; 
       sb   b,a                                            ; SUB B             ; 
       cb   a,@bytes+>09                                   ; CP $09            ; the energy unit?
       jne  status_page_equipment                          ; JR NZ,$6355       ; 
       movb @e,r0                                          ; BIT 1,E           ; a naval one?
       andi r0,>0200                                       ;                   
       jeq  status_page_equipment                          ; JR Z,$6355        ; 
       li   hl,msg_naval_energy_unt                        ; LD HL,$114C       ; "Naval Energy Unit"
       .rst >08                                            ; RST $08           ; print it
       jmp  _6359                                          ; JR $6359          ; 
status_page_equipment:                                     ; >6355
       li   hl,equipment_name_list2_empty_slots            ; LD HL,$10A7       ; the equipment names
       .rst >10                                            ; RST $10           ; print it
_6359:                                                     ; >6359
       movb @e,r0                                          ; BIT 7,E           ; a laser?
       andi r0,>8000                                       ;                   
       jeq  _636d                                          ; JR Z,$636D        ; no - nothing more to show
       .push bc                                            ; PUSH BC           ; 
       li   hl,msg_fblr                                    ; LD HL,$57DD       ; "FBLR"
       movb @bytes+>04,b                                   ; LD B,$04          ; 
_6363:                                                     ; >6363
       ; RR E                                              ; RR E              ; TODO: check code. fitted to this mount?
       jnc  _6369                                          ; JR NC,$6369       ; TODO: check code. clear - not fitted, skip its letter
       movb *hl,a                                          ; LD A,(HL)         ; print its letter
       .rst >00                                            ; RST $00           ; 
_6369:                                                     ; >6369
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $6363        ; next sub-option bit
       jne  _6363                                          ;                   
       .pop bc                                             ; POP BC            ; 
_636d:                                                     ; >636d
       .pop hl                                             ; POP HL            ; recover the pointer
       inc  hl                                             ; INC HL            ; -> the next slot
       sb   one,b                                          ; DJNZ $6325        ; next item
       jne  _6325                                          ;                   
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       movb a,@current_screen                              ; LD ($E902),A      ; the status page is showing
       .ret                                                ; RET               ; 

********************************************************************************
* Print "Commander" and the commander's name
* 
* Used by the routines at #R$6276 and #R$A30A.
* .
* Centred on the line: at column (42 - (10 + the length of the name,
* #R$EB11)) / 2.
print_commander_name:                                      ; >6377
       movb one,a                                          ; LD A,$01          ; 
       movb a,@cursor_vram_addr_row                        ; LD ($E710),A      ; text row 1
       movb @name_length,a                                 ; LD A,($EB11)      ; A = length of the name
       ab   @bytes+>0a,a                                   ; ADD A,$0A         ; 
       sb   @bytes+>2a,a                                   ; SUB $2A           ; 
       neg a                                               ; NEG               ; 
       srl  a,1                                            ; SRL A             ; 
       .call @set_cursor_position_combined                 ; CALL $3564        ; 
       li   hl,msg_commander                               ; LD HL,$57D3       ; "Commander "
       .rst >08                                            ; RST $08           ; print it
       li   hl,commander_name                              ; LD HL,$EB06       ; the commander's name
       .rst >08                                            ; RST $08           ; print it
       .ret                                                ; RET               ; 

********************************************************************************
* Refuse a docked command in flight
* 
* Used by the routines at #R$1837, #R$5BBD, #R$5CEE, #R$5DBB and #R$A30A.
* .
* Called by the handlers for things that only work when docked (launching,
* buying and selling). Returns normally if the player is docked
* (#R$E90A); otherwise beeps (#R$16FE) and returns to the handler's
* caller.
refuse_unless_docked:                                      ; >6393
       movb @docked,a                                      ; LD A,($E90A)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; docked
       .ret                                                ;                   
!
       .pop hl                                             ; POP HL            ; discard the return address
       b    @trigger_sfx_6                                 ; JP $16FE          ; beep

********************************************************************************
* Get the size of a unit of cargo
* 
* Used by the routines at #R$5C01, #R$5D72 and #R$8BA6.
* .
* Points HL at the size in grams (#R$5A8B) of a tonne, a kilogram or a
* gram.
* 
* I:A Units (0 tonnes, 1 kilograms, 2 grams)
* O:HL Pointer to the size (4 bytes)
unit_size:                                                 ; >639c
       li   hl,cargo_unit_sizes                            ; LD HL,$5A8B       ; tonnes
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; 
       .ret                                                ;                   
!
       li   hl,unit_size_kilogram                          ; LD HL,$5A8F       ; kilograms
       sb   one,a                                          ; DEC A             ; 
       jne  !                                              ; RET Z             ; 
       .ret                                                ;                   
!
       li   hl,unit_size_gram                              ; LD HL,$5A93       ; grams
       .ret                                                ; RET               ; 

********************************************************************************
* Illegal goods: worsen the legal status
* 
* Used by the routines at #R$5C01 and #R$8BA6.
* .
* Adds the quantity * how illegal the goods are (byte 3 of their entry in
* the market, see #R$0A02) to the legal status (#R$EB65), up to $FF.
* Called when buying or scooping cargo.
* 
* I:A Quantity
* I:IX Pointer to the goods' entry in the market (#R$F789)
illegal_goods:                                             ; >63aa
       movb a,d                                            ; LD D,A            ; D:E = A : this item's per-unit field
       movb @>03(ix),@e                                    ; LD E,(IX+$03)     ; E = how illegal
       .call @multiply_d_e_8bit                            ; CALL $1F51        ; A = quantity * that
       li   hl,legal_status                                ; LD HL,$EB65       ; add it to the legal status
       ab   *hl,a                                          ; ADD A,(HL)        ; 
       jnc  _63b8                                          ; JR NC,$63B8       ; TODO: check code. no overflow - keep it
       sb   a,a                                            ; SBC A,A           ; up to $FF
_63b8:                                                     ; >63b8
       movb a,*hl                                          ; LD (HL),A         ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Work out the free space in the hold
* 
* Used by the routines at #R$5C01, #R$6051, #R$8BA6 and #R$909F.
* .
* Starts with the hold's capacity (#R$5A97: 20 tonnes, or 35 with a large
* cargo bay, #R$F777), and takes the size of each of the 18 goods in the
* hold (#R$EB19) off it (#R$63E0).
work_out_free_space:                                       ; >63ba
       li   hl,cargo_hold_capacities                       ; LD HL,$5A97       ; 20 tonnes
       movb @item_large_cargo_bay,a                        ; LD A,($F777)      ; large cargo bay?
       socb a,a                                            ; OR A              ; 
       jeq  _63c6                                          ; JR Z,$63C6        ; no
       li   hl,hold_capacity_large                         ; LD HL,$5A9B       ; yes: 35 tonnes
_63c6:                                                     ; >63c6
       li   de,free_space                                  ; LD DE,$EB61       ; the free space
       li   bc,>0004                                       ; LD BC,$0004       ; 4 bytes
       .ldir                                               ; LDIR              ; 
       li   hl,cargo_hold                                  ; LD HL,$EB19       ; the goods in the hold
       movb @bytes+>12,a                                   ; LD A,$12          ; 18 of them
_63d3:                                                     ; >63d3
       .ex_af_af_                                          ; EX AF,AF'         ; 
       li   bc,>0001                                       ; LD BC,$0001       ; one of them
       .call @take_off_free_space                          ; CALL $63E0        ; take it off the free space
       .ex_de_hl                                           ; EX DE,HL          ; next
       .ex_af_af_                                          ; EX AF,AF'         ; 
       sb   one,a                                          ; DEC A             ; 
       jne  _63d3                                          ; JR NZ,$63D3       ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Take cargo off the free space in the hold
* 
* Used by the routines at #R$5C01, #R$63BA and #R$8BA6.
* .
* Subtracts BC units of the size at HL from the free space (#R$EB61).
* 
* I:BC Number of units
* I:HL Pointer to the size of a unit
take_off_free_space:                                       ; >63e0
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       li   de,free_space                                  ; LD DE,$EB61       ; the running capacity total
       .call @subtract_4byte_de_hl                         ; CALL $21CF        ; subtract one unit's occupied space
       .ex_de_hl                                           ; EX DE,HL          ; 
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       dec  bc                                             ; DEC BC            ; 
       movb b,a                                            ; LD A,B            ; 
       socb @c,a                                           ; OR C              ; 
       jne  take_off_free_space                            ; JR NZ,$63E0       ; more units - repeat
       .ret                                                ; RET               ; 

********************************************************************************
* Enter flight mode: set up the cockpit screen
* 
* Used by the routine at #R$645B.
* .
* Clears $E70B, $E902 and $E949 (so there are no scanner blips to
* erase), sets $EF9E and #R$E903 (space view showing), hides all 32 sprites
* (#R$3942), uploads the missile and compass dot sprite patterns (#R$39B9,
* #R$6EC7), unpacks the cockpit screen picture (#R$7139, see
* #R$CAD7) and draws all the gauges (#R$6433). #R$60B1 is the "leave
* flight" counterpart.
enter_flight_mode:                                         ; >63f1
       sb   a,a                                            ; XOR A             ; 
       movb a,@chart_cursor_active_flag                    ; LD ($E70B),A      ; 
       movb a,@current_screen                              ; LD ($E902),A      ; 
       movb a,@scanner_drawn_count                         ; LD ($E949),A      ; no scanner blips to erase
       sb   one,a                                          ; DEC A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; 
       movb a,@space_view_showing                          ; LD ($E903),A      ; space view showing
       li   hl,>1b00                                       ; LD HL,$1B00       ; hide all 32 sprites
       movb @bytes+>20,b                                   ; LD B,$20          ; 
       limi 0                                              ; DI                ; 
       .call @hide_sprites                                 ; CALL $3942        ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>78,a                                   ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $3880 (sprite patterns)
       li   hl,flight_sprite_patterns                      ; LD HL,$6EC7       ; 
       .call @write_run_length_encoded_byte_stream         ; CALL $39B9        ; upload the missile patterns
       movb @bytes+>c0,a                                   ; LD A,$C0          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>78,a                                   ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $38C0
       li   hl,compass_dot_pattern                         ; LD HL,$6ED4       ; 
       .call @write_run_length_encoded_byte_stream         ; CALL $39B9        ; upload the compass dot pattern
       ; EI                                                ; EI                ; TODO: check code. 
       .call @blank_screen_decompress_picture_recolour     ; CALL $7139        ; unpack the cockpit screen picture
       .call @redraw_all_dashboard_gauges                  ; CALL $6433        ; draw all the gauges
       sb   a,a                                            ; XOR A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Redraw all dashboard gauges
* 
* Used by the routines at #R$63F1 and #R$894D.
* .
* Calls all 13 dashboard-gauge-drawing routines in turn - the same set
* gated by #R$6C9E (gate_dashboard_hidden), which each of them calls
* first to skip the work when the dashboard is hidden.
redraw_all_dashboard_gauges:                               ; >6433
       .call @draw_speed_gauge                             ; CALL $6A59        ; the speed gauge
       .call @draw_roll_dial                               ; CALL $6BB3        ; the roll dial
       .call @draw_pitch_dial                              ; CALL $6BCA        ; the pitch dial
       .call @draw_energy_banks                            ; CALL $6A88        ; the energy banks
       .call @draw_gauge_dashboard_6b48                    ; CALL $6B48        ; the fore shield
       .call @draw_gauge_dashboard_6b54                    ; CALL $6B54        ; the aft shield
       .call @draw_laser_temperature                       ; CALL $6B60        ; the laser temperature
       .call @draw_fuel_gauge                              ; CALL $6AAD        ; the fuel
       .call @draw_missile_indicator                       ; CALL $6B6E        ; the missiles
       .call @draw_altitude                                ; CALL $6AC4        ; the altitude
       .call @draw_cabin_temperature                       ; CALL $6AD0        ; the cabin temperature
       .call @draw_station_indicator                       ; CALL $6ADC        ; the "S" indicator
       .call @draw_ecm_indicator                           ; CALL $6B12        ; the "E" indicator
       .ret                                                ; RET               ; 

********************************************************************************
* Switch to a new space view
* 
* Used by the routines at #R$64A1, #R$64B5, #R$64C9 and #R$64DD.
* .
* Shared tail of the four view selectors. Patches the CALL at $6944 in
* the stardust loop (#R$6911) to the view's stardust move handler. When
* not in flight, first calls #R$63F1 and sets the current view ($EB9A)
* to $FF so the view always counts as changed. If the view has changed,
* stores the new view number and copies the view's name (#R$118F: 7
* characters of 5 pixel rows) from DE into rows 1-5 of the character
* patterns at VRAM $0060-$0097 on the dashboard, then scatters a
* fresh stardust field for the new view (#R$6882). Finally shows the
* tunnel rings if launching ($E8F6, #R$6CB2), and sets up the view's
* laser (#R$6D24).
* 
* I:B New view number (0=front, 1=rear, 2=left, 3=right)
* I:DE Source data for the VRAM copy
* I:HL The view's stardust move handler
switch_view:                                               ; >645b
       mov  hl,@stardust_move_handler+>0001                ; LD ($6945),HL     ; patch the stardust move handler (#R$6944+1)
       .push de                                            ; PUSH DE           ; save DE
       movb @space_view_showing,a                          ; LD A,($E903)      ; in flight?
       socb a,a                                            ; OR A              ; 
       jne  _646f                                          ; JR NZ,$646F       ; yes
       .push bc                                            ; PUSH BC           ; 
       .call @enter_flight_mode                            ; CALL $63F1        ; no: set up the cockpit screen (#R$63F1)
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@current_view                                ; LD ($EB9A),A      ; and make sure the view counts as changed
       .pop bc                                             ; POP BC            ; 
_646f:                                                     ; >646f
       .pop de                                             ; POP DE            ; DE -> the view's name
       movb b,a                                            ; LD A,B            ; A = the new view
       li   hl,current_view                                ; LD HL,$EB9A       ; 
       cb   a,*hl                                          ; CP (HL)           ; the same as the current view?
       jeq  _6496                                          ; JR Z,$6496        ; yes - skip
       movb a,*hl                                          ; LD (HL),A         ; set the current view
       movb @bytes+>61,a                                   ; LD A,$61          ; A = $61, the VRAM address's low byte for the name's first character
       movb @bytes+>07,@c                                  ; LD C,$07          ; 7 characters
_647c:                                                     ; >647c
       .push af                                            ; PUSH AF           ; 
       limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $0061 + 8n: rows 1-5 of the character's pattern
       movb @bytes+>05,b                                   ; LD B,$05          ; 5 pixel rows
_6486:                                                     ; >6486
       movb *de,a                                          ; LD A,(DE)         ; copy a row of the name's pattern
       inc  de                                             ; INC DE            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       sb   one,b                                          ; DJNZ $6486        ; 
       jne  _6486                                          ;                   
       ; EI                                                ; EI                ; TODO: check code. 
       .pop af                                             ; POP AF            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; next character
       sb   one,@c                                         ; DEC C             ; 
       jne  _647c                                          ; JR NZ,$647C       ; 
       .call @scatter_stardust                             ; CALL $6882        ; scatter the stardust for the new view (#R$6882)
_6496:                                                     ; >6496
       movb @show_tunnel,a                                 ; LD A,($E8F6)      ; launching?
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; CALL NZ,$6CB2     ; yes - show the tunnel rings (#R$6CB2)
       .call @tunnel_rings                                 ;                   
!
       .call @view_laser                                   ; CALL $6D24        ; set up the view's laser (#R$6D24)
       .ret                                                ; RET               ; 

********************************************************************************
* Switch to the front view
* 
* Used by the routines at #R$1703, #R$1837, #R$1873, #R$19FC, #R$1C5C, #R$4173
* and #R$894D.
* .
* The first of four near-identical view selectors (see also #R$64B5,
* #R$64C9 and #R$64DD). Each points ($44CF) - the self-modified
* negate-target operand inside #R$4464 - at the view's own target, then
* passes the view number, its stardust move handler and its VRAM data to
* #R$645B.
switch_to_front_view:                                      ; >64a1
       .call @refuse_if_docked                             ; CALL $6DCF        ; 
       li   hl,view_front                                  ; LD HL,$44E5       ; front view's negate-target inside #R$4464
       mov  hl,@convert_to_view+>0001                      ; LD ($44CF),HL     ; patch the view conversion (#R$44CE+1)
       sb   b,b                                            ; LD B,$00          ; B = 0 (front view)
       li   hl,stardust_front_view                         ; LD HL,$64F1       ; HL = front view stardust handler (#R$64F1)
       li   de,view_name_front                             ; LD DE,$118F       ; DE = front view's VRAM data
       b    @switch_view                                   ; JP $645B          ; switch view

********************************************************************************
* Switch to the rear view
* 
* Used by the routine at #R$417D.
* .
* Rear view counterpart of #R$64A1 (key '2').
switch_to_rear_view:                                       ; >64b5
       .call @refuse_if_docked                             ; CALL $6DCF        ; 
       li   hl,view_rear                                   ; LD HL,$44E6       ; rear view's negate-target inside #R$4464
       mov  hl,@convert_to_view+>0001                      ; LD ($44CF),HL     ; patch the view conversion (#R$44CE+1)
       movb one,b                                          ; LD B,$01          ; B = 1 (rear view)
       li   hl,stardust_rear_view                          ; LD HL,$656B       ; HL = rear view stardust handler (#R$656B)
       li   de,view_name_rear                              ; LD DE,$11B2       ; DE = rear view's VRAM data
       b    @switch_view                                   ; JP $645B          ; switch view

********************************************************************************
* Switch to the left view
* 
* Used by the routine at #R$4187.
* .
* Left view counterpart of #R$64A1 (key '3').
switch_to_left_view:                                       ; >64c9
       .call @refuse_if_docked                             ; CALL $6DCF        ; 
       li   hl,view_left                                   ; LD HL,$44F3       ; left view's negate-target inside #R$4464
       mov  hl,@convert_to_view+>0001                      ; LD ($44CF),HL     ; patch the view conversion (#R$44CE+1)
       movb @bytes+>02,b                                   ; LD B,$02          ; B = 2 (left view)
       li   hl,stardust_left_view                          ; LD HL,$6628       ; HL = left view stardust handler (#R$6628)
       li   de,view_name_left                              ; LD DE,$11D5       ; DE = left view's VRAM data
       b    @switch_view                                   ; JP $645B          ; switch view

********************************************************************************
* Switch to the right view
* 
* Used by the routine at #R$4191.
* .
* Right view counterpart of #R$64A1 (key '4').
switch_to_right_view:                                      ; >64dd
       .call @refuse_if_docked                             ; CALL $6DCF        ; 
       li   hl,view_right                                  ; LD HL,$44FB       ; right view's negate-target inside #R$4464
       mov  hl,@convert_to_view+>0001                      ; LD ($44CF),HL     ; patch the view conversion (#R$44CE+1)
       movb @bytes+>03,b                                   ; LD B,$03          ; B = 3 (right view)
       li   hl,stardust_right_view                         ; LD HL,$6682       ; HL = right view stardust handler (#R$6682)
       li   de,view_name_right                             ; LD DE,$11F8       ; DE = right view's VRAM data
       b    @switch_view                                   ; JP $645B          ; switch view

********************************************************************************
* Stardust: move or respawn a particle in the front view
* 
* Used by the routine at #R$68CD.
* .
* The front view's stardust move handler (the default operand of the
* patched CALL at $6944). A particle flagged for respawning is given a
* random position within 63 pixels of the centre on each axis, and #R$6805
* sets its velocity to point straight out from the centre. Otherwise it is
* moved (at $6520).
* .
* At $6520, adds the particle's velocity to its position several times
* over, the number of times depending on how far the particle already is
* from the centre on that axis (the bit length of |offset|/4, minimum 1,
* from the table at $0200), so particles speed up as they fly outwards. X
* and Y are done independently.
* 
* I:F Z set to move the particle, clear to respawn it
* I:IX Pointer to the particle
stardust_front_view:                                       ; >64f1
       jeq  stardust_move_outwards                         ; JR Z,$6520        ; not flagged for respawning - go move it
       .call @random_byte                                  ; CALL $2176        ; A = random byte
       movb a,@l                                           ; LD L,A            ; 
       andi a,>3f00                                        ; AND $3F           ; C = |X| = 0-63
       movb a,@c                                           ; LD C,A            ; 
       ; RL L                                              ; RL L              ; TODO: check code. random sign
       jnc  _6500                                          ; JR NC,$6500       ; TODO: check code. 
       neg a                                               ; NEG               ; 
_6500:                                                     ; >6500
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb a,@>01(ix)                                     ; LD (IX+$01),A     ; set X
       .call @random_byte                                  ; CALL $2176        ; A = random byte
       movb a,@l                                           ; LD L,A            ; 
       andi a,>3f00                                        ; AND $3F           ; B = |Y| = 0-63
       movb a,b                                            ; LD B,A            ; 
       ; RL L                                              ; RL L              ; TODO: check code. random sign
       jnc  _6514                                          ; JR NC,$6514       ; TODO: check code. 
       neg a                                               ; NEG               ; 
_6514:                                                     ; >6514
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb a,@>03(ix)                                     ; LD (IX+$03),A     ; set Y
       .call @stardust_set_velocity                        ; CALL $6805        ; set the velocity, pointing away from the centre
       jmp  _656a                                          ; JR $656A          ; 
stardust_move_outwards:                                    ; >6520
       movb *ix,@l                                         ; LD L,(IX+$00)     ; 
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; HL = X
       movb @>04(ix),@e                                    ; LD E,(IX+$04)     ; 
       movb @>05(ix),d                                     ; LD D,(IX+$05)     ; DE = X velocity
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6533        ; 
       b    @stardust_front_x                              ;                   
!
       neg a                                               ; NEG               ; A = |X|
stardust_front_x:                                          ; >6533
       srl  a,1                                            ; SRL A             ; 
       srl  a,1                                            ; SRL A             ; A = |X| / 4
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>02,b                                   ; LD B,$02          ; 
       movb *bc,a                                          ; LD A,(BC)         ; B = number of steps from the bit length table
       movb a,b                                            ; LD B,A            ; 
_653c:                                                     ; >653c
       a    de,hl                                          ; ADD HL,DE         ; move along X...
       sb   one,b                                          ; DJNZ $653C        ; ...that many times
       jne  _653c                                          ;                   
       movb @l,*ix                                         ; LD (IX+$00),L     ; 
       movb h,@>01(ix)                                     ; LD (IX+$01),H     ; store the new X
       movb @>02(ix),@l                                    ; LD L,(IX+$02)     ; 
       movb @>03(ix),h                                     ; LD H,(IX+$03)     ; HL = Y
       movb @>06(ix),@e                                    ; LD E,(IX+$06)     ; 
       movb @>07(ix),d                                     ; LD D,(IX+$07)     ; DE = Y velocity
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6558        ; 
       b    @stardust_front_y                              ;                   
!
       neg a                                               ; NEG               ; A = |Y|
stardust_front_y:                                          ; >6558
       srl  a,1                                            ; SRL A             ; 
       srl  a,1                                            ; SRL A             ; A = |Y| / 4
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>02,b                                   ; LD B,$02          ; 
       movb *bc,a                                          ; LD A,(BC)         ; B = number of steps from the bit length table
       movb a,b                                            ; LD B,A            ; 
_6561:                                                     ; >6561
       a    de,hl                                          ; ADD HL,DE         ; move along Y...
       sb   one,b                                          ; DJNZ $6561        ; ...that many times
       jne  _6561                                          ;                   
       movb @l,@>02(ix)                                    ; LD (IX+$02),L     ; 
       movb h,@>03(ix)                                     ; LD (IX+$03),H     ; store the new Y
_656a:                                                     ; >656a
       .ret                                                ; RET               ; 

********************************************************************************
* Stardust: move or respawn a particle in the rear view
* 
* Called by the CALL at $6944 in #R$68CD, which #R$645B patches for the
* rear view (#R$64B5).
* .
* In the rear view the stardust flies in from the edges towards the centre.
* A particle flagged for respawning is placed at a random point on the
* bottom edge (Y=64) or top edge (Y=-63), or at X=88 (the right edge) or
* X=-63 (rather than the left edge at -87) with a random Y (at $6594). At
* $65AE, #R$6805 then sets its velocity pointing away from the centre,
* which is subtracted to move the particle back towards the centre.
* .
* At $65C1, subtracts the particle's (outward-pointing) velocity from its X
* coordinate several times over, the number of times depending on its
* distance from the centre as in #R$6520, so particles slow down as they
* approach the centre. If X changes sign, the particle has passed the
* centre and is flagged for respawning (and X isn't updated). Then (at
* $65EE) does the same for Y, storing it at $6621.
* 
* I:F Z set to move the particle, clear to respawn it
* I:IX Pointer to the particle
stardust_rear_view:                                        ; >656b
       jeq  stardust_move_inwards                          ; JR Z,$65C1        ; not flagged for respawning - go move it
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>0300                                        ; AND $03           ; A = random edge selector, 0-3
       movb a,@c                                           ; LD C,A            ; 
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jhe  stardust_rear_view_respawn_side                ; JR NC,$6594       ; 2 or 3 - put it at the side instead
       .ex_af_af_                                          ; EX AF,AF'         ; save the edge selector
_6578:                                                     ; >6578
       .call @random_byte                                  ; CALL $2176        ; pick a random X...
       movb a,@l                                           ; LD L,A            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6582        ; 
       b    @stardust_rear_random_x                        ;                   
!
       neg a                                               ; NEG               ; 
stardust_rear_random_x:                                    ; >6582
       cb   a,@bytes+>58                                   ; CP $58            ; 
       jhe  _6578                                          ; JR NC,$6578       ; ...within 87 of the centre
       movb a,@c                                           ; LD C,A            ; C = |X|
       movb @bytes+>40,h                                   ; LD H,$40          ; Y = 64 (bottom edge)
       movb h,b                                            ; LD B,H            ; B = |Y|
       .ex_af_af_                                          ; EX AF,AF'         ; restore the edge selector
       socb a,a                                            ; OR A              ; 
       jeq  _6592                                          ; JR Z,$6592        ; 0 - bottom edge
       movb @bytes+>c1,h                                   ; LD H,$C1          ; 1 - top edge: Y = -63
       movb @bytes+>3f,b                                   ; LD B,$3F          ; B = |Y|
_6592:                                                     ; >6592
       jmp  _65ae                                          ; JR $65AE          ; go set the position and velocity
stardust_rear_view_respawn_side:                           ; >6594
       .ex_af_af_                                          ; EX AF,AF'         ; save the edge selector and flags
_6595:                                                     ; >6595
       .call @random_byte                                  ; CALL $2176        ; pick a random Y...
       movb a,h                                            ; LD H,A            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$659F        ; 
       b    @stardust_rear_random_y                        ;                   
!
       neg a                                               ; NEG               ; 
stardust_rear_random_y:                                    ; >659f
       cb   a,@bytes+>40                                   ; CP $40            ; 
       jhe  _6595                                          ; JR NC,$6595       ; ...within 63 of the centre
       movb a,b                                            ; LD B,A            ; B = |Y|
       movb @bytes+>58,@l                                  ; LD L,$58          ; X = 88 (right edge)
       movb @l,@c                                          ; LD C,L            ; C = |X|
       .ex_af_af_                                          ; EX AF,AF'         ; restore the edge selector's flags
       jne  _65ae                                          ; JR NZ,$65AE       ; 3 - right edge
       movb @bytes+>c1,@l                                  ; LD L,$C1          ; 2 - X = -63
       movb @bytes+>3f,@c                                  ; LD C,$3F          ; C = |X|
_65ae:                                                     ; >65ae
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb @l,@>01(ix)                                    ; LD (IX+$01),L     ; set X
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb h,@>03(ix)                                     ; LD (IX+$03),H     ; set Y
       .call @stardust_set_velocity                        ; CALL $6805        ; set the velocity, pointing away from the centre
       jmp  _6627                                          ; JR $6627          ; 
stardust_move_inwards:                                     ; >65c1
       movb *ix,@l                                         ; LD L,(IX+$00)     ; 
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; HL = X
       movb h,@c                                           ; LD C,H            ; C = X before moving (for its sign)
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$65CF        ; 
       b    @stardust_rear_x                               ;                   
!
       neg a                                               ; NEG               ; A = |X|
stardust_rear_x:                                           ; >65cf
       srl  a,1                                            ; SRL A             ; 
       srl  a,1                                            ; SRL A             ; A = |X| / 4
       movb a,@e                                           ; LD E,A            ; 
       movb @bytes+>02,d                                   ; LD D,$02          ; 
       movb *de,a                                          ; LD A,(DE)         ; B = number of steps from the bit length table
       movb a,b                                            ; LD B,A            ; 
       movb @>04(ix),@e                                    ; LD E,(IX+$04)     ; 
       movb @>05(ix),d                                     ; LD D,(IX+$05)     ; DE = X velocity
_65de:                                                     ; >65de
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; move back along X...
       sb   one,b                                          ; DJNZ $65DE        ; ...that many times
       jne  _65de                                          ;                   
       movb h,a                                            ; LD A,H            ; 
       ; XOR C                                             ; XOR C             ; TODO: check code. has X changed sign?
       jlt  !                                              ; JP P,$65EE        ; no - go store it
       b    @stardust_move_inwards_y                       ;                   
!
       movb @b255,@>08(ix)                                 ; LD (IX+$08),$FF   ; yes - passed the centre, flag it for respawning
       jmp  _65f4                                          ; JR $65F4          ; go move along Y
stardust_move_inwards_y:                                   ; >65ee
       movb @l,*ix                                         ; LD (IX+$00),L     ; 
       movb h,@>01(ix)                                     ; LD (IX+$01),H     ; store the new X
_65f4:                                                     ; >65f4
       movb @>02(ix),@l                                    ; LD L,(IX+$02)     ; 
       movb @>03(ix),h                                     ; LD H,(IX+$03)     ; HL = Y
       movb h,@c                                           ; LD C,H            ; C = Y before moving (for its sign)
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6602        ; 
       b    @stardust_rear_y                               ;                   
!
       neg a                                               ; NEG               ; A = |Y|
stardust_rear_y:                                           ; >6602
       srl  a,1                                            ; SRL A             ; 
       srl  a,1                                            ; SRL A             ; A = |Y| / 4
       movb a,@e                                           ; LD E,A            ; 
       movb @bytes+>02,d                                   ; LD D,$02          ; 
       movb *de,a                                          ; LD A,(DE)         ; B = number of steps from the bit length table
       movb a,b                                            ; LD B,A            ; 
       movb @>06(ix),@e                                    ; LD E,(IX+$06)     ; 
       movb @>07(ix),d                                     ; LD D,(IX+$07)     ; DE = Y velocity
_6611:                                                     ; >6611
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; move back along Y...
       sb   one,b                                          ; DJNZ $6611        ; ...that many times
       jne  _6611                                          ;                   
       movb h,a                                            ; LD A,H            ; 
       ; XOR C                                             ; XOR C             ; TODO: check code. has Y changed sign?
       jlt  !                                              ; JP P,$6621        ; no - go store it
       b    @stardust_store_y                              ;                   
!
       movb @b255,@>08(ix)                                 ; LD (IX+$08),$FF   ; yes - passed the centre, flag it for respawning
       jmp  _6627                                          ; JR $6627          ; 
stardust_store_y:                                          ; >6621
       movb @l,@>02(ix)                                    ; LD (IX+$02),L     ; 
       movb h,@>03(ix)                                     ; LD (IX+$03),H     ; store the new Y
_6627:                                                     ; >6627
       .ret                                                ; RET               ; 

********************************************************************************
* Stardust: move or respawn a particle in the left view
* 
* Called by the CALL at $6944 in #R$68CD, which #R$645B patches for the
* left view (#R$64C9).
* .
* In the left view the stardust streams from right to left. A particle
* flagged for respawning is placed on the right edge (X=88) at a random
* height within 63 of the centre, and given a random speed by passing
* #R$6805 a random direction (both components 4-7). Otherwise (at $665C)
* it's moved left by four times the size of its Y velocity, which serves as
* its speed here (at $6677 for a negative velocity); its Y doesn't change.
* 
* I:F Z set to move the particle, clear to respawn it
* I:IX Pointer to the particle
stardust_left_view:                                        ; >6628
       jeq  stardust_move_left                             ; JR Z,$665C        ; not flagged for respawning - go move it
_662a:                                                     ; >662a
       .call @random_byte                                  ; CALL $2176        ; pick a random Y...
       movb a,@l                                           ; LD L,A            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6634        ; 
       b    @stardust_left_random_y                        ;                   
!
       neg a                                               ; NEG               ; 
stardust_left_random_y:                                    ; >6634
       cb   a,@bytes+>40                                   ; CP $40            ; 
       jhe  _662a                                          ; JR NC,$662A       ; ...within 63 of the centre
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb @l,@>03(ix)                                    ; LD (IX+$03),L     ; set Y
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb @bytes+>58,@>01(ix)                            ; LD (IX+$01),$58   ; X = 88 (right edge)
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>0300                                        ; AND $03           ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 
       movb a,b                                            ; LD B,A            ; B = random 4-7
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>0300                                        ; AND $03           ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 
       movb a,@c                                           ; LD C,A            ; C = random 4-7
       .call @stardust_set_velocity                        ; CALL $6805        ; set a random velocity
       jmp  _6681                                          ; JR $6681          ; 
stardust_move_left:                                        ; >665c
       movb *ix,@l                                         ; LD L,(IX+$00)     ; 
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; HL = X
       movb @>06(ix),@e                                    ; LD E,(IX+$06)     ; 
       movb @>07(ix),d                                     ; LD D,(IX+$07)     ; DE = Y velocity (the speed)
       czc  @bit7,d                                        ; BIT 7,D           ; 
       jhe  !                                              ; JP M,$6677        ; negative - add it instead
       b    @stardust_move_left_negative                   ;                   
!
       s    de,hl                                          ; SBC HL,DE         ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       s    de,hl                                          ; SBC HL,DE         ; X = X - 4 * speed
       jmp  _667b                                          ; JR $667B          ; 
stardust_move_left_negative:                               ; >6677
       a    de,hl                                          ; ADD HL,DE         ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       a    de,hl                                          ; ADD HL,DE         ; X = X - 4 * |speed|
_667b:                                                     ; >667b
       movb @l,*ix                                         ; LD (IX+$00),L     ; 
       movb h,@>01(ix)                                     ; LD (IX+$01),H     ; store the new X
_6681:                                                     ; >6681
       .ret                                                ; RET               ; 

********************************************************************************
* Stardust: move or respawn a particle in the right view
* 
* Called by the CALL at $6944 in #R$68CD, which #R$645B patches for the
* right view (#R$64DD).
* .
* The mirror image of #R$6628: in the right view the stardust streams from
* left to right, so particles respawn on the left edge (X=-87) and are
* moved right (at $66B6, and $66CD for a negative velocity).
* 
* I:F Z set to move the particle, clear to respawn it
* I:IX Pointer to the particle
stardust_right_view:                                       ; >6682
       jeq  stardust_move_right                            ; JR Z,$66B6        ; not flagged for respawning - go move it
_6684:                                                     ; >6684
       .call @random_byte                                  ; CALL $2176        ; pick a random Y...
       movb a,@l                                           ; LD L,A            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$668E        ; 
       b    @stardust_right_random_y                       ;                   
!
       neg a                                               ; NEG               ; 
stardust_right_random_y:                                   ; >668e
       cb   a,@bytes+>40                                   ; CP $40            ; 
       jhe  _6684                                          ; JR NC,$6684       ; ...within 63 of the centre
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb @l,@>03(ix)                                    ; LD (IX+$03),L     ; set Y
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb @bytes+>a9,@>01(ix)                            ; LD (IX+$01),$A9   ; X = -87 (left edge)
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>0300                                        ; AND $03           ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 
       movb a,b                                            ; LD B,A            ; B = random 4-7
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>0300                                        ; AND $03           ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 
       movb a,@c                                           ; LD C,A            ; C = random 4-7
       .call @stardust_set_velocity                        ; CALL $6805        ; set a random velocity
       jmp  _66db                                          ; JR $66DB          ; 
stardust_move_right:                                       ; >66b6
       movb *ix,@l                                         ; LD L,(IX+$00)     ; 
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; HL = X
       movb @>06(ix),@e                                    ; LD E,(IX+$06)     ; 
       movb @>07(ix),d                                     ; LD D,(IX+$07)     ; DE = Y velocity (the speed)
       czc  @bit7,d                                        ; BIT 7,D           ; 
       jhe  !                                              ; JP M,$66CD        ; negative - subtract it instead
       b    @stardust_move_right_negative                  ;                   
!
       a    de,hl                                          ; ADD HL,DE         ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       a    de,hl                                          ; ADD HL,DE         ; X = X + 4 * speed
       jmp  _66d5                                          ; JR $66D5          ; 
stardust_move_right_negative:                              ; >66cd
       s    de,hl                                          ; SBC HL,DE         ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       s    de,hl                                          ; SBC HL,DE         ; X = X + 4 * |speed|
_66d5:                                                     ; >66d5
       movb @l,*ix                                         ; LD (IX+$00),L     ; 
       movb h,@>01(ix)                                     ; LD (IX+$01),H     ; store the new X
_66db:                                                     ; >66db
       .ret                                                ; RET               ; 

********************************************************************************
* Stardust: rotate about the centre of the view
* 
* Used by the routines at #R$67B5, #R$67C3, #R$67ED and #R$67F7.
* .
* Used for roll in the front and rear views, and for pitch in the side
* views. Rotates every particle's pixel position (X,Y) about the centre
* of the view by the angle whose cosine and sine are given in HL and DE:
* X' = X*cos - Y*sin, Y' = X*sin + Y*cos. The multiplications are done
* with logarithms: #R$1FCF converts cos and sin to logs, X and Y are
* converted using the log table at $0800 (tagging the sign into bit 6 of
* the high byte), and #R$2160 adds a pair of logs to give the product.
* Then #R$6805 sets the particle's velocity from its new position.
* 
* I:HL Cosine (sign-magnitude, from the roll or pitch coefficients)
* I:DE Sine (sign-magnitude)
stardust_rotate:                                           ; >66dc
       .call @log_sign_tagged                              ; CALL $1FCF        ; convert cos to a log
       mov  hl,@stardust_log_cos                           ; LD ($E779),HL     ; and save it
       .ex_de_hl                                           ; EX DE,HL          ; 
       .call @log_sign_tagged                              ; CALL $1FCF        ; convert sin to a log
       mov  hl,@stardust_log_sin                           ; LD ($E77B),HL     ; and save it
       mov  @reclaimed_range_start,ix                      ; LD IX,($EFA6)     ; IX -> the stardust table
       movb @bytes+>0f,b                                   ; LD B,$0F          ; B = 15 particles
stardust_rotate_particle:                                  ; >66ef
       .push bc                                            ; PUSH BC           ; 
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; A = X
       socb a,a                                            ; OR A              ; 
       .push af                                            ; PUSH AF           ; save its sign
       jlt  !                                              ; JP P,$66FA        ; 
       b    @stardust_rotate_log_x                         ;                   
!
       neg a                                               ; NEG               ; A = |X|
stardust_rotate_log_x:                                     ; >66fa
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@stardust_log_x_lookup+>0001                 ; LD ($66FF),A      ; point the LD at the table entry for |X| (#R$66FE+1)
stardust_log_x_lookup:                                     ; >66fe
       mov  @log_table,hl                                  ; LD HL,($0800)     ; HL = log |X|
       .pop af                                             ; POP AF            ; 
       jlt  !                                              ; JP P,$6707        ; 
       b    @stardust_rotate_save_log_x                    ;                   
!
       socb @bit6,h                                        ; SET 6,H           ; tag the sign of X
stardust_rotate_save_log_x:                                ; >6707
       mov  hl,@stardust_log_x                             ; LD ($E77D),HL     ; save log X
       movb @>03(ix),a                                     ; LD A,(IX+$03)     ; A = Y
       socb a,a                                            ; OR A              ; 
       .push af                                            ; PUSH AF           ; save its sign
       jlt  !                                              ; JP P,$6714        ; 
       b    @stardust_rotate_log_y                         ;                   
!
       neg a                                               ; NEG               ; A = |Y|
stardust_rotate_log_y:                                     ; >6714
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@stardust_log_y_lookup+>0001                 ; LD ($6719),A      ; point the LD at the table entry for |Y| (#R$6718+1)
stardust_log_y_lookup:                                     ; >6718
       mov  @log_table,hl                                  ; LD HL,($0800)     ; HL = log |Y|
       .pop af                                             ; POP AF            ; 
       jlt  !                                              ; JP P,$6721        ; 
       b    @stardust_rotate_save_log_y                    ;                   
!
       socb @bit6,h                                        ; SET 6,H           ; tag the sign of Y
stardust_rotate_save_log_y:                                ; >6721
       mov  hl,@stardust_log_y                             ; LD ($E77F),HL     ; save log Y
       mov  @stardust_log_sin,bc                           ; LD BC,($E77B)     ; 
       .call @multiply_logs                                ; CALL $2160        ; HL = Y * sin
       .ex_de_hl                                           ; EX DE,HL          ; 
       mov  @stardust_log_x,hl                             ; LD HL,($E77D)     ; 
       mov  @stardust_log_cos,bc                           ; LD BC,($E779)     ; 
       .call @multiply_logs                                ; CALL $2160        ; HL = X * cos
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; X' = X * cos - Y * sin
       movb @l,@>01(ix)                                    ; LD (IX+$01),L     ; store the new X
       mov  @stardust_log_x,hl                             ; LD HL,($E77D)     ; 
       mov  @stardust_log_sin,bc                           ; LD BC,($E77B)     ; 
       .call @multiply_logs                                ; CALL $2160        ; HL = X * sin
       .ex_de_hl                                           ; EX DE,HL          ; 
       mov  @stardust_log_y,hl                             ; LD HL,($E77F)     ; 
       mov  @stardust_log_cos,bc                           ; LD BC,($E779)     ; 
       .call @multiply_logs                                ; CALL $2160        ; HL = Y * cos
       a    de,hl                                          ; ADD HL,DE         ; Y' = X * sin + Y * cos
       movb @l,@>03(ix)                                    ; LD (IX+$03),L     ; store the new Y
       movb @l,a                                           ; LD A,L            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$675C        ; 
       b    @stardust_rotate_abs_y                         ;                   
!
       neg a                                               ; NEG               ; 
stardust_rotate_abs_y:                                     ; >675c
       movb a,b                                            ; LD B,A            ; B = |Y|
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6766        ; 
       b    @stardust_rotate_abs_x                         ;                   
!
       neg a                                               ; NEG               ; 
stardust_rotate_abs_x:                                     ; >6766
       movb a,@c                                           ; LD C,A            ; C = |X|
       .call @stardust_set_velocity                        ; CALL $6805        ; set the velocity, pointing away from the centre
       li   de,>000b                                       ; LD DE,$000B       ; 
       a    de,ix                                          ; ADD IX,DE         ; IX -> next particle
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DEC B             ; 
       jeq  !                                              ; JP NZ,$66EF       ; loop for all 15 particles
       b    @stardust_rotate_particle                      ;                   
!
       .ret                                                ; RET               ; 

********************************************************************************
* Stardust: move up or down
* 
* Used by the routines at #R$67CD, #R$67D3, #R$67DD and #R$67E3.
* .
* Used for pitch in the front and rear views, and for roll in the side
* views. Converts the sine in HL to a signed pixel count and adds it to
* every particle's Y, then sets its velocity from its new position
* (#R$6805).
* 
* I:HL Sine (sign-magnitude, from the roll or pitch coefficients)
stardust_move_vertically:                                  ; >6775
