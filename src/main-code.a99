********************************************************************************
* Flight controls off
* 
* Set by #R$1A7D, which also stops any roll and pitch, when the escape
* capsule is launched (#R$19FC), the Torus jump drive is engaged (#R$86E6)
* or a hyperspace jump starts (#R$894D). Cleared when the Torus jump ends
* or is cut short (#R$13FD, at $14CD and $14F1), when the escape capsule's
* countdown runs out (#R$2810), on the title screen (#R$1C5C, at $1DC8) and
* by #R$707D. While it's set, #R$401C ignores the flight controls and every
* key but the pause key, attacking ships don't fire (#R$26A9, at $26E0) and
* there are no collisions (#R$8755, at $876A).
flight_controls_off:                                       ; >ef8e
       byte >00

********************************************************************************
* Per-object flag (see #R$EF99's sibling)
* 
* Cleared alongside #R$EF99 by #R$422E; set (unconditionally, $FF) at
* $42CA within #R$4255's body; read by two
* object-type render handlers (#R$254C, and a further site at $27B6)
* to gate their own bodies.
ef98_per_object_flag:                                      ; >ef98
       byte >00

********************************************************************************
* Object in the laser sights
* 
* Cleared for each object by #R$422E and set by #R$4735 (at $4779) when
* it's in the laser sights; #R$28F6 only lets the laser hit it when it's
* set.
in_sights:                                                 ; >ef99
       byte >00

********************************************************************************
* Identify the target
* 
* Set by the 'I' key (#R$1B0D); the next object in the laser sights has
* its name shown (#R$4735), which clears it.
identify_target:                                           ; >ef9d
       byte >00

********************************************************************************
* VRAM-write-in-progress busy flag
* 
* Set to $FF (suppress) while a screen/VRAM update is under way and
* cleared to 0 (allow) once it's done. #R$3955 and
* #R$70E8/#R$7139 bracket each individual VRAM fill
* this way, set-then-clear in quick succession; #R$63F1
* (enter_flight_mode) holds it set across a longer stretch (through
* #R$7139 and #R$6433) before clearing it once at the end - so the
* flag marks "don't touch VRAM right now" for however long that takes,
* not a single atomic operation. Read by #R$7202's own header ("if
* ($EF9E) is clear") to skip certain VBlank-time work while any of
* these are in progress, avoiding VRAM contention.
vram_busy_flag:                                            ; >ef9e
       byte >00

********************************************************************************
* Flag-nibble search result index (cached)
* 
* #R$6D24's own header describes the search (four flag-nibble bytes
* at $F779/$F781/$F77A/$F782 checked against ($EB9A)'s bit pattern);
* this caches the result (D) alongside $F818 (C) at its tail ($6D6F).
* No read site found for this specific cache in this capture.
flag_search_result_cache:                                  ; >efa0
       byte >02

********************************************************************************
* Stardust table address / reclaimed-memory range start (word)
* 
* Confirmed by the same $7003 disassembly as #R$EFA4's description:
* `LD HL,$6F9F / LD ($EFA6),HL` stores this routine's own start
* address. #R$6882 and
* #R$68EA load it directly as `IX,($EFA6)`, and it's also loaded
* within #R$66DC (at $66E9), #R$6775 (at $677E), #R$6956 (at $6963)
* and #R$699C (at $69A8) - the 15-particle stardust table (see #R$68CD),
* which occupies the reclaimed $6F9F-$7043 space.
reclaimed_range_start:                                     ; >efa6
       data startup_code_stardust_table

********************************************************************************
* RG1SAV: copy of VDP register 1
* 
* The MSX BIOS's copy of VDP register 1. #R$6F9F sets the sprite size to
* 16x16 in it, and #R$70E8 clears bit 6 (blanking the screen) and writes it
* to the VDP.
vdp_reg1_cache:                                            ; >f3e0
       byte >E2

********************************************************************************
* Address of the cockpit screen picture (word)
* 
* Holds $CAD7, the cockpit picture (#R$CAD7). Saved here from HL by the
* one-time startup code (#R$6F9F, step 1), and read by #R$7139, which
* unpacks the picture (#R$390E) when entering flight.
cockpit_picture_addr:                                      ; >f740
       data cockpit_picture

********************************************************************************
* Main-loop tick/frame counter (16-bit)
* 
* Advanced once per pass of #R$0106's main loop (`LD HL,($F746) / INC
* HL / LD ($F746),HL` at $010F-$0113) - counts loop passes, not VBlanks.
* Also read by the routines at #R$13FD (at $140F) and #R$422E (at $4249).
main_loop_tick_counter:                                    ; >f746
       data >0000

********************************************************************************
* VBlank sub-tick counter since the last loop pass
* 
* Incremented by the RST $38 handler (#R$7202, see #R$0038's own
* comment) on every VBlank interrupt. Zeroed right after ($F746) is
* advanced, at $0117 (and again at $1E61), then polled until >=7 at
* #R$1EBC - a "wait a few frames" gate distinct from the free-running
* ($F746) counter.
vblank_subtick_counter:                                    ; >f748
       byte >03

********************************************************************************
* The ends of the line being drawn
* 
* The x, y and z (words) of the two ends of a ship's laser beam (#R$43C2)
* or an edge (#R$496D) in the view, kept so that #R$4B22 can clip the line
* where it passes the player when one end is behind: $F769-$F76E is the end
* behind the player, $F76F-$F774 the end in front.
line_end_1_x:                                              ; >f769
       byte >00,>00                                                  ; 
line_end_1_y:                                              ; >f76b
       byte >00,>00                                                  ; 
line_end_1_z:                                              ; >f76d
       byte >00,>00                                                  ; 
line_end_2_x:                                              ; >f76f
       byte >00,>00                                                  ; 
line_end_2_y:                                              ; >f771
       byte >00,>00                                                  ; 
line_end_2_z:                                              ; >f773
       byte >00,>00                                                  ; 

********************************************************************************
* Equipment item 1: Fuel level, in tenths of a light year (0-70)
* 
* The first entry of the 14-entry, 1-byte-per-item equipment array that
* #R$5DD9's page indexes - see that routine's comment for the full
* item list (#R$0FFC's order) and the selector cascade that reads this
* array (#R$5E1F onward). Fuel and Missiles (#R$F776) are the two
* special-cased items; this one is read/written directly as a 0-70
* counter by #R$5E7D/#R$5E8B/#R$5EBB and drawn as a dashboard dial by
* #R$6AAD.
* .
* The other entries: missiles (#R$F776) are a count. A laser's entry
* (#R$F779, #R$F77A, #R$F781, #R$F782) has bit 7 set, plus a bit for each
* mount it's fitted to - bit 0 front, 1 rear, 2 left, 3 right (#R$5EFE,
* #R$6D24). Any other item is 0 if it isn't fitted and 1 if it is (#R$5EE4
* allows only one), except that the energy unit (#R$F77E) is 2 for a naval
* one (#R$91DB).
fuel_level:                                                ; >f775
       byte >00

********************************************************************************
* Equipment item 2: Missile count
* 
* The second entry of the equipment array (#R$5DD9). On the equipment
* page, #R$5ED1 refuses a purchase at exactly 4 (a full rack). Drawn on
* the flight dashboard as a 4-segment indicator by #R$6B6E, called
* alongside the fuel dial (#R$F775) from the same full-redraw routine
* (#R$6433) - classic Elite's four missile pylon lights.
missile_count:                                             ; >f776
       byte >00

********************************************************************************
* Equipment item 5: Pulse Laser
* 
* See #R$F777 for the equipment. For a laser, bit 7 is always set
* (marking it as a laser, see #R$6355), and bits 0-3 are the mounts it's
* fitted to: front, rear, left and right (#R$6D24). The default commander
* has a pulse laser on the front mount ($81).
item_pulse_laser:                                          ; >f779
       byte >00

********************************************************************************
* Equipment item 6: Beam Laser
* 
* See #R$F779.
item_beam_laser:                                           ; >f77a
       byte >00

********************************************************************************
* Equipment item 13: Mining Laser
* 
* See #R$F779.
item_mining_laser:                                         ; >f781
       byte >00

********************************************************************************
* Equipment item 14: Military Laser
* 
* See #R$F779.
item_military_laser:                                       ; >f782
       byte >00

********************************************************************************
* Object status
* 
* Byte 0 of the 40-byte record of the object being processed (copied
* from the object table, #R$EBA0, by #R$13FD). Bit 0: in use. Bit 2:
* can't be shot (#R$4735). Bit 3: no collisions (#R$8755), and the
* orientation isn't rotated (#R$221B) - bits 2 and 3 are set for the
* planet, the sun and explosions (#R$31AD). Bit 5: hostile (#R$2528).
* Bit 6: no bounty when it's destroyed (#R$2556) - set for missiles and
* cargo when they're created (#R$2D7E, #R$8DB9), and for anything destroyed
* by a collision (#R$8755), the ECM (#R$323C) or the energy bomb (#R$329E).
* Bit 7: the roof vector has been worked out since
* the orientation last changed (#R$4599).
object_status_byte:                                        ; >f7cd
       byte >81

********************************************************************************
* Position X (word), per-object workspace
* 
* The object's position is (x, y, z) at $F7CE, $F7D0 and $F7D2 (see
* #R$EBA0). The player's roll and pitch (#R$221B, #R$22C0) rotate it every
* frame. Part of the object being processed, with #R$F7CD.
object_position_x:                                         ; >f7ce
       byte >00                                                      ; 
position_x_hi:                                             ; >f7cf
       byte >00                                                      ; 

********************************************************************************
* Position Y (word), per-object workspace
* 
* Second word of the same position vector - see #R$F7CE's own
* comment. Within the same per-object workspace as #R$F7CD.
object_position_y:                                         ; >f7d0
       byte >00                                                      ; 
position_y_hi:                                             ; >f7d1
       byte >00                                                      ; 

********************************************************************************
* Position Z, low byte (per-object workspace)
* 
* Low byte of the position vector's third word (Z) - #R$F7D3 is its
* high byte, doubling as the position's Z sign. Within the same
* per-object workspace as #R$F7CD.
object_position_z_lo:                                      ; >f7d2
       byte >C0

********************************************************************************
* Side vector
* 
* The object's orientation, as three unit vectors: the side vector here
* (x, y, z), the nose vector (#R$F7DA) and the roof vector (#R$F7E0).
* Each component is sign-magnitude, with 1.0 = $4000. A vertex at (x, y,
* z) in the blueprint is at x * side + y * roof + z * nose (#R$4464).
side_vector:                                               ; >f7d4
       byte >00,>40                                                  ; 
side_vector_y:                                             ; >f7d6
       byte >00,>00                                                  ; 
side_vector_z:                                             ; >f7d8
       byte >00,>00                                                  ; 

********************************************************************************
* Nose vector
* 
* See #R$F7D4. Used for docking (#R$87DD) and ships' laser beams
* (#R$43C2).
nose_vector:                                               ; >f7da
       byte >00                                                      ; 
nose_vector_x_hi:                                          ; >f7db
       byte >00                                                      ; 
nose_vector_y:                                             ; >f7dc
       byte >08,>00                                                  ; 
nose_vector_z:                                             ; >f7de
       byte >01                                                      ; 

********************************************************************************
* Roof vector
* 
* See #R$F7D4. Worked out as nose x side (#R$4599).
roof_vector:                                               ; >f7e0
       byte >00,>00                                                  ; 
roof_vector_y:                                             ; >f7e2
       byte >6A,>37                                                  ; 
roof_vector_z:                                             ; >f7e4
       byte >07,>A0

********************************************************************************
* Speed
* 
* The object's speed: #R$866D moves it forward by this much (scaled by
* its distance, see #R$8B66) along its axis vector each frame. Set at
* spawn (#R$3037) from byte $0D of the ship's blueprint (see #R$A817),
* unless the spawning code has set it to 0, and changed by 4 per frame
* by #R$2869 - increased up to the maximum in $F802 while ($F7F4) is set,
* otherwise reduced. The death scene (#R$1703) slows its debris down every
* 4th frame.
object_speed:                                              ; >f7e6
       byte >00

********************************************************************************
* Ship type
* 
* The working object's ship type: its blueprint number in the table at
* #R$A7D7, which lists them all (1 the Space Station, 2 a missile, 3 a
* cargo canister, ... $1F the Constrictor), or $64 for the planet and
* $65 for the sun. Byte $1A of the 40-byte object record copied to
* #R$F7CD.
ship_type:                                                 ; >f7e7
       byte >0A

********************************************************************************
* Rotations since the orientation was straightened out
* 
* Counted by the rotation routines (#R$221B, #R$22C0); at 200, #R$4503
* straightens out the orientation and resets it.
rotation_count:                                            ; >f7e8
       byte >60

********************************************************************************
* Energy
* 
* The object's energy: set at spawn (#R$3037) from byte $0C of its
* blueprint (see #R$A817), and reduced by laser hits (#R$291E) and
* collisions (#R$8755). When it runs out, the object is destroyed.
object_energy:                                             ; >f7e9
       byte >00

********************************************************************************
* Missiles
* 
* How many missiles the object has: set at spawn (#R$3037) from bits 0-6
* of byte $13 of its blueprint (see #R$A817). While it has any, each
* laser hit gives a 20/256 chance that it fires one back (#R$291E); a
* Thargoid releases its Thargons instead (#R$2A94, which zeroes this).
object_missiles:                                           ; >f7ea
       byte >00

********************************************************************************
* Turn number
* 
* 1-3, given to each object in turn when it's added to the object table
* (#R$3037, from #R$E92F); some handler work is done only on the object's
* turn (#R$2542), i.e. every third frame.
turn_number:                                               ; >f7ed
       byte >02

********************************************************************************
* Handler type
* 
* Which handler (#R$2528) runs for the object each frame, from the table
* at #R$288D: 0 none, 1 explosion, 2 space station, 3 the player's
* missile, 4-12 ships' tactics, 14 a missile fired at the player.
handler_type:                                              ; >f7ee
       byte >00

********************************************************************************
* Handler countdown
* 
* Used by the handlers (#R$2528): the length of a turning phase or of
* flying on (#R$2758, #R$27A1), an explosion's countdown (#R$2556), and
* for the player's missile the slot of its target (#R$2D7E, #R$25B9).
handler_countdown:                                         ; >f7ef
       byte >00

********************************************************************************
* Per-type parameter block
* 
* Tail of the 40-byte per-object workspace starting at #R$F7CD (the LDIR
* at #R$13FD/#R$1703 copies exactly 40 bytes, ending here at $F7F4). Its
* meaning depends on the handler type. For the ship handler types (4-12):
* .
* #R$F7F0 is the turn rate for the first turn-away phase, whose length
* is #R$F7EF (just before this block); $F7F1/$F7F2 are the second
* phase's length and rate (see #R$2758 and #R$281E). $F7F3 is the handler
* type to switch to after turning away. $F7F4 is #R$2869's speed-up flag
* (1 = speed up, 0 = slow down).
* .
* For explosions (type 1, #R$2556), #R$F7F0 is a value stepped by an
* amount derived from #R$F7EF's countdown, upwards (saturating at $FF)
* normally and downwards once the game is over. #R$4AEC also uses
* #R$F7F0 as an index into the page-$0800 log table.
per_type_parameter_block:                                  ; >f7f0
       byte >00
turn_phase_2_length:                                       ; >f7f1
       byte >00                                                      ; 
turn_phase_2_rate:                                         ; >f7f2
       byte >00                                                      ; 
next_handler_type:                                         ; >f7f3
       byte >00                                                      ; 
speed_up_flag:                                             ; >f7f4
       byte >00                                                      ; 

********************************************************************************
* Blueprint: vertex data
* 
* Bytes $00-$01 of the object's blueprint header (copied to $F7F5-$F80E
* by #R$16E3, see #R$A817): the address of its vertices.
bp_vertices:                                               ; >f7f5
       data ship_letter_i_vertices

********************************************************************************
* Blueprint: edge data
* 
* Bytes $02-$03 of the object's blueprint header (see #R$F7F5): the
* address of its edges.
bp_edges:                                                  ; >f7f7
       data ship_letter_i_edges

********************************************************************************
* Blueprint: faces
* 
* Bytes $04-$05 of the object's blueprint header (see #R$F7F5): the
* address of its faces, drawn by #R$4255: each an optional scale byte and
* normal (#R$F804), then a count and the numbers of its edges.
bp_faces:                                                  ; >f7f9
       data ship_letter_i_faces

********************************************************************************
* Blueprint: name
* 
* Bytes $06-$07 of the object's blueprint header (see #R$F7F5): the
* address of its name, shown by the 'I' key (#R$4735) and the title
* screen (#R$1C5C).
bp_name:                                                   ; >f7fb
       data ship_letter_i_vertices

********************************************************************************
* Blueprint: number of faces
* 
* Byte $08 of the object's blueprint header (see #R$F7F5).
bp_face_count:                                             ; >f7fd
       byte >01

********************************************************************************
* Blueprint: number of edges
* 
* Byte $09 of the object's blueprint header (see #R$F7F5). #R$4255 clears
* one byte per edge at $E7B6.
bp_edge_count:                                             ; >f7fe
       byte >0C

********************************************************************************
* Blueprint: number of vertices
* 
* Byte $0A of the object's blueprint header (see #R$F7F5). #R$4255 clears
* one byte per vertex at $E784.
bp_vertex_count:                                           ; >f7ff
       byte >0C

********************************************************************************
* Blueprint: targetable area
* 
* Byte $0B of the object's blueprint header (see #R$F7F5): how close to
* the crosshairs the object has to be to be hit by the laser (projected
* by #R$46CA for #R$4735). For an explosion, #R$4255 puts its size here.
bp_targetable_area:                                        ; >f800
       byte >00

********************************************************************************
* Blueprint: faces have normals
* 
* Byte $0F of the object's blueprint header (see #R$F7F5): nonzero if
* each face in the face list (#R$F7F9) starts with a scale byte and a
* normal, used to hide the faces that face away (#R$4255).
bp_face_normals:                                           ; >f804
       byte >00

********************************************************************************
* Blueprint: size
* 
* Byte $10 of the object's blueprint header (see #R$F7F5): how close
* things come to it before they collide (#R$8755) or a missile hits it
* (#R$25FF).
bp_size:                                                   ; >f805
       byte >0C

********************************************************************************
* Fore shield
* 
* Recharged by one (up to $18) each regeneration tick (#R$1928), drawn on the
* dashboard by #R$6B48, and reduced by #R$193F when the player is hit from in
* front. Damage it can't absorb is taken from the energy (#R$F817).
fore_shield:                                               ; >f80f
       byte >00

********************************************************************************
* Aft shield
* 
* Like #R$F80F, but reduced when the player is hit from behind, and drawn
* by #R$6B54.
aft_shield:                                                ; >f810
       byte >00

********************************************************************************
* Cabin temperature gauge
* 
* Worked out by #R$1577 from the distance to the sun (#R$E725): the
* closer, the hotter. Drawn by #R$6AD0. Above $15, the fuel scoop works
* (#R$1577) and the alert level rises (#R$E90C).
cabin_temperature:                                         ; >f811
       byte >00

********************************************************************************
* Altitude gauge
* 
* Quantized by #R$15CB from ($E727), drawn by #R$6AC4. Triggers
* "Altitude Low" (#R$15E7) once below 4.
altitude_gauge:                                            ; >f812
       byte >00

********************************************************************************
* Laser temperature gauge
* 
* Goes up by 2 each time the laser fires (#R$2AD0, at $2AF8), which it won't
* do once this reaches 48, and down by 2 (#R$190D) every 16 frames - or 8
* or 4 with an energy unit (#R$18E6). Drawn halved by #R$6B60.
laser_temp_gauge:                                          ; >f813
       byte >00

********************************************************************************
* Speed (cached at #R$E87A on hyperspace engage)
* 
* Read by #R$1577 (update_altitude_and_e725_gauges_then_scoop) as the
* speed, gating the Fuel Scoop's activation on being "fast enough".
* #R$6805 scales the stardust's velocity by it. Cached to #R$E87A when a hyperspace jump is engaged.
speed_gauge_value:                                         ; >f814
       byte >00

********************************************************************************
* Roll rate
* 
* -16 to +16. Ramped by the roll keys (#R$6A15), and stopped when they're
* released with option D (#R$6BE1). #R$2209 sets up the rotation from it.
roll_rate:                                                 ; >f815
       byte >00

********************************************************************************
* Pitch rate
* 
* -16 to +16. Ramped by the pitch keys (#R$6A15), and stopped when
* they're released with option D (#R$6BE1). #R$2212 sets up the rotation
* from it.
pitch_rate:                                                ; >f816
       byte >00

********************************************************************************
* Energy gauge
* 
* Drawn by #R$6A88, and topped up by #R$190D (see #R$E944) to at most $60.
* Drained by #R$19EC: by 1 every other frame while the cloaking device or
* the ECM jammer is on (#R$13FD), and by any shield damage left over once
* the shields (#R$F80F/#R$F810) are down (#R$193F). Below $18, "Energy Low"
* is shown (#R$15E7).
energy_gauge:                                              ; >f817
       byte >00

********************************************************************************
* Current view's laser
* 
* The type of laser fitted to the current view (#R$6D24): 0 pulse, 1
* mining, 2 beam, 3 military, or $FF (negative) for none - when the laser
* can't be fired (#R$2AD0) and nothing is in its sights (#R$4735). On the
* Equip Ship screen, #R$5EFE uses it to hold the item number of the laser
* being bought instead (4, 12, 5 or 13; see #R$5AC3).
view_laser_type:                                           ; >f818
       byte >FF

********************************************************************************
* Laser cooldown
* 
* How many frames must pass between shots of the current view's laser,
* set by #R$6D82 for the laser type. Loaded into #R$F81B when the laser
* fires.
laser_cooldown:                                            ; >f819
       byte >00

********************************************************************************
* Laser power
* 
* The damage the current view's laser does per hit (#R$291E), set by
* #R$6D82 for the laser type.
laser_power:                                               ; >f81a
       byte >00
