* The message "Hit key for mission"
       .msxalign >1ef9
msg_hit_key_mission:                                       ; >1ef9
       text 'Hit key for missio',>ee

********************************************************************************
* Multiply: 8-bit x 8-bit -> 8-bit, unsigned, truncated
* 
* Used by the routines at #R$4BA8, #R$6164 and #R$63AA.
* .
* A = D * E via the standard double-and-add algorithm, using the same
* SRL-B/INC-B/DJNZ early-exit trick as #R$1F86 (see there for how that
* works) but on a single 8-bit accumulator/multiplicand pair instead of a
* 24-bit one - so the result silently truncates if the true product
* would exceed 255.
multiply_d_e_8bit:                                         ; >1f51
       movb d,r1                                           ;                   ; (TI: with MPY)
       srl  r1,8                                           ;                   ; 
       movb @e,r0                                          ;                   ; 
       srl  r0,8                                           ;                   ; 
       mpy  r0,r1                                          ;                   ; R1:R2 = D * E
       swpb r2                                             ;                   ; 
       movb r2,a                                           ;                   ; A = its low byte, as on the MSX
       rt                                                  ; RET               ; 

********************************************************************************
* Multiply: HL = L * L, or A * E
* 
* Used by the routines at #R$205D and #R$8570.
* .
* Returns L squared. The entry at $1F60 returns A * E, unsigned: a shift
* and add multiplication, looping once for each bit of A (its bit length,
* from the table at #R$0200).
* 
* I:L The number to square
* O:HL The product
square_l:                                                  ; >1f5e
       movb @l,a                                           ; LD A,L            ; 
       movb a,@e                                           ; LD E,A            ; A = E = L
* This entry point is used by the routines at #R$2FF9, #R$3D76, #R$3DF4,
* #R$4C2B, #R$4C80, #R$4EEC, #R$50AA, #R$512F, #R$525F, #R$5524, #R$5E6B,
* #R$6164, #R$6A59, #R$6AAD, #R$6BB3 and #R$6BCA.
multiply_a_e_16bit:                                        ; >1f60
       movb a,r0                                           ; LD L,A            ; R0 = A
       srl  r0,8                                           ; LD H,$02          ; 
       movb @e,r1                                          ; LD B,(HL)         ; R1 = E
       srl  r1,8                                           ; LD D,$00          ; 
       mpy  r0,r1                                          ; ADD HL,DE         ; R1:R2 = A * E (the shift-and-add loop on the Z80)
       mov  r2,hl                                          ;                   ; HL = the product
       rt                                                  ; RET               ; 

********************************************************************************
* Multiply: 8-bit x 16-bit -> 16-bit, unsigned
* 
* Used by the routines at #R$5AC7, #R$5C01 and #R$5D72.
* .
* Same algorithm as #R$1F60 (same $0200 bit-length table, same RRA-driven
* double-and-add), but the multiplicand is the caller's HL rather than a
* second 8-bit value in E.
multiply_a_hl_16bit:                                       ; >1f73
       movb a,r0                                           ;                   ; (TI: with MPY)
       srl  r0,8                                           ;                   ; 
       mpy  hl,r0                                          ;                   ; R0:R1 = A * HL
       mov  r1,hl                                          ;                   ; HL = the low word, as on the MSX
       rt                                                  ; RET               ; 

********************************************************************************
* Multiply: 16-bit x 8-bit -> 24-bit, unsigned
* 
* Used by the routines at #R$24A7, #R$24D1, #R$4B76, #R$848D and #R$8F94.
* .
* Computes (A:HL) = HL * A via the standard double-and-add algorithm: for
* each set bit of the multiplier (A, tested from bit 0 upward via SRL),
* adds the current (doubling) 24-bit multiplicand C:DE into the 24-bit
* accumulator A:HL, then doubles C:DE ready for the next bit. The
* multiplicand starts zero-extended from the caller's 16-bit HL (C is
* cleared); the caller's DE is clobbered and plays no part in the result.
* .
* The INC B/DJNZ pair works around SRL B destroying B as a loop counter:
* SRL shifts the next multiplier bit into carry, and INC undoes DJNZ's
* decrement so B ends the iteration holding exactly that shifted value:
* the loop exits as soon as it reaches 0, so a multiplier with few
* significant bits needs fewer doublings than a full 8 (an early exit,
* not a fixed-length loop).
* 
* I:A 8-bit unsigned multiplier
* I:HL 16-bit unsigned multiplicand
* O:A Bits 16-23 of the product
* O:HL Bits 0-15 of the product
multiply_16x8:                                             ; >1f86
       movb a,r0                                           ; LD B,A            ; R0 = the multiplier
       srl  r0,8                                           ;                   ; 
       mov  hl,r1                                          ; EX DE,HL          ; R1 = the multiplicand
       mpy  r0,r1                                          ; ADD HL,DE         ; R1:R2 = HL * A (the double-and-add loop on the Z80)
       mov  r2,hl                                          ;                   ; HL = bits 0-15 of the product
       swpb r1                                             ;                   ; 
       movb r1,a                                           ; ADC A,C           ; A = bits 16-23
       rt                                                  ; RET               ; 

********************************************************************************
* Integer square root
* 
* Used by the routines at #R$2054 and #R$8570.
* .
* Returns the square root of A:HL, rounded down, using the usual
* bit-by-bit method: two bits of the number are brought down into the
* remainder (A:HL) at a time, and the trial value - the root so far with
* binary 01 appended (C:D:$40) - is subtracted if it fits, giving the next
* bit of the root. The number is first shifted left 6 bits so that it
* fills the 24 bits, so it must be less than $40000 (2^18), giving a root
* of up to 511 in 9 steps. Used for distances (#R$2054) and by the compass
* (#R$8570).
* 
* I:A:HL Number (less than $40000)
* O:HL Its square root
square_root:                                               ; >1f9c
* TI: a binary search with MPY. For the values that occur (up to 2 * 255^2)
* it gives the same root as the MSX's restoring square root.
       movb a,ix                                           ;                   ; IX = the number's high word (A)
       srl  ix,8                                           ;                   ; 
       clr  bc                                             ;                   ; BC = the root so far
       li   de,>0100                                       ;                   ; DE = the next bit to try
_1f9c_bit:                                                 
       mov  bc,r0                                          ;                   ; 
       soc  de,r0                                          ;                   ; R0 = the root with this bit
       mov  r0,r1                                          ;                   ; 
       mpy  r0,r1                                          ;                   ; R1:R2 = its square
       c    r1,ix                                          ;                   ; 
       jh   _1f9c_next                                     ;                   ; too big
       jl   _1f9c_keep                                     ;                   ; 
       c    r2,hl                                          ;                   ; 
       jh   _1f9c_next                                     ;                   ; too big
_1f9c_keep:                                                
       mov  r0,bc                                          ;                   ; keep the bit
_1f9c_next:                                                
       srl  de,1                                           ;                   ; 
       jne  _1f9c_bit                                      ;                   ; 
       mov  bc,hl                                          ; LD H,C / LD L,D   ; HL = the root
       rt                                                  ; RET               ; 

********************************************************************************
* Convert a sign-magnitude value to a sign-tagged logarithm
* 
* Used by the routines at #R$433F, #R$66DC and #R$8685.
* .
* Takes the top 9 bits of HL's 15-bit magnitude (HL >> 6) as an index
* into the word table at $0800-$0BFF, which holds log2(n) * 1024 for
* n = 0-511 (log2(1)=$0000, log2(2)=$0400, log2(4)=$0800 and so on). If HL was negative, sets bit 6 of the result's high byte to
* tag the sign. #R$2160 adds two such logs to multiply the values.
* 
* I:HL Value (sign-magnitude: bit 7 of H is the sign)
* O:HL Its logarithm, with bit 6 of H set if the value was negative
log_sign_tagged:                                           ; >1fcf
       mov  hl,r2                                          ; BIT 7,H           ; R2 = HL, to test its sign at the end
       mov  hl,r1                                          ; LD A,H            ; 
       srl  r1,5                                           ; RRA               ; R1 = HL >> 5...
       andi r1,>03fe                                       ; AND $03           ; ...as an even byte offset: the word index HL >> 6
       mov  @log_table(r1),hl                              ; LD A,(HL)         ; HL = the table entry
       mov  r2,r2                                          ; EX AF,AF'         ; 
       jlt  !                                              ; RET Z             ; HL was non-negative - return as-is
       rt                                                  ;                   ; 
!
       socb @bit6,h                                        ; SET 6,H           ; else tag bit 6 of the result's high byte
       rt                                                  ; RET               ; 

********************************************************************************
* Convert a logarithm back to a value (antilog)
* 
* Used by the routine at #R$2160.
* .
* The inverse of #R$1FCF's log lookup: indexes the byte table at
* $0400-$07FF (an exponential curve, rising to 250 at the top) by
* HL >> 4, and returns the byte found there. Called by #R$2160 once it
* has added two logs, to turn the sum into the product.
* 
* I:HL Logarithm (as returned by #R$1FCF, or a sum of two)
* O:HL The corresponding value (0-255)
antilog:                                                   ; >1ff2
       mov  hl,r1                                          ; LD A,H            ; 
       srl  r1,4                                           ; RRA               ; R1 = HL >> 4...
       andi r1,>03fe                                       ; AND $03           ; ...as an even byte offset: the word index HL >> 5
       movb @antilog_table(r1),@l                          ; LD L,(HL)         ; L = the high byte of the entry (the first byte on the TI)
       sb   h,h                                            ; LD H,$00          ; zero-extend it into HL
       rt                                                  ; RET               ; 

********************************************************************************
* Multiply two vector components
* 
* Used by the routines at #R$439D, #R$4503, #R$4599 and #R$8E62.
* .
* Returns HL * DE / $4000, where 1.0 is $4000: the inputs are
* sign-magnitude, the result a two's complement number. A shift-and-add
* multiplication, looping once for each bit of HL's magnitude (its bit
* length, from the table at #R$0200: its high byte's plus 8, or at $2028,
* if the high byte is 0, its low byte's).
* 
* I:HL First (sign-magnitude)
* I:DE Second (sign-magnitude)
* O:HL Product (two's complement)
multiply_components:                                       ; >200a
       mov  hl,r0                                          ; LD A,H            ; 
       xor  de,r0                                          ; XOR D             ; R0 bit 15 = the sign of the product
       mov  hl,r1                                          ; RES 7,D           ; 
       andi r1,>7fff                                       ;                   ; R1 = |first number|
       mov  de,r2                                          ;                   ; 
       andi r2,>7fff                                       ;                   ; R2 = |second number|
       mpy  r2,r1                                          ; ADD IY,DE         ; R1:R2 = the product (the shift-and-add loop on the Z80)
       sla  r1,2                                           ; RLA               ; 
       srl  r2,14                                          ; ADC HL,HL         ; 
       soc  r2,r1                                          ;                   ; 
       mov  r1,hl                                          ;                   ; HL = the product / $4000
       mov  r0,r0                                          ; EX AF,AF'         ; the sign
       jlt  !                                              ; RET P             ; positive - done
       rt                                                  ;                   ; 
!
       neg  hl                                             ; SUB L             ; negative: negate HL
       rt                                                  ; RET               ; 

********************************************************************************
* Distance between two points on a chart
* 
* Used by the routine at #R$6141.
* .
* Returns 4 * sqrt(dx^2 + dy^2) for the points (D,E) and (B,C), from
* #R$205D's squared distance and #R$1F9C's square root.
* 
* I:B,C One point
* I:D,E The other point
* O:HL Four times the distance between them
distance_between_two_2d_points_d:                          ; >2054
       .proc                                               ;                   ; 
       bl   @squared_distance_2d                           ; CALL $205D        ; 
       bl   @square_root                                   ; CALL $1F9C        ; 
       sla  hl,2                                           ; ADD HL,HL x 2     ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Squared distance between two 2D points: (D,E) and (B,C)
* 
* Used by the routines at #R$2054, #R$5325 and #R$538B.
* .
* Computes dx=|E-C| and dy=|D-B|, squares each via #R$1F5E (using the
* alternate register set to hold dx's square across the second call),
* then adds them: HL = dx^2 + dy^2. A's bit 0 on return holds any carry
* out of the 16-bit sum (ADC A,A folding the final #R$1F5E's overflow in).
squared_distance_2d:                                       ; >205d
       movb @e,r0                                          ; LD A,E            ; (TI: with MPY)
       srl  r0,8                                           ;                   ; 
       movb @c,r1                                          ;                   ; 
       srl  r1,8                                           ;                   ; 
       s    r1,r0                                          ; SUB C             ; 
       abs  r0                                             ; NEG               ; dx
       mpy  r0,r0                                          ; CALL $1F5E        ; R1 = dx^2
       mov  r1,hl                                          ;                   ; 
       movb d,r0                                           ; LD A,D            ; 
       srl  r0,8                                           ;                   ; 
       movb b,r1                                           ;                   ; 
       srl  r1,8                                           ;                   ; 
       s    r1,r0                                          ; SUB B             ; 
       abs  r0                                             ; NEG               ; dy
       mpy  r0,r0                                          ; CALL $1F5E        ; R1 = dy^2
       sb   a,a                                            ; XOR A             ; 
       a    r1,hl                                          ; ADD HL,DE         ; 
       jnc  _205d_end                                      ; ADC A,A           ; A:HL = dx^2 + dy^2
       movb one,a                                          ;                   ; 
_205d_end:                                                 
       rt                                                  ; RET               ; 

********************************************************************************
* Divide: 16-bit / 8-bit -> 16-bit, unsigned
* 
* Used by the routines at #R$1C5C, #R$265E, #R$281E, #R$4DAB, #R$4EEC, #R$4F37,
* #R$512F, #R$525F, #R$5D72, #R$5E6B, #R$6A59, #R$6AAD, #R$6BB3, #R$6BCA and
* #R$9BB2.
* .
* HL = HL/A via standard restoring division (16 iterations, shift-subtract-
* restore). Frequently paired with #R$1F60 (multiply then divide, i.e.
* scale a value by a fraction) - see e.g. #R$6A59/#R$6AAD/#R$6BB3/#R$6BCA's
* dashboard gauges.
* 
* I:HL Dividend
* I:A Divisor
* O:HL Quotient
divide_hl_a:                                               ; >2079
       movb a,r0                                           ; LD E,A            ; 
       srl  r0,8                                           ; LD D,$00          ; R0 = the divisor
       jne  !                                              ;                   ; 
       seto hl                                             ;                   ; dividing by 0 gives $FFFF, as the restoring division does
       rt                                                  ;                   ; 
!
       clr  r1                                             ; LD H,D            ; 
       mov  hl,r2                                          ; LD C,L            ; R1:R2 = the dividend
       div  r0,r1                                          ; SBC HL,DE         ; R1 = the quotient, R2 = the remainder
       mov  r1,hl                                          ; LD H,A            ; HL = the quotient
       rt                                                  ; RET               ; 

********************************************************************************
* Divide: 24-bit / 10, extracting one decimal digit
* 
* Used by the routines at #R$3675 and #R$5E6B.
* .
* Same shift-subtract-restore shape as #R$2079's 16-bit divide, but
* hardwired to divide by 10 and widened to a 24-bit dividend (verified
* by simulation, e.g. 65535 -> quotient 6553, remainder 5). This is the
* standard single step of converting a binary value to decimal one
* digit at a time - #R$3675 loops it until the quotient reaches zero,
* collecting a full digit string; #R$5E8B makes one call on its own,
* keeping only the quotient and discarding the remainder digit, to
* strip a fractional decimal place from a fixed-point product.
* 
* I:C Dividend, low byte
* I:L Dividend, middle byte
* I:H Dividend, high byte
* O:A Remainder (the extracted digit, 0-9)
* O:C Quotient, low byte
* O:L Quotient, middle byte
* O:H Quotient, high byte
divide_c_l_h_by_10:                                        ; >20c6
       li   r2,10                                          ; XOR A             ; (TI: two DIVs instead of the 24-step shift and subtract)
       clr  r0                                             ; LD B,$18          ; 
       mov  hl,r1                                          ;                   ; 
       div  r2,r0                                          ;                   ; R0 = H:L / 10, R1 = the remainder
       mov  r0,hl                                          ;                   ; H:L = the quotient's upper 16 bits
       swpb r1                                             ;                   ; 
       movb @c,@r1lb                                       ;                   ; R1 = the remainder * 256 + C
       clr  r0                                             ;                   ; 
       div  r2,r0                                          ;                   ; R0 = that / 10 (< 256), R1 = the remainder
       swpb r0                                             ;                   ; 
       movb r0,@c                                          ;                   ; C = the quotient's low byte
       swpb r1                                             ;                   ; 
       movb r1,a                                           ;                   ; A = the remainder (the digit)
       rt                                                  ; RET               ; 

********************************************************************************
* Divide HL:DE by 100000
* 
* Used by the routine at #R$6051.
* .
* Used by #R$6051 to show the free space in the hold, which is held in
* grams, in tenths of a tonne. A restoring division by 100000 kept in the
* shadow CHL: shifts the dividend left a bit at a time into CHL, and
* subtracts 100000 from it if it can (at $210D), shifting the quotient
* bits in at the bottom of the dividend.
* 
* I:HL:DE Dividend
* O:HL:DE Quotient
divide_by_100000:                                          ; >20e1
       .proc                                               ;                   ; (TI: / 1000, then / 100, with DIV)
       li   r2,1000                                        ;                   ; 
       bl   @divide_hl_de_by_r2                            ;                   ; 
       li   r2,100                                         ;                   ; 
       bl   @divide_hl_de_by_r2                            ;                   ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Divide DE:HL by 1000
* 
* Used by the routine at #R$5B4D.
* .
* Used by #R$5B4D to show amounts of cargo, which are held in grams, in
* kilograms or tonnes. A restoring division, like #R$20E1's, by 1000 kept
* in the shadow BC. The entry at $2134 (a single trial subtraction) is
* also the target of the unused jump-table entry at $00A0 (see
* #R$003B).
* 
* I:DE:HL The 32-bit dividend
* O:DE:HL The quotient
divide_by_1000:                                            ; >211c
       li   r2,1000                                        ;                   ; (TI: with DIV)
* TI-specific: divide the 32-bit HL:DE by R2, with two DIVs
*
* I:HL:DE The dividend (HL the high word)
* I:R2 The divisor
* O:HL:DE The quotient
* O:R1 The remainder
divide_hl_de_by_r2:                                        
       clr  r0                                             ;                   ; 
       mov  hl,r1                                          ;                   ; 
       div  r2,r0                                          ;                   ; R0 = HL / R2, R1 = the remainder
       mov  r0,hl                                          ;                   ; HL = the quotient's high word
       mov  r1,r0                                          ;                   ; 
       mov  de,r1                                          ;                   ; 
       div  r2,r0                                          ;                   ; R0 = (the remainder:DE) / R2, R1 = the remainder
       mov  r0,de                                          ;                   ; DE = the quotient's low word
       rt                                                  ; RET               ; 

********************************************************************************
* Twist the seeds once
* 
* Used by the routine at #R$4CE7.
* .
* Turns the three 16-bit seeds (s0, s1, s2) at #R$E904 into (s1, s2, s0 +
* s1 + s2), as in BBC Elite.
twist_seeds:                                               ; >2147
       movb @system_seeds+1,hl                             ; LD HL,($E904)     ; HL = the oldest slot
       movb @system_seeds,@l                               ;                   ; 
       movb @seed_s1+1,de                                  ; LD DE,($E906)     ; DE = the middle slot
       movb @seed_s1,@e                                    ;                   ; 
       movb @seed_s2+1,bc                                  ; LD BC,($E908)     ; BC = the newest slot
       movb @seed_s2,@c                                    ;                   ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = oldest+middle
       a    bc,hl                                          ; ADD HL,BC         ; HL = oldest+middle+newest (the new sum)
       movb de,@system_seeds+1                             ; LD ($E904),DE     ; shift: middle becomes the new oldest
       movb @e,@system_seeds                               ;                   ; 
       movb bc,@seed_s1+1                                  ; LD ($E906),BC     ; shift: newest becomes the new middle
       movb @c,@seed_s1                                    ;                   ; 
       movb hl,@seed_s2+1                                  ; LD ($E908),HL     ; the sum becomes the new newest
       movb @l,@seed_s2                                    ;                   ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Multiply two sign-tagged logarithms
* 
* Used by the routines at #R$4464, #R$47A1, #R$66DC and #R$86DC.
* .
* Adds two logs from #R$1FCF (or the log table at $0800) and converts the
* sum back with #R$1FF2, giving the product; the result is negated if
* exactly one of the two was tagged negative (bit 6 of the high byte).
* Returns 0 if the sum overflows 16 bits ($2172).
* 
* I:HL Sign-tagged log of the first value
* I:BC Sign-tagged log of the second value
* O:HL The signed product
multiply_logs:                                             ; >2160
       .proc
       mov  hl,r2                                          ; LD A,H            ; 
       xor  bc,r2                                          ; XOR B             ; R2 bit 14 = the product's sign
       a    bc,hl                                          ; ADD HL,BC         ; add the logs
       joc  overflow_case_return_0                         ; JR C,$2172        ; overflow - return 0
       bl   @antilog                                       ; CALL $1FF2        ; HL = antilog
       andi r2,>4000                                       ; EX AF,AF'         ; 
       jeq  multiply_logs_exit                             ; RET P             ; positive - done
!
       neg  hl                                             ; SUB L             ; negative: negate HL
       jmp  multiply_logs_exit                             ; RET               ; 
overflow_case_return_0:                                    ; >2172
       clr  hl                                             ; LD HL,$0000       ; 
multiply_logs_exit:
       .endproc                                            ; RET               ; 

********************************************************************************
* Generate a random byte
* 
* Used by the routines at #R$13FD, #R$1703, #R$193F, #R$1DDC, #R$25B9, #R$26A9,
* #R$27DF, #R$281E, #R$2859, #R$28F6, #R$2A1C, #R$2A94, #R$2B05, #R$2C21,
* #R$2C3C, #R$2D3B, #R$3326, #R$3EAD, #R$50AA, #R$64F1, #R$656B, #R$6628,
* #R$6682, #R$6882, #R$707D, #R$894D, #R$8DB9, #R$8E51 and #R$8F25.
* .
* The game's random number generator: shifts and XORs the three bytes at
* $E936-$E938, returning one of them. Seeded from the R register at startup
* (#R$6F9F).
* 
* O:A A random byte
random_byte:                                               ; >2176
       clr  r0                                             ;                   ; 
       movb @rng_state_3,r0                                ; LD A,($E938)      ; R0 = the third byte
       movb @rng_state_2,a                                 ; LD A,($E937)      ; 
       movb a,@rng_state_3                                 ; LD ($E938),A      ; the second byte moves into the third
       sla  r0,1                                           ; RL L              ; shift the third byte left...
       cb   a,@bytes+>80                                   ; CP $80            ; ...with carry = the second byte < $80
       jhe  !                                              ;                   ; 
       ori  r0,>0100                                       ;                   ; 
!
       clr  r1                                             ;                   ; 
       movb @prng_state,r1                                 ; LD A,($E936)      ; R1 = the first byte
       movb r1,@rng_state_2                                ; LD ($E937),A      ; the first byte moves into the second
       srl  r1,1                                           ; RRA               ; shift it right...
       czc  @bit0,a                                        ;                   ; ...with carry = bit 0 of the second byte
       jeq  !                                              ;                   ; 
       ori  r1,>8000                                       ;                   ; 
!
       xor  r0,r1                                          ; XOR L             ; 
       movb r1,a                                           ;                   ; 
       movb a,@prng_state                                  ; LD ($E936),A      ; the new first byte
       rt                                                  ; RET               ; 

********************************************************************************
* Convert a logarithm back to a value (16-bit antilog)
* 
* Used by the routines at #R$2191, #R$46CA, #R$47F0 and #R$84A6.
* .
* Returns 2^(HL/1024) from the antilog table at #R$0400, indexed by HL / 32
* - the full 16-bit version of #R$1FF2, which returns only the high byte.
* Returns $FFFF ($21C0) if HL is $4000 or more, i.e. the result wouldn't
* fit in 16 bits.
* 
* I:HL Logarithm (log2(n) * 1024)
* O:HL The value
antilog16:                                                 ; >21a3
       movb h,a                                            ; LD A,H            ; 
       czc  @bit6,a                                        ; BIT 6,A           ; HL >= $4000?
       jne  antilog16_overflow                             ; JR NZ,$21C0       ; too big - return $FFFF
       mov  hl,r1                                          ; RRA               ; 
       srl  r1,4                                           ; RR L              ; R1 = HL >> 4...
       andi r1,>03fe                                       ; AND $03           ; ...as an even byte offset: the word index HL >> 5
       mov  @antilog_table(r1),hl                          ; LD A,(HL)         ; HL = 2^(log / 1024)
       rt                                                  ; RET               ; 
antilog16_overflow:                                        ; >21c0
       seto hl                                             ; LD HL,$FFFF       ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Add a 4-byte number at (HL) to one at (DE)
* 
* Used by the routines at #R$5C01 and #R$8BA6.
* .
* A 32-bit add, low byte first. Used to add a unit of cargo to the hold
* (#R$5C01, #R$8BF9).
* 
* I:DE Pointer to the number to add to
* I:HL Pointer to the number to add
add_4byte_de_hl:                                           ; >21c4
* TI: a native 32-bit add, leaving HL and DE unchanged (on the MSX they
* end up 4 bytes on; every caller saves them)
       movb @1(de),r0                                      ;                   ; R0 = the low word at DE
       movb *de,@r0lb                                      ;                   ; 
       movb @1(hl),r1                                      ;                   ; R1 = the low word at HL
       movb *hl,@r1lb                                      ;                   ; 
       a    r1,r0                                          ;                   ; 
       movb @r0lb,*de                                      ;                   ; (MOVB leaves the carry alone)
       movb r0,@1(de)                                      ;                   ; 
       movb @3(de),r0                                      ;                   ; R0 = the high word at DE
       movb @2(de),@r0lb                                   ;                   ; 
       jnc  _21c4_no_carry                                 ;                   ; 
       inc  r0                                             ;                   ; 
_21c4_no_carry:                                            
       movb @3(hl),r1                                      ;                   ; R1 = the high word at HL
       movb @2(hl),@r1lb                                   ;                   ; 
       a    r1,r0                                          ;                   ; 
       movb @r0lb,@2(de)                                   ;                   ; 
       movb r0,@3(de)                                      ;                   ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Subtract a 4-byte value at (HL) from the 4-byte value at (DE)
* 
* Used by the routines at #R$5D72 and #R$63E0.
* .
* #R$21C4's subtract counterpart: DE -= HL, byte by byte with borrow
* propagation.
* 
* I:DE -> The 4-byte accumulator (updated in place)
* I:HL -> The 4-byte value to subtract
subtract_4byte_de_hl:                                      ; >21cf
* TI: a native 32-bit subtraction, leaving HL and DE unchanged
       movb @1(de),r0                                      ;                   ; R0 = the low word at DE
       movb *de,@r0lb                                      ;                   ; 
       movb @1(hl),r1                                      ;                   ; R1 = the low word at HL
       movb *hl,@r1lb                                      ;                   ; 
       s    r1,r0                                          ;                   ; (carry clear = a borrow)
       movb @r0lb,*de                                      ;                   ; 
       movb r0,@1(de)                                      ;                   ; 
       movb @3(de),r0                                      ;                   ; R0 = the high word at DE
       movb @2(de),@r0lb                                   ;                   ; 
       joc  _21cf_no_borrow                                ;                   ; 
       dec  r0                                             ;                   ; 
_21cf_no_borrow:                                           
       movb @3(hl),r1                                      ;                   ; R1 = the high word at HL
       movb @2(hl),@r1lb                                   ;                   ; 
       s    r1,r0                                          ;                   ; 
       movb @r0lb,@2(de)                                   ;                   ; 
       movb r0,@3(de)                                      ;                   ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Look up the rotation coefficients for a turn rate
* 
* Used by the routines at #R$2209, #R$2212, #R$2365 and #R$23D9.
* .
* Copies the 6-byte record for turn rate |A| to DE: the cos and sin of
* |A| half-degrees from the table at #R$121B (|A| up to 40), or the
* 30-degree record at #R$2522 for |A| = 127. If A is negative, sets bit
* 7 of the copy's last byte (the top of the sin value), which makes
* #R$24A7 turn the other way. Used to set up the live roll and pitch
* tables (#R$2209, #R$2212) and objects' own turns (#R$2365, #R$23D9).
* 
* I:A Turn rate (-40 to 40, or -127/127)
* I:DE Where to copy the record
lookup_rotation_coeffs:                                    ; >21da
       socb a,a                                            ; OR A              ; 
       .push af                                            ; PUSH AF           ; save the sign
       jgt  lookup_rotation_coeffs_abs                     ; JP P,$21E1        ; 
       jeq  lookup_rotation_coeffs_abs                     ;                   ; 
!
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = |rate|
lookup_rotation_coeffs_abs:                                ; >21e1
       cb   a,@bytes+>7f                                   ; CP $7F            ; 127?
       jne  _21ea                                          ; JR NZ,$21EA       ; no - use the table
       li   hl,rotation_30_degrees                         ; LD HL,$2522       ; yes - use the 30-degree record
       jmp  _21f6                                          ; JR $21F6          ; 
_21ea:                                                     ; >21ea
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       movb h,b                                            ; LD B,H            ; 
       movb @l,@c                                          ; LD C,L            ; BC = |rate| * 2
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL = |rate| * 6
       li   bc,trig_table_fine                             ; LD BC,$121B       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> the record in the table
_21f6:                                                     ; >21f6
       .ldi                                                ; LDI               ; copy the 6-byte record to DE
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .pop af                                             ; POP AF            ; 
       jlt  !                                              ; RET P             ; rate positive - done
       rt                                                  ;                   
!
       dec  de                                             ; DEC DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; HL -> the copy's last byte
       socb @bit7,*hl                                      ; SET 7,(HL)        ; negative: set bit 7 to turn the other way
       rt                                                  ; RET               ; 

********************************************************************************
* Refresh the live "cos"-role rotation table from the roll rate at $F815
* 
* Used by the routines at #R$1837 and #R$6BE1.
refresh_roll_table:                                        ; >2209
       movb @roll_rate,a                                   ; LD A,($F815)      ; 
       li   de,live_roll_coeff_table                       ; LD DE,$EB76       ; #R$22C0's table
       b    @lookup_rotation_coeffs                        ; JP $21DA          ; 

********************************************************************************
* Refresh the live "cos"-role rotation table from the pitch rate at $F816
* 
* Used by the routine at #R$6BE1.
refresh_pitch_table:                                       ; >2212
       movb @pitch_rate,a                                  ; LD A,($F816)      ; 
       li   de,live_pitch_coeff_table                      ; LD DE,$EB7C       ; #R$221B's table
       b    @lookup_rotation_coeffs                        ; JP $21DA          ; 

********************************************************************************
* Apply the player's pitch to the object (its position, side and nose vectors)
* 
* Used by the routine at #R$13FD.
* .
* Uses the live coefficient table at $EB7C (refreshed from the pitch
* rate at $F816 by #R$2212) to apply one #R$2450-style rotation step to
* three separate 2D coordinate pairs:
* .
* - ($F7D0,$F7D2) always, via a plain call to #R$2450;
* - ($F7D6,$F7D8) and ($F7DC,$F7DE) as well, but only when bit 3 of
* the object status byte at $F7CD is clear - done inline here
* (repeating #R$2450's rotate-then-normalize pattern by hand,
* calling #R$24D1/#R$24A7 directly, rather than calling #R$2450
* itself) so there is no inline counterpart to #R$2450's own
* $7FFF/$8000/$7F92 overflow saturation.
* .
* #R$22C0 rotates the same three pairs' *other* halves ($F7CE, $F7D4,
* $F7DA) around a different axis, using its own table at $EB76. Since
* $F7D0 is written by both this routine and #R$22C0, (F7CE,F7D0,F7D2) is
* really one 3D vector being rotated first around one axis then the
* other - likewise (F7D4,F7D6,F7D8) and (F7DA,F7DC,F7DE). The first is the
* object's position, which is always rotated; the other two are its side
* and nose vectors (#R$F7D4, #R$F7DA). Each
* inline half is written back in sign-magnitude form (magnitude in
* the low 15 bits, sign in the high byte's bit 7) - the same
* representation #R$2450 normalizes its own BC/DE inputs into at
* entry, and #R$24D1/#R$24A7 expect throughout.
* 
* I:$F7D0/$F7D2/$F7D6/$F7D8/$F7DC/$F7DE The three vectors' second halves
* I:$F7CD Object status byte (bit 3 gates the two orientation vectors)
step_pitch_rotation:                                       ; >221b
       .proc                                               ;                   ; 
       li   ix,live_pitch_coeff_table                      ; LD IX,$EB7C       ; IX -> the live pitch-rotation coefficient table
       mov  @object_position_y,bc                          ; LD BC,($F7D0)     ; BC = y
       mov  @object_position_z,de                          ; LD DE,($F7D2)     ; DE = z
       bl   @rotate_pair                                   ; CALL $2450        ; rotate (y, z) by one pitch step
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; store y'
       mov  de,@object_position_z                          ; LD ($F7D2),DE     ; store z'
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       movb *hl,r0                                         ; BIT 3,(HL)        ; the planet, the sun or an explosion?
       andi r0,>0800                                       ;                   ; 
       jne  _221b_end                                      ; RET NZ            ; yes - only its position turns
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; the roof vector needs working out again (#R$4599)
       ab   one,@rotation_count                            ; LD HL,$F7E8 / INC (HL); count the rotation (see #R$4503)
       li   r1,side_vector_y                               ; LD HL,($F7D6) ... ; rotate (side.y, side.z)...
       bl   @rotate_axis_pair                              ; ... LD ($F7D6),HL ; (TI: in a shared routine)
       li   r1,nose_vector_y                               ; LD HL,($F7DC) ... ; ...and (nose.y, nose.z)
       bl   @rotate_axis_pair                              ; ... LD ($F7DC),HL ; 
_221b_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Apply the player's roll to the object (its position, side and nose vectors)
* 
* Used by the routine at #R$13FD.
* .
* The companion to #R$221B: uses the live coefficient table at $EB76
* (refreshed from the roll rate at $F815 by #R$2209) to rotate the
* *other* half of the same three vectors #R$221B rotates - ($F7CE,
* $F7D0) always via #R$2450, plus ($F7D4,$F7D6) and ($F7DA,$F7DC) when
* bit 3 of $F7CD is clear, applied inline the same way #R$221B does.
* See that routine for the full picture: together the two calls rotate
* three 3D vectors: the object's position (always updated) and its side
* and nose vectors (#R$F7D4, #R$F7DA), unless it's the planet, the sun
* or an explosion (bit 3 of #R$F7CD).
* 
* I:$F7CE/$F7D0/$F7D4/$F7D6/$F7DA/$F7DC The three vectors' first halves
* I:$F7CD Object status byte (bit 3 gates the two orientation vectors)
step_roll_rotation:                                        ; >22c0
       .proc                                               ;                   ; 
       li   ix,live_roll_coeff_table                       ; LD IX,$EB76       ; IX -> the live roll-rotation coefficient table
       mov  @object_position_x,bc                          ; LD BC,($F7CE)     ; BC = x
       mov  @object_position_y,de                          ; LD DE,($F7D0)     ; DE = y
       bl   @rotate_pair                                   ; CALL $2450        ; rotate (x, y) by one roll step
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; store x'
       mov  de,@object_position_y                          ; LD ($F7D0),DE     ; store y'
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       movb *hl,r0                                         ; BIT 3,(HL)        ; the planet, the sun or an explosion?
       andi r0,>0800                                       ;                   ; 
       jne  _22c0_end                                      ; RET NZ            ; yes - only its position turns
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; the roof vector needs working out again (#R$4599)
       ab   one,@rotation_count                            ; LD HL,$F7E8 / INC (HL); count the rotation (see #R$4503)
       li   r1,side_vector                                 ; LD HL,($F7D4) ... ; rotate (side.x, side.y)...
       bl   @rotate_axis_pair                              ; ... LD ($F7D4),HL ; (TI: in a shared routine)
       li   r1,nose_vector                                 ; LD HL,($F7DA) ... ; ...and (nose.x, nose.y)
       bl   @rotate_axis_pair                              ; ... LD ($F7DA),HL ; 
_22c0_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Pitch the object by angle A
* 
* Used by the routines at #R$1C5C, #R$1E5A, #R$2758 and #R$2EB2.
* .
* Sets the nose vector to nose * cos + roof * sin, using the rotation
* record for angle A (#R$21DA) at #R$E7FC. The roof vector, which is the
* cross product of the nose and side vectors, is worked out first
* (#R$4599) and marked as needing working out again afterwards (bit 7 of
* #R$F7CD). Counts the rotation in #R$F7E8, so that #R$4503 can straighten
* the orientation every so often.
* 
* I:A The angle, in half-degrees (see #R$21DA)
pitch_object:                                              ; >2365
       .proc
       li   de,pitch_roll_rotation                         ; LD DE,$E7FC       ; set up the rotation record for angle A
       bl   @lookup_rotation_coeffs                        ; CALL $21DA        ; (#R$21DA)
       li   ix,pitch_roll_rotation                         ; LD IX,$E7FC       ; IX -> the rotation record
       bl   @work_out_roof                                 ; CALL $4599        ; make sure the roof vector is up to date (#R$4599)
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; it will need working out again
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; HL = roof.x
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.x * sin (#R$24A7)
       .push hl                                            ; PUSH HL           ; save it
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; HL = nose.x
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = nose.x * cos (#R$24D1)
       .pop de                                             ; POP DE            ; 
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = nose.x * cos + roof.x * sin
       jgt  pitch_object_nose_x                            ; JP P,$2393        ; positive - store it
       jeq  pitch_object_nose_x                            ;                   ; 
!
       neg  hl                                             ; SUB L             ; negate HL
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
pitch_object_nose_x:                                       ; >2393
       mov  hl,@nose_vector                                ; LD ($F7DA),HL     ; store the new nose.x
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; HL = roof.y
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.y * sin
       .push hl                                            ; PUSH HL           ; 
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = nose.y
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = nose.y * cos
       .pop de                                             ; POP DE            ; 
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = nose.y * cos + roof.y * sin
       jgt  pitch_object_nose_y                            ; JP P,$23B2        ; positive - store it
       jeq  pitch_object_nose_y                            ;                   ; 
!
       neg  hl                                             ; SUB L             ; negate HL
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
pitch_object_nose_y:                                       ; >23b2
       mov  hl,@nose_vector_y                              ; LD ($F7DC),HL     ; store the new nose.y
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; HL = roof.z
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.z * sin
       .push hl                                            ; PUSH HL           ; 
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; HL = nose.z
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = nose.z * cos
       .pop de                                             ; POP DE            ; 
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = nose.z * cos + roof.z * sin
       jgt  pitch_object_nose_z                            ; JP P,$23D1        ; positive - store it
       jeq  pitch_object_nose_z                            ;                   ; 
!
       neg  hl                                             ; SUB L             ; negate HL
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
pitch_object_nose_z:                                       ; >23d1
       mov  hl,@nose_vector_z                              ; LD ($F7DE),HL     ; store the new nose.z
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       ab   one,*hl                                        ; INC (HL)          ; count the rotation
       .endproc                                            ; RET               ; 

********************************************************************************
* Roll the object by angle A
* 
* Used by the routines at #R$1C5C, #R$254C, #R$2758, #R$27B3 and #R$2EB2.
* .
* Sets the side vector to side * cos - roof * sin, using the rotation
* record for angle A (#R$21DA) at #R$E7FC. Otherwise the same as #R$2365.
* 
* I:A The angle, in half-degrees (see #R$21DA)
roll_object:                                               ; >23d9
       .proc
       li   de,pitch_roll_rotation                         ; LD DE,$E7FC       ; set up the rotation record for angle A
       bl   @lookup_rotation_coeffs                        ; CALL $21DA        ; (#R$21DA)
       li   ix,pitch_roll_rotation                         ; LD IX,$E7FC       ; IX -> the rotation record
       bl   @work_out_roof                                 ; CALL $4599        ; make sure the roof vector is up to date (#R$4599)
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; it will need working out again
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; HL = side.x
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = side.x * cos (#R$24D1)
       .push hl                                            ; PUSH HL           ; save it
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; HL = roof.x
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.x * sin (#R$24A7)
       .pop de                                             ; POP DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = side.x * cos - roof.x * sin
       jgt  roll_object_side_x                             ; JP P,$2408        ; positive - store it
       jeq  roll_object_side_x                             ;                   ; 
!
       neg  hl                                             ; SUB L             ; negate HL
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
roll_object_side_x:                                        ; >2408
       mov  hl,@side_vector                                ; LD ($F7D4),HL     ; store the new side.x
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; HL = side.y
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = side.y * cos
       .push hl                                            ; PUSH HL           ; 
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; HL = roof.y
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.y * sin
       .pop de                                             ; POP DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = side.y * cos - roof.y * sin
       jgt  roll_object_side_y                             ; JP P,$2428        ; positive - store it
       jeq  roll_object_side_y                             ;                   ; 
!
       neg  hl                                             ; SUB L             ; negate HL
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
roll_object_side_y:                                        ; >2428
       mov  hl,@side_vector_y                              ; LD ($F7D6),HL     ; store the new side.y
       mov  @side_vector_z,hl                              ; LD HL,($F7D8)     ; HL = side.z
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = side.z * cos
       .push hl                                            ; PUSH HL           ; 
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; HL = roof.z
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.z * sin
       .pop de                                             ; POP DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = side.z * cos - roof.z * sin
       jgt  roll_object_side_z                             ; JP P,$2448        ; positive - store it
       jeq  roll_object_side_z                             ;                   ; 
!
       neg  hl                                             ; SUB L             ; negate HL
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
roll_object_side_z:                                        ; >2448
       mov  hl,@side_vector_z                              ; LD ($F7D8),HL     ; store the new side.z
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       ab   one,*hl                                        ; INC (HL)          ; count the rotation
       .endproc                                            ; RET               ; 

********************************************************************************
* Rotate a pair of coordinates
* 
* Used by the routines at #R$221B and #R$22C0.
* .
* Used by #R$221B and #R$22C0. Returns X' = X.cos - Y.sin and Y' = X.sin +
* Y.cos, with the rotation's cos (IX+0 to IX+2, #R$24D1) and sin (IX+3 to
* IX+5, #R$24A7), converting the coordinates to sign-magnitude first.
* Results out of range are saturated to -32768 or +32767 - except that, by
* a bug, a Y' below -32768 becomes $7F92 (at $249F), a large positive
* number: an overflow of the addition with carry set is a negative one,
* so it should be -32768.
* 
* I:BC Signed X coordinate
* I:DE Signed Y coordinate
* I:IX Pointer to the 6-byte rotation-coefficient table
* O:HL Rotated X'
* O:DE Rotated Y'
rotate_pair:                                               ; >2450
       .proc                                               ;                   ; 
       abs  bc                                             ; BIT 7,B           ; X to sign-magnitude...
       jgt  _245c                                          ; JR Z,$245C        ; (ABS sets the status from the value before)
       jeq  _245c                                          ;                   ; 
       ori  bc,>8000                                       ; XOR A / SUB C / ... / OR $80; 
_245c:                                                     ; >245c
       abs  de                                             ; BIT 7,D           ; ...and Y
       jgt  _2468                                          ; JR Z,$2468        ; 
       jeq  _2468                                          ;                   ; 
       ori  de,>8000                                       ; XOR A / SUB E / ... / OR $80; 
_2468:                                                     ; >2468
       .push bc                                            ; PUSH BC           ; save X (at -6(SP) below)
       .push de                                            ; PUSH DE           ; save Y (at -4(SP))
       mov  bc,hl                                          ; LD H,B / LD L,C   ; 
       bl   @multiply_by_cos                               ; CALL $24D1        ; X.cos
       .push hl                                            ; EX (SP),HL        ; save it (at -2(SP))
       mov  @-4(sp),hl                                     ;                   ; HL = Y
       bl   @multiply_by_sin                               ; CALL $24A7        ; Y.sin
       mov  @-2(sp),r0                                     ; POP DE / EX DE,HL ; R0 = X.cos
       s    hl,r0                                          ; OR A / SBC HL,DE  ; X' = X.cos - Y.sin
       jno  _2486                                          ; JP PO,$2486       ; no overflow - use it as-is
       jlt  _2483                                          ; JR C,$2483        ; overflow, with the true X' positive?
       li   r0,>8000                                       ; LD HL,$8000       ; no: -32768
       jmp  _2486                                          ; JR $2486          ; 
_2483:                                                     ; >2483
       li   r0,>7fff                                       ; LD HL,$7FFF       ; yes: +32767
_2486:                                                     ; >2486
       mov  r0,@-2(sp)                                     ; LD ($E802),HL     ; stash X' (TI: on the stack)
       mov  @-6(sp),hl                                     ; POP HL            ; HL = X
       bl   @multiply_by_sin                               ; CALL $24A7        ; X.sin
       mov  hl,@-6(sp)                                     ; EX (SP),HL        ; save it
       mov  @-4(sp),hl                                     ;                   ; HL = Y
       bl   @multiply_by_cos                               ; CALL $24D1        ; Y.cos
       a    @-6(sp),hl                                     ; POP DE / OR A / ADC HL,DE; Y' = X.sin + Y.cos
       jno  _24a2                                          ; JP PO,$24A2       ; no overflow - use it as-is
       jlt  rotate_pair_y_positive                         ; JR C,$249F        ; overflow, with the true Y' positive?
       li   hl,>7f92                                       ; LD HL,$7F92       ; no: a bug - should be $8000 (-32768)
       jmp  _24a2                                          ;                   ; 
rotate_pair_y_positive:                                    
       li   hl,>7fff                                       ; LD HL,$7FFF       ; yes: +32767
_24a2:                                                     ; >24a2
       mov  hl,de                                          ; EX DE,HL          ; DE = Y'
       mov  @-2(sp),hl                                     ; LD HL,($E802)     ; HL = X'
       ai   sp,-6                                          ;                   ; drop the saved values
       jmp  rotate_pair_exit                               ; RET               ; 
* TI: rotate a pair of the object's axis vector components (sign-magnitude
* words, big-endian, the second 2 bytes after the first) by the rotation
* record at IX, as #R$221B and #R$22C0 do inline: X' = X.cos - Y.sin and
* Y' = X.sin + Y.cos, stored back in sign-magnitude form.
*
* I:R1 -> X
* I:IX -> the rotation record
rotate_axis_pair:                                          
       .proc                                               ;                   ; 
       mov  r1,*sp+                                        ;                   ; save the pointer (at -6(SP) below)
       mov  *r1,hl                                         ; LD HL,(X)         ; HL = X
       bl   @multiply_by_cos                               ; CALL $24D1        ; X.cos
       .push hl                                            ; PUSH HL           ; 
       mov  @-4(sp),r1                                     ;                   ; 
       mov  @2(r1),hl                                      ; LD HL,(Y)         ; HL = Y
       bl   @multiply_by_sin                               ; CALL $24A7        ; Y.sin
       mov  @-2(sp),r0                                     ; POP DE / EX DE,HL ; R0 = X.cos
       s    hl,r0                                          ; OR A / SBC HL,DE  ; X' = X.cos - Y.sin
       abs  r0                                             ; JP P,... / XOR A / SUB L ...; in sign-magnitude form
       jgt  rotate_axis_pair_1                             ;                   ; (ABS sets the status from the value before)
       jeq  rotate_axis_pair_1                             ;                   ; 
       ori  r0,>8000                                       ; SET 7,H           ; 
rotate_axis_pair_1:                                        
       mov  r0,@-2(sp)                                     ; PUSH HL           ; save X'
       mov  @-4(sp),r1                                     ;                   ; 
       mov  *r1,hl                                         ; LD HL,(X)         ; HL = X again
       bl   @multiply_by_sin                               ; CALL $24A7        ; X.sin
       .push hl                                            ; PUSH HL           ; 
       mov  @-6(sp),r1                                     ;                   ; 
       mov  @2(r1),hl                                      ; LD HL,(Y)         ; HL = Y again
       bl   @multiply_by_cos                               ; CALL $24D1        ; Y.cos
       a    @-2(sp),hl                                     ; POP DE / OR A / ADC HL,DE; Y' = Y.cos + X.sin
       abs  hl                                             ; JP P,... / XOR A / SUB L ...; in sign-magnitude form
       jgt  rotate_axis_pair_2                             ;                   ; 
       jeq  rotate_axis_pair_2                             ;                   ; 
       ori  hl,>8000                                       ; SET 7,H           ; 
rotate_axis_pair_2:                                        
       mov  @-6(sp),r1                                     ;                   ; R1 -> X
       mov  hl,@2(r1)                                      ; LD (Y),HL         ; store Y'
       mov  @-4(sp),r0                                     ; POP HL            ; R0 = X'
       mov  r0,*r1                                         ; LD (X),HL         ; store it
       ai   sp,-6                                          ;                   ; drop the saved values
rotate_pair_exit:
       .endproc                                            ; RET               ; 

********************************************************************************
* Multiply by a rotation record's sine
* 
* Used by the routines at #R$221B, #R$22C0, #R$2365, #R$23D9 and #R$2450.
* .
* Returns HL * sin, where sin is the 24-bit value at IX+3 in a rotation
* record from #R$21DA (bits 0-22, with $400000 = 1), rounded to the
* nearest integer. The result's sign is the input's sign XOR bit 7 of
* IX+5, which #R$21DA sets for a negative turn rate - sin(-t) is -sin(t),
* whereas cos(-t) is cos(t), so #R$24D1 needs no such bit. The
* multiplication itself is shared with #R$24D1 (from $24F5).
* 
* I:HL Number (sign-magnitude, 15-bit magnitude)
* I:IX Pointer to the rotation record
* O:HL HL * sin, rounded (two's complement)
multiply_by_sin:                                           ; >24a7
       movb @>05(ix),r0                                    ; LD A,(IX+$05)     ; 
       xor  hl,r0                                          ; XOR H             ; R0 bit 15 = the result's sign: sin's sign XOR the input's
       mov  ix,iy                                          ;                   ; 
       ai   iy,3                                           ; LD A,(IX+$03)     ; IY -> sin, the 24-bit value at IX+3
       jmp  _24f5                                          ; JR $24F5          ; 

********************************************************************************
* Multiply by a rotation record's cosine
* 
* Used by the routines at #R$221B, #R$22C0, #R$2365, #R$23D9 and #R$2450.
* .
* Returns HL * cos, where cos is the 24-bit value at IX+0 in a rotation
* record from #R$21DA ($400000 = 1), rounded to the nearest integer, with
* the input's sign. Multiplies the magnitude by each of the value's three
* bytes (#R$1F86), adds the three products at their byte positions into
* IY:HL:A, and takes bits 22-37 of the total, rounding with bit 21 - i.e.
* round(magnitude * cos / 2^22), confirmed by emulation. Note that the
* input is sign-magnitude but the result is two's complement.
* 
* I:HL Number (sign-magnitude, 15-bit magnitude)
* I:IX Pointer to the rotation record
* O:HL HL * cos, rounded (two's complement)
multiply_by_cos:                                           ; >24d1
       mov  hl,r0                                          ; LD A,H            ; R0 bit 15 = the result's sign: the input's
       mov  ix,iy                                          ; LD A,(IX+$00)     ; IY -> cos, the 24-bit value at IX+0
* This entry point is used by the routine at #R$24A7.
_24f5:                                                     ; >24f5
       mov  hl,de                                          ; RES 7,H           ; 
       andi de,>7fff                                       ;                   ; DE = the magnitude
       movb *iy,a                                          ; CALL $1F86        ; 
       srl  a,8                                            ;                   ; A (R4) = the value's low byte
       mpy  de,a                                           ;                   ; R4:R5 = magnitude * low byte
       sla  a,8                                            ;                   ; 
       srl  bc,8                                           ;                   ; 
       soc  bc,a                                           ;                   ; A (R4) = that product >> 8
       movb @2(iy),r1                                      ;                   ; 
       movb @1(iy),@r1lb                                   ;                   ; 
       andi r1,>7fff                                       ; AND $7F           ; R1 = the value's top two bytes, without the sign bit
       mpy  de,r1                                          ;                   ; R1:R2 = magnitude * top two bytes
       a    a,r2                                           ; ADD IY,BC         ; R1:R2 = the product >> 8...
       jnc  !                                              ;                   ; 
       inc  r1                                             ;                   ; 
!
       ai   r2,>2000                                       ; RL L              ; ...rounded with bit 21 of the product
       jnc  !                                              ;                   ; 
       inc  r1                                             ;                   ; 
!
       sla  r1,2                                           ; ADD HL,HL         ; 
       srl  r2,14                                          ; RLA               ; 
       soc  r2,r1                                          ;                   ; 
       mov  r1,hl                                          ; LD H,A            ; HL = round(magnitude * value / 2^22)
       mov  r0,r0                                          ; EX AF,AF'         ; result negative?
       jlt  !                                              ; RET P             ; no - done
       rt                                                  ;                   ; 
!
       neg  hl                                             ; SUB L             ; yes: negate HL
       rt                                                  ; RET               ; 

********************************************************************************
* Rotation coefficients for a 30-degree turn
* 
* A 6-byte record in the same format as the table at #R$121B: cos 30
* degrees ($376CF5 / $400000 = 0.866) then sin 30 degrees ($200000 /
* $400000 = 0.5), as 24-bit values. #R$21DA uses it instead of the table
* for a turn rate of +/-127 ($7F), as used to spin the title screen's
* "ELITE" letters (#R$1E5A, #R$1E96).
       .msxalign >2522
rotation_30_degrees:                                       ; >2522
       byte >F5,>6C,>37                                              ; cos 30 degrees
       byte >00,>00,>20                                              ; sin 30 degrees

********************************************************************************
* The message "Bounty: ... credits"
* 
* Shown by #R$2556 when a ship with a bounty is destroyed, after
* formatting the bounty into the digits at $28B4 (#R$3675, which sets bit
* 7 of the last digit; #R$2556 clears it again so that the message runs
* on into " credits").
msg_bounty:                                                ; >28ad
       text 'Bounty:'                                             ; 
bounty_digit_buffer:                                       ; >28b4
       byte >00,>00,>00,>00,>00                                   ; the digits
msg_credits:                                               ; >28b9
       text ' credit',>f3                                         ; 

********************************************************************************
* The message "No bounty!"
msg_no_bounty:                                             ; >28c1
       text 'No bounty',>a1                                       ; 

********************************************************************************
* Clear the object table
* 
* Used by the routines at #R$1703, #R$1E01, #R$894D, #R$8C94 and #R$8D2A.
* .
* Clears the object table (#R$EBA0: 20 slots of 40 bytes), the number of
* objects of each ship type (#R$E844), and the numbers of pirates and
* traders (#R$E939, #R$E93A).
clear_all_ship_slots:                                      ; >28d4
       .proc
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; the object table
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,planet_position                             ; LD DE,$EBA1       ; 
       li   bc,>031f                                       ; LD BC,$031F       ; 
       .ldir                                               ; LDIR              ; clear it
       li   hl,ship_type_counts                            ; LD HL,$E844       ; the number of objects of each ship type
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,ship_type_counts+>0001                      ; LD DE,$E845       ; 
       li   bc,>001f                                       ; LD BC,$001F       ; 
       .ldir                                               ; LDIR              ; clear them
       sb   a,a                                            ; XOR A             ; 
       movb a,@pirate_count                                ; LD ($E939),A      ; no pirates
       movb a,@trader_count                                ; LD ($E93A),A      ; no traders
       .endproc                                            ; RET               ; 

********************************************************************************
* Get a ship's blueprint
* 
* Used by the routines at #R$25B9, #R$3037, #R$3187 and #R$31AD.
* .
* Points IY at the blueprint for a ship type, from the table at #R$A7D7.
* 
* I:A Ship type
* O:IY The blueprint (see #R$A817 for the layout)
get_blueprint:                                             ; >2fe9
       cb   a,@bytes+blueprints_2_first_type
       jhe  !
       .select_bank blueprints_1_bank_select                                          ; Select blueprints ROM bank 1
       jmp  !!
!
       .select_bank blueprints_2_bank_select                                          ; Select blueprints ROM bank 2
!
       ab   a,a                                            ; ADD A,A           ;
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; BC = ship type * 2
       li   hl,ship_blueprints                             ; LD HL,$A7D7       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> its entry in the blueprint table
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,b                                          ; LD B,(HL)         ; BC = the blueprint's address
       movb b,iyh                                          ; LD IYH,B          ; 
       movb @c,@iyl                                        ; LD IYL,C          ; IY = BC
       rt                                                  ; RET               ; 

* TI: read byte R2 of the blueprint for ship type A, from code in any bank
* (#R$2FE9 selects the blueprint's bank, so code in a ROM bank can't read
* through IY itself)
*
* I:A Ship type
* I:R2 The offset
* O:A The byte
blueprint_byte:
       .proc                                               ;                   ; 
       .save_bank                                          ;                   ; 
       bl   @get_blueprint                                 ; CALL $2FE9        ; IY -> the blueprint
       a    iy,r2                                          ;                   ; 
       movb *r2,a                                          ; LD A,(IY+n)       ; 
       .restore_bank                                       ;                   ; 
       .endproc                                            ;                   ; 

********************************************************************************
* Find the missile aimed at an object
* 
* Used by the routines at #R$30EA and #R$46CA.
* .
* Looks through the object table (#R$EBA0) for a missile (ship type 2)
* whose target (byte $22 of its record, see #R$F7EF) is the object in
* slot C. Enemy missiles are checked too, though that byte isn't set for
* them (#R$2A3A).
* 
* I:C Slot number of the target
* O:F Z set if there is one
* O:IX Pointer to the missile's record
find_missile_at_object:                                    ; >3016
       li   ix,ship_object_table                           ; LD IX,$EBA0       ; IX -> the ship-object table
       li   de,>0028                                       ; LD DE,$0028       ; DE = 40, one slot's stride
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_301f:                                                     ; >301f
       movb *ix,r0                                         ; BIT 0,(IX+$00)    ; in use?
       andi r0,>0100                                       ;                   
       jeq  _3031                                          ; JR Z,$3031        ; no - skip it
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; A = ship type
       cb   a,@bytes+>02                                   ; CP $02            ; a missile?
       jne  _3031                                          ; JR NZ,$3031       ; not a missile
       movb @>22(ix),a                                     ; LD A,(IX+$22)     ; A = its target
       cb   a,@c                                           ; CP C              ; does it match the one we're looking for?
       jne  !                                              ; RET Z             ; aimed at this object
       rt                                                  ;                   
!
_3031:                                                     ; >3031
       a    de,ix                                          ; ADD IX,DE         ; next slot
       sb   one,b                                          ; DJNZ $301F        ; 
       jne  _301f                                          ;                   
       ab   one,b                                          ; INC B             ; none found: NZ
       rt                                                  ; RET               ; 

********************************************************************************
* Add an object to the object table
* 
* Used by the routines at #R$1703, #R$19FC, #R$1E01, #R$2A3A, #R$2A71, #R$2A94,
* #R$2B05, #R$2C3C, #R$2D3B, #R$2D7E, #R$3187, #R$8C94, #R$8D2A and #R$8DB9.
* .
* Copies the working object (#R$F7CD), whose ship type and handler type the
* caller has set up, into the first free slot of the 20-slot object table
* (#R$EBA0). On the way it gets its turn number (1-3, see #R$2542) from
* #R$E92F; its energy (#R$F7E9) from byte $0C of its blueprint (#R$2FE9);
* its speed (#R$F7E6) from byte $0D, unless the caller set it to 0; and its
* missiles (#R$F7EA) from bits 0-6 of byte $13. The counts of objects about
* are updated (#R$E844, #R$E93A, #R$E939).
* .
* At $3090, counts pirates (class 4) in #R$E939.
* .
* At $30A4, tries the next slot, returning with carry clear if there are no
* more.
* 
* O:F Carry set if it was added, clear if the table is full
add_object:                                                ; >3037
       .proc
       .save_bank                                          ;                   ; (TI: get_blueprint selects a blueprint bank; select the caller's again)
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; 
       li   de,>0028                                       ; LD DE,$0028       ; 
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_303f:                                                     ; >303f
       movb *hl,r0                                         ; BIT 0,(HL)        ; in use?
       andi r0,>0100                                       ;                   
       jne  add_object_next_slot                           ; JR NZ,$30A4       ; yes - try the next
       .push hl                                            ; PUSH HL           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @next_turn_number,a                            ; LD A,($E92F)      ; A = the next turn number
       movb a,@turn_number                                 ; LD ($F7ED),A      ; give it to this object
       ab   one,a                                          ; INC A             ; 
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  _3052                                          ; JR NZ,$3052       ; 
       movb one,a                                          ; LD A,$01          ; (1-3)
_3052:                                                     ; >3052
       movb a,@next_turn_number                            ; LD ($E92F),A      ; 
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       bl   @get_blueprint                                 ; CALL $2FE9        ; IY -> the blueprint
       movb @>0c(iy),a                                     ; LD A,(IY+$0C)     ; 
       movb a,@object_energy                               ; LD ($F7E9),A      ; energy
       li   hl,object_speed                                ; LD HL,$F7E6       ; 
       movb *hl,a                                          ; LD A,(HL) / OR A  ; 
       jeq  _306c                                          ; JR Z,$306C        ; speed 0 - leave it
       movb @>0d(iy),a                                     ; LD A,(IY+$0D)     ; 
       movb a,*hl                                          ; LD (HL),A         ; speed
_306c:                                                     ; >306c
       movb @>13(iy),a                                     ; LD A,(IY+$13)     ; 
       andi a,>7f00                                        ; AND $7F           ; 
       movb a,@object_missiles                             ; LD ($F7EA),A      ; missiles
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       cb   a,@bytes+>20                                   ; CP $20            ; 
       jhe  _3098                                          ; JR NC,$3098       ; the planet or the sun - not counted
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,ship_type_counts                            ; LD HL,$E844       ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       ab   one,*hl                                        ; INC (HL)          ; one more of this ship type
       movb @>12(iy),a                                     ; LD A,(IY+$12)     ; 
       andi a,>1c00                                        ; AND $1C           ; A = class
       jne  add_object_count_pirates                       ; JR NZ,$3090       ; not a trader
       li   hl,trader_count                                ; LD HL,$E93A       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more trader
       jmp  _3098                                          ; JR $3098          ; 
add_object_count_pirates:                                  ; >3090
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  _3098                                          ; JR NZ,$3098       ; not a pirate
       li   hl,pirate_count                                ; LD HL,$E939       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more pirate
_3098:                                                     ; >3098
       .pop de                                             ; POP DE            ; 
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; 
       .pop hl                                             ; POP HL            ; 
       .restore_bank
       .retc                                               ; RET               ; 
add_object_next_slot:                                      ; >30a4
       a    de,hl                                          ; ADD HL,DE         ; 
       sb   one,b                                          ; DJNZ $303F        ; 
       jne  _303f                                          ;                   
       socb a,a                                            ; OR A              ; 
       .restore_bank
       .retnc                                              ; RET               ; 

********************************************************************************
* The message "Target Lost"
msg_target_lost:                                           ; >337d
       text 'Target Los',>f4                                      ; 

********************************************************************************
* The message "Condition RED!"
msg_condition_red:                                         ; >3388
       text 'Condition RED',>a1                                   ; 

********************************************************************************
* The message "Right On Commander"
msg_right_commander:                                       ; >3396
       text 'Right On Commande',>f2                               ; 

********************************************************************************
* The message "Missile jammed!"
msg_missile_jammed:                                        ; >33a8
       text 'Missile jammed',>a1                                  ; 

********************************************************************************
* The message "Incoming missile"
msg_incoming_missile:                                      ; >33b7
       text 'Incoming missil',>e5                                 ; 

********************************************************************************
* RST $00 target: print character A
* 
* Used by the routines at #R$0000 and #R$357A.
* .
* Copies the character's 8-byte pattern (from $099F + A * 8) to $E600,
* shifted right by the cursor's pixel offset (#R$E70E), and XORs it into
* the two character cells at the cursor (#R$E70F): the characters are 6
* pixels wide, so most straddle two 8-pixel cells. At $351C, moves on to
* the second cell, and then moves the cursor on 6 pixels (and the column,
* #R$E72C, on by one).
print_char:                                                ; >34a8
       .proc
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, as interrupts are off, so the sound effects play on)
       .push af                                            ; PUSH AF           ; save registers
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; 
       movb a,@l                                           ; LD L,A            ; HL = A (the character code)
       sb   h,h                                            ; LD H,$00          ; 
       sla  hl,3                                           ; ADD HL,HL         ; HL *= 8 (this char's offset into the font table)
       ;                                                   ; ADD HL,HL         ; 
       ;                                                   ; ADD HL,HL         ; 
       .save_bank                                          ;                   ; (TI: select the caller's bank again after the copy)
       .select_bank font_bank_select                       ;                   ; the font is in ROM bank 6 on the TI
       li   bc,font->0100                                  ; LD BC,$099F       ; the font pattern table (codes $20-$7F)
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this character's 8-byte glyph
       li   de,scratch_buffer                              ; LD DE,$E600       ; DE -> the staging buffer
       li   bc,>0008                                       ; LD BC,$0008       ; 8 bytes
       .ldir                                               ; LDIR              ; copy the glyph in
       .restore_bank                                       ;                   ; 
       .ex_de_hl                                           ; EX DE,HL          ; HL -> just past the copied glyph ($E608)
       sb   *hl,*hl                                        ; LD (HL),$00       ; zero it...
       li   de,scratch_buffer_5+>0004                      ; LD DE,$E609       ; ...and the following 7 bytes too
       movb @bytes+>07,@c                                  ; LD C,$07          ; 
       .ldir                                               ; LDIR              ; ($E608-$E60F: the buffer's "spillover" half, initially all zero)
       movb @cursor_subpixel_offset,a                      ; LD A,($E70E) / OR A; A = the cursor's sub-pixel shift (0-7)
       jeq  _34e5                                          ; JR Z,$34E5        ; no shift needed - the buffer's ready as-is
       movb a,b                                            ; LD B,A            ; B = the shift amount
       li   hl,scratch_buffer                              ; LD HL,$E600       ; HL -> the glyph half of the buffer
       li   de,scratch_buffer_5+>0003                      ; LD DE,$E608       ; DE -> the spillover half
       movb @bytes+>08,@c                                  ; LD C,$08          ; 8 rows
_34d7:                                                     ; >34d7
       .push bc                                            ; PUSH BC           ; 
       movb *hl,r0                                         ; LD A,(DE)         ; R0 = glyph byte : this row's spillover byte (0 to start)
       movb *de,@r0lb                                      ;                   ; 
_34d9:                                                     ; >34d9
       srl  r0,1                                           ; SRL (HL)          ; shift the glyph byte right one bit...
       ;                                                   ; RRA               ; ...carrying the bit shifted out into the spillover byte
       sb   one,b                                          ; DJNZ $34D9        ; repeat for the full shift amount
       jne  _34d9                                          ;                   
       movb r0,*hl                                         ;                   ; store the shifted glyph byte
       movb @r0lb,*de                                      ; LD (DE),A         ; store what spilled over into the next byte
       inc  hl                                             ; INC HL            ; both halves -> next row
       inc  de                                             ; INC DE            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,@c                                         ; DEC C             ; 
       jne  _34d7                                          ; JR NZ,$34D7       ; next row
_34e5:                                                     ; >34e5
       movb @cursor_vram_addr+1,de                         ; LD DE,($E70F)     ; DE -> this cell's row-0 pattern-table byte
       movb @cursor_vram_addr,@e                           ;                   ;
       li   hl,scratch_buffer                              ; LD HL,$E600       ; HL -> the buffer's glyph (left-tile) half
       movb @bytes+>02,@c                                  ; LD C,$02          ; two tile columns to plot: this cell, then the next
_34ee:                                                     ; >34ee
       .push de                                            ; PUSH DE           ; stash this tile's base VRAM address
       movb @bytes+>08,b                                   ; LD B,$08          ; 8 rows
_34f1:                                                     ; >34f1
;      limi 0                                              ; DI                ; VDP address/data access must not be interrupted
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb d,a                                            ; LD A,D            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, read mode
;      .push hl                                            ; PUSH HL           ; (timing delay - let the VDP latch the address, not needed on the TI)
;      .pop hl                                             ; POP HL            ; 
       movb @vdprd,a                                       ; IN A,($98)        ; A = the current pattern byte at that address
       movb *hl,r0                                         ; XOR (HL)          ; combine with this row's buffer byte
       xor  r0,a                                           ;                   ; 
       inc  hl                                             ; INC HL            ; buffer -> next row
       .ex_af_af_                                          ; EX AF,AF'         ; stash the combined byte
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; re-issue the address, low byte
       movb d,a                                            ; LD A,D            ; 
       socb @bytes+>40,a                                   ; OR $40            ; ...high byte, this time in write mode
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       .ex_af_af_                                          ; EX AF,AF'         ; recover the combined byte
       movb a,@vdpwd                                       ; OUT ($98),A       ; write it back (an XOR-plot, not an overwrite)
       ; EI                                                ; EI                ;
       sb   one,b                                          ; DEC B             ; one row done
       jeq  continue_34a8_advance_cursor                   ; JR Z,$351C        ; all 8 rows plotted - go advance the cursor
       ab   one,@e                                         ; INC E             ; VRAM address -> next row of this pattern
       movb @e,a                                           ; LD A,E            ; 
       andi a,>0700                                        ; AND $07           ; crossed an 8-byte pattern-table boundary?
       jne  _351a                                          ; JR NZ,$351A       ; no - carry on
       movb @e,a                                           ; LD A,E            ; 
       sb   one,a                                          ; DEC A             ; undo the wrap...
       andi a,>f800                                        ; AND $F8           ; ...and snap back to this boundary's start
       movb a,@e                                           ; LD E,A            ; 
       ab   one,d                                          ; INC D             ; move into the pattern table's next bank
_351a:                                                     ; >351a
       jmp  _34f1                                          ; JR $34F1          ; plot the next row
continue_34a8_advance_cursor:                              ; >351c
       .pop de                                             ; POP DE            ; recover this tile's base VRAM address
       movb @e,a                                           ; LD A,E            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; E += 8: the next cell's row-0 pattern byte
       movb a,@e                                           ; LD E,A            ; 
       sb   one,@c                                         ; DEC C             ; one tile done
       jne  _34ee                                          ; JR NZ,$34EE       ; plot the second tile (the buffer's spillover half)
       movb @cursor_subpixel_offset,a                      ; LD A,($E70E)      ; A = the cursor's sub-pixel shift
       cb   a,@bytes+>02                                   ; CP $02            ; shifted by 2 or more?
       jl   _3534                                          ; JR C,$3534        ; no - stay in the same screen column
       movb @cursor_vram_addr+1,hl                         ; LD HL,($E70F)     ; yes - advance to the next screen column's pattern address
       movb @cursor_vram_addr,@l                           ;                   ;
       movb @bytes+>08,@c                                  ; LD C,$08          ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb hl,@cursor_vram_addr+1                         ; LD ($E70F),HL     ; 
       movb @l,@cursor_vram_addr                           ;                   ;
_3534:                                                     ; >3534
       ab   @bytes+>06,a                                   ; ADD A,$06         ; advance the sub-pixel shift by the font's 6px width
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jl   _353c                                          ; JR C,$353C        ; still within 0-7 - done
       sb   @bytes+>08,a                                   ; SUB $08           ; wrap back into 0-7
_353c:                                                     ; >353c
       movb a,@cursor_subpixel_offset                      ; LD ($E70E),A      ; store the updated sub-pixel shift
       li   hl,cursor_column                               ; LD HL,$E72C       ; the on-screen column counter (see #R$3564)
       ab   one,*hl                                        ; INC (HL)          ; 
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Set the text cursor to column B, row C
* 
* Used by the routines at #R$3596, #R$3955, #R$5AF8, #R$5B4D, #R$5BBD, #R$5C8E,
* #R$5DBB, #R$60E3, #R$612D, #R$6164, #R$6276, #R$9120, #R$9A4B and #R$A30A.
* .
* Text is printed in 6-pixel-wide characters. Sets the cursor's address in the
* pattern table (#R$E70F) to that of the character cell containing pixel B * 6
* of row C, and its pixel within the cell (#R$E70E) to the rest; also sets the
* column (#R$E72C) and clears #R$E70D.
* 
* I:B Column
* I:C Row
set_cursor_position:                                       ; >3548
       .push hl                                            ; PUSH HL           ; 
       movb @c,h                                           ; LD H,C            ; H = the row
       movb b,a                                            ; LD A,B            ; 
       movb a,@cursor_column                               ; LD ($E72C),A      ; the column
       ab   a,a                                            ; ADD A,A           ; 
       ab   b,a                                            ; ADD A,B           ; 
       ab   a,a                                            ; ADD A,A           ; A = column * 6
       .push af                                            ; PUSH AF           ; 
       andi a,>f800                                        ; AND $F8           ; 
       movb a,@l                                           ; LD L,A            ; L = 8 * the character cell it's in
       movb hl,@cursor_vram_addr+1                         ; LD ($E70F),HL     ; set the address in the pattern table
       movb @l,@cursor_vram_addr                           ;                   ;
       .pop af                                             ; POP AF            ; 
       andi a,>0700                                        ; AND $07           ; 
       movb a,@cursor_subpixel_offset                      ; LD ($E70E),A      ; the pixel within the cell
       sb   a,a                                            ; XOR A             ; 
       movb a,@unused_counter_e70d                         ; LD ($E70D),A      ; 
       .pop hl                                             ; POP HL            ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Set the text cursor to column A
* 
* Used by the routines at #R$35E7, #R$3619, #R$3631, #R$5AF8, #R$5B4D, #R$5CEE,
* #R$5DBB, #R$6066, #R$6164 and #R$6377.
* .
* Like #R$3548, but leaves the cursor on the same row (the high byte of
* #R$E70F).
* 
* I:A Column
set_cursor_position_combined:                              ; >3564
       movb a,@cursor_column                               ; LD ($E72C),A      ; the column
       movb a,r1                                           ;                   ; 
       srl  r1,8                                           ;                   ; 
       mov  r1,r0                                          ;                   ; 
       sla  r1,1                                           ;                   ; 
       a    r0,r1                                          ;                   ; 
       sla  r1,1                                           ;                   ; R1 = column * 6
       mov  r1,r0                                          ;                   ; 
       andi r0,>00f8                                       ; AND $F8           ; 
       swpb r0                                             ;                   ; 
       movb r0,@cursor_vram_addr                           ; LD ($E70F),A      ; the character cell
       andi r1,>0007                                       ; AND $07           ; 
       swpb r1                                             ;                   ; 
       movb r1,@cursor_subpixel_offset                     ; LD ($E70E),A      ; the pixel within the cell
       rt                                                  ; RET               ; 

********************************************************************************
* RST $08 target: print a tokenised string at HL
* [text]
* 
* Used by the routines at #R$0008, #R$1651 and #R$40DE.
* .
* Reads bytes from HL until a 0 byte ends the string. Each byte has its
* top bit (the tokenised-text terminator convention noted elsewhere -
* e.g. #R$39C8) stripped and, if the result is nonzero, is expanded via
* #R$34A8 (RST $00); the original byte's top bit being set ends the
* string after this character.
rst_08_target_print_tokenised_string:                      ; >357a
       .proc
rst_08_target_print_tokenised_string_jmp:
       movb *hl,a                                          ; LD A,(HL) / OR A  ; 
       jeq  rst_08_target_print_tokenised_string_exit      ; RET Z             ; 0 - the end
!
       andi a,>7f00                                        ; AND $7F           ; 
       jeq  !                                              ; CALL NZ,$34A8     ; print the character (#R$34A8)
       bl   @print_char                                    ;                   
!
       movb *hl,r0                                         ; BIT 7,(HL)        ; bit 7 set?
       andi r0,>8000                                       ;                   
       jeq  !                                              ; RET NZ            ; yes - that was the last character
rst_08_target_print_tokenised_string_exit:
       .endproc                                            ;                   
!
       inc  hl                                             ; INC HL            ; 
       jmp  rst_08_target_print_tokenised_string_jmp       ; JR $357A          ; 

********************************************************************************
* RST $10 target: print the A'th tokenised string in a list at HL
* [text]
* 
* Used by the routine at #R$0010.
* .
* Skips A strings via #R$358D, then prints the one HL now points to via
* RST $08 (#R$357A).
rst_10_target_print_ath_tokenised:                         ; >3588
       .proc                                               ;                   ; 
       bl   @skip_tokenised_strings_advancing_hl_past      ; CALL $358D        ; 
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Skip A tokenised strings, advancing HL past each one
* 
* Used by the routines at #R$193F, #R$3588 and #R$8BA6.
* .
* Each string ends at the first byte with its top bit set (the same
* terminator convention #R$357A prints by). Returns once A strings have
* been skipped (A=0 on entry does nothing).
skip_tokenised_strings_advancing_hl_past:                  ; >358d
       sb   one,a                                          ; DEC A             ; 
       jlt  skip_tokenised_strings_end                     ; RET M             ; 
_358f:                                                     ; >358f
       movb *hl+,r0                                        ; BIT 7,(HL) / INC HL; 
       jgt  _358f                                          ; JR Z,$358F        ; not the last character
       jeq  _358f                                          ;                   ; 
       jmp  skip_tokenised_strings_advancing_hl_past       ; JR $358D          ; 
skip_tokenised_strings_end:                                
       rt                                                  ;                   ; 

********************************************************************************
* RST $20 target: print a list of positioned tokenised strings
* [text]
* 
* Used by the routine at #R$0020.
* .
* Reads (column, row, tokenised-string) records from HL: a negative
* column byte ends the list; otherwise positions the cursor via #R$3548,
* prints the string via RST $08 (#R$357A), advances past it, and
* repeats.
rst_20_target_print_list_positioned:                       ; >3596
       .proc                                               ;                   ; 
_3596:                                                     
       movb *hl,a                                          ; LD A,(HL)         ; A = the column
       jlt  _3596_end                                      ; RET M             ; bit 7 set - the end of the list
       movb a,b                                            ; LD B,A            ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl+,@c                                        ; LD C,(HL)         ; C = the row
       bl   @set_cursor_position                           ; CALL $3548        ; put the cursor there (#R$3548)
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print the string (#R$357A)
       inc  hl                                             ; INC HL            ; move past its last byte
       jmp  _3596                                          ; JR $3596          ; next record
_3596_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Fill BC bytes of VRAM with a fixed byte
* 
* Used by the routine at #R$3955.
* .
* Writes E to the VDP data port BC times in a row. The caller must point the
* VDP at the target VRAM address (via port $99) before calling; each write
* auto-increments that address.
* 
* I:E Fill byte
* I:BC Number of bytes to write
fill_vram_bytes:                                           ; >35a4
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       dec  bc                                             ; DEC BC            ; 
       movb b,a                                            ; LD A,B            ; 
       socb @c,a                                           ; OR C              ; 
       jne  fill_vram_bytes                                ; JR NZ,$35A4       ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Fill up to 256*C bytes of VRAM with a fixed byte
* 
* Used by the routine at #R$70E8.
* .
* Writes A to the VDP data port in chunks of 256 bytes (the inner counter B
* is loaded with 0, so DJNZ wraps it to 256), repeated C times. Like
* #R$35A4, the caller must set the VRAM write address first.
* 
* I:A Fill byte
* I:C Number of 256-byte chunks to write
fill_vram_256:                                             ; >35ad
       li   r2,vdpwd                                       ;                   ; 
       clr  r1                                             ; LD B,$00          ; 
       movb @c,r1                                          ;                   ; R1 = C * 256 bytes
_35af:                                                     ; >35af
       movb a,*r2                                          ; OUT ($98),A       ; 
       dec  r1                                             ; DJNZ $35AF / DEC C; 
       jne  _35af                                          ; JR NZ,$35AD       ; 
       sb   @c,@c                                          ;                   ; C = 0, as on the MSX
       rt                                                  ; RET               ; 

********************************************************************************
* Fill a rectangular block of a screen-2 table with one byte
* 
* Used by the routines at #R$36F1, #R$3955, #R$50CE, #R$60CA, #R$6ADC, #R$6B12,
* #R$6CA8 and #R$72C1.
* .
* Fills a C-character-wide, (B/8)-row-tall rectangle of whichever VDP table
* HL points into (pattern or colour) with byte A - used to blank a
* text-window or dashboard area.
* .
* For each column, writes A to all 8 pixel-rows of one character (the VRAM
* address auto-increments across them); after the 8th byte, instead of
* carrying on into the next character along the row it drops to the same
* character position one name-table row further down (+256 bytes = +32
* characters) and continues. After B bytes like this (i.e. B/8 rows), it
* moves one character to the right (HL+8) and repeats for C columns.
* 
* I:A Fill byte
* I:HL VRAM address of the top-left character's first pixel-row byte
* I:B Height in pixel-rows (a multiple of 8)
* I:C Width in characters
fill_vram_rect:                                            ; >35b8
;      limi 0                                              ; DI                ; 
       movb a,@e                                           ; LD E,A            ; Keep the fill byte in E; A is about to be reused for
       movb @bytes+>07,d                                   ; LD D,$07          ; address bytes. D = row-within-character wrap mask
_35bc:                                                     ; >35bc
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; Remember this column's start address
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; Point the VDP at this column
_35c6:                                                     ; >35c6
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; Write the fill byte
       ab   one,@l                                         ; INC L             ; 
       movb @l,a                                           ; LD A,L            ; 
       andi a,>0700                                        ; AND D             ; D is always 7 here
       jne  _35db                                          ; JR NZ,$35DB       ; Still inside this character's 8 pixel-rows
       movb @l,a                                           ; LD A,L            ; 
       sb   one,a                                          ; DEC A             ; 
       andi a,>f800                                        ; AND $F8           ; Back to this character's row 0...
       movb a,@l                                           ; LD L,A            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ab   one,h                                          ; INC H             ; ...but one name-table row down (+256 = 32 characters)
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
_35db:                                                     ; >35db
       sb   one,b                                          ; DJNZ $35C6        ; 
       jne  _35c6                                          ;                   
       .pop hl                                             ; POP HL            ; 
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; Next character along the row
       movb a,@l                                           ; LD L,A            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,@c                                         ; DEC C             ; 
       jne  _35bc                                          ; JR NZ,$35BC       ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Wait for a keypress, blinking the text-input cursor meanwhile [text]
* 
* Used by the routines at #R$3631, #R$3815 and #R$A30A.
* .
* Resets the blink-phase flag #R$E72E to 0 (erased) and the blink
* countdown #R$E72D to 1, then repeatedly calls #R$3619 (which steps
* the blink and HALTs for one VBlank each call) until #R$E8F5 (the
* polled action code, see #R$347A) becomes non-zero. Consumes that
* action code, and - only if the cursor glyph is currently showing
* (#R$E72E set) - erases it (another XOR-plot of $7F via RST $00,
* then #R$3564 to step the text cursor back the column that plot
* advanced it by). Always plays the click (#R$7468) before
* returning the consumed action code in A.
* 
* O:A The polled action code that ended the wait
wait_for_keypress_blinking_cursor:                         ; >35e7
       .proc                                               ;                   ; 
       .push bc                                            ; PUSH BC           ; save registers
       .push hl                                            ; PUSH HL           ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@cursor_blink_phase_flag                     ; LD ($E72E),A      ; blink phase = erased
       movb one,@cursor_blink_countdown                    ; INC A / LD ($E72D),A; blink countdown = 1 (steps immediately)
_35f1:                                                     ; >35f1
       bl   @step_cursor_blink                             ; CALL $3619        ; step the blink
       bl   @ti_wait_frame                                 ; HALT              ; (TI: wait for the next frame, polling for VBlank)
       movb @pending_debounced_keypress_byte_status,a      ; LD A,($E8F5) / OR A; A = the polled action code
       jeq  _35f1                                          ; JR Z,$35F1        ; nothing pressed yet - keep blinking and waiting
       .push af                                            ; PUSH AF           ; stash the action code
       sb   @pending_debounced_keypress_byte_status,@pending_debounced_keypress_byte_status; XOR A / LD ($E8F5),A; consume it
       movb @cursor_blink_phase_flag,a                     ; LD A,($E72E) / OR A; A = the blink-phase flag
       jeq  _3610                                          ; JR Z,$3610        ; cursor not currently shown - nothing to erase
       movb @bytes+>7f,a                                   ; LD A,$7F          ; the cursor glyph
       bl   @print_char                                    ; RST $00           ; XOR-plot it (erasing it, since it was showing)
       movb @cursor_column,a                               ; LD A,($E72C)      ; step the text cursor back the column that plot advanced
       sb   one,a                                          ; DEC A             ; 
       bl   @set_cursor_position_combined                  ; CALL $3564        ; 
_3610:                                                     ; >3610
       .sfx 0                                              ; LD A,$00 / CALL $7468; click
       .pop af                                             ; POP AF            ; recover the action code
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Step #R$35E7's cursor-blink countdown and toggle the cursor glyph
* 
* Used by the routine at #R$35E7.
* .
* Decrements the countdown at #R$E72D, returning if it hasn't reached
* zero. Otherwise resets it to 30 ($1E), XOR-plots the cursor glyph
* $7F via RST $00 (toggling it on screen), steps the text cursor back
* the column that plot advanced it by (#R$3564), and complements the
* blink-phase flag #R$E72E to track which state ("on" or "erased")
* the glyph is now in.
step_cursor_blink:                                         ; >3619
       .proc                                               ;                   ; 
       sb   one,@cursor_blink_countdown                    ; LD HL,$E72D / DEC (HL); 
       jne  _3619_end                                      ; RET NZ            ; not yet due - done
       movb @bytes+>1e,@cursor_blink_countdown             ; LD (HL),$1E       ; due - reset the countdown (30 ticks)
       movb @bytes+>7f,a                                   ; LD A,$7F          ; the cursor glyph
       bl   @print_char                                    ; RST $00           ; XOR-plot it (toggles it on screen)
       movb @cursor_column,a                               ; LD A,($E72C)      ; step the text cursor back the column that plot advanced
       sb   one,a                                          ; DEC A             ; 
       bl   @set_cursor_position_combined                  ; CALL $3564        ; 
       movb @cursor_blink_phase_flag,r0                    ; LD HL,$E72E / LD A,(HL); toggle the blink-phase flag
       inv  r0                                             ; CPL               ; 
       movb r0,@cursor_blink_phase_flag                    ; LD (HL),A         ; 
_3619_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Read a line of keyboard input into $E8F7
* 
* Used by the routines at #R$55A3, #R$5AC7, #R$5EFE and #R$A36B.
* .
* Reads keys (#R$35E7) into the buffer at $E8F7, printing them, until Enter
* or ESC is pressed, and clears the message line (#R$3955). Enter
* terminates the buffer with 0 and returns with carry set; ESC (at $3643)
* returns with carry clear. Backspace ($7F) rubs out the last character, if
* there is one. Any other character (at $3662) is only accepted if it's in
* the range D-E and the buffer holds fewer than C characters.
* 
* I:C Maximum number of characters
* I:D Lowest character code accepted
* I:E Highest character code accepted
* O:F Carry set if Enter was pressed, clear for ESC
read_line_keyboard_input:                                  ; >3631
       .proc                                               ;                   ; 
       li   hl,keyboard_input_buffer                       ; LD HL,$E8F7       ; HL -> the input buffer
       sb   b,b                                            ; LD B,$00          ; B = characters read so far
_3636:                                                     ; >3636
       bl   @wait_for_keypress_blinking_cursor             ; CALL $35E7        ; A = the next key (blocks until one is available)
       cb   a,@bytes+>0d                                   ; CP $0D            ; Enter?
       jne  continue_3631_esc_or_backspace                 ; JR NZ,$3643       ; no
       sb   *hl,*hl                                        ; LD (HL),$00       ; yes - null-terminate the buffer
       bl   @clear_message_line                            ; JP $3955          ; clear the message line
       .retc                                               ; SCF               ; carry set = Enter
continue_3631_esc_or_backspace:                            ; >3643
       cb   a,@bytes+>1b                                   ; CP $1B            ; ESC?
       jne  _3643_backspace                                ; JP Z,$3955        ; 
       bl   @clear_message_line                            ;                   ; clear the message line
       .retnc                                              ;                   ; carry clear = ESC
_3643_backspace:                                           
       cb   a,@bytes+>7f                                   ; CP $7F            ; backspace (TI: FCTN-S)?
       jne  continue_3643_accept_reject_character          ; JR NZ,$3662       ; no - an ordinary character
       movb b,b                                            ; INC B / DEC B     ; buffer already empty?
       jeq  _3673                                          ; JR Z,$3660        ; yes - nothing to delete
       movb @cursor_column,a                               ; LD A,($E72C)      ; step the cursor back one column...
       sb   one,a                                          ; DEC A             ; 
       .push af                                            ; PUSH AF           ; ...stashing that column for the re-set below
       bl   @set_cursor_position_combined                  ; CALL $3564        ; 
       dec  hl                                             ; DEC HL            ; buffer -> the character being deleted
       movb *hl,a                                          ; LD A,(HL)         ; 
       bl   @print_char                                    ; RST $00           ; XOR-plot it away
       .pop af                                             ; POP AF            ; force the cursor position back to that column...
       bl   @set_cursor_position_combined                  ; CALL $3564        ; ...undoing the advance the plot just caused
       sb   one,b                                          ; DEC B             ; one fewer character in the buffer
       jmp  _3673                                          ; JR $3673          ; 
continue_3643_accept_reject_character:                     ; >3662
       movb a,*hl                                          ; LD (HL),A         ; provisionally store the character
       cb   a,d                                            ; CP D              ; below the lowest acceptable code?
       jl   _3673                                          ; JR C,$3673        ; yes - reject
       cb   a,@e                                           ; CP E              ; above the highest?
       jh   _3673                                          ; JR Z,$366B / JR NC,$3673; yes - reject (TI: JH straight after the CB)
       cb   @c,b                                           ; LD A,C / CP B     ; buffer already full?
       jeq  _3673                                          ; JR Z,$3673        ; yes - reject
       movb *hl+,a                                         ; LD A,(HL) / INC HL; accepted - plot the character
       bl   @print_char                                    ; RST $00           ; 
       ab   one,b                                          ; INC B             ; one more character
_3673:                                                     ; >3673
       jmp  _3636                                          ; JR $3636          ; next key

********************************************************************************
* Format a number
* 
* Used by the routines at #R$1651, #R$1A8A, #R$2556 and #R$36E1.
* .
* Writes the digits of the 24-bit number H:L:C at IX, with bit 7 of the
* last one set, as tokenised text. Divides by 10 (#R$20C6) until it's 0,
* pushing each digit. If bit 7 of the control byte (kept in $E738) is set,
* pads the number to the width in bits 0-5 with #R$EF96 (normally a space).
* If bit 6 is set, the number is in tenths: it gets at least two digits,
* and (at $36C1) a decimal point before the last one. At $36B8 and $36D7,
* writes a digit.
* 
* I:A Control byte: bit 7 pads to the width in bits 0-5, bit 6 adds a
* .   decimal point
* I:H:L:C The number (C the low byte)
* I:IX Where to write it
* O:IX One past the last byte written
format_number:                                             ; >3675
       .proc                                               ;                   ; 
       movb a,@format_control                              ; LD ($E738),A      ; cache the control byte
       sb   @e,@e                                          ; LD E,$00          ; E = digit count so far
       seto r0                                             ; LD A,$FF          ; push the bottom-of-stack sentinel
       .push r0                                            ; PUSH AF           ; 
_367d:                                                     ; >367d
       bl   @divide_c_l_h_by_10                            ; CALL $20C6        ; A = the next digit, H:L:C = the reduced quotient
       .push af                                            ; PUSH AF           ; push this digit
       ab   one,@e                                         ; INC E             ; one more digit
       movb @c,a                                           ; LD A,C            ; 
       socb h,a                                            ; OR H              ; 
       socb @l,a                                           ; OR L              ; 
       jne  _367d                                          ; JR NZ,$367D       ; quotient not yet zero - extract another digit
       movb @format_control,a                              ; LD A,($E738)      ; A = the control byte again
       movb a,d                                            ; LD D,A            ; D = the control byte, for the bit-6 tests below
       czc  @bit6,a                                        ; BIT 6,A           ; 
       jeq  _3696                                          ; JR Z,$3696        ; clear - skip the two-digit-minimum check
       movb @e,b                                           ; LD B,E            ; was exactly one digit produced?
       ab   one,@e                                         ; INC E             ; 
       sb   one,b                                          ; DEC B             ; 
       jne  _3696                                          ; JR NZ,$3696       ; no - move on
       .push bc                                            ; PUSH BC           ; yes - push an extra placeholder digit (0)
       ab   one,@e                                         ; INC E             ; 
_3696:                                                     ; >3696
       movb @format_control,a                              ; OR A              ; test the control byte's sign
       jgt  format_number_digits                           ; JP P,$36AA        ; bit 7 clear - no minimum-width padding
       jeq  format_number_digits                           ;                   ; 
       andi a,>3f00                                        ; AND $3F           ; A = the minimum field width
       sb   @e,a                                           ; SUB E             ; minus the digits actually produced
       jeq  format_number_digits                           ; JR Z,$36AA        ; exactly enough already - no padding needed
       jlt  format_number_digits                           ;                   ; (TI: more than enough - no padding either)
       movb a,b                                            ; LD B,A            ; B = the padding count
       movb @number_fill_char,a                            ; LD A,($EF96)      ; A = the fill character
_36a3:                                                     ; >36a3
       movb a,*ix+                                         ; LD (IX+$00),A / INC IX; write B fill bytes
       sb   one,b                                          ; DJNZ $36A3        ; 
       jne  _36a3                                          ;                   ; 
format_number_digits:                                      ; >36aa
       czc  @bit6,d                                        ; BIT 6,D           ; the decimal-point/two-digit-minimum flag again
       jne  continue_3675_write_digit_decimal_point        ; JR NZ,$36C1       ; set - with a decimal point
_36ae:                                                     ; >36ae
       .pop af                                             ; POP AF / OR A     ; pop the next digit (most significant first)
       jlt  format_number_end                              ; JP P,$36B8        ; the sentinel - finish
       ab   @bytes+>30,a                                   ; ADD A,$30         ; digit -> ASCII
       movb a,*ix+                                         ; LD (IX+$00),A / INC IX; write it
       jmp  _36ae                                          ; JR $36AE          ; next digit
continue_3675_write_digit_decimal_point:                   ; >36c1
       sb   one,@e                                         ; DEC E             ; account for the terminal $FF popped, but not written
_36c2:                                                     ; >36c2
       movb @e,a                                           ; LD A,E            ; exactly one digit left to write?
       sb   one,a                                          ; DEC A             ; 
       jne  _36cd                                          ; JR NZ,$36CD       ; no - write the next digit as usual
       movb @bytes+>2e,a                                   ; LD A,$2E          ; yes - insert '.' first
       movb a,*ix+                                         ; LD (IX+$00),A / INC IX; 
_36cd:                                                     ; >36cd
       .pop af                                             ; POP AF / OR A     ; pop the next digit
       jlt  format_number_end                              ; JP P,$36D7        ; the sentinel - finish
       ab   @bytes+>30,a                                   ; ADD A,$30         ; digit -> ASCII
       movb a,*ix+                                         ; LD (IX+$00),A / INC IX; write it
       sb   one,@e                                         ; DEC E             ; one fewer digit remaining
       jmp  _36c2                                          ; JR $36C2          ; check for the decimal point again
format_number_end:                                         
       socb @bit7,@-1(ix)                                  ; SET 7,(IX-$01)    ; flag the last byte written
       .endproc                                            ; RET               ; 

********************************************************************************
* RST $18 target: format a value into $E717 and print it [text]
* 
* Used by the routine at #R$0018.
* .
* Runs #R$3675's format-into-$E717 loop, then prints the result via
* RST $08 (#R$357A).
rst_18_target_format_value_print:                          ; >36e1
       .proc                                               ;                   ; 
       .push ix                                            ; PUSH IX           ; 
       li   ix,text_buffer                                 ; LD IX,$E717       ; 
       bl   @format_number                                 ; CALL $3675        ; 
       .pop ix                                             ; POP IX            ; 
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* RST $28 target: colour a list of rectangles
* 
* Used by the routines at #R$0028 and #R$90D3.
* .
* Reads 5-byte records from IX until one starts with a byte with bit 7 set
* (usually $FF): the column, row, width and height of a rectangle (in text
* columns, 6 pixels wide, and character rows), and a colour byte. Fills
* the colour table for the rectangle with the colour (#R$35B8), from the
* character cell containing its left edge (column * 6 pixels) to the one
* containing the pixel just after its right edge ((column + width) * 6) -
* so it can reach one cell further right than the rectangle. Used for the
* frames and colour bars of the screens (e.g. #R$58BD).
* 
* I:IX The list of rectangles
rst_28_target_draw_list_tile:                              ; >36f1
       .proc                                               ;                   ; 
_36f1:                                                     
       movb *ix,r1                                         ; LD A,(IX+$00)     ; the column
       jlt  _36f1_end                                      ; RET M             ; end of the list
       srl  r1,8                                           ;                   ; 
       mov  r1,r0                                          ;                   ; 
       sla  r1,1                                           ;                   ; 
       a    r0,r1                                          ;                   ; 
       sla  r1,1                                           ;                   ; R1 = column * 6 (the left edge in pixels)
       andi r1,>00f8                                       ; AND $F8           ; 8 * the character cell it's in
       mov  r1,r2                                          ;                   ; 
       swpb r1                                             ;                   ; 
       movb r1,@l                                          ; LD L,A            ; 
       movb @1(ix),h                                       ; LD A,(IX+$01)     ; 
       ab   @bytes+>20,h                                   ; ADD A,$20 / LD H,A; HL = the colour table address for that cell
       movb *ix,r1                                         ; LD A,B            ; 
       ab   @2(ix),r1                                      ; ADD A,(IX+$02)    ; 
       srl  r1,8                                           ;                   ; 
       mov  r1,r0                                          ;                   ; 
       sla  r1,1                                           ;                   ; 
       a    r0,r1                                          ;                   ; 
       sla  r1,1                                           ;                   ; (column + width) * 6 (the right edge in pixels)
       andi r1,>00f8                                       ; AND $F8           ; 
       ai   r1,8                                           ; ADD A,$08         ; 
       s    r2,r1                                          ; SUB L             ; 
       srl  r1,3                                           ; RRA x 3           ; 
       andi r1,>001f                                       ; AND $1F           ; 
       swpb r1                                             ;                   ; 
       movb r1,@c                                          ; LD C,A            ; C = the number of character cells across
       movb @3(ix),r1                                      ; LD A,(IX+$03)     ; 
       sla  r1,3                                           ; ADD A,A x 3       ; 
       movb r1,b                                           ; LD B,A            ; B = height * 8 (pixel rows)
       movb @4(ix),a                                       ; LD A,(IX+$04)     ; A = the colour
       bl   @fill_vram_rect                                ; CALL $35B8        ; fill the rectangle
       ai   ix,5                                           ; ADD IX,BC         ; IX -> the next rectangle
       jmp  _36f1                                          ; JR $36F1          ; 
_36f1_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Draw a Bresenham line from (B,C) to (D,E), pixel-precise [line-draw]
* 
* Used by the routines at #R$37E2, #R$523A, #R$541E and #R$5584.
* .
* A second, independent Bresenham line-drawer alongside the #R$3C48 family,
* plotting via #R$3793 - which self-modifies the displacement of its own
* `OR (IX+d)` instruction to `C AND 7` before each use, so IX (fixed at
* $E700, the bit-position table $80..$01) still selects the correct single
* pixel bit within the target byte despite never being re-pointed. Caches
* the original (D,E) endpoint to #R$E730 (for #R$37E2's fan-drawing use),
* then swaps the two endpoints if needed so the row always decreases from B
* down to D, works out the column step direction and the row/column deltas,
* plots the first point, and picks $3773's steep-line loop if the row delta
* exceeds the column delta, or its own shallow-line loop (row-major vs.
* column-major Bresenham stepping) otherwise.
* .
* At $3773, the loop for a steep line, stepping the row every time and the
* column only sometimes.
draw_bresenham_line_372b:                                  ; >372b
       .proc                                               ;                   ; (TI: the pixel masks come from pixel_bitmask_table in plot_line_pixel, IX isn't used)
       movb de,@bresenham_cached_endpoint+1                ; LD ($E730),DE     ; cache the original second endpoint
       movb @e,@bresenham_cached_endpoint                  ;                   ; 
       movb d,a                                            ; LD A,D            ; 
       cb   a,b                                            ; CP B              ; first endpoint's row < second's?
       jl   _373c                                          ; JR C,$373C        ; yes - no swap needed
       movb b,d                                            ; LD D,B            ; no - swap rows...
       movb a,b                                            ; LD B,A            ; 
       movb @e,a                                           ; LD A,E            ; 
       movb @c,@e                                          ; LD E,C            ; ...and columns, so (D,E) becomes the smaller-row endpoint
       movb a,@c                                           ; LD C,A            ; 
_373c:                                                     ; >373c
       movb @e,a                                           ; LD A,E            ; 
       sb   @c,a                                           ; SUB C             ; dx = E - C (signed column delta, post-swap)
       movb one,@l                                         ; LD L,$01          ; L = +1 (default column step)
       joc  _3746                                          ; JR NC,$3746       ; dx >= 0 - keep that step
       andi a,>ff00                                        ; NEG               ; dx < 0 - take the magnitude...
       neg  a                                              ;                   ; 
       movb @b255,@l                                       ; LD L,$FF          ; ...and step -1 instead
_3746:                                                     ; >3746
       movb a,@e                                           ; LD E,A            ; E = abs(dx)
       movb b,a                                            ; LD A,B            ; 
       sb   d,a                                            ; SUB D             ; dy = B - D (always >= 0, since D <= B after the swap)
       movb a,d                                            ; LD D,A            ; D = dy
       .push hl                                            ; PUSH HL           ; 
       bl   @plot_line_pixel                               ; CALL $3793        ; plot the first point (B,C)
       .pop hl                                             ; POP HL            ; 
       cb   @e,d                                           ; LD A,E / CP D     ; dx < dy (steeper than 45 degrees)?
       jl   draw_bresenham_line_372b_steep                 ; JR C,$3773        ; yes - a steep line
       movb @e,r0                                          ; LD H,E            ; 
       srl  r0,1                                           ; SRL H             ; 
       movb r0,h                                           ;                   ; H = dx/2, the error accumulator
       movb @e,a                                           ; LD A,E / OR A     ; 
       jeq  _3792                                          ; RET Z             ; dx == 0 - a single point, already plotted above
       movb a,@line_points_left                            ; LD ($E734),A      ; E734 = dx, the remaining-points loop counter
_375c:                                                     ; >375c
       ab   @l,@c                                          ; LD A,C / ADD A,L / LD C,A; column += step (the major axis)
       movb h,a                                            ; LD A,H            ; 
       sb   d,a                                            ; SUB D             ; error -= dy
       joc  _3765                                          ; JR NC,$3765       ; still >= 0 - no row step this time
       sb   one,b                                          ; DEC B             ; underflowed - row -= 1 (towards D)
       ab   @e,a                                           ; ADD A,E           ; and restore the error by += dx
_3765:                                                     ; >3765
       movb a,h                                            ; LD H,A            ; store the updated error
       .push hl                                            ; PUSH HL           ; 
       bl   @plot_line_pixel                               ; CALL $3793        ; plot (B,C)
       .pop hl                                             ; POP HL            ; 
       sb   one,@line_points_left                          ; DEC ($E734)       ; one fewer point to plot (after the POP, which changes the status)
       jne  _375c                                          ; JR NZ,$375C       ; more to go - next point
       jmp  _3792                                          ; JR $3792          ; done
draw_bresenham_line_372b_steep:                            ; >3773
       movb d,r0                                           ; LD H,D            ; 
       srl  r0,1                                           ; SRL H             ; 
       movb r0,h                                           ;                   ; H = dy/2, the error accumulator
       movb d,a                                            ; LD A,D / OR A     ; 
       jeq  _3792                                          ; RET Z             ; dy = 0 - a single point, already plotted
       movb a,@line_points_left                            ; LD ($E734),A      ; E734 = dy, the remaining-points loop counter
_377c:                                                     ; >377c
       sb   one,b                                          ; DEC B             ; row -= 1 (the major axis)
       movb h,a                                            ; LD A,H            ; 
       sb   @e,a                                           ; SUB E             ; error -= dx
       movb a,h                                            ; LD H,A            ; 
       joc  _3787                                          ; JR NC,$3787       ; still >= 0 - no column step this time
       ab   d,a                                            ; ADD A,D           ; underflowed - restore the error by += dy...
       movb a,h                                            ; LD H,A            ; 
       ab   @l,@c                                          ; LD A,C / ADD A,L / LD C,A; ...and step the column
_3787:                                                     ; >3787
       .push hl                                            ; PUSH HL           ; 
       bl   @plot_line_pixel                               ; CALL $3793        ; plot (B,C)
       .pop hl                                             ; POP HL            ; 
       sb   one,@line_points_left                          ; DEC ($E734)       ; one fewer point to plot
       jne  _377c                                          ; JR NZ,$377C       ; more to go - next point
_3792:                                                     ; >3792
       .endproc                                            ; RET               ; 

********************************************************************************
* Plot a pixel of a line
* 
* Used by the routines at #R$372B and #R$4D0B.
* .
* Sets pixel (x, y) in the pattern table in VRAM, ORing in its bit from
* the table at $E700 (by patching the displacement of an (IX+d)
* instruction). While #R$E90F is set, only plots in character cells
* coloured $F1 (white on black).
* 
* I:B y
* I:C x
plot_line_pixel:                                           ; >3793
       .proc                                               ;                   ; 
       bl   @pixel_address                                 ; CALL $37D1        ; HL = the pixel's address
       movb @e90f_equip_op_flag,a                          ; LD A,($E90F)      ; only in white on black cells?
       jeq  _37ad                                          ; OR A / JR Z,$37AD ; no
       movb @l,@vdpwa                                      ; LD A,L / OUT ($99),A; VRAM address low byte
       movb h,r0                                           ; LD A,H            ; 
       ab   @bytes+>20,r0                                  ; ADD A,$20         ; its colour (at +$2000)
       movb r0,@vdpwa                                      ; OUT ($99),A       ; 
       cb   @vdprd,@bytes+>f1                              ; IN A,($98) / CP $F1; white on black?
       jne  _37be                                          ; RET NZ            ; no - don't plot
_37ad:                                                     ; >37ad
       movb @c,r1                                          ; LD A,C            ; 
       srl  r1,8                                           ;                   ; 
       andi r1,>0007                                       ; AND $07           ; the column's bit position within its byte (0-7)
       movb @l,@vdpwa                                      ; LD A,L / OUT ($99),A; VRAM address low byte
       movb h,@vdpwa                                       ; LD A,H / OUT ($99),A; ...high byte, read mode
       movb @vdprd,r0                                      ; IN A,($98)        ; A = the current byte there
       movb @pixel_bitmask_table(r1),r2                    ; OR (IX+d)         ; the pixel bit (TI: indexed, not self-modified)
       movb @plot_pixel_xor,r1                             ;                   ; XOR it instead, for #R$541E (TI: a flag, not
       jne  _37bf_xor                                      ;                   ; a patched opcode)
       socb r2,r0                                          ;                   ; combine in the pixel bit
       jmp  _37bf_done                                     ;                   ; 
_37bf_xor:
       xor  r2,r0                                          ; XOR (IX+d)        ; toggle the pixel bit
_37bf_done:
       movb @l,@vdpwa                                      ; LD A,L / OUT ($99),A; re-issue the address, low byte
       movb h,r1                                           ; LD A,H            ; 
       socb @bytes+>40,r1                                  ; OR $40            ; ...high byte, this time in write mode
       movb r1,@vdpwa                                      ; OUT ($99),A       ; 
       movb r0,@vdpwd                                      ; OUT ($98),A       ; write it back
_37be:                                                     
       .endproc                                            ; RET               ; 

********************************************************************************
* Get the address of a pixel in the pattern table
* 
* Used by the routines at #R$3793, #R$50CE, #R$512F and #R$8205.
* .
* For screen 2: (y / 8) * 256 + (x AND $F8) + (y AND 7).
* 
* I:B y
* I:C x
* O:HL Address
pixel_address:                                             ; >37d1
       movb b,r0                                           ; LD A,B            ; 
       srl  r0,8                                           ;                   ; R0 = y
       mov  r0,r1                                          ;                   ; 
       andi r1,>0007                                       ; AND $07           ; y AND 7
       srl  r0,3                                           ; RRA x 3 / AND $1F ; 
       swpb r0                                             ;                   ; H = y / 8
       a    r1,r0                                          ;                   ; 
       movb @c,r1                                          ; LD A,C            ; 
       srl  r1,8                                           ;                   ; 
       andi r1,>00f8                                       ; AND $F8           ; x AND $F8
       a    r1,r0                                          ; ADD A,L           ; 
       mov  r0,hl                                          ;                   ; HL = (y / 8) * 256 + (x AND $F8) + (y AND 7)
       rt                                                  ; RET               ; 

********************************************************************************
* Draw a line on from the last point
* 
* Used by the routine at #R$37E9.
* .
* Draws a line from the end of the last line (#R$E730, cached by
* #R$372B) to (D, E).
* 
* I:D y
* I:E x
draw_line_on:                                              ; >37e2
       movb @bresenham_cached_endpoint+1,bc                ; LD BC,($E730)     ; BC = the endpoint #R$372B cached last time
       movb @bresenham_cached_endpoint,@c                  ;                   ; 
       b    @draw_bresenham_line_372b                      ; JP $372B          ; draw a line from there to (D,E)

********************************************************************************
* Draw lines
* 
* Used by the routine at #R$70E8.
* .
* Draws the lines in the list at HL: each group is a starting point (y, x)
* and the points (y, x) to draw lines to in turn (#R$37E2, #R$372B), ending
* with $FF; the list ends with another $FF.
* .
* At $3805, the next group.
* 
* I:HL The list
draw_lines:                                                ; >37e9
       .proc                                               ;                   ; 
draw_lines_1:                                              
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@b255                                        ; CP $FF            ; 
       jeq  draw_lines_end                                 ; RET Z             ; end of the list
       movb a,b                                            ; LD B,A            ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl+,@c                                        ; LD C,(HL) / INC HL; 
       movb bc,@bresenham_cached_endpoint+1                ; LD ($E730),BC     ; the starting point
       movb @c,@bresenham_cached_endpoint                  ;                   ; 
_37f5:                                                     ; >37f5
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@b255                                        ; CP $FF            ; 
       jeq  draw_lines_2                                   ; JR Z,$3805        ; end of the group
       movb *hl+,d                                         ; LD D,(HL) / INC HL; 
       movb *hl+,@e                                        ; LD E,(HL) / INC HL; DE = the next point
       .push hl                                            ; PUSH HL           ; 
       bl   @draw_line_on                                  ; CALL $37E2        ; draw a line to it
       .pop hl                                             ; POP HL            ; 
       jmp  _37f5                                          ; JR $37F5          ; 
draw_lines_2:                                              ; >3805
       inc  hl                                             ; INC HL            ; HL -> past the $FF terminator
       jmp  draw_lines_1                                   ; JR $37E9          ; process whatever list (if any) follows
draw_lines_end:                                            
       .endproc                                            ;                   ; 

********************************************************************************
* Busy-wait delay loop (~3*65536 iterations)
* 
* Used by the routine at #R$5FFB.
* On the TI it waits 71 frames instead, so the music keeps playing.
busy_wait_delay:                                           ; >3808
       .proc
       movb @vblank_frame_counter,a                        ; LD B,$03          ; (TI: wait 71 frames, polling for VBlank, instead of
_380a:                                                     ; >380a
       bl   @ti_poll_vblank                                ; LD HL,$0000       ; counting 3 * 65536 - about as long on the MSX)
       movb @vblank_frame_counter,b                        ; DEC HL            ; 
       sb   a,b                                            ; LD A,H / OR L     ; B = the frames passed
       cb   b,@bytes+>47                                   ; JR NZ,$380D       ; 
       jl   _380a                                          ; DJNZ $380A        ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* The message " ? "
* 
* Printed via RST $08 (#R$3815, at $3818). No character here has bit 7
* set, so it ends at the $00.
msg_382c:                                                  ; >382c
       text ' ? ',>00                                             ; 

********************************************************************************
* Write B bytes from (HL) to the VDP data port
* 
* Used by the routines at #R$4D8A, #R$6ADC and #R$6B12.
* .
* The caller must point the VDP at the target VRAM address (via port $99)
* first; each write auto-increments it. Unlike #R$35A4 this reads its
* fill data from memory rather than writing one fixed byte repeatedly.
* 
* I:HL Source address
* I:B Number of bytes to write
copy_to_vram:                                              ; >3830
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       sb   one,b                                          ; DJNZ $3830        ; 
       jne  copy_to_vram                                   ;                   
       rt                                                  ; RET               ; 

********************************************************************************
* Copy the space view to the screen
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C, #R$1E5A, #R$40DE, #R$6CB2
* and #R$894D.
* .
* Counts the message timer down, drawing any message into the space view
* first (#R$39F1). Then copies the space view's bitmap buffer (#R$D600) to
* the pattern table: character rows 1-16, columns 5-26 (176x128 pixels).
* Each character's 8 bytes are the same byte of 8 consecutive 32-byte rows
* of the buffer. Sets #R$EF9E while it's writing to VRAM. Reads the buffer
* through HL with indexed offsets, so it can be located anywhere.
copy_space_view:                                           ; >3846
       .proc                                               ;                   ; 
       bl   @count_message_timer                           ; CALL $39F1        ; count the message timer down
* TI: copies only the characters of each row that were drawn in this time
* (view_min, view_max) or last time (view_prev_min, view_prev_max), rather than
* all 22: see view_mark_line.
       li   de,space_view_buffer                           ; LD H,$D6          ; DE -> the buffer
       li   r2,vdpwd                                       ; LD C,$98          ; R2 -> the VDP data port
       movb @bytes+>10,@vram_busy_flag                     ; LD A,$10 / LD ($EF9E),A; writing to VRAM
       clr  r1                                             ;                   ; R1 = the character row (0-15)
_3855:                                                     ; >3855
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, interrupts are off)
       movb @view_min(r1),r0                               ;                   ; R0 = the first character to copy...
       movb @view_max(r1),a                                ;                   ; ...and A the last: those drawn in this time...
       cb   @view_prev_min(r1),r0                          ;                   ; 
       jhe  copy_space_view_1                              ;                   ; 
       movb @view_prev_min(r1),r0                          ;                   ; ...and last time
copy_space_view_1:
       cb   @view_prev_max(r1),a                           ;                   ; 
       jle  copy_space_view_2                              ;                   ; 
       movb @view_prev_max(r1),a                           ;                   ; 
copy_space_view_2:
       movb @view_min(r1),@view_prev_min(r1)               ;                   ; what is on the screen after this
       movb @view_max(r1),@view_prev_max(r1)               ;                   ; 
       cb   r0,a                                           ;                   ; 
       jh   copy_space_view_3                              ;                   ; none: nothing to copy in this row
       movb a,b                                            ; LD B,$C6          ; 
       sb   r0,b                                           ;                   ; 
       ab   one,b                                          ;                   ; B = the number of characters
       srl  r0,8                                           ;                   ; 
       mov  de,hl                                          ;                   ; 
       a    r0,hl                                          ;                   ; HL -> the first one in the buffer
       sla  r0,3                                           ; LD DE,$4120       ; R0 = its address in the pattern table, for writing:
       ai   r0,>4128                                       ;                   ; VRAM $0128 is row 1, column 5
       mov  r1,a                                           ;                   ; 
       swpb a                                              ;                   ; 
       a    a,r0                                           ;                   ; + 256 for each character row
       swpb r0                                             ; LD A,$28          ; 
       movb r0,@vdpwa                                      ; OUT ($99),A       ; VRAM address low byte
       swpb r0                                             ; LD A,D            ; 
       movb r0,@vdpwa                                      ; OUT ($99),A       ; high byte
       bl   @copy_space_view_row_pad                       ; OUTI              ; copy the characters (8 OUTIs and a DJNZ each), from scratchpad
copy_space_view_3:
       ai   de,>100                                        ; INC H             ; next 8 rows of the buffer
       inc  r1                                             ; INC D             ; next character row
       ci   r1,16                                          ; DEC A             ; 
       jne  _3855                                          ; JR NZ,$3855       ; 
       sb   @vram_busy_flag,@vram_busy_flag                ; LD ($EF9E),A      ; done writing to VRAM
       .endproc                                            ; RET               ; 

********************************************************************************
* Clear the space view
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C, #R$1E5A, #R$6CB2 and
* #R$894D.
* .
* Clears the space view's bitmap buffer (#R$D600) - the first 22 bytes
* (176 pixels) of each of its 128 rows. The original pushes zeros with SP
* pointed into the buffer; here each row is cleared with 11 CLRs.
clear_space_view:                                          ; >388f
       .proc                                               ;                   ; 
* TI: clears only the characters of each row that were drawn in (view_min,
* view_max): see view_mark_line. Changes A, DE and HL, as on the MSX, but not
* BC, which its callers count with.
       clr  r1                                             ; LD A,$10          ; R1 = the character row (0-15)
clear_space_view_1:
       movb @view_min(r1),r0                               ;                   ; R0 = the first character drawn in, A = the last
       movb @view_max(r1),a                                ;                   ; 
       cb   r0,a                                           ;                   ; 
       jh   clear_space_view_5                             ;                   ; none
       movb @b255,@view_min(r1)                            ;                   ; none from now on
       sb   @view_max(r1),@view_max(r1)                    ;                   ; 
       mov  r1,hl                                          ; LD HL,$E5F6       ; 
       swpb hl                                             ;                   ; 
       ai   hl,space_view_buffer                           ;                   ; HL -> the row in the buffer: 8 rows of 32 bytes
       srl  r0,8                                           ;                   ; 
       andi r0,>fffe                                       ;                   ; R0 = the first byte to clear (the buffer is cleared in words)
       srl  a,8                                            ;                   ; 
       s    r0,a                                           ;                   ; 
       srl  a,1                                            ;                   ; 
       inc  a                                              ;                   ; A = the number of words in each row
       ci   a,4                                            ;                   ; 
       jl   clear_space_view_2                             ;                   ; 
       li   r0,8                                           ;                   ; many: clear all 22 bytes of the 8 rows, from scratchpad
       bl   @clear_space_view_rows_pad                     ; PUSH DE           ; 
       jmp  clear_space_view_5                             ;                   ; 
clear_space_view_2:
       a    r0,hl                                          ;                   ; HL -> the first word
       li   r0,32                                          ;                   ; 
       s    a,r0                                           ;                   ; 
       s    a,r0                                           ;                   ; R0 = the step to the first word of the next row
       li   r2,8                                           ;                   ; 8 rows
clear_space_view_3:
       mov  a,de                                           ;                   ; 
clear_space_view_4:
       clr  *hl+                                           ;                   ; 
       dec  de                                             ;                   ; 
       jne  clear_space_view_4                             ;                   ; 
       a    r0,hl                                          ;                   ; 
       dec  r2                                             ;                   ; 
       jne  clear_space_view_3                             ;                   ; 
clear_space_view_5:
       inc  r1                                             ;                   ; 
       ci   r1,16                                          ;                   ; 
       jne  clear_space_view_1                             ;                   ; 
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, interrupts are off)
       .endproc                                            ; RET               ; 

********************************************************************************
* Decompress a full-screen picture (pattern + colour data) to VRAM
* 
* Used by the routine at #R$7139.
* .
* Calls #R$3928 twice against the same compressed input stream: first with
* the VRAM write address set to $0000 (the pattern-generator table) to
* unpack the picture's pixel data, then - continuing the same stream where
* the first call left off - with the address set to $2000 (the colour
* table) to unpack its per-character ink/paper bytes.
* 
* I:HL Pointer to the compressed picture stream (pattern data, then colour data)
decompress_picture:                                        ; >390e
       .proc
       sb   a,a                                            ; LD A,$00          ; 
;      limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; VRAM address = $0000 (pattern-generator table)
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ; EI                                                ; EI                ;
       bl   @decompress_rle_to_vram                        ; CALL $3928        ; Unpack the pixel/pattern half of the picture
       sb   a,a                                            ; LD A,$00          ; 
;      limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>60,a                                   ; LD A,$60          ; VRAM address = $2000 (colour table)
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ; EI                                                ; EI                ;
       b    @decompress_rle_to_vram_jmp                    ; JP $3928          ; Unpack the colour half, continuing the same stream

********************************************************************************
* Decompress a run-length-encoded byte stream straight to VRAM
* 
* Used by the routine at #R$390E.
* .
* The caller sets the VDP write address beforehand; each OUT to the data
* port auto-increments it, so the decompressed image is written out in one
* pass with no RAM-side copy.
* .
* The first stream byte is an escape marker (E). Every following byte is
* compared against it: a byte that differs from E is a literal pixel byte,
* written straight to VRAM (at $393E). A byte equal to E introduces a run -
* the next byte is the value to repeat, and the one after is the repeat
* count, written out that many times. A repeat count of 0 marks the end of
* the stream and returns instead of writing anything.
* .
* 
* 
* I:HL Pointer to the compressed byte stream
* O:HL Points just past the terminating zero-count run
decompress_rle_to_vram_jmp:
       .pop r11
decompress_rle_to_vram:                                    ; >3928
       movb *hl,@e                                         ; LD E,(HL)         ; E = this stream's escape/marker byte
       inc  hl                                             ; INC HL            ; 
_392a:                                                     ; >392a
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       cb   a,@e                                           ; CP E              ; Same as the marker?
       jne  rle_literal_byte                               ; JR NZ,$393E       ; No: literal byte
       movb *hl,@c                                         ; LD C,(HL)         ; Yes: next byte is the value to repeat...
       inc  hl                                             ; INC HL            ; 
       movb *hl,b                                          ; LD B,(HL)         ; ...and the byte after that is the repeat count
       inc  hl                                             ; INC HL            ; 
       movb b,a                                            ; LD A,B / OR A     ; 
       jne  !                                              ; RET Z             ; Count of 0 marks the end of the stream
       rt                                                  ;                   
!
       movb @c,a                                           ; LD A,C            ; 
_3937:                                                     ; >3937
       movb a,@vdpwd                                       ; OUT ($98),A       ; Write the repeated byte...
;      nop                                                 ; NOP               ; 
       sb   one,b                                          ; DJNZ $3937        ; ...B times
       jne  _3937                                          ;                   
       jmp  _3940                                          ; JR $3940          ; 
rle_literal_byte:                                          ; >393e
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
_3940:                                                     ; >3940
       jmp  _392a                                          ; JR $392A          ; 

********************************************************************************
* Hide B sprites (move them off-screen)
* 
* Used by the routines at #R$608C, #R$60B1, #R$63F1 and #R$6D24.
* .
* Sets the Y-coordinate byte of each of B consecutive 4-byte
* sprite-attribute-table entries, starting at HL, to $DF - below the
* visible 192 lines, so the VDP skips drawing them.
* 
* I:HL VRAM address of the first sprite's attribute-table entry (its Y byte)
* I:B Number of sprites to hide
hide_sprites_jmp:
       .pop r11
hide_sprites:                                              ; >3942
       li   de,>0004                                       ; LD DE,$0004       ; Sprite-attribute entries are 4 bytes apart
_3945:                                                     ; >3945
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; Point the VDP at this sprite's Y byte
       movb @bytes+>df,a                                   ; LD A,$DF          ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; Off-screen Y coordinate
       a    de,hl                                          ; ADD HL,DE         ; Next sprite entry
       sb   one,b                                          ; DJNZ $3945        ; 
       jne  _3945                                          ;                   
       rt                                                  ; RET               ; 

********************************************************************************
* Clear the message line
* 
* Used by the routines at #R$1651, #R$1683, #R$3631, #R$40DE, #R$52CE, #R$55A3,
* #R$5CEE, #R$5FFB, #R$608C, #R$60B1, #R$6DCF, #R$922D, #R$A30A, #R$A377,
* #R$A3C7, #R$A3E0, #R$A41B and #R$A542.
* .
* Clears row 22 of the screen from column 3 - 26 characters: zeroes their
* patterns and sets their colours to $15 (#R$35A4) - colours the bottom
* pixel row of the 26 characters above it $15 too (#R$35B8), and puts the
* text cursor at column 5 of the row (#R$3548), ready for a message or
* prompt. Sets #R$EF9E while it writes to the VRAM. Preserves AF, BC and
* HL.
clear_message_line:                                        ; >3955
       .proc
clear_message_line_jmp:
       .push af                                            ; PUSH AF           ; 
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; save registers
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; VRAM busy
       movb @bytes+>18,a                                   ; LD A,$18          ; 
;      limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>56,a                                   ; LD A,$56          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1618: the patterns of row 22, column 3
       ; EI                                                ; EI                ;
       li   bc,>00d0                                       ; LD BC,$00D0       ; 208 bytes (26 characters)
       sb   @e,@e                                          ; LD E,$00          ; of 0
       bl   @fill_vram_bytes                               ; CALL $35A4        ; clear them (#R$35A4)
       sb   a,a                                            ; XOR A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; VRAM not busy
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; VRAM busy
       movb @bytes+>18,a                                   ; LD A,$18          ; 
;      limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>76,a                                   ; LD A,$76          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $3618: the colours of row 22, column 3
       ; EI                                                ; EI                ;
       li   bc,>00d0                                       ; LD BC,$00D0       ; 208 bytes
       movb @bytes+>15,@e                                  ; LD E,$15          ; of $15
       bl   @fill_vram_bytes                               ; CALL $35A4        ; colour them
       sb   a,a                                            ; XOR A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; VRAM not busy
       li   hl,>351f                                       ; LD HL,$351F       ; HL = $351F, the bottom pixel row of row 21, column 3
       li   bc,>011a                                       ; LD BC,$011A       ; 1 pixel row, 26 characters
       movb @bytes+>15,a                                   ; LD A,$15          ; colour $15
       bl   @fill_vram_rect                                ; CALL $35B8        ; colour it (#R$35B8)
       ; EI                                                ; EI                ;
       li   bc,>0516                                       ; LD BC,$0516       ; column 5, row 22
       bl   @set_cursor_position                           ; CALL $3548        ; put the text cursor there (#R$3548)
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; restore registers
       .endproc                                            ; RET               ; 

********************************************************************************
* Set a sprite's attributes
* 
* Used by the routines at #R$4E4D, #R$6B6E, #R$6D24 and #R$85FB.
* .
* Writes a sprite attribute table entry - y, x, pattern number and colour
* - to the VDP, whose write address the caller has set, and adds 4 to the
* pattern number, ready for the next 16x16 sprite.
* 
* I:B y
* I:C x
* I:D Pattern number
* I:E Colour
* O:D Pattern number + 4
set_sprite:                                                ; >39a4
       movb b,a                                            ; LD A,B            ; y
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
;      .push hl                                            ; PUSH HL           ; 
;      .pop hl                                             ; POP HL            ; (a short delay for the VDP)
       movb @c,a                                           ; LD A,C            ; x
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
;      .push hl                                            ; PUSH HL           ; 
;      .pop hl                                             ; POP HL            ; 
       movb d,a                                            ; LD A,D            ; pattern
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 
       movb a,d                                            ; LD D,A            ; the next sprite's pattern
       movb @e,a                                           ; LD A,E            ; colour
;      nop                                                 ; NOP               ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Write a run-length-encoded byte stream to the VDP data port
* 
* Used by the routines at #R$4D8A, #R$63F1 and #R$6D24.
* .
* Reads (count, value) pairs from (HL); a count of 0 ends the stream.
* For each pair, writes value to the VDP data port ($98) count times - the
* PUSH HL/POP HL between writes doesn't touch HL, so it looks like a pure
* timing delay to satisfy the VDP's write cycle. Assumes the VDP write
* address was already set (via port $99) by the caller.
* 
* I:HL Pointer to a (count, value) byte stream, 0-terminated
write_run_length_encoded_byte_stream:                      ; >39b9
       movb *hl,a                                          ; LD A,(HL) / OR A  ; A = the count
       jne  !                                              ; RET Z             ; 0 - the end
       rt                                                  ;                   
!
       movb a,b                                            ; LD B,A            ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = the byte
       inc  hl                                             ; INC HL            ; 
_39c0:                                                     ; >39c0
       movb a,@vdpwd                                       ; OUT ($98),A       ; write it
;      .push hl                                            ; PUSH HL           ; 
;      .pop hl                                             ; POP HL            ; (a short delay for the VDP)
       sb   one,b                                          ; DJNZ $39C0        ; count times
       jne  _39c0                                          ;                   
       jmp  write_run_length_encoded_byte_stream           ; JR $39B9          ; next pair

********************************************************************************
* Show a message in the space view
* 
* Used by the routines at #R$1651, #R$1683, #R$1703, #R$193F, #R$19FC, #R$1A8A,
* #R$1C5C, #R$1E5A, #R$2556, #R$2A3A, #R$2C3C, #R$2D7E, #R$30EA, #R$32E7,
* #R$39E9, #R$40DE, #R$46CA, #R$894D and #R$8BA6.
* .
* Remembers the message at HL ($E735) and the column that centres it in
* the view's 22 characters ($E737), and starts the message timer
* (#R$E919), so that the message is drawn for the next 10 frames
* (#R$39F1, #R$3A03).
* 
* I:HL The message
show_view_message_jmp:
       .pop r11
show_view_message:                                         ; >39c8
       movb hl,@view_message_address+1                     ; LD ($E735),HL     ; the message
       movb @l,@view_message_address                       ;                   ;
       sb   @c,@c                                          ; LD C,$00          ; 
show_view_message_count:                                   ; >39cd
       ab   one,@c                                         ; INC C             ; count its characters
       movb *hl+,a                                         ; LD A,(HL)         ; the next character (MOVB sets the status; INC HL would change it on the TI)
       ;                                                   ; OR A              ; 
       ;                                                   ; INC HL            ; 
       jgt  show_view_message_count                        ; JP P,$39CD        ; 
       jeq  show_view_message_count                        ;                   ; 
!
       movb @c,a                                           ; LD A,C            ; 
       czc  @bit0,a                                        ; BIT 0,A           ; 
       jeq  _39da                                          ; JR Z,$39DA        ; 
       ab   one,a                                          ; INC A             ; (rounded up to even)
_39da:                                                     ; >39da
       sb   @bytes+>16,a                                   ; SUB $16           ; 
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
       srl  a,1                                            ; SRL A             ; (22 - length) / 2
       movb a,@view_message_column                         ; LD ($E737),A      ; the column
       movb @bytes+>8a,a                                   ; LD A,$8A          ; 
       movb a,@message_timer                               ; LD ($E919),A      ; start the timer
       rt                                                  ; RET               ; 

********************************************************************************
* Count the message timer down
* 
* Used by the routines at #R$1C5C and #R$3846.
* .
* Called each frame before the space view is copied to the screen
* (#R$3846), and by the title screen (#R$1D02). While the timer (#R$E919)
* is negative the message is being shown ($39FC); once positive, it counts
* down to 0, during which no new message is shown (#R$39E9).
* .
* At $39FC, for 10 frames draws the message ($3A03); then sets the timer to
* 25, the gap before another message can be shown.
* .
* At $3A03, copies the message's characters from the character patterns in
* VRAM ($1A80 + 8 * code) into the space view's bitmap buffer, at column
* ($E737) of the row whose page is #R$E92C (32 bytes to a pixel row). The
* entry at $3A34 moves on to the next character.
count_message_timer:                                       ; >39f1
       li   hl,message_timer                               ; LD HL,$E919       ; 
       movb *hl,a                                          ; LD A,(HL) / OR A  ; A = the message timer
       jne  !                                              ; RET Z             ; 0 - nothing to do
       rt                                                  ;                   
!
       jlt  count_message_timer_2                          ; JP M,$39FC        ; negative - a message is showing
!
       sb   one,*hl                                        ; DEC (HL)          ; counting down to when the next message can be shown
       rt                                                  ; RET               ; 
count_message_timer_2:                                     ; >39fc
       sb   one,*hl                                        ; DEC (HL)          ; 
       jlt  draw_view_message                              ; JP M,$3A03        ; still showing - draw it
!
       movb @bytes+>19,*hl                                 ; LD (HL),$19       ; 25 frames before the next message
       rt                                                  ; RET               ; 
draw_view_message:                                         ; >3a03
       movb @view_message_address+1,hl                     ; LD HL,($E735)     ; the message
       movb @view_message_address,@l                       ;                   ;
       movb @view_message_column,@e                        ; LD A,($E737)      ; E = column
       movb @message_row,d                                 ; LD A,($E92C)      ; D = row, as an MSX buffer page ($D6-$E5)
       ai   de,space_view_buffer->d600                     ;                   ; DE -> the buffer at that row and column
       movb @message_row,r1                                ;                   ; (TI: mark the characters it covers, see view_mark_line:
       srl  r1,8                                           ;                   ; it is centred, so from its column to 21 - its column)
       ai   r1,->d6                                        ;                   ; R1 = the character row
       movb @view_message_column,r0                        ;                   ; 
       cb   r0,@view_min(r1)                               ;                   ; 
       jhe  draw_view_message_1                            ;                   ; 
       movb r0,@view_min(r1)                               ;                   ; 
draw_view_message_1:
       movb @bytes+21,r2                                   ;                   ; 
       sb   r0,r2                                          ;                   ; 
       cb   r2,@view_max(r1)                               ;                   ; 
       jle  _3a0e                                          ;                   ; 
       movb r2,@view_max(r1)                               ;                   ; 
_3a0e:                                                     ; >3a0e
       movb *hl,a                                          ; LD A,(HL)         ; A = the next character
       inc  hl                                             ; INC HL            ; 
       .push af                                            ; PUSH AF           ; save it (bit 7 set on the last one)
       andi a,>7f00                                        ; AND $7F           ; 
* @label=*
_3a13:                                                     ; >3a13
       .push de                                            ; PUSH DE           ; save the buffer address
       .push hl                                            ; PUSH HL           ; save the message pointer
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; 
       sla  hl,3                                           ; ADD HL,HL         ; 
       ;                                                   ; ADD HL,HL         ; 
       ;                                                   ; ADD HL,HL         ; HL = the character * 8
       li   bc,>1a80                                       ; LD BC,$1A80       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL = the character's pattern
;      limi 0                                              ; DI                ; 
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; point the VDP at the pattern
;      .push hl                                            ; PUSH HL           ; 
;      .pop hl                                             ; POP HL            ; (a short delay for the VDP)
       movb @bytes+>08,b                                   ; LD B,$08          ; 8 pixel rows
_3a2a:                                                     ; >3a2a
       movb @vdprd,a                                       ; IN A,($98)        ; copy a row
       movb a,*de                                          ; LD (DE),A         ; 
       ai   de,>20                                         ; ADD A,$20         ; next pixel row
       sb   one,b                                          ; DJNZ $3A2A        ; 
       jne  _3a2a                                          ;                   
       ; EI                                                ; EI                ;
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop af                                             ; POP AF            ; 
       socb a,a                                            ; OR A              ; 
       jgt  !                                              ; RET M             ; that was the last character
       jeq  !                                              ;                   ; 
       rt                                                  ;                   
!
       inc  de                                             ; INC E             ; next column
       jmp  _3a0e                                          ; JR $3A0E          ; 

********************************************************************************
* Colour the space view
* 
* Used by the routines at #R$1C5C, #R$1E01, #R$7139 and #R$894D.
* .
* Fills the colour table for the space view - character rows 1-16, columns
* 5-26 - with A.
* 
* I:A Colour
colour_space_view:                                         ; >3a4d
       .proc
       li   hl,>2128                                       ; LD HL,$2128       ; HL = $2128: the colour table at row 1, column 5
       movb a,@e                                           ; LD E,A            ; 
       movb a,r1                                           ;                   ; R1 = the colour (A is needed for the address)
       movb @bytes+>10,@c                                  ; LD C,$10          ; 16 rows
       li   r2,vdpwd                                       ;                   ; R2 -> the VDP data port
_3a53:                                                     ; >3a53
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, interrupts are off)
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; point the VDP at the row
       movb @bytes+>b0,b                                   ; LD B,$B0          ; 176 bytes (22 characters)
_3a5e:                                                     ; >3a5e
       movb r1,*r2                                         ; LD A,E / OUT ($98),A; 
       sb   one,b                                          ; DJNZ $3A5E        ; 
       jne  _3a5e                                          ;                   ; 
       ab   one,h                                          ; INC H             ; next row
       sb   one,@c                                         ; DEC C             ; 
       jne  _3a53                                          ; JR NZ,$3A53       ; 
       movb @e,a                                           ;                   ; A = the colour, as on the MSX
       .endproc                                            ; RET               ; 

********************************************************************************
* Work out a point's outcode
* 
* Used by the routines at #R$3AC2, #R$3BE0 and #R$3DD7.
* .
* Sets a bit in C for each edge of the clip window that the point is
* beyond: bit 0 for x < $7F8C (-116), bit 1 for x > $8075 (+117), bit 2 for
* y < $7FC1 (-63) and bit 3 for y > $8040 (+64). A point exactly on an edge
* sets bit 4, 5, 6 or 7 instead. The x tests are at $3A72-$3A9B, the y
* tests at $3A9D-$3ABF.
* 
* I:DE x + $8000
* I:HL y + $8000
* O:C The outcode
outcode:                                                   ; >3a72
       sb   @c,@c                                          ; LD C,$00          ; C = 0 (the outcode accumulator)
       ci   de,>7f8c                                       ; SBC A,$7F         ; compare X with the near boundary (16-bit, unsigned)
       jhe  !                                              ; JP NC,$3A82       ; 
       socb @bit0,@c                                       ; SET 0,C           ; DE < $7F8C - X is beyond the near boundary
       jmp  outcode_y                                      ; JR $3A9D          ; 
!
outcodes_x_near_boundary_case_else:                        ; >3a82
       jne  outcodes_x_far_boundary_test_line              ; JP NZ,$3A8A       ; not exactly on the boundary - test the far side
       socb @bit4,@c                                       ; SET 4,C           ; exactly on the near boundary
       jmp  outcode_y                                      ; JR $3A9D          ; 
outcodes_x_far_boundary_test_line:                         ; >3a8a
       ci   de,>8075                                       ; SBC A,$80         ; compare X with the far boundary
       jl   outcode_y                                      ; JP C,$3A9D        ; DE < $8075 - X is within both bounds
       jne  outcodes_x_beyond_far_boundary_case            ; JR NZ,$3A9B       ; 
       socb @bit5,@c                                       ; SET 5,C           ; exactly on the far boundary
       jmp  outcode_y                                      ; JR $3A9D          ; 
outcodes_x_beyond_far_boundary_case:                       ; >3a9b
       socb @bit1,@c                                       ; SET 1,C           ; X is beyond the far boundary
outcode_y:                                                 ; >3a9d
       ci   hl,>7fc1                                       ; SBC A,$7F         ; compare Y with the near boundary
       jhe  !                                              ; JP NC,$3AAA       ; 
       socb @bit2,@c                                       ; SET 2,C           ; HL < $7FC1 - Y is beyond the near boundary
       rt                                                  ; RET               ; 
!
outcodes_y_near_boundary_case_else:                        ; >3aaa
       jne  outcodes_y_far_boundary_test_line              ; JP NZ,$3AB1       ; 
       socb @bit6,@c                                       ; SET 6,C           ; exactly on the near boundary
       rt                                                  ; RET               ; 
outcodes_y_far_boundary_test_line:                         ; >3ab1
       ci   hl,>8040                                       ; SBC A,$80         ; compare Y with the far boundary
       jl   !                                              ; RET C             ; HL < $8040 - Y is within both bounds
       jne  outcodes_y_beyond_far_boundary_case            ; JR NZ,$3ABF       ; 
       socb @bit7,@c                                       ; SET 7,C           ; exactly on the far boundary
!
       rt                                                  ; RET               ; 
outcodes_y_beyond_far_boundary_case:                       ; >3abf
       socb @bit3,@c                                       ; SET 3,C           ; Y is beyond the far boundary
       rt                                                  ; RET               ; 

********************************************************************************
* Clip and draw a line
* 
* Used by the routines at #R$3D8C, #R$43C2 and #R$496D.
* .
* Draws the line between the points at $EB92/$EB94 and $EB96/$EB98, clipped
* to the space view, Cohen-Sutherland style: works out their outcodes
* (#R$3A72, with $8000 added to the coordinates); if both points are
* inside, draws the line (#R$3C29), and if both are beyond the same edge,
* doesn't. Otherwise the line is clipped by bisection.
* .
* At $3B26, if only point 2 is outside, point 1 is the reference point
* inside the window, and (at $3BDA) point 2 is moved to the edge (#R$3BE0,
* #R$3BEC) before the line is drawn.
* .
* At $3B3B, both points are outside: bisects the line (#R$3B53) up to 16
* times looking for a midpoint inside the window, each time replacing
* whichever point is on the other side of the midpoint (at $3BA9, $3BB8,
* $3BC7); if none is found, the line isn't drawn (#R$3BB2). One that is
* becomes the reference point, and each of the original points is moved to
* the edge by bisecting towards it (#R$3BEC) before the line is drawn.
clip_and_draw_line:                                        ; >3ac2
       .proc
       mov  @clip_point1_x,de                              ; LD DE,($EB92)     ; DE = point 1's X (biased/unbiased mix - see #R$3A72)
       ai   de,>8000                                       ; LD A,D / ADD A,$80; bias the high byte by $80 into the unsigned comparison range
       mov  de,@clip_point1_x                              ; LD D,A / LD ($EB93),A; and store it back - the high byte is biased in memory too
       mov  @clip_point1_y,hl                              ; LD HL,($EB94)     ; HL = point 1's Y
       ai   hl,>8000                                       ; LD A,H / ADD A,$80; bias the high byte by $80 into the unsigned comparison range
       mov  hl,@clip_point1_y                              ; LD H,A / LD ($EB95),A; and store it back - the high byte is biased in memory too
       bl   @outcode                                       ; CALL $3A72        ; C = point 1's outcode (#R$3A72)
       movb @c,a                                           ; LD A,C            ; A = that outcode
       .ex_af_af_                                          ; EX AF,AF'         ; stash it in AF' - point 2's outcode calc below reuses A and C
       mov  @clip_point2_x,de                              ; LD DE,($EB96)     ; DE = point 2's X
       ai   de,>8000                                       ; LD A,D / ADD A,$80; bias the high byte by $80 into the unsigned comparison range
       mov  de,@clip_point2_x                              ; LD D,A / LD ($EB97),A; and store it back - the high byte is biased in memory too
       mov  @clip_point2_y,hl                              ; LD HL,($EB98)     ; HL = point 2's Y
       ai   hl,>8000                                       ; LD A,H / ADD A,$80; bias the high byte by $80 into the unsigned comparison range
       mov  hl,@clip_point2_y                              ; LD H,A / LD ($EB99),A; and store it back - the high byte is biased in memory too
       bl   @outcode                                       ; CALL $3A72        ; C = point 2's outcode (#R$3A72)
       .ex_af_af_                                          ; EX AF,AF'         ; restore point 1's outcode into A
       movb a,b                                            ; LD B,A            ; B = point 1's outcode
       socb @c,a                                           ; OR C              ; A = point1 OR point2 (either point's failing-boundary bits)
       andi a,>0f00                                        ; AND $0F           ; keep only the true outcode bits (0-3)
       jne  !                                              ; JP Z,$3C29        ; both points pass every boundary - trivially accept: go convert and draw (#R$3C29)
       b    @clip_endpoints_to_screen_space                ;                   
!
       movb b,a                                            ; LD A,B            ; A = point 1's outcode again
       movb @c,r0                                          ; AND C             ; A = point1 AND point2 (boundaries both points fail together)
       inv  r0                                             ;                   ; 
       szcb r0,a                                           ;                   ; 
       andi a,>0f00                                        ; AND $0F           ; keep only the true outcode bits (0-3)
       jeq  !                                              ; RET NZ            ; if nonzero, both points are outside on the same side - trivially reject, nothing to draw
       .endproc                                            ;                   
!
       movb @c,a                                           ; LD A,C            ; A = point 2's outcode
       andi a,>0f00                                        ; AND $0F           ; keep only the true outcode bits (0-3)
       jne  clip_case_point2_only_outside                  ; JR NZ,$3B26       ; point 2 fails some boundary - go clip it
       movb @c,a                                           ; LD A,C            ; point 2 is inside, so point 1 is outside; A = point 2's outcode
       movb de,@clip_reference_x+1                         ; LD ($E827),DE     ; cache point 2's (inside) coordinates to $E827/$E829 as the known-good reference
       movb @e,@clip_reference_x                           ;                   ;
       movb hl,@clip_reference_y+1                         ; LD ($E829),HL     ; and its Y to $E829
       movb @l,@clip_reference_y                           ;                   ;
       .exx                                                ; EXX               ; switch to the shadow registers
       mov  @clip_point1_x,hl                              ; LD HL,($EB92)     ; HL = point 1's (biased) X
       mov  hl,@clip_point2_x                              ; LD ($EB96),HL     ; copy it into point 2's slot ($EB96)
       mov  @clip_point1_y,hl                              ; LD HL,($EB94)     ; HL = point 1's (biased) Y
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; copy it into point 2's slot ($EB98)
       .exx                                                ; EXX               ; back to the main registers
       mov  de,@clip_point1_x                              ; LD ($EB92),DE     ; overwrite point 1's slot ($EB92) with point 2's X - the outside point now lives in slot 1
       mov  hl,@clip_point1_y                              ; LD ($EB94),HL     ; and point 1's Y slot ($EB94) with point 2's Y
       b    @finish_clip_and_draw                          ; JP $3BDA          ; hand off to the boundary-clipping code
clip_case_point2_only_outside:                             ; >3b26
       movb b,a                                            ; LD A,B            ; A = point 1's masked outcode
       andi a,>0f00                                        ; AND $0F           ; keep only the true outcode bits
       jne  bisect_clip_both_points_outside                ; JR NZ,$3B3B       ; point 1 also fails a boundary - bisect both sides
       movb b,a                                            ; LD A,B            ; (redundant reload)
       mov  @clip_point1_x,hl                              ; LD HL,($EB92)     ; HL = point 1's (inside) X
       movb hl,@clip_reference_x+1                         ; LD ($E827),HL     ; cache it as the reference X
       movb @l,@clip_reference_x                           ;                   ;
       mov  @clip_point1_y,hl                              ; LD HL,($EB94)     ; HL = point 1's (inside) Y
       movb hl,@clip_reference_y+1                         ; LD ($E829),HL     ; cache it as the reference Y
       movb @l,@clip_reference_y                           ;                   ;
       b    @finish_clip_and_draw                          ; JP $3BDA          ; go clip point 2 (still at ($EB96)/($EB98)) towards the reference
bisect_clip_both_points_outside:                           ; >3b3b
       movb a,b                                            ; LD B,A            ; B = point 1's masked outcode
       movb @c,a                                           ; LD A,C            ; A = point 2's raw outcode
       andi a,>0f00                                        ; AND $0F           ; keep only the true outcode bits
       movb a,@c                                           ; LD C,A            ; C = point 2's masked outcode
       .push de                                            ; PUSH DE           ; save point 2's original X (still live in DE, see I: above)
       .push hl                                            ; PUSH HL           ; save point 2's original Y (still live in HL)
       mov  @clip_point1_x,hl                              ; LD HL,($EB92)     ; HL = point 1's original X
       .push hl                                            ; PUSH HL           ; save it too
       mov  @clip_point1_y,hl                              ; LD HL,($EB94)     ; HL = point 1's original Y
       .push hl                                            ; PUSH HL           ; save it too
       .push bc                                            ; PUSH BC           ; stash the two masked outcodes...
       .exx                                                ; EXX               ; ...to move them into the shadow set
       .pop bc                                             ; POP BC            ; shadow BC = (point 1 outcode, point 2 outcode), untouched for the rest of the loop
       .exx                                                ; EXX               ; back to the main set
       movb @bytes+>10,a                                   ; LD A,$10          ; 16 iterations
       movb a,@clip_bisection_count                        ; LD ($E826),A      ; the bisection counter
clip_bisect:                                               ; >3b53
       mov  @clip_point1_x,hl                              ; LD HL,($EB92)     ; HL = point 1's (current) X
       mov  @clip_point2_x,de                              ; LD DE,($EB96)     ; DE = point 2's (current) X
       a    de,hl                                          ; ADD HL,DE         ; HL = X1+X2
       jnc  !                                              ; RR H              ; halve the sum... (the ADD's carry is bit 16 of the sum)
       srl  hl,1                                           ; RR L              ; 
       ori  hl,>8000                                       ;                   ; (ORI leaves the carry from the SRL alone)
       jmp  !!                                             ;                   ; 
!
       srl  hl,1                                           ;                   ; 
!
       jnc  _3b62                                          ; JR NC,$3B62       ; no rounding needed
       inc  hl                                             ; INC HL            ; round the midpoint X up
_3b62:                                                     ; >3b62
       .ex_de_hl                                           ; EX DE,HL          ; DE = midpoint X
       mov  @clip_point1_y,hl                              ; LD HL,($EB94)     ; HL = point 1's (current) Y
       mov  @clip_point2_y,bc                              ; LD BC,($EB98)     ; BC = point 2's (current) Y
       a    bc,hl                                          ; ADD HL,BC         ; HL = Y1+Y2
       jnc  !                                              ; RR H              ; halve... (the ADD's carry is bit 16 of the sum)
       srl  hl,1                                           ; RR L              ; 
       ori  hl,>8000                                       ;                   ; (ORI leaves the carry from the SRL alone)
       jmp  !!                                             ;                   ; 
!
       srl  hl,1                                           ;                   ; 
!
       jnc  _3b72                                          ; JR NC,$3B72       ; 
       inc  hl                                             ; INC HL            ; round the midpoint Y up
_3b72:                                                     ; >3b72
       bl   @outcode                                       ; CALL $3A72        ; C = the midpoint's outcode
       movb @c,a                                           ; LD A,C            ; 
       andi a,>0f00                                        ; AND $0F           ; keep only the true outcode bits
       jne  bisect_test_which_endpoint_to_replace          ; JR NZ,$3BA9       ; midpoint still outside - pick which endpoint to replace
       movb @c,a                                           ; LD A,C            ; midpoint is inside
       movb de,@clip_reference_x+1                         ; LD ($E827),DE     ; cache it as the new reference X
       movb @e,@clip_reference_x                           ;                   ;
       movb hl,@clip_reference_y+1                         ; LD ($E829),HL     ; and reference Y
       movb @l,@clip_reference_y                           ;                   ;
       .exx                                                ; EXX               ; (unused since $3B4D - just scratch here)
       .pop hl                                             ; POP HL            ; HL = point 1's ORIGINAL Y (saved at $3B49)
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; park it in point 2's Y slot (see prose above)
       .pop hl                                             ; POP HL            ; HL = point 1's ORIGINAL X (saved at $3B45)
       mov  hl,@clip_point2_x                              ; LD ($EB96),HL     ; park it in point 2's X slot
       .push af                                            ; PUSH AF           ; save flags across the call below
       bl   @move_point_to_edge                            ; CALL $3BE0        ; bisect the parked point (point 1's original) towards the reference
       .pop af                                             ; POP AF            ; 
       mov  de,@clip_point1_x                              ; LD ($EB92),DE     ; point 1's slot becomes the refined boundary crossing
       mov  hl,@clip_point1_y                              ; LD ($EB94),HL     ; 
       .exx                                                ; EXX               ; back to the main set
       movb de,@clip_reference_x+1                         ; LD ($E827),DE     ; re-cache the refined point as the reference too
       movb @e,@clip_reference_x                           ;                   ;
       movb hl,@clip_reference_y+1                         ; LD ($E829),HL     ; 
       movb @l,@clip_reference_y                           ;                   ;
       .pop hl                                             ; POP HL            ; HL = point 2's ORIGINAL Y (saved at $3B41)
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; restore point 2's Y slot to its true original value
       .pop hl                                             ; POP HL            ; HL = point 2's ORIGINAL X (saved at $3B40)
       mov  hl,@clip_point2_x                              ; LD ($EB96),HL     ; restore point 2's X slot likewise
       jmp  finish_clip_and_draw                           ; JR $3BDA          ; finish clipping point 2's original position towards the refined reference
bisect_test_which_endpoint_to_replace:                     ; >3ba9
       .exx                                                ; EXX               ; switch to the shadow set (holds the two original outcodes)
       movb a,@e                                           ; LD E,A            ; E' = the midpoint's masked outcode
       movb @c,r0                                          ; AND C             ; A = midpoint AND point 2's outcode
       inv  r0                                             ;                   ; 
       szcb r0,a                                           ;                   ; 
       jeq  bisect_replace_point1_with_midpoint            ; JR Z,$3BB8        ; no shared bits - test against point 1 instead
       movb @e,a                                           ; LD A,E            ; A = the midpoint's masked outcode again
       movb b,r0                                           ; AND B             ; A = midpoint AND point 1's outcode
       inv  r0                                             ;                   ; 
       szcb r0,a                                           ;                   ; 
       jeq  bisect_replace_point2_with_midpoint            ; JR Z,$3BC7        ; no shared bits either - default to replacing point 2
clip_abandon:                                              ; >3bb2
       ai   sp,-8                                          ; LD HL,$0008 / ADD HL,SP / LD SP,HL; discard this call's 4 saved words, abandoning the clip (TI: the stack grows up)
       .endproc                                            ; RET               ; give up without drawing
bisect_replace_point1_with_midpoint:                       ; >3bb8
       movb @e,a                                           ; LD A,E            ; A = the midpoint's masked outcode
       movb b,r0                                           ; AND B             ; A = midpoint AND point 1's outcode
       inv  r0                                             ;                   ; 
       szcb r0,a                                           ;                   ; 
       jeq  bisect_replace_point2_with_midpoint            ; JR Z,$3BC7        ; no shared bits - default to replacing point 2 instead
       movb @e,b                                           ; LD B,E            ; shadow B = the midpoint's outcode, replacing point 1's for future comparisons
       .exx                                                ; EXX               ; back to the main set
       mov  de,@clip_point1_x                              ; LD ($EB92),DE     ; point 1's slot becomes the midpoint X
       mov  hl,@clip_point1_y                              ; LD ($EB94),HL     ; and midpoint Y
       jmp  _3bd0                                          ; JR $3BD0          ; join the shared loop tail
bisect_replace_point2_with_midpoint:                       ; >3bc7
       movb @e,@c                                          ; LD C,E            ; shadow C = the midpoint's outcode, replacing point 2's for future comparisons
       .exx                                                ; EXX               ; back to the main set
       mov  de,@clip_point2_x                              ; LD ($EB96),DE     ; point 2's slot becomes the midpoint X
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; and midpoint Y
_3bd0:                                                     ; >3bd0
       li   hl,clip_bisection_count                        ; LD HL,$E826       ; -> the iteration counter
       sb   one,*hl                                        ; DEC (HL)          ; one fewer iteration left
       jeq  !                                              ; JP NZ,$3B53       ; more to go - bisect again
       b    @clip_bisect                                   ;                   
!
       b    @clip_abandon                                  ; JP $3BB2          ; exhausted - abandon the clip
finish_clip_and_draw:                                      ; >3bda
       bl   @move_point_to_edge                            ; CALL $3BE0        ; resolve point 2's slot down to the clip boundary
       b    @clip_endpoints_to_screen_space                ; JP $3C29          ; convert to screen space and draw

********************************************************************************
* Move an outside point to the clip window's edge
* 
* Used by the routine at #R$3AC2.
* .
* If the outcode in A has any of bits 4-7 set (#R$3A72: a point exactly on
* an edge), just returns the reference point inside the window
* ($E827/$E829). Otherwise (at $3BEC) bisects between the reference point
* and the outside point at $EB96/$EB98 until the midpoint lies exactly on
* an edge, and returns that. A midpoint inside the window becomes the new
* reference point, and one outside it (at $3C20) the new outside point.
* There's no limit on the number of steps.
* 
* I:A An outcode
* O:DE x + $8000
* O:HL y + $8000
move_point_to_edge:                                        ; >3be0
       .proc
       andi a,>f000                                        ; AND $F0           ; keep only the "exactly on boundary" bits
       jeq  bisect_clip_single_outside_endpoint            ; JR Z,$3BEC        ; none set - go bisect
       movb @clip_reference_x+1,de                         ; LD DE,($E827)     ; already on a boundary - DE = the reference X
       movb @clip_reference_x,@e                           ;                   ;
       movb @clip_reference_y+1,hl                         ; LD HL,($E829)     ; and reference Y
       movb @clip_reference_y,@l                           ;                   ;
       jmp  move_point_to_edge_exit                        ; RET               ; 
bisect_clip_single_outside_endpoint:                       ; >3bec
       mov  @clip_point2_x,hl                              ; LD HL,($EB96)     ; HL = the outside point's current X
       movb @clip_reference_x+1,de                         ; LD DE,($E827)     ; DE = the reference X
       movb @clip_reference_x,@e                           ;                   ;
       a    de,hl                                          ; ADD HL,DE         ; HL = sum
       jnc  !                                              ; RR H              ; halve... (the ADD's carry is bit 16 of the sum)
       srl  hl,1                                           ; RR L              ; 
       ori  hl,>8000                                       ;                   ; (ORI leaves the carry from the SRL alone)
       jmp  !!                                             ;                   ; 
!
       srl  hl,1                                           ;                   ; 
!
       jnc  _3bfb                                          ; JR NC,$3BFB       ; 
       inc  hl                                             ; INC HL            ; round the midpoint X up
_3bfb:                                                     ; >3bfb
       .ex_de_hl                                           ; EX DE,HL          ; DE = midpoint X
       movb @clip_reference_y+1,hl                         ; LD HL,($E829)     ; HL = the reference Y
       movb @clip_reference_y,@l                           ;                   ;
       mov  @clip_point2_y,bc                              ; LD BC,($EB98)     ; BC = the outside point's current Y
       a    bc,hl                                          ; ADD HL,BC         ; HL = sum
       jnc  !                                              ; RR H              ; halve... (the ADD's carry is bit 16 of the sum)
       srl  hl,1                                           ; RR L              ; 
       ori  hl,>8000                                       ;                   ; (ORI leaves the carry from the SRL alone)
       jmp  !!                                             ;                   ; 
!
       srl  hl,1                                           ;                   ; 
!
       jnc  _3c0b                                          ; JR NC,$3C0B       ; 
       inc  hl                                             ; INC HL            ; round the midpoint Y up
_3c0b:                                                     ; >3c0b
       bl   @outcode                                       ; CALL $3A72        ; C = the midpoint's outcode
       movb @c,a                                           ; LD A,C            ; 
       andi a,>0f00                                        ; AND $0F           ; keep only the true outcode bits
       jne  bisect_move_outside_endpoint_to_midpoint       ; JR NZ,$3C20       ; still outside - move the outside point to the midpoint and loop
       movb @c,a                                           ; LD A,C            ; midpoint passes both true-outcode tests
       andi a,>f000                                        ; AND $F0           ; test the "exactly on boundary" bits
       jeq  !                                              ; RET NZ            ; on a boundary - done, DE/HL hold the midpoint
move_point_to_edge_exit:
       .endproc                                            ;                   
!
       movb de,@clip_reference_x+1                         ; LD ($E827),DE     ; fully inside - it becomes the new reference X
       movb @e,@clip_reference_x                           ;                   ;
       movb hl,@clip_reference_y+1                         ; LD ($E829),HL     ; and reference Y
       movb @l,@clip_reference_y                           ;                   ;
       jmp  _3c27                                          ; JR $3C27          ; loop again from the (now closer) reference
bisect_move_outside_endpoint_to_midpoint:                  ; >3c20
       mov  de,@clip_point2_x                              ; LD ($EB96),DE     ; the outside point's X becomes the midpoint X
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; and midpoint Y
_3c27:                                                     ; >3c27
       jmp  bisect_clip_single_outside_endpoint            ; JR $3BEC          ; bisect again

********************************************************************************
* Convert clipped line endpoints to screen space, then set up the draw
* [line-draw]
* 
* Used by the routine at #R$3AC2.
* .
* The entry point for actually drawing a clipped line segment: reached
* directly from #R$3AC2 when both endpoints were trivially inside the
* clip rectangle, or via #R$3BDA once the boundary-clipping code (the
* #R$3B26/#R$3B3B/#R$3BEC cluster) has replaced
* a clipped-out endpoint with the computed intersection point.
* .
* Converts each endpoint's raw coordinate to screen space via the same
* $0300+$57 lookup table for the "column" axis (E and C) and a $40-value
* flip for the "row" axis (D and B, mirroring around row $40) - then
* falls into #R$3C48 to set up the Bresenham walk.
* 
* I:E The first endpoint's raw column value (via $EB96)
* I:L The first endpoint's raw row value (via $EB98)
* I:($EB92) The second endpoint's column-axis raw value
* I:($EB94) The second endpoint's row-axis raw value
clip_endpoints_to_screen_space:                            ; >3c29
       movb @l,d                                           ; LD D,L            ; D = the first endpoint's raw row value (was in L)
       movb @e,@l                                          ; LD L,E            ; L = the first endpoint's raw column value (was in E)
       movb @l,r1                                          ; LD H,$03          ; R1 = the column, for the column-lookup table
       srl  r1,8                                           ;                   ; 
       movb @scale_3_4_table(r1),a                         ; LD A,(HL)         ; A = table[column]
       ab   @bytes+>57,a                                   ; ADD A,$57         ; 
       movb a,@e                                           ; LD E,A            ; E = screen-space column, first endpoint
       movb @bytes+>40,a                                   ; LD A,$40          ; 
       sb   d,a                                            ; SUB D             ; A = $40 - raw row (mirror around row $40)
       movb a,d                                            ; LD D,A            ; D = screen-space row, first endpoint
       movb @clip_point1_x+1,a                             ; LD A,($EB92)      ; A = the second endpoint's raw column value
       movb a,@l                                           ; LD L,A            ; 
       movb a,r1                                           ; LD A,(HL)         ; 
       srl  r1,8                                           ;                   ; 
       movb @scale_3_4_table(r1),a                         ;                   ; A = table[column]
       ab   @bytes+>57,a                                   ; ADD A,$57         ; 
       movb a,@c                                           ; LD C,A            ; C = screen-space column, second endpoint
       movb @clip_point1_y+1,a                             ; LD A,($EB94)      ; A = the second endpoint's raw row value
       sb   @bytes+>40,a                                   ; SUB $40           ; 
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = $40 - raw row (same mirror, computed the other way round)
       movb a,b                                            ; LD B,A            ; B = screen-space row, second endpoint
       b    @setup_bresenham_line                          ; JP $3C48          ; hand off (D,E)/(B,C) to the Bresenham setup

********************************************************************************
* Draw a line
* 
* Used by the routines at #R$2DC8 and #R$3C29.
* .
* Draws the line from (B, C) to (D, E) - row, column - into the space
* view's bitmap buffer at $D600, which #R$3846 copies to the screen. Swaps
* the points if needed so that the line goes from the higher row to the
* lower one, and works out dx and dy, and the start's address in the buffer
* (#R$3CEC) and pixel mask.
* .
* A shallow line is drawn by the Bresenham loop at $3C86, dx pixels,
* stepping the row when the error term runs out (at $3CA5 when it doesn't);
* its pixel mask rotation ($3C94) and byte step ($3C98) are patched for the
* direction of the line, here or at $3C7C for the other direction. A steep
* line is drawn by the loop at $3CC6, dy pixels, stepping the column (at
* $3CE4 when it doesn't), patched at $3CAD or $3CBC. The pixels are ORed in
* at $3CA7 and $3CE6 (#R$6CB2 changes the OR to XOR).
* 
* I:B,C One end (row, column)
* I:D,E The other end (row, column)
setup_bresenham_line:                                      ; >3c48
       movb d,a                                            ; LD A,D            ; A = row of the (candidate) first endpoint
       cb   a,b                                            ; CP B              ; compare against the second endpoint's row
       jhe  _3c51                                          ; JR NC,$3C51       ; already D>=B - no swap needed
       movb b,d                                            ; LD D,B            ; swap D<->B...
       movb a,b                                            ; LD B,A            ; ...(A holds the old D)
       movb @e,a                                           ; LD A,E            ; and swap E<->C together, keeping the pairs matched
       movb @c,@e                                          ; LD E,C            ; 
       movb a,@c                                           ; LD C,A            ; now D>=B - walking from the higher row to the lower
_3c51:                                                     ; >3c51
       bl   @view_mark_line                                ;                   ; (TI: mark the characters the line covers)
       movb @e,a                                           ; LD A,E            ; A = column of the (now-first) endpoint
       sb   @c,a                                           ; SUB C             ; A = E-C
       li   r2,1                                           ; PUSH AF           ; R2 = the column step: +1 if E>=C...
       joc  _3c58                                          ; JR NC,$3C58       ; E>=C - already non-negative (TI carry: no borrow)
       andi a,>ff00                                        ;                   ; 
       neg  a                                              ; NEG               ; else negate
       seto r2                                             ;                   ; ...or -1
_3c58:                                                     ; >3c58
       movb a,@e                                           ; LD E,A            ; E = dx = abs(E-C), the column delta
       movb d,a                                            ; LD A,D            ; 
       sb   b,a                                            ; SUB B             ; A = D-B (non-negative, since D>=B now)
       movb a,d                                            ; LD D,A            ; D = dy, the row delta
       bl   @row_column_to_buffer_address                  ; CALL $3CEC        ; HL = buffer address for the second endpoint (B,C)
       movb @c,r1                                          ; LD A,C            ; second endpoint's column...
       andi r1,>0700                                       ; AND $07           ; ...its bit position within the byte
       srl  r1,8                                           ; LD ($3C66),A      ; 
line_start_mask:                                           ; >3c65
       movb @pixel_bitmask_table(r1),r1                    ; LD A,($E702)      ; R1 = the pixel bitmask for that bit position...
       andi r1,>ff00                                       ; LD C,A            ; ...in its high byte (a zero high byte means a byte boundary was crossed)
       li   r0,>8000                                       ; LD A,$09          ; moving right: the mask wraps round to bit 7...
       mov  @line_rotate_right,@line_shallow_rotate_pad    ; LD ($3C94),A      ; ...rotating right
       mov  r2,r2                                          ;                   ; 
       jgt  !                                              ; JR C,$3C7C        ; 
       li   r0,>0100                                       ; LD A,$01          ; moving left: it wraps round to bit 0...
       mov  @line_rotate_left,@line_shallow_rotate_pad     ; LD ($3C94),A      ; ...rotating left
!
       mov  r0,@line_mask_wrap                             ;                   ; 
       mov  @line_shallow_rotate_pad,@line_steep_rotate_pad ; LD ($3CDD),A      ; the same rotate for the steep loop
       movb @e,a                                           ; LD A,E            ; A = dx
       cb   a,d                                            ; CP D              ; compare dx against dy
       jl   steep_line_loop                                ; JR C,$3CAD        ; dx < dy - a steep line
shallow_line_loop:                                         ; >3c86
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; dx=0 - nothing to draw
       .ret                                                ;                   ; 
!
       movb a,b                                            ; LD B,A            ; B = dx, the loop counter
       movb a,r0                                           ; RRA               ; 
       srl  r0,1                                           ; LD H,A            ; R0 (high byte) = dx/2, the Bresenham error term
       b    @line_shallow_rotate_pad                       ;                   ; the pixel loop runs in scratchpad (line_loops)
steep_line_loop:                                           ; >3cc6
       movb d,a                                            ; LD A,D / OR A     ; A = dy (also the loop count)
       jne  !                                              ; RET Z             ; dy=0 - nothing to draw
       .ret                                                ;                   ; 
!
       movb a,b                                            ; LD B,A            ; B = dy, the loop counter
       movb a,r0                                           ; RRA               ; 
       srl  r0,1                                           ; LD H,A            ; R0 (high byte) = dy/2, the Bresenham error term
       b    @line_steep_loop_pad                           ;                   ; the pixel loop runs in scratchpad (line_loops)
* The rotate instructions copied into the line loops in scratchpad, and the
* plot operations #R$6CB2 copies there. Never executed here.
line_rotate_right:
       srl  r1,1                                           ;                   ; the pixel moves right
line_rotate_left:
       sla  r1,1                                           ;                   ; the pixel moves left
line_plot_or:
       socb r1,a                                           ;                   ; 
line_plot_xor:
       xor  r1,a                                           ;                   ; 
line_mask_wrap:
       data 0                                              ;                   ; the pixel bitmask after crossing a byte boundary

********************************************************************************
* TI: Mark the part of the space view that a line covers
* 
* Copying the whole space view to the screen (#R$3846) and clearing its
* buffer (#R$388F) take long, so for each of the 16 character rows the game
* keeps track of the first and last character that have been drawn in since
* the buffer was cleared (view_min and view_max; the first is after the last
* if none have been). #R$388F only clears those, and #R$3846 only copies
* those and the ones it copied last time (view_prev_min and view_prev_max),
* which are still on the screen. Everything that draws in the buffer marks
* what it covers: lines (#R$3C48), which mark the rectangle they are in;
* pixels (#R$3CFD); and the message (#R$3A03). #R$63F1 marks everything
* (view_mark_all), as then neither the buffer nor the screen is known.
* 
* I:B,D The rows of the line's ends (B <= D)
* I:C,E The columns of its ends
view_mark_line:
       movb @c,r0                                          ;                   ; 
       movb @e,r2                                          ;                   ; 
       cb   r0,r2                                          ;                   ; 
       jle  view_mark_line_1                               ;                   ; 
       movb r2,r0                                          ;                   ; R0 = the lower column, R2 the higher
       movb @c,r2                                          ;                   ; 
view_mark_line_1:
       srl  r0,3                                           ;                   ; as characters
       srl  r2,3                                           ;                   ; 
       movb d,a                                            ;                   ; 
       srl  a,11                                           ;                   ; A = the last character row
       movb b,r1                                           ;                   ; 
       srl  r1,11                                          ;                   ; R1 = the first
* This entry point is used by #R$3CFD, with R0 = R2 = the character and R1 = A
* = the character row.
view_mark_rows:
       cb   r0,@view_min(r1)                               ;                   ; 
       jhe  view_mark_rows_1                               ;                   ; 
       movb r0,@view_min(r1)                               ;                   ; 
view_mark_rows_1:
       cb   r2,@view_max(r1)                               ;                   ; 
       jle  view_mark_rows_2                               ;                   ; 
       movb r2,@view_max(r1)                               ;                   ; 
view_mark_rows_2:
       inc  r1                                             ;                   ; 
       c    r1,a                                           ;                   ; 
       jle  view_mark_rows                                 ;                   ; 
       rt                                                  ;                   ; 

********************************************************************************
* Work out an address in the space view's bitmap buffer
* 
* Used by the routines at #R$3C48, #R$3CFD and #R$3F68.
* .
* Returns $D600 + B * 32 + C / 8, the address of the byte holding pixel
* (B, C) in the space view's bitmap buffer (#R$D600). B isn't checked.
* 
* I:B Row (0-127)
* I:C Column
* O:HL The address
row_column_to_buffer_address:                              ; >3cec
       movb b,r0                                           ; LD H,B            ; R0 = row...
       movb @c,@r0lb                                       ; LD A,C            ; ...and column
       srl  r0,3                                           ; SRL H             ; shift the 16-bit (row,column) pair right 3 bits: row * 32 + column / 8
       ai   r0,space_view_buffer                           ; ADD A,$D6         ; add the buffer's address
       mov  r0,hl                                          ; LD H,A            ; HL = the buffer address
       rt                                                  ; RET               ; 

********************************************************************************
* Plot a single pixel at a (row, column) position [line-draw]
* 
* Used by the routines at #R$3DD7 and #R$68CD.
* .
* The single-point special case of #R$3C86/#R$3CC6's line loop: converts
* BC to a buffer address via #R$3CEC, patches the pixel-bitmask lookup
* at $3D07/$E700 for C's low 3 bits (the same idiom #R$3C48 uses via
* $3C65/$E702), and ORs the bitmask into that one buffer byte.
* 
* I:B Row (passed straight to #R$3CEC, unclamped there too)
* I:C Column
plot_single_pixel:                                         ; >3cfd
       .proc
plot_single_pixel_jmp:
       bl   @row_column_to_buffer_address                  ; CALL $3CEC        ; HL = buffer address for (B,C)
       movb @c,r0                                          ;                   ; (TI: mark its character, see view_mark_line)
       srl  r0,3                                           ;                   ; 
       mov  r0,r2                                          ;                   ; 
       movb b,r1                                           ;                   ; 
       srl  r1,11                                          ;                   ; 
       mov  r1,a                                           ;                   ; 
       bl   @view_mark_rows                                ;                   ; 
       movb @c,a                                           ; LD A,C            ; A = column
       andi a,>0700                                        ; AND $07           ; keep the low 3 bits (bit position within the byte)
       mov  a,r1                                           ; LD ($3D07),A      ; index the table with A (instead of patching the operand)
       srl  r1,8                                           ;                   ;
plot_pixel_mask:                                           ; >3d06
       movb @pixel_bitmask_table(r1),a                     ; LD A,($E700)      ; A = the pixel bitmask for that bit position
       movb a,@c                                           ; LD C,A            ; C = the pixel bitmask
       movb *hl,a                                          ; LD A,(HL)         ; A = the current buffer byte
       socb @c,a                                           ; OR C              ; OR in the pixel bitmask
       movb a,*hl                                          ; LD (HL),A         ; write the plotted pixel
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw a circle
* 
* Used by the routines at #R$4A86 and #R$6CB2.
* .
* Draws a circle of radius HL around (IX, IY) as four arcs, one for each
* quadrant, each a series of lines (#R$3AC2). Splits the radius into an
* 8-bit mantissa and a shift count ($EB9C, $EB9B), then takes B steps
* through the cos/sin table at #R$1311, 2 + DE bytes apart, scaling each
* (cos, sin) by the radius (#R$3D76). At $3D4E, adds the four points (cos,
* sin), (-cos, sin), (-cos, -sin) and (cos, -sin) to the centre (#R$3D8C),
* joining each to the same quadrant's point from the step before. Used for
* the planet (#R$4A86: 10 steps of 10 degrees) and the tunnel rings
* (#R$6CB2: 3 steps of 45 degrees, centred on (0, 0)).
* 
* I:B Number of steps
* I:DE Bytes to skip in the table after each step
* I:HL Radius
* I:IX Centre x
* I:IY Centre y
draw_circle:                                               ; >3d0e
       .proc
draw_circle_jmp:
       movb h,a                                            ; LD A,H / OR A     ; A = the magnitude's high byte
       jeq  _3d1d                                          ; JR Z,$3D1D        ; yes - shift count stays 0, skip the normalizing loop
       sb   @c,@c                                          ; LD C,$00          ; C = shift count so far
draw_circle_shift:                                         ; >3d14
       ab   one,@c                                         ; INC C             ; count this shift
       movb a,r0                                           ; RRA               ; shift A (the magnitude's high byte)...
       movb @l,@r0lb                                       ; RR L              ; ...and L along with it
       srl  r0,1                                           ;                   ; 
       movb @r0lb,@l                                       ;                   ; 
       movb r0,a                                           ; OR A              ; does the high byte still not fit in L alone?
       jne  draw_circle_shift                              ; JP NZ,$3D14       ; keep shifting until it does
!
       movb @c,a                                           ; LD A,C            ; A = the final shift count
_3d1d:                                                     ; >3d1d
       movb a,@depth_shift                                 ; LD ($EB9B),A      ; cache the shift count
       movb @l,a                                           ; LD A,L            ; A = the reduced mantissa (magnitude >> shift count)
       movb a,@shared_normalize_mantissa                   ; LD ($EB9C),A      ; cache the mantissa for #R$3D76 to multiply against
       movb a,@circle_first_step                           ; LD ($E80C),A      ; also seed the "first vertex" flag with it (nonzero unless the whole magnitude was 0)
       movb ix,@circle_centre_x+1                          ; LD ($E81F),IX     ; cache the caller's centre X
       movb @ixl,@circle_centre_x                          ;                   ;
       movb iy,@circle_centre_y+1                          ; LD ($E821),IY     ; cache the caller's centre Y
       movb @iyl,@circle_centre_y                          ;                   ;
       li   hl,trig_table_coarse                           ; LD HL,$1311       ; HL -> #R$1311's coarse trig table
_3d32:                                                     ; >3d32
       .push bc                                            ; PUSH BC           ; save the outer step counter (B) and its partner C
       .push de                                            ; PUSH DE           ; save the caller's per-step pointer stride (DE) too
       movb *hl,@c                                         ; LD C,(HL)         ; C = this step's cos byte
       inc  hl                                             ; INC HL            ; 
       movb *hl,@e                                         ; LD E,(HL)         ; E = this step's sin byte
       inc  hl                                             ; INC HL            ; HL now points past this step's record
       .push hl                                            ; PUSH HL           ; save the table pointer
       bl   @scale_by_trig_byte                            ; CALL $3D76        ; HL = the scaled sin offset (E was the sin byte)
       .push hl                                            ; PUSH HL           ; save it
       movb @c,@e                                          ; LD E,C            ; E = the cos byte this time
       bl   @scale_by_trig_byte                            ; CALL $3D76        ; HL = the scaled cos offset
       .ex_de_hl                                           ; EX DE,HL          ; DE = the scaled cos offset
       .pop bc                                             ; POP BC            ; BC = the scaled sin offset (popped back in LIFO order)
       movb @circle_first_step,a                           ; LD A,($E80C) / OR A; is this the very first step (flag still nonzero)?
       jeq  plot_one_table_steps_vertex_all                ; JR Z,$3D4E        ; no - the 4 slots already hold the previous step's points
       li   hl,circle_saved_sp                             ; LD HL,$E81D       ; yes - nothing to connect to yet; target the (still-empty) slots directly
       jmp  _3d51                                          ; JR $3D51          ; 
plot_one_table_steps_vertex_all:                           ; >3d4e
       li   hl,circle_previous_points_top                  ; LD HL,$E819       ; entry for step 2 onward - the 4 slots here already hold step 1's vertices
_3d51:                                                     ; >3d51
       .push de                                            ; PUSH DE           ; save the scaled cos offset (about to be negated)
       bl   @draw_circle_point                             ; CALL $3D8C        ; plot quadrant 1: (DE,BC)
       neg  de                                             ; SUB E             ; DE = -DE
       bl   @draw_circle_point                             ; CALL $3D8C        ; plot quadrant 2: (-DE,BC)
       neg  bc                                             ; SUB C             ; BC = -BC
       bl   @draw_circle_point                             ; CALL $3D8C        ; plot quadrant 3: (-DE,-BC)
       .pop de                                             ; POP DE            ; DE = the original (positive) cos offset again
       bl   @draw_circle_point                             ; CALL $3D8C        ; plot quadrant 4: (DE,-BC)
       sb   a,a                                            ; XOR A             ; 
       movb a,@circle_first_step                           ; LD ($E80C),A      ; clear the "first vertex" flag - later steps connect edges
       .pop hl                                             ; POP HL            ; HL = the table pointer #R$3D32 saved
       .pop de                                             ; POP DE            ; DE = the caller's per-step stride, saved untouched
       .pop bc                                             ; POP BC            ; BC = the outer step counter (B) and its old partner C
       a    de,hl                                          ; ADD HL,DE         ; advance the table pointer by the stride, on top of the 2 bytes already consumed reading this step's record
       sb   one,b                                          ; DJNZ $3D32        ; loop for the next step
       jne  _3d32                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Scale #R$3D0E's magnitude by one #R$1311 trig byte
* 
* Used by the routine at #R$3D0E.
* .
* Multiplies the mantissa #R$3D0E cached at $EB9C by the trig-table byte
* in E (#R$1F60: HL = A*E), then shifts the 16-bit product right by (7
* minus the shift count #R$3D0E cached at $EB9B) to restore the
* original magnitude's scale - undoing #R$1311's $80=1.0 fixed-point
* format and #R$3D0E's own mantissa-reducing shift in a single pass. A
* shift count of exactly 7 needs no further shift at all (#R$1F60's
* product is already correctly scaled) and returns immediately. A shift
* count over 8 (magnitude >= $8000, since #R$3D0E's count is the
* original high byte's bit length) makes A wrap negative here, so B
* becomes a large positive value and the DJNZ loop shifts far past
* zero - silently collapsing the result to 0 rather than clamping; not
* confirmed whether #R$3D0E's callers ever reach that far.
* 
* I:E A trig-table byte (cos or sin, #R$1311's format)
* O:HL The magnitude, scaled by E/$80
scale_by_trig_byte:                                        ; >3d76
       .proc
       movb @shared_normalize_mantissa,a                   ; LD A,($EB9C)      ; A = the cached mantissa
       bl   @multiply_a_e_16bit                            ; CALL $1F60        ; HL = mantissa * E (the trig byte)
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; A = the cached shift count
       sb   @bytes+>07,a                                   ; SUB $07           ; 
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = 7 - shift count
       jeq  scale_by_trig_byte_exit                        ; RET Z             ; already correctly scaled - done
!
       movb a,b                                            ; LD B,A            ; B = the remaining shift count
_3d85:                                                     ; >3d85
       srl  h,1                                            ; SRL H             ; shift HL right...
       ; RR L                                              ; RR L              ; ...one bit at a time (done by the SRL H above, which shifts all of HL)
       sb   one,b                                          ; DJNZ $3D85        ; 
       jne  _3d85                                          ;                   
scale_by_trig_byte_exit:
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw a circle: a point
* 
* Used by the routine at #R$3D0E.
* .
* Adds the offset (DE, BC) to the centre ($E81F, $E821). On the first step
* (($E80C) set) just stores the point in the 4-byte slot below HL;
* otherwise (at $3DAC) draws the line (#R$3AC2) to it from the point stored
* there - the same quadrant's point from the step before - and stores the
* new one. Uses SP to read and write the slot.
* 
* I:BC y offset
* I:DE x offset
* I:HL The slot
* O:HL The next slot
draw_circle_point:                                         ; >3d8c
* TI: the slots are read and written through HL, rather than by pointing SP at
* them (the stack grows up on the TI); a slot holds X at +2 and Y at +0.
       .proc                                               ;                   ; 
       movb @circle_first_step,a                           ; LD A,($E80C)      ; still the first step (nothing in the slot to connect to yet)?
       jeq  write_vertex_and_draw_edge                     ; OR A / JR Z,$3DAC ; no - read the slot and draw the line
       movb @circle_centre_x+1,r0                          ; LD HL,($E81F)     ; R0 = the centre X...
       movb @circle_centre_x,@r0lb                         ;                   ; 
       a    de,r0                                          ; ADD HL,DE         ; ...+ this step's cos-scaled offset
       movb r0,@-2(hl)                                     ; PUSH HL           ; the vertex's X, 2 bytes below the cursor
       movb @r0lb,@-1(hl)                                  ;                   ; 
       movb @circle_centre_y+1,r0                          ; LD HL,($E821)     ; R0 = the centre Y...
       movb @circle_centre_y,@r0lb                         ;                   ; 
       a    bc,r0                                          ; ADD HL,BC         ; ...+ this step's sin-scaled offset
       movb r0,@-4(hl)                                     ; PUSH HL           ; the vertex's Y, 4 bytes below the cursor
       movb @r0lb,@-3(hl)                                  ;                   ; 
       ai   hl,-4                                          ; LD HL,$0000 / ADD HL,SP; HL = the new cursor (old cursor - 4)
       jmp  draw_circle_point_exit                         ; RET               ; 
write_vertex_and_draw_edge:                                ; >3dac
       movb *hl,r0                                         ; POP HL            ; R0 = the slot's old Y (this quadrant's vertex from the last step)
       movb @1(hl),@r0lb                                   ;                   ; 
       mov  r0,@clip_point2_y                              ; LD ($EB98),HL     ; -> point 2's Y
       movb @2(hl),r0                                      ; POP HL            ; R0 = the slot's old X
       movb @3(hl),@r0lb                                   ;                   ; 
       mov  r0,@clip_point2_x                              ; LD ($EB96),HL     ; -> point 2's X
       movb @circle_centre_x+1,r0                          ; LD HL,($E81F)     ; R0 = the centre X...
       movb @circle_centre_x,@r0lb                         ;                   ; 
       a    de,r0                                          ; ADD HL,DE         ; ...+ this step's cos-scaled offset
       mov  r0,@clip_point1_x                              ; LD ($EB92),HL     ; -> point 1's X
       movb r0,@2(hl)                                      ; PUSH HL           ; and the slot's, for the next step
       movb @r0lb,@3(hl)                                   ;                   ; 
       movb @circle_centre_y+1,r0                          ; LD HL,($E821)     ; R0 = the centre Y...
       movb @circle_centre_y,@r0lb                         ;                   ; 
       a    bc,r0                                          ; ADD HL,BC         ; ...+ this step's sin-scaled offset
       mov  r0,@clip_point1_y                              ; LD ($EB94),HL     ; -> point 1's Y
       movb r0,*hl                                         ; PUSH HL           ; and the slot's, for the next step
       movb @r0lb,@1(hl)                                   ;                   ; 
       ai   hl,-4                                          ; LD HL,$FFFC / ADD HL,SP; HL = the new cursor (old cursor - 4)
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; save the registers across the line-draw call
       bl   @clip_and_draw_line                            ; CALL $3AC2        ; clip and draw the edge from point 1 to point 2
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
draw_circle_point_exit:
       .endproc                                            ; RET               ; 

********************************************************************************
* Clip-test and plot a single point [line-draw]
* 
* Used by the routine at #R$4AEC.
* .
* The single-point counterpart of #R$3AC2's line-clip pipeline: biases
* DE/HL into #R$3A72's unsigned comparison range and tests the outcode;
* if the point fails any true boundary, it's off-screen and this returns
* without drawing. Otherwise converts it to screen space the same way
* #R$3C29 does for its first endpoint (the $0300 column-lookup table
* plus $57, and the $40-row mirror) and plots it via #R$3CFD.
* 
* I:D/E Raw X, high/low byte (D gets biased by #R$3A72's own convention)
* I:H/L Raw Y, high/low byte (H gets biased likewise)
clip_test_and_plot_single_point:                           ; >3dd7
       .proc
       movb d,a                                            ; LD A,D            ; A = X's high byte
       ab   @bytes+>80,a                                   ; ADD A,$80         ; bias it into the unsigned comparison range
       movb a,d                                            ; LD D,A            ; 
       movb h,a                                            ; LD A,H            ; A = Y's high byte
       ab   @bytes+>80,a                                   ; ADD A,$80         ; bias it likewise
       movb a,h                                            ; LD H,A            ; 
       bl   @outcode                                       ; CALL $3A72        ; C = this point's outcode
       movb @c,a                                           ; LD A,C            ; 
       andi a,>0f00                                        ; AND $0F           ; keep only the true outcode bits
       jeq  !                                              ; RET NZ            ; off-screen - nothing to plot
       .endproc                                            ;                   
!
       movb @bytes+>40,a                                   ; LD A,$40          ; 
       sb   @l,a                                           ; SUB L             ; A = $40 - raw row (the same row mirror #R$3C29 uses)
       movb a,b                                            ; LD B,A            ; B = screen-space row
       movb @e,@l                                          ; LD L,E            ; L = raw column (X's low byte)
       movb @l,r1                                          ; LD H,$03          ; R1 = the column, for the column-lookup table
       srl  r1,8                                           ;                   ; 
       movb @scale_3_4_table(r1),a                         ; LD A,(HL)         ; A = table[column]
       ab   @bytes+>57,a                                   ; ADD A,$57         ; 
       movb a,@c                                           ; LD C,A            ; C = screen-space column
       b    @plot_single_pixel_jmp                         ; JP $3CFD          ; plot the pixel at (B,C)

********************************************************************************
* Draw a filled disc
* 
* Used by the routine at #R$4A86.
* .
* Draws the sun, or any other object too small or far away to draw as a
* wireframe (#R$4A86), as a filled disc of radius HL (under 256) around
* (IX, IY), with a ragged edge: up to 2 pixels for the sun (ship type $65),
* 1 otherwise ($E604). Takes 10 steps of 10 degrees through the cos/sin
* table at #R$1311, scaling each (cos, sin) by the radius (#R$1F60), and
* (at $3E58) fills the part of the disc between each step's point and the
* one before (#R$3E6A).
* 
* I:HL Radius (#R$EB9E)
* I:IX Centre x
* I:IY Centre y
draw_disc:                                                 ; >3df4
       movb h,a                                            ; LD A,H / OR A     ; A = the magnitude's high byte
       jeq  !                                              ; RET NZ            ; no - out of range for this routine, do nothing
       .ret                                                ;                   
!
       movb a,@scratch_buffer                              ; LD ($E600),A      ; A=0: reset the row-fill countdown (see prose)
       movb a,@lineplot_scratch_vars_e603                  ; LD ($E603),A      ; and the running sign-accumulator
       movb @l,a                                           ; LD A,L            ; A = the magnitude (fits in a byte)
       movb a,@shared_normalize_mantissa                   ; LD ($EB9C),A      ; cache it as the mantissa for #R$1F60's multiply
       movb a,@circle_first_step                           ; LD ($E80C),A      ; also seed the "first step" flag with it
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>65                                   ; CP $65            ; is it mode $65?
       jne  !                                              ; JR Z,$3E0E        ; (tested before the load, which changes the status on the TI)
       movb @bytes+>02,a                                   ; LD A,$02          ; yes - type 2
       jmp  _3e0e                                          ;                   ; 
!
       movb one,a                                          ; DEC A             ; no - type 1
_3e0e:                                                     ; >3e0e
       movb a,@scratch_buffer_4                            ; LD ($E604),A      ; cache the type
       li   bc,>8000                                       ; LD BC,$8000       ; 
       a    bc,ix                                          ; ADD IX,BC         ; bias the centre X into clip-space convention
       movb ix,@circle_centre_x+1                          ; LD ($E81F),IX     ; cache it
       movb @ixl,@circle_centre_x                          ;                   ;
       a    bc,iy                                          ; ADD IY,BC         ; bias the centre Y likewise
       movb iy,@circle_centre_y+1                          ; LD ($E821),IY     ; cache it
       movb @iyl,@circle_centre_y                          ;                   ;
       li   iy,partial_byte_right_mask_table_8             ; LD IY,$4014       ; IY -> #R$4014's partial-byte mask table (fixed for the whole call tree)
       li   hl,trig_table_coarse                           ; LD HL,$1311       ; HL -> #R$1311's trig table
       movb @bytes+>0a,b                                   ; LD B,$0A          ; 10 steps
_3e29:                                                     ; >3e29
       .push bc                                            ; PUSH BC           ; save the outer step counter
       movb *hl,@c                                         ; LD C,(HL)         ; C = this step's cos byte
       inc  hl                                             ; INC HL            ; 
       movb *hl,@e                                         ; LD E,(HL)         ; E = this step's sin byte
       inc  hl                                             ; INC HL            ; HL now points past this step's record
       .push hl                                            ; PUSH HL           ; save the table pointer
       movb @shared_normalize_mantissa,a                   ; LD A,($EB9C)      ; A = the cached mantissa
       bl   @multiply_a_e_16bit                            ; CALL $1F60        ; HL = mantissa * sin byte
       mov  hl,r0                                          ; LD A,H            ; fold the 16-bit product into an 8-bit scaled value...
       sla  r0,1                                           ; RL L              ; 
       movb r0,a                                           ; RLA               ; A = (HL << 1) >> 8
       .ex_af_af_                                          ; EX AF,AF'         ; ...and stash it
       movb @shared_normalize_mantissa,a                   ; LD A,($EB9C)      ; A = the cached mantissa again
       movb @c,@e                                          ; LD E,C            ; E = this step's cos byte
       bl   @multiply_a_e_16bit                            ; CALL $1F60        ; HL = mantissa * cos byte
       mov  hl,r0                                          ; LD A,H            ; fold it the same way...
       sla  r0,1                                           ; RL L              ; 
       movb r0,a                                           ; RLA               ; A = (HL << 1) >> 8
       movb a,@c                                           ; LD C,A            ; C = the scaled cos value
       .ex_af_af_                                          ; EX AF,AF'         ; A = the scaled sin value (stashed above)
       movb a,b                                            ; LD B,A            ; B = the scaled sin value
       movb @circle_first_step,a                           ; LD A,($E80C) / OR A; still the first step (nothing to connect to yet)?
       jeq  fill_disc_connect_to_previous_step             ; JR Z,$3E58        ; no - go connect to the previous step
       movb bc,@circle_previous_points+1                   ; LD ($E80D),BC     ; yes - just cache this (scaled cos, scaled sin) pair for next step
       movb @c,@circle_previous_points                     ;                   ;
       sb   a,a                                            ; XOR A             ; 
       movb a,@circle_first_step                           ; LD ($E80C),A      ; clear the "first step" flag
       jmp  _3e63                                          ; JR $3E63          ; nothing to connect to yet
fill_disc_connect_to_previous_step:                        ; >3e58
       movb @circle_previous_points+1,de                   ; LD DE,($E80D)     ; DE = the previous step's scaled (cos,sin) pair
       movb @circle_previous_points,@e                     ;                   ;
       movb bc,@circle_previous_points+1                   ; LD ($E80D),BC     ; cache this step's pair for next time
       movb @c,@circle_previous_points                     ;                   ;
       bl   @draw_disc_fill_between_steps                  ; CALL $3E6A        ; fill the band between the two points
_3e63:                                                     ; >3e63
       .pop hl                                             ; POP HL            ; HL = the table pointer
       .pop bc                                             ; POP BC            ; BC = the outer step counter
       inc  hl                                             ; INC HL            ; advance past this step's 2-byte record
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $3E29        ; loop for the next step
       jne  _3e29                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a filled disc: fill between two steps
* 
* Used by the routine at #R$3DF4.
* .
* Walks the rows between the previous step's point and this one's, as a
* Bresenham line (a steep one at $3E92), filling each row's span (#R$3EAD).
draw_disc_fill_between_steps:                              ; >3e6a
       .proc
       movb @e,a                                           ; LD A,E            ; A = the previous step's scaled sin (dy-ish component)
       sb   @c,a                                           ; SUB C             ; A -= this step's scaled sin
       ;                                                   ; LD L,$01          ; (TI: the step of 1 is added with ONE, as SRL H below shifts into L)
       movb a,@e                                           ; LD E,A            ; E = the row delta
       movb b,a                                            ; LD A,B            ; A = the previous step's scaled cos
       sb   d,a                                            ; SUB D             ; A -= this step's scaled cos
       movb a,d                                            ; LD D,A            ; D = the column delta
       movb @e,a                                           ; LD A,E            ; A = the row delta
       cb   a,d                                            ; CP D              ; compare against the column delta
       jl   fill_disc_span_walk_y_major                    ; JR C,$3E92        ; row delta smaller - a steep line
       movb @e,h                                           ; LD H,E            ; H = row delta (Bresenham error term init)
       srl  h,1                                            ; SRL H             ; H = row delta / 2
       movb @e,a                                           ; LD A,E / OR A     ; A = the row delta (also the loop count)
       jeq  _3eac                                          ; RET Z             ; nothing to fill
!
       movb a,@ixl                                         ; LD IXL,A          ; IXl = loop count
draw_disc_next_row:                                        ; >3e7e
       movb @c,a                                           ; LD A,C            ; A = the column so far
       ab   one,a                                          ; ADD A,L           ; step it by 1 (L=1)
       movb a,@c                                           ; LD C,A            ; 
       movb h,a                                            ; LD A,H            ; error term
       sb   d,a                                            ; SUB D             ; -= column delta
       joc  _3e87                                          ; JR NC,$3E87       ; still non-negative - no row step this iteration
       sb   one,b                                          ; DEC B             ; underflowed - step the row
       ab   @e,a                                           ; ADD A,E           ; and correct the error term
_3e87:                                                     ; >3e87
       movb a,h                                            ; LD H,A            ; H = corrected error term
       bl   @draw_disc_fill_row                            ; CALL $3EAD        ; fill this row's span at (B,C)
       sb   one,@ixl                                       ; DEC IXL           ; one fewer column to go
       jne  draw_disc_next_row                             ; JP NZ,$3E7E       ; loop
!
       jmp  _3eac                                          ; JR $3EAC          ; done
fill_disc_span_walk_y_major:                               ; >3e92
       movb d,h                                            ; LD H,D            ; H = column delta (Bresenham error term init)
       srl  h,1                                            ; SRL H             ; H = column delta / 2
       movb d,a                                            ; LD A,D / OR A     ; A = column delta (also the loop count)
       jeq  _3eac                                          ; RET Z             ; nothing to fill
!
       movb a,@ixl                                         ; LD IXL,A          ; IXl = loop count
_3e9a:                                                     ; >3e9a
       sb   one,b                                          ; DEC B             ; step the row (every time)
       movb h,a                                            ; LD A,H            ; error term
       sb   @e,a                                           ; SUB E             ; -= row delta
       movb a,h                                            ; LD H,A            ; 
       joc  _3ea5                                          ; JR NC,$3EA5       ; still non-negative - no column step this iteration
       ab   d,a                                            ; ADD A,D           ; underflowed - correct the error term
       movb a,h                                            ; LD H,A            ; 
       movb @c,a                                           ; LD A,C            ; column so far
       ab   one,a                                          ; ADD A,L           ; step it by 1
       movb a,@c                                           ; LD C,A            ; 
_3ea5:                                                     ; >3ea5
       bl   @draw_disc_fill_row                            ; CALL $3EAD        ; fill this row's span at (B,C)
       sb   one,@ixl                                       ; DEC IXL           ; one fewer row to go
       jne  _3e9a                                          ; JR NZ,$3E9A       ; loop
_3eac:                                                     ; >3eac
       .endproc                                            ; RET               ; done

********************************************************************************
* Draw a filled disc: fill a row
* 
* Used by the routine at #R$3E6A.
* .
* Makes the disc's edge ragged: every 16 rows, picks new random bits
* (#R$2176); otherwise (at $3EC4) shifts the old ones ($E601). Each bit
* moves the edge's offset ($E603) out or in by a pixel, between 0 and the
* maximum in $E604. At $3EE4, works out the row's span from the centre
* plus and minus the half-width and that offset, clipped to the space view,
* and fills it (#R$3F68).
draw_disc_fill_row:                                        ; >3ead
       .proc
       .push bc                                            ; PUSH BC           ; save (row, column)
       .push de                                            ; PUSH DE           ; save (row delta, column delta)
       .push hl                                            ; PUSH HL           ; 
       movb @scratch_buffer,a                              ; LD A,($E600) / OR A; A = the row-fill countdown
       jne  fill_disc_decay_dither_value                   ; JR NZ,$3EC4       ; not time to reseed - decay the existing value
       .push bc                                            ; PUSH BC           ; time to reseed: save (row, column) again across the RNG calls
       bl   @random_byte                                   ; CALL $2176        ; A = a random byte
       movb a,@l                                           ; LD L,A            ; L = it
       bl   @random_byte                                   ; CALL $2176        ; A = another random byte
       movb a,h                                            ; LD H,A            ; H = it - (H,L) is the fresh jitter seed
       .pop bc                                             ; POP BC            ; restore (row, column)
       movb @bytes+>10,a                                   ; LD A,$10          ; reset the countdown to 16
       jmp  _3ec7                                          ; JR $3EC7          ; join the shared tail
fill_disc_decay_dither_value:                              ; >3ec4
       movb @scratch_buffer_1+1,hl                         ; LD HL,($E601)     ; HL = the previous jitter seed
       movb @scratch_buffer_1,@l                           ;                   ;
_3ec7:                                                     ; >3ec7
       sb   one,a                                          ; DEC A             ; one fewer call before the next reseed
       movb a,@scratch_buffer                              ; LD ($E600),A      ; store the countdown back
       movb @scratch_buffer_4,a                            ; LD A,($E604)      ; A = #R$3DF4's "type" value (1 or 2)
       movb a,@e                                           ; LD E,A            ; E = it
       srl  hl,1                                           ; RR H              ; shift the jitter seed right (the carry in is always 0 here)
       ;                                                   ; RR L              ; 
       movb hl,@scratch_buffer_1+1                         ; LD ($E601),HL     ; store the decayed seed back for next time
       movb @l,@scratch_buffer_1                           ;                   ;
       movb @zero,a                                        ; SBC A,A           ; A = 0 or $FF, from the shift's final carry (MOV leaves the carry alone)
       jnc  !                                              ;                   ; 
       movb @b255,a                                        ;                   ; 
!
       jne  _3eda                                          ; JR NZ,$3EDA       ; $FF - keep it
       ab   one,a                                          ; INC A             ; 0 - bump to 1 (never a zero jitter step)
_3eda:                                                     ; >3eda
       li   hl,lineplot_scratch_vars_e603                  ; LD HL,$E603       ; -> the running sign-accumulator
       ab   *hl,a                                          ; ADD A,(HL)        ; add this step's +-1 jitter to it
       jgt  fill_disc_row_span_bounds                      ; JP P,$3EE4        ; still non-negative - go compute the span
       jeq  fill_disc_row_span_bounds                      ;                   ; 
!
       sb   a,a                                            ; XOR A             ; negative - clamp to 0
       jmp  _3ee8                                          ; JR $3EE8          ; 
fill_disc_row_span_bounds:                                 ; >3ee4
       cb   a,@e                                           ; CP E              ; does the jittered value exactly hit the "type" value?
       jne  _3ee8                                          ; JR NZ,$3EE8       ; no - keep it
       sb   one,a                                          ; DEC A             ; yes - nudge it down by one
_3ee8:                                                     ; >3ee8
       movb a,*hl                                          ; LD (HL),A         ; store the clamped jitter value back to $E603
       ab   @c,a                                           ; ADD A,C           ; A = jitter + column
       movb a,@c                                           ; LD C,A            ; 
       movb bc,@disc_row_half_width+1                      ; LD ($E823),BC     ; cache this row's (jitter+column, row) offset pair
       movb @c,@disc_row_half_width                        ;                   ;
       sb   b,b                                            ; LD B,$00          ; 
       movb @circle_centre_x+1,hl                          ; LD HL,($E81F)     ; HL = the cached centre X
       movb @circle_centre_x,@l                            ;                   ;
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; HL = centre X - offset (left bound, raw)
       .ex_de_hl                                           ; EX DE,HL          ; DE = left bound
       li   hl,>7f8a                                       ; LD HL,$7F8A       ; clip window test (near side)...
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _3f64                                          ; JR C,$3F64        ; out of range - skip this bound
       li   hl,>8074                                       ; LD HL,$8074       ; ...and far side
       a    de,hl                                          ; ADD HL,DE         ; 
       joc  _3f06                                          ; JR C,$3F06        ; in range
       movb @bytes+>8c,@e                                  ; LD E,$8C          ; clamp to the boundary
_3f06:                                                     ; >3f06
       movb @e,r1                                          ; LD D,$03          ; R1 = the column, for the column-lookup table
       srl  r1,8                                           ;                   ; 
       movb @scale_3_4_table(r1),a                         ; LD A,(DE)         ; A = table[column]
       ab   @bytes+>57,a                                   ; ADD A,$57         ; 
       movb a,@clip_point1_x+1                             ; LD ($EB92),A      ; cache the left bound's screen column
       movb @circle_centre_x+1,hl                          ; LD HL,($E81F)     ; HL = the cached centre X again
       movb @circle_centre_x,@l                            ;                   ;
       movb @disc_row_half_width+1,bc                      ; LD BC,($E823)     ; BC = the offset pair
       movb @disc_row_half_width,@c                        ;                   ;
       sb   b,b                                            ; LD B,$00          ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL = centre X + offset (right bound, raw)
       dec  hl                                             ; DEC HL            ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = right bound
       li   hl,>8074                                       ; LD HL,$8074       ; clip window test (far side)...
       a    de,hl                                          ; ADD HL,DE         ; 
       jnc  _3f64                                          ; JR NC,$3F64       ; out of range - skip
       li   hl,>7f8a                                       ; LD HL,$7F8A       ; ...and near side
       a    de,hl                                          ; ADD HL,DE         ; 
       jnc  _3f28                                          ; JR NC,$3F28       ; in range
       movb @bytes+>75,@e                                  ; LD E,$75          ; clamp to the boundary
_3f28:                                                     ; >3f28
       movb @e,r1                                          ; LD D,$03          ; R1 = the column, for the column-lookup table
       srl  r1,8                                           ;                   ; 
       movb @scale_3_4_table(r1),a                         ; LD A,(DE)         ; A = table[column]
       ab   @bytes+>57,a                                   ; ADD A,$57         ; 
       movb a,@clip_point2_x+1                             ; LD ($EB96),A      ; cache the right bound's screen column
       movb @disc_row_offset+1,bc                          ; LD BC,($E824)     ; BC = this row's row offset
       movb @disc_row_offset,@c                            ;                   ; 
       movb @circle_centre_y+1,hl                          ; LD HL,($E821)     ; HL = the cached centre Y
       movb @circle_centre_y,@l                            ;                   ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL = centre Y + row offset: the row below the centre...
       bl   @fill_disc_row_span                            ; CALL C,$3F68      ; fill the span in it, if it is in the view (TI: the routine checks that)
_3f49:                                                     ; >3f49
       movb @disc_row_offset+1,bc                          ; LD BC,($E824)     ; BC = this row's row offset again
       movb @disc_row_offset,@c                            ;                   ; 
       movb @circle_centre_y+1,hl                          ; LD HL,($E821)     ; HL = the cached centre Y
       movb @circle_centre_y,@l                            ;                   ; 
       s    bc,hl                                          ; OR A / SBC HL,BC  ; HL = centre Y - row offset: ...and the row above it
       bl   @fill_disc_row_span                            ; CALL C,$3F68      ; fill the span in it too
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, as interrupts are off)
_3f64:                                                     ; >3f64
       .pop hl                                             ; POP HL            ; restore (row delta, column delta)
       .pop de                                             ; POP DE            ; restore (row, column)
       .pop bc                                             ; POP BC            ; restore the outer step counter/loop state
       .endproc                                            ; RET               ; 

********************************************************************************
* Partial-byte right-mask table (8 entries)
* 
* #R$3DF4 loads IY with this address at $3E20 and never reloads it -
* every routine it calls (#R$1F60, #R$2176, #R$3CEC, and the rest of
* this call tree down through #R$3EAD/#R$3EE4/#R$3F68/#R$3F9F) leaves
* IY untouched, so IY stays fixed at $4014 throughout. #R$3F68 and
* #R$3F9F each self-modify the `d` operand of a following `(IY+d)`
* read ($3F95 patches $3F98's displacement, $3FA1 patches $3FA4's,
* within #R$3F68 and #R$3F9F respectively) with a column-within-byte
* index (0-7, from `AND $07` on a screen column), then OR the byte
* read into a pixel-
* plot buffer byte - the same role as the already-documented #R$E700
* pixel-bitmask table (see #R$3CFD), but masking a whole trailing run
* of bits rather than a single bit. Index i clears the top i bits and
* leaves the low (8-i) bits set: $FF,$7F,$3F,$1F,$0F,$07,$03,$01.
       .msxalign >4014
partial_byte_right_mask_table_8:                           ; >4014
       byte >FF,>7F,>3F,>1F,>0F,>07,>03,>01

********************************************************************************
* Read the flight controls and dispatch key presses
* 
* Used by the routine at #R$0106.
* .
* Called by the main loop (#R$0106) every pass. In flight ($E903 set), and
* unless the flight controls are off (#R$EF8E), it reads the flight
* controls: SPACE speeds up (#R$6956) and '/' ('?') slows down (#R$699C),
* both read straight from the keyboard matrix; then the control bits from
* #R$40A6 roll left or right (#R$69E5, #R$69F8), pitch (#R$69FD climb,
* #R$6A10 dive) and fire the laser (#R$2AD0); and 'J' engages the Torus Jump
* Drive (#R$86E6). All the matrix keys are active low.
* .
* Then, if a key has been typed (($E8F5), from the keyboard scan), looks it
* up in the 33-entry table at #R$419B and jumps to its handler via $409B.
* While ($EF8E) is set, only the pause key ($86) is accepted.
* .
* At $409B, with HL pointing at the matching entry in the key table, plays
* a click (#R$7468, event 0) and jumps to the handler address in the entry.
read_controls:                                             ; >401c
       movb @flight_controls_off,a                         ; LD A,($EF8E) / OR A; flight controls off?
       jne  _4077                                          ; JR NZ,$4077       ; yes - skip them
       movb @space_view_showing,a                          ; LD A,($E903) / OR A; 
       jeq  _4077                                          ; JR Z,$4077        ; not in flight - skip them too
       .proc                                               ;                   ; 
* TI: SPACE and '/' are read by ti_read_joysticks, into speed_keys
       movb @speed_keys,r0                                 ; IN A,($A9) / AND $01; SPACE?
       czc  @bit0,r0                                       ;                   ; 
       jeq  _4039                                          ;                   ; 
       bl   @speed_up                                      ; CALL Z,$6956      ; yes - speed up
_4039:                                                     ; >4039
       movb @speed_keys,r0                                 ; IN A,($A9) / AND $10; '/'?
       czc  @bit1,r0                                       ;                   ; 
       jeq  _404a                                          ;                   ; 
       bl   @speed_down                                    ; CALL Z,$699C      ; yes - slow down
_404a:                                                     ; >404a
       bl   @get_control_bits                              ; CALL $40A6        ; A = control bits (#R$40A6)
       czc  @bit2,a                                        ; BIT 2,A           ; 
       jne  _4052                                          ;                   ; 
       bl   @roll_left                                     ; CALL Z,$69E5      ; left: roll left
_4052:                                                     ; >4052
       czc  @bit3,a                                        ; BIT 3,A           ; 
       jne  _4057                                          ;                   ; 
       bl   @roll_right                                    ; CALL Z,$69F8      ; right: roll right
_4057:                                                     ; >4057
       czc  @bit1,a                                        ; BIT 1,A           ; 
       jne  _405c                                          ;                   ; 
       bl   @pitch_climb                                   ; CALL Z,$69FD      ; down: climb
_405c:                                                     ; >405c
       czc  @bit0,a                                        ; BIT 0,A           ; 
       jne  _4061                                          ;                   ; 
       bl   @pitch_dive                                    ; CALL Z,$6A10      ; up: dive
_4061:                                                     ; >4061
       czc  @bit4,a                                        ; BIT 4,A           ; 
       jne  _4066                                          ;                   ; 
       .far_call code_bank_12_select,fire_laser            ; CALL Z,$2AD0      ; fire: fire the laser
_4066:                                                     ; >4066
       movb @speed_keys,r0                                 ; IN A,($A9) / AND $80; 'J'? (TI: read by ti_read_joysticks)
       czc  @bit2,r0                                       ;                   ; 
       jeq  !                                              ;                   ; 
       .far_call code_bank_12_select,engage_torus_jump_drive; CALL Z,$86E6      ; yes - engage the Torus Jump Drive
!
       .pop r11                                            ;                   ; 
_4077:                                                     ; >4077
       movb @pending_debounced_keypress_byte_status,a      ; LD A,($E8F5) / OR A; A = key typed, if any
       jne  _407c                                          ; RET Z             ; none
       rt                                                  ;                   ; 
_407c:                                                     ; >407c
       sb   @pending_debounced_keypress_byte_status,@pending_debounced_keypress_byte_status; XOR A / LD ($E8F5),A; consume it
       movb @flight_controls_off,r0                        ; LD A,($EF8E) / OR A; flight controls off?
       jeq  _408b                                          ; JR Z,$408B        ; no
       cb   a,@bytes+>86                                   ; CP $86            ; 
       jeq  _408b                                          ; RET NZ            ; yes: only the pause key is accepted
       rt                                                  ;                   ; 
_408b:                                                     ; >408b
       li   r1,key_table                                   ; LD HL,$419B       ; R1 -> the key table
_4094:                                                     ; >4094
       mov  *r1,r0                                         ; CP (HL)           ; 
       jeq  _409a                                          ;                   ; (TI: the table ends with 0)
       cb   *r1,a                                          ;                   ; 
       jeq  run_key_handler                                ; JR Z,$409B        ; found
       ai   r1,6                                           ; ADD HL,DE         ; next entry
       jmp  _4094                                          ; DJNZ $4094        ; 
_409a:                                                     ; >409a
       rt                                                  ; RET               ; not one of them
run_key_handler:                                           ; >409b
       .sfx 0                                              ; LD A,$00 / CALL $7468; click
       mov  @2(r1),r0                                      ; INC HL / LD A,(HL) ...; R0 = the handler's ROM bank
       mov  @4(r1),r1                                      ;                   ; R1 = the handler
       b    @far_call_r0_r1                                ; JP (HL)           ; run the handler (in its ROM bank), which returns to the caller

********************************************************************************
* Get the control bits, applying the reverse-controls options
* 
* Used by the routine at #R$401C.
* .
* Returns the control bits from ($E8F4) (see #R$7312): bit 0 up, 1 down,
* 2 left, 3 right, 4 fire, each 0 while pressed. If bit 3 of ($E914) is
* set (pause menu option 'B'), up/down and left/right are swapped; if
* bit 4 is set (option 'Y'), up/down are swapped again - so 'Y' reverses
* pitch, and 'B' reverses both pitch and roll (both together reverse just
* roll).
* 
* O:A The control bits
* TI: swaps the bits directly.
get_control_bits:                                          ; >40a6
       movb @control_bits,a                                ; LD A,($E8F4)      ; A = control bits
       movb @options,r0                                    ; LD HL,$E914       ; 
       czc  @bit3,r0                                       ; BIT 3,(HL)        ; option 'B' on?
       jeq  _40ca                                          ; JR Z,$40CA        ; no
       movb a,r1                                           ;                   ; swap up/down and left/right
       andi r1,>0500                                       ;                   ; 
       sla  r1,1                                           ;                   ; 
       movb a,r2                                           ;                   ; 
       andi r2,>0a00                                       ;                   ; 
       srl  r2,1                                           ;                   ; 
       andi a,>f000                                        ;                   ; 
       soc  r1,a                                           ;                   ; 
       soc  r2,a                                           ;                   ; 
_40ca:                                                     ; >40ca
       czc  @bit4,r0                                       ; BIT 4,(HL)        ; option 'Y' on?
       jeq  _40dc                                          ; JR Z,$40DC        ; no
       movb a,r1                                           ;                   ; swap up and down
       andi r1,>0100                                       ;                   ; 
       sla  r1,1                                           ;                   ; 
       movb a,r2                                           ;                   ; 
       andi r2,>0200                                       ;                   ; 
       srl  r2,1                                           ;                   ; 
       andi a,>fc00                                        ;                   ; 
       soc  r1,a                                           ;                   ; 
       soc  r2,a                                           ;                   ; 
_40dc:                                                     ; >40dc
       rt                                                  ; RET               ; 

********************************************************************************
* Key table
* 
* 33 entries of 3 bytes - a key code (as produced by the key-code table at
* #R$0A57) and the address of its handler - searched by #R$401C, which
* runs the matching handler via #R$409B. Keys 1-4 (and F1-F4) switch
* view in flight but launch, buy, sell and equip when docked (see their
* handlers). Most keys match the manual's key lists; F5 and 'F' aren't
* in it.
key_table:                                                 ; >419b
* TI: (key in the high byte, the handler's ROM bank, the handler) words,
* only for the keys whose handlers are converted so far, ending with 0
       data >3000,code_bank_7_select,show_cargo_manifest_screen   ; '0': inventory (#R$5C8E)
       data >3100,code_bank_10_select,key_handler_1               ; '1': launch, or the front view in flight (#R$4173)
       data >3200,code_bank_12_select,key_handler_2               ; '2': buy cargo, or the rear view in flight (#R$417D)
       data >3300,code_bank_12_select,key_handler_3               ; '3': sell cargo, or the left view in flight (#R$4187)
       data >3400,code_bank_12_select,key_handler_4               ; '4': equip ship, or the right view in flight (#R$4191)
       data >8000,code_bank_12_select,switch_to_front_view        ; F1 (FCTN-1): front view (#R$64A1, in RAM)
       data >8100,code_bank_12_select,switch_to_rear_view         ; F2 (FCTN-2): rear view (#R$64B5)
       data >8200,code_bank_12_select,switch_to_left_view         ; F3 (FCTN-3): left view (#R$64C9)
       data >8300,code_bank_12_select,switch_to_right_view        ; F4 (FCTN-4): right view (#R$64DD)
       data >3500,code_bank_9_select,galactic_chart               ; '5': galactic chart (#R$4D0B)
       data >3600,code_bank_9_select,local_chart                  ; '6': local chart (#R$4F64)
       data >3700,code_bank_8_select,key_data_on_system           ; '7': data on system (#R$6164)
       data >4600,code_bank_9_select,key_find_system              ; 'F': find a system by name (#R$55A3)
       data >4400,code_bank_9_select,key_distance                 ; 'D': distance to the system nearest the chart cursor (#R$52CE)
       data >3800,code_bank_7_select,key_handler_8                ; '8': market prices (#R$5B99)
       data >3900,code_bank_7_select,status_page                  ; '9': commander status (#R$6276)
       data >5b00,code_bank_7_select,commander_menu               ; '[' (FCTN-R): load/save commander menu (#R$A30A)
       data >5400,code_bank_12_select,key_handler_t               ; 'T': target a missile (#R$2D58)
       data >5500,code_bank_11_select,cancel_missile_lock         ; 'U': unarm the missile (#R$2D70)
       data >4d00,code_bank_12_select,key_fire_missile            ; 'M': fire the missile (#R$2D7E)
       data >4500,code_bank_12_select,key_handler_e               ; 'E': ECM (#R$3223)
       data >0900,code_bank_12_select,key_handler_tab             ; TAB (FCTN-7): energy bomb (#R$329E)
       data >1b00,code_bank_12_select,key_escape_capsule          ; Esc (FCTN-9): escape capsule (#R$19FC)
       data >4800,code_bank_13_select,key_handler_h               ; 'H': hyperspace (#R$88AC)
       data >4700,code_bank_13_select,key_handler_g               ; 'G': galactic hyperspace (#R$8926)
       data >8400,code_bank_13_select,key_f5_info                 ; F5 (FCTN-5): game time, score and credits (#R$1A8A)
       data >4300,code_bank_12_select,key_handler_c               ; 'C': docking computer (#R$1692)
       data >4900,code_bank_13_select,key_handler_i               ; 'I': identify the target (#R$1B0D)
       data >5900,code_bank_13_select,key_handler_y               ; 'Y': cloaking device on/off (#R$1B13)
       data >4c00,code_bank_13_select,key_handler_l               ; 'L': ECM jammer on/off (#R$1B25)
       data >8600,code_bank_12_select,freeze_game                 ; STOP (FCTN-6): freeze the game (#R$40DE)
       data >8700,code_bank_9_select,update_chart_cursor          ; HOME (FCTN-8): bring back the cursor, as 'B' (#R$527F)
       data >4200,code_bank_9_select,update_chart_cursor          ; 'B': bring back the cursor (#R$527F)
       data 0                                                     ; end of the table

********************************************************************************
* The message "     Game Frozen     "
msg_game_frozen:                                           ; >420d
       text '     Game Frozen     ',>a0                           ; 

********************************************************************************
* Draw the object
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C and #R$1E5A.
* .
* Called for each object by the main loop (#R$13FD). Clears the flags for
* the laser sights (#R$EF99), the object being on screen ($EF98), the
* orientation cache (#R$E6F0) and not drawing it (#R$E6F3), then draws it
* ($4255) - except the Cougar (ship type $1E), which is cloaked: unless
* it's exploding, it's only drawn while bit 5 of the frame counter
* (#R$F746) is set, so it flickers.
* .
* At $4255, projects the object's position (#R$44CE) into $E6D8/$E6DC,
* giving up if it's behind the player, and works out its scale (#R$46CA).
* An explosion (handler type 1) is drawn by #R$4AEC, with its size
* (#R$F7F0) in #R$F800. Anything else must be on screen (#R$4A99); if it
* can't be drawn in full (bit 3 of #R$F7CD) or is too far away (#R$EB9E
* under 4), #R$4A86 draws it small. Otherwise it's drawn as a wireframe
* with hidden faces removed: the flags for the vertices already projected
* (#R$E784, #R$F7FF of them) and the edges already drawn (#R$E7B6, #R$F7FE of
* them) are cleared, and for each face in the blueprint's faces (#R$F7F9,
* #R$F7FD of them): if the faces have normals (#R$F804), the face's scale
* byte and 6-byte normal are read and the face skipped if it faces away
* (#R$4873, $4336); otherwise its edges are drawn (#R$491A).
* .
* At $4336, skips the face's list of edges (a count, then the edges). The
* entry at $433B moves on to the next face.
draw_object:                                               ; >422e
       .proc
       .save_bank                                          ;                   ; (TI: draw_object_body selects the blueprint's bank;
       bl   @draw_object_body                              ;                   ; select the caller's bank again afterwards)
       .restore_bank                                       ;                   ; 
       .endproc                                            ;                   ; 
draw_object_body:
       .proc
       bl   @select_blueprint_bank                         ;                   ; its blueprint's ROM bank (another bank may have been selected since #R$16E3)
       sb   a,a                                            ; XOR A             ; A = 0
       movb a,@in_sights                                   ; LD ($EF99),A      ; not in the sights
       movb a,@ef98_per_object_flag                        ; LD ($EF98),A      ; not on screen
       movb a,@vector_cache_valid_flag                     ; LD ($E6F0),A      ; orientation not cached
       movb a,@nothing_changed_flag                        ; LD ($E6F3),A      ; 
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>1e                                   ; CP $1E            ; is it mode 30?
       jne  draw_ship                                      ; JR NZ,$4255       ; not the Cougar
       movb @handler_type,a                                ; LD A,($F7EE)      ; mode 30: A = the object's type
       cb   a,one                                          ; CP $01            ; is it type 1?
       jeq  draw_ship                                      ; JR Z,$4255        ; exploding
       movb @main_loop_tick_counter,a                      ; LD A,($F746)      ; else A = the tick/frame counter's low byte
       andi a,>2000                                        ; AND $20           ; test bit 5
       jne  draw_ship                                      ; JR NZ,$4255       ; its turn to be seen
       sb   one,a                                          ; DEC A             ; clear: A = $FF (from 0)
       movb a,@nothing_changed_flag                        ; LD ($E6F3),A      ; don't draw it this frame
       .endproc                                            ; RET               ; and return without drawing it
draw_ship:                                                 ; >4255
       mov  @object_position_x,de                          ; LD DE,($F7CE)     ; DE = the object's world position, first half
       mov  @object_position_z,hl                          ; LD HL,($F7D2)     ; HL = ...second half
       bl   @convert_to_view                               ; CALL $44CE        ; project the object's position
       mov  de,@view_x                                     ; LD ($E6D8),DE     ; store the projected first half
       mov  hl,@view_z                                     ; LD ($E6DC),HL     ; store the projected second half
       movb h,a                                            ; LD A,H / OR A     ; A = the projected second half's high byte
       jgt  !                                              ; RET M             ; behind the player
       jeq  !                                              ;                   ; 
       .endproc                                            ;                   
!
       socb @l,a                                           ; OR L              ; 
       jne  !                                              ; RET Z             ; 
       .endproc                                            ;                   
!
       a    hl,hl                                          ; ADD HL,HL         ; HL = the projected second half, doubled
       mov  hl,@view_z2                                    ; LD ($E6DA),HL     ; store it - a depth scale used below
* @label=*
_426f:                                                     ; >426f
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = handler type
       cb   a,one                                          ; CP $01            ; is it type 1?
       jne  _427c                                          ; JR NZ,$427C       ; not an explosion
       movb @per_type_parameter_block,a                    ; LD A,($F7F0)      ; 
       movb a,@bp_targetable_area                          ; LD ($F800),A      ; the explosion's size
_427c:                                                     ; >427c
       bl   @ship_screen_size                              ; CALL $46CA        ; work out the scale
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = the object's type again
       cb   a,one                                          ; CP $01            ; is it type 1?
       jeq  _42bc                                          ; JR Z,$42BC        ; an explosion
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; else HL = the cached value at $EB9E (see #R$4A99)
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; 
       jne  !                                              ; RET Z             ; zero - bail out
       .endproc                                            ;                   
!
       mov  @view_x,de                                     ; LD DE,($E6D8)     ; DE = the projected first half
       mov  @object_position_y,bc                          ; LD BC,($F7D0)     ; BC = the vector's shared middle component
       mov  @view_z2,hl                                    ; LD HL,($E6DA)     ; HL = the doubled depth value
       bl   @project_point                                 ; CALL $47C4        ; scale (DE,BC) against it via #R$47C4
       movb b,ixh                                          ; LD IXH,B          ; IX = the scaled first pair
       movb @c,@ixl                                        ; LD IXL,C          ; 
       movb d,iyh                                          ; LD IYH,D          ; IY = the scaled second pair
       movb @e,@iyl                                        ; LD IYL,E          ; 
       bl   @on_screen                                     ; CALL $4A99        ; is it on screen?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no
       jmp  draw_object_exit                               ;                   ; 
!
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = the object status byte
       andi a,>0800                                        ; AND $08           ; 
       jeq  !                                              ; JP NZ,$4A86       ; can't be drawn in full - draw it small
       b    @draw_small                                    ;                   
!
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; clear: HL = the cached value at $EB9E
       li   de,>fffc                                       ; LD DE,$FFFC       ; DE = -4
       a    de,hl                                          ; ADD HL,DE         ; HL -= 4 (carry reflects whether HL was >= 4)
       joc  !                                              ; JP NC,$4A86       ; too far away - draw it small
       b    @draw_small                                    ;                   
!
       movb @ship_type,a                                   ; LD A,($F7E7)      ; else A = the current ship type
_42bc:                                                     ; >42bc
       bl   @work_out_roof                                 ; CALL $4599        ; work out the third orientation vector
       bl   @cache_orientation                             ; CALL $433F        ; refresh the cached, quantized object vectors
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = the object's type
       cb   a,one                                          ; CP $01            ; is it type 1?
       jne  !                                              ; JP Z,$4AEC        ; an explosion - #R$4AEC
       b    @draw_explosion                                ;                   
!
       movb @b255,a                                        ; LD A,$FF          ; else: A = $FF
       movb a,@ef98_per_object_flag                        ; LD ($EF98),A      ; on screen
       li   hl,vertex_flags                                ; LD HL,$E784       ; HL -> the $E784 buffer
       li   de,vertex_flags+>0001                          ; LD DE,$E785       ; DE -> one byte past it
       movb @bp_vertex_count+1,bc                          ; LD BC,($F7FF)     ; C = number of vertices
       movb @bp_vertex_count,@c                            ;                   ;
       sb   b,b                                            ; LD B,$00          ; keep only the low byte (C)
       movb b,*hl                                          ; LD (HL),B         ; seed the first byte with 0
       sb   one,@c                                         ; DEC C             ; one fewer byte to fill
       .ldir                                               ; LDIR              ; clear the vertex flags
       li   hl,edge_flags                                  ; LD HL,$E7B6       ; HL -> the $E7B6 buffer
       li   de,edge_flags+>0001                            ; LD DE,$E7B7       ; DE -> one byte past it
       movb @bp_edge_count+1,bc                            ; LD BC,($F7FE)     ; C = number of edges
       movb @bp_edge_count,@c                              ;                   ;
       sb   b,b                                            ; LD B,$00          ; keep only the low byte (C)
       movb b,*hl                                          ; LD (HL),B         ; seed the first byte with 0
       sb   one,@c                                         ; DEC C             ; one fewer byte to fill
       .ldir                                               ; LDIR              ; clear the edge flags
;      movb @bytes+>e6,a                                   ; LD A,$E6          ; A = $E6
;      movb a,@vertex_cache_slot                           ; LD ($E6C9),A      ; the vertex cache is in page $E6 (the TI stores the full address in #R$49FD)
       li   ix,edge_flags                                  ; LD IX,$E7B6       ; IX -> the $E7B6 buffer
       li   iy,vertex_flags                                ; LD IY,$E784       ; IY -> the $E784 buffer
       movb @bp_faces,hl                                   ; LD HL,($F7F9)     ; HL -> the faces
       movb @bp_faces+1,@l                                 ;                   ;
       movb @bp_face_count,a                               ; LD A,($F7FD)      ; B = number of faces
       movb a,b                                            ; LD B,A            ; B = the loop count
_4303:                                                     ; >4303
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, interrupts are off)
       .push bc                                            ; PUSH BC           ; save the loop counter
       movb @bp_face_normals,a                             ; LD A,($F804) / OR A; A = faces have normals?
       jeq  _4325                                          ; JR Z,$4325        ; no
       movb *hl,a                                          ; LD A,(HL)         ; else: A = the next data byte
       inc  hl                                             ; INC HL            ; 
       movb a,@face_scale                                  ; LD ($E7E8),A      ; the normal's scale
       movb a,@e                                           ; LD E,A            ; E = that byte, used as a table index
       movb a,r1                                           ; LD D,$02          ; 
       srl  r1,8                                           ;                   ; 
       movb @bit_length_table(r1),a                        ; LD A,(DE)         ; A = the scale's bit length (#R$0200)
       movb a,@face_scale_bits                             ; LD ($E7E9),A      ; 
       movb *hl+,@rotated_vector+1                         ; LD DE,$E7EA       ; copy the 6-byte vector, swapping each little-endian word
       movb *hl+,@rotated_vector                           ; LDI               ; to big-endian for word access
       movb *hl+,@rotated_vector_y+1                       ; LDI               ; 
       movb *hl+,@rotated_vector_y                         ; LDI               ; 
       movb *hl+,@rotated_vector_z+1                       ; LDI               ; 
       movb *hl+,@rotated_vector_z                         ; LDI x 2           ; (DE and BC are not used afterwards)
_4325:                                                     ; >4325
       movb @bp_face_normals,a                             ; LD A,($F804) / OR A; A = the per-entry mode/flag byte again
       jeq  _4331                                          ; JR Z,$4331        ; clear - skip #R$4873's combine step
       bl   @face_visible                                  ; CALL $4873        ; does the face face the player?
       movb a,a                                            ;                   ; (the RET changed the status)
       jgt  draw_ship_skip_face                            ; JP P,$4336        ; no - skip it
       jeq  draw_ship_skip_face                            ;                   ; 
!
_4331:                                                     ; >4331
       bl   @draw_face_edges                               ; CALL $491A        ; yes - draw its edges
       jmp  _433b                                          ; JR $433B          ; join the shared loop-advance tail
draw_ship_skip_face:                                       ; >4336
       movb *hl,@c                                         ; LD C,(HL)         ; C = a length-prefix byte
       inc  hl                                             ; INC HL            ; 
       sb   b,b                                            ; LD B,$00          ; B = 0 (widen C to BC)
       a    bc,hl                                          ; ADD HL,BC         ; HL += C, skipping that many bytes
_433b:                                                     ; >433b
       .pop bc                                             ; POP BC            ; restore the loop counter
       sb   one,b                                          ; DJNZ $4303        ; one entry done - loop for the next
       jne  _4303                                          ;                   
draw_object_exit:
       .endproc                                            ; RET               ; 

********************************************************************************
* Cache the object's orientation as logarithms
* 
* Used by the routines at #R$422E and #R$43C2.
* .
* Converts the object's orientation vectors - side (#R$F7D4), roof
* (#R$F7E0) and nose (#R$F7DA) - to sign-tagged logarithms (#R$1FCF), for
* #R$4464's multiplications: the side and roof vectors at $E6CC and
* $E6D2, and the nose vector (unless bit 4 of #R$F7CD is set) at
* #R$EB68. Marks the cache valid (#R$E6F0).
cache_orientation:                                         ; >433f
       .proc
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; HL = a position/axis word
       bl   @log_sign_tagged                               ; CALL $1FCF        ; side vector's x
       mov  hl,@side_vector_logs                           ; LD ($E6CC),HL     ; cache the result
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; side y
       bl   @log_sign_tagged                               ; CALL $1FCF        ; quantize it
       mov  hl,@side_vector_log_y                          ; LD ($E6CE),HL     ; cache the result
       mov  @side_vector_z,hl                              ; LD HL,($F7D8)     ; side z
       bl   @log_sign_tagged                               ; CALL $1FCF        ; quantize it
       mov  hl,@side_vector_log_z                          ; LD ($E6D0),HL     ; cache the result
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; roof x
       bl   @log_sign_tagged                               ; CALL $1FCF        ; quantize it
       mov  hl,@roof_vector_logs                           ; LD ($E6D2),HL     ; cache the result
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; roof y
       bl   @log_sign_tagged                               ; CALL $1FCF        ; quantize it
       mov  hl,@roof_vector_log_y                          ; LD ($E6D4),HL     ; cache the result
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; roof z
       bl   @log_sign_tagged                               ; CALL $1FCF        ; quantize it
       mov  hl,@roof_vector_log_z                          ; LD ($E6D6),HL     ; cache the result
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = the object status byte
       andi a,>1000                                        ; AND $10           ; test bit 4
       jne  _4397                                          ; JR NZ,$4397       ; skip the nose vector
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; nose x
       bl   @log_sign_tagged                               ; CALL $1FCF        ; quantize it
       mov  hl,@nose_vector_logs                           ; LD ($EB68),HL     ; cache the result
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; nose y
       bl   @log_sign_tagged                               ; CALL $1FCF        ; quantize it
       mov  hl,@nose_vector_log_y                          ; LD ($EB6A),HL     ; cache the result
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; nose z
       bl   @log_sign_tagged                               ; CALL $1FCF        ; quantize it
       mov  hl,@nose_vector_log_z                          ; LD ($EB6C),HL     ; cache the result
_4397:                                                     ; >4397
       movb @b255,a                                        ; LD A,$FF          ; A = $FF
       movb a,@vector_cache_valid_flag                     ; LD ($E6F0),A      ; the cache is valid
       .endproc                                            ; RET               ; 

********************************************************************************
* Rotate a vertex into the view
* 
* Used by the routines at #R$4873, #R$49FD and #R$4A5C.
* .
* Multiplies the vertex (or normal) at #R$E7EA - x, y and z as sign-tagged
* logarithms, as the blueprints store them - by the object's orientation
* (cached as logarithms by #R$433F), multiplying via logs (#R$2160):
* x' = x * side.x + y * roof.x + z * nose.x, and likewise for y' and z'.
* Then, at $44CE, turns (DE, BC, HL) = (x', y', z') into the coordinates
* of the current view (#R$44E5, #R$44E6, #R$44F3 or #R$44FB, patched in
* by the view selectors at #R$64A1).
* 
* O:DE x
* O:BC y
* O:HL z
rotate_vertex:                                             ; >4464
       .proc
       mov  @rotated_vector,hl                             ; LD HL,($E7EA)     ; x * side.x
       mov  @side_vector_logs,bc                           ; LD BC,($E6CC)     ; BC = row 1's first coefficient
       bl   @multiply_logs                                 ; CALL $2160        ; combine it via #R$2160
       .ex_de_hl                                           ; EX DE,HL          ; DE = that combine's result
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; y * roof.x
       mov  @roof_vector_logs,bc                           ; LD BC,($E6D2)     ; BC = row 1's second coefficient
       bl   @multiply_logs                                 ; CALL $2160        ; combine it
       a    de,hl                                          ; ADD HL,DE         ; HL = the running sum for row 1
       .ex_de_hl                                           ; EX DE,HL          ; DE = that sum
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; z * nose.x
       mov  @nose_vector_logs,bc                           ; LD BC,($EB68)     ; BC = row 1's third coefficient
       bl   @multiply_logs                                 ; CALL $2160        ; combine it
       a    de,hl                                          ; ADD HL,DE         ; x'
       .push hl                                            ; PUSH HL           ; save it
       mov  @rotated_vector,hl                             ; LD HL,($E7EA)     ; x * side.y
       mov  @side_vector_log_y,bc                          ; LD BC,($E6CE)     ; 
       bl   @multiply_logs                                 ; CALL $2160        ; combine
       .ex_de_hl                                           ; EX DE,HL          ; DE = that result
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; y * roof.y
       mov  @roof_vector_log_y,bc                          ; LD BC,($E6D4)     ; BC = row 2's second coefficient
       bl   @multiply_logs                                 ; CALL $2160        ; combine
       a    de,hl                                          ; ADD HL,DE         ; running sum for row 2
       .ex_de_hl                                           ; EX DE,HL          ; DE = that sum
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; z * nose.y
       mov  @nose_vector_log_y,bc                          ; LD BC,($EB6A)     ; BC = row 2's third coefficient
       bl   @multiply_logs                                 ; CALL $2160        ; combine
       a    de,hl                                          ; ADD HL,DE         ; y'
       .push hl                                            ; PUSH HL           ; save it
       mov  @rotated_vector,hl                             ; LD HL,($E7EA)     ; x * side.z
       mov  @side_vector_log_z,bc                          ; LD BC,($E6D0)     ; BC = row 3's first coefficient
       bl   @multiply_logs                                 ; CALL $2160        ; combine
       .ex_de_hl                                           ; EX DE,HL          ; DE = that result
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; y * roof.z
       mov  @roof_vector_log_z,bc                          ; LD BC,($E6D6)     ; BC = row 3's second coefficient
       bl   @multiply_logs                                 ; CALL $2160        ; combine
       a    de,hl                                          ; ADD HL,DE         ; running sum for row 3
       .ex_de_hl                                           ; EX DE,HL          ; DE = that sum
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; z * nose.z
       mov  @nose_vector_log_z,bc                          ; LD BC,($EB6C)     ; BC = row 3's third coefficient
       bl   @multiply_logs                                 ; CALL $2160        ; combine
       a    de,hl                                          ; ADD HL,DE         ; z'
       .pop bc                                             ; POP BC            ; BC = the second output component
       .pop de                                             ; POP DE            ; DE = the first output component
       bl   @convert_to_view                               ;                   ; convert to the current view
       .endproc                                            ; RET               ; 
* This entry point is used by the routines at #R$422E and #R$43C2.
convert_to_view:                                           ; >44ce
       b    @view_front                                    ; CALL $44E5        ; convert to the current view (operand patched by #R$64A1)

********************************************************************************
* Add the object's position
* 
* Used by the routines at #R$43C2, #R$4873, #R$49FD, #R$4A5C and #R$4AEC.
* .
* Adds the object's position in the view - x from #R$E6D8, y from #R$F7D0
* and z from #R$E6DA (twice the object's z) - to a rotated vertex.
* 
* I:DE,BC,HL The vertex's x, y and z
* O:DE,BC,HL x, y and z relative to the player
add_object_position:                                       ; >44d2
       .proc
       .push hl                                            ; PUSH HL           ; save the caller's HL (the "value on the stack")
       mov  @view_x,hl                                     ; LD HL,($E6D8)     ; HL = the projected first half (see #R$4255)
       a    de,hl                                          ; ADD HL,DE         ; HL += DE
       .ex_de_hl                                           ; EX DE,HL          ; DE = the combined result
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; HL = the vector's shared middle component
       a    bc,hl                                          ; ADD HL,BC         ; HL += BC
       .ex_sp_hl                                           ; EX (SP),HL        ; swap HL with the saved value on the stack
       mov  @view_z2,bc                                    ; LD BC,($E6DA)     ; BC = the depth scale (see #R$4255/#R$43C2)
       jnc  !                                              ;                   ; (ADC: add the carry first)
       inc  hl                                             ;                   ; 
!
       a    bc,hl                                          ; ADC HL,BC         ; HL += BC, with carry
       .pop bc                                             ; POP BC            ; BC = the earlier ($F7D0)+original combine
       .endproc                                            ; RET               ; 

********************************************************************************
* Convert to the view: front
* 
* Used by the routine at #R$4464.
* .
* The front view's version of the call at #R$44CE: x and z are
* unchanged.
view_front:                                                ; >44e5
       rt                                                  ; RET               ; 

********************************************************************************
* Convert to the view: rear
* 
* The rear view's version of the call at #R$44CE (patched in by #R$64B5):
* x and z are negated.
* 
* I:DE x
* I:HL z
view_rear:                                                 ; >44e6
       neg  de                                             ; XOR A / SUB E / LD E,A / SBC A,A / SUB D / LD D,A; DE = -x
       neg  hl                                             ; XOR A / SUB L / LD L,A / SBC A,A / SUB H / LD H,A; HL = -z
       rt                                                  ; RET               ; 

********************************************************************************
* Convert to the view: left
* 
* The left view's version of the call at #R$44CE (patched in by #R$64C9):
* the view's x is z, and its z is -x.
* 
* I:DE x
* I:HL z
view_left:                                                 ; >44f3
       mov  de,r0                                          ; EX DE,HL          ; 
       mov  hl,de                                          ;                   ; DE = z
       neg  r0                                             ; XOR A / SUB L / LD L,A / SBC A,A / SUB H / LD H,A; 
       mov  r0,hl                                          ;                   ; HL = -x
       rt                                                  ; RET               ; 

********************************************************************************
* Convert to the view: right
* 
* The right view's version of the call at #R$44CE (patched in by #R$64DD):
* the view's x is -z, and its z is x.
* 
* I:DE x
* I:HL z
view_right:                                                ; >44fb
       mov  hl,r0                                          ; EX DE,HL          ; 
       mov  de,hl                                          ;                   ; HL = x
       neg  r0                                             ; XOR A / SUB E / LD E,A / SBC A,A / SUB D / LD D,A; 
       mov  r0,de                                          ;                   ; DE = -z
       rt                                                  ; RET               ; 

********************************************************************************
* Straighten out the orientation
* 
* Used by the routines at #R$13FD and #R$1C5C.
* .
* Called for each object by the main loop (#R$13FD) and on the title
* screen (#R$1D3D). The orientation vectors drift from being unit length
* and at right angles as they're rotated, so after 200 rotations (counted
* in #R$F7E8 by the rotation routines at #R$221B and #R$22C0) this
* normalises the side and nose vectors (#R$4642), works out the roof
* vector as nose x side (#R$4599), and then the nose vector as side x
* roof.
straighten_orientation:                                    ; >4503
       .proc
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = the counter
       cb   a,@bytes+>c8                                   ; CP $C8            ; 200 rotations yet?
       jhe  !                                              ; RET C             ; no
       .endproc                                            ;                   
!
       sb   *hl,*hl                                        ; LD (HL),$00       ; start counting again
       li   hl,side_vector                                 ; LD HL,$F7D4       ; HL -> vector 1
       bl   @normalise_vector                              ; CALL $4642        ; normalise the side vector
       li   hl,nose_vector                                 ; LD HL,$F7DA       ; HL -> vector 2
       bl   @normalise_vector                              ; CALL $4642        ; normalise the nose vector
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; HL -> the "third vector already derived" guard byte
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; 
       bl   @work_out_roof                                 ; CALL $4599        ; roof = nose x side
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; side.y * roof.z
       mov  @roof_vector_z,de                              ; LD DE,($F7E4)     ; DE = vector3.z
       bl   @multiply_components                           ; CALL $200A        ; HL = vector1.y * vector3.z
       .push hl                                            ; PUSH HL           ; save it
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; roof.y * side.z
       mov  @side_vector_z,de                              ; LD DE,($F7D8)     ; DE = vector1.z
       bl   @multiply_components                           ; CALL $200A        ; HL = vector3.y * vector1.z
       .ex_de_hl                                           ; EX DE,HL          ; DE = that product
       .pop hl                                             ; POP HL            ; HL = the first product (vector1.y * vector3.z)
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; nose.x = the difference
       jgt  straighten_nose_x                              ; JP P,$4545        ; non-negative - keep it
       jeq  straighten_nose_x                              ;                   ; 
!
       neg  hl                                             ; SUB L             ; ...H:L = abs(HL)
       socb @bit7,h                                        ; SET 7,H           ; ...and tag it negative, sign-magnitude style
straighten_nose_x:                                         ; >4545
       mov  hl,@nose_vector                                ; LD ($F7DA),HL     ; 
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; roof.x * side.z
       mov  @side_vector_z,de                              ; LD DE,($F7D8)     ; DE = vector1.z
       bl   @multiply_components                           ; CALL $200A        ; HL = vector3.x * vector1.z
       .push hl                                            ; PUSH HL           ; save it
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; side.x * roof.z
       mov  @roof_vector_z,de                              ; LD DE,($F7E4)     ; DE = vector3.z
       bl   @multiply_components                           ; CALL $200A        ; HL = vector1.x * vector3.z
       .ex_de_hl                                           ; EX DE,HL          ; DE = that product
       .pop hl                                             ; POP HL            ; HL = the first product (vector3.x * vector1.z)
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; nose.y
       jgt  straighten_nose_y                              ; JP P,$456D        ; non-negative - keep it
       jeq  straighten_nose_y                              ;                   ; 
!
       neg  hl                                             ; SUB L             ; ...H:L = abs(HL)
       socb @bit7,h                                        ; SET 7,H           ; ...and tag it negative, sign-magnitude style
straighten_nose_y:                                         ; >456d
       mov  hl,@nose_vector_y                              ; LD ($F7DC),HL     ; 
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; side.x * roof.y
       mov  @roof_vector_y,de                              ; LD DE,($F7E2)     ; DE = vector3.y
       bl   @multiply_components                           ; CALL $200A        ; HL = vector1.x * vector3.y
       .push hl                                            ; PUSH HL           ; save it
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; roof.x * side.y
       mov  @side_vector_y,de                              ; LD DE,($F7D6)     ; DE = vector1.y
       bl   @multiply_components                           ; CALL $200A        ; HL = vector3.x * vector1.y
       .ex_de_hl                                           ; EX DE,HL          ; DE = that product
       .pop hl                                             ; POP HL            ; HL = the first product (vector1.x * vector3.y)
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; nose.z
       jgt  straighten_nose_z                              ; JP P,$4595        ; non-negative - keep it
       jeq  straighten_nose_z                              ;                   ; 
!
       neg  hl                                             ; SUB L             ; ...H:L = abs(HL)
       socb @bit7,h                                        ; SET 7,H           ; ...and tag it negative, sign-magnitude style
straighten_nose_z:                                         ; >4595
       mov  hl,@nose_vector_z                              ; LD ($F7DE),HL     ; store as the new vector2.z
       .endproc                                            ; RET               ; 

********************************************************************************
* Work out the roof vector
* 
* Used by the routines at #R$2365, #R$23D9, #R$2C3C, #R$2EB2, #R$422E and
* #R$4503.
* .
* Sets the roof vector (#R$F7E0) to nose x side (#R$F7DA, #R$F7D4),
* multiplying with #R$200A - unless it's already been worked out since
* the orientation last changed (bit 7 of #R$F7CD, which this sets).
work_out_roof:                                             ; >4599
       .proc
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       movb *hl,r0                                         ; BIT 7,(HL)        ; roof vector already worked out?
       andi r0,>8000                                       ;                   
       jeq  !                                              ; RET NZ            ; already worked out
       .endproc                                            ;                   
!
       socb @bit7,*hl                                      ; SET 7,(HL)        ; it soon will be
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; nose.y * side.z
       mov  @side_vector_z,de                              ; LD DE,($F7D8)     ; 
       bl   @multiply_components                           ; CALL $200A        ; (#R$200A)
       .push hl                                            ; PUSH HL           ; save it
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; side.y * nose.z
       mov  @nose_vector_z,de                              ; LD DE,($F7DE)     ; 
       bl   @multiply_components                           ; CALL $200A        ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = the second product
       .pop hl                                             ; POP HL            ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; roof.x = the difference
       jgt  work_out_roof_x                                ; JP P,$45C6        ; positive - store it
       jeq  work_out_roof_x                                ;                   ; 
!
       neg  hl                                             ; SUB L             ; negate HL
       socb @bit7,h                                        ; SET 7,H           ; (sign-magnitude)
work_out_roof_x:                                           ; >45c6
       mov  hl,@roof_vector                                ; LD ($F7E0),HL     ; store roof.x
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; side.x * nose.z
       mov  @nose_vector_z,de                              ; LD DE,($F7DE)     ; 
       bl   @multiply_components                           ; CALL $200A        ; 
       .push hl                                            ; PUSH HL           ; save it
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; nose.x * side.z
       mov  @side_vector_z,de                              ; LD DE,($F7D8)     ; 
       bl   @multiply_components                           ; CALL $200A        ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = the second product
       .pop hl                                             ; POP HL            ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; roof.y
       jgt  work_out_roof_y                                ; JP P,$45EE        ; positive - store it
       jeq  work_out_roof_y                                ;                   ; 
!
       neg  hl                                             ; SUB L             ; negate HL
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
work_out_roof_y:                                           ; >45ee
       mov  hl,@roof_vector_y                              ; LD ($F7E2),HL     ; store roof.y
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; nose.x * side.y
       mov  @side_vector_y,de                              ; LD DE,($F7D6)     ; 
       bl   @multiply_components                           ; CALL $200A        ; 
       .push hl                                            ; PUSH HL           ; save it
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; side.x * nose.y
       mov  @nose_vector_y,de                              ; LD DE,($F7DC)     ; 
       bl   @multiply_components                           ; CALL $200A        ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = the second product
       .pop hl                                             ; POP HL            ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; roof.z
       jgt  work_out_roof_z                                ; JP P,$4616        ; positive - store it
       jeq  work_out_roof_z                                ;                   ; 
!
       neg  hl                                             ; SUB L             ; negate HL
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
work_out_roof_z:                                           ; >4616
       mov  hl,@roof_vector_z                              ; LD ($F7E4),HL     ; store roof.z
       .endproc                                            ; RET               ; 

********************************************************************************
* Square a vector component
* 
* Used by the routine at #R$4642.
* .
* Part of #R$4642. Multiplies the component's magnitude by itself.
* 
* I:DE Component (sign-magnitude)
* O:HL,IX The square (HL the high word)
square_component:                                          ; >461a
       mov  de,r0                                          ; RES 7,D           ; 
       andi r0,>7fff                                       ;                   ; R0 = |component|
       mov  r0,r1                                          ;                   ; 
       mpy  r0,r1                                          ; ADD IX,DE         ; R1:R2 = the square (the shift-and-add loop on the Z80)
       mov  r1,hl                                          ;                   ; 
       mov  r2,ix                                          ;                   ; HL:IX = the square
       rt                                                  ; RET               ; 

********************************************************************************
* Normalise a vector
* 
* Used by the routines at #R$4503 and #R$8E62.
* .
* Works out the length of the vector at HL - the square root (at $466B,
* two bits at a time) of the sum of the squares of its components
* (#R$461A) - and divides each component by it (#R$46A1), so that the
* vector's length is $4000 (1.0).
* 
* I:HL The vector (three sign-magnitude words)
normalise_vector:                                          ; >4642
       .proc
       .push hl                                            ; PUSH HL           ; save the vector's address
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 components
_4645:                                                     ; >4645
       mov  *hl+,de                                        ; LD E,(HL) / INC HL / LD D,(HL) / INC HL; DE = the next component (TI: a big-endian word)
       .push hl                                            ; PUSH HL           ; save the pointer
       .push bc                                            ; PUSH BC           ; 
       bl   @square_component                              ; CALL $461A        ; square it
       .pop bc                                             ; POP BC            ; 
       .ex_sp_hl                                           ; EX (SP),HL        ; put the square's high word on the stack...
       .push ix                                            ; PUSH IX           ; ...and its low word
       sb   one,b                                          ; DJNZ $4645        ; next component
       jne  _4645                                          ;                   
       li   ix,>0000                                       ; LD IX,$0000       ; 
       movb b,h                                            ; LD H,B            ; 
       movb b,@l                                           ; LD L,B            ; HL:IX = 0
       movb @bytes+>03,b                                   ; LD B,$03          ; add up the squares
_465c:                                                     ; >465c
       .pop de                                             ; POP DE            ; 
       a    de,ix                                          ; ADD IX,DE         ; 
       jnc  !                                              ;                   ; carry into the high word
       inc  hl                                             ;                   ; 
!
       .pop de                                             ; POP DE            ; 
       a    de,hl                                          ; ADC HL,DE         ; HL:IX = the sum of the squares
       sb   one,b                                          ; DJNZ $465C        ; 
       jne  _465c                                          ;                   
       clr  de                                             ; LD DE,$0000       ; DE = 0, the root so far
       li   r0,>8000                                       ; LD B,$10          ; R0 = the next bit of the root to try
_466d:                                                     ; >466d
       mov  de,bc                                          ; SUB $40           ; 
       soc  r0,bc                                          ; SBC HL,DE         ; BC = the root with that bit set
       mov  bc,r1                                          ;                   ; 
       mpy  bc,r1                                          ;                   ; R1:R2 = its square
       c    r1,hl                                          ;                   ; 
       jh   _4677                                          ;                   ; too big - leave the bit clear
       jl   !                                              ;                   ; 
       c    r2,ix                                          ;                   ; 
       jh   _4677                                          ;                   ; 
!
       mov  bc,de                                          ;                   ; it fits: keep the bit
_4677:                                                     ; >4677
       srl  r0,1                                           ; DJNZ $466D        ; next bit
       jne  _466d                                          ;                   ; 16 bits of root
       .pop hl                                             ; POP HL            ; HL -> the vector
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 components
_468f:                                                     ; >468f
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; save the pointer
       mov  *hl,hl                                         ; LD A,(HL) / INC HL / LD H,(HL) / LD L,A; HL = the component (TI: a big-endian word)
       bl   @divide_by_length                              ; CALL $46A1        ; divide it by the length
       .pop hl                                             ; POP HL            ; 
       movb a,*hl+                                         ; LD (HL),C / INC HL; store it (TI: high byte first)
       movb @c,*hl+                                        ; LD (HL),A / INC HL; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $468F        ; next component
       jne  _468f                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Divide a component by the vector's length
* 
* Used by the routine at #R$4642.
* .
* Part of #R$4642. Returns the component * $4000 / length, keeping its
* sign (bit 7 of A).
* 
* I:DE Length
* I:HL Component (sign-magnitude)
* O:A,C The result (sign-magnitude)
divide_by_length:                                          ; >46a1
       mov  hl,r1                                          ; RES 7,H           ; 
       andi r1,>7fff                                       ;                   ; R1 = |component|
       mov  r1,r2                                          ; SRL H             ; 
       srl  r1,2                                           ; RR L              ; 
       sla  r2,14                                          ; RRA               ; R1:R2 = |component| * $4000
       div  de,r1                                          ; SBC HL,DE         ; R1 = the quotient (the restoring division on the Z80)
       movb r1,a                                           ;                   ; 
       swpb r1                                             ;                   ; 
       movb r1,@c                                          ;                   ; A:C = the quotient
       mov  hl,hl                                          ; BIT 7,H           ; component positive?
       jlt  !                                              ; RET Z             ; yes - done
       rt                                                  ;                   ; 
!
       socb @bytes+>80,a                                   ; OR $80            ; no: set the sign bit
       rt                                                  ; RET               ; 

********************************************************************************
* Draw a ship: work out its size on screen
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Caches the logarithm of the object's depth - twice its z
* ($E6DA), or its distance (#R$EB8E) for the planet and sun (bit 3 of
* #R$F7CD) - for projecting (#R$EB9B, #R$E6F1). Then projects (#R$47F0) its
* targetable area (#R$F800) into $E6EF, for the laser sights ($4735), and
* its size (#R$F805) into #R$EB9E, its radius on screen (at $4738). The
* planet and sun are done by $4714.
* .
* At $4714, the radius on screen is 2 ^ ((K - log(distance)) / 1024), with
* K = $4C00 for the planet and $4800 for the sun (#R$21A3); 0 if that's too
* small ($4735).
* .
* At $4735, the radius is 0; at $4738, it's stored in #R$EB9E. Then, if the
* current view has a laser ($F818) and the object's X and Y coordinates
* ($E6D8, $F7D0), scaled by its distance (#R$47F0), are both within $E6EF,
* and it isn't exploding (bit 2 of #R$F7CD), it's in the sights: if the 'I'
* key has been pressed (#R$EF9D), shows its name (($F7FB), from its
* blueprint); marks it as in the sights for the laser (#R$EF99); and if the
* player's missile is armed (#R$E910 = 1), locks it onto the object -
* unless a missile is already on its way to it (#R$3016) - and shows
* "Missile Locked".
ship_screen_size:                                          ; >46ca
       .proc
       mov  @view_z2,de                                    ; LD DE,($E6DA)     ; DE = depth
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = the object status byte
       andi a,>0800                                        ; AND $08           ; test bit 3 (the orientation-vector gate, as elsewhere)
       jeq  _46d9                                          ; JR Z,$46D9        ; not the planet or sun
       movb @object_distance+1,de                          ; LD DE,($EB8E)     ; their distance
       movb @object_distance,@e                            ;                   ;
_46d9:                                                     ; >46d9
       movb d,a                                            ; LD A,D / OR A     ; A = DE's high byte
       jeq  _46e7                                          ; JR Z,$46E7        ; zero - skip the normalize loop below
       movb d,r1                                           ; LD L,A            ; 
       srl  r1,8                                           ; LD H,$02          ; 
       movb @bit_length_table(r1),a                        ; LD B,(HL)         ; A = the bit length of the high byte (the exponent)
       movb a,r0                                           ; RRA               ; 
       srl  r0,8                                           ; RR E              ; 
       mov  de,r2                                          ; DJNZ              ; shift DE right by that many bits...
       srl  r2,0                                           ;                   ; 
       swpb r2                                             ;                   ; 
       movb r2,@e                                          ;                   ; ...keeping the low byte
_46e7:                                                     ; >46e7
       movb a,@depth_shift                                 ; LD ($EB9B),A      ; the depth's exponent
       movb @e,r2                                          ; SLA E             ; 
       srl  r2,7                                           ; ADC A,$08         ; R2 = the word index * 2
       andi r2,>01fe                                       ;                   ; 
       mov  @log_table(r2),de                              ; LD A,(HL)         ; read the table entry
       movb de,@log_depth+1                                ; LD ($E6F1),DE     ; log of the depth
       movb @e,@log_depth                                  ;                   ;
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = the object status byte again
       andi a,>0800                                        ; AND $08           ; test bit 3 again
       jne  planet_screen_size                             ; JR NZ,$4714       ; the planet or sun
       movb @bp_targetable_area+1,hl                       ; LD HL,($F800)     ; the targetable area
       movb @bp_targetable_area,@l                         ;                   ;
       sb   h,h                                            ; LD H,$00          ; keep only the low byte
       bl   @project_coordinate                            ; CALL $47F0        ; project it
       movb hl,@targetable_area+1                          ; LD ($E6EF),HL     ; for the laser sights
       movb @l,@targetable_area                            ;                   ;
       movb @bp_size+1,hl                                  ; LD HL,($F805)     ; the size
       movb @bp_size,@l                                    ;                   ;
       sb   h,h                                            ; LD H,$00          ; keep only the low byte
       bl   @project_coordinate                            ; CALL $47F0        ; project it
       jmp  _4738                                          ; JR $4738          ; its radius on screen
planet_screen_size:                                        ; >4714
       li   hl,>4c00                                       ; LD HL,$4C00       ; K for the planet
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>65                                   ; CP $65            ; is it mode $65?
       jne  _4721                                          ; JR NZ,$4721       ; no - keep the $4C00 base
       li   hl,>4800                                       ; LD HL,$4800       ; K for the sun
_4721:                                                     ; >4721
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; K - log(distance)
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; A = the shift count
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; A = -exponent
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; A = -exponent * 4
       ab   h,a                                            ; ADD A,H           ; A += HL's high byte
       jlt  check_sights                                   ; JP M,$4735        ; too small
!
       movb a,h                                            ; LD H,A            ; else: H = the combined high byte
       bl   @antilog16                                     ; CALL $21A3        ; antilog
       jmp  _4738                                          ; JR $4738          ; join the shared continuation at $4738
check_sights:                                              ; >4735
       li   hl,>0000                                       ; LD HL,$0000       ; HL = 0
_4738:                                                     ; >4738
       mov  hl,@screen_radius                              ; LD ($EB9E),HL     ; 
       movb @view_laser_type,a                             ; LD A,($F818) / OR A; A = a sign byte at $F818
       jlt  ship_screen_size_exit                          ; RET M             ; no laser in this view
!
       mov  @view_x,hl                                     ; LD HL,($E6D8)     ; HL = X coordinate
       bl   @project_coordinate                            ; CALL $47F0        ; scale it by the distance
       movb @targetable_area+1,hl                          ; LD HL,($E6EF)     ; HL = a threshold at $E6EF
       movb @targetable_area,@l                            ;                   ;
       .ex_de_hl                                           ; EX DE,HL          ; DE = that threshold, HL = #R$47F0's result
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE
       joc  ship_screen_size_exit                          ; RET NC            ; outside the sights
!
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; HL = Y coordinate
       bl   @project_coordinate                            ; CALL $47F0        ; scale it by the distance
       movb @targetable_area+1,hl                          ; LD HL,($E6EF)     ; HL = the same threshold at $E6EF
       movb @targetable_area,@l                            ;                   ;
       .ex_de_hl                                           ; EX DE,HL          ; DE = that threshold, HL = #R$47F0's result
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE
       joc  ship_screen_size_exit                          ; RET NC            ; outside the sights
!
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = a flag byte at $F7CD
       andi a,>0400                                        ; AND $04           ; test bit 2
       jne  ship_screen_size_exit                          ; RET NZ            ; exploding
!
       movb @identify_target,a                             ; LD A,($EF9D) / OR A; A = a flag at $EF9D
       jeq  _4777                                          ; JR Z,$4777        ; 'I' not pressed
       movb @bp_name,hl                                    ; LD HL,($F7FB)     ; HL -> the ship's name
       movb @bp_name+1,@l                                  ;                   ;
       bl   @show_view_message                             ; CALL $39C8        ; show it
       sb   a,a                                            ; XOR A             ; A = 0
       movb a,@identify_target                             ; LD ($EF9D),A      ; 
       movb one,a                                          ; LD A,$01          ; A = 1
       .sfx 1                                              ; CALL $7468        ; play the beep
_4777:                                                     ; >4777
       movb @b255,a                                        ; LD A,$FF          ; A = $FF
       movb a,@in_sights                                   ; LD ($EF99),A      ; in the sights
       movb @missile_state,a                               ; LD A,($E910)      ; A = a state byte at $E910
       sb   one,a                                          ; DEC A             ; A -= 1
       jne  ship_screen_size_exit                          ; RET NZ            ; missile not armed
!
       movb @current_slot,a                                ; LD A,($E911)      ; C = this object's slot
       movb a,@c                                           ; LD C,A            ; C = that value
       bl   @find_missile_at_object                        ; CALL $3016        ; a missile on its way to it already?
       jne  !                                              ; RET Z             ; yes
ship_screen_size_exit:
       .endproc                                            ;                   
!
       li   hl,missile_state                               ; LD HL,$E910       ; HL -> $E910
       ab   one,*hl                                        ; INC (HL)          ; locked (state 2)
       bl   @draw_missile_indicator                        ; CALL $6B6E        ; redraw the missile indicator
       movb @current_slot,a                                ; LD A,($E911)      ; A = ($E911) again
       movb a,@missile_target                              ; LD ($E928),A      ; the missile's target
       movb one,a                                          ; LD A,$01          ; A = 1
       .sfx 1                                              ; CALL $7468        ; play the beep
       li   hl,msg_missile_locked                          ; LD HL,$4B9A       ; "Missile Locked"
       b    @show_view_message_jmp                         ; JP $39C8          ; show it

********************************************************************************
* Draw an explosion: the next dot's offset
* 
* Used by the routine at #R$4AEC.
* .
* Part of #R$4AEC. Multiplies the next two words of the random table (at
* ($E6DE)) by the explosion's size (#R$EB90), as logarithms (#R$2160).
* 
* O:DE,BC,HL x, y and 0
explosion_dot:                                             ; >47a1
       .proc
       movb @explosion_random_pointer+1,hl                 ; LD HL,($E6DE)     ; HL -> the next random number (#R$EEC6)
       movb @explosion_random_pointer,@l                   ;                   ;
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,b                                          ; LD B,(HL)         ; BC = the first
       inc  hl                                             ; INC HL            ; 
       .push hl                                            ; PUSH HL           ; save the pointer
       movb @perentry_loop_pointer+1,hl                    ; LD HL,($EB90)     ; HL = the explosion's size (as a logarithm)
       movb @perentry_loop_pointer,@l                      ;                   ;
       bl   @multiply_logs                                 ; CALL $2160        ; HL = the first * the size (#R$2160)
       .ex_sp_hl                                           ; EX (SP),HL        ; save it, HL = the pointer
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,b                                          ; LD B,(HL)         ; BC = the second
       inc  hl                                             ; INC HL            ; 
       movb hl,@explosion_random_pointer+1                 ; LD ($E6DE),HL     ; save the pointer for the next dot
       movb @l,@explosion_random_pointer                   ;                   ;
       movb @perentry_loop_pointer+1,hl                    ; LD HL,($EB90)     ; 
       movb @perentry_loop_pointer,@l                      ;                   ;
       bl   @multiply_logs                                 ; CALL $2160        ; HL = the second * the size
       movb h,b                                            ; LD B,H            ; BC = y
       movb @l,@c                                          ; LD C,L            ; 
       .pop de                                             ; POP DE            ; DE = x
       li   hl,>0000                                       ; LD HL,$0000       ; HL = z = 0
       .endproc                                            ; RET               ; 

********************************************************************************
* Project a point
* 
* Used by the routines at #R$422E, #R$43C2, #R$496D, #R$49FD and #R$4AEC.
* .
* Divides x and y by the depth z, as logarithms, giving the point's
* position on screen relative to the middle of the view (#R$47F0). Also
* caches log(z) for further projections (#R$EB9B, #R$E6F1).
* 
* I:DE x
* I:BC y
* I:HL z (positive)
* O:BC x on screen
* O:DE y on screen
project_point:                                             ; >47c4
       .proc
       .push bc                                            ; PUSH BC           ; save the caller's BC (the second value to combine)
       movb h,a                                            ; LD A,H / OR A     ; A = HL's high byte
       jeq  _47d5                                          ; JR Z,$47D5        ; z under 256
       movb h,r1                                           ; LD L,A            ; 
       srl  r1,8                                           ; LD H,$02          ; 
       movb @bit_length_table(r1),a                        ; LD B,(HL)         ; A = the bit length of the high byte (the exponent)
       movb a,r0                                           ; RRA               ; 
       srl  r0,8                                           ; RR L              ; 
       mov  hl,r2                                          ; DJNZ              ; shift HL right by that many bits...
       srl  r2,0                                           ;                   ; 
       swpb r2                                             ;                   ; 
       movb r2,@l                                          ;                   ; ...keeping the low byte
_47d5:                                                     ; >47d5
       movb a,@depth_shift                                 ; LD ($EB9B),A      ; the shift
       movb @l,r2                                          ; SLA L             ; 
       srl  r2,7                                           ; ADC A,$08         ; R2 = the word index * 2
       andi r2,>01fe                                       ;                   ; 
       mov  @log_table(r2),hl                              ; LD A,(HL)         ; read the table entry
       movb hl,@log_depth+1                                ; LD ($E6F1),HL     ; log(z)
       movb @l,@log_depth                                  ;                   ;
       .ex_de_hl                                           ; EX DE,HL          ; HL = the caller's DE (first value to combine)
       bl   @project_coordinate                            ; CALL $47F0        ; project x
       .ex_sp_hl                                           ; EX (SP),HL        ; stash the first result on the stack; HL = the saved BC
       bl   @project_coordinate                            ; CALL $47F0        ; project y
       .ex_de_hl                                           ; EX DE,HL          ; DE = the second result
       .pop bc                                             ; POP BC            ; BC = the first result (stashed above)
       .endproc                                            ; RET               ; return with BC/DE = the two combined results

********************************************************************************
* Project a coordinate
* 
* Used by the routines at #R$46CA and #R$47C4.
* .
* Returns 128 * v / z, worked out with logarithms: log(v) (normalised by
* the same shift as z, #R$EB9B) + log 128 ($1C00) - log(z) (#R$E6F1),
* turned back into a value (#R$21A3); 0 if it's out of range ($4839). Keeps
* v's sign.
* .
* At $4839, gives 0; at $483C, puts back v's sign.
* 
* I:HL v
* O:HL 128 * v / z
project_coordinate:                                        ; >47f0
       .proc
       .ex_de_hl                                           ; EX DE,HL          ; HL = the caller's value; DE = whatever it swaps with
       movb d,a                                            ; LD A,D / OR A     ; A = DE's high byte (the value's sign)
       .push af                                            ; PUSH AF           ; save the sign
       jgt  project_coordinate_abs                         ; JP P,$47FD        ; non-negative - skip the negate below
       jeq  project_coordinate_abs                         ;                   ; 
!
       neg  de                                             ; SUB E             ; negative: negate DE (absolute value)
       movb d,a                                            ; LD D,A            ; 
project_coordinate_abs:                                    ; >47fd
       movb d,a                                            ;                   ; A = D (the PUSH above changed the status)
       jeq  _4809                                          ; JR Z,$4809        ; zero - skip the normalize loop below
       movb d,r1                                           ; LD L,A            ; 
       srl  r1,8                                           ; LD H,$02          ; 
       movb @bit_length_table(r1),a                        ; LD B,(HL)         ; A = the bit length of the high byte (the exponent)
       movb a,r0                                           ; RRA               ; 
       srl  r0,8                                           ; RR E              ; 
       mov  de,r2                                          ; DJNZ              ; shift DE right by that many bits...
       srl  r2,0                                           ;                   ; 
       swpb r2                                             ;                   ; 
       movb r2,@e                                          ;                   ; ...keeping the low byte
_4809:                                                     ; >4809
       li   hl,depth_shift                                 ; LD HL,$EB9B       ; HL -> the exponent #R$46CA/#R$47C4 stored
       sb   *hl,a                                          ; SUB (HL)          ; A -= that exponent
       ab   a,a                                            ; ADD A,A           ; A doubled...
       ab   a,a                                            ; ADD A,A           ; ...twice more (A *= 4)
       .ex_af_af_                                          ; EX AF,AF'         ; stash A (and flags) in the shadow set
       movb @e,r2                                          ; SLA E             ; 
       srl  r2,7                                           ; ADC A,$08         ; R2 = the word index * 2
       andi r2,>01fe                                       ;                   ; 
       mov  @log_table(r2),hl                              ; LD A,(HL)         ; read the table entry
       li   bc,>1c00                                       ; LD BC,$1C00       ; BC = $1C00
       a    bc,hl                                          ; ADD HL,BC         ; HL += $1C00
       joc  project_coordinate_2                           ; JR C,$4839        ; overflowed - out of range
       movb @log_depth+1,de                                ; LD DE,($E6F1)     ; DE = the caller's stored scale word
       movb @log_depth,@e                                  ;                   ;
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE
       .ex_af_af_                                          ; EX AF,AF'         ; restore the stashed exponent*4 value
       ab   h,a                                            ; ADD A,H           ; A += HL's high byte
       jlt  project_coordinate_2                           ; JP M,$4839        ; negative - out of range
!
       movb a,h                                            ; LD H,A            ; else: H = the combined high byte
       bl   @antilog16                                     ; CALL $21A3        ; combine via #R$21A3
       mov  hl,hl                                          ; BIT 7,H           ; test the result's sign bit
       jgt  project_coordinate_join                        ; JP P,$4837        ; non-negative - keep it
       jeq  project_coordinate_join                        ;                   ; 
!
       szcb @bit7,h                                        ; RES 7,H           ; else clear the sign bit (magnitude only)
project_coordinate_join:                                   ; >4837
       jmp  _483c                                          ; JR $483C          ; join the shared sign-reapply tail
project_coordinate_2:                                      ; >4839
       li   hl,>0000                                       ; LD HL,$0000       ; HL = 0 (the out-of-range case)
_483c:                                                     ; >483c
       movb h,d                                            ; LD D,H            ; D = H
       movb @l,@e                                          ; LD E,L            ; E = L (DE = HL, the magnitude copy)
       .pop af                                             ; POP AF            ; restore the value's original sign
       jgt  project_coordinate_exit                        ; RET P             ; non-negative - return as-is
       jeq  project_coordinate_exit                        ;                   ; 
!
       neg  hl                                             ; SUB L             ; negative: negate HL
project_coordinate_exit:
       .endproc                                            ; RET               ; return with the original sign reapplied to HL

********************************************************************************
* Draw a ship: scale a normal's component
* 
* Used by the routine at #R$4873.
* .
* Part of #R$4873. Multiplies the component by the face's scale byte
* ($E7E8, with its bit length in $E7E9) and divides by 256, keeping the
* sign.
* 
* I:HL Component
* O:HL Scaled component
scale_normal_component:                                    ; >4847
       mov  hl,r0                                          ; BIT 7,H           ; R0 bit 15 = the value's sign
       clr  r1                                             ;                   ; 
       movb @l,r1                                          ; LD A,L            ; 
       mov  r0,r0                                          ;                   ; 
       jgt  !                                              ; JP P,$4851        ; non-negative - keep L as-is
       jeq  !                                              ;                   ; 
       neg  r1                                             ; NEG               ; negative: negate L
!
       srl  r1,8                                           ; LD E,L            ; R1 = abs(L)
       movb @face_scale,r2                                 ; LD A,($E7E8)      ; 
       srl  r2,8                                           ;                   ; R2 = the face's scale byte
       mpy  r2,r1                                          ; ADD HL,DE         ; R1:R2 = the product (the shift-and-add loop on the Z80)
       srl  r2,8                                           ; LD L,H            ; 
       mov  r2,hl                                          ; LD H,$00          ; HL = the product's high byte
       mov  r0,r0                                          ; POP AF            ; restore the value's original sign
       jlt  !                                              ; RET P             ; non-negative - return as-is
       rt                                                  ;                   ; 
!
       neg  hl                                             ; SUB L             ; negative: negate HL
       rt                                                  ; RET               ; 

********************************************************************************
* Draw a ship: does a face face the player?
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Rotates the face's normal (#R$E7EA) into the view
* (#R$4464), scales it by the face's scale byte (#R$4847), and adds up
* its products with the ship's position (#R$48EC) - a dot product,
* negative if the face can be seen.
* 
* O:A,HL The dot product (A the high byte)
face_visible:                                              ; >4873
       .proc
       .push hl                                            ; PUSH HL           ; save the caller's HL
       bl   @rotate_vertex                                 ; CALL $4464        ; transform the vector via #R$4464 (BC/DE/HL = its three components)
       mov  de,@rotated_vector                             ; LD ($E7EA),DE     ; cache the first component
       mov  bc,@rotated_vector_y                           ; LD ($E7EC),BC     ; cache the second component
       mov  hl,@rotated_vector_z                           ; LD ($E7EE),HL     ; cache the third component
       .ex_de_hl                                           ; EX DE,HL          ; HL = the first component
       bl   @scale_normal_component                        ; CALL $4847        ; scale it via #R$4847
       .push hl                                            ; PUSH HL           ; save the scaled result
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; HL = the second component
       bl   @scale_normal_component                        ; CALL $4847        ; scale it too
       .push hl                                            ; PUSH HL           ; save that result
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; HL = the third component
       bl   @scale_normal_component                        ; CALL $4847        ; scale it too
       .pop bc                                             ; POP BC            ; BC = the second scaled result
       .pop de                                             ; POP DE            ; DE = the first scaled result
       bl   @add_object_position                           ; CALL $44D2        ; combine (third scaled result in HL) with BC/DE via #R$44D2
       czc  @bit7,d                                        ; BIT 7,D           ; test D's sign bit
       jeq  _48a5                                          ; JR Z,$48A5        ; clear - skip the negate below
       neg  de                                             ; SUB E             ; set: negate DE...
       ori  de,>8000                                       ; OR $80            ; ...and force the sign bit set (sign-magnitude form)
_48a5:                                                     ; >48a5
       czc  @bit7,b                                        ; BIT 7,B           ; test B's sign bit
       jeq  _48b1                                          ; JR Z,$48B1        ; clear - skip the negate below
       neg  bc                                             ; SUB C             ; set: negate BC...
       ori  bc,>8000                                       ; OR $80            ; ...and force the sign bit set
_48b1:                                                     ; >48b1
       mov  bc,@face_visible_workspace_1                   ; LD ($E6EA),BC     ; cache the sign-magnitude BC
       czc  @bit7,h                                        ; BIT 7,H           ; test H's sign bit
       jeq  _48c1                                          ; JR Z,$48C1        ; clear - skip the negate below
       neg  hl                                             ; SUB L             ; set: negate HL...
       ori  hl,>8000                                       ; OR $80            ; ...and force the sign bit set
_48c1:                                                     ; >48c1
