********************************************************************************
* "FRONT VIEW" bitmap
* 
* The view name shown when switching to the front view (#R$64A1): 7
* characters of 5 pixel rows each, one character per line, which #R$645B
* copies into rows 1-5 of the character patterns at VRAM $0060-$0097.
view_name_front:                                           ; >118f
       byte >FB,>C3,>F3,>C3,>C3
       byte >C7,>6D,>CD,>4D,>27
       byte >26,>B6,>BE,>B6,>32
       byte >F0,>60,>60,>60,>60
       byte >6D,>6C,>6C,>28,>11
       byte >EF,>CC,>CF,>CC,>EF
       byte >B6,>36,>36,>3E,>94

********************************************************************************
* Get the object's blueprint data
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C and #R$1E5A.
* .
* Copies the 26-byte header of the blueprint for the object's ship type
* ($F7E7), found via the table at #R$A7D7, to $F7F5-$F80E (see #R$A817
* for the layout). Does nothing for ship types $64 and above (the planet
* and the sun), which have no blueprint.
get_blueprint_data:                                        ; >16e3
       .proc
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = ship type
       cb   a,@bytes+29
       jhe  !
       seto @blueprints_1_bank_select                                          ; Select blueprints ROM bank 1
       jmp  !!
!
       seto @blueprints_2_bank_select                                          ; Select blueprints ROM bank 2
!
       cb   a,@bytes+>64                                   ; CP $64            ; 
       jl   !                                              ; RET NC            ; the planet or the sun - no blueprint
       .endproc                                            ;                   
!
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; HL = that word index
       li   bc,ship_blueprints                             ; LD BC,$A7D7       ; BC -> the blueprint table
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this ship type's table entry
       movb *hl,a                                          ; LD A,(HL)         ; read the entry (little-endian word)...
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL -> the blueprint header
       li   de,bp_vertices                                 ; LD DE,$F7F5       ; 
       li   bc,>001a                                       ; LD BC,$001A       ; 26 bytes
       .ldir                                               ; LDIR              ; copy the header to $F7F5
       .endproc                                            ; RET               ; 

********************************************************************************
* Title screen
*
* Used by the routines at #R$0106 and #R$9120.
* .
* Called by the main loop (#R$0106), and by #R$9120 for a mission briefing.
* Switches to the front view (#R$64A1), which also draws the cockpit
* screen, and marks the game as in flight (($E903)) with the main loop's
* per-frame pass off (($E90A)).
* .
* Normally, turns sound effects off, starts the title music (#R$7603), and
* shows the spinning "ELITE" letters (#R$1E01). Then shows each of the 14
* ships in #R$1F40 in turn: each one flies in from a distance of 2000 to a
* distance that depends on its size, turns this way and that for 150
* frames, then flies off, with its name and "Load New Commander ?" shown
* underneath. After the last ship it starts again with the letters. It only
* leaves when Y or N is pressed ($1DB5), jumping to the load commander
* screen or the docked screen.
* .
* For a mission briefing (($E93D) = $10, from #R$9120) it shows just the
* ship in #R$1F4F, with "Hit key for mission", and returns when any key is
* pressed.
* .
* At $1D3D, moves the ship in by 120 each frame until it reaches the
* distance in ($E888), then turns it about two axes by angles that swing
* back and forth (#R$1DDC). Counts down the 150 frames in ($E88B), and then
* starts the ship flying off (($E88C)). Then checks for a key (($E8F5)):
* for a mission briefing any key returns; otherwise Y or N goes to $1DB5,
* and anything else is ignored. Loops back for the next frame at #R$1CF4.
* .
* At $1DB5, stops the music (#R$7438), sets up the commander record
* (#R$A469), turns sound effects back on, and clears $EEC1, $E940, $EF8E
* and $E90C. Then Y ($E924 = $FF) goes to the load commander screen
* (#R$A30A), and N to the docked screen (#R$6276), starting with the
* default commander.
title_screen:                                              ; >1c5c
       limi 0                                              ; DI                ; backdrop colour 1 (black)
       movb one,a                                          ; LD A,$01          ;
       movb a,@vdpwa                                       ; OUT ($99),A       ;
       movb @bytes+>87,a                                   ; LD A,$87          ;
       movb a,@vdpwa                                       ; OUT ($99),A       ;
       ; EI                                                ; EI                ; TODO: check code.
       sb   a,a                                            ; XOR A             ;
       movb a,@docked                                      ; LD ($E90A),A      ;
       sb   one,a                                          ; DEC A             ;
       movb a,@e940_gate_flag                              ; LD ($E940),A      ; $E940 = $FF
       bl   @switch_to_front_view                          ; CALL $64A1        ; switch to the front view (drawing the cockpit screen)
       movb @b255,a                                        ; LD A,$FF          ;
       movb a,@space_view_showing                          ; LD ($E903),A      ; space view showing...
       movb a,@docked                                      ; LD ($E90A),A      ; ...and docked
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       jeq  title_screen_mission                           ; JR Z,$1C93        ; mission briefing - #R$1C93
       li   hl,options                                     ; LD HL,$E914       ;
       szcb @bit0,*hl                                      ; RES 0,(HL)        ; turn sound effects off (see #R$7468)
;       li   hl,title_music                                 ; LD HL,$7AE4       ;
;       .call @start_tune                                   ; CALL $7603        ; start the music
_1c8b:                                                     ; >1c8b
       bl   @title_screen_letters                          ; CALL $1E01        ; show the spinning "ELITE" letters
       li   hl,title_ships                                 ; LD HL,$1F40       ; HL -> the list of title screen ships
       jmp  _1c96                                          ; JR $1C96          ;
title_screen_mission:                                      ; >1c93
       li   hl,mission_briefing_ship                       ; LD HL,$1F4F       ; HL -> the mission briefing ship
_1c96:                                                     ; >1c96
       mov  hl,@title_ship_ptr                             ; LD ($E890),HL     ; point at the first ship
       movb @bytes+>71,a                                   ; LD A,$71          ;
       bl   @colour_space_view                             ; CALL $3A4D        ; colour the space view ($71)
title_screen_next_ship:                                    ; >1c9e
       mov  @title_ship_ptr,hl                             ; LD HL,($E890)     ; HL -> next ship in the list
       movb *hl,a                                          ; LD A,(HL)         ; A = this step's view-type byte
       socb a,a                                            ; OR A              ;
       jeq  _1c8b                                          ; JR Z,$1C8B        ; end of the list - start again with the letters
       movb *hl,a                                          ; LD A,(HL)         ;
       movb a,@ship_type                                   ; LD ($F7E7),A      ; set the object's type
       inc  hl                                             ; INC HL            ;
       mov  hl,@title_ship_ptr                             ; LD ($E890),HL     ;
       movb one,a                                          ; LD A,$01          ;
       movb a,@title_wobble_target_1                       ; LD ($E886),A      ; wobble targets start at 1
       movb a,@title_wobble_target_2                       ; LD ($E887),A      ;
       movb a,@object_status_byte                          ; LD ($F7CD),A      ;
       li   hl,title_ship_start                            ; LD HL,$1F2E       ; set its position (Z = 2000) and orientation
       li   de,object_position_x                           ; LD DE,$F7CE       ;
       li   bc,>0012                                       ; LD BC,$0012       ;
       .ldir                                               ; LDIR              ;
       bl   @get_blueprint_data                            ; CALL $16E3        ; set the object up for its type (#R$16E3)
       sb   a,a                                            ; XOR A             ;
       movb a,@title_ship_arrived                          ; LD ($E88A),A      ; not arrived yet
       movb a,@title_ship_flying_off                       ; LD ($E88C),A      ; not flying off yet
       movb a,@title_wobble                                ; LD ($E884),A      ; wobble angles start at 0
       movb a,@title_wobble_angle_2                        ; LD ($E885),A      ;
       movb a,@object_status_byte                          ; LD ($F7CD),A      ;
       movb a,@handler_type                                ; LD ($F7EE),A      ;
       movb @bytes+>96,a                                   ; LD A,$96          ;
       movb a,@title_ship_frames                           ; LD ($E88B),A      ; stay for 150 frames
       movb @bp_size,a                                     ; LD A,($F805)      ; A = the ship's size
       movb a,h                                            ; LD H,A            ;
       sb   @l,@l                                          ; LD L,$00          ; HL = A:$00
       srl  h,1                                            ; SRL H             ;
       ; RR L                                              ; RR L              ; TODO: check code. HL = HL >> 2
       srl  h,1                                            ; SRL H             ;
       ; RR L                                              ; RR L              ; TODO: check code.
       movb @bytes+>2c,a                                   ; LD A,$2C          ;
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = size * 64 / 44
       mov  hl,@title_ship_distance                        ; LD ($E888),HL     ; the distance to fly in to
title_screen_next_frame:                                   ; >1cf4
       bl   @clear_space_view                              ; CALL $388F        ; next frame: clear the space view
       movb @bytes+>d6,a                                   ; LD A,$D6          ;
       movb a,@message_row                                 ; LD ($E92C),A      ; the ship's name at the top of the view
       mov  @bp_name,hl                                    ; LD HL,($F7FB)     ;
       bl   @show_view_message                             ; CALL $39C8        ; print the ship's name
_1d02:                                                     ; >1d02
       bl   @count_message_timer                           ; CALL $39F1        ;
       movb @bytes+>e4,a                                   ; LD A,$E4          ;
       movb a,@message_row                                 ; LD ($E92C),A      ; the prompt at the bottom
       li   hl,msg_load_new_commander                      ; LD HL,$1ED7       ; HL = "Load New Commander ?"
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       jne  _1d17                                          ; JR NZ,$1D17       ;
       li   hl,msg_hit_key_mission                         ; LD HL,$1EF9       ; mission briefing: "Hit key for mission"
_1d17:                                                     ; >1d17
       bl   @show_view_message                             ; CALL $39C8        ; print it
       bl   @draw_object                                   ; CALL $422E        ; draw the ship
       bl   @copy_space_view                               ; CALL $3846        ; copy the space view to the screen
       movb @title_ship_flying_off,a                       ; LD A,($E88C)      ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_frame                             ; JR Z,$1D3D        ; not flying off
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; else HL = #R$EB9E (cached_range_value)
       li   de,>0005                                       ; LD DE,$0005       ;
       s    de,hl                                          ; SBC HL,DE         ;
       jnc  !                                              ; JP C,$1C9E        ; TODO: check code. flown out of sight - next ship
       b    @title_screen_next_ship                        ;
!
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; else nudge $F7D2 towards +200...
       li   de,>00c8                                       ; LD DE,$00C8       ;
       a    de,hl                                          ; ADD HL,DE         ;
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; fly off: Z += 200
       jmp  _1d62                                          ; JR $1D62          ;
title_screen_frame:                                        ; >1d3d
       movb @title_ship_arrived,a                          ; LD A,($E88A)      ; has the ship arrived?
       socb a,a                                            ; OR A              ;
       jne  _1d62                                          ; JR NZ,$1D62       ; yes
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; no: move it closer
       li   de,>ff88                                       ; LD DE,$FF88       ;
       a    de,hl                                          ; ADC HL,DE         ;
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ;
       mov  @title_ship_distance,de                        ; LD DE,($E888)     ; DE = distance to stop at
       jhe  !                                              ; JP M,$1D5A        ;
       b    @title_screen_ship_arrived                     ;
!
       socb a,a                                            ; OR A              ;
       s    de,hl                                          ; SBC HL,DE         ;
       jnc  _1d62                                          ; JR NC,$1D62       ; TODO: check code. not there yet
title_screen_ship_arrived:                                 ; >1d5a
       mov  de,@object_position_z_lo                       ; LD ($F7D2),DE     ; there: stop at that distance
       li   hl,title_ship_arrived                          ; LD HL,$E88A       ;
       sb   one,*hl                                        ; DEC (HL)          ; and flag it as arrived
_1d62:                                                     ; >1d62
       li   hl,title_wobble                                ; LD HL,$E884       ;
       li   ix,title_wobble_target_1                       ; LD IX,$E886       ;
       .call @title_screen_swing                           ; CALL $1DDC        ; swing the first angle
       li   hl,title_wobble_angle_2                        ; LD HL,$E885       ;
       li   ix,title_wobble_target_2                       ; LD IX,$E887       ;
       .call @title_screen_swing                           ; CALL $1DDC        ; and the second
       movb @title_wobble,a                                ; LD A,($E884)      ;
       sra  a,1                                            ; SRA A             ;
       bl   @pitch_object                                  ; CALL $2365        ; turn the ship
       movb @title_wobble_angle_2,a                        ; LD A,($E885)      ;
       sra  a,1                                            ; SRA A             ;
       bl   @roll_object                                   ; CALL $23D9        ; about both axes
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       jeq  _1d97                                          ; JR Z,$1D97        ; mission briefing - the ship stays
       li   hl,title_ship_frames                           ; LD HL,$E88B       ;
       sb   one,*hl                                        ; DEC (HL)          ;
       jne  _1d97                                          ; JR NZ,$1D97       ;
       sb   one,a                                          ; DEC A             ;
       movb a,@title_ship_flying_off                       ; LD ($E88C),A      ; time's up: start flying off
_1d97:                                                     ; >1d97
       bl   @straighten_orientation                        ; CALL $4503        ; re-orthogonalise the ship's axes
       li   hl,pending_debounced_keypress_byte_status      ; LD HL,$E8F5       ;
       movb *hl,a                                          ; LD A,(HL)         ;
       socb a,a                                            ; OR A              ;
       jeq  _1db2                                          ; JR Z,$1DB2        ; no key pressed
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       movb *hl,a                                          ; LD A,(HL)         ;
       sb   *hl,*hl                                        ; LD (HL),$00       ;
       jne  !                                              ; RET Z             ; mission briefing: any key returns
       .ret                                                ;
!
       cb   a,@bytes+>59                                   ; CP $59            ;
       jeq  title_screen_key                               ; JR Z,$1DB5        ; Y
       cb   a,@bytes+>4e                                   ; CP $4E            ;
       jeq  title_screen_key                               ; JR Z,$1DB5        ; N
_1db2:                                                     ; >1db2
       b    @title_screen_next_frame                       ; JP $1CF4          ; next frame
title_screen_key:                                          ; >1db5
       .push af                                            ; PUSH AF           ;
;       .call @stop_all_sound                               ; CALL $7438        ; stop the music
;       .call @unpack_commander                             ; CALL $A469        ; set up the commander record
       li   hl,options                                     ; LD HL,$E914       ;
       socb @bit0,*hl                                      ; SET 0,(HL)        ; sound effects on
       sb   a,a                                            ; XOR A             ;
       movb a,@in_witchspace                               ; LD ($EEC1),A      ;
       movb a,@e940_gate_flag                              ; LD ($E940),A      ;
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ;
       movb a,@alert_level                                 ; LD ($E90C),A      ;
       .pop af                                             ; POP AF            ;
       cb   a,@bytes+>59                                   ; CP $59            ;
       jeq  !                                              ; JP NZ,$6276       ; N - the docked screen
;       b    @status_page                                   ;
!
       movb @b255,a                                        ; LD A,$FF          ;
       movb a,@load_new_commander                          ; LD ($E924),A      ;
;       b    @commander_menu                                ; JP $A30A          ; Y - load a commander

********************************************************************************
* Title screen: swing an angle back and forth
*
* Used by the routine at #R$1C5C.
* .
* Steps the angle at HL by 1 towards its target at IX. On reaching it,
* picks a new random target of 20-35 with the opposite sign, so the angle
* swings back and forth by varying amounts. $1DF3 handles a negative
* target.
*
* I:HL Pointer to the angle
* I:IX Pointer to its target
title_screen_swing:                                        ; >1ddc
       movb *ix,a                                          ; LD A,(IX+$00)     ;
       socb a,a                                            ; OR A              ; the target negative?
       jhe  !                                              ; JP M,$1DF3        ; yes
       b    @title_screen_swing_down                       ;
!
       ab   one,*hl                                        ; INC (HL)          ; swing up
       cb   a,*hl                                          ; CP (HL)           ; reached the target?
       jeq  !                                              ; RET NZ            ; no
       .ret                                                ;
!
       bl   @random_byte                                   ; CALL $2176        ;
       andi a,>0f00                                        ; AND $0F           ;
       ab   @bytes+>14,a                                   ; ADD A,$14         ;
       neg a                                               ; NEG               ;
       movb a,*ix                                          ; LD (IX+$00),A     ; new target: -(20 to 35)
       .ret                                                ; RET               ;
title_screen_swing_down:                                   ; >1df3
       sb   one,*hl                                        ; DEC (HL)          ; swing down
       cb   a,*hl                                          ; CP (HL)           ; reached the target?
       jeq  !                                              ; RET NZ            ; no
       .ret                                                ;
!
       bl   @random_byte                                   ; CALL $2176        ;
       andi a,>0f00                                        ; AND $0F           ;
       ab   @bytes+>14,a                                   ; ADD A,$14         ;
       movb a,*ix                                          ; LD (IX+$00),A     ; new target: 20 to 35
       .ret                                                ; RET               ;

********************************************************************************
* Title screen: the spinning "ELITE" letters
*
* Used by the routine at #R$1C5C.
* .
* Clears the object table (#R$28D4), colours the space view ($D1), and
* adds the five letters from #R$1F0C one by one, each at its X position
* with the orientation from #R$1F1E (#R$3037). After each one it runs
* #R$1E5A for 24 frames, in which the newest letter turns one way and
* comes 7 closer per frame, while the ones before it turn the other way
* and move 7 further away. After the fifth, a short pause, then 24 more
* frames of all five turning and moving away. A keypress at any point
* ends the letters. The entry at $1E32, which adds a single object, is
* the target of the unused jump-table entry at $0088 (see #R$003B).
title_screen_letters:                                      ; >1e01
       .proc
       bl   @clear_all_ship_slots                          ; CALL $28D4        ;
       movb @bytes+>d1,a                                   ; LD A,$D1          ;
       bl   @colour_space_view                             ; CALL $3A4D        ; colour the space view
       movb @b255,a                                        ; LD A,$FF          ;
       movb a,@title_letter_being_added                    ; LD ($E892),A      ; a letter is being added
       movb @bytes+>e4,a                                   ; LD A,$E4          ;
       movb a,@message_row                                 ; LD ($E92C),A      ; messages at the bottom of the view
       li   hl,title_letters                               ; LD HL,$1F0C       ; HL -> the letters
       movb @bytes+>05,b                                   ; LD B,$05          ; 5 letters
* This entry point is used by the routine at #R$1E48.
title_screen_add_letter:                                   ; >1e18
       movb *hl,a                                          ; LD A,(HL)         ;
       inc  hl                                             ; INC HL            ;
       movb a,@ship_type                                   ; LD ($F7E7),A      ; set the letter's ship type
       movb *hl,@e                                         ; LD E,(HL)         ;
       inc  hl                                             ; INC HL            ;
       movb *hl,d                                          ; LD D,(HL)         ;
       inc  hl                                             ; INC HL            ;
       mov  de,@object_position_x                          ; LD ($F7CE),DE     ; set its X position
       .push bc                                            ; PUSH BC           ;
       .push hl                                            ; PUSH HL           ;
       li   hl,title_letters_orientation                   ; LD HL,$1F1E       ;
       li   de,object_position_y                           ; LD DE,$F7D0       ;
       li   bc,>0010                                       ; LD BC,$0010       ;
       .ldir                                               ; LDIR              ; set its Y, Z and orientation
spawn_fresh_ship:                                          ; >1e32
       sb   a,a                                            ; XOR A             ;
       movb a,@handler_type                                ; LD ($F7EE),A      ;
       ab   one,a                                          ; INC A             ;
       movb a,@object_status_byte                          ; LD ($F7CD),A      ;
       bl   @add_object                                    ; CALL $3037        ; add it to the object table
       mov  hl,@title_letter_slot                          ; LD ($E88E),HL     ; remember which slot it's in
       bl   @title_screen_letter_frames                    ; CALL $1E5A        ; run 24 frames
       jnc  title_screen_next_letter                       ; JR NC,$1E48       ; TODO: check code. no key pressed
       .pop hl                                             ; POP HL            ;
       .pop hl                                             ; POP HL            ;
       .endproc                                            ; RET               ; key pressed - end the letters

********************************************************************************
* Title screen: next letter
*
* Used by the routine at #R$1E01.
* .
* Continues #R$1E01 with the next letter; after the fifth, pauses briefly,
* clears ($E892), and runs 24 more frames (#R$1E5A) with all five letters
* turning and moving away.
title_screen_next_letter:                                  ; >1e48
       .pop hl                                             ; POP HL            ;
       .pop bc                                             ; POP BC            ;
       sb   one,b                                          ; DEC B             ;
       jeq  !                                              ; JP NZ,$1E18       ; next letter
       b    @title_screen_add_letter                       ;
!
_1e4e:                                                     ; >1e4e
       dec  bc                                             ; DEC BC            ;
       movb b,a                                            ; LD A,B            ;
       socb @c,a                                           ; OR C              ;
       jne  _1e4e                                          ; JR NZ,$1E4E       ; a short pause
       sb   a,a                                            ; XOR A             ;
       movb a,@title_letter_being_added                    ; LD ($E892),A      ; no letter being added any more
       b    @title_screen_letter_frames_jmp                ; JP $1E5A          ; 24 more frames

********************************************************************************
* Title screen: run 24 frames of the "ELITE" letters
*
* Used by the routines at #R$1E01 and #R$1E48.
* .
* Each frame clears the space view, and turns and moves each letter: the
* one being added (the slot in ($E88E), while ($E892) is set) turns one way
* (#R$2365, A=$7F) and comes 7 closer; the others ($1E96) turn the other
* way and move 7 away. Then prints "(c)1987 Firebird" and waits for the
* frame to end ($1EB3).
* .
* At $1E96, turns the letter (#R$2365, A=$81), moves it 7 further away,
* draws it (#R$422E) and copies its record back to the object table.
* .
* At $1EB3, prints "(c)1987 Firebird" (#R$1EEB), copies the space view to
* the screen, and waits until 7 VBlanks have passed since the frame
* started. If a key has been pressed, returns (from #R$1E5A) with carry
* set.
* .
* At $1ED0, loops back to #R$1E5C until the 24 frames are done, then
* returns with carry clear.
*
* O:F Carry set if a key was pressed
title_screen_letter_frames:                                ; >1e5a
       .proc
title_screen_letter_frames_jmp:
       movb @bytes+>18,b                                   ; LD B,$18          ; 24 frames
title_screen_letter_slot:                                  ; >1e5c
       .push bc                                            ; PUSH BC           ;
       bl   @clear_space_view                              ; CALL $388F        ; clear the space view
       sb   a,a                                            ; XOR A             ;
       movb a,@vblank_subtick_counter                      ; LD ($F748),A      ; start timing the frame
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; HL -> the object table
_1e67:                                                     ; >1e67
       movb *hl,a                                          ; LD A,(HL)         ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_letter_frame_end                  ; JR Z,$1EB3        ; no more letters - end of the frame
       .push hl                                            ; PUSH HL           ;
       .push hl                                            ; PUSH HL           ;
       li   de,object_status_byte                          ; LD DE,$F7CD       ;
       li   bc,>0028                                       ; LD BC,$0028       ;
       .ldir                                               ; LDIR              ; copy the letter's record to the workspace
       bl   @get_blueprint_data                            ; CALL $16E3        ;
       movb @title_letter_being_added,a                    ; LD A,($E892)      ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_letter_away                       ; JR Z,$1E96        ; no letter being added
       .pop de                                             ; POP DE            ;
       mov  @title_letter_slot,hl                          ; LD HL,($E88E)     ;
       socb a,a                                            ; OR A              ;
       s    de,hl                                          ; SBC HL,DE         ;
       jne  _1e94                                          ; JR NZ,$1E94       ; not the one being added
       movb @bytes+>7f,a                                   ; LD A,$7F          ;
       bl   @pitch_object                                  ; CALL $2365        ; turn it 30 degrees
       movb @object_position_z_lo,a                        ; LD A,($F7D2)      ;
       sb   @bytes+>07,a                                   ; SUB $07           ;
       movb a,@object_position_z_lo                        ; LD ($F7D2),A      ; and move it 7 closer
_1e94:                                                     ; >1e94
       jmp  _1ea4                                          ; JR $1EA4          ;
title_screen_letter_away:                                  ; >1e96
       .pop de                                             ; POP DE            ;
       movb @bytes+>81,a                                   ; LD A,$81          ;
       bl   @pitch_object                                  ; CALL $2365        ; turn it 30 degrees the other way
       movb @object_position_z_lo,a                        ; LD A,($F7D2)      ;
       ab   @bytes+>07,a                                   ; ADD A,$07         ;
       movb a,@object_position_z_lo                        ; LD ($F7D2),A      ; and move it 7 away
_1ea4:                                                     ; >1ea4
       bl   @draw_object                                   ; CALL $422E        ; draw it
       .pop de                                             ; POP DE            ;
       li   hl,object_status_byte                          ; LD HL,$F7CD       ;
       li   bc,>0028                                       ; LD BC,$0028       ;
       .ldir                                               ; LDIR              ; copy the record back
       .ex_de_hl                                           ; EX DE,HL          ;
       jmp  _1e67                                          ; JR $1E67          ;
title_screen_letter_frame_end:                             ; >1eb3
       li   hl,msg_copyright_1987_firebird                 ; LD HL,$1EEB       ;
       bl   @show_view_message                             ; CALL $39C8        ; print "(c)1987 Firebird"
       bl   @copy_space_view                               ; CALL $3846        ; copy the space view to the screen
_1ebc:                                                     ; >1ebc
       movb @vblank_subtick_counter,a                      ; LD A,($F748)      ;
       cb   a,@bytes+>07                                   ; CP $07            ;
       jl   _1ebc                                          ; JR C,$1EBC        ; wait for 7 VBlanks
       movb @pending_debounced_keypress_byte_status,a      ; LD A,($E8F5)      ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_letter_next_frame                 ; JR Z,$1ED0        ; no key
       sb   a,a                                            ; XOR A             ;
       movb a,@pending_debounced_keypress_byte_status      ; LD ($E8F5),A      ; forget the key
       .pop hl                                             ; POP HL            ;
       ; SCF                                               ; SCF               ; TODO: check code.
       .endproc                                            ; RET               ; return with carry set
title_screen_letter_next_frame:                            ; >1ed0
       .pop bc                                             ; POP BC            ; recover the slot counter
       sb   one,b                                          ; DEC B             ;
       jeq  !                                              ; JP NZ,$1E5C       ; slots remain - render the next one
       b    @title_screen_letter_slot                      ;
!
       socb a,a                                            ; OR A              ; none left - carry clear (no key pressed)
       .endproc                                            ; RET               ;

********************************************************************************
* The message "Load New Commander ?"
msg_load_new_commander:                                    ; >1ed7
       text 'LOAD NEW COMMANDER ',>bf

********************************************************************************
* The message "(c)1987 Firebird"
*
* #R$1EB3 (display_message_wait_few_frames) loads HL here directly and
* measures and prints it as one string (#R$39C8), up to the bit-7-set "d".
* Character $60 is the copyright symbol in this game's font (#R$0A9F).
msg_copyright_1987_firebird:                               ; >1eeb
       text >60,'1987 FIREBIR',>e4

********************************************************************************
* The message "Hit key for mission"
msg_hit_key_mission:                                       ; >1ef9
       text 'HIT KEY FOR MISSIO',>ee

********************************************************************************
* Title screen "ELITE" letters
*
* 3 bytes per letter, for #R$1E01: the ship type (8, 9, 10, 11 and 8
* again - E, L, I, T, E), then the X position (-30, -15, 0, 15, 30).
title_letters:                                             ; >1f0c
       byte >08,>E2,>FF,>09,>F1,>FF,>0A,>00
       byte >00,>0B,>0F,>00,>08,>1E,>00,>0A
       byte >18,>FC

********************************************************************************
* Title screen letters' starting position and orientation
*
* Copied to $F7D0 for each letter by #R$1E01: Y = 0, Z = 192, then the
* orientation vectors.
title_letters_orientation:                                 ; >1f1e
       byte >00,>00,>C0,>00,>00,>40,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>40

********************************************************************************
* Title screen ships' starting position and orientation
*
* Copied to $F7CE by #R$1C5C for each ship: X = 0, Y = 0, Z = 2000, then
* the orientation vectors.
title_ship_start:                                          ; >1f2e
       byte >00,>00,>00,>00,>D0,>07,>00,>C0
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>C0

********************************************************************************
* Title screen ships
*
* The ship types (14, 27, 1, 4, 17, 21, 18, 24, 22, 28, 26, 29, 12, 5)
* of the ships #R$1C5C shows in turn, ending with 0.
title_ships:                                               ; >1f40
       byte >0E,>1B,>01,>04,>11,>15,>12,>18
       byte >16,>1C,>1A,>1D,>0C,>05,>00

********************************************************************************
* Mission briefing ship
* 
* The ship type (31) of the ship #R$1C5C shows for a mission briefing,
* ending with 0.
mission_briefing_ship:                                     ; >1f4f
       byte >1F,>00

********************************************************************************
* Multiply: HL = L * L, or A * E
* 
* Used by the routines at #R$205D and #R$8570.
* .
* Returns L squared. The entry at $1F60 returns A * E, unsigned: a shift
* and add multiplication, looping once for each bit of A (its bit length,
* from the table at #R$0200).
* 
* I:L The number to square
* O:HL The product
square_l:                                                  ; >1f5e
       movb @l,a                                           ; LD A,L            ; 
       movb a,@e                                           ; LD E,A            ; A = E = L
* This entry point is used by the routines at #R$2FF9, #R$3D76, #R$3DF4,
* #R$4C2B, #R$4C80, #R$4EEC, #R$50AA, #R$512F, #R$525F, #R$5524, #R$5E6B,
* #R$6164, #R$6A59, #R$6AAD, #R$6BB3 and #R$6BCA.
multiply_a_e_16bit:                                        ; >1f60
       movb a,@l                                           ; LD L,A            ; 
       movb @bytes+>02,h                                   ; LD H,$02          ; 
       movb *hl,b                                          ; LD B,(HL)         ; B = A's bit length (#R$0200)
       sb   d,d                                            ; LD D,$00          ; 
       movb d,h                                            ; LD H,D            ; 
       movb d,@l                                           ; LD L,D            ; HL = 0, the product; DE = E, which is shifted left
_1f68:                                                     ; >1f68
       srl  a,1                                            ; RRA               ; TODO: check code. shift the next bit out of A
       jnc  _1f6c                                          ; JR NC,$1F6C       ; TODO: check code. 0 - don't add
       a    de,hl                                          ; ADD HL,DE         ; 1: add DE
_1f6c:                                                     ; >1f6c
       ; SLA E                                             ; SLA E             ; TODO: check code. shift DE left
       sla  d,1                                            ; RL D              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $1F68        ; next bit
       jne  _1f68                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Multiply: 16-bit x 8-bit -> 24-bit, unsigned
* 
* Used by the routines at #R$24A7, #R$24D1, #R$4B76, #R$848D and #R$8F94.
* .
* Computes (A:HL) = HL * A via the standard double-and-add algorithm: for
* each set bit of the multiplier (A, tested from bit 0 upward via SRL),
* adds the current (doubling) 24-bit multiplicand C:DE into the 24-bit
* accumulator A:HL, then doubles C:DE ready for the next bit. The
* multiplicand starts zero-extended from the caller's 16-bit HL (C is
* cleared); the caller's DE is clobbered and plays no part in the result.
* .
* The INC B/DJNZ pair works around SRL B destroying B as a loop counter:
* SRL shifts the next multiplier bit into carry, and INC undoes DJNZ's
* decrement so B ends the iteration holding exactly that shifted value:
* the loop exits as soon as it reaches 0, so a multiplier with few
* significant bits needs fewer doublings than a full 8 (an early exit,
* not a fixed-length loop).
* 
* I:A 8-bit unsigned multiplier
* I:HL 16-bit unsigned multiplicand
* O:A Bits 16-23 of the product
* O:HL Bits 0-15 of the product
multiply_16x8:                                             ; >1f86
       .ex_de_hl                                           ; EX DE,HL          ; DE = the multiplicand (the caller's HL)
       movb a,b                                            ; LD B,A            ; B = multiplier
       sb   a,a                                            ; XOR A             ; 
       movb a,h                                            ; LD H,A            ; 
       movb a,@l                                           ; LD L,A            ; Accumulator A:HL := 0
       movb a,@c                                           ; LD C,A            ; Multiplicand's high byte := 0 (zero-extend DE to 24 bits)
_1f8c:                                                     ; >1f8c
       srl  b,1                                            ; SRL B             ; Next multiplier bit -> carry
       jnc  _1f92                                          ; JR NC,$1F92       ; TODO: check code. Bit was 0 - skip the add
       a    de,hl                                          ; ADD HL,DE         ; Accumulator += multiplicand (low 16 bits)...
       ab   @c,a                                           ; ADC A,C           ; ...and the high byte, with carry
_1f92:                                                     ; >1f92
       ; SLA E                                             ; SLA E             ; TODO: check code. Double the multiplicand (24-bit: C:D:E)
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       ab   one,b                                          ; INC B             ; Undo DJNZ's decrement below
       sb   one,b                                          ; DJNZ $1F8C        ; Loop while a significant bit remains
       jne  _1f8c                                          ;                   
       rt                                                  ; RET               ; 

********************************************************************************
* Convert a sign-magnitude value to a sign-tagged logarithm
* 
* Used by the routines at #R$433F, #R$66DC and #R$8685.
* .
* Takes the top 9 bits of HL's 15-bit magnitude (HL >> 6) as an index
* into the word table at $0800-$0BFF, which holds log2(n) * 1024 for
* n = 0-511 (log2(1)=$0000, log2(2)=$0400, log2(4)=$0800 and so on). If HL was negative, sets bit 6 of the result's high byte to
* tag the sign. #R$2160 adds two such logs to multiply the values.
* 
* I:HL Value (sign-magnitude: bit 7 of H is the sign)
* O:HL Its logarithm, with bit 6 of H set if the value was negative
log_sign_tagged:                                           ; >1fcf
       czc  @bit7,h                                        ; BIT 7,H           ; test H's sign bit
       .ex_af_af_                                          ; EX AF,AF'         ; stash the sign flag in the shadow set
       movb h,a                                            ; LD A,H            ; A:L = HL
       srl  a,1                                            ; RRA               ; TODO: check code. shift A:L right...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...again...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...again...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...again...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...and a fifth time (A:L = HL >> 5)
       ; RR L                                              ; RR L              ; TODO: check code. 
       andi a,>0300                                        ; AND $03           ; A = one of 4 pages (0-3)
       szcb @bit0,@l                                       ; RES 0,L           ; L = an even byte offset within that page
       ab   @bytes+>08,a                                   ; ADD A,$08         ; A = $08 + page (one of $08-$0B)
       movb a,h                                            ; LD H,A            ; HL -> the table entry
       movb *hl,a                                          ; LD A,(HL)         ; read the entry (little-endian word)...
       ab   one,@l                                         ; INC L             ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; ...HL = the table entry
       .ex_af_af_                                          ; EX AF,AF'         ; restore the stashed sign flag
       jne  !                                              ; RET Z             ; HL was non-negative - return as-is
       rt                                                  ;                   
!
       socb @bit6,h                                        ; SET 6,H           ; else tag bit 6 of the result's high byte
       rt                                                  ; RET               ; 

********************************************************************************
* Convert a logarithm back to a value (antilog)
* 
* Used by the routine at #R$2160.
* .
* The inverse of #R$1FCF's log lookup: indexes the byte table at
* $0400-$07FF (an exponential curve, rising to 250 at the top) by
* HL >> 4, and returns the byte found there. Called by #R$2160 once it
* has added two logs, to turn the sum into the product.
* 
* I:HL Logarithm (as returned by #R$1FCF, or a sum of two)
* O:HL The corresponding value (0-255)
antilog:                                                   ; >1ff2
       movb h,a                                            ; LD A,H            ; A = HL's high byte
       srl  a,1                                            ; RRA               ; TODO: check code. shift A:L right...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...four times total...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. ...A:L now holds HL >> 4 (roughly)
       andi a,>0300                                        ; AND $03           ; keep the low 2 bits - one of 4 pages
       ab   @bytes+>04,a                                   ; ADD A,$04         ; page 4 + that index (table lives at $0400-$07FF)
       movb a,h                                            ; LD H,A            ; H = the page
       socb @bit0,@l                                       ; SET 0,L           ; force an odd byte offset within the page
       movb *hl,@l                                         ; LD L,(HL)         ; read the table byte
       sb   h,h                                            ; LD H,$00          ; zero-extend it into HL
       rt                                                  ; RET               ; 

********************************************************************************
* Multiply two vector components
* 
* Used by the routines at #R$439D, #R$4503, #R$4599 and #R$8E62.
* .
* Returns HL * DE / $4000, where 1.0 is $4000: the inputs are
* sign-magnitude, the result a two's complement number. A shift-and-add
* multiplication, looping once for each bit of HL's magnitude (its bit
* length, from the table at #R$0200: its high byte's plus 8, or at $2028,
* if the high byte is 0, its low byte's).
* 
* I:HL First (sign-magnitude)
* I:DE Second (sign-magnitude)
* O:HL Product (two's complement)
multiply_components:                                       ; >200a
       .proc
       movb h,a                                            ; LD A,H            ; 
       ; XOR D                                             ; XOR D             ; TODO: check code. the sign of the product
       .ex_af_af_                                          ; EX AF,AF'         ; save it in F'
       .push hl                                            ; PUSH HL           ; save the first number
       szcb @bit7,d                                        ; RES 7,D           ; DE = |second number|
       sb   a,a                                            ; XOR A             ; 
       li   iy,>0000                                       ; LD IY,$0000       ; 
       movb a,h                                            ; LD H,A            ; 
       movb a,@l                                           ; LD L,A            ; HL:IY = 0, the product
       movb a,b                                            ; LD B,A            ; 
       movb a,@c                                           ; LD C,A            ; BC:DE = |second number|, which is shifted left
       .exx                                                ; EXX               ; switch to the other set
       .pop bc                                             ; POP BC            ; BC = the first number
       movb @bytes+>02,h                                   ; LD H,$02          ; HL -> the bit-length table (#R$0200)
       movb b,a                                            ; LD A,B            ; 
       andi a,>7f00                                        ; AND $7F           ; A = |first number|'s high byte
       jeq  multiply_components_2                          ; JR Z,$2028        ; 0 - use the low byte's bit length
       movb a,@l                                           ; LD L,A            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; A = its bit length + 8
       jmp  _202a                                          ; JR $202A          ; 
multiply_components_2:                                     ; >2028
       movb @c,@l                                          ; LD L,C            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = the low byte's bit length
_202a:                                                     ; >202a
       movb a,@l                                           ; LD L,A            ; 
       movb b,a                                            ; LD A,B            ; A:C = |first number|
       movb @l,b                                           ; LD B,L            ; B = the number of bits
_202d:                                                     ; >202d
       srl  a,1                                            ; RRA               ; TODO: check code. shift the next bit out of the first number
       ; RR C                                              ; RR C              ; TODO: check code. 
       .exx                                                ; EXX               ; 
       jnc  _2037                                          ; JR NC,$2037       ; TODO: check code. 0 - don't add
       a    de,iy                                          ; ADD IY,DE         ; 1: add BC:DE to the product
       a    bc,hl                                          ; ADC HL,BC         ; 
_2037:                                                     ; >2037
       ; SLA E                                             ; SLA E             ; TODO: check code. shift BC:DE left
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       sla  b,1                                            ; RL B              ; TODO: check code. 
       .exx                                                ; EXX               ; 
       sb   one,b                                          ; DJNZ $202D        ; next bit
       jne  _202d                                          ;                   
       .exx                                                ; EXX               ; 
       movb iyh,a                                          ; LD A,IYH          ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; HL = the product / $4000
       .ex_af_af_                                          ; EX AF,AF'         ; the sign
       jlt  !                                              ; RET P             ; positive - done
       .endproc                                            ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Divide: 16-bit / 8-bit -> 16-bit, unsigned
* 
* Used by the routines at #R$1C5C, #R$265E, #R$281E, #R$4DAB, #R$4EEC, #R$4F37,
* #R$512F, #R$525F, #R$5D72, #R$5E6B, #R$6A59, #R$6AAD, #R$6BB3, #R$6BCA and
* #R$9BB2.
* .
* HL = HL/A via standard restoring division (16 iterations, shift-subtract-
* restore). Frequently paired with #R$1F60 (multiply then divide, i.e.
* scale a value by a fraction) - see e.g. #R$6A59/#R$6AAD/#R$6BB3/#R$6BCA's
* dashboard gauges.
* 
* I:HL Dividend
* I:A Divisor
* O:HL Quotient
divide_hl_a:                                               ; >2079
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; DE = the divisor
       movb @l,@c                                          ; LD C,L            ; 
       movb h,a                                            ; LD A,H            ; A:C = the dividend
       movb d,h                                            ; LD H,D            ; 
       movb d,@l                                           ; LD L,D            ; HL = 0, the remainder
       movb @bytes+>10,b                                   ; LD B,$10          ; 16 bits
_2082:                                                     ; >2082
       ; CCF                                               ; CCF               ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. shift the next quotient bit in (complemented)...
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; ...and the next dividend bit into the remainder
       s    de,hl                                          ; SBC HL,DE         ; subtract the divisor
       jnc  _208d                                          ; JR NC,$208D       ; TODO: check code. it fits
       a    de,hl                                          ; ADD HL,DE         ; it doesn't: add it back
_208d:                                                     ; >208d
       sb   one,b                                          ; DJNZ $2082        ; 
       jne  _2082                                          ;                   
       ; CCF                                               ; CCF               ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       movb @c,@l                                          ; LD L,C            ; 
       movb a,h                                            ; LD H,A            ; HL = the quotient
       rt                                                  ; RET               ; 

********************************************************************************
* Multiply two sign-tagged logarithms
* 
* Used by the routines at #R$4464, #R$47A1, #R$66DC and #R$86DC.
* .
* Adds two logs from #R$1FCF (or the log table at $0800) and converts the
* sum back with #R$1FF2, giving the product; the result is negated if
* exactly one of the two was tagged negative (bit 6 of the high byte).
* Returns 0 if the sum overflows 16 bits ($2172).
* 
* I:HL Sign-tagged log of the first value
* I:BC Sign-tagged log of the second value
* O:HL The signed product
multiply_logs:                                             ; >2160
       .proc
       movb h,a                                            ; LD A,H            ; 
       ; XOR B                                             ; XOR B             ; TODO: check code. bit 6 = product's sign
       ab   a,a                                            ; ADD A,A           ; move it to bit 7 (S flag)
       .ex_af_af_                                          ; EX AF,AF'         ; and save it
       a    bc,hl                                          ; ADD HL,BC         ; add the logs
       joc  overflow_case_return_0                         ; JR C,$2172        ; TODO: check code. overflow - return 0
       bl   @antilog                                       ; CALL $1FF2        ; HL = antilog
       .ex_af_af_                                          ; EX AF,AF'         ; 
       jlt  !                                              ; RET P             ; positive - done
       .endproc                                            ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       movb a,h                                            ; LD H,A            ; 
       .endproc                                            ; RET               ; 
overflow_case_return_0:                                    ; >2172
       li   hl,>0000                                       ; LD HL,$0000       ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Generate a random byte
* 
* Used by the routines at #R$13FD, #R$1703, #R$193F, #R$1DDC, #R$25B9, #R$26A9,
* #R$27DF, #R$281E, #R$2859, #R$28F6, #R$2A1C, #R$2A94, #R$2B05, #R$2C21,
* #R$2C3C, #R$2D3B, #R$3326, #R$3EAD, #R$50AA, #R$64F1, #R$656B, #R$6628,
* #R$6682, #R$6882, #R$707D, #R$894D, #R$8DB9, #R$8E51 and #R$8F25.
* .
* The game's random number generator: shifts and XORs the three bytes at
* $E936-$E938, returning one of them. Seeded from the R register at startup
* (#R$6F9F).
* 
* O:A A random byte
random_byte:                                               ; >2176
       movb @rng_state_3,a                                 ; LD A,($E938)      ; 
       movb a,@l                                           ; LD L,A            ; L = the third byte
       movb @rng_state_2,a                                 ; LD A,($E937)      ; 
       movb a,@rng_state_3                                 ; LD ($E938),A      ; the second byte moves into the third
       cb   a,@bytes+>80                                   ; CP $80            ; carry = its bit 7
       ; RL L                                              ; RL L              ; TODO: check code. shift L left, with that bit
       srl  a,1                                            ; RRA               ; TODO: check code. 
       movb @prng_state,a                                  ; LD A,($E936)      ; 
       movb a,@rng_state_2                                 ; LD ($E937),A      ; the first byte moves into the second
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; XOR L                                             ; XOR L             ; TODO: check code. 
       movb a,@prng_state                                  ; LD ($E936),A      ; the new first byte
       rt                                                  ; RET               ; 

********************************************************************************
* Convert a logarithm back to a value (16-bit antilog)
* 
* Used by the routines at #R$2191, #R$46CA, #R$47F0 and #R$84A6.
* .
* Returns 2^(HL/1024) from the antilog table at #R$0400, indexed by HL / 32
* - the full 16-bit version of #R$1FF2, which returns only the high byte.
* Returns $FFFF ($21C0) if HL is $4000 or more, i.e. the result wouldn't
* fit in 16 bits.
* 
* I:HL Logarithm (log2(n) * 1024)
* O:HL The value
antilog16:                                                 ; >21a3
       movb h,a                                            ; LD A,H            ; 
       czc  @bit6,a                                        ; BIT 6,A           ; HL >= $4000?
       jne  antilog16_overflow                             ; JR NZ,$21C0       ; too big - return $FFFF
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. A:L = HL / 16
       andi a,>0300                                        ; AND $03           ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; page $04-$07 of the antilog table
       movb a,h                                            ; LD H,A            ; 
       szcb @bit0,@l                                       ; RES 0,L           ; even offset (word entries)
       movb *hl,a                                          ; LD A,(HL)         ; 
       ab   one,@l                                         ; INC L             ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL = 2^(log / 1024)
       rt                                                  ; RET               ; 
antilog16_overflow:                                        ; >21c0
       li   hl,>ffff                                       ; LD HL,$FFFF       ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Look up the rotation coefficients for a turn rate
* 
* Used by the routines at #R$2209, #R$2212, #R$2365 and #R$23D9.
* .
* Copies the 6-byte record for turn rate |A| to DE: the cos and sin of
* |A| half-degrees from the table at #R$121B (|A| up to 40), or the
* 30-degree record at #R$2522 for |A| = 127. If A is negative, sets bit
* 7 of the copy's last byte (the top of the sin value), which makes
* #R$24A7 turn the other way. Used to set up the live roll and pitch
* tables (#R$2209, #R$2212) and objects' own turns (#R$2365, #R$23D9).
* 
* I:A Turn rate (-40 to 40, or -127/127)
* I:DE Where to copy the record
lookup_rotation_coeffs:                                    ; >21da
       socb a,a                                            ; OR A              ; 
       .push af                                            ; PUSH AF           ; save the sign
       jlt  !                                              ; JP P,$21E1        ; 
       b    @lookup_rotation_coeffs_abs                    ;                   
!
       neg a                                               ; NEG               ; A = |rate|
lookup_rotation_coeffs_abs:                                ; >21e1
       cb   a,@bytes+>7f                                   ; CP $7F            ; 127?
       jne  _21ea                                          ; JR NZ,$21EA       ; no - use the table
       li   hl,rotation_30_degrees                         ; LD HL,$2522       ; yes - use the 30-degree record
       jmp  _21f6                                          ; JR $21F6          ; 
_21ea:                                                     ; >21ea
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       movb h,b                                            ; LD B,H            ; 
       movb @l,@c                                          ; LD C,L            ; BC = |rate| * 2
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL = |rate| * 6
       li   bc,trig_table_fine                             ; LD BC,$121B       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> the record in the table
_21f6:                                                     ; >21f6
       .ldi                                                ; LDI               ; copy the 6-byte record to DE
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .pop af                                             ; POP AF            ; 
       jlt  !                                              ; RET P             ; rate positive - done
       rt                                                  ;                   
!
       dec  de                                             ; DEC DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; HL -> the copy's last byte
       socb @bit7,*hl                                      ; SET 7,(HL)        ; negative: set bit 7 to turn the other way
       rt                                                  ; RET               ; 

********************************************************************************
* Pitch the object by angle A
* 
* Used by the routines at #R$1C5C, #R$1E5A, #R$2758 and #R$2EB2.
* .
* Sets the nose vector to nose * cos + roof * sin, using the rotation
* record for angle A (#R$21DA) at #R$E7FC. The roof vector, which is the
* cross product of the nose and side vectors, is worked out first
* (#R$4599) and marked as needing working out again afterwards (bit 7 of
* #R$F7CD). Counts the rotation in #R$F7E8, so that #R$4503 can straighten
* the orientation every so often.
* 
* I:A The angle, in half-degrees (see #R$21DA)
pitch_object:                                              ; >2365
       .proc
       li   de,pitch_roll_rotation                         ; LD DE,$E7FC       ; set up the rotation record for angle A
       bl   @lookup_rotation_coeffs                        ; CALL $21DA        ; (#R$21DA)
       li   ix,pitch_roll_rotation                         ; LD IX,$E7FC       ; IX -> the rotation record
       bl   @work_out_roof                                 ; CALL $4599        ; make sure the roof vector is up to date (#R$4599)
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; it will need working out again
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; HL = roof.x
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.x * sin (#R$24A7)
       .push hl                                            ; PUSH HL           ; save it
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; HL = nose.x
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = nose.x * cos (#R$24D1)
       .pop de                                             ; POP DE            ; 
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = nose.x * cos + roof.x * sin
       jlt  !                                              ; JP P,$2393        ; positive - store it
       b    @pitch_object_nose_x                           ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
pitch_object_nose_x:                                       ; >2393
       mov  hl,@nose_vector                                ; LD ($F7DA),HL     ; store the new nose.x
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; HL = roof.y
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.y * sin
       .push hl                                            ; PUSH HL           ; 
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = nose.y
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = nose.y * cos
       .pop de                                             ; POP DE            ; 
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = nose.y * cos + roof.y * sin
       jlt  !                                              ; JP P,$23B2        ; positive - store it
       b    @pitch_object_nose_y                           ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
pitch_object_nose_y:                                       ; >23b2
       mov  hl,@nose_vector_y                              ; LD ($F7DC),HL     ; store the new nose.y
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; HL = roof.z
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.z * sin
       .push hl                                            ; PUSH HL           ; 
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; HL = nose.z
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = nose.z * cos
       .pop de                                             ; POP DE            ; 
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = nose.z * cos + roof.z * sin
       jlt  !                                              ; JP P,$23D1        ; positive - store it
       b    @pitch_object_nose_z                           ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
pitch_object_nose_z:                                       ; >23d1
       mov  hl,@nose_vector_z                              ; LD ($F7DE),HL     ; store the new nose.z
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       ab   one,*hl                                        ; INC (HL)          ; count the rotation
       .endproc                                            ; RET               ; 

********************************************************************************
* Roll the object by angle A
* 
* Used by the routines at #R$1C5C, #R$254C, #R$2758, #R$27B3 and #R$2EB2.
* .
* Sets the side vector to side * cos - roof * sin, using the rotation
* record for angle A (#R$21DA) at #R$E7FC. Otherwise the same as #R$2365.
* 
* I:A The angle, in half-degrees (see #R$21DA)
roll_object:                                               ; >23d9
       .proc
       li   de,pitch_roll_rotation                         ; LD DE,$E7FC       ; set up the rotation record for angle A
       bl   @lookup_rotation_coeffs                        ; CALL $21DA        ; (#R$21DA)
       li   ix,pitch_roll_rotation                         ; LD IX,$E7FC       ; IX -> the rotation record
       bl   @work_out_roof                                 ; CALL $4599        ; make sure the roof vector is up to date (#R$4599)
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       szcb @bit7,*hl                                      ; RES 7,(HL)        ; it will need working out again
       mov  @side_vector,hl                                ; LD HL,($F7D4)     ; HL = side.x
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = side.x * cos (#R$24D1)
       .push hl                                            ; PUSH HL           ; save it
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; HL = roof.x
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.x * sin (#R$24A7)
       .pop de                                             ; POP DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = side.x * cos - roof.x * sin
       jlt  !                                              ; JP P,$2408        ; positive - store it
       b    @roll_object_side_x                            ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
roll_object_side_x:                                        ; >2408
       mov  hl,@side_vector                                ; LD ($F7D4),HL     ; store the new side.x
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; HL = side.y
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = side.y * cos
       .push hl                                            ; PUSH HL           ; 
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; HL = roof.y
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.y * sin
       .pop de                                             ; POP DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = side.y * cos - roof.y * sin
       jlt  !                                              ; JP P,$2428        ; positive - store it
       b    @roll_object_side_y                            ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
roll_object_side_y:                                        ; >2428
       mov  hl,@side_vector_y                              ; LD ($F7D6),HL     ; store the new side.y
       mov  @side_vector_z,hl                              ; LD HL,($F7D8)     ; HL = side.z
       bl   @multiply_by_cos                               ; CALL $24D1        ; HL = side.z * cos
       .push hl                                            ; PUSH HL           ; 
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; HL = roof.z
       bl   @multiply_by_sin                               ; CALL $24A7        ; HL = roof.z * sin
       .pop de                                             ; POP DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = side.z * cos - roof.z * sin
       jlt  !                                              ; JP P,$2448        ; positive - store it
       b    @roll_object_side_z                            ;                   
!
       sb   a,a                                            ; XOR A             ; negative: HL = |HL|...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       socb @bit7,h                                        ; SET 7,H           ; ...in sign-magnitude form
roll_object_side_z:                                        ; >2448
       mov  hl,@side_vector_z                              ; LD ($F7D8),HL     ; store the new side.z
       li   hl,rotation_count                              ; LD HL,$F7E8       ; 
       ab   one,*hl                                        ; INC (HL)          ; count the rotation
       .endproc                                            ; RET               ; 

********************************************************************************
* Multiply by a rotation record's sine
* 
* Used by the routines at #R$221B, #R$22C0, #R$2365, #R$23D9 and #R$2450.
* .
* Returns HL * sin, where sin is the 24-bit value at IX+3 in a rotation
* record from #R$21DA (bits 0-22, with $400000 = 1), rounded to the
* nearest integer. The result's sign is the input's sign XOR bit 7 of
* IX+5, which #R$21DA sets for a negative turn rate - sin(-t) is -sin(t),
* whereas cos(-t) is cos(t), so #R$24D1 needs no such bit. The
* multiplication itself is shared with #R$24D1 (from $24F5).
* 
* I:HL Number (sign-magnitude, 15-bit magnitude)
* I:IX Pointer to the rotation record
* O:HL HL * sin, rounded (two's complement)
multiply_by_sin:                                           ; >24a7
       .proc
       movb @>05(ix),a                                     ; LD A,(IX+$05)     ; 
       ; XOR H                                             ; XOR H             ; TODO: check code. combine the sign of sin with the input's
       .ex_af_af_                                          ; EX AF,AF'         ; save the result's sign
       szcb @bit7,h                                        ; RES 7,H           ; H:L -> pure magnitude
       mov  hl,@multiply_trig_workspace                    ; LD ($E804),HL     ; 
       movb @>03(ix),a                                     ; LD A,(IX+$03)     ; low byte of sin
       bl   @multiply_16x8                                 ; CALL $1F86        ; magnitude * coeff0
       .push af                                            ; PUSH AF           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @multiply_trig_workspace,hl                    ; LD HL,($E804)     ; 
       movb @>04(ix),a                                     ; LD A,(IX+$04)     ; middle byte
       bl   @multiply_16x8                                 ; CALL $1F86        ; magnitude * coeff1
       .push af                                            ; PUSH AF           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @multiply_trig_workspace,hl                    ; LD HL,($E804)     ; 
       movb @>05(ix),a                                     ; LD A,(IX+$05)     ; top byte, without the sign bit
       andi a,>7f00                                        ; AND $7F           ; 
       bl   @multiply_16x8                                 ; CALL $1F86        ; magnitude * coeff2
       jmp  _24f5                                          ; JR $24F5          ; 

********************************************************************************
* Multiply by a rotation record's cosine
* 
* Used by the routines at #R$221B, #R$22C0, #R$2365, #R$23D9 and #R$2450.
* .
* Returns HL * cos, where cos is the 24-bit value at IX+0 in a rotation
* record from #R$21DA ($400000 = 1), rounded to the nearest integer, with
* the input's sign. Multiplies the magnitude by each of the value's three
* bytes (#R$1F86), adds the three products at their byte positions into
* IY:HL:A, and takes bits 22-37 of the total, rounding with bit 21 - i.e.
* round(magnitude * cos / 2^22), confirmed by emulation. Note that the
* input is sign-magnitude but the result is two's complement.
* 
* I:HL Number (sign-magnitude, 15-bit magnitude)
* I:IX Pointer to the rotation record
* O:HL HL * cos, rounded (two's complement)
multiply_by_cos:                                           ; >24d1
       .proc
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; 
       .ex_af_af_                                          ; EX AF,AF'         ; save the input's sign
       szcb @bit7,h                                        ; RES 7,H           ; H:L -> pure magnitude
       mov  hl,@multiply_trig_workspace                    ; LD ($E804),HL     ; 
       movb *ix,a                                          ; LD A,(IX+$00)     ; low byte of cos
       bl   @multiply_16x8                                 ; CALL $1F86        ; magnitude * coeff0
       .push af                                            ; PUSH AF           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @multiply_trig_workspace,hl                    ; LD HL,($E804)     ; 
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; middle byte
       bl   @multiply_16x8                                 ; CALL $1F86        ; magnitude * coeff1
       .push af                                            ; PUSH AF           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @multiply_trig_workspace,hl                    ; LD HL,($E804)     ; 
       movb @>02(ix),a                                     ; LD A,(IX+$02)     ; top byte
       bl   @multiply_16x8                                 ; CALL $1F86        ; magnitude * coeff2
* This entry point is used by the routine at #R$24A7.
_24f5:                                                     ; >24f5
       li   iy,>0000                                       ; LD IY,$0000       ; IY:HL:A accumulator := coeff2's product (the live A:HL)
       .pop bc                                             ; POP BC            ; BC = coeff1's product, low 16 bits
       .pop de                                             ; POP DE            ; DE = coeff1's product, high byte (D) + flags (discarded)
       movb b,@e                                           ; LD E,B            ; 
       movb @c,b                                           ; LD B,C            ; 
       sb   @c,@c                                          ; LD C,$00          ; Realign coeff1's 24-bit product 8 bits up (DE:BC = product1 << 8)...
       a    bc,iy                                          ; ADD IY,BC         ; 
       a    de,hl                                          ; ADC HL,DE         ; 
       ab   @c,a                                           ; ADC A,C           ; ...and add it in
       .pop bc                                             ; POP BC            ; BC = coeff0's product, low 16 bits
       .pop de                                             ; POP DE            ; DE = coeff0's product, high byte (D) + flags (discarded)
       movb d,@e                                           ; LD E,D            ; 
       sb   d,d                                            ; LD D,$00          ; Realign coeff0's product to its natural (unshifted) position...
       a    bc,iy                                          ; ADD IY,BC         ; 
       a    de,hl                                          ; ADC HL,DE         ; 
       ab   d,a                                            ; ADC A,D           ; ...and add it in too
       a    hl,hl                                          ; ADD HL,HL         ; Shift A:H:L left 2 bits (IY, the lowest 16 bits, is now
       sla  a,1                                            ; RLA               ; TODO: check code. spent - only its carry-out into HL mattered, for
       a    hl,hl                                          ; ADD HL,HL         ; rounding precision)...
       sla  a,1                                            ; RLA               ; TODO: check code. 
       ; RL L                                              ; RL L              ; TODO: check code. ...and one more bit into L, whose carry-out is the round-to-nearest bit tested below
       movb h,@l                                           ; LD L,H            ; Result := {A,H} (L is discarded - it only existed to
       movb a,h                                            ; LD H,A            ; capture that rounding bit)
       jnc  _2519                                          ; JR NC,$2519       ; TODO: check code. 
       inc  hl                                             ; INC HL            ; Round up if the dropped bit was set
_2519:                                                     ; >2519
       .ex_af_af_                                          ; EX AF,AF'         ; result negative?
       jlt  !                                              ; RET P             ; no - done
       .endproc                                            ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; yes - negate it (two's complement)
       .endproc                                            ; RET               ; 

********************************************************************************
* Rotation coefficients for a 30-degree turn
* 
* A 6-byte record in the same format as the table at #R$121B: cos 30
* degrees ($376CF5 / $400000 = 0.866) then sin 30 degrees ($200000 /
* $400000 = 0.5), as 24-bit values. #R$21DA uses it instead of the table
* for a turn rate of +/-127 ($7F), as used to spin the title screen's
* "ELITE" letters (#R$1E5A, #R$1E96).
rotation_30_degrees:                                       ; >2522
       byte >F5,>6C,>37                                              ; cos 30 degrees
       byte >00,>00,>20                                              ; sin 30 degrees

********************************************************************************
* Clear the object table
* 
* Used by the routines at #R$1703, #R$1E01, #R$894D, #R$8C94 and #R$8D2A.
* .
* Clears the object table (#R$EBA0: 20 slots of 40 bytes), the number of
* objects of each ship type (#R$E844), and the numbers of pirates and
* traders (#R$E939, #R$E93A).
clear_all_ship_slots:                                      ; >28d4
       .proc
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; the object table
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,planet_position                             ; LD DE,$EBA1       ; 
       li   bc,>031f                                       ; LD BC,$031F       ; 
       .ldir                                               ; LDIR              ; clear it
       li   hl,ship_type_counts                            ; LD HL,$E844       ; the number of objects of each ship type
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,ship_type_counts+>0001                      ; LD DE,$E845       ; 
       li   bc,>001f                                       ; LD BC,$001F       ; 
       .ldir                                               ; LDIR              ; clear them
       sb   a,a                                            ; XOR A             ; 
       movb a,@pirate_count                                ; LD ($E939),A      ; no pirates
       movb a,@trader_count                                ; LD ($E93A),A      ; no traders
       .endproc                                            ; RET               ; 

********************************************************************************
* Get a ship's blueprint
* 
* Used by the routines at #R$25B9, #R$3037, #R$3187 and #R$31AD.
* .
* Points IY at the blueprint for a ship type, from the table at #R$A7D7.
* 
* I:A Ship type
* O:IY The blueprint (see #R$A817 for the layout)
get_blueprint:                                             ; >2fe9
       cb   a,@bytes+29
       jhe  !
       seto @blueprints_1_bank_select                                          ; Select blueprints ROM bank 1
       jmp  !!
!
       seto @blueprints_2_bank_select                                          ; Select blueprints ROM bank 2
!
       ab   a,a                                            ; ADD A,A           ;
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; BC = ship type * 2
       li   hl,ship_blueprints                             ; LD HL,$A7D7       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> its entry in the blueprint table
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,b                                          ; LD B,(HL)         ; BC = the blueprint's address
       movb b,iyh                                          ; LD IYH,B          ; 
       movb @c,@iyl                                        ; LD IYL,C          ; IY = BC
       rt                                                  ; RET               ; 

********************************************************************************
* Find the missile aimed at an object
* 
* Used by the routines at #R$30EA and #R$46CA.
* .
* Looks through the object table (#R$EBA0) for a missile (ship type 2)
* whose target (byte $22 of its record, see #R$F7EF) is the object in
* slot C. Enemy missiles are checked too, though that byte isn't set for
* them (#R$2A3A).
* 
* I:C Slot number of the target
* O:F Z set if there is one
* O:IX Pointer to the missile's record
find_missile_at_object:                                    ; >3016
       li   ix,ship_object_table                           ; LD IX,$EBA0       ; IX -> the ship-object table
       li   de,>0028                                       ; LD DE,$0028       ; DE = 40, one slot's stride
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_301f:                                                     ; >301f
       movb *ix,r0                                         ; BIT 0,(IX+$00)    ; in use?
       andi r0,>0100                                       ;                   
       jeq  _3031                                          ; JR Z,$3031        ; no - skip it
       movb @>1a(ix),a                                     ; LD A,(IX+$1A)     ; A = ship type
       cb   a,@bytes+>02                                   ; CP $02            ; a missile?
       jne  _3031                                          ; JR NZ,$3031       ; not a missile
       movb @>22(ix),a                                     ; LD A,(IX+$22)     ; A = its target
       cb   a,@c                                           ; CP C              ; does it match the one we're looking for?
       jne  !                                              ; RET Z             ; aimed at this object
       rt                                                  ;                   
!
_3031:                                                     ; >3031
       a    de,ix                                          ; ADD IX,DE         ; next slot
       sb   one,b                                          ; DJNZ $301F        ; 
       jne  _301f                                          ;                   
       ab   one,b                                          ; INC B             ; none found: NZ
       rt                                                  ; RET               ; 

********************************************************************************
* Add an object to the object table
* 
* Used by the routines at #R$1703, #R$19FC, #R$1E01, #R$2A3A, #R$2A71, #R$2A94,
* #R$2B05, #R$2C3C, #R$2D3B, #R$2D7E, #R$3187, #R$8C94, #R$8D2A and #R$8DB9.
* .
* Copies the working object (#R$F7CD), whose ship type and handler type the
* caller has set up, into the first free slot of the 20-slot object table
* (#R$EBA0). On the way it gets its turn number (1-3, see #R$2542) from
* #R$E92F; its energy (#R$F7E9) from byte $0C of its blueprint (#R$2FE9);
* its speed (#R$F7E6) from byte $0D, unless the caller set it to 0; and its
* missiles (#R$F7EA) from bits 0-6 of byte $13. The counts of objects about
* are updated (#R$E844, #R$E93A, #R$E939).
* .
* At $3090, counts pirates (class 4) in #R$E939.
* .
* At $30A4, tries the next slot, returning with carry clear if there are no
* more.
* 
* O:F Carry set if it was added, clear if the table is full
add_object:                                                ; >3037
       .proc
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; 
       li   de,>0028                                       ; LD DE,$0028       ; 
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_303f:                                                     ; >303f
       movb *hl,r0                                         ; BIT 0,(HL)        ; in use?
       andi r0,>0100                                       ;                   
       jne  add_object_next_slot                           ; JR NZ,$30A4       ; yes - try the next
       .push hl                                            ; PUSH HL           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @next_turn_number,a                            ; LD A,($E92F)      ; A = the next turn number
       movb a,@turn_number                                 ; LD ($F7ED),A      ; give it to this object
       ab   one,a                                          ; INC A             ; 
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  _3052                                          ; JR NZ,$3052       ; 
       movb one,a                                          ; LD A,$01          ; (1-3)
_3052:                                                     ; >3052
       movb a,@next_turn_number                            ; LD ($E92F),A      ; 
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       bl   @get_blueprint                                 ; CALL $2FE9        ; IY -> the blueprint
       movb @>0c(iy),a                                     ; LD A,(IY+$0C)     ; 
       movb a,@object_energy                               ; LD ($F7E9),A      ; energy
       li   hl,object_speed                                ; LD HL,$F7E6       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _306c                                          ; JR Z,$306C        ; speed 0 - leave it
       movb @>0d(iy),a                                     ; LD A,(IY+$0D)     ; 
       movb a,*hl                                          ; LD (HL),A         ; speed
_306c:                                                     ; >306c
       movb @>13(iy),a                                     ; LD A,(IY+$13)     ; 
       andi a,>7f00                                        ; AND $7F           ; 
       movb a,@object_missiles                             ; LD ($F7EA),A      ; missiles
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       cb   a,@bytes+>20                                   ; CP $20            ; 
       jhe  _3098                                          ; JR NC,$3098       ; the planet or the sun - not counted
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,ship_type_counts                            ; LD HL,$E844       ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       ab   one,*hl                                        ; INC (HL)          ; one more of this ship type
       movb @>12(iy),a                                     ; LD A,(IY+$12)     ; 
       andi a,>1c00                                        ; AND $1C           ; A = class
       jne  add_object_count_pirates                       ; JR NZ,$3090       ; not a trader
       li   hl,trader_count                                ; LD HL,$E93A       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more trader
       jmp  _3098                                          ; JR $3098          ; 
add_object_count_pirates:                                  ; >3090
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  _3098                                          ; JR NZ,$3098       ; not a pirate
       li   hl,pirate_count                                ; LD HL,$E939       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more pirate
_3098:                                                     ; >3098
       .pop de                                             ; POP DE            ; 
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; 
       ; SCF                                               ; SCF               ; TODO: check code. 
       .pop hl                                             ; POP HL            ; 
       .endproc                                            ; RET               ; 
add_object_next_slot:                                      ; >30a4
       a    de,hl                                          ; ADD HL,DE         ; 
       sb   one,b                                          ; DJNZ $303F        ; 
       jne  _303f                                          ;                   
       socb a,a                                            ; OR A              ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* RST $00 target: print character A
* 
* Used by the routines at #R$0000 and #R$357A.
* .
* Copies the character's 8-byte pattern (from $099F + A * 8) to $E600,
* shifted right by the cursor's pixel offset (#R$E70E), and XORs it into
* the two character cells at the cursor (#R$E70F): the characters are 6
* pixels wide, so most straddle two 8-pixel cells. At $351C, moves on to
* the second cell, and then moves the cursor on 6 pixels (and the column,
* #R$E72C, on by one).
print_char:                                                ; >34a8
       .proc
       .push af                                            ; PUSH AF           ; save registers
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; 
       movb a,@l                                           ; LD L,A            ; HL = A (the character code)
       sb   h,h                                            ; LD H,$00          ; 
       a    hl,hl                                          ; ADD HL,HL         ; HL *= 8 (this char's offset into the font table)
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       li   bc,log_table+>019f                             ; LD BC,$099F       ; the font pattern table
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this character's 8-byte glyph
       li   de,scratch_buffer                              ; LD DE,$E600       ; DE -> the staging buffer
       li   bc,>0008                                       ; LD BC,$0008       ; 8 bytes
       .ldir                                               ; LDIR              ; copy the glyph in
       .ex_de_hl                                           ; EX DE,HL          ; HL -> just past the copied glyph ($E608)
       sb   *hl,*hl                                        ; LD (HL),$00       ; zero it...
       li   de,scratch_buffer_5+>0004                      ; LD DE,$E609       ; ...and the following 7 bytes too
       movb @bytes+>07,@c                                  ; LD C,$07          ; 
       .ldir                                               ; LDIR              ; ($E608-$E60F: the buffer's "spillover" half, initially all zero)
       movb @cursor_subpixel_offset,a                      ; LD A,($E70E)      ; A = the cursor's sub-pixel shift (0-7)
       socb a,a                                            ; OR A              ; 
       jeq  _34e5                                          ; JR Z,$34E5        ; no shift needed - the buffer's ready as-is
       movb a,b                                            ; LD B,A            ; B = the shift amount
       li   hl,scratch_buffer                              ; LD HL,$E600       ; HL -> the glyph half of the buffer
       li   de,scratch_buffer_5+>0003                      ; LD DE,$E608       ; DE -> the spillover half
       movb @bytes+>08,@c                                  ; LD C,$08          ; 8 rows
_34d7:                                                     ; >34d7
       .push bc                                            ; PUSH BC           ; 
       movb *de,a                                          ; LD A,(DE)         ; A = this row's spillover byte (0 to start)
_34d9:                                                     ; >34d9
       ; SRL (HL)                                          ; SRL (HL)          ; TODO: check code. shift the glyph byte right one bit...
       srl  a,1                                            ; RRA               ; TODO: check code. ...carrying the bit shifted out into A's top bit
       sb   one,b                                          ; DJNZ $34D9        ; repeat for the full shift amount
       jne  _34d9                                          ;                   
       movb a,*de                                          ; LD (DE),A         ; store what spilled over into the next byte
       inc  hl                                             ; INC HL            ; both halves -> next row
       inc  de                                             ; INC DE            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,@c                                         ; DEC C             ; 
       jne  _34d7                                          ; JR NZ,$34D7       ; next row
_34e5:                                                     ; >34e5
       mov  @cursor_vram_addr,de                           ; LD DE,($E70F)     ; DE -> this cell's row-0 pattern-table byte
       li   hl,scratch_buffer                              ; LD HL,$E600       ; HL -> the buffer's glyph (left-tile) half
       movb @bytes+>02,@c                                  ; LD C,$02          ; two tile columns to plot: this cell, then the next
_34ee:                                                     ; >34ee
       .push de                                            ; PUSH DE           ; stash this tile's base VRAM address
       movb @bytes+>08,b                                   ; LD B,$08          ; 8 rows
_34f1:                                                     ; >34f1
       limi 0                                              ; DI                ; VDP address/data access must not be interrupted
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb d,a                                            ; LD A,D            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, read mode
       .push hl                                            ; PUSH HL           ; (timing delay - let the VDP latch the address)
       .pop hl                                             ; POP HL            ; 
       movb @vdprd,a                                       ; IN A,($98)        ; A = the current pattern byte at that address
       ; XOR (HL)                                          ; XOR (HL)          ; TODO: check code. combine with this row's buffer byte
       inc  hl                                             ; INC HL            ; buffer -> next row
       .ex_af_af_                                          ; EX AF,AF'         ; stash the combined byte
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; re-issue the address, low byte
       movb d,a                                            ; LD A,D            ; 
       socb @bytes+>40,a                                   ; OR $40            ; ...high byte, this time in write mode
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       .ex_af_af_                                          ; EX AF,AF'         ; recover the combined byte
       movb a,@vdpwd                                       ; OUT ($98),A       ; write it back (an XOR-plot, not an overwrite)
       ; EI                                                ; EI                ; TODO: check code. 
       sb   one,b                                          ; DEC B             ; one row done
       jeq  continue_34a8_advance_cursor                   ; JR Z,$351C        ; all 8 rows plotted - go advance the cursor
       ab   one,@e                                         ; INC E             ; VRAM address -> next row of this pattern
       movb @e,a                                           ; LD A,E            ; 
       andi a,>0700                                        ; AND $07           ; crossed an 8-byte pattern-table boundary?
       jne  _351a                                          ; JR NZ,$351A       ; no - carry on
       movb @e,a                                           ; LD A,E            ; 
       sb   one,a                                          ; DEC A             ; undo the wrap...
       andi a,>f800                                        ; AND $F8           ; ...and snap back to this boundary's start
       movb a,@e                                           ; LD E,A            ; 
       ab   one,d                                          ; INC D             ; move into the pattern table's next bank
_351a:                                                     ; >351a
       jmp  _34f1                                          ; JR $34F1          ; plot the next row
continue_34a8_advance_cursor:                              ; >351c
       .pop de                                             ; POP DE            ; recover this tile's base VRAM address
       movb @e,a                                           ; LD A,E            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; E += 8: the next cell's row-0 pattern byte
       movb a,@e                                           ; LD E,A            ; 
       sb   one,@c                                         ; DEC C             ; one tile done
       jne  _34ee                                          ; JR NZ,$34EE       ; plot the second tile (the buffer's spillover half)
       movb @cursor_subpixel_offset,a                      ; LD A,($E70E)      ; A = the cursor's sub-pixel shift
       cb   a,@bytes+>02                                   ; CP $02            ; shifted by 2 or more?
       jl   _3534                                          ; JR C,$3534        ; no - stay in the same screen column
       mov  @cursor_vram_addr,hl                           ; LD HL,($E70F)     ; yes - advance to the next screen column's pattern address
       movb @bytes+>08,@c                                  ; LD C,$08          ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       mov  hl,@cursor_vram_addr                           ; LD ($E70F),HL     ; 
_3534:                                                     ; >3534
       ab   @bytes+>06,a                                   ; ADD A,$06         ; advance the sub-pixel shift by the font's 6px width
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jl   _353c                                          ; JR C,$353C        ; still within 0-7 - done
       sb   @bytes+>08,a                                   ; SUB $08           ; wrap back into 0-7
_353c:                                                     ; >353c
       movb a,@cursor_subpixel_offset                      ; LD ($E70E),A      ; store the updated sub-pixel shift
       li   hl,cursor_column                               ; LD HL,$E72C       ; the on-screen column counter (see #R$3564)
       ab   one,*hl                                        ; INC (HL)          ; 
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Set the text cursor to column B, row C
* 
* Used by the routines at #R$3596, #R$3955, #R$5AF8, #R$5B4D, #R$5BBD, #R$5C8E,
* #R$5DBB, #R$60E3, #R$612D, #R$6164, #R$6276, #R$9120, #R$9A4B and #R$A30A.
* .
* Text is printed in 6-pixel-wide characters. Sets the cursor's address in the
* pattern table (#R$E70F) to that of the character cell containing pixel B * 6
* of row C, and its pixel within the cell (#R$E70E) to the rest; also sets the
* column (#R$E72C) and clears #R$E70D.
* 
* I:B Column
* I:C Row
set_cursor_position:                                       ; >3548
       .push hl                                            ; PUSH HL           ; 
       movb @c,h                                           ; LD H,C            ; H = the row
       movb b,a                                            ; LD A,B            ; 
       movb a,@cursor_column                               ; LD ($E72C),A      ; the column
       ab   a,a                                            ; ADD A,A           ; 
       ab   b,a                                            ; ADD A,B           ; 
       ab   a,a                                            ; ADD A,A           ; A = column * 6
       .push af                                            ; PUSH AF           ; 
       andi a,>f800                                        ; AND $F8           ; 
       movb a,@l                                           ; LD L,A            ; L = 8 * the character cell it's in
       mov  hl,@cursor_vram_addr                           ; LD ($E70F),HL     ; set the address in the pattern table
       .pop af                                             ; POP AF            ; 
       andi a,>0700                                        ; AND $07           ; 
       movb a,@cursor_subpixel_offset                      ; LD ($E70E),A      ; the pixel within the cell
       sb   a,a                                            ; XOR A             ; 
       movb a,@unused_counter_e70d                         ; LD ($E70D),A      ; 
       .pop hl                                             ; POP HL            ; 
       rt                                                  ; RET               ; 

********************************************************************************
* RST $08 target: print a tokenised string at HL
* [text]
* 
* Used by the routines at #R$0008, #R$1651 and #R$40DE.
* .
* Reads bytes from HL until a 0 byte ends the string. Each byte has its
* top bit (the tokenised-text terminator convention noted elsewhere -
* e.g. #R$39C8) stripped and, if the result is nonzero, is expanded via
* #R$34A8 (RST $00); the original byte's top bit being set ends the
* string after this character.
rst_08_target_print_tokenised_string:                      ; >357a
       .proc
rst_08_target_print_tokenised_string_jmp:
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; 0 - the end
       .endproc                                            ;                   
!
       andi a,>7f00                                        ; AND $7F           ; 
       jeq  !                                              ; CALL NZ,$34A8     ; print the character (#R$34A8)
       bl   @print_char                                    ;                   
!
       movb *hl,r0                                         ; BIT 7,(HL)        ; bit 7 set?
       andi r0,>8000                                       ;                   
       jeq  !                                              ; RET NZ            ; yes - that was the last character
       .endproc                                            ;                   
!
       inc  hl                                             ; INC HL            ; 
       jmp  rst_08_target_print_tokenised_string_jmp       ; JR $357A          ; 

********************************************************************************
* Fill BC bytes of VRAM with a fixed byte
* 
* Used by the routine at #R$3955.
* .
* Writes E to the VDP data port BC times in a row. The caller must point the
* VDP at the target VRAM address (via port $99) before calling; each write
* auto-increments that address.
* 
* I:E Fill byte
* I:BC Number of bytes to write
fill_vram_bytes:                                           ; >35a4
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       dec  bc                                             ; DEC BC            ; 
       movb b,a                                            ; LD A,B            ; 
       socb @c,a                                           ; OR C              ; 
       jne  fill_vram_bytes                                ; JR NZ,$35A4       ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Fill a rectangular block of a screen-2 table with one byte
* 
* Used by the routines at #R$36F1, #R$3955, #R$50CE, #R$60CA, #R$6ADC, #R$6B12,
* #R$6CA8 and #R$72C1.
* .
* Fills a C-character-wide, (B/8)-row-tall rectangle of whichever VDP table
* HL points into (pattern or colour) with byte A - used to blank a
* text-window or dashboard area.
* .
* For each column, writes A to all 8 pixel-rows of one character (the VRAM
* address auto-increments across them); after the 8th byte, instead of
* carrying on into the next character along the row it drops to the same
* character position one name-table row further down (+256 bytes = +32
* characters) and continues. After B bytes like this (i.e. B/8 rows), it
* moves one character to the right (HL+8) and repeats for C columns.
* 
* I:A Fill byte
* I:HL VRAM address of the top-left character's first pixel-row byte
* I:B Height in pixel-rows (a multiple of 8)
* I:C Width in characters
fill_vram_rect:                                            ; >35b8
       limi 0                                              ; DI                ; 
       movb a,@e                                           ; LD E,A            ; Keep the fill byte in E; A is about to be reused for
       movb @bytes+>07,d                                   ; LD D,$07          ; address bytes. D = row-within-character wrap mask
_35bc:                                                     ; >35bc
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; Remember this column's start address
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; Point the VDP at this column
_35c6:                                                     ; >35c6
       movb @e,a                                           ; LD A,E            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; Write the fill byte
       ab   one,@l                                         ; INC L             ; 
       movb @l,a                                           ; LD A,L            ; 
       ; AND D                                             ; AND D             ; TODO: check code. 
       jne  _35db                                          ; JR NZ,$35DB       ; Still inside this character's 8 pixel-rows
       movb @l,a                                           ; LD A,L            ; 
       sb   one,a                                          ; DEC A             ; 
       andi a,>f800                                        ; AND $F8           ; Back to this character's row 0...
       movb a,@l                                           ; LD L,A            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ab   one,h                                          ; INC H             ; ...but one name-table row down (+256 = 32 characters)
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
_35db:                                                     ; >35db
       sb   one,b                                          ; DJNZ $35C6        ; 
       jne  _35c6                                          ;                   
       .pop hl                                             ; POP HL            ; 
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; Next character along the row
       movb a,@l                                           ; LD L,A            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,@c                                         ; DEC C             ; 
       jne  _35bc                                          ; JR NZ,$35BC       ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Busy-wait delay loop (~3*65536 iterations)
* 
* Used by the routine at #R$5FFB.
busy_wait_delay:                                           ; >3808
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 outer passes
_380a:                                                     ; >380a
       li   hl,>0000                                       ; LD HL,$0000       ; 
_380d:                                                     ; >380d
       dec  hl                                             ; DEC HL            ; count HL down from 0 (i.e. 65536 iterations)...
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; 
       jne  _380d                                          ; JR NZ,$380D       ; 
       sb   one,b                                          ; DJNZ $380A        ; ...3 times over
       jne  _380a                                          ;                   
       rt                                                  ; RET               ; 

********************************************************************************
* Write B bytes from (HL) to the VDP data port
* 
* Used by the routines at #R$4D8A, #R$6ADC and #R$6B12.
* .
* The caller must point the VDP at the target VRAM address (via port $99)
* first; each write auto-increments it. Unlike #R$35A4 this reads its
* fill data from memory rather than writing one fixed byte repeatedly.
* 
* I:HL Source address
* I:B Number of bytes to write
copy_to_vram:                                              ; >3830
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       sb   one,b                                          ; DJNZ $3830        ; 
       jne  copy_to_vram                                   ;                   
       rt                                                  ; RET               ; 

********************************************************************************
* Copy the space view to the screen
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C, #R$1E5A, #R$40DE, #R$6CB2
* and #R$894D.
* .
* Counts the message timer down, drawing any message into the space view
* first (#R$39F1). Then copies the space view's bitmap buffer (#R$D600) to
* the pattern table: character rows 1-16, columns 5-26 (176x128 pixels).
* Each character's 8 bytes are the same byte of 8 consecutive 32-byte rows
* of the buffer. Sets #R$EF9E while it's writing to VRAM.
copy_space_view:                                           ; >3846
       .proc
       bl   @count_message_timer                           ; CALL $39F1        ; count the message timer down
       li   de,>4120                                       ; LD DE,$4120       ; D = $41: VRAM $0128 for writing; E = 32
       movb @bytes+>d6,h                                   ; LD H,$D6          ; H = the buffer's first page
       movb @bytes+>98,@c                                  ; LD C,$98          ; C = the VDP data port
       movb @bytes+>10,a                                   ; LD A,$10          ; 16 character rows
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; writing to VRAM
_3855:                                                     ; >3855
       .ex_af_af_                                          ; EX AF,AF'         ; 
       limi 0                                              ; DI                ; 
       movb @bytes+>28,a                                   ; LD A,$28          ; VRAM address low byte: column 5
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb d,a                                            ; LD A,D            ; high byte: the character row
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ; EI                                                ; EI                ; TODO: check code. 
       sb   a,a                                            ; XOR A             ; start at byte 0 of the page
       movb @bytes+>c6,b                                   ; LD B,$C6          ; 22 characters (8 OUTIs and a DJNZ each)
_3862:                                                     ; >3862
       movb a,@l                                           ; LD L,A            ; row 0 of the character
       ; OUTI                                              ; OUTI              ; TODO: check code. 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@l                                           ; LD L,A            ; row 1
       ; OUTI                                              ; OUTI              ; TODO: check code. 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@l                                           ; LD L,A            ; row 2
       ; OUTI                                              ; OUTI              ; TODO: check code. 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@l                                           ; LD L,A            ; row 3
       ; OUTI                                              ; OUTI              ; TODO: check code. 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@l                                           ; LD L,A            ; row 4
       ; OUTI                                              ; OUTI              ; TODO: check code. 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@l                                           ; LD L,A            ; row 5
       ; OUTI                                              ; OUTI              ; TODO: check code. 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@l                                           ; LD L,A            ; row 6
       ; OUTI                                              ; OUTI              ; TODO: check code. 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@l                                           ; LD L,A            ; row 7
       ; OUTI                                              ; OUTI              ; TODO: check code. 
       ab   @e,a                                           ; ADD A,E           ; (back to row 0)
       ab   one,a                                          ; INC A             ; next byte along
       sb   one,b                                          ; DJNZ $3862        ; next character
       jne  _3862                                          ;                   
       ab   one,h                                          ; INC H             ; next page of the buffer
       ab   one,d                                          ; INC D             ; next character row
       .ex_af_af_                                          ; EX AF,AF'         ; 
       sb   one,a                                          ; DEC A             ; 
       jne  _3855                                          ; JR NZ,$3855       ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; done writing to VRAM
       .endproc                                            ; RET               ; 

********************************************************************************
* Clear the space view
* 
* Used by the routines at #R$13FD, #R$1703, #R$1C5C, #R$1E5A, #R$6CB2 and
* #R$894D.
* .
* Clears the space view's bitmap buffer (#R$D600) - the first 22 bytes
* (176 pixels) of each of its 128 rows - from the bottom up, 8 rows a
* pass, by pointing SP into the buffer and pushing zeros.
clear_space_view:                                          ; >388f
       .proc
       mov  sp,@clear_view_saved_sp                        ; LD ($E732),SP     ; save SP
       li   hl,tape_record_data+>0fe5                      ; LD HL,$E5F6       ; the end of the bottom row's 22 bytes, plus 1
       li   de,>0000                                       ; LD DE,$0000       ; 
       li   bc,>ffe0                                       ; LD BC,$FFE0       ; 32 bytes back: the row above
       movb @bytes+>10,a                                   ; LD A,$10          ; 16 passes of 8 rows
_389e:                                                     ; >389e
       mov  hl,sp                                          ; LD SP,HL          ; SP -> the end of the row
       .push de                                            ; PUSH DE           ; clear 22 bytes
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       a    bc,hl                                          ; ADD HL,BC         ; the row above
       mov  hl,sp                                          ; LD SP,HL          ; SP -> the end of the row
       .push de                                            ; PUSH DE           ; clear 22 bytes
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       a    bc,hl                                          ; ADD HL,BC         ; the row above
       mov  hl,sp                                          ; LD SP,HL          ; SP -> the end of the row
       .push de                                            ; PUSH DE           ; clear 22 bytes
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       a    bc,hl                                          ; ADD HL,BC         ; the row above
       mov  hl,sp                                          ; LD SP,HL          ; SP -> the end of the row
       .push de                                            ; PUSH DE           ; clear 22 bytes
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       a    bc,hl                                          ; ADD HL,BC         ; the row above
       mov  hl,sp                                          ; LD SP,HL          ; SP -> the end of the row
       .push de                                            ; PUSH DE           ; clear 22 bytes
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       a    bc,hl                                          ; ADD HL,BC         ; the row above
       mov  hl,sp                                          ; LD SP,HL          ; SP -> the end of the row
       .push de                                            ; PUSH DE           ; clear 22 bytes
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       a    bc,hl                                          ; ADD HL,BC         ; the row above
       mov  hl,sp                                          ; LD SP,HL          ; SP -> the end of the row
       .push de                                            ; PUSH DE           ; clear 22 bytes
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       a    bc,hl                                          ; ADD HL,BC         ; the row above
       mov  hl,sp                                          ; LD SP,HL          ; SP -> the end of the row
       .push de                                            ; PUSH DE           ; clear 22 bytes
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
       .push de                                            ; PUSH DE           ; 
