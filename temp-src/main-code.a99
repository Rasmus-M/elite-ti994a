********************************************************************************
* Sound effect table
* 
* The routines for sound effects 0-14, looked up by #R$7468. Each one
* starts with a `CALL $753F` that runs the effect's script.
sound_effect_table:                                        ; >7ac6
       data sound_effect_0                                           ; 0: click
       data sound_effect_1                                           ; 1
       data sound_effect_2                                           ; 2: explosion
       data sound_effect_3                                           ; 3: laser
