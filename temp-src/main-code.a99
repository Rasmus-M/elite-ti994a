********************************************************************************
* Equipment minimum tech levels
* 
* One byte per item of equipment, in the order of the Equip Ship list
* (#R$0FFC): the lowest tech level at which it's on sale. Fuel, Missiles
* and the Large Cargo Bay are always available, then one more item per
* tech level from 2 up, and the last three at 10. #R$5DBB counts the
* entries up to the system's tech level to decide how many items to
* list; the $FF at $116A ends the table.
equipment_tech_levels:                                     ; >115c
       byte >00,>00,>00,>02,>03,>04,>05,>06
       byte >07,>08,>09,>0A,>0A,>0A,>FF

********************************************************************************
* Equipment prices
* 
* One word per item of equipment, in the order of the Equip Ship list
* (#R$0FFC), in tenths of a credit. Fuel's entry is 0: #R$5DD9 shows the
* fuel price from ($E724) instead. Read by #R$5DD9, #R$5FAB and #R$6003.
equipment_prices:                                          ; >116b
       data >0000                                                    ; Fuel (priced per light year elsewhere): 0.0 Cr
       data >012C                                                    ; Missile: 30.0 Cr
       data >0FA0                                                    ; Large Cargo Bay: 400.0 Cr
       data >1770                                                    ; E.C.M. System: 600.0 Cr
       data >0FA0                                                    ; Pulse Laser: 400.0 Cr
       data >2710                                                    ; Beam Laser: 1000.0 Cr
       data >1482                                                    ; Fuel Scoops: 525.0 Cr
       data >2710                                                    ; Escape Capsule: 1000.0 Cr
       data >2328                                                    ; Energy Bomb: 900.0 Cr
       data >3A98                                                    ; Extra Energy Unit: 1500.0 Cr
       data >3A98                                                    ; Docking Computer: 1500.0 Cr
       data >C350                                                    ; Galactic Hyperdrive: 5000.0 Cr
       data >1f40                                                    ; Mining Laser: 800.0 Cr
       data >EA60                                                    ; Military Laser: 6000.0 Cr

********************************************************************************
* Pixel bit masks
* 
* $80, $40, ... $01: the mask for each pixel position within a byte.
* Copied to #R$E700 at startup (see #R$6F9F), where the line and pixel
* plotting routines use it.
pixel_bit_masks:                                           ; >1187
       byte >80,>40,>20,>10,>08,>04,>02,>01

