* ROM bank 8: the math tables, and code: the data on system screen and the galactic chart
* Assembled for real by code-bank-8.a99, and DORG in the other builds for its labels
       .ifdef code_bank_8
       aorg >6000
       .else
       dorg >6000
       .endif
       bss  >40
       .ifdef code_bank_8
       bcopy "../../bin/math-tables.bin" ; the math tables, as in the other banks
       .else
       bss  math_tables_end-math_tables
       .endif

* The data on system screen, with its own data and the system description
* generator ("goatsoup")

