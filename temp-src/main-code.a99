scanner_saved_first:                                       ; >e75c
       data >0000

********************************************************************************
* Scanner: last saved-background record
* 
* The record #R$8380 saved last, so that the next one can be linked to it.
scanner_saved_last:                                        ; >e75e
       data >0000

********************************************************************************
* Scanner record being drawn: VRAM address low byte
* 
* Unpacked from the scanner queue by #R$8380; read as a word with
* #R$E761.
scanner_vram_addr:                                         ; >e760
       byte >00

********************************************************************************
* Scanner record being drawn: VRAM address high byte
* 
