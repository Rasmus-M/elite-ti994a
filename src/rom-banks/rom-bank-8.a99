********************************************************************************
* Data on System: "There's a mean, nasty, vicious ship out there!"
* 
* Printed by #R$6164 instead of the system's description when the Constrictor
* is in the system (mission state $16, #R$E93D). A list of (column, row,
* string) records ending with $FF (see #R$3596).
msg_mean_nasty_vicious_ship:                               ; >585d
       text >05,>0f,'There''s a mean, nasty, viciou',>f3          ; 
       text >05,>10,'ship out there',>a1                          ; 
       byte >FF                                                   ; 

********************************************************************************
* Data on System headings
* 
* Printed by #R$6164. A list of (column, row, string) records ending with $FF
* (see #R$3596).
data_on_system_headings:                                   ; >5953
       text >05,>03,'Distance',>ba                                ; 
       text >05,>05,'Economy',>ba                                 ; 
       text >05,>06,'Government',>ba                              ; 
       text >05,>07,'Tech. Level',>ba                             ; 
       text >05,>09,'Population',>ba                              ; 
       text >05,>0c,'Gross Productivity',>ba                      ; 
       text >05,>0d,'Average Radius',>ba                          ; 
       byte >FF                                                   ; 

********************************************************************************
* Data on System frame
* 
* Drawn by #R$6164. A list of (RST $28) rectangles ending with $FF (see
* #R$36F1).
data_on_system_frame:                                      ; >59b7
       byte >05,>01,>21,>01,>91                                   ; 
       byte >05,>03,>13,>0F,>21                                   ; 
       byte >0F,>03,>16,>01,>71                                   ; 
       byte >12,>05,>14,>03,>71                                   ; 
       byte >11,>09,>0C,>01,>71                                   ; 
       byte >05,>0A,>21,>01,>51                                   ; 
       byte >19,>0C,>0A,>02,>71                                   ; 
       byte >05,>0F,>21,>05,>D1                                   ; 
       byte >FF                                                   ; 

********************************************************************************
* Show the Data on System screen: the inhabitants
* 
* Used by the routine at #R$6164.
* .
* Part of #R$6189. Prints "(" and then, as BBC Elite does, "Human
* Colonial)" (#R$0E81) if bit 7 of the seed s2_lo (#R$F74F) is clear;
* otherwise a description of the inhabitants ($60F8).
* .
* At $60F8, as BBC Elite does, builds the species from up to four words,
* picked by bits of the seeds s2_hi (#R$F750), s1_hi (#R$F74E) and s0_hi
* (#R$F74C) from the lists at $0E91, $0EA9, $0ECF and $0EF6, and then
* prints the closing ")".
show_inhabitants:                                          ; >60e3
       .proc                                               ;                   ; 
       li   bc,>050a                                       ; LD BC,$050A       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       movb @bytes+>28,a                                   ; LD A,$28          ; '('
       bl   @print_char                                    ; RST $00           ; print it
       movb @system_s2_lo,a                                ; LD A,($F74F) / OR A; 
       jlt  build_object_description_words                 ; JP M,$60F8        ; bit 7 set - describe them
       li   hl,msg_human_colonial                          ; LD HL,$0E81       ; "Human Colonial)"
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       .endproc                                            ; RET               ; 
build_object_description_words:                            ; >60f8
       movb @system_s2_hi,a                                ; LD A,($F750)      ; 
       srl  a,2                                            ; RRA x 2           ; 
       andi a,>0700                                        ; AND $07           ; bits 2-4
       li   hl,msg_large                                   ; LD HL,$0E91       ; 
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print the first word
       movb @system_s2_hi,a                                ; POP AF / RRA x 3  ; 
       srl  a,5                                            ;                   ; 
       andi a,>0700                                        ; AND $07           ; bits 5-7
       li   hl,msg_green                                   ; LD HL,$0EA9       ; 
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print the second word
       movb @system_s1_hi,a                                ; LD A,($F74E)      ; 
       xor  @system_s0_hi,a                                ; LD HL,$F74C / XOR (HL); (TI: XOR of words - only the high byte is used)
       andi a,>0700                                        ; AND $07           ; bits 0-2
       .push af                                            ; PUSH AF           ; 
       li   hl,msg_slimy                                   ; LD HL,$0ECF       ; 
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print the third word
       movb @system_s2_hi,a                                ; LD A,($F750)      ; 
       andi a,>0300                                        ; AND $03           ; bits 0-1
       .pop bc                                             ; POP BC            ; 
       ab   b,a                                            ; ADD A,B           ; + the third word's number
       andi a,>0700                                        ; AND $07           ; 
       li   hl,msg_rodent                                  ; LD HL,$0EF6       ; 
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print the fourth word
       movb @bytes+>29,a                                   ; LD A,$29          ; ')'
       bl   @print_char                                    ; RST $00           ; print it
       .endproc                                            ; RET               ; 

********************************************************************************
* Key '7': Data on System
* 
* Reached via the key table at #R$419B. First checks for mission 1's events
* (states $11 and $13: #R$9190, #R$91AA). Then, unless the screen is
* already showing, selects the system nearest the cursor on a chart
* (#R$5314 on the galactic chart, #R$538B on the local chart) and shows the
* data on the selected system ($6189).
* .
* At $6189, for the selected system: hides the sprites, draws a frame, and
* prints its name (as #R$6066 does) and distance (#R$6141), then its data
* from #R$4C9B: economy (#R$F754, from the words at #R$0F75), government
* (#R$F753, #R$0FA7), tech level (#R$F755), population (tech level *
* economy / 2 + 20 + bits 3-5 of s1_lo, in billions) and species (#R$60E3),
* gross productivity ((government + 8)^2 * population / 4, in M CR) and
* average radius (s2_lo, in km). In mission state $16 (#R$E93D), adds
* "There's a mean, nasty, vicious ship out there!"; otherwise the system's
* description.
* .
* At $626D, adds the system's description (#R$9A4B). At $6270, marks the
* Data on System screen as showing (#R$E902 = 1).
key_data_on_system:                                        ; >6164
       .proc                                               ;                   ; 
* TI: the mission 1 checks (states $11 and $13, #R$9190, #R$91AA) aren't
* converted yet; neither can happen before the missions are.
       cb   @current_screen,one                            ; LD A,($E902) / CP $01; Data on System showing?
       jne  show_system_data_screen                        ; RET Z             ; yes - nothing to do
       .endproc                                            ;                   ; 
* TI: selecting the system nearest the cursor on a chart (#R$5314, #R$538B)
* isn't converted yet, as the charts aren't.
show_system_data_screen:                                   ; >6189
       bl   @hide_sprites_clear_page                       ; CALL $608C        ; hide sprites
       li   ix,data_on_system_frame                        ; LD IX,$59B7       ; 
       bl   @rst_28_target_draw_list_tile                  ; RST $28           ; draw a frame
       li   hl,data_on_system_headings                     ; LD HL,$5953       ; 
       bl   @rst_20_target_print_list_positioned           ; RST $20           ; print the Distance/Economy/.../Present System field list
       movb one,@cursor_vram_addr_row                      ; LD A,$01 / LD ($E710),A; text row 1
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       bl   @generate_system_name                          ; CALL $4CAF        ; generate and format its name
       sb   @bytes+>22,a                                   ; SUB $22           ; compute a centering column from the character count
       andi a,>ff00                                        ; NEG               ; 
       neg  a                                              ;                   ; 
       srl  a,1                                            ; SRL A             ; 
       bl   @set_cursor_position_combined                  ; CALL $3564        ; position the cursor there
       li   hl,msg_data                                    ; LD HL,$56F7       ; "Data on "
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       li   hl,text_buffer                                 ; LD HL,$E717       ; the generated name
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       li   bc,>0f03                                       ; LD BC,$0F03       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       bl   @distance_to_selected_system                   ; CALL $6141        ; compute the distance to it
       movb @l,@c                                          ; LD C,L            ; 
       movb h,@l                                           ; LD L,H            ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; control byte: pad to width 0, decimal-point handling
       bl   @rst_18_target_format_value_print              ; RST $18           ; format and print the distance
       li   hl,msg_light_years_5845                        ; LD HL,$5845       ; " Light Years"
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       li   bc,>1205                                       ; LD BC,$1205       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       li   de,msg_agricultural                            ; LD DE,$0F8D       ; the economy word-list, lower half
       movb @system_economy,a                              ; LD A,($F754)      ; A = the economy code
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jl   _61da                                          ; JR C,$61DA        ; below 4 - use the lower half
       sb   @bytes+>04,a                                   ; SUB $04           ; above - use the upper half instead
       li   de,msg_industrial                              ; LD DE,$0F9B       ; 
_61da:                                                     ; >61da
       li   hl,msg_poor_0f75                               ; LD HL,$0F75       ; the economy word-list, first word
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print it
       .ex_de_hl                                           ; EX DE,HL          ; 
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print the second word
       li   bc,>1206                                       ; LD BC,$1206       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       movb @system_government,a                           ; LD A,($F753)      ; A = the government code
       li   hl,msg_anarchy                                 ; LD HL,$0FA7       ; the government-name list
       bl   @rst_10_target_print_ath_tokenised             ; RST $10           ; print it
       li   bc,>1207                                       ; LD BC,$1207       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       movb @system_tech_level,@c                          ; LD A,($F755) / LD C,A; tech level
       sb   a,a                                            ; XOR A             ; 
       clr  hl                                             ; SBC HL,HL         ; 
       bl   @rst_18_target_format_value_print              ; RST $18           ; format and print it
       li   bc,>1109                                       ; LD BC,$1109       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       movb @system_tech_level,r1                          ; LD A,($F755) / LD E,A; population:
       srl  r1,8                                           ;                   ; 
       movb @system_economy,r0                             ; LD A,($F754) / LD D,A; 
       srl  r0,8                                           ;                   ; 
       mpy  r0,r1                                          ; CALL $1F51        ; tech level * economy (TI: MPY)
       andi r2,>00ff                                       ;                   ; (8 bits, as on the MSX)
       srl  r2,1                                           ; SRL A             ; / 2
       ai   r2,>14                                         ; ADD A,$14         ; + 20
       movb @system_s1_lo,r0                               ; LD A,($F74D)      ; 
       srl  r0,11                                          ; RRA x 3           ; 
       andi r0,>0007                                       ; AND $07           ; 
       a    r0,r2                                          ; ADD A,C           ; + bits 3-5 of s1_lo
       swpb r2                                             ;                   ; 
       movb r2,a                                           ;                   ; A = the population (8 bits, as on the MSX)
       .push af                                            ; PUSH AF           ; stash it (needed again below)
       movb a,@c                                           ; LD C,A            ; 
       clr  hl                                             ; SBC HL,HL         ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; control byte: pad to width 0, decimal-point handling
       bl   @rst_18_target_format_value_print              ; RST $18           ; print the population
       li   hl,msg_billion                                 ; LD HL,$56FF       ; " Billion"
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       bl   @show_inhabitants                              ; CALL $60E3        ; print the species
       li   bc,>190c                                       ; LD BC,$190C       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       movb @system_government,r1                          ; LD A,($F753)      ; productivity: (government + 8)^2...
       srl  r1,8                                           ;                   ; 
       ai   r1,8                                           ; ADD A,$08         ; 
       mpy  r1,r1                                          ; CALL $1F51        ; (TI: MPY)
       andi r2,>00ff                                       ; LD E,A            ; (8 bits, as on the MSX)
       .pop af                                             ; POP AF            ; the population
       movb a,r0                                           ;                   ; 
       srl  r0,8                                           ;                   ; 
       mpy  r2,r0                                          ; CALL $1F60        ; ...* population
       srl  r1,2                                           ; SRL H / RR L x 2  ; / 4
       swpb r1                                             ;                   ; 
       movb r1,@c                                          ; LD C,L            ; 
       swpb r1                                             ;                   ; 
       movb r1,@l                                          ; LD L,H            ; 
       sb   a,a                                            ; XOR A             ; 
       sb   h,h                                            ; LD H,A            ; 
       bl   @rst_18_target_format_value_print              ; RST $18           ; print the productivity
       li   hl,msg_m_cr                                    ; LD HL,$5707       ; " M CR"
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       li   bc,>190d                                       ; LD BC,$190D       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       movb @system_s1_hi,@c                               ; LD BC,($F74E)     ; radius: s2_lo:s1_hi
       movb @system_s2_lo,@l                               ; LD L,B            ; 
       sb   a,a                                            ; XOR A             ; 
       sb   h,h                                            ; LD H,A            ; 
       bl   @rst_18_target_format_value_print              ; RST $18           ; print the radius
       li   hl,msg_km                                      ; LD HL,$570C       ; " km"
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
       cb   @mission_state,@bytes+>16                      ; LD A,($E93D) / CP $16; the Constrictor is here?
       jne  show_system_data_2                             ; JR NZ,$626D       ; 
       li   hl,msg_mean_nasty_vicious_ship                 ; LD HL,$585D       ; 
       bl   @rst_20_target_print_list_positioned           ; RST $20           ; print "There's a mean, nasty, vicious ship out there!"
       jmp  _6270                                          ; JR $6270          ; 
show_system_data_2:                                        ; >626d
       bl   @show_system_description                       ; CALL $9A4B        ; the system's description
_6270:                                                     ; >6270
       movb one,@current_screen                            ; LD A,$01 / LD ($E902),A; Data on System is showing
       .endproc                                            ; RET               ; 

********************************************************************************
* Goatsoup: show the system's description
* 
* Used by the routine at #R$6164.
* .
* As BBC Elite does, generates the selected system's description (#R$E72B)
* from the goatsoup template at #R$A2EB (#R$9AB9) into the buffer at $E9D7,
* with its random choices seeded from the system's seeds (#R$EAD7, #R$EAD9,
* from #R$F74B-#R$F750). Then prints it from row 15, column 5, word-wrapped
* at 33 characters: at $9A9E, goes back from the 34th character to the last
* space, and (at $9AA6) prints the line up to there and moves on to the
* next row.
show_system_description:                                   ; >9a4b
       .proc                                               ;                   ; 
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       bl   @generate_system_name                          ; CALL $4CAF        ; generate its name-seed fields
       movb @system_s0_hi,r0                               ; LD HL,($F74B)     ; (TI: the seeds as words)
       movb @system_s0_lo,@r0lb                            ;                   ; 
       movb @system_s1_hi,r1                               ; LD DE,($F74D)     ; 
       movb @system_s1_lo,@r1lb                            ;                   ; 
       xor  r1,r0                                          ; XOR D / XOR E     ; 
       movb r0,@goatsoup_seed_word1+1                      ; LD ($EAD7),HL     ; the first seed word
       movb @r0lb,@goatsoup_seed_word1                     ;                   ; 
       movb @system_s2_hi,r1                               ; LD DE,($F74F)     ; 
       movb @system_s2_lo,@r1lb                            ;                   ; 
       xor  r1,r0                                          ; XOR D / XOR E     ; 
       movb r0,@goatsoup_seed_word2+1                      ; LD ($EAD9),HL     ; the second seed word
       movb @r0lb,@goatsoup_seed_word2                     ;                   ; 
       li   r1,shared_blit_or_goatsoup_buffer              ; LD HL,$E9D6 / LD (HL),$00; clear the buffer
       li   r2,>80                                         ; LD BC,$00FF / LDIR; (TI: 256 bytes, a word at a time)
_9a6e_clear:                                               
       clr  *r1+                                           ;                   ; 
       dec  r2                                             ;                   ; 
       jne  _9a6e_clear                                    ;                   ; 
       li   bc,>050f                                       ; LD BC,$050F       ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       li   ix,goatsoup_description_template_a2eb          ; LD IX,$A2EB       ; IX -> the goatsoup template
       li   iy,shared_blit_or_goatsoup_buffer+1            ; LD IY,$E9D7       ; IY -> the expanded-text buffer
       bl   @goatsoup_expand_one_byte                      ; CALL $9AB9        ; expand the whole template
       sb   *iy,*iy                                        ; LD (IY+$00),$00   ; null-terminate it
       li   de,shared_blit_or_goatsoup_buffer+1            ; LD DE,$E9D7       ; DE -> the start of the expanded text
_9a93:                                                     ; >9a93
       mov  de,hl                                          ; LD HL,$0021 / ADD HL,DE; look 33 columns ahead
       ai   hl,>21                                         ;                   ; 
       movb *hl,a                                          ; LD A,(HL) / OR A  ; ran off the end of the text?
       jne  _9a9e                                          ; JR NZ,$9A9E       ; no - find a place to wrap
       .ex_de_hl                                           ; EX DE,HL          ; yes - print the rest as one final line
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; 
       .endproc                                            ; RET               ; 
_9a9e:                                                     ; >9a9e
       cb   *hl,@bytes+>20                                 ; LD A,(HL) / CP $20; this character a space?
       jeq  _9aa6                                          ; JR Z,$9AA6        ; yes - split the line there
       dec  hl                                             ; DEC HL            ; no - look one character earlier
       jmp  _9a9e                                          ; JR $9A9E          ; 
_9aa6:                                                     ; >9aa6
       sb   *hl,*hl                                        ; LD (HL),$00       ; split the line there (temporarily)
       .push hl                                            ; PUSH HL           ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print this line
       movb @cursor_vram_addr_row,@c                       ; LD BC,($E710) / INC C; advance to the next row
       ab   one,@c                                         ;                   ; 
       movb @bytes+>05,b                                   ; LD B,$05          ; 
       bl   @set_cursor_position                           ; CALL $3548        ; position the cursor
       .pop de                                             ; POP DE            ; recover the split point
       inc  de                                             ; INC DE            ; DE -> the next line's start
       jmp  _9a93                                          ; JR $9A93          ; wrap the rest

********************************************************************************
* Goatsoup: expand one template byte from (IX) into (IY)
* 
* Used by the routines at #R$9A4B, #R$9B35, #R$9B43 and #R$9B7C.
* .
* $00 ends the expansion. $01-$1F dispatch through the #R$A2F2 word table
* to a control-code handler (#R$9B34's `JP (HL)` trampoline -
* #R$9B35/$9B43/$9B6E/$9B71/$9B77/$9B7C are the Ctrl-A..Ctrl-F handlers).
* $20 (space) and above fall to $9ADA.
* .
* At $9ADA, $20-$7F are literal characters, printed via $9B0A. $80 and
* above ($9A/$A5/$A6/etc in the word lists - see #R$9BCB) are symbol
* references: index (byte AND $7F) into a 6-byte-stride table at $A201 to
* get a new IX (a sub-template to recurse into), rolling a random choice
* among that symbol's alternatives via #R$9BB2 (which also advances the
* ship-name seed) if it returns nonzero. Either way recurses via #R$9AB9
* for the chosen sub-template, then continues expanding the outer template.
* .
* At $9B0A, collapses a run of spaces into one. If auto-capitalise
* (#R$EAD6) is armed and the previous character was a space following
* (elsewhere) a full stop, and this character is lowercase, clears its bit
* 5 to capitalise it.
goatsoup_expand_one_byte:                                  ; >9ab9
       .proc                                               ;                   ; (TI: recursive, so the stack is in RAM - see ram_stack)
_9ab9:                                                     
       movb *ix+,a                                         ; LD A,(IX+$00) / INC IX / OR A; A = the next template byte
       jeq  _9ab9_end                                      ; RET Z             ; end of template
       cb   a,@bytes+>20                                   ; CP $20            ; a control code (1-31)?
       jhe  goatsoup_expand_literal_or_symbol              ; JR NC,$9ADA       ; no
       clr  r1                                             ; ADD A,A / LD E,A / LD D,$00; 
       movb a,r1                                           ;                   ; 
       srl  r1,7                                           ;                   ; R1 = the code * 2
       movb @goatsoup_control_code_dispatch+1(r1),r0       ; LD HL,$A2F2 / ADD HL,DE / LD A,(HL) ...; R0 -> this control code's handler
       movb @goatsoup_control_code_dispatch(r1),@r0lb      ;                   ; 
       .push ix                                            ; PUSH IX           ; 
       bl   *r0                                            ; CALL $9B34        ; run it (TI: BL *R0 instead of the JP (HL) trampoline)
       .pop ix                                             ; POP IX            ; 
       jmp  _9ab9                                          ; JP $9AB9          ; expand the next byte
goatsoup_expand_literal_or_symbol:                         ; >9ada
       movb a,a                                            ; OR A              ; a literal character?
       jgt  goatsoup_print_literal_capitalise              ; JP P,$9B0A        ; yes - print it
       .push ix                                            ; PUSH IX           ; no - a symbol reference
       andi a,>7f00                                        ; AND $7F           ; the symbol's index
       clr  r1                                             ;                   ; 
       movb a,r1                                           ;                   ; 
       srl  r1,8                                           ;                   ; 
       mov  r1,r0                                          ;                   ; 
       sla  r1,1                                           ;                   ; 
       a    r0,r1                                          ;                   ; 
       sla  r1,1                                           ; ADD HL,HL ...     ; *6 (the symbol table's stride)
       ai   r1,goatsoup_symbols                            ; LD DE,$A201 / ADD HL,DE; 
       mov  r1,hl                                          ;                   ; HL -> this symbol's entry
       movb @1(hl),ix                                      ; LD A,(HL) / LD IXl,A ...; IX -> its default sub-template
       movb *hl,@ixl                                       ;                   ; 
       bl   @goatsoup_advance_seed_roll_0_51               ; CALL $9BB2        ; roll a random alternative (0-4)
       movb a,a                                            ; OR A              ; 
       jeq  _9b02                                          ; JR Z,$9B02        ; none rolled - use the default sub-template
       clr  r1                                             ; LD E,A / LD D,$00 ; 
       movb a,r1                                           ;                   ; 
       srl  r1,8                                           ;                   ; 
       a    r1,hl                                          ; ADD HL,DE         ; 
       movb @1(hl),r1                                      ; LD E,(HL)         ; that alternative's offset
       srl  r1,8                                           ;                   ; 
       a    r1,ix                                          ; ADD IX,DE         ; -> that alternative's sub-template
_9b02:                                                     ; >9b02
       bl   @goatsoup_expand_one_byte                      ; CALL $9AB9        ; recurse into the sub-template
       .pop ix                                             ; POP IX            ; restore the outer template
       jmp  _9ab9                                          ; JP $9AB9          ; continue expanding it
goatsoup_print_literal_capitalise:                         ; >9b0a
       cb   a,@bytes+>20                                   ; CP $20            ; a space?
       jne  _9b13                                          ; JR NZ,$9B13       ; no - print it as-is
       cb   a,@-1(iy)                                      ; CP (IY-$01)       ; yes - was the previous character a space too?
       jeq  _9ab9                                          ; JR Z,$9AB9        ; yes - collapse it
_9b13:                                                     ; >9b13
       movb @goatsoup_capitalize_flag,r0                   ; LD A,($EAD6) / OR A; the auto-capitalise flag
       jeq  _9b2c                                          ; JR Z,$9B2C        ; not armed - print as-is
       cb   @-1(iy),@bytes+>20                             ; LD A,(IY-$01) / CP $20; armed: was the previous character a space?
       jne  _9b2c                                          ; JR NZ,$9B2C       ; no - print as-is
       cb   a,@bytes+>61                                   ; CP $61            ; lowercase?
       jl   _9b2c                                          ; JR C,$9B2C        ; no - print as-is
       cb   a,@bytes+>7b                                   ; CP $7B            ; 
       jhe  _9b2c                                          ; JR NC,$9B2C       ; no - print as-is
       andi a,>df00                                        ; RES 5,C           ; yes - capitalise it
_9b2c:                                                     ; >9b2c
       movb a,*iy+                                         ; LD (IY+$00),C / INC IY; store the character
       jmp  _9ab9                                          ; JP $9AB9          ; expand the next byte
_9ab9_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Goatsoup Ctrl-A: expand $E717's contents into the output, plus a space
* 
* Reached only through the control-code handler table at #R$A2F2, indexed by
* the code doubled - not a literal CALL/JP. #R$E717 is the same buffer
* #R$4C9B/$4CB8 and the value-formatting helpers write generated
* names/numbers into, so this control code inserts whatever was most
* recently generated there into the goatsoup output.
line_editor_ctrl_a:                                        ; >9b35
       .proc                                               ;                   ; 
       li   ix,text_buffer                                 ; LD IX,$E717       ; IX -> the last-generated text
       bl   @goatsoup_expand_one_byte                      ; CALL $9AB9        ; expand it into the output
       movb @bytes+>20,*iy+                                ; LD (IY+$00),$20 / INC IY; append a space
       .endproc                                            ; RET               ; 

********************************************************************************
* Goatsoup control code 2: the system's name as an adjective
* 
* Reached via the table at #R$A2F2. Turns the system's name in #R$E717
* into an adjective, as BBC Elite does ("Lave" becomes "Lavian"): finds
* the end of the name, and adds "ian " (#R$A300) to it - replacing its
* last letter if that's a vowel (#R$A305) - and expands it into the
* description (#R$9AB9). Then generates the selected system's name
* (#R$E72B, #R$4CAF) into #R$E717 again.
goatsoup_adjective:                                        ; >9b43
       .proc                                               ;                   ; 
       li   de,text_buffer                                 ; LD DE,$E717       ; the system's name
_9b46:                                                     ; >9b46
       movb *de+,a                                         ; LD A,(DE) / OR A / INC DE; 
       jne  _9b46                                          ; JR Z,$9B4D        ; found the end
       dect de                                             ; DEC DE            ; DE -> the last letter
       movb *de,a                                          ; LD A,(DE)         ; 
       li   hl,vowels                                      ; LD HL,$A305       ; the vowels
       li   r1,5                                           ; LD BC,$0005       ; 
_9b55:                                                     
       cb   a,*hl+                                         ; CPIR              ; (TI: a loop) a vowel?
       jeq  goatsoup_adjective_2                           ; JR Z,$9B5A        ; yes - replace it
       dec  r1                                             ;                   ; 
       jne  _9b55                                          ;                   ; 
       inc  de                                             ; INC DE            ; no - add after it
goatsoup_adjective_2:                                      ; >9b5a
       li   hl,adjective_ending                            ; LD HL,$A300       ; "ian "
       li   bc,>0006                                       ; LD C,$06          ; "ian " and the terminator (and one more)
       .ldir                                               ; LDIR              ; add it
       li   ix,text_buffer                                 ; LD IX,$E717       ; expand the result
       bl   @goatsoup_expand_one_byte                      ; CALL $9AB9        ; expand the name into the description
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       bl   @generate_system_name                          ; JP $4CAF          ; generate its name again
       .endproc                                            ;                   ; 

********************************************************************************
* Goatsoup Ctrl-D: back up the output cursor by one character
* 
* Reached only via the same $A2F2 dispatch table as #R$9B35 (index 4) - not
* a literal CALL/JP.
line_editor_ctrl_d:                                        ; >9b6e
       dec  iy                                             ; DEC IY            ; back up the output cursor
       rt                                                  ; RET               ; 

********************************************************************************
* Goatsoup Ctrl-E: arm auto-capitalisation
* 
* Reached only via the same $A2F2 dispatch table as #R$9B35 (index 5) - not a
* literal CALL/JP. Never triggered in this capture.
line_editor_ctrl_e:                                        ; >9b71
       seto r0                                             ; LD A,$FF          ; 
       movb r0,@goatsoup_capitalize_flag                   ; LD ($EAD6),A      ; arm the auto-capitalise flag
       rt                                                  ; RET               ; 

********************************************************************************
* Goatsoup Ctrl-F: disarm auto-capitalisation
* 
* Reached only via the same $A2F2 dispatch table as #R$9B35 (index 6) - not
* a literal CALL/JP.
line_editor_ctrl_f:                                        ; >9b77
       sb   @goatsoup_capitalize_flag,@goatsoup_capitalize_flag; XOR A / LD ($EAD6),A; disarm the auto-capitalise flag
       rt                                                  ; RET               ; 

********************************************************************************
* Goatsoup Ctrl-C: generate and insert a random ship name
* 
* Reached only via the same $A2F2 dispatch table as #R$9B35 (index 3) - not a
* literal CALL/JP. Never triggered in this capture. Advances rotating_
* accumulator from the two seed words #R$9A4B derived (#R$EAD7/$EAD9,
* XORed together into #R$E904/$E906/$E908), then generates 4 more
* name-seed bytes (#R$4CE7) and expands them into a name via #R$4CB8 -
* the same machinery #R$4C9B/#R$4CE7 use for system names - before
* expanding the result into the output (#R$9AB9) and appending a space.
line_editor_ctrl_c:                                        ; >9b7c
       .proc                                               ;                   ; 
       movb @goatsoup_seed_word1+1,r0                      ; LD HL,($EAD7)     ; combine the two seed words...
       movb @goatsoup_seed_word1,@r0lb                     ;                   ; 
       movb r0,@system_seeds+1                             ; LD ($E904),HL     ; 
       movb @r0lb,@system_seeds                            ;                   ; 
       movb @goatsoup_seed_word2+1,r1                      ; LD HL,($EAD9)     ; 
       movb @goatsoup_seed_word2,@r1lb                     ;                   ; 
       movb r1,@seed_s1+1                                  ; LD ($E906),HL     ; 
       movb @r1lb,@seed_s1                                 ;                   ; 
       xor  r0,r1                                          ; XOR D / XOR E     ; 
       movb r1,@seed_s2+1                                  ; LD ($E908),HL     ; ...into rotating_accumulator
       movb @r1lb,@seed_s2                                 ;                   ; 
       .push ix                                            ;                   ; (TI: system_name_from_seeds changes IX)
       li   ix,goatsoup_name_pairs                         ; LD IX,$EADB       ; 
       bl   @system_name_from_seeds                        ; CALL $4CE7        ; build 4 more name-seed bytes
       li   hl,goatsoup_name_pairs                         ; LD HL,$EADB       ; expand the name-seed digrams via $E717...
       bl   @expand_name                                   ; CALL $4CB8        ; 
       li   ix,text_buffer                                 ; LD IX,$E717       ; ...and expand the generated name into the output
       bl   @goatsoup_expand_one_byte                      ; CALL $9AB9        ; 
       .pop ix                                             ;                   ; 
       movb @bytes+>20,*iy+                                ; LD (IY+$00),$20 / INC IY; append a space
       movb @selected_system,a                             ; LD A,($E72B)      ; then overwrite $E717 with the selected system's
       bl   @generate_system_name                          ; JP $4CAF          ; name too, and return
       .endproc                                            ;                   ; 

********************************************************************************
* Goatsoup: advance the ship-name seed (Fibonacci-style), roll a 0-51 value
* 
* Used by the routine at #R$9AB9.
* .
* Advances the two seed words #R$9A4B set up (#R$EAD7/$EAD9) in a
* Fibonacci-like fashion (new second word = sum of both, old second
* word becomes the new first), then scales the high byte of the sum by
* 52/256 (#R$2079) to roll a value 0-51 - #R$9ADA's random-alternative
* selector for a symbol's weighted choices.
goatsoup_advance_seed_roll_0_51:                           ; >9bb2
       .proc                                               ;                   ; 
       .push hl                                            ; PUSH HL           ; 
       movb @goatsoup_seed_word2+1,r0                      ; LD HL,($EAD9)     ; R0 = the second seed word
       movb @goatsoup_seed_word2,@r0lb                     ;                   ; 
       movb @goatsoup_seed_word1+1,r1                      ; LD DE,($EAD7)     ; R1 = the first seed word
       movb @goatsoup_seed_word1,@r1lb                     ;                   ; 
       movb r0,@goatsoup_seed_word1+1                      ; LD ($EAD7),HL     ; the second word becomes the new first
       movb @r0lb,@goatsoup_seed_word1                     ;                   ; 
       a    r1,r0                                          ; ADD HL,DE         ; sum them
       movb r0,@goatsoup_seed_word2+1                      ; LD ($EAD9),HL     ; the sum becomes the new second word
       movb @r0lb,@goatsoup_seed_word2                     ;                   ; 
       andi r0,>00ff                                       ; LD H,$00          ; HL = the sum's low byte
       mov  r0,hl                                          ;                   ; 
       movb @bytes+>34,a                                   ; LD A,$34          ; 52
       bl   @divide_hl_a                                   ; CALL $2079        ; / 52
       movb @l,a                                           ; LD A,L            ; A = the rolled value, 0-4
       .pop hl                                             ; POP HL            ; 
       .endproc                                            ; RET               ; 

