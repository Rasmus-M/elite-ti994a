       byte >00                                                      ; $14: Boa Class Cruiser
       byte >00                                                      ; $15: Gecko
       byte >00                                                      ; $16: Moray Star Boat
       byte >00                                                      ; $17: Adder
       byte >00                                                      ; $18: Mamba
       byte >00                                                      ; $19: Asp MkII
       byte >00                                                      ; $1A: Sidewinder
       byte >00                                                      ; $1B: Wolf MkII
num_orbit_shuttles:                                        ; >e860
       byte >00                                                      ; $1C: Orbit Shuttle
num_transporters:                                          ; >e861
       byte >00                                                      ; $1D: Transporter
       byte >00                                                      ; $1E: Cougar
       byte >00                                                      ; $1F: Constrictor

********************************************************************************
* Delta X sign byte (cached, high byte of the delta X word)
* 
* High byte of the signed delta X word #R$2DF1 computes at #R$EB82,
* cached here before the word is negated in place - so this is the
* delta's original sign, independent of the later negation. Read back
* by #R$2EB2/#R$2F2F as one leg of their dot-product-style alignment
* reduction (#R$2E56). Within the same span #R$E7EA/#R$E844 describe -
* #R$28D4 clears it along with the rest.
cached_delta_x_sign:                                       ; >e864
       byte >00

********************************************************************************
* Delta Y sign byte (cached, high byte of the delta Y word)
* 
* Same role as #R$E864, for the delta Y word cached at #R$EB84.
cached_delta_y_sign:                                       ; >e865
       byte >00

********************************************************************************
* Delta Z sign byte (cached, high byte of the delta Z word)
* 
* Same role as #R$E864, for the delta Z word cached at #R$EB86. Also
* compared against orientation vector 2's own Z sign byte (#R$F7DF)
* by #R$2F2F to pick between #R$2F85 and a direct turn-rate step.
cached_delta_z_sign:                                       ; >e866
       byte >00

********************************************************************************
* Laser beams' target: x coordinate
* 
* Where the laser beams meet (#R$2DC8): picked at random near the middle
* of the view when the laser fires (#R$2AD0).
laser_target_x:                                            ; >e867
       byte >00

********************************************************************************
* Laser beams' target: y coordinate
* 
* See #R$E867.
laser_target_y:                                            ; >e868
       byte >00

********************************************************************************
* Something was destroyed
* 
* Set by #R$31AD whenever it destroys an object. #R$323C and #R$329E clear
* it before destroying objects, and play the explosion sound if it's set
* afterwards.
something_destroyed:                                       ; >e869
       byte >00

********************************************************************************
* Scaled delta magnitude/divisor (word)
* 
* The length #R$84A6 derives from the delta vector at #R$EB82 (via
* #R$2DF1), right-shifted by #R$EB9B bits (0 = no shift) - see #R$2DF1's
* own header. Consumed by #R$2E7B (signed_divide_24_by_16) as the
* unsigned 16-bit divisor.
scaled_delta_divisor:                                      ; >e86a
       byte >00,>00

********************************************************************************
* Steering: tolerance
* 
* Copied by #R$2EB2 from the table at #R$33C7, indexed by the depth's
* shift (#R$EB9B). If the dot product (#R$E86E) is smaller than this (at
* $2F0A and $2F8B), the object is pointing at the point closely enough.
steering_tolerance:                                        ; >e86c
       byte >00,>00

********************************************************************************
* Steering: dot product
* 
* The dot product of the object's side or roof vector with the direction
* to the point it is steering towards (#R$EB82), divided by the distance
* (#R$E86A) - i.e. the sine of the angle between that direction and the
* object's nose-roof or nose-side plane, with 1.0 = $4000. Stored by
* #R$2EB2 (via #R$2E7B) in sign-magnitude form: bit 7 of the high byte
* ($E86F) is the sign, which gives the direction to turn (at $2F1F, $2F74
* and $2FA5).
steering_dot_product:                                      ; >e86e
       data 0                                                        ; (TI: a big-endian word)
steering_dot_product_hi:
       equ  steering_dot_product

********************************************************************************
* Police launch timer
* 
* Frames until #R$315C launches the next Viper: 40 for the first (set
* by #R$2A1C), then 100 between launches.
police_launch_timer:                                       ; >e870
       byte >00

********************************************************************************
* Escort formation cursor
* 
* Points at the next record in the escort formation table (#R$343B) while
* #R$2C3C spawns escorts.
escort_table_cursor:                                       ; >e871
       byte >00,>00

********************************************************************************
* Laser shot used
* 
* Cleared by #R$2AD0 when the laser fires, and decremented by #R$291E
* when the shot hits something, so that one shot hits only one object
* (#R$28F6 checks it).
laser_shot_used:                                           ; >e873
       byte >00

********************************************************************************
* Per-type table entry cache (word)
* 
* #R$8685 copies the 2-byte table entry for the object's type from
* $0800+type*2 here (`LD DE,$E874 / LDI / LDI`); #R$86DC reads it back
* via #R$2160 to combine with each rotated vector component.
type_entry_cache:                                          ; >e874
       data 0                                                        ; (TI: a big-endian word)

********************************************************************************
* Last amount moved
* 
* How far the last object was moved past the player (#R$8B00); the
* space station, which follows the planet, is moved by the same amount
* (#R$8B00).
last_move:                                                 ; >e876
       byte >00,>00

********************************************************************************
* Torus jump speed
* 
* How far each object moves past the player per frame during a Torus
* jump: set to 200 by #R$86E6, less if the planet gets close (#R$8B00).
jump_speed:                                                ; >e878
       byte >00,>00

********************************************************************************
* Speed saved while the Torus Jump Drive is engaged
* 
* #R$86E6 (the Torus Jump Drive) saves the speed ($F814) here at
* $8700-$8703, and #R$8B8F brings the speed back up to it when the jump
* ends.
cached_f814_at_engage:                                     ; >e87a
       byte >00

********************************************************************************
* Stardust streak lengthening countdown
* 
* Decremented on each #R$872E call during a jump; on hitting 0, reloaded
* from #R$E87C and #R$E723 is increased.
stardust_passes_countdown:                                 ; >e87b
       byte >00

********************************************************************************
* Stardust streak lengthening interval
* 
* Reload value for #R$E87B: 10 for hyperspace (#R$894D), 5 for the
* in-system jump (#R$86E6).
stardust_passes_interval:                                  ; >e87c
       byte >00

********************************************************************************
* Call-scoped HL cache for $8BC7 / $8BF9 (word)
* 
* #R$8BC7 computes HL via #R$639C and caches it here once at $8BD4,
* then re-reads it at $8BE5 inside its own loop (across an
* intervening #R$63BA call that clobbers HL). If the sign test at
* $8BF0 comes back positive, control branches via `JP P,$8BF9`
* into the separately-declared routine at #R$8BF9 (used only by
* #R$8BC7), which re-reads the same cached HL once more at $8C09
* inside its own inner loop, across an intervening #R$21C4 call. So
* the cache's live range spans both routines, not just #R$8BC7's own
* loop.
call_scoped_hl_cache_word:                                 ; >e87d
       byte >00,>00

********************************************************************************
* Cached hyperspace jump fuel cost
* 
* Set by #R$8910 ('H') or forced to 0 by #R$8926 ('G'); deducted from
* the fuel level by #R$894D.
hyperspace_fuel_cost:                                      ; >e87f
       byte >00

********************************************************************************
* Hyperspace engage flash colour
* 
* Stepped by $10 each pass of #R$894D's engage loop, wrapping at $21.
hyperspace_flash_colour:                                   ; >e880
       byte >00

********************************************************************************
* Unused
* 
* Nothing in the game uses these bytes.
unused_e881:                                               ; >e881
       byte >00,>00,>00

********************************************************************************
* Title screen ship's wobble angles and targets
* 
* $E884 and $E885 are the two angles #R$1D3D turns the title screen ship
* by each frame (halved, via #R$2365 and #R$23D9); $E886 and $E887 are the
* targets #R$1DDC swings them towards.
title_wobble:                                              ; >e884
       byte >00                                                      ; 
title_wobble_angle_2:                                      ; >e885
       byte >00                                                      ; 
title_wobble_target_1:                                     ; >e886
       byte >00                                                      ; 
title_wobble_target_2:                                     ; >e887
       byte >00                                                      ; 

********************************************************************************
* Title screen ship's fly-in distance (word)
* 
* Set by #R$1C5C from the ship's size ((($F805) * 64) / 44); #R$1D3D
* moves the ship in until it's this far away.
title_ship_distance:                                       ; >e888
       byte >00,>00

********************************************************************************
* Title screen ship arrived flag
* 
* Cleared by #R$1C5C for each ship, and set by #R$1D3D once the ship has
* flown in to #R$E888.
title_ship_arrived:                                        ; >e88a
       byte >00

********************************************************************************
* Title screen ship's frame countdown
* 
* Set to 150 by #R$1C5C for each ship and counted down by #R$1D3D; when
* it reaches 0 the ship flies off (#R$E88C). Not counted for a mission
* briefing.
title_ship_frames:                                         ; >e88b
       byte >00

********************************************************************************
* Title screen ship flying-off flag
* 
* Set by #R$1D3D when #R$E88B runs out. #R$1C5C then moves the ship away
* by 200 each frame until it's out of sight (($EB9E) below 5), and shows
* the next ship.
title_ship_flying_off:                                     ; >e88c
       byte >00

********************************************************************************
* Unused
* 
* Nothing in the game uses this byte.
unused_e88d:                                               ; >e88d
       byte >00

********************************************************************************
* Title screen: slot of the letter being added (word)
* 
* Set by #R$1E01 (at $1E3D) to the object-table slot of the letter just
* added, so that #R$1E5A can move that letter differently from the rest.
title_letter_slot:                                         ; >e88e
       byte >00,>00

********************************************************************************
* Title screen: pointer to the next ship in the list (word)
* 
* Set by #R$1C5C to the start of #R$1F40 (or #R$1F4F for a mission
* briefing) and advanced past each ship as it's shown.
title_ship_ptr:                                            ; >e890
       byte >00,>00

********************************************************************************
* Title screen: letter-being-added flag
* 
* Set by #R$1E01 while it's adding the "ELITE" letters one by one, and
* cleared (#R$1E48) once all five are in.
title_letter_being_added:                                  ; >e892
       byte >00

********************************************************************************
* Unused
* 
* Nothing in the game uses this byte.
unused_e893:                                               ; >e893
       byte >00

********************************************************************************
* Sound channel: active
* 
* The context of the sound channel being processed runs from here to $E8A2. It
* is swapped in from the channel's record in #R$E8A3 (by #R$74AE and #R$7645)
* and back out again (by #R$7505 and #R$7645), so each field here is also a
* field in those records. This one is nonzero while the channel is playing.
sound_channel_active:                                      ; >e894
       byte >00

********************************************************************************
* Sound channel: tone register
* 
* The number of the first of the channel's two PSG tone period registers (see
* #R$74F6).
sound_channel_tone_register:                               ; >e895
       byte >00

********************************************************************************
* Sound channel: volume register
* 
* The number of the channel's PSG volume register (8-10), used by #R$748A and
* #R$74EC.
sound_channel_volume_register:                             ; >e896
       byte >00

********************************************************************************
* Sound channel: countdown
* 
* Counted down by #R$74A6, which continues at #R$740C when it runs out. The
* loop command (#R$769B) also uses this byte and the next one as the address
* of a loop table.
sound_channel_countdown:                                   ; >e897
       byte >00

********************************************************************************
* Sound channel: last data byte
* 
* The last byte written to the channel's volume register by #R$74EC (the PSG's
* registers can't be read back).
sound_channel_last_data:                                   ; >e898
       byte >00

********************************************************************************
* Sound channel: handler or data pointer
* 
* For a sound effect, the address of its per-frame handler, set by command 0
* (#R$7553) and called every tick by #R$7645 (at $766E). For music, the
* channel's position in the tune, read and advanced by #R$769B.
sound_channel_data_pointer:                                ; >e899
       byte >00                                                      ; 
sound_channel_handler_hi:                                  ; >e89a
       byte >00                                                      ; 

********************************************************************************
* Sound channel: parameter
* 
* Set by command 5 (#R$7582), and also used by #R$769B for a pending rest.
* Counted down or compared by many of the commands (see #R$78A7).
sound_channel_parameter:                                   ; >e89b
       byte >00

********************************************************************************
* Sound channel: duration
* 
* For music, the current note's duration countdown (#R$769B); for a sound
* effect, the address of its "playing" flag (set by #R$755E, cleared by
* #R$7438 or when the effect ends).
sound_channel_duration:                                    ; >e89c
       byte >00,>00

********************************************************************************
* Sound channel: second parameter
* 
* Set by command 6 (#R$7587), and used by #R$78A7.
sound_channel_parameter_2:                                 ; >e89e
       byte >00

********************************************************************************
* Sound channel: tone period
* 
* Set by command 2 (#R$756A), which also writes it to the PSG (#R$74F6). The
* per-frame handlers of many effects change it each frame to sweep the pitch;
* effect 4 (#R$7791) uses its low byte as a noise period instead.
sound_channel_position:                                    ; >e89f
       byte >00,>00

********************************************************************************
* Sound channel: envelope written
* 
* Set by command 9 (#R$758F) after it writes the PSG's envelope registers;
* when set, #R$740C clears it and writes the channel's volume register
* (#R$74EC).
sound_channel_envelope_flag:                               ; >e8a1
       byte >00

********************************************************************************
* Sound channel: don't take over
* 
* Set by command 11 (#R$75B0). #R$74AE won't take over a busy channel with
* this set for another effect.
sound_channel_keep:                                        ; >e8a2
       byte >00

********************************************************************************
* Sound channel records
* 
* One 15-byte record for each of the three sound channels, set up by
* #R$75CD (which clears them and gives each its tone and volume registers),
* #R$7603 (a tune) and #R$74AE (a sound effect). #R$7645 copies each active
* channel's record to #R$E894 to work on it and back again afterwards, and
* #R$74AE/#R$7505 do the same for the channel an effect is started on, so
* the fields are those at #R$E894-#R$E8A2:
* .
* #TABLE
* { =h Offset | =h Field }
* { $00 | Nonzero while the channel is playing (#R$E894) }
* { $01 | The first of its two PSG tone period registers (#R$E895) }
* { $02 | Its PSG volume register (#R$E896) }
* { $03-$04 | An effect's countdown (#R$E897); for a tune, the address of
* the channel's entry in its list of patterns (#R$7AEE) }
* { $05-$06 | The address of an effect's per-frame handler, or the
* channel's position in the tune (#R$E899) }
* { $07 | A parameter, or a pending rest (#R$E89B) }
* { $08-$09 | The current note's duration countdown, or the address of an
* effect's "playing" flag (#R$E89C) }
* { $0A | A second parameter (#R$E89E) }
* { $0B-$0C | The tone period (#R$E89F) }
* { $0D | Set once the envelope registers have been written (#R$E8A1) }
* { $0E | Set if another effect mustn't take the channel over (#R$E8A2) }
* TABLE#
sound_channel_records:                                     ; >e8a3
       byte >00                                                      ; channel 1: active
channel_1_tone_register:                                   ; >e8a4
       byte >00                                                      ; tone register
channel_1_volume_register:                                 ; >e8a5
       byte >00,>00,>00,>00,>00,>00,>00,>00,>00,>00,>00,>00,>00      ; volume register, then the rest
sound_channel_2_record:                                    ; >e8b2
       byte >00                                                      ; channel 2: active
channel_2_tone_register:                                   ; >e8b3
       byte >00                                                      ; tone register
channel_2_volume_register:                                 ; >e8b4
       byte >00,>00,>00,>00,>00,>00,>00,>00,>00,>00,>00,>00,>00      ; volume register, then the rest
sound_channel_3_record:                                    ; >e8c1
       byte >00                                                      ; channel 3: active
channel_3_tone_register:                                   ; >e8c2
       byte >00                                                      ; tone register
channel_3_volume_register:                                 ; >e8c3
       byte >00,>00,>00,>00,>00,>00,>00,>00,>00,>00,>00,>00,>00      ; volume register, then the rest

********************************************************************************
* Address of the tune being played
* 
* Set by #R$7603 to the address of the tune header (#R$7AE4), so that #R$7645
* can start the tune again when it ends. It is still 0 when the title music
* first starts, which is what lets #R$7645 restart a "tune" at $0000 (see
* #R$7603).
tune_address:                                              ; >e8d0
       byte >00,>00

********************************************************************************
* Number of the tune's channels still playing
* 
* Set by #R$7603 to the tune's number of channels, and decremented by
* #R$769B when a channel reaches the end of its list of patterns; when it
* gets to 0, #R$7645 starts the tune again.
tune_channels_playing:                                     ; >e8d2
       byte >00

********************************************************************************
* Address of the record of the channel being worked on (word)
* 
* Set by #R$74AE to the record (#R$E8A3) of the channel a sound effect is
* started on, so that #R$7505 can copy the channel's fields at #R$E894 back
* to it. In this snapshot it holds bytes written by the tune-restart bug
* (#R$7603).
active_channel_record:                                     ; >e8d3
       byte >00,>00

********************************************************************************
* Sound channel to take over next
* 
* Counts down 2, 1, 0, 2, ... each time #R$74AE has to take over a busy
* channel, choosing which one. In this snapshot it holds a byte written by
* the tune-restart bug (#R$7603).
sound_channel_rotation:                                    ; >e8d5
       byte >00

********************************************************************************
* Sound mode
* 
* 0 = no sound, 1 = music (#R$75B6), $FF = sound effects (#R$75C3); set
* by #R$75CD, and set to 0 by #R$7438.
sound_mode:                                                ; >e8d6
       byte >00

********************************************************************************
* Copy of PSG register 7 (the mixer)
* 
* The PSG's registers can't be read back, so #R$751D keeps a copy of what
* it writes to register 7 here, for #R$748A to change.
psg_mixer_copy:                                            ; >e8d7
       byte >00

********************************************************************************
* Unused flag
* 
* Set to $FF by #R$7645 on every tick, but nothing reads it.
unused_flag_e8d8:                                          ; >e8d8
       byte >00

********************************************************************************
* Unused
* 
* Nothing in the game uses these bytes.
unused_e8d9:                                               ; >e8d9
       byte >00,>00,>00

********************************************************************************
* Equipment-item-name text buffer [text]
* 
* Built one item at a time by the equipment-list display routine at
* $19A1 (indexed off the $F775 owned-equipment table): copies a name
* string from the #R$10A7 equipment-name list via #R$358D into this
* buffer (terminated by the string's usual high-bit-set last
* character), appends a fixed 5-byte suffix copied from $1BC3, then
* prints the whole thing via #R$39C8. The list's longest name is 16
* characters ("Docking Computer"/"Naval Energy Unt"), so the longest
* possible fill is 16+5=21 bytes - within this block's 23-byte extent
* with 2 bytes to spare. In this snapshot it holds bytes written by the
* tune-restart bug (#R$7603).
equipment_item_name_text_buffer_text:                      ; >e8dc
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00

********************************************************************************
* Info sub-page index for key-$84's handler at $1A8A [status]
* 
* Read at entry to pick which page to draw (0 = the in-game clock -
* see #R$F742's own description; 1 = commander info from $EB13/$EB14;
* 2+ indexes a jump table at $1C42). Incremented and wrapped 0-5 by
* #R$1A8A/#R$1A8A's own tail ($1B02: `INC (HL)` then reset to 0 once
* it reaches 6) each time the key is pressed again, cycling pages.
* In this snapshot it holds a byte written by the tune-restart bug
* (#R$7603).
info_sub_page_index_key84_handler:                         ; >e8f3
       byte >00

********************************************************************************
* Control bits
* 
* Built every VBlank by #R$7312 from the joysticks and keys: bit 0 up, 1
* down, 2 left, 3 right, 4 fire, each 0 while pressed. Read by #R$40A6
* for the flight controls, and by #R$73BA/#R$73CE to move the chart
* cursor (see #R$E708).
control_bits:                                              ; >e8f4
       byte >00

********************************************************************************
* Pending debounced keypress byte [status]
* 
* Holds the last debounced key code, with zero doing double duty as
* "no key pending yet." #R$35E7's key-wait primitive blocks on it
* (`HALT` loop until nonzero), then clears it and returns the value it
* just read as A - the actual key code #R$3631 and friends then act on
* (`CP $0D`/`CP $1B`/`CP $7F`, or store it as a typed character). Set
* by #R$349B's key-scan work (via #R$3465). #R$1EB3 also polls and
* clears it directly, discarding any pending key rather than waiting,
* if one arrived before the message finished displaying.
pending_debounced_keypress_byte_status:                    ; >e8f5
       byte >00

********************************************************************************
* Show the tunnel rings
* 
* Set by #R$1837 while it switches to the front view on launching, so
* that #R$645B shows the tunnel rings (#R$6CB2).
show_tunnel:                                               ; >e8f6
       byte >00

********************************************************************************
* Keyboard input buffer (11 bytes)
* 
* #R$3631 reads a line of keyboard input into here, one key at a time
* (#R$35E7), ending it with 0 when Enter is pressed. Used for a planet's name
* on the chart (#R$55A3), numbers (#R$5AC7), a laser's mount (#R$5F3F) and
* the commander's name (#R$A36B).
keyboard_input_buffer:                                     ; >e8f7
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00

********************************************************************************
* Current screen
* 
* 0 none (a space view), 1 Data on System (#R$6189), 2 market prices
* (#R$5B99), 3 status page (#R$6276), 4 galactic chart (#R$4D0B), 5
* cargo (#R$5C8E), 6 local chart (#R$4F64). #R$88AC checks it so that
* 'H' on a chart jumps to the system under the cursor.
current_screen:                                            ; >e902
       byte >00

********************************************************************************
* Space view showing
* 
* Set when one of the space views is showing (#R$63F1), with the
* dashboard, and cleared when another screen replaces it (#R$60B1). The
* main loop (#R$13FD) only draws the space view and the scanner while
* it's set, and the gauges are only drawn then (#R$6C9E).
space_view_showing:                                        ; >e903
       byte >00                                                      ; cleared by the startup code (#R$6F9F); the snapshot has $04

********************************************************************************
* System seeds
* 
* The three 16-bit seeds (s0, s1, s2) of the system being generated
* (#R$4C9B): starting from the galaxy's (#R$E711) and twisted four times
* (#R$5613) for each system after the first.
system_seeds:                                              ; >e904
       byte >00                                                      ; 
seed_s0_hi:                                                ; >e905
       byte >00                                                      ; 
seed_s1:                                                   ; >e906
       byte >00                                                      ; 
seed_s1_hi:                                                ; >e907
       byte >00                                                      ; 
seed_s2:                                                   ; >e908
       byte >00                                                      ; 
seed_s2_hi:                                                ; >e909
       byte >00                                                      ; 

********************************************************************************
* Docked
* 
* Set when the player docks (#R$1873) and at the start of a game
* (#R$1C5C), and cleared on launching (#R$707D) and in the death scene
* (#R$1703). While it's set the main loop (#R$0106) doesn't run the
* per-frame pass (#R$13FD), and keys like '1' and '2' (#R$4173,
* #R$417D) do their docked jobs; #R$6DCF and #R$6393 check it for the
* commands that only work in flight or only when docked.
docked:                                                    ; >e90a
       byte >00

********************************************************************************
* VBlank frame counter
* 
* Incremented by the RST $38 handler (#R$7202, see #R$0038's own
* header) on every VBlank interrupt - a second, simpler counter
* alongside #R$F748's sub-tick counter.
vblank_frame_counter:                                      ; >e90b
       byte >00

********************************************************************************
* Alert level
* 
* 0-2, set each frame by #R$15E7, and shown on the status page (#R$6276)
* as the condition: "Green", "Red" or "Red", in green or red - flashing
* (#R$72C1) while it's nonzero. At level 2 the alarm sounds (#R$7202).
alert_level:                                               ; >e90c
       byte >00

********************************************************************************
* Alert-flash countdown
* 
* #R$72C1 decrements this every VBlank; on hitting 0, resets it to $19
* (25) and, if the space view is showing (#R$E903) with bit 5 of #R$E914 set and
* ($F814)>=$1A, toggles ($E913) by XOR $30 and runs a status-hook call
* (#R$35B8, message/code $04:$03 from $31B3).
alert_flash_countdown:                                     ; >e90d
       byte >00

********************************************************************************
* VRAM flash-toggle state
* 
* XOR-flipped by #R$72C1 (`LD (HL),A` after `XOR $90`) and written out
* via a 64-byte OUT ($98) burst when ($E902)=3 and #R$E90C is nonzero -
* see #R$E90C's own description, which already names this mechanism.
vram_flash_toggle:                                         ; >e90e
       byte >00

********************************************************************************
* Equipment-effect operation-in-progress flag
* 
* #R$5524 sets this $FF at the start of a per-item loop gated on
* ($F775) (equipment-array slot 0) being fitted, and clears it to 0
* once the loop finishes. #R$3793 (at $3796) reads it to gate a VDP
* port-write path - same "don't touch this while busy" shape as
* #R$EF9E, for a different operation.
e90f_equip_op_flag:                                        ; >e90f
       byte >00

********************************************************************************
* Missile state
* 
* 0 unarmed, 1 armed ('T', #R$2D58), 2 locked on to a target (#R$4735,
* #R$E928). Fired with 'M' (#R$2D7E) when locked; 'U' (#R$2D70) cancels
* it. Shown by the missile indicator (#R$6B6E).
missile_state:                                             ; >e910
       byte >00

********************************************************************************
* Current object slot
* 
* The number of the object-table slot (#R$EBA0) whose object the main
* loop (#R$13FD) is processing.
current_slot:                                              ; >e911
       byte >00

********************************************************************************
* ECM countdown
* 
* Set to $78 (120) by the ECM sound effect (#R$7815) when the player's
* ECM or an enemy's is set off, and counted down on every VBlank by
* #R$7202, stopping at -1. While it's running the ECM is on (#R$323C) and
* the "E" indicator is shown (#R$6B12); #R$3294 clears it once it has
* finished.
ecm_countdown:                                             ; >e912
       byte >00

********************************************************************************
* Alert status-hook toggle
* 
* XOR $30'd by #R$72C1 when the alert-flash countdown (#R$E90D)
* expires under its gated conditions, then passed as E to #R$35B8
* (with HL=$31B3, BC=$0403) - see #R$E90D's description.
e913_status_toggle:                                        ; >e913
       byte >00

********************************************************************************
* Options
* 
* Set with keys while the game is frozen (#R$40DE):
* .
* #TABLE
* { =h Bit | =h Key | =h Effect when set }
* { 0 | S/Q | Sound effects on (#R$7468) }
* { 1 | D | Roll and pitch stop when the keys are released (#R$6BFE) }
* { 2 | R | Roll and pitch stop first when reversed (#R$6A15) }
* { 3 | B | Reverse roll and pitch (#R$40A6) }
* { 4 | Y | Reverse pitch (#R$40A6) }
* { 5 | F | The scanner's blips are drawn on alternate frames (#R$8205),
* and the speed indicator flashes above speed 26 (#R$72C1) }
* { 6 | M | Muted: 'S' and 'Q' have no effect }
* TABLE#
* .
* Saved in the commander file (#R$A551).
options:                                                   ; >e914
       byte >00

********************************************************************************
* Sound effect 4 playing flag
* 
* Set to $FF by sound effect 4's own script (command 1, #R$755E) while it
* plays, and cleared when it ends. #R$193F and #R$323C only start sound
* effect 4 when it isn't already playing.
sound_effect_4_playing:                                    ; >e915
       byte >00

********************************************************************************
* Alarm playing
* 
* The "playing" flag of sound effect 5, the alarm: its script sets it
* (command 1, #R$77AD) and it's cleared when the effect ends (#R$740C). At
* alert level 2 (#R$E90C), #R$7202 starts the alarm again whenever this is
* clear, so it sounds continuously.
alarm_playing:                                             ; >e916
       byte >00

********************************************************************************
* Docking
* 
* Set when the player docks with the space station: by #R$87DD when the
* ship flies into the slot, or by the docking computer (#R$1692). The
* main loop (#R$13FD) then completes the docking (#R$1873). Cleared by
* #R$707D on launching.
docking:                                                   ; >e917
       byte >00

********************************************************************************
* Torus Jump Drive countdown
* 
* Set to 25 by #R$86E6 when the jump drive is engaged, and counted down
* once per frame by #R$13FD, which ends the jump when it reaches 0. Also
* tested by #R$8B00.
torus_jump_countdown:                                      ; >e918
       byte >00

********************************************************************************
* Message timer
* 
* Started at $8A by #R$39C8 ($9E by #R$1A8A). While it's negative the
* message is drawn in the space view (#R$3A03), for 10 frames (or 30);
* then it's set to 25 and counts
* down to 0 (#R$39F1), during which #R$39E9 won't show another message.
message_timer:                                             ; >e919
       byte >00

********************************************************************************
* Hyperspace target-selected flag
* 
* #R$88AC aborts with "Select System" if clear; cleared by #R$894D
* once the jump fires.
hyperspace_target_selected:                                ; >e91a
       byte >00

********************************************************************************
* Hyperspace countdown, inner
* 
* Armed by #R$8910/#R$8926; ticked down by #R$7202's VBlank handler,
* which sets #R$E920 once this and #R$E91C both reach 0.
hyperspace_countdown_inner:                                ; >e91b
       byte >00

********************************************************************************
* Hyperspace countdown, outer
hyperspace_countdown_outer:                                ; >e91c
       byte >00

********************************************************************************
* Hyperspace countdown last shown
* 
* The number of seconds left (#R$E91B) that #R$1670 last showed on the
* message line; cleared when a countdown starts (#R$88AC, #R$8926).
countdown_shown:                                           ; >e91d
       byte >00

********************************************************************************
* VBlank-ISR-in-progress flag
* 
* #R$7202's own header already documents the mechanism fully: set to 1
* right after the ISR acknowledges the VDP interrupt, cleared to 0
* right before it restores registers and re-enables interrupts. Two
* sound-driver routines check it before their own `EI` to decide
* whether it's safe to re-enable interrupts mid-ISR rather than wait:
* #R$7505 (sound-context save) and #R$75CD (reset_sound_channels).
vblank_isr_progress_flag:                                  ; >e91e
       byte >00

********************************************************************************
* Unused flag
* 
* Cleared by #R$707D, but nothing has been found that reads it.
unused_flag_e91f:                                          ; >e91f
       byte >00

********************************************************************************
* Hyperspace engage trigger flag
* 
* Set by #R$7202 when the #R$E91B/#R$E91C countdown expires; gates
* and is cleared by #R$894D.
hyperspace_trigger:                                        ; >e920
       byte >00

********************************************************************************
* Radius of the tunnel ring being drawn
* 
* Set by #R$6CB2 for each ring it draws, and used by sound effect 7's handler
* (#R$77FB) to make the sound follow the rings.
tunnel_ring_radius:                                        ; >e921
       byte >00,>00

********************************************************************************
* Tunnel rings finished
* 
* Cleared by sound effect 7 (#R$77EE) and set by #R$6CB2 when it has finished
* drawing the rings, which ends the effect (#R$77FB).
tunnel_rings_finished:                                     ; >e923
       byte >00

********************************************************************************
* Load a new commander from the title screen
* 
* Set by #R$1DB5 when the player answers 'Y' to "Load New Commander";
* the commander menu (#R$A31D) then goes straight to option '1', and
* clears it.
load_new_commander:                                        ; >e924
       byte >00

********************************************************************************
* Galactic-jump flag
* 
* Set by #R$8926 ('G'), cleared by #R$8910 ('H'); read by #R$894D to
* decide whether to advance the galaxy seed/number.
galactic_jump_flag:                                        ; >e925
       byte >00

********************************************************************************
* Unused
* 
* Nothing in the game uses these bytes.
unused_e926:                                               ; >e926
       byte >00,>00

********************************************************************************
* Missile target
* 
* The slot number (#R$E911) of the object the player's missile is locked
* on to (#R$4735). #R$2D7E gives it to the missile when it's fired
* (#R$F7EF).
missile_target:                                            ; >e928
       byte >00

********************************************************************************
* Launch roll
* 
* Set on launching (#R$1837), when the ship starts rolling; while it's
* set, #R$6BE1 slows the roll down until it stops.
launch_roll:                                               ; >e929
       byte >00

********************************************************************************
* Unused flag
* 
* Set to 1 by the startup code (#R$6F9F), but nothing has been found that
* reads it.
unused_flag_e92a:                                          ; >e92a
       byte >01

********************************************************************************
* Redraw the speed gauge
* 
* While it's 0, #R$6A59 doesn't redraw the speed gauge. Cleared while the
* speed is changed in a loop (#R$8B7B, #R$8B8F), and set to $FF again
* afterwards (#R$8B8A, #R$8BA1) and at startup (#R$7045).
redraw_speed_gauge:                                        ; >e92b
       byte >FF

********************************************************************************
* Message row
* 
* The page of the space view's bitmap buffer that messages are drawn into
* (#R$3A03): $E4 for the bottom of the view (the usual), $D6 for the top
* (the title screen's ship names, #R$1C5C).
message_row:                                               ; >e92c
       byte >00

********************************************************************************
* A ship has fired
* 
* Set by #R$26A9 when a ship fires at the player, so the main loop draws
* its laser beam (#R$43C2); cleared each frame (#R$13FD).
ship_fired:                                                ; >e92d
       byte >00

********************************************************************************
* Whose turn it is
* 
* Cycled 3, 2, 1, 3... each frame by the main loop (#R$13FD). Some
* handler work is done only for objects whose turn number (#R$F7ED)
* matches (#R$2542), i.e. every third frame. Bit 0 also decides which
* frames the scanner's blips are drawn on with option 'F' (#R$8205).
current_turn:                                              ; >e92e
       byte >01

********************************************************************************
* Next turn number
* 
* The turn number (#R$F7ED) given to the next object added to the object
* table (#R$3037), which cycles it 1, 2, 3, 1...
next_turn_number:                                          ; >e92f
       byte >01

********************************************************************************
* Kills that brought no promotion
* 
* Counted by #R$331B; "Right On Commander" is shown each time it wraps
* round to 0.
kill_count:                                                ; >e930
       byte >00

********************************************************************************
* Keyboard debounce column mask (cached row's held keys)
* 
* Low byte of the (row, column-mask) pair #R$349B caches as a word
* write to this address - see #R$347A's own header for the full
* debounce mechanism. #R$347A re-tests this mask against a fresh
* strobe of the cached row (#R$E932) to check the same key(s) are
* still held.
keyboard_debounce_column_mask:                             ; >e931
       byte >00

********************************************************************************
* Keyboard debounce cached row nibble ($FF = none cached)
* 
* High byte of the same (row, column-mask) pair #R$349B caches (see
* #R$E931's own comment), but also read alone by #R$347A each VBlank
* as "which row (if any) had a key held last frame" - $FF meaning
* none cached, triggering a full matrix rescan via #R$344F.
keyboard_debounce_cached_row:                              ; >e932
       byte >FF

********************************************************************************
* Secondary flag/counter pair, also a ship-type marker
* 
* Read/cleared by #R$13FD's end-of-loop tail ($14EA) as a second
* "decaying counter hit zero" trigger alongside #R$E918, running the
* same #R$8B8F cleanup and a sound cue when set. Separately stashed
* with the ship-type value $64 by #R$8B00 as a marker for its own
* magnitude-clamping branch - two unrelated reuses of the same byte.
secondary_flag_counter_pair:                               ; >e933
       byte >00

********************************************************************************
* Number of police ships still to launch
* 
* Set to 1-6 by #R$2A1C when the police are called, and counted down by
* #R$315C as it launches each Viper from the space station.
police_to_launch:                                          ; >e934
       byte >00

********************************************************************************
* Unused
* 
* Nothing in the game uses this byte.
unused_e935:                                               ; >e935
       byte >00

********************************************************************************
* PRNG state (3 bytes)
* 
* #R$2176's (random_byte) own 3-byte shift-register state - see that
* routine's header. Seeded at startup from the Z80 refresh register R
* (#R$7045 step 6).
prng_state:                                                ; >e936
       byte >21                                                      ; 
rng_state_2:                                               ; >e937
       byte >BE                                                      ; 
rng_state_3:                                               ; >e938
       byte >AE                                                      ; 

********************************************************************************
* Number of pirates
* 
* How many pirates (class 4, see #R$A817) there are about: counted by
* #R$3090 and #R$30D7. Limits the pirates #R$2B24 spawns to 2 at a time.
pirate_count:                                              ; >e939
       byte >00

********************************************************************************
* Number of traders
* 
* How many traders (class 0, see #R$A817) there are about: counted by
* #R$3037 and #R$30A9. #R$2B24 only spawns a trader when there are
* none.
trader_count:                                              ; >e93a
       byte >00

********************************************************************************
* Jumps until the next mission
* 
* Counted down by #R$894D on each hyperspace jump outside the first
* galaxy while there's no mission under way; when it runs out, it's
* reset to 64 and the next mission starts (#R$908C).
jumps_to_next_mission:                                     ; >e93b
       byte >00

********************************************************************************
* Next mission
* 
* The number of the next mission (1-5) that #R$908C will start, or 6
* once they've all been started. 1 for a new commander (#R$7172).
next_mission:                                              ; >e93c
       byte >00

********************************************************************************
* Mission state
* 
* The high nibble is the mission number, the low nibble its progress (0
* is no mission). #R$908C starts the next mission every 64 hyperspace
* jumps while there's none under way.
* .
* #TABLE
* { =h State | =h Meaning }
* { $10 | Mission 1: the Constrictor briefing, on docking
* (#R$9120) }
* { $11 | Go to the navy research centre (#R$EFA2, #R$9190) }
* { $12 | The Constrictor has made a galactic jump; follow it
* (#R$894D) }
* { $13/$14 | Follow its trail through five systems (#R$91AA) }
* { $15 | Dock at the last system on the trail (#R$1896) }
* { $16 | "There's a mean, nasty, vicious ship out there!" (#R$6189);
* on launching, $17 (#R$1837) }
* { $17 | The Constrictor appears (#R$2B24): $18 }
* { $18 | Destroying the Constrictor (#R$291E): $19 }
* { $19 | The reward, on docking (#R$91F0) }
* { $20 | Mission 2: the Thargoid documents briefing, on docking
* (#R$9120) }
* { $21 | Carrying the documents to the naval base (#R$EFA2); Thargoids
* come instead of pirates (#R$2C3C), and after every Torus jump
* (#R$13FD); delivered on docking there (#R$91DB) }
* { $30 | Mission 3: "Fuel Leak" on arriving in a system (#R$894D) }
* { $31 | The supernova briefing, on docking (#R$909F) }
* { $32 | Refugees refused; the sun is approaching (#R$887F) }
* { $33 | Refugees on board; the sun is approaching }
* { $34 | Refugees delivered, on docking in the next system
* (#R$90FB) }
* { $40 | Mission 4: the Cougar appears, with Asp MkII escorts (#R$2B24):
* $41; ends when the Cougar has gone (#R$30D7) }
* { $50 | Mission 5: the Thargoid base briefing, on docking
* (#R$9220) }
* { $51 | Go to the next system }
* { $52 | The system has been invaded by the Thargoids; destroy its space
* station (#R$291E) }
* { $53 | The reward, on docking (#R$920F) }
* TABLE#
* .
* #R$8AC8 changes the state on each hyperspace jump.
mission_state:                                             ; >e93d
       byte >00

********************************************************************************
* Supernova: how far the sun has come
* 
* Subtracted from the sun's distance (#R$887F) in mission states $32 and
* $33, and reduced by 100 every frame, so the sun gets closer and
* closer. Reset to 0 by #R$1868.
supernova_offset:                                          ; >e93e
       byte >00,>00

********************************************************************************
* Search-cascade gate flag
* 
* #R$6D24's own header names this: "unless ($E940) is set" it skips
* the bit-index search below and falls straight to its tail. Written
* within #R$1C5C (at $1C6B), #R$1DB5 (at $1DC5) and #R$9120 (at $912B).
e940_gate_flag:                                            ; >e940
       byte >00

********************************************************************************
* Object's depth
* 
* The magnitude of the object's z relative to the player, stored by
* #R$883D; decides its distance band (#R$8B66).
object_depth:                                              ; >e941
       byte >00,>00

********************************************************************************
* Hostile ship about
* 
* Cleared each frame by the main loop (#R$13FD), and set by #R$2528 for
* any object that's hostile (bit 5 of its status byte). Makes the alert
* level at least 1 (#R$15E7).
hostile_about:                                             ; >e943
       byte >00

********************************************************************************
* Recharge timer
* 
* Frames until the energy banks and shields are next recharged (#R$18E6):
* 16 normally, 8 or 4 with an energy unit (#R$F77E).
recharge_timer:                                            ; >e944
       byte >01

********************************************************************************
* Death scene: random colours flag
* 
* Set by #R$1703 so that the first frame of the death scene gives the
* space view random colours (#R$180B, which clears it).
death_scene_colours_flag:                                  ; >e945
       byte >00

********************************************************************************
* Scanner queue write pointer (word)
* 
* Reset to #R$E94A by #R$13FD at the start of each frame and advanced by
* #R$8332 past each record added.
scanner_queue_ptr:                                         ; >e946
       byte >00,>00

********************************************************************************
* Number of records in the scanner queue
* 
* Reset by #R$13FD each frame, incremented by #R$8332 for each object
* added, and read by #R$8380, which copies it to #R$E949.
scanner_queue_count:                                       ; >e948
       byte >00

********************************************************************************
* Number of scanner blips drawn last frame
* 
* Set by #R$8380 from #R$E948; #R$834D restores nothing if it's 0.
scanner_drawn_count:                                       ; >e949
       byte >00

********************************************************************************
* Scanner queue
* 
* Room for 20 seven-byte records ($E94A-$E9D5), one for each slot of the
* object table: built by #R$8205/#R$82A0 during the frame and drawn by
* #R$8380 in the next VBlank. See #R$82A0 for the record format.
scanner_queue:                                             ; >e94a
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00

********************************************************************************
* Shared scratch buffer: scanner saved-background list / goatsoup text
* 
* Reused for two unrelated purposes, interlocked by #R$EB02 (which
* #R$13FD caches from #R$E903 (space view showing) and #R$8380 gates
* on): while out of flight, #R$8380 never runs, so goatsoup has the
* buffer to itself; while in flight, only the scanner uses it.
* .
* (1) In flight, #R$8380 saves here the VRAM bytes it draws the scanner
* blips and sticks over (`LD DE,$E9D6`), as a linked list of records
* that #R$834D writes back next frame to erase them; see #R$834D for
* the record format. At most 300 bytes are used (#R$EB03).
* .
* (2) #R$9A4B (goatsoup system-description text) zeroes exactly this
* 256-byte span first (`LD HL,$E9D6` / `LD (HL),0` / `LD DE,$E9D7` /
* `LD BC,$00FF` / LDIR), then decodes tokens from the word-list table
* at $A2EB through it via #R$9AB9's line-editor-style expander (IY
* walks the output from $E9D7). Also computes two XOR-combined hash
* words from ($F74B)/($F74D)/($F74F) into #R$EAD7/#R$EAD9 right after
* the zeroing - see those blocks below.
shared_blit_or_goatsoup_buffer:                            ; >e9d6
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00

********************************************************************************
* Goatsoup capitalize-next-word flag [text]
* 
* Set to $FF by the #R$9AB9 line editor's Ctrl-E handler (#R$9B71)
* and cleared to 0 by its Ctrl-F handler (#R$9B77). #R$9B0A (also
* reached via #R$9AB9) checks it when about to emit a lowercase
* letter following a space and, if set, clears bit 5 of the letter
* (`RES 5,C`) to capitalize it - the mechanism behind goatsoup's
* capitalized system/world names.
goatsoup_capitalize_flag:                                  ; >ead6
       byte >00

********************************************************************************
* Goatsoup RNG seed, word 1 [text]
* 
* Paired with #R$EAD9 (word 2). #R$9A4B seeds both from XOR-combined
* copies of ($F74B)/($F74D)/($F74F); #R$9BB2 then twists the pair each
* time goatsoup makes a random word-list choice (`DE=(EAD7) / HL=(EAD9)
* / (EAD7)=HL / HL+=DE / (EAD9)=HL` - a classic Fibonacci-style
* generator, the same shape as the original game's system-description
* seed). #R$9B7C also folds this word (XORed with word 2) into the seeds
* it generates a random ship name from (#R$E904).
goatsoup_seed_word1:                                       ; >ead7
       byte >00,>00

********************************************************************************
* Goatsoup RNG seed, word 2 [text]
* 
* See #R$EAD7 (word 1) for the full twist mechanism this pairs with.
goatsoup_seed_word2:                                       ; >ead9
       byte >00,>00

********************************************************************************
* Goatsoup: letter pairs of a random name
* 
* The four letter-pair indices of a random name in a system's description:
* #R$9B7C works them out here (#R$4CE7) and expands them into #R$E717
* (#R$4CB8).
goatsoup_name_pairs:                                       ; >eadb
       byte >00,>00,>00,>00

********************************************************************************
* Unused
* 
* Nothing in the game uses these bytes.
unused_eadf:                                               ; >eadf
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00

********************************************************************************
* Scanner queue ready flag
* 
* Set (from #R$E903, space view showing) by #R$13FD once the frame's scanner queue
* is complete; the VBlank handler (#R$7202) clears it and calls #R$8380
* to draw the queue. #R$13FD waits for it to be clear before starting a
* new queue.
scanner_queue_ready:                                       ; >eb02
       byte >00

********************************************************************************
* Space left in the scanner's saved-background list (word)
* 
* Reset to 300 (the size of #R$E9D6's list) by #R$13FD each frame and
* reduced by #R$8332 for each object added; an object whose record
* wouldn't fit isn't shown that frame.
scanner_background_space:                                  ; >eb03
       byte >00,>00

********************************************************************************
* Space station in range flag / compass target
* 
* 1 while the ship is inside the space station's safe zone - within 9000
* of the planet - and 0 otherwise; set and cleared by #R$1549/#R$156D.
* It is also the object-table slot number of the compass target (#R$85FB):
* slot 0 is the planet and slot 1 the space station, so the compass
* tracks the station while it's in range, as the manual describes. Shown
* on the console as the "S" indicator (#R$6ADC). The docking computer
* ('C', #R$1692) only works while it's set, and #R$2B24's hostile-ship
* countdown only runs while it's clear.
station_in_range:                                          ; >eb05
       byte >00

********************************************************************************
* Commander name (11-byte buffer)
* 
* #R$A433 (`LD HL,$1337 / LD DE,$EB06 / LD BC,$000B / LDIR`) fills
* this from #R$1337's "JAMESON",$00 default (and the 3 bytes after it),
* then sets #R$EB11 to 7. #R$6377 (at $638E, `LD HL,$EB06 / RST $08`)
* prints it as tokenised text. In this snapshot the "S" and the last two
* bytes hold bytes written by the tune-restart bug (#R$7603).
* TI: the "S" is restored, until the default commander (#R$A469) is set up.
commander_name:                                            ; >eb06
       byte >4A,>41,>4D,>45,>53,>4F,>4E,>00
       byte >00,>C3,>A8

********************************************************************************
* Length of the commander's name
* 
* Worked out by #R$A30A, and set to 7 for JAMESON by #R$A433. Used to
* centre the name (#R$6377).
name_length:                                               ; >eb11
       byte >00

********************************************************************************
* Combat rank
* 
* 0 Harmless, 1 Mostly Harmless, 2 Poor, 3 Average, 4 Above average, 5
* Competent, 6 Dangerous, 7 Deadly, 8 E-L-I-T-E (the names at #R$0F25,
* shown on the status page by #R$6276). Goes up when the score (#R$EB13)
* reaches the next threshold (#R$336D, #R$32E7). The higher it is, the
* more police (#R$2A1C), pirate escorts (#R$2C3C) and witchspace
* Thargoids (#R$894D) the player meets, and the harder pirates hit
* (#R$26A9).
combat_rank:                                               ; >eb12
       byte >00

********************************************************************************
* Score
* 
* A 24-bit number, raised by each object the player destroys (#R$32E7)
* and shown on the status page (#R$1A8A). Its value decides the combat
* rank (#R$EB12).
score:                                                     ; >eb13
       byte >00                                                      ; 
score_1:                                                   ; >eb14
       byte >00                                                      ; 
score_2:                                                   ; >eb15
       byte >00                                                      ; 

********************************************************************************
* Player's 24-bit cash total
* 
* Little-endian: $EB16 is the low byte, $EB18 the high byte. Formatted
* and printed by #R$6037.
player_cash:                                               ; >eb16
       byte >00                                                      ; 
cash_1:                                                    ; >eb17
       byte >00                                                      ; 
cash_2:                                                    ; >eb18
       byte >00                                                      ; 

********************************************************************************
* Cargo hold
* 
* How much of each of the goods is in the hold, in grams, 4 bytes each: the
* 17 kinds of goods in the order of their names at #R$0D9F (Food ... Alien
* Items), then the refugees of mission 3 (#R$909F). #R$63BA works out the
* free space from them. Cleared by #R$9237, and saved in the commander file
* (#R$A551). This snapshot was taken before the commander file was unpacked
* (#R$A469), so the hold holds bytes written by the tune-restart bug
* (#R$7603), not cargo.
cargo_hold:                                                ; >eb19
       byte >00,>00,>00,>00                                          ; 0: Food
       byte >00,>00,>00,>00                                          ; 1: Textiles
       byte >00,>00,>00,>00                                          ; 2: Radioactives
       byte >00,>00,>00,>00                                          ; 3: Slaves
       byte >00,>00,>00,>00                                          ; 4: Liquor/Wines
       byte >00,>00,>00,>00                                          ; 5: Luxuries
       byte >00,>00,>00,>00                                          ; 6: Narcotics
       byte >00,>00,>00,>00                                          ; 7: Computers
       byte >00,>00,>00,>00                                          ; 8: Machinery
       byte >00,>00,>00,>00                                          ; 9: Alloys
       byte >00,>00,>00,>00                                          ; 10: Firearms
       byte >00,>00,>00,>00                                          ; 11: Furs
       byte >00,>00,>00,>00                                          ; 12: Minerals
       byte >00,>00,>00,>00                                          ; 13: Gold
       byte >00,>00,>00,>00                                          ; 14: Platinum
cargo_gem_stones:                                          ; >eb55
       byte >00,>00,>00,>00                                          ; 15: Gem-Stones
       byte >00,>00,>00,>00                                          ; 16: Alien Items
cargo_refugees:                                            ; >eb5d
       byte >00,>00,>00,>00                                          ; 17: Refugees

********************************************************************************
* Free space in the hold
* 
* In grams: #R$63BA starts it at the hold's capacity (#R$5A97) and takes
* the cargo off it; #R$63E0 takes more off. If the high byte ($EB64) is
* negative, there isn't room.
free_space:                                                ; >eb61
       byte >00,>00                                                  ; 
free_hold_space_2:                                         ; >eb63
       byte >00                                                      ; 

********************************************************************************
* Free space in the hold: high byte
* 
* The fourth byte of #R$EB61: negative if there isn't room for the cargo
* (#R$5C01, #R$8BC7).
free_space_hi:                                             ; >eb64
       byte >00

********************************************************************************
* Legal status
* 
* Shown on the status page (#R$6276) as "Clean" (0), "Offender" (1-49)
* or "Fugitive" (50 or more). Increased by 64 (up to $FF) for destroying
* a trader or a police ship (#R$31AD), by 10 for each laser hit on the
* space station (#R$291E), and by the quantity * how illegal for buying
* or scooping illegal goods (#R$63AA); halved on each hyperspace jump
* (#R$894D). The worse it is, the more likely the police are to be
* called (#R$2C21) and the more Thargoids there are in witchspace
* (#R$894D).
legal_status:                                              ; >eb65
       byte >00

********************************************************************************
* Current galaxy number, 0-7
current_galaxy:                                            ; >eb66
       byte >00

********************************************************************************
* Current system index
* 
* The system the ship is in. Its data is generated by #R$4BA8.
current_system:                                            ; >eb67
       byte >00

********************************************************************************
* Nose vector, as logarithms
* 
* The object's nose vector (#R$F7DA) as sign-tagged logarithms, cached by
* #R$433F for #R$4464.
* Unlike the other variables, the words are big-endian, for word access.
nose_vector_logs:                                          ; >eb68
       data 0
nose_vector_log_y:                                         ; >eb6a
       data 0
nose_vector_log_z:                                         ; >eb6c
       data 0

********************************************************************************
* Distance to the reference point
* 
* The length of the vector from the object to the reference point (#R$EB88),
* worked out by #R$2DF1 and #R$3113 (#R$84A6). #R$25FF compares it with the
* target's size to see whether a missile has hit it.
reference_distance:                                        ; >eb6e
       byte >00                                                      ; 
reference_distance_hi:                                     ; >eb6f
       byte >00                                                      ; 

********************************************************************************
* Unused
* 
* Nothing in the game uses these bytes.
unused_eb70:                                               ; >eb70
       byte >00,>00,>00,>00,>00,>00

********************************************************************************
* Live roll-rotation coefficient table
* 
* #R$2209 refreshes this from the roll rate at $F815 via #R$21DA (signed rate
* -> 6-byte cos/sin coefficient record copy); #R$22C0 consumes it to rotate ($F7CE,$F7D4,$F7DA) - see
* #R$221B's own header (its pitch-table sibling) for the full
* rotation mechanism.
live_roll_coeff_table:                                     ; >eb76
       byte >00                                                      ; 
roll_cos:                                                  ; >eb77
       byte >00,>00,>00                                              ; 
roll_sin:                                                  ; >eb7a
       byte >00,>00                                                  ; 

********************************************************************************
* Live pitch-rotation coefficient table
* 
* #R$2212 refreshes this from the pitch rate at $F816 via the same
* #R$21DA lookup-and-copy; #R$221B (step_pitch_rotation)
* consumes it - see that routine's own header for the full mechanism
* and the (F7CE,F7D0,F7D2)-style vector pairing it documents.
live_pitch_coeff_table:                                    ; >eb7c
       byte >00                                                      ; 
pitch_cos:                                                 ; >eb7d
       byte >00,>00,>00                                              ; 
pitch_sin:                                                 ; >eb80
       byte >00,>00                                                  ; 

********************************************************************************
* Absolute delta X (word)
* 
* First word of the 3-word absolute delta vector - #R$2DF1 and
* #R$3113 each compute abs(#R$EB88 minus #R$F7CE) (or the
* mirror-signed equivalent) into this word (and #R$EB84/#R$EB86 for
* the Y/Z words), then feed all three to #R$84A6 to derive the
* magnitude cached at #R$EB6E. In the main loop's per-object pass,
* #R$8205 also scales all three to place the object on the scanner.
abs_delta_x:                                               ; >eb82
       byte >00                                                      ; 
delta_x_hi:                                                ; >eb83
       byte >00                                                      ; 

********************************************************************************
* Absolute delta Y (word)
* 
* Second word of the same delta vector - see #R$EB82's own comment.
abs_delta_y:                                               ; >eb84
       byte >00                                                      ; 
delta_y_hi:                                                ; >eb85
       byte >00                                                      ; 

********************************************************************************
* Absolute delta Z (word)
* 
* Third word of the same delta vector - see #R$EB82's own comment.
abs_delta_z:                                               ; >eb86
       byte >00                                                      ; 
delta_z_hi:                                                ; >eb87
       byte >00                                                      ; 

********************************************************************************
* Reference point: x
* 
* The point an object steers towards (#R$2EB2): the position of a missile's
* target or of the space station, copied from its slot in the object table
* (#R$2FF9), or zero for the player. #R$2DF1 and #R$3113 work out the vector from the object to it
* (#R$EB82).
reference_point_x:                                         ; >eb88
       data 0                                                        ; (TI: a big-endian word, as the object table's positions are)

********************************************************************************
* Reference-point Y (word)
* 
* Second word of the same reference-point vector - see #R$EB88's own
* comment.
reference_point_y:                                         ; >eb8a
       data 0                                                        ; (TI: a big-endian word, as the object table's positions are)

********************************************************************************
* Reference-point Z (word)
* 
* Third word of the same reference-point vector - see #R$EB88's own
* comment.
reference_point_z:                                         ; >eb8c
       data 0                                                        ; (TI: a big-endian word, as the object table's positions are)

********************************************************************************
* Distance of the object being processed (word)
* 
* The working object's distance from the player (#R$84A6), stored on
* every path through #R$883D/#R$88A1 (`LD ($EB8E),HL` at $88A8). Read back
* by #R$8755 (threshold-compared against $F805), #R$8205's own
* header, #R$27F4/#R$2A3A (top-nibble-tested via the high byte alone),
* and within #R$46CA (at $46D5) and #R$8B00 (at $8B32/$8B40).
object_distance:                                           ; >eb8e
       byte >00                                                      ; 
object_distance_hi:                                        ; >eb8f
       byte >00                                                      ; 

********************************************************************************
* Pointer input for $47A1's per-entry loop (word)
* 
* #R$4AEC (set up and run #R$47A1's per-entry loop) copies a 2-byte
* table entry here (page $0800+, indexed by ($F7F0)) via two LDIs;
* #R$47A1 consumes it through #R$2160 - see #R$4AEC's own header for
* the full mechanism.
perentry_loop_pointer:                                     ; >eb90
       byte >00,>00

********************************************************************************
* Clip point 1: column (X)
* 
* #R$3AC2's "point 1" X (paired with #R$EB94's Y). #R$3AC2 sign-flips
* and outcode-tests this pair alongside #R$EB96/#R$EB98, then (if not
* trivially inside/outside) falls through to boundary-clipping code
* that can overwrite it with a computed intersection point before
* #R$3C29 converts both pairs to screen space and draws. Note:
* #R$3C29's own I: block calls this same pair "the second endpoint" -
* the file has two conflicting numbering conventions for this pair;
* this block follows #R$3AC2's (5 callers, vs. #R$3C29's 2). Also
* reused as a general scale/quantize output slot by several callers of
* #R$47C4/#R$4B22 outside the clipper itself (#R$442A, #R$4A99's
* callers, #R$496D's cluster).
* The four clip point words are big-endian, for word access.
clip_point1_x:                                             ; >eb92
       data 0

********************************************************************************
* Clip point 1: row (Y)
* 
* Paired with #R$EB92 - see its description.
clip_point1_y:                                             ; >eb94
       data 0

********************************************************************************
* Clip point 2: column (X)
* 
* #R$3AC2's "point 2" X (paired with #R$EB98's Y) - #R$3C29's I: block
* calls this same pair "the first endpoint"; see #R$EB92's description
* for the numbering conflict.
clip_point2_x:                                             ; >eb96
       data 0

********************************************************************************
* Clip point 2: row (Y)
* 
* Paired with #R$EB96 - see its description.
clip_point2_y:                                             ; >eb98
       data 0

********************************************************************************
* Current view
* 
* Which space view is showing: 0 front, 1 rear, 2 left, 3 right. Set by
* #R$645B when the player switches view (and to $FF when the cockpit screen
* is set up, so that the next view always counts as a change). Selects the
* stardust's roll and pitch handlers (#R$67A8), the rear view's handling of
* particles reaching the centre (#R$6915), and the mount whose laser is
* used (#R$6D24).
current_view:                                              ; >eb9a
       byte >00

********************************************************************************
* Depth's shift
* 
* How far the depth was shifted down before its logarithm was taken
* (#R$46CA, #R$47C4); coordinates are shifted likewise when projected
* (#R$47F0).
depth_shift:                                               ; >eb9b
       byte >00

********************************************************************************
* Shared normalization mantissa
* 
* Reused scratch, paired with #R$EB9B: #R$3D0E (and #R$3DF4) cache the
* reduced 8-bit mantissa here for #R$3D76 (scale_by_trig_byte) to
* multiply against; also written directly by a couple of other sites
* ($4FEA, $5149) unrelated to that pairing.
shared_normalize_mantissa:                                 ; >eb9c
       byte >00

********************************************************************************
* Unused
* 
* Nothing in the game uses this byte.
unused_eb9d:                                               ; >eb9d
       byte >00

********************************************************************************
* Radius on screen
* 
* The object's size (#R$F805), or the planet's or sun's radius,
* projected (#R$46CA, #R$4714); used to check whether it's on screen
* (#R$4A99) and whether to draw it small (#R$4255, #R$4A86).
screen_radius:                                             ; >eb9e
       data 0

********************************************************************************
* Ship/object table: 20 slots, 40-byte stride
* 
* #TABLE
* { =h Offset | =h Field }
* { $00 | #R$F7CD - status: bit 0 in use, bit 2 can't be shot (#R$4735), bit 3 no collisions (#R$8755) - both set for the planet, the sun and explosions - bit 5 hostile, bit 6 no bounty }
* { $01-$02 | #R$F7CE - Position X (word) }
* { $03-$04 | #R$F7D0 - Position Y (word) }
* { $05 | #R$F7D2 - Position Z, low byte }
* { $06 | #R$F7D3 - Position Z, high byte/sign }
* { $07-$0C | #R$F7D4 - side vector: X/Y/Z words }
* { $0D-$12 | #R$F7DA - nose vector: X/Y/Z words }
* { $13-$18 | #R$F7E0 - roof vector (nose x side): X/Y/Z words }
* { $19 | #R$F7E6 - speed, seeded from blueprint header +$0D }
* { $1A | #R$F7E7 - current ship type }
* { $1B | #R$F7E8 - rotations since the orientation was straightened out }
* { $1C | #R$F7E9 - energy, from byte $0C of the blueprint }
* { $1D | #R$F7EA - missiles, from byte $13 of the blueprint }
* { $1E | #R$F7EB - a Thargon's Thargoid's slot }
* { $1F | #R$F7EC - cargo type, if scooped }
* { $20 | #R$F7ED - turn number (1-3) }
* { $21 | #R$F7EE - handler type (see #R$288D) }
* { $22 | #R$F7EF - the handler's countdown, or a missile's target }
* { $23-$27 | #R$F7F0 - per-type parameter block: for the ship handler types, the two turn-away phases' (countdown, rate) pairs, the next handler type, and the speed-up flag - see its own header for other types }
* TABLE#
* .
* #R$28D4 clears all 20 slots (800 bytes). #R$13FD (at $1450) walks them,
* copying each active slot's record to #R$F7CD to work on it and back
* again, and #R$3037 (at $3016) processes each slot in place. The fields
* are described in full at #R$F7CD and the entries after it.
