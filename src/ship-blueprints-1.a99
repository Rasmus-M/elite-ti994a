ship_letter_e_vertices:                                    ; >c8ba
       byte >57,>4A,>4A,>0D,>FF,>FF,>57,>0A
       byte >4A,>0D,>FF,>FF,>57,>0A,>57,>0A
       byte >FF,>FF,>00,>44,>57,>0A,>FF,>FF
       byte >00,>44,>00,>04,>FF,>FF,>57,>0A
       byte >00,>04,>FF,>FF,>57,>0A,>00,>44
       byte >FF,>FF,>00,>44,>00,>44,>FF,>FF
       byte >00,>44,>57,>4A,>FF,>FF,>57,>0A
       byte >57,>4A,>FF,>FF,>57,>0A,>4A,>4D
       byte >FF,>FF,>57,>4A,>4A,>4D,>FF,>FF

* Title letter E: edge array (2 bytes/edge)
ship_letter_e_edges:                                       ; >c902
       byte >00,>01,>01,>02,>02,>03,>03,>04
       byte >04,>05,>05,>06,>06,>07,>07,>08
       byte >08,>09,>09,>0A,>0A,>0B,>0B,>00

* Title letter E: faces (1 face)
*
* The letter's one face. The title letters have no normals (#R$F804), so a
* face is just a count and the numbers of its edges (see #R$A8DD); this one
* lists all 12 of the letter's edges, so #R$491A draws the whole outline.
* The other letters' faces (#R$C971, #R$C9F2, #R$CA59) are the same, each
* listing all of the letter's edges.
ship_letter_e_faces:                                       ; >c91a
       byte >0C,>00,>01,>02,>03,>04,>05,>06
       byte >07,>08,>09,>0A,>0B

* Title letter L: ship-blueprint header
*
* The letter "L" shown on the title screen (ship type 9, see #R$1F0C). See
* #R$A817 for the blueprint format. 6 vertices and 6 edges, going once
* round the letter's outline. The letters have no name: the name pointer
* points to the vertex array, which reads as "WJJ" (see #R$A7D7). It
* has one face, made of all its edges (#R$C971).
ship_letter_l_header:                                      ; >c927
       data ship_letter_l_vertices
       data ship_letter_l_edges
       data ship_letter_l_faces
       data ship_letter_l_vertices
       byte >01,>06,>06,>00,>00,>00,>FF,>00
       byte >0C,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00

