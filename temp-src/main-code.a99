********************************************************************************
* Goatsoup: the system description template
* 
* The top-level template for a system's description, which #R$9A4B (at
* $9A81) expands with #R$9AB9. Control code 4 takes back the space after
* the last word, so that the full stop follows it directly. The last two
* bytes, at $A2F2, double as entry 0 of the control-code handler table
* (#R$A2F4), which is never used.
goatsoup_description_template_a2eb:                        ; >a2eb
       byte >06,>92                                                  ; control code 6 (#R$9B77), symbol $92
       text 'IS '
       byte >93,>04                                                  ; symbol $93, control code 4 (#R$9B6E)
goatsoup_control_code_dispatch:                            ; >a2f2
       text '.',>00                                                  ; a full stop, and the end

********************************************************************************
* Goatsoup control code handlers
* 
* The routines for control codes 1-6 in the goatsoup templates: #R$9AB9
* reads code n's entry at $A2F2+2n. Code 0 ends a template, so entry 0 is
* never read; its two bytes, at $A2F2, are the end of the template at
* #R$A2EB.
_a2f4:                                                     ; >a2f4
       data line_editor_ctrl_a                                       ; 1: #R$9B35
       data goatsoup_adjective                                       ; 2: #R$9B43
       data line_editor_ctrl_c                                       ; 3: #R$9B7C
       data line_editor_ctrl_d                                       ; 4: #R$9B6E
       data line_editor_ctrl_e                                       ; 5: #R$9B71
       data line_editor_ctrl_f                                       ; 6: #R$9B77

********************************************************************************
* The adjective ending
* 
* Added to a system's name by #R$9B43.
adjective_ending:                                          ; >a300
       text 'IAN ',>00

********************************************************************************
* Vowels
* 
* The letters #R$9B43 replaces with "ian ".
vowels:                                                    ; >a305
       text 'AEIOU'

********************************************************************************
* Show the commander menu
* 
* Used by the routines at #R$1C5C, #R$A377, #R$A3E0, #R$A41B and #R$A542.
* .
* Reached from the title screen (#R$1DB5) and after each menu option.
* Refuses in flight (#R$6393). Packs the commander's data into the
* commander file (#R$A44F), and works out the length of the name (#R$EB06,
* into #R$EB11). Then $A31D shows the menu.
* .
* At $A31D, draws the menu: "1. Load new Commander", "2. Save Commander",
* "3. Catalog tape", "4. Default JAMESON", and the commander's name. The
* entry at $A33A goes straight to option 1 if "Load New Commander" was
* chosen on the title screen (#R$E924), and otherwise asks "Select option
* ?" ($A348).
* .
* At $A348, prints the menu prompt ($A5FD), then waits (#R$35E7) for a key
* in the range '1'-'5', rejecting anything else, before falling to $A359.
* .
* At $A359, redraws the dashboard, then (at $A35C) converts the '1'-'5' key
* to a 0-4 index and jumps to the option's routine from the table at $A6A4.
commander_menu:                                            ; >a30a
       .call @refuse_unless_docked                         ; CALL $6393        ; refuse in flight
       .call @pack_commander                               ; CALL $A44F        ; pack the commander file
       li   hl,commander_name                              ; LD HL,$EB06       ; the commander's name
       sb   b,b                                            ; LD B,$00          ; 
_a315:                                                     ; >a315
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  commander_menu_2                               ; JR Z,$A31D        ; 
       ab   one,b                                          ; INC B             ; count its letters
       inc  hl                                             ; INC HL            ; 
       jmp  _a315                                          ; JR $A315          ; 
commander_menu_2:                                          ; >a31d
       movb b,a                                            ; LD A,B            ; 
       movb a,@name_length                                 ; LD ($EB11),A      ; the length of the name
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide the sprites
       li   ix,commander_menu_frame                        ; LD IX,$A5ED       ; 
       .rst >28                                            ; RST $28           ; draw a frame
       li   hl,commander_menu_text                         ; LD HL,$A58F       ; the menu
       .rst >20                                            ; RST $20           ; print it
       .call @print_commander_name                         ; CALL $6377        ; 
       li   bc,>1706                                       ; LD BC,$1706       ; 
       .call @set_cursor_position                          ; CALL $3548        ; 
       li   hl,commander_name                              ; LD HL,$EB06       ; 
       .rst >08                                            ; RST $08           ; print the commander's name
* This entry point is used by the routines at #R$A3C7, #R$A3E0 and #R$A41B.
commander_menu_ask:                                        ; >a33a
       movb @load_new_commander,a                          ; LD A,($E924)      ; from the title screen?
       socb a,a                                            ; OR A              ; 
       jeq  commander_menu_wait_for_choice                 ; JR Z,$A348        ; no - ask
       sb   a,a                                            ; XOR A             ; 
       movb a,@load_new_commander                          ; LD ($E924),A      ; 
       movb @bytes+>31,a                                   ; LD A,$31          ; yes - option '1'
       jmp  _a35c                                          ; JR $A35C          ; 
commander_menu_wait_for_choice:                            ; >a348
       li   hl,msg_select_option                           ; LD HL,$A5FD       ; "Select option ? "
       .rst >20                                            ; RST $20           ; print it
_a34c:                                                     ; >a34c
       .call @wait_for_keypress_blinking_cursor            ; CALL $35E7        ; wait for a key
       cb   a,@bytes+>31                                   ; CP $31            ; below '1'?
       jl   _a357                                          ; JR C,$A357        ; yes - reject
       cb   a,@bytes+>36                                   ; CP $36            ; '6' or above?
       jl   continue_a348_dispatch_menu_choice             ; JR C,$A359        ; no (i.e. '1'-'5') - a valid choice
_a357:                                                     ; >a357
       jmp  _a34c                                          ; JR $A34C          ; reject - wait for another key
continue_a348_dispatch_menu_choice:                        ; >a359
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
_a35c:                                                     ; >a35c
       sb   @bytes+>31,a                                   ; SUB $31           ; convert '1'-'5' to a 0-4 index
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,misc_pointer_table                          ; LD HL,$A6A4       ; the menu dispatch table
       a    bc,hl                                          ; ADD HL,BC         ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; 
       b    *hl                                            ; JP (HL)           ; TODO. 

********************************************************************************
* Prompt for and read a commander name
* 
* Used by the routines at #R$A377 and #R$A3E0.
read_commander_name:                                       ; >a36b
       li   hl,msg_commanders_name                         ; LD HL,$A61D       ; "Commander's name ? "
       .rst >20                                            ; RST $20           ; print it
       li   de,>415a                                       ; LD DE,$415A       ; accepted character-code range
       movb @bytes+>0a,@c                                  ; LD C,$0A          ; up to 10 characters
       b    @read_line_keyboard_input                      ; JP $3631          ; read a line of keyboard input

********************************************************************************
* Commander menu option 1: load a new commander
* 
* Reached via the table at $A6A4 (#R$A30A). Asks for a name (#R$A36B), then
* searches the tape for a commander file (#R$A492 - "Searching ..") with
* that name - or any name, if none was typed - searching again (at $A3A9)
* if it doesn't match. At $A3AB, copies the name (11 bytes, from $D606) to
* #R$EB06 and the commander file (128 bytes, from $D611) to $F6C0, and
* unpacks it (#R$A469) before going back to the menu.
menu_load_commander:                                       ; >a377
       .call @read_commander_name                          ; CALL $A36B        ; prompt for and read a commander name
       joc  !                                              ; JP NC,$A30A       ; TODO: check code. Esc - back to the menu
       b    @commander_menu                                ;                   
!
_a37d:                                                     ; >a37d
       li   hl,msg_searching                               ; LD HL,$A646       ; "Searching .. (CTRL-STOP to exit)"
       .rst >08                                            ; RST $08           ; print it
       .call @search_read_checksum_tape_record             ; CALL $A492        ; search the tape for a commander record
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       jnc  !                                              ; JP C,$A542        ; TODO: check code. not found/error - show the error handler
       b    @show_tape_io_error_return_menu                ;                   
!
       li   hl,msg_found_commander                         ; LD HL,$A675       ; found: "Found Commander "
       .rst >08                                            ; RST $08           ; print it
       li   hl,tape_record                                 ; LD HL,$D606       ; the found record
       .call @show_message                                 ; CALL $5FFB        ; show it for a while
       li   hl,keyboard_input_buffer                       ; LD HL,$E8F7       ; A = the typed name
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  continue_a377_adopt_saved_record               ; JR Z,$A3AB        ; empty (accept whatever was found) - adopt it
       li   de,tape_record                                 ; LD DE,$D606       ; compare the typed name against the found record
_a39e:                                                     ; >a39e
       movb *de,a                                          ; LD A,(DE)         ; 
       cb   a,*hl                                          ; CP (HL)           ; 
       jne  continue_a377_retry_save                       ; JR NZ,$A3A9       ; mismatch - keep searching
       inc  hl                                             ; INC HL            ; 
       inc  de                                             ; INC DE            ; 
       socb a,a                                            ; OR A              ; 
       jne  _a39e                                          ; JR NZ,$A39E       ; more to compare - keep going
       jmp  continue_a377_adopt_saved_record               ; JR $A3AB          ; matched - adopt it
continue_a377_retry_save:                                  ; >a3a9
       jmp  _a37d                                          ; JR $A37D          ; search again
continue_a377_adopt_saved_record:                          ; >a3ab
       li   hl,tape_record                                 ; LD HL,$D606       ; the found record's name
       li   de,commander_name                              ; LD DE,$EB06       ; commander_name
       li   bc,>000b                                       ; LD BC,$000B       ; 11 bytes
       .ldir                                               ; LDIR              ; 
       li   hl,tape_record_data                            ; LD HL,$D611       ; the found record's state
       li   de,commander_menu_buffer                       ; LD DE,$F6C0       ; 
       li   bc,>0080                                       ; LD BC,$0080       ; 128 bytes
       .ldir                                               ; LDIR              ; 
       .call @unpack_commander                             ; CALL $A469        ; finalise it
       b    @commander_menu                                ; JP $A30A          ; back to the menu

********************************************************************************
* Menu option '3': catalog tape (see #R$A35C's dispatch table at $A6A4)
* 
* Reached only via #R$A35C's (key '1'-'4') dispatch table, not a
* literal CALL/JP. Never triggered in this capture.
* .
* Repeatedly searches the tape for the next commander record
* (#R$A492) and displays each one found, looping unconditionally -
* listing every recording on the tape (per #R$A58F's own "Catalog
* tape" menu text and "CTRL-STOP to exit" search message).
menu_option_3_handler_dispatch_table:                      ; >a3c7
       li   hl,msg_searching                               ; LD HL,$A646       ; "Searching .. (CTRL-STOP to exit)"
       .rst >08                                            ; RST $08           ; print it
       .call @search_read_checksum_tape_record             ; CALL $A492        ; search the tape for the next commander record
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       jnc  !                                              ; JP C,$A33A        ; TODO: check code. failed - a different error handler than #R$A377's
       b    @commander_menu_ask                            ;                   
!
       li   hl,msg_found_commander                         ; LD HL,$A675       ; found: "Found Commander "
       .rst >08                                            ; RST $08           ; print it
       li   hl,tape_record                                 ; LD HL,$D606       ; the found record
       .call @show_message                                 ; CALL $5FFB        ; show it for a while
       jmp  menu_option_3_handler_dispatch_table           ; JR $A3C7          ; search for the next one

********************************************************************************
* Commander menu option '2': save commander
* 
* Reached via the menu's jump table ($A6A4, #R$A359). Asks for a name
* (#R$A36B), which becomes the commander's name (#R$EB06) if one is
* typed. Shows "Start recording and press a key", turns the cassette
* motor on (bit 4 of the PPI's port C, $AA, reset), and waits for a key
* (#R$3A3C). Then shows "Saving Commander" and the name, and writes the
* commander file to tape (#R$A4CA): on failure, #R$A542; otherwise back
* to the menu (#R$A30A).
menu_save_commander:                                       ; >a3e0
       .call @read_commander_name                          ; CALL $A36B        ; prompt for and read a commander name
       joc  !                                              ; JP NC,$A33A       ; TODO: check code. Esc - back to the menu
       b    @commander_menu_ask                            ;                   
!
       movb @keyboard_input_buffer,a                       ; LD A,($E8F7)      ; A = the typed name
       socb a,a                                            ; OR A              ; 
       jeq  _a3f7                                          ; JR Z,$A3F7        ; empty - keep the existing name
       li   hl,keyboard_input_buffer                       ; LD HL,$E8F7       ; typed - adopt it
       li   de,commander_name                              ; LD DE,$EB06       ; commander_name
       li   bc,>000b                                       ; LD BC,$000B       ; 11 bytes
       .ldir                                               ; LDIR              ; 
_a3f7:                                                     ; >a3f7
       li   hl,msg_start_recording                         ; LD HL,$A685       ; "Start recording and press a key"
       .rst >08                                            ; RST $08           ; print it
       ; IN A,($AA)                                        ; IN A,($AA)        ; TODO: check code. turn the cassette motor on
       andi a,>ef00                                        ; AND $EF           ; (bit 4 of the PPI's port C reset)
       ; OUT ($AA),A                                       ; OUT ($AA),A       ; TODO: check code. 
       .call @block_until_key_action_no_cursor             ; CALL $3A3C        ; wait for a key
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       li   hl,msg_saving_commander                        ; LD HL,$A634       ; "Saving Commander "
       .rst >08                                            ; RST $08           ; print it
       li   hl,commander_name                              ; LD HL,$EB06       ; commander_name
       .rst >08                                            ; RST $08           ; print it
       .call @write_commander_record_to_tape               ; CALL $A4CA        ; write the commander file to tape
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       jnc  !                                              ; JP C,$A542        ; TODO: check code. failed - show the error handler
       b    @show_tape_io_error_return_menu                ;                   
!
       b    @commander_menu                                ; JP $A30A          ; succeeded - back to the menu

********************************************************************************
* Commander menu option '4': default JAMESON
* 
* Reached via the menu's jump table ($A6A4, #R$A359). Asks "Are you
* sure"; if 'Y', gives the player the default commander, JAMESON
* (#R$A433, #R$A469). Back to the menu (#R$A30A).
menu_default_commander:                                    ; >a41b
       li   hl,msg_are_you_sure                            ; LD HL,$A611       ; "Are you sure"
       .rst >08                                            ; RST $08           ; print it
       .call @confirm_prompt_yn                            ; CALL $3815        ; wait for Y, N or ESC
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       cb   a,@bytes+>59                                   ; CP $59            ; 
       jeq  !                                              ; JP NZ,$A33A       ; not 'Y' - ask again
       b    @commander_menu_ask                            ;                   
!
       .call @default_commander                            ; CALL $A433        ; the default commander file
       .call @unpack_commander                             ; CALL $A469        ; unpack it
       b    @commander_menu                                ; JP $A30A          ; back to the menu

********************************************************************************
* Load the default commander
* 
* Used by the routines at #R$6F9F and #R$A41B.
* .
* Copies the default commander file (#R$7172) into the commander file
* buffer ($F6C0), and the name "JAMESON" (#R$1337) into the commander's
* name (#R$EB06), 7 letters long (#R$EB11). Used at startup (#R$6F9F)
* and for menu option '4' (#R$A41B).
default_commander:                                         ; >a433
       li   hl,default_commander_file                      ; LD HL,$7172       ; 
       li   de,commander_menu_buffer                       ; LD DE,$F6C0       ; the commander file buffer
       li   bc,>0080                                       ; LD BC,$0080       ; 
       .ldir                                               ; LDIR              ; copy the default commander file
       li   hl,jameson_default_commander_name_string       ; LD HL,$1337       ; "JAMESON"
       li   de,commander_name                              ; LD DE,$EB06       ; the commander's name
       li   bc,>000b                                       ; LD BC,$000B       ; 
       .ldir                                               ; LDIR              ; 
       movb @bytes+>07,a                                   ; LD A,$07          ; 
       movb a,@name_length                                 ; LD ($EB11),A      ; 7 letters
       .ret                                                ; RET               ; 

********************************************************************************
* Pack the commander file
* 
* Used by the routine at #R$A30A.
* .
* Copies the commander's data - the variables listed at #R$A551 - into
* the commander file buffer at $F6C0, for saving.
pack_commander:                                            ; >a44f
       li   hl,commander_file_variables                    ; LD HL,$A551       ; the list of variables
       li   de,commander_menu_buffer                       ; LD DE,$F6C0       ; the commander file buffer
_a455:                                                     ; >a455
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; HL = next variable
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; all done
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = its length
       inc  hl                                             ; INC HL            ; 
       .push hl                                            ; PUSH HL           ; 
       movb b,h                                            ; LD H,B            ; 
       movb @c,@l                                          ; LD L,C            ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       .ldir                                               ; LDIR              ; copy it into the buffer
       .pop hl                                             ; POP HL            ; 
       jmp  _a455                                          ; JR $A455          ; 

********************************************************************************
* Unpack the commander file
* 
* Used by the routines at #R$1C5C, #R$A377 and #R$A41B.
* .
* Copies the commander file buffer at $F6C0 back into the variables listed
* at #R$A551, then sets up the current system ($A486).
* .
* At $A486, selects the current system (#R$E72B), sets up its data and
* market (#R$4BA8), and updates the chart cursor (#R$527F).
unpack_commander:                                          ; >a469
       li   hl,commander_file_variables                    ; LD HL,$A551       ; the list of variables
       li   de,commander_menu_buffer                       ; LD DE,$F6C0       ; the commander file buffer
_a46f:                                                     ; >a46f
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; DE = next variable
       socb a,a                                            ; OR A              ; 
       jeq  unpack_commander_2                             ; JR Z,$A486        ; all done
       movb a,b                                            ; LD B,A            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = its length
       inc  hl                                             ; INC HL            ; 
       .push hl                                            ; PUSH HL           ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       movb b,d                                            ; LD D,B            ; 
       movb @c,@e                                          ; LD E,C            ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       .ldir                                               ; LDIR              ; copy it from the buffer
       .ex_de_hl                                           ; EX DE,HL          ; 
       .pop hl                                             ; POP HL            ; 
       jmp  _a46f                                          ; JR $A46F          ; 
unpack_commander_2:                                        ; >a486
       movb @current_system,a                              ; LD A,($EB67)      ; the current system
       movb a,@selected_system                             ; LD ($E72B),A      ; is selected
       .call @arrive_in_system                             ; CALL $4BA8        ; set up its data and market
       b    @update_chart_cursor                           ; JP $527F          ; update the chart cursor

********************************************************************************
* Search the tape for a commander record, read and checksum it
* 
* Used by the routines at #R$A377 and #R$A3C7.
* .
* Sets up the memory configuration for tape I/O (#R$A511), then reads
* bytes via the standard MSX BIOS cassette-input hooks ($00E1 TAPION,
* $00E4 TAPIN) looking for a sync byte ($36) before reading
* the 139-byte record ($D606 onward: 11-byte name + 128-byte state,
* matching #R$A3AB's own copy) into it, accumulating a running
* checksum in C. Reads one more byte and compares it against D (a
* caller-supplied expected checksum) - RET with carry set on any I/O
* error or checksum mismatch. Restores the memory configuration
* (#R$A52C) either way.
* 
* O:carry Set on I/O error or checksum mismatch
search_read_checksum_tape_record:                          ; >a492
       .call @tape_io_setup                                ; CALL $A511        ; set up for tape I/O
_a495:                                                     ; >a495
       .call @>00e1                                        ; CALL $00E1        ; read a byte (BIOS cassette input?)
       jnc  !                                              ; JP C,$A4C4        ; TODO: check code. I/O error - bail
       b    @tape_read_done                                ;                   
!
       .call @>00e4                                        ; CALL $00E4        ; read another byte
       jnc  !                                              ; JP C,$A4C4        ; TODO: check code. I/O error - bail
       b    @tape_read_done                                ;                   
!
       cb   a,@bytes+>36                                   ; CP $36            ; the sync byte?
       jne  _a495                                          ; JR NZ,$A495       ; no - keep searching
       li   hl,tape_record                                 ; LD HL,$D606       ; yes: HL -> the record buffer
       li   bc,>8b00                                       ; LD BC,$8B00       ; B = 139 bytes, C = the checksum accumulator
_a4ab:                                                     ; >a4ab
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       .call @>00e4                                        ; CALL $00E4        ; read the next byte
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       jnc  !                                              ; JP C,$A4C4        ; TODO: check code. I/O error - bail
       b    @tape_read_done                                ;                   
!
       movb a,*hl                                          ; LD (HL),A         ; store it
       inc  hl                                             ; INC HL            ; 
       ab   @c,a                                           ; ADD A,C           ; accumulate the checksum
       movb a,@c                                           ; LD C,A            ; 
       sb   one,b                                          ; DJNZ $A4AB        ; next byte
       jne  _a4ab                                          ;                   
       .push bc                                            ; PUSH BC           ; 
       .call @>00e4                                        ; CALL $00E4        ; read the recorded checksum byte
       .pop bc                                             ; POP BC            ; 
       cb   a,d                                            ; CP D              ; does it match the accumulated one?
       jeq  tape_read_done                                 ; JR Z,$A4C4        ; yes - success
       ; SCF                                               ; SCF               ; TODO: check code. no - report a mismatch
tape_read_done:                                            ; >a4c4
       .call @>00f0                                        ; CALL $00F0        ; TAPOOF - turn off the cassette motor
       b    @tape_io_restore                               ; JP $A52C          ; restore the memory configuration, return

********************************************************************************
* Write a commander record to tape, with a checksum
* 
* Used by the routine at #R$A3E0.
* .
* Copies commander_name (#R$EB06) and the commander state at $F6C0
* into the 139-byte record buffer at $D606 (the same layout
* #R$A492/#R$A3AB use), sets up for tape I/O (#R$A511), then writes a
* sync byte and the whole record via the standard MSX BIOS cassette-
* output hooks ($00EA TAPOON, $00ED TAPOUT), accumulating and finally
* writing a checksum byte too. Restores the memory configuration
* (#R$A52C) either way.
* 
* O:carry Set on I/O error
write_commander_record_to_tape:                            ; >a4ca
       li   hl,commander_name                              ; LD HL,$EB06       ; commander_name
       li   de,tape_record                                 ; LD DE,$D606       ; the record buffer
       li   bc,>000b                                       ; LD BC,$000B       ; 11 bytes
       .ldir                                               ; LDIR              ; 
       li   hl,commander_menu_buffer                       ; LD HL,$F6C0       ; the commander state
       li   de,tape_record_data                            ; LD DE,$D611       ; 
       li   bc,>0080                                       ; LD BC,$0080       ; 128 bytes
       .ldir                                               ; LDIR              ; 
       .call @tape_io_setup                                ; CALL $A511        ; set up for tape I/O
       movb one,a                                          ; LD A,$01          ; 
       .call @>00ea                                        ; CALL $00EA        ; TAPOON - turn on the cassette motor, write a header
       joc  _a50b                                          ; JR C,$A50B        ; TODO: check code. I/O error - bail
       movb @bytes+>36,a                                   ; LD A,$36          ; the sync byte
       .call @>00ed                                        ; CALL $00ED        ; write it
       joc  _a50b                                          ; JR C,$A50B        ; TODO: check code. I/O error - bail
       li   hl,tape_record                                 ; LD HL,$D606       ; HL -> the record buffer
       li   bc,>8b00                                       ; LD BC,$8B00       ; B = 139 bytes, C = the checksum accumulator
_a4f7:                                                     ; >a4f7
       movb *hl,a                                          ; LD A,(HL)         ; A = this byte
       ab   @c,a                                           ; ADD A,C           ; accumulate the checksum
       movb a,@c                                           ; LD C,A            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = this byte again
       inc  hl                                             ; INC HL            ; 
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       .call @>00ed                                        ; CALL $00ED        ; write it
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       joc  _a50b                                          ; JR C,$A50B        ; TODO: check code. I/O error - bail
       sb   one,b                                          ; DJNZ $A4F7        ; next byte
       jne  _a4f7                                          ;                   
       movb @c,a                                           ; LD A,C            ; A = the accumulated checksum
       .call @>00ed                                        ; CALL $00ED        ; write it
_a50b:                                                     ; >a50b
       .call @>00f0                                        ; CALL $00F0        ; TAPOOF - turn off the cassette motor
       b    @tape_io_restore                               ; JP $A52C          ; restore the memory configuration, return

********************************************************************************
* Cache the slot IDs at pages 0/1, arm the tape-I/O memory configuration
* 
* Used by the routines at #R$A492 and #R$A4CA.
* .
* Reads the slot ID at pages 0 and 1 (#R$A727, with HL=$0000/$4000)
* into $D604/$D605 (for #R$A52C to restore afterwards), then arms
* whatever memory configuration #R$A6AE sets up for tape I/O, using a
* system variable at $FCC1.
tape_io_setup:                                             ; >a511
       li   hl,>0000                                       ; LD HL,$0000       ; page 0
       .call @read_slot_mapped_into_page                   ; CALL $A727        ; A = its slot ID
       movb a,@tape_slot_page0                             ; LD ($D604),A      ; cache it
       li   hl,>4000                                       ; LD HL,$4000       ; page 1
       .call @read_slot_mapped_into_page                   ; CALL $A727        ; A = its slot ID
       movb a,@tape_slot_page1                             ; LD ($D605),A      ; cache it
       movb @>fcc1,a                                       ; LD A,($FCC1)      ; a system variable
       li   hl,>0000                                       ; LD HL,$0000       ; 
       b    @map_slot_into_page                            ; JP $A6AE          ; arm the tape-I/O memory configuration

********************************************************************************
* Restore the pages 0/1 slot IDs #R$A511 cached
* 
* Used by the routines at #R$A492 and #R$A4CA.
* .
* Restores the original memory configuration (#R$A6AE) at pages 0 and
* 1 from the slot IDs #R$A511 cached to $D604/$D605, undoing whatever
* #R$A511 armed for tape I/O.
tape_io_restore:                                           ; >a52c
       .push af                                            ; PUSH AF           ; preserve the caller's result (carry/A)
       movb @tape_slot_page0,a                             ; LD A,($D604)      ; page 0's original slot ID
       li   hl,>0000                                       ; LD HL,$0000       ; 
       .call @map_slot_into_page                           ; CALL $A6AE        ; restore it
       movb @tape_slot_page1,a                             ; LD A,($D605)      ; page 1's original slot ID
       li   hl,>4000                                       ; LD HL,$4000       ; 
       .call @map_slot_into_page                           ; CALL $A6AE        ; restore it
       .pop af                                             ; POP AF            ; recover the caller's result
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Show a tape I/O error message, then return to the menu
* 
* Used by the routines at #R$A377 and #R$A3E0.
* .
* Beeps (#R$16FE), clears the message line, and shows "Tape I/O error!"
* (#R$A666) before returning to the commander menu (#R$A30A).
show_tape_io_error_return_menu:                            ; >a542
       .call @trigger_sfx_6                                ; CALL $16FE        ; beep
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       li   hl,msg_tape_io_error                           ; LD HL,$A666       ; "Tape I/O error!"
       .call @show_message                                 ; CALL $5FFB        ; show it for a while
       b    @commander_menu                                ; JP $A30A          ; back to the menu

********************************************************************************
* Commander file variables
* 
* The variables saved in the commander file, as (address, length): #R$A44F
* copies them into the commander file buffer at $F6C0 for saving, and
* #R$A469 copies them back. The list ends with an address of 0.
commander_file_variables:                                  ; >a551
       data current_galaxy                                           ; 1: galaxy number (#R$EB66)
       byte >01                                                      ; 
       data galaxy_seeds                                             ; 6: galaxy seeds (#R$E711)
       byte >06                                                      ; 
       data current_system                                           ; 1: current system (#R$EB67)
       byte >01                                                      ; 
       data options                                                  ; 1: options (#R$E914)
       byte >01                                                      ; 
       data player_cash                                              ; 3: cash (#R$EB16)
       byte >03                                                      ; 
       data market_price_roll                                        ; 1: market random byte (#R$EFAA)
       byte >01                                                      ; 
       data scratch_buffer                                           ; 4: scratch buffer ($E600)
       byte >04                                                      ; 
       data fuel_level                                               ; 20: fuel and equipment (#R$F775)
       byte >14                                                      ; 
       data cargo_hold                                               ; 72: cargo hold (#R$EB19)
       byte >48                                                      ; 
       data legal_status                                             ; 1: legal status (#R$EB65)
       byte >01                                                      ; 
       data score                                                    ; 3: score (#R$EB13)
       byte >03                                                      ; 
       data combat_rank                                              ; 1: combat rank (#R$EB12)
       byte >01                                                      ; 
       data scratch_buffer                                           ; 1: scratch buffer ($E600)
       byte >01                                                      ; 
       data constrictor_trail_count                                  ; 1: Constrictor's trail (#R$EFA3)
       byte >01                                                      ; 
       data kill_count                                               ; 1: kills (#R$E930)
       byte >01                                                      ; 
       data next_mission                                             ; 1: next mission (#R$E93C)
       byte >01                                                      ; 
       data mission_state                                            ; 1: mission state (#R$E93D)
       byte >01                                                      ; 
       data mission_system                                           ; 1: mission system (#R$EFA2)
       byte >01                                                      ; 
       data jumps_to_next_mission                                    ; 1: jumps to the next mission (#R$E93B)
       byte >01                                                      ; 
       data game_clock                                               ; 4: game time (#R$F742)
       byte >04                                                      ; 
       data >0000                                                    ; end of list

********************************************************************************
* Commander menu
* 
* Printed by #R$A30A (RST $20): a list of (column, row, string) records ending
* with $FF (see #R$3596).
commander_menu_text:                                       ; >a58f
       text >05,>04,'1. LOAD NEW COMMANDER',>00
       text >05,>06,'2. SAVE COMMANDER',>00
       text >05,>08,'3. CATALOG TAPE',>00
       text >05,>0a,'4. DEFAULT JAMESON',>00
       text >05,>0c,'5. EXIT',>00
       byte >FF

********************************************************************************
* Commander menu frame
* 
* Three (RST $28) rectangles that #R$A30A draws around the commander menu (see
* #R$36F1).
commander_menu_frame:                                      ; >a5ed
       byte >05,>01,>20,>01,>91
       byte >05,>04,>02,>09,>D1
       byte >08,>04,>19,>09,>21
       byte >FF

********************************************************************************
* Commander menu: "Select option ?"
* 
* Printed by #R$A30A.
msg_select_option:                                         ; >a5fd
       text >05,>16,'SELECT OPTION ? ',>00
       byte >FF

********************************************************************************
* The message "Are you sure"
msg_are_you_sure:                                          ; >a611
       text 'ARE YOU SUR',>e5

********************************************************************************
* Commander menu: "Commander's name ?"
* 
* Printed by #R$A36B.
msg_commanders_name:                                       ; >a61d
       text >05,>16,'COMMANDER''S NAME ? ',>00
       byte >FF

********************************************************************************
* The message "Saving Commander "
msg_saving_commander:                                      ; >a634
       text 'SAVING COMMANDER ',>80

********************************************************************************
* The message "Searching .. (CTRL-STOP to exit)"
msg_searching:                                             ; >a646
       text 'SEARCHING .. (CTRL-STOP TO EXIT',>a9

********************************************************************************
* The message "Tape I/O error!"
msg_tape_io_error:                                         ; >a666
       text 'TAPE I/O ERROR',>a1

********************************************************************************
* The message "Found Commander "
msg_found_commander:                                       ; >a675
       text 'FOUND COMMANDER',>a0

********************************************************************************
* The message "Start recording and press a key"
msg_start_recording:                                       ; >a685
       text 'START RECORDING AND PRESS A KE',>f9

********************************************************************************
* Pointer table
misc_pointer_table:                                        ; >a6a4
       data menu_load_commander
       data menu_save_commander
       data menu_option_3_handler_dispatch_table
       data menu_default_commander
       data status_page

********************************************************************************
* Map primary/secondary slot A into page H (MSX slot-switching primitive)
* 
* Used by the routines at #R$A511 and #R$A52C.
* .
* The standard MSX cross-slot memory-mapping technique (see #R$A6F3's own
* comment on the page-3 secondary-slot register at $FFFF, and
* EXPTBL/SLTTBL). Computes the OUT($A8) mask/value for mapping page H to
* primary slot A (#R$A6CE); if that slot isn't expanded, applies it
* directly to port $A8. Otherwise (at $A6BB) also writes the sub-slot
* number into that slot's cached secondary-slot byte at $FCC5+slot (#R$A6F3
* does the actual port $A8/$FFFF read-modify-write).
* 
* I:A The primary slot number to map in
* I:H The target page's high address byte ($00/$40/$80/$C0)
map_slot_into_page:                                        ; >a6ae
       .call @compute_page_slot_mask_value                 ; CALL $A6CE        ; compute the port $A8 mask/value for this page/slot
       jhe  !                                              ; JP M,$A6BB        ; expanded - also set the secondary slot register
       b    @continue_a6ae_set_secondary_slot              ;                   
!
       ; IN A,($A8)                                        ; IN A,($A8)        ; TODO: check code. not expanded - read the current primary slot register
       ; AND C                                             ; AND C             ; TODO: check code. clear this page's 2 bits
       socb b,a                                            ; OR B              ; set them to the new slot
       ; OUT ($A8),A                                       ; OUT ($A8),A       ; TODO: check code. write it back
       .ret                                                ; RET               ; 
continue_a6ae_set_secondary_slot:                          ; >a6bb
       .push hl                                            ; PUSH HL           ; 
       .call @map_slot_read_secondary_byte                 ; CALL $A6F3        ; map the primary slot, get its old secondary byte
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       movb @l,a                                           ; LD A,L            ; 
       ; AND H                                             ; AND H             ; TODO: check code. 
       socb d,a                                            ; OR D              ; 
       li   hl,>fcc5                                       ; LD HL,$FCC5       ; the cached secondary-slot bytes
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb a,*hl                                          ; LD (HL),A         ; update this slot's cached value
       .pop hl                                             ; POP HL            ; 
       movb @c,a                                           ; LD A,C            ; 
       jmp  map_slot_into_page                             ; JR $A6AE          ; re-apply via the primary path

********************************************************************************
* Compute the port $A8 mask/value for mapping page H to slot A
* 
* Used by the routine at #R$A6AE.
* .
* Works out which 2 bits of port $A8 correspond to page H (0-3, from
* its high address byte) and builds a clear-mask (C) and shifted value
* (B) for setting them to slot A. Also checks $FCC1+slot's bit 7 (the
* expanded-slot flag EXPTBL records) - returns with the sign flag set
* if that slot is expanded, for #R$A6AE to detect.
* 
* I:A The primary slot number
* I:H The target page's high address byte
* O:B,C The OUT($A8) set-value and clear-mask for this page
* O:sign Set if this slot is expanded (has a secondary slot register)
compute_page_slot_mask_value:                              ; >a6ce
       limi 0                                              ; DI                ; slot-switching must not be interrupted
       .push af                                            ; PUSH AF           ; 
       movb h,a                                            ; LD A,H            ; A = the page index (0-3), from the address's high byte
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       andi a,>0300                                        ; AND $03           ; 
       movb a,@e                                           ; LD E,A            ; 
       movb @bytes+>c0,a                                   ; LD A,$C0          ; build a 2-bit clear-mask, rotated into this page's position
page_slot_mask_rotate:                                     ; >a6d8
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sb   one,@e                                         ; DEC E             ; 
       jlt  !                                              ; JP P,$A6D8        ; 
       b    @page_slot_mask_rotate                         ;                   
!
       movb a,@e                                           ; LD E,A            ; 
       inv  a                                              ; CPL               ; complement it into a clear-mask
       movb a,@c                                           ; LD C,A            ; C = the clear-mask
       .pop af                                             ; POP AF            ; 
       .push af                                            ; PUSH AF           ; 
       andi a,>0300                                        ; AND $03           ; A = the target slot number
       ab   one,a                                          ; INC A             ; 
       movb a,b                                            ; LD B,A            ; 
       movb @bytes+>ab,a                                   ; LD A,$AB          ; rotate the slot number into this page's bit position
_a6e9:                                                     ; >a6e9
       ab   @bytes+>55,a                                   ; ADD A,$55         ; 
       sb   one,b                                          ; DJNZ $A6E9        ; 
       jne  _a6e9                                          ;                   
       movb a,d                                            ; LD D,A            ; 
       ; AND E                                             ; AND E             ; TODO: check code. 
       movb a,b                                            ; LD B,A            ; B = the set-value
       .pop af                                             ; POP AF            ; 
       ; AND A                                             ; AND A             ; TODO: check code. test the slot number for the expanded-slot check below
       .ret                                                ; RET               ; 

********************************************************************************
* Map slot A into page H, and read/return its cached secondary-slot byte
* 
* Used by the routine at #R$A6AE.
* .
* Applies the port $A8 change for an expanded primary slot (as
* #R$A6AE's own direct path does for a non-expanded one), then reads
* and returns the target sub-slot's secondary-slot byte via the page-3
* secondary-slot register at $FFFF (see that address's own comment) -
* the standard MSX cross-slot technique, gated on the slot actually
* being expanded (bit 7 of #R$FCC1+slot, matching #R$A6CE's own check).
map_slot_read_secondary_byte:                              ; >a6f3
       .push af                                            ; PUSH AF           ; 
       movb d,a                                            ; LD A,D            ; the clear-mask from #R$A6CE
       andi a,>c000                                        ; AND $C0           ; 
       movb a,@c                                           ; LD C,A            ; 
       .pop af                                             ; POP AF            ; 
       .push af                                            ; PUSH AF           ; 
       movb a,d                                            ; LD D,A            ; 
       ; IN A,($A8)                                        ; IN A,($A8)        ; TODO: check code. read the current primary slot register
       movb a,b                                            ; LD B,A            ; keep a copy to restore later
       andi a,>3f00                                        ; AND $3F           ; clear the target page's bits
       socb @c,a                                           ; OR C              ; 
       ; OUT ($A8),A                                       ; OUT ($A8),A       ; TODO: check code. map the slot in temporarily
       movb d,a                                            ; LD A,D            ; 
       srl  a,1                                            ; RRCA              ; TODO: check code. 
       srl  a,1                                            ; RRCA              ; TODO: check code. 
       andi a,>0300                                        ; AND $03           ; A = the target sub-slot number
       movb a,d                                            ; LD D,A            ; 
       movb @bytes+>ab,a                                   ; LD A,$AB          ; rotate it into the secondary-register's bit position
secondary_slot_rotate:                                     ; >a70b
       ab   @bytes+>55,a                                   ; ADD A,$55         ; 
       sb   one,d                                          ; DEC D             ; 
       jlt  !                                              ; JP P,$A70B        ; 
       b    @secondary_slot_rotate                         ;                   
!
       ; AND E                                             ; AND E             ; TODO: check code. 
       movb a,d                                            ; LD D,A            ; 
       movb @e,a                                           ; LD A,E            ; 
       inv  a                                              ; CPL               ; 
       movb a,h                                            ; LD H,A            ; 
       movb @>ffff,a                                       ; LD A,($FFFF)      ; read the current secondary slot register
       inv  a                                              ; CPL               ; 
       movb a,@l                                           ; LD L,A            ; 
       ; AND H                                             ; AND H             ; TODO: check code. clear this sub-slot's bits
       socb d,a                                            ; OR D              ; set them
       movb a,@>ffff                                       ; LD ($FFFF),A      ; write it back
       movb b,a                                            ; LD A,B            ; restore the original primary slot register
       ; OUT ($A8),A                                       ; OUT ($A8),A       ; TODO: check code. 
       .pop af                                             ; POP AF            ; 
       andi a,>0300                                        ; AND $03           ; A = the target sub-slot number
       .ret                                                ; RET               ; 

********************************************************************************
* Read which slot is currently mapped into page H
* 
* Used by the routine at #R$A511.
* .
* Reads port $A8 to find the primary slot mapped into page H, then - if
* that slot is expanded (bit 7 of #R$FCC1+slot) - also reads its cached
* secondary-slot byte (#R$FCC5+slot) to find which sub-slot, combining both
* into a single slot ID (at $A74D). The standard MSX slot-identification
* technique (mirrors #R$A6CE/#R$A6F3's own).
* 
* I:H The page's high address byte
* O:A The slot ID (primary, or primary+secondary if expanded)
read_slot_mapped_into_page:                                ; >a727
       movb h,a                                            ; LD A,H            ; A = the page index (0-3)
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       andi a,>0300                                        ; AND $03           ; 
       movb a,@e                                           ; LD E,A            ; 
       movb a,b                                            ; LD B,A            ; 
       ; IN A,($A8)                                        ; IN A,($A8)        ; TODO: check code. read the primary slot register
       jeq  _a736                                          ; JR Z,$A736        ; page 0 - already in the low bits
_a732:                                                     ; >a732
       srl  a,1                                            ; RRA               ; TODO: check code. shift this page's bits down
       srl  a,1                                            ; RRA               ; TODO: check code. 
       sb   one,b                                          ; DJNZ $A732        ; 
       jne  _a732                                          ;                   
_a736:                                                     ; >a736
       andi a,>0300                                        ; AND $03           ; A = the primary slot number
       movb a,@c                                           ; LD C,A            ; 
       li   hl,>fcc1                                       ; LD HL,$FCC1       ; EXPTBL-style expanded-slot flags
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb *hl,r0                                         ; BIT 7,(HL)        ; is this slot expanded?
       andi r0,>8000                                       ;                   
       jne  !                                              ; RET Z             ; no - the primary slot number is the whole ID
       .ret                                                ;                   
!
       li   hl,>fcc5                                       ; LD HL,$FCC5       ; yes: the cached secondary-slot bytes
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = this slot's secondary-slot byte
_a745:                                                     ; >a745
       sb   one,@e                                         ; DEC E             ; shift it down to this page's sub-slot bits
       jhe  !                                              ; JP M,$A74D        ; 
       b    @continue_a727_combine_slot_numbers            ;                   
!
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       jmp  _a745                                          ; JR $A745          ; 
continue_a727_combine_slot_numbers:                        ; >a74d
       sla  a,1                                            ; RLA               ; TODO: check code. shift the sub-slot number into bits 2-3
       sla  a,1                                            ; RLA               ; TODO: check code. 
       andi a,>0c00                                        ; AND $0C           ; 
       socb @c,a                                           ; OR C              ; combine with the primary slot number
       socb @bytes+>80,a                                   ; OR $80            ; mark it as an expanded-slot ID
       .ret                                                ; RET               ; 

********************************************************************************
* Unused text
* 
* Five pieces of text, each ending with 0 (or, the last, a byte with bit 7
* set). They look like left-over words for the system descriptions
* (#R$9A4B), but nothing refers to them.
unused_text_a755:                                          ; >a755
       text 'TLE PLANET ',>00
       text 'DUMP ',>00
       text 'FREQUENT ',>00
       text 'OCCASIONAL ',>00
       text 'UNP',>87

********************************************************************************
* Stack
* 
* The game's stack, which #R$0106 sets up to grow down from $A7D7. All
* zeroes when the game starts; this snapshot shows it in use down to
* $A795.
stack:                                                     ; >a781
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>89,>72,>89,>72
       byte >0D,>00,>89,>72,>89,>72,>89,>72
       byte >FE,>FF,>0B,>0B,>0B,>00,>89,>72
       byte >01,>00,>89,>72,>89,>72,>FE,>02
       byte >00,>04,>FD,>FF,>20,>37,>00,>00
       byte >FC,>E7,>C6,>E7,>00,>17,>B8,>60
       byte >00,>0B,>FB,>24,>44,>00,>08,>00
       byte >AB,>45,>BF,>42,>A7,>1E,>F0,>EB
       byte >00,>01,>8E,>1C,>0F,>01

********************************************************************************
* Ship blueprint table
* 
* The address of each ship type's blueprint (see #R$A817 for the layout),
* indexed by ship type (#R$F7E7) by #R$2FE9. Entry 0 is unused. Relocated
* at startup (#R$7045). Each blueprint ends with the ship's name, from
* which the names here are taken. Ship types 8-11 are the letters E, L,
* I and T shown on the title screen, which have no names.
ship_blueprints:                                           ; >a7d7
       data >0000                                                    ; $00: (none)
       data ship_space_station_header                                ; $01: Space Station
       data ship_missile_header                                      ; $02: Missile
       data ship_cargo_canister_header                               ; $03: Cargo Canister
       data ship_asteroid_header                                     ; $04: Asteroid
       data ship_escape_capsule_header                               ; $05: Escape Capsule
       data ship_thargon_header                                      ; $06: Thargon
       data ship_platlet_header                                      ; $07: Platlet
       data ship_letter_e_header                                     ; $08: letter E (title screen)
       data ship_letter_l_header                                     ; $09: letter L (title screen)
       data ship_letter_i_header                                     ; $0A: letter I (title screen)
       data ship_letter_t_header                                     ; $0B: letter T (title screen)
       data ship_viper_header                                        ; $0C: Viper
       data ship_fer_de_lance_header                                 ; $0D: Fer-De-Lance
       data ship_cobra_mkiii_header                                  ; $0E: Cobra MkIII
       data ship_python_header                                       ; $0F: Python
       data ship_anaconda_header                                     ; $10: Anaconda
       data ship_cobra_mk1_header                                    ; $11: Cobra MK1
       data ship_krait_header                                        ; $12: Krait
       data ship_thargoid_header                                     ; $13: Thargoid
       data ship_boa_class_cruiser_header                            ; $14: Boa Class Cruiser
       data ship_gecko_header                                        ; $15: Gecko
       data ship_moray_star_boat_header                              ; $16: Moray Star Boat
       data ship_adder_header                                        ; $17: Adder
       data ship_mamba_header                                        ; $18: Mamba
       data ship_asp_mkii_header                                     ; $19: Asp MkII
       data ship_sidewinder_header                                   ; $1A: Sidewinder
       data ship_wolf_mkii_header                                    ; $1B: Wolf MkII
       data ship_orbit_shuttle_header                                ; $1C: Orbit Shuttle
       data ship_transporter_header                                  ; $1D: Transporter
       data ship_cougar_header                                       ; $1E: Cougar
       data ship_constrictor_header                                  ; $1F: Constrictor

********************************************************************************
* Cougar: ship-blueprint header
* 
* #TABLE
* { =h Offset | =h Field }
* { $00-$01 | #R$A837 - vertex array pointer (word) }
* { $02-$03 | #R$A8A9 - edge array pointer (word) }
* { $04-$05 | #R$A8DD - faces pointer (word; see #R$F7F9) }
* { $06-$07 | #R$A831 - name text pointer (word; named ships only) }
* { $08 | Number of faces (#R$F7FD) }
* { $09 | Number of edges (#R$F7FE) }
* { $0A | Number of vertices (#R$F7FF) }
* { $0B | Targetable area (#R$F800): how close to the crosshairs it has to be to be hit by the laser (#R$46CA, #R$4735) }
* { $0C | Energy (#R$F801): the energy (#R$F7E9) it starts with (#R$3037) }
* { $0D | Maximum speed (#R$F802): the speed #R$2869 speeds up to, and the initial speed (#R$F7E6) at spawn unless the caller sets it to 0 }
* { $0E | Gun vertex (#R$F803): the vertex its laser beam is drawn from (#R$43C2) }
* { $0F | Faces have normals (#R$F804) }
* { $10 | Size (#R$F805): the distance at which a missile hits it (#R$25FF), and how close it comes on the title screen (#R$1C5C) }
* { $11 | Manoeuvrability (#R$F806): its turn rate, and how close it gets to the player before turning away (#R$2744, #R$281E) }
* { $12 | Bits 2-4: class (#R$F807): 0 trader, 4 pirate, 8 shuttle/escape capsule, $0C asteroid, $10 police, $14 bounty hunter, $18 station/missile/cargo, $1C Thargoid/Constrictor (see #R$31AD, #R$26A9) }
* { $13 | Bit 7: fitted with ECM (#R$25B9); bits 0-6 the number of missiles (#R$F7EA) }
* { $14 | Cargo (#R$F809): the low nibble the most cargo canisters it leaves, the high nibble their cargo type; $FF one canister holding the cloaking device (#R$8DB9) }
* { $15 | Aggression (#R$F80A): the chance of firing each frame (#R$26A9) }
* { $16-$17 | Bounty (#R$F80B), paid when it's destroyed (#R$2578) }
* { $18-$19 | Score value (#R$F80D), added to the score when it's destroyed (#R$32E7) }
* TABLE#
* .
* The 26-byte header of a blueprint (see #R$A7D7). The vertices (#R$A837)
* are 6 bytes each, and the edges (#R$A8A9) 2 bytes each: the numbers of
* the two vertices at its ends. The blueprints' vertices, edges, faces
* and names fill $A817-$CA61 with no gaps.
ship_cougar_header:                                        ; >a817
       data ship_cougar_vertices
       data ship_cougar_edges
       data ship_cougar_faces
       data ship_cougar_name
       byte >07,>1A,>13,>31,>FF,>28,>00,>01
       byte >43,>24,>26,>87,>FF,>96,>88,>13
       byte >E8,>03

********************************************************************************
* Cougar name text
* 
* The Cougar's name, which its blueprint header points to (#R$A817), ending
* with a bit-7-set "r" like the other messages (see #R$4223).
ship_cougar_name:                                          ; >a831
       text 'COUGA',>f2

********************************************************************************
* Cougar: vertex array (6 bytes/vertex)
* 
* 19 vertices, each an x, y and z (words), which #R$49FD rotates into
* the view (#R$4464).
ship_cougar_vertices:                                      ; >a837
       byte >FF,>FF,>4A,>09,>44,>18,>4A,>51
       byte >FF,>FF,>4A,>15,>4A,>55,>FF,>FF
       byte >4A,>55,>FF,>FF,>3B,>0F,>4A,>55
       byte >FF,>FF,>3B,>4F,>4A,>55,>4A,>11
       byte >FF,>FF,>4A,>15,>4A,>15,>FF,>FF
       byte >4A,>55,>AE,>54,>FF,>FF,>3B,>17
       byte >A1,>57,>FF,>FF,>4A,>51,>AE,>14
       byte >FF,>FF,>3B,>17,>A1,>17,>FF,>FF
       byte >4A,>51,>FF,>FF,>3B,>0B,>84,>14
       byte >FF,>FF,>00,>0C,>93,>12,>57,>4E
       byte >00,>04,>F8,>15,>57,>0E,>00,>04
       byte >F8,>15,>4A,>4D,>57,>0A,>4A,>55
       byte >4A,>4D,>57,>4A,>4A,>55,>4A,>0D
       byte >57,>4A,>4A,>55,>4A,>0D,>57,>0A
       byte >4A,>55

********************************************************************************
* Cougar: edge array (2 bytes/edge)
* 
* 26 edges, each the numbers of the two vertices at its ends. The last
* one ($FB,$01) is an invisible edge: bit 7 of its first byte is set, so
* #R$491A never draws it (and doesn't read its second byte). It is listed in
* faces 5 and 6 (#R$A8DD), closing them.
ship_cougar_edges:                                         ; >a8a9
       byte >00,>01,>01,>07,>07,>08,>08,>02
       byte >02,>03,>03,>06,>02,>04,>04,>06
       byte >06,>0A,>0A,>09,>09,>05,>05,>00
       byte >00,>03,>01,>04,>05,>04,>01,>02
       byte >05,>06,>0C,>0D,>0D,>0B,>0B,>0E
       byte >0E,>0C,>0F,>10,>10,>12,>12,>11
       byte >11,>0F,>FB,>01

********************************************************************************
* Cougar: faces (7 faces)
* 
* Each face is a scale byte and a normal vector (three words), used to
* hide the faces that face away (#R$4255, #R$4873), then a count and the
* numbers of the face's edges (#R$491A). A blueprint without normals
* (#R$F804) has just the edge lists (see #R$B3CC).
* .
* The title letters (#R$C91A) and the Platlet (#R$B3CC) have no normals.
ship_cougar_faces:                                         ; >a8dd
       byte >0A,>4D,>59,>A4,>1F,>F6,>12,>09
       byte >00,>0F,>04,>0C,>01,>02,>03,>11
       byte >12,>0A,>4D,>19,>A4,>1F,>F6,>12
       byte >09,>0B,>0C,>05,>10,>08,>09,>0A
       byte >14,>13,>28,>FF,>FF,>FF,>FF,>FA
       byte >5F,>08,>05,>04,>06,>07,>15,>16
       byte >17,>18,>0A,>4D,>59,>A4,>5F,>F6
       byte >12,>06,>0D,>0F,>06,>01,>02,>03
       byte >0A,>4D,>19,>A4,>5F,>F6,>12,>06
       byte >0E,>10,>07,>08,>09,>0A,>07,>FF
       byte >FF,>EB,>5F,>B1,>14,>03,>0E,>0D
       byte >19,>07,>FF,>FF,>EB,>5F,>B1,>14
       byte >03,>0B,>00,>19

********************************************************************************
* Constrictor: ship-blueprint header
* 
* See #R$A817 for the format. 24 vertices, 40 edges. The Constrictor is
* the ship stolen in mission 1 (#R$9483).
ship_constrictor_header:                                   ; >a941
       data ship_constrictor_vertices
       data ship_constrictor_edges
       data ship_constrictor_faces
       data ship_constrictor_name
       byte >0A,>18,>12,>32,>FF,>28,>11,>01
       byte >4B,>24,>3E,>FF,>72,>96,>A0,>0F
       byte >88,>13

********************************************************************************
* Constrictor name text
* 
* The message "Constrictor".
ship_constrictor_name:                                     ; >a95b
       text 'CONSTRICTO',>f2

********************************************************************************
* Constrictor: vertex array (6 bytes/vertex)
ship_constrictor_vertices:                                 ; >a966
       byte >4A,>11,>3B,>4B,>4A,>19,>4A,>51
       byte >3B,>4B,>4A,>19,>05,>57,>3B,>4B
       byte >4A,>15,>05,>57,>3B,>4B,>4A,>55
       byte >4A,>51,>CD,>0E,>4A,>55,>4A,>11
       byte >CD,>0E,>4A,>55,>05,>17,>3B,>4B
       byte >4A,>55,>05,>17,>3B,>4B,>4A,>15
       byte >4A,>11,>CD,>0E,>4A,>09,>4A,>51
       byte >CD,>0E,>4A,>09,>4A,>11,>3B,>4B
       byte >D1,>17,>4A,>51,>3B,>4B,>D1,>17
       byte >93,>12,>3B,>4B,>93,>52,>93,>52
       byte >3B,>4B,>93,>52,>A1,>0F,>3B,>4B
       byte >A1,>4F,>A1,>4F,>3B,>4B,>A1,>4F
       byte >FF,>FF,>3B,>4B,>FF,>FF,>FF,>FF
       byte >3B,>4B,>4A,>19

********************************************************************************
* Constrictor: edge array (2 bytes/edge)
