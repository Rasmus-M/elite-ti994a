       text '  '                                                     ; 0
       text 'LE'                                                     ; 1
       text 'XE'                                                     ; 2
       text 'GE'                                                     ; 3
       text 'ZA'                                                     ; 4
       text 'CE'                                                     ; 5
       text 'BI'                                                     ; 6
       text 'SO'                                                     ; 7
       text 'US'                                                     ; 8
       text 'ES'                                                     ; 9
       text 'AR'                                                     ; 10
       text 'MA'                                                     ; 11
       text 'IN'                                                     ; 12
       text 'DI'                                                     ; 13
       text 'RE'                                                     ; 14
       text 'A '                                                     ; 15
       text 'ER'                                                     ; 16
       text 'AT'                                                     ; 17
       text 'EN'                                                     ; 18
       text 'BE'                                                     ; 19
       text 'RA'                                                     ; 20
       text 'LA'                                                     ; 21
       text 'VE'                                                     ; 22
       text 'TI'                                                     ; 23
