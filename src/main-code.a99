msg_cloaking_device_8c85:                                  ; >8c85
       text 'Cloaking devic',>e5                                  ; 

********************************************************************************
* Unpack the commander file
* 
* Used by the routines at #R$1C5C, #R$A377 and #R$A41B.
* .
* Copies the commander file buffer at $F6C0 back into the variables listed
* at #R$A551, then sets up the current system ($A486).
* .
* At $A486, selects the current system (#R$E72B), sets up its data and
* market (#R$4BA8), and updates the chart cursor (#R$527F).
unpack_commander:                                          ; >a469
       .proc                                               ;                   ; 
       li   ix,commander_file_variables                    ; LD HL,$A551       ; the list of variables
       li   hl,commander_menu_buffer                       ; LD DE,$F6C0       ; the commander file buffer
_a46f:                                                     ; >a46f
       mov  *ix+,de                                        ; LD C,(HL) / LD A,(HL) / OR A; DE -> the next variable
       jeq  unpack_commander_2                             ; JR Z,$A486        ; all done
       mov  *ix+,bc                                        ; LD A,(HL)         ; BC = its length
       .ldir                                               ; LDIR              ; copy it from the buffer
       jmp  _a46f                                          ; JR $A46F          ; 
unpack_commander_2:                                        ; >a486
       movb @current_system,@selected_system               ; LD A,($EB67) / LD ($E72B),A; the current system is selected
       bl   @arrive_in_system                              ; CALL $4BA8        ; set up its data and market
* TI: update_chart_cursor (#R$527F) isn't converted yet. It only changes
* anything in witchspace or on a chart, not from the title screen.
       .endproc                                            ; JP $527F          ; update the chart cursor

********************************************************************************
* Commander file variables
* 
* The variables saved in the commander file, as (address, length): #R$A44F
* copies them into the commander file buffer at $F6C0 for saving, and
* #R$A469 copies them back. The list ends with an address of 0.
commander_file_variables:                                  ; >a551
       data current_galaxy,1                                      ; galaxy number (#R$EB66) (TI: words, not a word and a byte)
       data galaxy_seeds,6                                        ; galaxy seeds (#R$E711)
       data current_system,1                                      ; current system (#R$EB67)
       data options,1                                             ; options (#R$E914)
       data player_cash,3                                         ; cash (#R$EB16)
       data market_price_roll,1                                   ; market random byte (#R$EFAA)
       data scratch_buffer,4                                      ; scratch buffer ($E600)
       data fuel_level,20                                         ; fuel and equipment (#R$F775)
       data cargo_hold,72                                         ; cargo hold (#R$EB19)
       data legal_status,1                                        ; legal status (#R$EB65)
       data score,3                                               ; score (#R$EB13)
       data combat_rank,1                                         ; combat rank (#R$EB12)
       data scratch_buffer,1                                      ; scratch buffer ($E600)
       data constrictor_trail_count,1                             ; Constrictor's trail (#R$EFA3)
       data kill_count,1                                          ; kills (#R$E930)
       data next_mission,1                                        ; next mission (#R$E93C)
       data mission_state,1                                       ; mission state (#R$E93D)
       data mission_system,1                                      ; mission system (#R$EFA2)
       data jumps_to_next_mission,1                               ; jumps to the next mission (#R$E93B)
       data game_clock,4                                          ; game time (#R$F742)
       data 0                                                     ; end of list

********************************************************************************
* Ship blueprint table
*
* The address of each ship type's blueprint (see #R$A817 for the layout),
* indexed by ship type (#R$F7E7) by #R$2FE9. Entry 0 is unused. Relocated
* at startup (#R$7045). Each blueprint ends with the ship's name, from
* which the names here are taken. Ship types 8-11 are the letters E, L,
* I and T shown on the title screen, which have no names.
       .msxalign >a7d7
ship_blueprints:                                           ; >a7d7
       byte >00,>00                                                  ; $00: (none)
       byte ship_space_station_header%%256,ship_space_station_header//256 ; $01: Space Station
       byte ship_missile_header%%256,ship_missile_header//256        ; $02: Missile
       byte ship_cargo_canister_header%%256,ship_cargo_canister_header//256 ; $03: Cargo Canister
       byte ship_asteroid_header%%256,ship_asteroid_header//256      ; $04: Asteroid
       byte ship_escape_capsule_header%%256,ship_escape_capsule_header//256 ; $05: Escape Capsule
       byte ship_thargon_header%%256,ship_thargon_header//256        ; $06: Thargon
       byte ship_platlet_header%%256,ship_platlet_header//256        ; $07: Platlet
       byte ship_letter_e_header%%256,ship_letter_e_header//256      ; $08: letter E (title screen)
       byte ship_letter_l_header%%256,ship_letter_l_header//256      ; $09: letter L (title screen)
       byte ship_letter_i_header%%256,ship_letter_i_header//256      ; $0A: letter I (title screen)
       byte ship_letter_t_header%%256,ship_letter_t_header//256      ; $0B: letter T (title screen)
       byte ship_viper_header%%256,ship_viper_header//256            ; $0C: Viper
       byte ship_fer_de_lance_header%%256,ship_fer_de_lance_header//256 ; $0D: Fer-De-Lance
       byte ship_cobra_mkiii_header%%256,ship_cobra_mkiii_header//256 ; $0E: Cobra MkIII
       byte ship_python_header%%256,ship_python_header//256          ; $0F: Python
       byte ship_anaconda_header%%256,ship_anaconda_header//256      ; $10: Anaconda
       byte ship_cobra_mk1_header%%256,ship_cobra_mk1_header//256    ; $11: Cobra MK1
       byte ship_krait_header%%256,ship_krait_header//256            ; $12: Krait
       byte ship_thargoid_header%%256,ship_thargoid_header//256      ; $13: Thargoid
       byte ship_boa_class_cruiser_header%%256,ship_boa_class_cruiser_header//256 ; $14: Boa Class Cruiser
       byte ship_gecko_header%%256,ship_gecko_header//256            ; $15: Gecko
       byte ship_moray_star_boat_header%%256,ship_moray_star_boat_header//256 ; $16: Moray Star Boat
       byte ship_adder_header%%256,ship_adder_header//256            ; $17: Adder
       byte ship_mamba_header%%256,ship_mamba_header//256            ; $18: Mamba
       byte ship_asp_mkii_header%%256,ship_asp_mkii_header//256      ; $19: Asp MkII
       byte ship_sidewinder_header%%256,ship_sidewinder_header//256  ; $1A: Sidewinder
       byte ship_wolf_mkii_header%%256,ship_wolf_mkii_header//256    ; $1B: Wolf MkII
       byte ship_orbit_shuttle_header%%256,ship_orbit_shuttle_header//256 ; $1C: Orbit Shuttle
       byte ship_transporter_header%%256,ship_transporter_header//256 ; $1D: Transporter
       byte ship_cougar_header%%256,ship_cougar_header//256          ; $1E: Cougar
       byte ship_constrictor_header%%256,ship_constrictor_header//256 ; $1F: Constrictor

********************************************************************************
* Scratch buffer
* 
* Used for different things at different times: #R$34A8 shifts a character's
* pattern here before printing it; #R$3DF4 and #R$3EAD keep the filled disc's
* ragged edge here ($E600-$E604); and #R$8205 and #R$8F25 use the first few
* bytes too. It is also the start of the vertex cache (#R$E61D).
       .msxalign >e600
scratch_buffer:                                            ; >e600
       byte >00                                                      ; 
scratch_buffer_1:                                          ; >e601
       byte >00                                                      ; 

********************************************************************************
* "No previous point yet" gate (Bresenham circle-line connector)
* 
* #R$5584 (connect_circle_point) skips drawing a line from the cached
* previous point unless this is set - see its own header.
circle_connector_no_prev_point_gate:                       ; >e602
       byte >00

********************************************************************************
* Reused 16-byte scratch buffer, $E600-$E60F
* 
* Remainder of #R$E600's buffer - see that entry's own comment.
lineplot_scratch_vars_e603:                                ; >e603
       byte >00                                                      ; 
scratch_buffer_4:                                          ; >e604
       byte >00                                                      ; 
scratch_buffer_5:                                          ; >e605
       byte >00,>00,>00,>00,>00,>00                                  ; 
       byte >00,>00,>00,>00,>00

********************************************************************************
* Unused
* 
