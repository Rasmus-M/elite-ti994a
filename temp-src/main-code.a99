sound_effect_13:                                           ; >7977
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >03,>0C                                                  ; command 3: volume 12
       byte >02,>50,>00                                              ; command 2: tone period 80
       byte >04,>0F                                                  ; command 4: countdown 15
       byte >05,>02                                                  ; command 5: parameter 2
       byte >00,>8A,>79                                              ; command 0: per-frame handler #R$798A
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 13: per-frame handler
* 
* Sets the volume to the countdown (#R$E897), so it fades out. When that runs
* out, restarts it at 15 with tone period 120, and ends the effect (#R$740C)
* after #R$E89B blips.
sound_effect_13_handler:                                   ; >798a
       movb @sound_channel_countdown,a                     ; LD A,($E897)      ; 
       .call @cache_write_channel_data_byte_sound          ; CALL $74EC        ; set the volume to the countdown (#R$74EC)
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       li   hl,>0078                                       ; LD HL,$0078       ; 
       .call @write_16_bit_tone_period_psg                 ; CALL $74F6        ; at 0: tone period 120
       movb @bytes+>0f,a                                   ; LD A,$0F          ; 
       movb a,@sound_channel_countdown                     ; LD ($E897),A      ; and restart the countdown at 15
       li   hl,sound_channel_parameter                     ; LD HL,$E89B       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer blip
       jne  !                                              ; JP Z,$740C        ; none left - end the effect (#R$740C)
       b    @end_sound_effect                              ;                   
!
       .ret                                                ; RET               ; 

********************************************************************************
