system_search_point:                                       ; >e61b
       byte >00,>00

********************************************************************************
* Vertex cache
* 
* The screen positions (two words) of the vertices #R$49FD has projected while
* drawing an object, 4 bytes each, at $E600 + 4 * the vertex number - so the
* cache starts at $E600, sharing its first 29 bytes with the variables at
* #R$E600-#R$E61B, which aren't used while an object is being drawn.
vertex_cache:                                              ; >e61d
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00

********************************************************************************
* Vertex cache: address of the slot being written
* 
* The high byte is always $E6 (#R$422E); #R$49FD sets the low byte to 4 * the
* vertex number. On the TI it's the full address of the slot in scratch_buffer,
* as a big-endian word.
vertex_cache_slot:                                         ; >e6c8
       data 0

********************************************************************************
* Unused
* 
* Nothing has been found that uses them.
unused_e6ca:                                               ; >e6ca
       byte >00,>00

********************************************************************************
* Logarithms of the side vector
* 
* The x, y and z of the object's side vector (#R$F7D4) as sign-tagged
* logarithms (#R$1FCF), cached by #R$433F for #R$4464.
* Unlike the other variables, the words are big-endian, for word access.
side_vector_logs:                                          ; >e6cc
       data 0
side_vector_log_y:                                         ; >e6ce
       data 0
side_vector_log_z:                                         ; >e6d0
       data 0

********************************************************************************
* Logarithms of the roof vector
* 
* The x, y and z of the object's roof vector (#R$F7E0) as sign-tagged
* logarithms (#R$1FCF), cached by #R$433F for #R$4464.
* Unlike the other variables, the words are big-endian, for word access.
roof_vector_logs:                                          ; >e6d2
       data 0
roof_vector_log_y:                                         ; >e6d4
       data 0
roof_vector_log_z:                                         ; >e6d6
       data 0

********************************************************************************
* Object's position in the view: x
* 
* Set by #R$422E (at $4255) from the object's position, converted to the
* current view (#R$44E5).
view_x:                                                    ; >e6d8
       data 0

********************************************************************************
* Object's position in the view: z * 2
* 
* Twice #R$E6DC, set by #R$422E (at $4255) and #R$43C2: the depth that #R$44D2
* adds to a vertex and #R$46CA projects with.
view_z2:                                                   ; >e6da
       data 0

********************************************************************************
* Object's position in the view: z
* 
* Set by #R$422E (at $4255); negative if the object is behind the player.
view_z:                                                    ; >e6dc
       data 0

********************************************************************************
* Explosion: random table pointer
* 
* Where #R$47A1 reads the next pair of random numbers for an explosion's dots,
* set by #R$4AEC.
explosion_random_pointer:                                  ; >e6de
       byte >00,>00

********************************************************************************
* On-screen check: left edge
* 
* The object's x on screen minus its radius, biased by $8000, worked out by
* #R$4A99.
on_screen_left:                                            ; >e6e0
       data 0

********************************************************************************
* On-screen check: right edge
* 
* The object's x on screen plus its radius, biased by $8000, worked out by
* #R$4A99.
on_screen_right:                                           ; >e6e2
       data 0

********************************************************************************
* On-screen check: top edge
* 
* The object's y on screen plus its radius, biased by $8000, worked out by
* #R$4A99.
on_screen_top:                                             ; >e6e4
       data 0

********************************************************************************
* On-screen check: bottom edge
* 
* The object's y on screen minus its radius, biased by $8000, worked out by
* #R$4A99.
on_screen_bottom:                                          ; >e6e6
       data 0

********************************************************************************
* Unused
* 
* Nothing has been found that uses them.
unused_e6e8:                                               ; >e6e8
       byte >00,>00

********************************************************************************
* Face visibility: workspace
* 
* A sign-magnitude value #R$4873 keeps while it works out the dot product.
face_visible_workspace_1:                                  ; >e6ea
       data 0

********************************************************************************
* Face visibility: more workspace
* 
* Another sign-magnitude value #R$4873 keeps while it works out the dot
* product.
face_visible_workspace_2:                                  ; >e6ec
       data 0

********************************************************************************
* Number of edges skipped
* 
* #R$491A adds 1 for each edge it skips because the edge's first vertex has
* bit 7 set (at $4948), and takes 1 off when the edge turns up again in
* another face (at $4962). Nothing reads it otherwise, so it has no effect.
skipped_edges_count:                                       ; >e6ee
       byte >00

********************************************************************************
* Object's targetable area on the screen
* 
* The object's targetable area (#R$F800) projected by #R$46CA: how close to
* the centre of the view its x and y must be for it to be in the laser sights.
* #R$46CA writes it as a word, so the high byte (always 0) goes into #R$E6F0.
targetable_area:                                           ; >e6ef
       byte >00

********************************************************************************
* Vector-cache-valid flag
* 
* Cleared by #R$422E alongside #R$E6F3, set by #R$433F once it
* refreshes the cached vectors at $EB68-$EB6C, and checked by
* #R$43C2's redraw gate before deciding whether to call #R$433F again.
vector_cache_valid_flag:                                   ; >e6f0
       byte >00

********************************************************************************
* Logarithm of the object's depth
* 
* Set by #R$46CA and #R$47C4, for projecting (#R$47F0).
log_depth:                                                 ; >e6f1
       byte >00,>00

********************************************************************************
* "Nothing changed" flag (redraw gate)
* 
* Cleared and, separately, set to $FF by #R$422E (to mark the current
* frame's projection as unchanged, skipping #R$4255); read by #R$43C2's
* redraw gate, which bails out early if this is already set. Within
* the same "nothing moved this frame" mechanism as #R$E92D.
nothing_changed_flag:                                      ; >e6f3
       byte >00

********************************************************************************
* Unused
* 
* Nothing has been found that uses them.
unused_e6f4:                                               ; >e6f4
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00

********************************************************************************
* Pixel bit-mask table
* 
* 8 single-bit masks, $80 down to $01 - one bit set per byte-position
* within a screen byte. Copied from $1187 at startup (see #R$7045's
* step 4). #R$3C48/#R$3CFD's line-drawing code looks this up via IX
* (see #R$372B/#R$4D4D/#R$4DEA), indexed by a coordinate's low 3 bits
* via a self-modified operand at $3D07.
pixel_bitmask_table:                                       ; >e700
       byte >80,>40,>20,>10,>08,>04,>02,>01

********************************************************************************
* Star-chart cursor step-size tier (0-8)
* 
* Shared by both chart-like screens ($E902=4, drawn by #R$4D0B/#R$4D6C
* using the current galaxy number #R$EB66; and $E902=6, drawn by
* #R$4FA2's cluster, which checks systems against the hyperspace
* target #R$EB67). Reset to
* 1 by #R$73BA whenever the combined keyboard/joystick nibble it reads
* from ($E8F4) is $0F (nothing held); otherwise #R$73CE increments it
* (capped at 8) every #R$E70C'th call, so holding a direction steadily
* accelerates the cursor's step size - classic auto-repeat-acceleration
* cursor control. Read by #R$7373 as the step added to/subtracted from
* #R$E709/#R$E70A each nudge.
chart_cursor_step_tier:                                    ; >e708
       byte >01

********************************************************************************
* Star-chart cursor sprite: X position
* 
* Low byte of the word #R$540D writes directly (to place the cursor
* immediately) and #R$7373/#R$7396 nudge a step at a time toward $11
* (17) or $E0 (224) depending on which directional bit is held.
* #R$73A6 writes this pair to VDP sprite slot 4 (VRAM $1B10-$1B11)
* each time it's touched; #R$4D8A sets up the sprite's whole entry
* (Y/X/pattern/colour) from the table at $5658.
chart_cursor_x:                                            ; >e709
       byte >00

********************************************************************************
* Star-chart cursor sprite: Y position
* 
* High byte of the same word as #R$E709 - see its description. Nudged
* toward $00 or $9F (159).
chart_cursor_y:                                            ; >e70a
       byte >00

********************************************************************************
* Chart cursor on
* 
* Set ($FF) by #R$4D6C (entering the $E902=4 screen) and #R$501E, a
* mid-block entry in #R$5014's routine (entering the $E902=6 screen);
* cleared by #R$6097 (leaving
* either screen for another) and #R$63F1 (returning to flight). Gates
* #R$73BA - called from #R$7202's VBLANK handler only on frames where
* neither ($E91B) nor ($EF9E) is set (see #R$7202's own header) - so
* the #R$E708/#R$E709/#R$E70A cursor-nudge mechanism only runs on
* those gated frames, and is a no-op whenever this flag is clear.
chart_cursor_active_flag:                                  ; >e70b
       byte >00

********************************************************************************
* Star-chart cursor movement countdown (7-frame period)
* 
* Decremented each time #R$73CE actually runs (i.e. each gated VBLANK
* call while #R$E70B is set and a direction is held - #R$73CE isn't
* reached at all when the input nibble is $0F); on reaching 0, resets
* to 7 and advances #R$E708's acceleration tier (capped at 8).
chart_cursor_countdown:                                    ; >e70c
       byte >01

********************************************************************************
* Unused counter
* 
* Cleared by #R$3548, and incremented and decremented again around printing a
* system's label (#R$50CE); nothing reads it.
unused_counter_e70d:                                       ; >e70d
       byte >00

********************************************************************************
* Cursor position: sub-pixel bit offset (0-7)
* 
* The low 3 bits of #R$3548's (set_cursor_position) B*6 stride (or
* #R$3564's (set_cursor_position_combined) A*6); read back by #R$34A8
* to shift a glyph's pixels before plotting it - see that routine's
* header comment.
cursor_subpixel_offset:                                    ; >e70e
       byte >00

********************************************************************************
* Text cursor: column
* 
* Text is printed in 6-pixel-wide characters, 42 to a line. This and
* #R$E710 form the address in the pattern table to print the next
* character at: the column * 6 rounded down to a multiple of 8, with the
* remaining pixels in $E70E. Set by #R$3548 and #R$3564.
cursor_vram_addr:                                          ; >e70f
       byte >00

********************************************************************************
* Text cursor: row
* 
* The text row to print on (the high byte of the address, see #R$E70F).
* Set by #R$3548; #R$6066, #R$6189 and #R$6377 set it to 1 directly and
* then just the column (#R$3564), to centre a title on row 1.
cursor_vram_addr_row:                                      ; >e710
       byte >00

********************************************************************************
* Galaxy seeds
* 
* The three 16-bit seeds of system 0 in the current galaxy (#R$5607),
* from which all the systems are generated (#R$4C9B). Each byte is
* rotated left on a galactic jump (#R$894D), as in BBC Elite.
galaxy_seeds:                                              ; >e711
       byte >00,>00,>00,>00,>00,>00

********************************************************************************
* Text buffer
* 
* Where #R$36E1 formats a number (#R$3675) and #R$4CB8 generates a system's
* name, ready for printing.
text_buffer:                                               ; >e717
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00

********************************************************************************
* Jump-in-progress flag
* 
* Set by #R$86E6 (in-system jump) and #R$894D (hyperspace); while set,
* #R$872E draws the stardust several times per frame, as streaks.
jump_in_progress:                                          ; >e722
       byte >00

********************************************************************************
* Stardust passes per frame during a jump
* 
* Ramped from 1 toward 7 by #R$872E, lengthening the stardust streaks; read by #R$894D's
* own outer loop to decide when to stop forcing its DJNZ counter back to 60.
stardust_passes:                                           ; >e723
       byte >00

********************************************************************************
* Price of fuel
* 
* The current system's price of fuel, per tenth of a light year: s0_lo
* AND 15 (#R$4BA8). Used when buying fuel (#R$5E7D).
fuel_price:                                                ; >e724
       byte >00

********************************************************************************
* Distance to the sun
* 
* Worked out each frame by #R$887F (via #R$883D) - in the supernova
* mission less #R$E93E - and turned into the cabin temperature (#R$1577).
sun_distance:                                              ; >e725
       byte >00,>00

********************************************************************************
* Distance to the planet
* 
* Worked out each frame by #R$883D, and turned into the altitude
* (#R$1577). Also decides whether the ship is in the space station's safe
* zone (#R$1549) and whether the Torus Jump Drive works (#R$86E6).
planet_distance:                                           ; >e727
       byte >00,>00

********************************************************************************
* Distance to the space station
* 
* Worked out each frame by #R$88A1 (via #R$883D). Its high byte ($E72A)
* decides whether ships are launched from the station (#R$2B24, #R$2B24).
station_distance:                                          ; >e729
       byte >00                                                      ; 
station_distance_hi:                                       ; >e72a
       byte >00                                                      ; 

********************************************************************************
* Selected system index
* 
* The system selected on the charts (the hyperspace target). Set to the
* current system (#R$EB67) by 'B'/HOME (#R$52A4), and copied to it on
* arrival after a jump (#R$894D).
selected_system:                                           ; >e72b
       byte >00

********************************************************************************
* Text cursor column
* 
* Stashed (unscaled) by #R$3548/#R$3564 when the cursor position is
* set, then incremented by #R$34A8's glyph-plot tail after each
* character; read back at $3609/$3623/$3650 to step the cursor back
* the column that a plot just advanced it by (undoing the auto-
* advance for a redraw/erase pass).
cursor_column:                                             ; >e72c
       byte >00

********************************************************************************
* Text-cursor blink countdown
* 
* Reset to 1 by #R$3619's caller before the blink loop starts - see
* that routine's own header.
cursor_blink_countdown:                                    ; >e72d
       byte >00

********************************************************************************
* Text-cursor blink-phase flag (0=erased, complemented each step)
* 
* See #R$3619's own header: reset to 0 (erased) before the blink loop
* starts, complemented on each step to track which state ("on" or
* "erased") the cursor glyph is currently in.
cursor_blink_phase_flag:                                   ; >e72e
       byte >00

********************************************************************************
