********************************************************************************
* MSX BIOS work area
* 
* Starts with the BIOS's interslot routines RDPRIM ($F380), WRPRIM
* ($F385) and CLPRIM ($F38C), which the game doesn't use; in this snapshot
* they are partly overwritten by the tune-restart bug (see #R$7603). The
* BIOS's variables follow, among them RG1SAV (#R$F3E0).
bios_work_area:                                            ; >f380
       byte >01,>00,>00,>18,>03,>D3,>A8,>73
       byte >7A,>01,>A8,>C9,>06,>06,>11,>01
       byte >00,>00,>08,>F1,>D3,>A8,>08,>C9
       byte >01,>E9,>00,>06,>06,>11,>01,>00
       byte >00,>00,>00,>00,>00,>00,>00,>01
       byte >00,>00,>06,>06,>11,>01,>00,>00
       byte >1D,>18,>00,>00,>00,>00,>01,>00
       byte >08,>06,>06,>11,>01,>00,>00,>00
       byte >20,>00,>00,>00,>1B,>01,>38,>00
       byte >06,>06,>11,>01,>00,>00,>1B,>00
       byte >38,>00,>08,>00,>01,>00,>00,>06
       byte >06,>11,>01,>00,>00,>01,>00,>02

********************************************************************************
* RG1SAV: copy of VDP register 1
* 
* The MSX BIOS's copy of VDP register 1. #R$6F9F sets the sprite size to
* 16x16 in it, and #R$70E8 clears bit 6 (blanking the screen) and writes it
* to the VDP.
vdp_reg1_cache:                                            ; >f3e0
       byte >E2

********************************************************************************
* MSX BIOS work area: VDP register copies, colours and key queue
* 
* MSX BIOS variables. The game doesn't use them, and the BIOS ROM is only
* ever paged in (#R$A511) for the tape routines, which don't use them
* either. In this snapshot $F3E3, $F3E6-$F3EB, $F3F2 and $F3F5-$F3FA have
* been overwritten by the tune-restart bug (see #R$7603).
bios_vars_f3e1:                                            ; >f3e1
       byte >06,>FF,>01,>36,>07,>07                                  ; RG2SAV-RG7SAV: copies of VDP registers 2-7
       byte >07,>11,>72,>00,>00                                      ; STATFL, TRGFLG, FORCLR, BAKCLR, BDRCLR
       byte >00,>00,>00                                              ; MAXUPD (a JP instruction)
       byte >00,>00,>00                                              ; MINUPD (a JP instruction)
       byte >01                                                      ; ATRBYT
       byte >59,>F9                                                  ; QUEUES
       byte >07,>07,>11                                              ; FRCNEW, SCNCNT, REPCNT
       byte >72,>00                                                  ; PUTPNT: key buffer write pointer
       byte >00,>FB                                                  ; GETPNT: key buffer read pointer

********************************************************************************
* Cassette parameters for the BIOS tape routines
* 
* MSX BIOS variables that set the timing of the tape signal. CS120 holds two
* 5-byte sets, for 1200 and 2400 baud; the BIOS copies one of them to LOW,
* HIGH and HEADER, which TAPOON and TAPOUT use when the game saves a commander
* (#R$A4CA). When loading (#R$A492), TAPION works out the timing from the
* tape's own header instead. The game itself doesn't use them.
* .
* In the snapshot taken when #R$6F9F runs they hold CS120 =
* $53,$5C,$26,$2D,$0F and $25,$2D,$0E,$16,$1F, and LOW-HEADER =
* $53,$5C,$26,$2D,$0F (1200 baud). In this snapshot the 1200-baud set is
* already zero when the game starts, and the tune-restart bug (see
* #R$7603) has overwritten $F401 and $F404-$F409, including LOW and HIGH,
* so a commander saved from this state would probably be written with the
* wrong timing.
cassette_params:                                           ; >f3fc
       byte >00,>00,>00,>00,>00                                      ; CS120: 1200 baud
       byte >01,>00,>00,>07,>07                                      ; CS120: 2400 baud
       byte >11,>72                                                  ; LOW: pulse widths for a 0 bit
       byte >00,>00                                                  ; HIGH: pulse widths for a 1 bit
       byte >00                                                      ; HEADER: length of the header tone

********************************************************************************
* MSX BIOS work area: key buffer, line buffer and BASIC variables
* 
* MSX BIOS and MSX-BASIC variables, starting with ASPCT1. They include the
* keyboard buffer (KBUF, $F41F-$F55C) and BASIC's line buffer (BUF,
* $F55E-$F65F). Nothing in the game reads or writes them, and the BIOS tape
* routines don't use them. #R$0181 jumps to $F420, inside KBUF, but nothing
* jumps to #R$0181.
bios_vars_f40b:                                            ; >f40b
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
