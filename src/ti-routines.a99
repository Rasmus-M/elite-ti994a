*********************************************************************
*
* Setup environment
*
ti_setup_environment:
;       mov  @rndsd,@pseudo_random_scrolling_counter
       li   one,>0100
       li   r0,>fffe
       mov  r0,@b255
       li   sp,ram_stack
       clr  r12                        ; Start the TMS9901 timer, counting down from >3FFF (ti_timer_frames)
       sbo  0                          ; clock mode
       li   r0,>3fff
       inct r12
       ldcr r0,14                      ; the timer's start value
       dect r12
       sbz  0                          ; back to I/O mode: the timer runs
       .proc
       bl   @init_bits
       bl   @clear_pad
       bl   @copy_to_pad
       bl   @graphics_mode
       li   r0,>1b80                   ; The view messages read their font from VRAM >1A80 + 8 * code
       bl   @vwad
       .select_bank view_font_bank_select ; It is in ROM bank 5
       li   r1,view_font
       li   r2,96*8                    ; Codes >20->7F
ti_setup_environment_1:
       movb *r1+,@vdpwd
       dec  r2
       jne  ti_setup_environment_1
       .select_bank font_bank_select   ; The rest are in ROM bank 6
       li   r0,>19e0                   ; The small ships' sprite patterns (ship_sprite), also in ROM bank 6:
       bl   @vwad                      ; the first 13 are sprite patterns 60 on
       li   r1,ship_sprite_patterns
       li   r2,ship_sprite_patterns_2-ship_sprite_patterns
ti_setup_environment_2:
       movb *r1+,@vdpwd
       dec  r2
       jne  ti_setup_environment_2
       li   r0,>1e80                   ; and the rest are 208 on
       bl   @vwad
       li   r2,ship_sprite_patterns_end-ship_sprite_patterns_2
ti_setup_environment_3:
       movb *r1+,@vdpwd
       dec  r2
       jne  ti_setup_environment_3
       .endproc
*// ti_setup_environment

*********************************************************************
*
* Init bits for bit operations
*
init_bits:
       li   r0,>0100
       li   r1,bits
       li   r2,8
init_bits_1:
       mov  r0,*r1+
       sla  r0,1
       dec  r2
       jne  init_bits_1
       rt
*// init_bits

*********************************************************************
*
* Clear scratchpad
*
clear_pad:
       li   r0,pad_vars
       li   r2,pad_max-pad_vars
clear_pad_1:
       clr  *r0+
       dect r2
       jne  clear_pad_1
       rt
*// clear_pad

*********************************************************************
*
* Copy routines to pad
*
copy_to_pad:
       li   r0,copy_space_view_row
       li   r1,copy_space_view_row_pad
       li   r2,copy_space_view_row_end-copy_space_view_row
copy_to_pad_1:
       mov  *r0+,*r1+
       dect r2
       jne  copy_to_pad_1

       li   r0,clear_space_view_rows
       li   r1,clear_space_view_rows_pad
       li   r2,clear_space_view_rows_end-clear_space_view_rows
copy_to_pad_3:
       mov  *r0+,*r1+
       dect r2
       jne  copy_to_pad_3

       li   r0,line_loops
       li   r1,line_loops_pad
       li   r2,line_loops_end-line_loops
copy_to_pad_2:
       mov  *r0+,*r1+
       dect r2
       jne  copy_to_pad_2
       rt
*// copy_to_pad

*********************************************************************
*
* Set graphics mode
*
graphics_mode:
       .proc
       clr  r0
       li   r1,vdp_registers
       li   r2,8
graphics_mode_1:
       movb *r1+,@r0lb
       bl   @vwtr                      ; Set register
       ai   r0,>0100
       dec  r2
       jne  graphics_mode_1
*      Clear VDP RAM, but for the top, where the disk DSR's buffers are (ti-disk.a99)
       clr  r0
       clr  r1
       li   r2,color_table+>1800-dsr_color_max
       bl   @vsmw
*      Disable sprites
       li   r0,sprite_attr_table
       li   r1,>d000
       bl   @vsbw
*      Init color table
       li   r0,color_table
       li   r1,>f100
       li   r2,>1800
       bl   @vsmw
*      Init name tables
       li   r0,name_table
       bl   @vwad
       bl   @ti_init_name_table
       .endproc
*      VDP registers
vdp_registers:
       byte >02                        ; Graphics II mode
       byte >e2                        ; 16K, display on, interrupt enabled
       byte name_table/>400            ; Name table
       byte >ff                        ; Color table
       byte pattern_table/>800+>03     ; Pattern table
       byte sprite_attr_table/>80      ; Sprite attribute table
       byte sprite_pattern_table/>800  ; Sprite pattern table
       byte >00                        ; Backdrop color
*// graphics_mode

*********************************************************************************
*
* Initialize name table for bitmap drawing
*
ti_init_name_table:
       clr  r1
       li   r2,768
ti_init_name_table_1:
       movb r1,@vdpwd
       ai   r1,>0100
       dec  r2
       jne  ti_init_name_table_1
       rt
*// ti_init_name_table

*********************************************************************
*
* VDP Write To Register
*
* R0 MSB: VDP register to write to
* R0 LSB: Value to write
*
vwtr:
       swpb r0
       movb r0,@vdpwa                  ; Send low byte (value) to write to VDP register
       swpb r0
       ori  r0,>8000                   ; Set up a VDP register write operation (10)
       movb r0,@vdpwa                  ; Send high byte (address) of VDP register
       rt
*// vwtr

*********************************************************************
*
* VDP Set Write Address
*
* R0: Write address in VDP RAM
*
vwad:
       swpb r0
       movb r0,@vdpwa                  ; Send low byte of VDP RAM write address
       swpb r0
       ori  r0,>4000                   ; Set read/write bits 14 and 15 to write (01)
       movb r0,@vdpwa                  ; Send high byte of VDP RAM write address
       rt
*// vwad

*********************************************************************
*
* VDP Single Byte Write
*
* R0: Write address in VDP RAM
* R1: MSB of R1 sent to VDP RAM
*
vsbw:
       swpb r0
       movb r0,@vdpwa                  ; Send low byte of VDP RAM write address
       swpb r0
       ori  r0,>4000                   ; Set read/write bits 14 and 15 to write (01)
       movb r0,@vdpwa                  ; Send high byte of VDP RAM write address
       movb r1,@vdpwd                  ; Write byte to VDP RAM
       rt
*// vsbw

;*********************************************************************
;*
;* VDP multiple Byte Write
;*
;* R0: Write address in VDP RAM
;* R1: Starting read address in CPU RAM
;* R2: Number of bytes to send
;*
;vmbw:
;       swpb r0
;       movb r0,@vdpwa                  ; Send low byte of VDP RAM write address
;       swpb r0
;       ori  r0,>4000                   ; Set read/write bits 14 and 15 to write (01)
;       movb r0,@vdpwa                  ; Send high byte of VDP RAM write address
;       li   r0,vdpwd
;vmbw_1:
;       movb *r1+,*r0                   ; Write byte to VDP RAM
;       dec  r2
;       jne  vmbw_1
;       rt
;*// vmbw

;*********************************************************************
;*
;* VDP multiple Byte Write (unrolled)
;*
;* R0: Write address in VDP RAM
;* R1: Starting read address in CPU RAM
;* R2: Number of bytes to send
;*
;vmbw_unrolled:
;       swpb r0
;       movb r0,@vdpwa                  ; Send low byte of VDP RAM write address
;       swpb r0
;       ori  r0,>4000                   ; Set read/write bits 14 and 15 to write (01)
;       movb r0,@vdpwa                  ; Send high byte of VDP RAM write address
;       li   r0,vdpwd
;       srl  r2,3
;vmbw_unrolled_1:
;       movb *r1+,*r0                   ; Write byte to VDP RAM
;       movb *r1+,*r0                   ; Write byte to VDP RAM
;       movb *r1+,*r0                   ; Write byte to VDP RAM
;       movb *r1+,*r0                   ; Write byte to VDP RAM
;       movb *r1+,*r0                   ; Write byte to VDP RAM
;       movb *r1+,*r0                   ; Write byte to VDP RAM
;       movb *r1+,*r0                   ; Write byte to VDP RAM
;       movb *r1+,*r0                   ; Write byte to VDP RAM
;       dec  r2
;       jne  vmbw_unrolled_1
;       rt
;*// vmbw_unrolled

*********************************************************************
*
* Mark the whole space view as drawn in and as on the screen, so that
* all of it is cleared and copied the next time (see view_mark_line in
* main-code.a99). Changes R1.
*
view_mark_all:
       clr  @star_sprite_count         ; and no stardust sprites
       clr  @ship_sprite_count         ; and no small ships
       li   r1,30
view_mark_all_1:
       mov  @view_cells_from,@view_cells(r1); all 11 cells
       mov  @view_cells_from,@view_prev_cells(r1)
       dect r1
       jgt  view_mark_all_1
       jeq  view_mark_all_1
       rt
*// view_mark_all

*********************************************************************
*
* Fill a row of a disc (#R$3F68, #R$3F9F, #R$3FC7)
*
* For the filled disc that the sun and far away objects are drawn as
* (#R$3DF4): sets the pixels of a row of the space view's buffer from the
* left column (#R$EB92) to the right column (#R$EB96), and marks them as
* drawn in (see view_mark_line in main-code.a99). Does nothing if the row
* is outside the view. Written for the TI: the MSX jumps into 32 unrolled
* instructions to fill the whole bytes.
*
* I:HL The row, as the disc's y: >8000 is the middle of the view (row 64),
* .    >8040 its top and >7FC1 its bottom
* Changes R0-R2, A, DE and HL.
*
fill_disc_row_span:
       ci   hl,>7fc1
       jl   fill_disc_row_span_6       ; below the view
       ci   hl,>8041
       jhe  fill_disc_row_span_6       ; above it
       li   r0,>4000
       sb   @l,r0
       srl  r0,8                       ; R0 = the row: >40 - the low byte
       clr  r1
       movb @clip_point1_x+1,r1
       swpb r1                         ; R1 = the left column
       clr  r2
       movb @clip_point2_x+1,r2
       swpb r2                         ; R2 = the right column
       ci   r2,175                     ; (the last column of the view)
       jle  fill_disc_row_span_1
       li   r2,175
fill_disc_row_span_1:
       c    r1,r2
       jh   fill_disc_row_span_6       ; nothing to fill
       mov  r0,de
       srl  de,2
       andi de,>001e                   ; DE = the character row * 2: mark what is drawn in
       mov  r1,a
       srl  a,3
       andi a,>001e                    ; A = the first cell * 2
       mov  r2,hl
       srl  hl,3
       andi hl,>001e                   ; HL = the last
       mov  @view_cells_from(a),a
       szc  @view_cells_to_inv(hl),a
       soc  a,@view_cells(de)
       sla  r0,5
       ai   r0,space_view_buffer       ; R0 -> the row in the buffer
       mov  r1,hl
       srl  hl,3
       a    r0,hl                      ; HL -> the byte of the left column
       mov  r2,de
       srl  de,3
       a    r0,de                      ; DE -> the byte of the right column
       andi r1,7
       andi r2,7
       movb @partial_byte_right_mask_table_8(r1),r0 ; R0 = the pixels from the left column to the end of its byte
       movb @partial_byte_right_mask_table_8(r2),a
       srl  a,1
       inv  a                          ; A = the pixels from the start of its byte to the right column
       c    hl,de
       jne  fill_disc_row_span_4
       inv  a                          ; Both in one byte: the pixels that are in both
       szcb a,r0
       socb r0,*hl
       rt
fill_disc_row_span_4:
       socb r0,*hl+                    ; The left byte,
fill_disc_row_span_5:
       c    hl,de
       jeq  fill_disc_row_span_7
       movb @b255,*hl+                 ; the whole bytes between,
       jmp  fill_disc_row_span_5
fill_disc_row_span_7:
       socb a,*hl                      ; and the right byte
fill_disc_row_span_6:
       rt
*// fill_disc_row_span

view_cells:                            ; For each character row of the space view: the cells drawn in (see
       data >ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0 ; view_mark_line in main-code.a99); all of them at first
       data >ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0
view_prev_cells:                       ; The same for what was copied to the screen last
       data >ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0
       data >ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0,>ffe0
       bss  32                         ; (and, while copying, what will be)
view_cell_bit:                         ; The bit of each of the 11 cells (two characters) of a row
       data >8000,>4000,>2000,>1000,>0800,>0400,>0200,>0100,>0080,>0040,>0020
view_cells_from:                       ; The bits of the cells from each cell on
       data >ffe0,>7fe0,>3fe0,>1fe0,>0fe0,>07e0,>03e0,>01e0,>00e0,>0060,>0020
view_cells_to_inv:                     ; The bits of the cells after each cell
       data >7fe0,>3fe0,>1fe0,>0fe0,>07e0,>03e0,>01e0,>00e0,>0060,>0020,>0000

*********************************************************************
*
* Copy one character row of the space view buffer to the VDP
* (the inner loop of copy_space_view). Copied to scratchpad at
* copy_space_view_row_pad, where it runs without wait states.
*
* HL: Buffer address of the row's first character, advanced past it
* B: Number of characters (MSB)
* R2: VDPWD
*
copy_space_view_row:
       movb *hl,*r2
       movb @>20(hl),*r2
       movb @>40(hl),*r2
       movb @>60(hl),*r2
       movb @>80(hl),*r2
       movb @>a0(hl),*r2
       movb @>c0(hl),*r2
       movb @>e0(hl),*r2
       inc  hl
       sb   one,b
       jne  copy_space_view_row
       rt
copy_space_view_row_end:
       equ  $

*********************************************************************
*
* Clear the space view buffer's rows (the loop of clear_space_view).
* Copied to scratchpad at clear_space_view_rows_pad.
*
* HL: Buffer address of the first row
* R0: Number of rows
*
clear_space_view_rows:
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       ai   hl,10                      ; Skip the other 10 bytes of the row
       dec  r0
       jne  clear_space_view_rows
       rt
clear_space_view_rows_end:
       equ  $

*********************************************************************
*
* The pixel loops of the line drawing (setup_bresenham_line), copied to
* scratchpad at line_loops_pad. The rotate instructions and the plot
* operations are patched there. The plot is a single SOCB to the buffer; for
* the tunnel rings (#R$6CB2), which are drawn with XOR, it and the SB after it
* are patched to BL @line_xor_plot (R11 is free: the loops return with .ret).
*
* HL: Buffer address   R0 (MSB): Error term   R1 (MSB): Pixel mask
* R2: Column step (+1/-1)   B: Pixel count   D: dy   E: dx
*
line_loops:                             ; The shallow loop
       srl  r1,1                       ; Rotate the pixel mask (patched)
       movb r1,r1
       jne  line_shallow_error_term    ; No byte boundary crossed
       mov  @line_mask_wrap,r1         ; The mask wraps round...
       a    r2,hl                      ; ...and the pointer steps a byte
line_shallow_error_term:
       sb   d,r0                       ; Error term -= dy
       joc  line_shallow_plot          ; Still non-negative - no row step
       ab   @e,r0                      ; Add dx back...
       ai   hl,>20                     ; ...and step a row
line_shallow_plot:
       socb r1,*hl                     ; OR in the pixel (these two instructions are patched
       sb   one,b                      ; to a call of line_xor_plot by #R$6CB2)
       jne  line_loops
       .ret
line_steep_loop:
       ai   hl,>20                     ; Step a row (every pixel)
       sb   @e,r0                      ; Error term -= dx
       joc  line_steep_plot            ; Still non-negative - no column step
       ab   d,r0                       ; Add dy back
line_steep_rotate:
       srl  r1,1                       ; Rotate the pixel mask (patched)
       movb r1,r1
       jne  line_steep_plot            ; No byte boundary crossed
       mov  @line_mask_wrap,r1         ; The mask wraps round...
       a    r2,hl                      ; ...and the pointer steps a byte
line_steep_plot:
       socb r1,*hl                     ; OR in the pixel (patched likewise)
       sb   one,b
       jne  line_steep_loop
       .ret
line_loops_end:
       equ  $
line_shallow_plot_op:                  ; The patched plot operations
       equ  line_shallow_plot
line_steep_plot_op:
       equ  line_steep_plot
* The loops' entry points and patched instructions in scratchpad
line_shallow_rotate_pad:
       equ  line_loops_pad
line_shallow_plot_op_pad:
       equ  line_loops_pad+line_shallow_plot_op-line_loops
line_steep_loop_pad:
       equ  line_loops_pad+line_steep_loop-line_loops
line_steep_rotate_pad:
       equ  line_loops_pad+line_steep_rotate-line_loops
line_steep_plot_op_pad:
       equ  line_loops_pad+line_steep_plot_op-line_loops

*********************************************************************
*
* VDP Single Byte Multiple Write
*
* R0: Write address in VDP RAM
* R1: MSB of R1 sent to VDP RAM
* R2: Number of bytes to write to VDP RAM
*
vsmw:
       swpb r0
       movb  r0,@vdpwa                 ; Send low byte of VDP RAM write address
       swpb r0
       ori  r0,>4000                   ; Set read/write bits 14 and 15 to write (01)
       movb r0,@vdpwa                  ; Send high byte of VDP RAM write address
       li   r0,vdpwd
vsmw_1:
       movb r1,*r0                     ; Write byte to VDP RAM
       dec  r2                         ; Byte counter
       jne  vsmw_1
       rt
*// vsmw

;*********************************************************************
