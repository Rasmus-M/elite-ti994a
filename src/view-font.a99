********************************************************************************
* Font for the view messages: 8x8 character bitmaps for codes $20-$7F
*
* The MSX reads the view messages' characters (#R$3A03) from VRAM ($1A80 +
* 8 * code), where the game has a bold font of its own, not the one it prints
* the pages with (#R$0A9F). This is a copy of VRAM $1B80-$1E7F as it is in
* the game (../elite-msx-skoolkit/snapshot/elite.vram.bin). Only the codes the
* messages use have glyphs: the space, "!", "-", ".", the digits, ":", "?",
* the letters, and $60, the copyright sign; the rest hold whatever is in
* VRAM there on the MSX (or nothing, from $7B on). On the TI, $7C-$7F are also
* the stardust's 16x16 sprite pattern (star_sprite_pattern): a dot in $7C.
* .
* On the TI it's in ROM bank 5 (view_font_bank_select), and ti_setup_environment
* copies it to VRAM >1B80.
view_font:
       byte >00,>00,>00,>00,>00,>00,>00,>00                          ; space
       byte >00,>1C,>1C,>1C,>18,>18,>00,>18                          ; "!"
       byte >91,>4E,>C3,>02,>54,>C3,>3C,>4F                          ; $22 (not a glyph)
       byte >C3,>3F,>4F,>C3,>05,>52,>C3,>1F                          ; $23 (not a glyph)
       byte >51,>C3,>12,>50,>C3,>91,>4E,>C3                          ; $24 (not a glyph)
       byte >14,>4F,>C3,>B1,>39,>C3,>91,>4E                          ; $25 (not a glyph)
       byte >C3,>91,>4E,>C3,>91,>4E,>C3,>79                          ; $26 (not a glyph)
       byte >3A,>C3,>22,>55,>C3,>B3,>55,>C3                          ; $27 (not a glyph)
       byte >1A,>54,>C3,>B0,>55,>C3,>B3,>55                          ; $28 (not a glyph)
       byte >C3,>66,>52,>C3,>3A,>51,>C3,>21                          ; $29 (not a glyph)
       byte >50,>C3,>A0,>56,>C3,>62,>55,>C3                          ; $2A (not a glyph)
       byte >B1,>39,>C3,>F7,>54,>C3,>FC,>54                          ; $2B (not a glyph)
       byte >C3,>F7,>55,>C3,>79,>3A,>C3,>78                          ; $2C (not a glyph)
       byte >00,>00,>00,>7E,>7E,>00,>00,>00                          ; "-"
       byte >00,>00,>00,>00,>00,>00,>18,>18                          ; "."
       byte >C3,>45,>51,>C3,>3B,>58,>C3,>31                          ; $2F (not a glyph)
       byte >00,>7E,>C6,>CE,>D6,>E6,>C6,>FC                          ; "0"
       byte >00,>38,>18,>18,>18,>18,>18,>38                          ; "1"
       byte >00,>FE,>06,>06,>7C,>C0,>C0,>FE                          ; "2"
       byte >00,>3E,>06,>06,>7E,>06,>06,>FC                          ; "3"
       byte >00,>42,>C6,>C6,>FE,>06,>06,>04                          ; "4"
