********************************************************************************
* Title screen
*
* Used by the routines at #R$0106 and #R$9120.
* .
* Called by the main loop (#R$0106), and by #R$9120 for a mission briefing.
* Switches to the front view (#R$64A1), which also draws the cockpit
* screen, and marks the game as in flight (($E903)) with the main loop's
* per-frame pass off (($E90A)).
* .
* Normally, turns sound effects off, starts the title music (#R$7603), and
* shows the spinning "ELITE" letters (#R$1E01). Then shows each of the 14
* ships in #R$1F40 in turn: each one flies in from a distance of 2000 to a
* distance that depends on its size, turns this way and that for 150
* frames, then flies off, with its name and "Load New Commander ?" shown
* underneath. After the last ship it starts again with the letters. It only
* leaves when Y or N is pressed ($1DB5), jumping to the load commander
* screen or the docked screen.
* .
* For a mission briefing (($E93D) = $10, from #R$9120) it shows just the
* ship in #R$1F4F, with "Hit key for mission", and returns when any key is
* pressed.
* .
* At $1D3D, moves the ship in by 120 each frame until it reaches the
* distance in ($E888), then turns it about two axes by angles that swing
* back and forth (#R$1DDC). Counts down the 150 frames in ($E88B), and then
* starts the ship flying off (($E88C)). Then checks for a key (($E8F5)):
* for a mission briefing any key returns; otherwise Y or N goes to $1DB5,
* and anything else is ignored. Loops back for the next frame at #R$1CF4.
* .
* At $1DB5, stops the music (#R$7438), sets up the commander record
* (#R$A469), turns sound effects back on, and clears $EEC1, $E940, $EF8E
* and $E90C. Then Y ($E924 = $FF) goes to the load commander screen
* (#R$A30A), and N to the docked screen (#R$6276), starting with the
* default commander.
title_screen:                                              ; >1c5c
       limi 0                                              ; DI                ; backdrop colour 1 (black)
       movb one,a                                          ; LD A,$01          ;
       movb a,@vdpwa                                       ; OUT ($99),A       ;
       movb @bytes+>87,a                                   ; LD A,$87          ;
       movb a,@vdpwa                                       ; OUT ($99),A       ;
       ; EI                                                ; EI                ; TODO: check code.
       sb   a,a                                            ; XOR A             ;
       movb a,@docked                                      ; LD ($E90A),A      ;
       sb   one,a                                          ; DEC A             ;
       movb a,@e940_gate_flag                              ; LD ($E940),A      ; $E940 = $FF
       .call @switch_to_front_view                         ; CALL $64A1        ; switch to the front view (drawing the cockpit screen)
       movb @b255,a                                        ; LD A,$FF          ;
       movb a,@space_view_showing                          ; LD ($E903),A      ; space view showing...
       movb a,@docked                                      ; LD ($E90A),A      ; ...and docked
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       jeq  title_screen_mission                           ; JR Z,$1C93        ; mission briefing - #R$1C93
       li   hl,options                                     ; LD HL,$E914       ;
       szcb @bit0,*hl                                      ; RES 0,(HL)        ; turn sound effects off (see #R$7468)
       li   hl,title_music                                 ; LD HL,$7AE4       ;
       .call @start_tune                                   ; CALL $7603        ; start the music
_1c8b:                                                     ; >1c8b
       .call @title_screen_letters                         ; CALL $1E01        ; show the spinning "ELITE" letters
       li   hl,title_ships                                 ; LD HL,$1F40       ; HL -> the list of title screen ships
       jmp  _1c96                                          ; JR $1C96          ;
title_screen_mission:                                      ; >1c93
       li   hl,mission_briefing_ship                       ; LD HL,$1F4F       ; HL -> the mission briefing ship
_1c96:                                                     ; >1c96
       mov  hl,@title_ship_ptr                             ; LD ($E890),HL     ; point at the first ship
       movb @bytes+>71,a                                   ; LD A,$71          ;
       .call @colour_space_view                            ; CALL $3A4D        ; colour the space view ($71)
title_screen_next_ship:                                    ; >1c9e
       mov  @title_ship_ptr,hl                             ; LD HL,($E890)     ; HL -> next ship in the list
       movb *hl,a                                          ; LD A,(HL)         ; A = this step's view-type byte
       socb a,a                                            ; OR A              ;
       jeq  _1c8b                                          ; JR Z,$1C8B        ; end of the list - start again with the letters
       movb *hl,a                                          ; LD A,(HL)         ;
       movb a,@ship_type                                   ; LD ($F7E7),A      ; set the object's type
       inc  hl                                             ; INC HL            ;
       mov  hl,@title_ship_ptr                             ; LD ($E890),HL     ;
       movb one,a                                          ; LD A,$01          ;
       movb a,@title_wobble_target_1                       ; LD ($E886),A      ; wobble targets start at 1
       movb a,@title_wobble_target_2                       ; LD ($E887),A      ;
       movb a,@object_status_byte                          ; LD ($F7CD),A      ;
       li   hl,title_ship_start                            ; LD HL,$1F2E       ; set its position (Z = 2000) and orientation
       li   de,object_position_x                           ; LD DE,$F7CE       ;
       li   bc,>0012                                       ; LD BC,$0012       ;
       .ldir                                               ; LDIR              ;
       .call @get_blueprint_data                           ; CALL $16E3        ; set the object up for its type (#R$16E3)
       sb   a,a                                            ; XOR A             ;
       movb a,@title_ship_arrived                          ; LD ($E88A),A      ; not arrived yet
       movb a,@title_ship_flying_off                       ; LD ($E88C),A      ; not flying off yet
       movb a,@title_wobble                                ; LD ($E884),A      ; wobble angles start at 0
       movb a,@title_wobble_angle_2                        ; LD ($E885),A      ;
       movb a,@object_status_byte                          ; LD ($F7CD),A      ;
       movb a,@handler_type                                ; LD ($F7EE),A      ;
       movb @bytes+>96,a                                   ; LD A,$96          ;
       movb a,@title_ship_frames                           ; LD ($E88B),A      ; stay for 150 frames
       movb @bp_size,a                                     ; LD A,($F805)      ; A = the ship's size
       movb a,h                                            ; LD H,A            ;
       sb   @l,@l                                          ; LD L,$00          ; HL = A:$00
       srl  h,1                                            ; SRL H             ;
       ; RR L                                              ; RR L              ; TODO: check code. HL = HL >> 2
       srl  h,1                                            ; SRL H             ;
       ; RR L                                              ; RR L              ; TODO: check code.
       movb @bytes+>2c,a                                   ; LD A,$2C          ;
       .call @divide_hl_a                                  ; CALL $2079        ; HL = size * 64 / 44
       mov  hl,@title_ship_distance                        ; LD ($E888),HL     ; the distance to fly in to
title_screen_next_frame:                                   ; >1cf4
       .call @clear_space_view                             ; CALL $388F        ; next frame: clear the space view
       movb @bytes+>d6,a                                   ; LD A,$D6          ;
       movb a,@message_row                                 ; LD ($E92C),A      ; the ship's name at the top of the view
       mov  @bp_name,hl                                    ; LD HL,($F7FB)     ;
       .call @show_view_message                            ; CALL $39C8        ; print the ship's name
_1d02:                                                     ; >1d02
       .call @count_message_timer                          ; CALL $39F1        ;
       movb @bytes+>e4,a                                   ; LD A,$E4          ;
       movb a,@message_row                                 ; LD ($E92C),A      ; the prompt at the bottom
       li   hl,msg_load_new_commander                      ; LD HL,$1ED7       ; HL = "Load New Commander ?"
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       jne  _1d17                                          ; JR NZ,$1D17       ;
       li   hl,msg_hit_key_mission                         ; LD HL,$1EF9       ; mission briefing: "Hit key for mission"
_1d17:                                                     ; >1d17
       .call @show_view_message                            ; CALL $39C8        ; print it
       .call @draw_object                                  ; CALL $422E        ; draw the ship
       .call @copy_space_view                              ; CALL $3846        ; copy the space view to the screen
       movb @title_ship_flying_off,a                       ; LD A,($E88C)      ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_frame                             ; JR Z,$1D3D        ; not flying off
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; else HL = #R$EB9E (cached_range_value)
       li   de,>0005                                       ; LD DE,$0005       ;
       s    de,hl                                          ; SBC HL,DE         ;
       jnc  !                                              ; JP C,$1C9E        ; TODO: check code. flown out of sight - next ship
       b    @title_screen_next_ship                        ;
!
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; else nudge $F7D2 towards +200...
       li   de,>00c8                                       ; LD DE,$00C8       ;
       a    de,hl                                          ; ADD HL,DE         ;
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; fly off: Z += 200
       jmp  _1d62                                          ; JR $1D62          ;
title_screen_frame:                                        ; >1d3d
       movb @title_ship_arrived,a                          ; LD A,($E88A)      ; has the ship arrived?
       socb a,a                                            ; OR A              ;
       jne  _1d62                                          ; JR NZ,$1D62       ; yes
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; no: move it closer
       li   de,>ff88                                       ; LD DE,$FF88       ;
       a    de,hl                                          ; ADC HL,DE         ;
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ;
       mov  @title_ship_distance,de                        ; LD DE,($E888)     ; DE = distance to stop at
       jhe  !                                              ; JP M,$1D5A        ;
       b    @title_screen_ship_arrived                     ;
!
       socb a,a                                            ; OR A              ;
       s    de,hl                                          ; SBC HL,DE         ;
       jnc  _1d62                                          ; JR NC,$1D62       ; TODO: check code. not there yet
title_screen_ship_arrived:                                 ; >1d5a
       mov  de,@object_position_z_lo                       ; LD ($F7D2),DE     ; there: stop at that distance
       li   hl,title_ship_arrived                          ; LD HL,$E88A       ;
       sb   one,*hl                                        ; DEC (HL)          ; and flag it as arrived
_1d62:                                                     ; >1d62
       li   hl,title_wobble                                ; LD HL,$E884       ;
       li   ix,title_wobble_target_1                       ; LD IX,$E886       ;
       .call @title_screen_swing                           ; CALL $1DDC        ; swing the first angle
       li   hl,title_wobble_angle_2                        ; LD HL,$E885       ;
       li   ix,title_wobble_target_2                       ; LD IX,$E887       ;
       .call @title_screen_swing                           ; CALL $1DDC        ; and the second
       movb @title_wobble,a                                ; LD A,($E884)      ;
       sra  a,1                                            ; SRA A             ;
       .call @pitch_object                                 ; CALL $2365        ; turn the ship
       movb @title_wobble_angle_2,a                        ; LD A,($E885)      ;
       sra  a,1                                            ; SRA A             ;
       .call @roll_object                                  ; CALL $23D9        ; about both axes
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       jeq  _1d97                                          ; JR Z,$1D97        ; mission briefing - the ship stays
       li   hl,title_ship_frames                           ; LD HL,$E88B       ;
       sb   one,*hl                                        ; DEC (HL)          ;
       jne  _1d97                                          ; JR NZ,$1D97       ;
       sb   one,a                                          ; DEC A             ;
       movb a,@title_ship_flying_off                       ; LD ($E88C),A      ; time's up: start flying off
_1d97:                                                     ; >1d97
       .call @straighten_orientation                       ; CALL $4503        ; re-orthogonalise the ship's axes
       li   hl,pending_debounced_keypress_byte_status      ; LD HL,$E8F5       ;
       movb *hl,a                                          ; LD A,(HL)         ;
       socb a,a                                            ; OR A              ;
       jeq  _1db2                                          ; JR Z,$1DB2        ; no key pressed
       movb @mission_state,a                               ; LD A,($E93D)      ;
       cb   a,@bytes+>10                                   ; CP $10            ;
       movb *hl,a                                          ; LD A,(HL)         ;
       sb   *hl,*hl                                        ; LD (HL),$00       ;
       jne  !                                              ; RET Z             ; mission briefing: any key returns
       .ret                                                ;
!
       cb   a,@bytes+>59                                   ; CP $59            ;
       jeq  title_screen_key                               ; JR Z,$1DB5        ; Y
       cb   a,@bytes+>4e                                   ; CP $4E            ;
       jeq  title_screen_key                               ; JR Z,$1DB5        ; N
_1db2:                                                     ; >1db2
       b    @title_screen_next_frame                       ; JP $1CF4          ; next frame
title_screen_key:                                          ; >1db5
       .push af                                            ; PUSH AF           ;
       .call @stop_all_sound                               ; CALL $7438        ; stop the music
       .call @unpack_commander                             ; CALL $A469        ; set up the commander record
       li   hl,options                                     ; LD HL,$E914       ;
       socb @bit0,*hl                                      ; SET 0,(HL)        ; sound effects on
       sb   a,a                                            ; XOR A             ;
       movb a,@in_witchspace                               ; LD ($EEC1),A      ;
       movb a,@e940_gate_flag                              ; LD ($E940),A      ;
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ;
       movb a,@alert_level                                 ; LD ($E90C),A      ;
       .pop af                                             ; POP AF            ;
       cb   a,@bytes+>59                                   ; CP $59            ;
       jeq  !                                              ; JP NZ,$6276       ; N - the docked screen
       b    @status_page                                   ;
!
       movb @b255,a                                        ; LD A,$FF          ;
       movb a,@load_new_commander                          ; LD ($E924),A      ;
       b    @commander_menu                                ; JP $A30A          ; Y - load a commander

********************************************************************************
* Title screen: swing an angle back and forth
*
* Used by the routine at #R$1C5C.
* .
* Steps the angle at HL by 1 towards its target at IX. On reaching it,
* picks a new random target of 20-35 with the opposite sign, so the angle
* swings back and forth by varying amounts. $1DF3 handles a negative
* target.
*
* I:HL Pointer to the angle
* I:IX Pointer to its target
title_screen_swing:                                        ; >1ddc
       movb *ix,a                                          ; LD A,(IX+$00)     ;
       socb a,a                                            ; OR A              ; the target negative?
       jhe  !                                              ; JP M,$1DF3        ; yes
       b    @title_screen_swing_down                       ;
!
       ab   one,*hl                                        ; INC (HL)          ; swing up
       cb   a,*hl                                          ; CP (HL)           ; reached the target?
       jeq  !                                              ; RET NZ            ; no
       .ret                                                ;
!
       .call @random_byte                                  ; CALL $2176        ;
       andi a,>0f00                                        ; AND $0F           ;
       ab   @bytes+>14,a                                   ; ADD A,$14         ;
       neg a                                               ; NEG               ;
       movb a,*ix                                          ; LD (IX+$00),A     ; new target: -(20 to 35)
       .ret                                                ; RET               ;
title_screen_swing_down:                                   ; >1df3
       sb   one,*hl                                        ; DEC (HL)          ; swing down
       cb   a,*hl                                          ; CP (HL)           ; reached the target?
       jeq  !                                              ; RET NZ            ; no
       .ret                                                ;
!
       .call @random_byte                                  ; CALL $2176        ;
       andi a,>0f00                                        ; AND $0F           ;
       ab   @bytes+>14,a                                   ; ADD A,$14         ;
       movb a,*ix                                          ; LD (IX+$00),A     ; new target: 20 to 35
       .ret                                                ; RET               ;

********************************************************************************
* Title screen: the spinning "ELITE" letters
*
* Used by the routine at #R$1C5C.
* .
* Clears the object table (#R$28D4), colours the space view ($D1), and
* adds the five letters from #R$1F0C one by one, each at its X position
* with the orientation from #R$1F1E (#R$3037). After each one it runs
* #R$1E5A for 24 frames, in which the newest letter turns one way and
* comes 7 closer per frame, while the ones before it turn the other way
* and move 7 further away. After the fifth, a short pause, then 24 more
* frames of all five turning and moving away. A keypress at any point
* ends the letters. The entry at $1E32, which adds a single object, is
* the target of the unused jump-table entry at $0088 (see #R$003B).
title_screen_letters:                                      ; >1e01
       .call @clear_all_ship_slots                         ; CALL $28D4        ;
       movb @bytes+>d1,a                                   ; LD A,$D1          ;
       .call @colour_space_view                            ; CALL $3A4D        ; colour the space view
       movb @b255,a                                        ; LD A,$FF          ;
       movb a,@title_letter_being_added                    ; LD ($E892),A      ; a letter is being added
       movb @bytes+>e4,a                                   ; LD A,$E4          ;
       movb a,@message_row                                 ; LD ($E92C),A      ; messages at the bottom of the view
       li   hl,title_letters                               ; LD HL,$1F0C       ; HL -> the letters
       movb @bytes+>05,b                                   ; LD B,$05          ; 5 letters
* This entry point is used by the routine at #R$1E48.
title_screen_add_letter:                                   ; >1e18
       movb *hl,a                                          ; LD A,(HL)         ;
       inc  hl                                             ; INC HL            ;
       movb a,@ship_type                                   ; LD ($F7E7),A      ; set the letter's ship type
       movb *hl,@e                                         ; LD E,(HL)         ;
       inc  hl                                             ; INC HL            ;
       movb *hl,d                                          ; LD D,(HL)         ;
       inc  hl                                             ; INC HL            ;
       mov  de,@object_position_x                          ; LD ($F7CE),DE     ; set its X position
       .push bc                                            ; PUSH BC           ;
       .push hl                                            ; PUSH HL           ;
       li   hl,title_letters_orientation                   ; LD HL,$1F1E       ;
       li   de,object_position_y                           ; LD DE,$F7D0       ;
       li   bc,>0010                                       ; LD BC,$0010       ;
       .ldir                                               ; LDIR              ; set its Y, Z and orientation
spawn_fresh_ship:                                          ; >1e32
       sb   a,a                                            ; XOR A             ;
       movb a,@handler_type                                ; LD ($F7EE),A      ;
       ab   one,a                                          ; INC A             ;
       movb a,@object_status_byte                          ; LD ($F7CD),A      ;
       .call @add_object                                   ; CALL $3037        ; add it to the object table
       mov  hl,@title_letter_slot                          ; LD ($E88E),HL     ; remember which slot it's in
       .call @title_screen_letter_frames                   ; CALL $1E5A        ; run 24 frames
       jnc  title_screen_next_letter                       ; JR NC,$1E48       ; TODO: check code. no key pressed
       .pop hl                                             ; POP HL            ;
       .pop hl                                             ; POP HL            ;
       .ret                                                ; RET               ; key pressed - end the letters

********************************************************************************
* Title screen: next letter
*
* Used by the routine at #R$1E01.
* .
* Continues #R$1E01 with the next letter; after the fifth, pauses briefly,
* clears ($E892), and runs 24 more frames (#R$1E5A) with all five letters
* turning and moving away.
title_screen_next_letter:                                  ; >1e48
       .pop hl                                             ; POP HL            ;
       .pop bc                                             ; POP BC            ;
       sb   one,b                                          ; DEC B             ;
       jeq  !                                              ; JP NZ,$1E18       ; next letter
       b    @title_screen_add_letter                       ;
!
_1e4e:                                                     ; >1e4e
       dec  bc                                             ; DEC BC            ;
       movb b,a                                            ; LD A,B            ;
       socb @c,a                                           ; OR C              ;
       jne  _1e4e                                          ; JR NZ,$1E4E       ; a short pause
       sb   a,a                                            ; XOR A             ;
       movb a,@title_letter_being_added                    ; LD ($E892),A      ; no letter being added any more
       b    @title_screen_letter_frames                    ; JP $1E5A          ; 24 more frames

********************************************************************************
* Title screen: run 24 frames of the "ELITE" letters
*
* Used by the routines at #R$1E01 and #R$1E48.
* .
* Each frame clears the space view, and turns and moves each letter: the
* one being added (the slot in ($E88E), while ($E892) is set) turns one way
* (#R$2365, A=$7F) and comes 7 closer; the others ($1E96) turn the other
* way and move 7 away. Then prints "(c)1987 Firebird" and waits for the
* frame to end ($1EB3).
* .
* At $1E96, turns the letter (#R$2365, A=$81), moves it 7 further away,
* draws it (#R$422E) and copies its record back to the object table.
* .
* At $1EB3, prints "(c)1987 Firebird" (#R$1EEB), copies the space view to
* the screen, and waits until 7 VBlanks have passed since the frame
* started. If a key has been pressed, returns (from #R$1E5A) with carry
* set.
* .
* At $1ED0, loops back to #R$1E5C until the 24 frames are done, then
* returns with carry clear.
*
* O:F Carry set if a key was pressed
title_screen_letter_frames:                                ; >1e5a
       movb @bytes+>18,b                                   ; LD B,$18          ; 24 frames
title_screen_letter_slot:                                  ; >1e5c
       .push bc                                            ; PUSH BC           ;
       .call @clear_space_view                             ; CALL $388F        ; clear the space view
       sb   a,a                                            ; XOR A             ;
       movb a,@vblank_subtick_counter                      ; LD ($F748),A      ; start timing the frame
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; HL -> the object table
_1e67:                                                     ; >1e67
       movb *hl,a                                          ; LD A,(HL)         ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_letter_frame_end                  ; JR Z,$1EB3        ; no more letters - end of the frame
       .push hl                                            ; PUSH HL           ;
       .push hl                                            ; PUSH HL           ;
       li   de,object_status_byte                          ; LD DE,$F7CD       ;
       li   bc,>0028                                       ; LD BC,$0028       ;
       .ldir                                               ; LDIR              ; copy the letter's record to the workspace
       .call @get_blueprint_data                           ; CALL $16E3        ;
       movb @title_letter_being_added,a                    ; LD A,($E892)      ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_letter_away                       ; JR Z,$1E96        ; no letter being added
       .pop de                                             ; POP DE            ;
       mov  @title_letter_slot,hl                          ; LD HL,($E88E)     ;
       socb a,a                                            ; OR A              ;
       s    de,hl                                          ; SBC HL,DE         ;
       jne  _1e94                                          ; JR NZ,$1E94       ; not the one being added
       movb @bytes+>7f,a                                   ; LD A,$7F          ;
       .call @pitch_object                                 ; CALL $2365        ; turn it 30 degrees
       movb @object_position_z_lo,a                        ; LD A,($F7D2)      ;
       sb   @bytes+>07,a                                   ; SUB $07           ;
       movb a,@object_position_z_lo                        ; LD ($F7D2),A      ; and move it 7 closer
_1e94:                                                     ; >1e94
       jmp  _1ea4                                          ; JR $1EA4          ;
title_screen_letter_away:                                  ; >1e96
       .pop de                                             ; POP DE            ;
       movb @bytes+>81,a                                   ; LD A,$81          ;
       .call @pitch_object                                 ; CALL $2365        ; turn it 30 degrees the other way
       movb @object_position_z_lo,a                        ; LD A,($F7D2)      ;
       ab   @bytes+>07,a                                   ; ADD A,$07         ;
       movb a,@object_position_z_lo                        ; LD ($F7D2),A      ; and move it 7 away
_1ea4:                                                     ; >1ea4
       .call @draw_object                                  ; CALL $422E        ; draw it
       .pop de                                             ; POP DE            ;
       li   hl,object_status_byte                          ; LD HL,$F7CD       ;
       li   bc,>0028                                       ; LD BC,$0028       ;
       .ldir                                               ; LDIR              ; copy the record back
       .ex_de_hl                                           ; EX DE,HL          ;
       jmp  _1e67                                          ; JR $1E67          ;
title_screen_letter_frame_end:                             ; >1eb3
       li   hl,msg_copyright_1987_firebird                 ; LD HL,$1EEB       ;
       .call @show_view_message                            ; CALL $39C8        ; print "(c)1987 Firebird"
       .call @copy_space_view                              ; CALL $3846        ; copy the space view to the screen
_1ebc:                                                     ; >1ebc
       movb @vblank_subtick_counter,a                      ; LD A,($F748)      ;
       cb   a,@bytes+>07                                   ; CP $07            ;
       jl   _1ebc                                          ; JR C,$1EBC        ; wait for 7 VBlanks
       movb @pending_debounced_keypress_byte_status,a      ; LD A,($E8F5)      ;
       socb a,a                                            ; OR A              ;
       jeq  title_screen_letter_next_frame                 ; JR Z,$1ED0        ; no key
       sb   a,a                                            ; XOR A             ;
       movb a,@pending_debounced_keypress_byte_status      ; LD ($E8F5),A      ; forget the key
       .pop hl                                             ; POP HL            ;
       ; SCF                                               ; SCF               ; TODO: check code.
       .ret                                                ; RET               ; return with carry set
title_screen_letter_next_frame:                            ; >1ed0
       .pop bc                                             ; POP BC            ; recover the slot counter
       sb   one,b                                          ; DEC B             ;
       jeq  !                                              ; JP NZ,$1E5C       ; slots remain - render the next one
       b    @title_screen_letter_slot                      ;
!
       socb a,a                                            ; OR A              ; none left - carry clear (no key pressed)
       .ret                                                ; RET               ;

********************************************************************************
* The message "Load New Commander ?"
msg_load_new_commander:                                    ; >1ed7
       text 'LOAD NEW COMMANDER ',>bf

********************************************************************************
* The message "(c)1987 Firebird"
*
* #R$1EB3 (display_message_wait_few_frames) loads HL here directly and
* measures and prints it as one string (#R$39C8), up to the bit-7-set "d".
* Character $60 is the copyright symbol in this game's font (#R$0A9F).
msg_copyright_1987_firebird:                               ; >1eeb
       text >60,'1987 FIREBIR',>e4

********************************************************************************
* The message "Hit key for mission"
msg_hit_key_mission:                                       ; >1ef9
       text 'HIT KEY FOR MISSIO',>ee

********************************************************************************
* Title screen "ELITE" letters
*
* 3 bytes per letter, for #R$1E01: the ship type (8, 9, 10, 11 and 8
* again - E, L, I, T, E), then the X position (-30, -15, 0, 15, 30).
title_letters:                                             ; >1f0c
       byte >08,>E2,>FF,>09,>F1,>FF,>0A,>00
       byte >00,>0B,>0F,>00,>08,>1E,>00,>0A
       byte >18,>FC

********************************************************************************
* Title screen letters' starting position and orientation
*
* Copied to $F7D0 for each letter by #R$1E01: Y = 0, Z = 192, then the
* orientation vectors.
title_letters_orientation:                                 ; >1f1e
       byte >00,>00,>C0,>00,>00,>40,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>40

********************************************************************************
* Title screen ships' starting position and orientation
*
* Copied to $F7CE by #R$1C5C for each ship: X = 0, Y = 0, Z = 2000, then
* the orientation vectors.
title_ship_start:                                          ; >1f2e
       byte >00,>00,>00,>00,>D0,>07,>00,>C0
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>C0

********************************************************************************
* Title screen ships
*
* The ship types (14, 27, 1, 4, 17, 21, 18, 24, 22, 28, 26, 29, 12, 5)
* of the ships #R$1C5C shows in turn, ending with 0.
title_ships:                                               ; >1f40
       byte >0E,>1B,>01,>04,>11,>15,>12,>18
       byte >16,>1C,>1A,>1D,>0C,>05,>00

