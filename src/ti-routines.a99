;       rt

*********************************************************************
*
* EXX
*
exx_routine:
       mov  bc,r0
       mov  bc_,bc
       mov  r0,bc_
       mov  hl,r0
       mov  hl_,hl
       mov  r0,hl_
       mov  de,r0
       mov  de_,de
       mov  r0,de_
       rt
*// exx_routine

;*********************************************************************
;*
;* DAA
;*
;daa_routine:
;       mov  a,r0
;       andi r0,>0f00
;       cb   r0,@bytes+>09
;       jle  !
;       ab   @bytes+>06,a
;!      mov  a,r0
;       andi r0,>f000                   ; Ensure carry is cleared by shift
;       srl  r0,4
;       cb   r0,@bytes+>09
;       jle  !
;       ab   @bytes+>60,a
;!      rt
;*// daa_routine
