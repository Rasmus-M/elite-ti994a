*********************************************************************
*
* Disk operations (TI-specific)
*
* The commander menu loads and saves commanders on disk, where the MSX uses
* tape (#R$A492, #R$A4CA): a commander is a file of 139 bytes, the record
* at #R$D606 (the name and the commander file), loaded and saved as a
* program file with the DSR's LOAD and SAVE operations.
*
* The disk controller's DSR needs two things that the game overwrites:
*
* - The scratchpad (>8300->83FF), as the console left it: the top of the
*   free VDP RAM (>8370), the GPL workspace (>83E0) and more. The game uses
*   all of it: the main workspace, the bit masks, the routines copy_to_pad
*   installs and pad_ws.
* - Its buffers at the top of the VDP RAM, from the address after the one
*   in >8370 (>37D8 with the usual three files). They start with a header
*   that the DSR checks, in the last 40 bytes of the color table (the
*   colors of the bottom right five characters of the screen); the rest of
*   the area is under the name table and the sprite attribute table, and
*   above them (which the game leaves alone: ti_setup_environment doesn't
*   clear it).
*
* So ti_save_console_state keeps a copy of both when the game starts, and
* ti_disk_operation puts them back around the call to the DSR, with the
* game's scratchpad and colors where the copies were - and sets up the name
* table and the sprite attribute table again afterwards.
*
* All of this runs in a workspace of its own in low RAM (disk_ws), since
* the main workspace is in the scratchpad. The routines are in ROM bank 14
* (rom-bank-14.a99); here, in low RAM, are their entry point, which selects
* that bank, and their data.
*
disk_pab:                              ; The PAB, in VDP RAM that is free (see equates.a99)
       equ  sprite_pattern_table+>0100
disk_buffer:                           ; The buffer for the file, in VDP RAM
       equ  sprite_pattern_table+>0140
disk_record_size:                      ; The size of the record (#R$D606): 11 + 128 bytes
       equ  139
disk_load:                             ; The DSR's operations
       equ  >0500
disk_save:
       equ  >0600
*********************************************************************
*
* Load or save the commander record (ti_disk_operation, in ROM bank 14)
*
* Called with BLWP @disk_vector: selects the bank, calls the routine, and
* selects the caller's bank (current_bank) again.
*
disk_vector:
       data disk_ws,disk_entry

disk_entry:
       li   r0,code_bank_14_select
       seto *r0
       bl   @ti_disk_operation
       mov  @current_bank,r0
       seto *r0
       rtwp
*// disk_entry

disk_opcode:                           ; The operation: disk_load or disk_save (the high byte)
       byte 0
disk_error:                            ; 0 if the last operation went well
       byte 0
disk_name_length:                      ; The length of the file's name
       byte 0
disk_name:                             ; The file's name: "DSK1." and up to 10 characters
       bss  15
       even
dsr_color_max:                         ; The most bytes of the color table that are kept
       equ  40
dsr_color_address:                     ; The VDP address of the DSR's part of the color table
       data 0
dsr_color_length:                      ; and its length (0 if there is none)
       data 0
dsr_color_bytes:                       ; The copy of it: the DSR's bytes, or the game's colors during a disk operation
       bss  dsr_color_max
dsr_color_temp:
       bss  dsr_color_max
disk_ws:                               ; The workspace of the disk routines
       bss  >20
console_pad:                           ; The copy of the scratchpad: the console's, or the game's during a disk operation
       bss  >100
