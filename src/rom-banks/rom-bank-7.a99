msg_commanders_name:                                       ; >a61d
       text >05,>16,'Commander''s name ? ',>00                     ; 
       byte >FF                                                   ; 

********************************************************************************
* The message "Saving Commander "
msg_saving_commander:                                      ; >a634
       text 'Saving Commander',>a0                                ; 

