       text >05,>0f,'leak to the Thargoids',>a1
       byte >FF

********************************************************************************
* Mission 5: the briefing
* 
* Shown by #R$9220.
msg_thargoid_base_briefing:                                ; >98b4
       text >05,>08,'Intellegence reports that ',>e1
       text >05,>09,'nearby system has been invade',>e4
       text >05,>0a,'by Thargoid ships and that th',>e5
       text >05,>0b,'space station is under attack. W',>e5
       text >05,>0c,'suggest that you destroy th',>e5
       text >05,>0d,'space station and don''t try t',>ef
       text >05,>0e,'dock',>ae
       byte >FF

********************************************************************************
* Mission 5: the reward
* 
* Shown by #R$920F.
msg_thargoid_base_reward:                                  ; >997a
       text >05,>08,'Thanks for destroying th',>e5
       text >05,>09,'Thargoid base. A new device wa',>f3
       text >05,>0a,'salvaged from a Thargoid shi',>f0
       text >05,>0b,'which we have fitted to you',>f2
       text >05,>0c,'Cobra. The device appears to ja',>ed
       text >05,>0d,'ECM broadcasts and is activate',>e4
       text >05,>0e,'by the L key',>ae
       byte >FF

********************************************************************************
* Mission 3 reward: 50 grams of gem-stones
* 
* When the player delivers the refugees, #R$90FB copies these 4 bytes into
* the hold's gem-stones (#R$EB55), replacing any the player already had
* rather than adding to them.
mission_3_gem_stones:                                      ; >9a46
       byte >32,>00,>00,>00                                          ; 50 grams

********************************************************************************
* Empty message for the mission 1 and 2 briefings
* 
* #R$9120 passes this to #R$90D3 as the message to show on the mission
* screen. #R$90D3 prints it with RST $20 (#R$3596), whose list ends at the
* first record with a negative column byte - this one - so all it shows is
* the frame and the header. #R$9120 then prints the briefing itself: the
* name of the system it has picked, followed by #R$9483 (mission 1) or
* #R$96DA (mission 2).
empty_mission_message:                                     ; >9a4a
       byte >FF                                                      ; the end of the list

rom_bank_13_end:
       equ  $
       bss  >8000-$
