       limi 0                                              ; DI                ; 
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; point the VDP at the row
       movb @bytes+>b0,b                                   ; LD B,$B0          ; 176 bytes (22 characters)
_181f:                                                     ; >181f
       movb r,a                                            ; LD A,R            ; A = a random colour from the R register...
       andi a,>0f00                                        ; AND $0F           ; 
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jl   _181f                                          ; JR C,$181F        ; ...from 2 to 15
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       socb one,a                                          ; OR $01            ; on black
       movb a,@vdpwd                                       ; OUT ($98),A       ; write it
       sb   one,b                                          ; DJNZ $181F        ; 
       jne  _181f                                          ;                   
       ; EI                                                ; EI                ; TODO: check code. 
       ab   one,h                                          ; INC H             ; next row
       sb   one,@c                                         ; DEC C             ; 
       jne  _1814                                          ; JR NZ,$1814       ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Key '1' when docked: launch
* 
* Used by the routine at #R$4173.
* .
* Reached from #R$4173. Refuses in flight (#R$6393). Places the planet, the
* space station and the sun (#R$8D2A), resets the flight variables
* (#R$707D), and starts the ship rolling with the station (roll rate 4,
* #R$F815, #R$2209). Suppresses the police check on entering the safe zone
* ($EF9C, see #R$1549), since the ship starts in it. Switches to the front
* view (#R$64A1), showing the tunnel rings (#R$E8F6). In mission state $16
* (#R$E93D) moves on to $17, so the Constrictor appears (#R$2B24);
* otherwise goes on to $1868.
* .
* At $1868, during mission 3 (#R$E93D = $3x), resets how far the sun has
* come (#R$E93E), so the supernova's approach starts again on each launch.
launch:                                                    ; >1837
       .call @refuse_unless_docked                         ; CALL $6393        ; refuse in flight
       .call @launch_place_planet_station_and_sun          ; CALL $8D2A        ; place the planet, station and sun
       .call @reset_flight                                 ; CALL $707D        ; reset the flight variables
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@launch_roll                                 ; LD ($E929),A      ; the ship starts rolling
       movb a,@safe_zone_entry_latch                       ; LD ($EF9C),A      ; no police check on entering the safe zone
       movb @bytes+>04,a                                   ; LD A,$04          ; roll rate 4
       movb a,@roll_rate                                   ; LD ($F815),A      ; 
       .call @refresh_roll_table                           ; CALL $2209        ; set up the roll
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@show_tunnel                                 ; LD ($E8F6),A      ; show the tunnel rings
       .call @switch_to_front_view                         ; CALL $64A1        ; switch to the front view
       sb   a,a                                            ; XOR A             ; 
       movb a,@show_tunnel                                 ; LD ($E8F6),A      ; 
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>16                                   ; CP $16            ; 
       jne  continue_1837_clear_e93e                       ; JR NZ,$1868       ; not that state
       ab   one,a                                          ; INC A             ; advance the state machine
       movb a,@mission_state                               ; LD ($E93D),A      ; 
       .ret                                                ; RET               ; 
continue_1837_clear_e93e:                                  ; >1868
       andi a,>f000                                        ; AND $F0           ; keep the high nibble
       cb   a,@bytes+>30                                   ; CP $30            ; state $30-$3F?
       jeq  !                                              ; RET NZ            ; no - nothing to do
       .ret                                                ;                   
!
       s    hl,hl                                          ; SBC HL,HL         ; yes - HL = 0
       mov  hl,@supernova_offset                           ; LD ($E93E),HL     ; reset the running total
       .ret                                                ; RET               ; 

********************************************************************************
* Dock
* 
* Used by the routine at #R$13FD.
* .
* Called by the main loop (#R$13FD) once the ship has docked (#R$E917).
* Switches to the front view unless a space view is showing (#R$E903),
* flashes the dashboard (#R$6CB2), clears the alert level (#R$E90C), sets
* the docked flag (#R$E90A), checks for mission events (#R$1896), and
* shows the status page (#R$6276).
dock:                                                      ; >1873
       sb   a,a                                            ; XOR A             ; A = 0
       movb a,@hyperspace_countdown_inner                  ; LD ($E91B),A      ; 
       movb a,@hyperspace_trigger                          ; LD ($E920),A      ; 
       movb @space_view_showing,a                          ; LD A,($E903)      ; A = space view showing?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; CALL Z,$64A1      ; switch to the front view
       .call @switch_to_front_view                         ;                   
!
       .call @tunnel_rings                                 ; CALL $6CB2        ; flash the dashboard
       sb   a,a                                            ; XOR A             ; 
       movb a,@docking                                     ; LD ($E917),A      ; docking done
       movb a,@alert_level                                 ; LD ($E90C),A      ; alert level 0
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@docked                                      ; LD ($E90A),A      ; docked
       .call @mission_on_docking                           ; CALL $1896        ; check for mission events
       b    @status_page                                   ; JP $6276          ; show the status page

********************************************************************************
* Missions: check for mission events on docking
* 
* Used by the routine at #R$1873.
* .
* Called by #R$1873 on docking. Depending on the mission state (#R$E93D):
* $10 or $20 shows the briefing for mission 1 (the stolen Constrictor) or 2
* (the Thargoid documents) (#R$9120); in state $15, docking at the system
* the Constrictor was last heard of (#R$EFA2) moves on to state $16.
* .
* At $18B4, docking in state $18 - with the Constrictor still at large -
* goes back to state $17, so that it appears again on launching. At $18BD,
* in state $19 (the Constrictor destroyed) pays the reward (#R$91F0); in
* state $21, docking at the naval base (#R$EFA2) delivers the Thargoid
* documents (#R$91DB). At $18D1, state $31 shows the supernova briefing
* (#R$909F), $34 completes that mission (#R$90FB), $50 shows the Thargoid
* base briefing (#R$9220), and $53 - the Thargoid base destroyed - its
* reward (#R$920F).
mission_on_docking:                                        ; >1896
       movb @mission_state,a                               ; LD A,($E93D)      ; A = the current state
       cb   a,@bytes+>10                                   ; CP $10            ; 
       jne  !                                              ; JP Z,$9120        ; mission 1: the Constrictor briefing
       b    @mission_briefing                              ;                   
!
       cb   a,@bytes+>20                                   ; CP $20            ; 
       jne  !                                              ; JP Z,$9120        ; mission 2: the Thargoid documents briefing
       b    @mission_briefing                              ;                   
!
       cb   a,@bytes+>15                                   ; CP $15            ; 
       jne  mission_on_docking_2                           ; JR NZ,$18B4       ; 
       movb @current_system,a                              ; LD A,($EB67)      ; A = the current system
       li   hl,mission_system                              ; LD HL,$EFA2       ; HL -> the galaxy-arrival index
       cb   a,*hl                                          ; CP (HL)           ; jump target reached yet?
       jeq  !                                              ; RET NZ            ; not the Constrictor's system
       .ret                                                ;                   
!
       li   hl,mission_state                               ; LD HL,$E93D       ; reached - advance to state $16
       ab   one,*hl                                        ; INC (HL)          ; state $16: the Constrictor is here
       .ret                                                ; RET               ; 
mission_on_docking_2:                                      ; >18b4
       cb   a,@bytes+>18                                   ; CP $18            ; state $18?
       jne  mission_on_docking_3                           ; JR NZ,$18BD       ; 
       sb   one,a                                          ; DEC A             ; the Constrictor appears again
       movb a,@mission_state                               ; LD ($E93D),A      ; 
       .ret                                                ; RET               ; 
mission_on_docking_3:                                      ; >18bd
       cb   a,@bytes+>19                                   ; CP $19            ; state $19?
       jne  !                                              ; JP Z,$91F0        ; Constrictor destroyed: the reward
       b    @constrictor_reward                            ;                   
!
       cb   a,@bytes+>21                                   ; CP $21            ; state $21?
       jne  mission_on_docking_4                           ; JR NZ,$18D1       ; 
       movb @current_system,a                              ; LD A,($EB67)      ; A = the current system
       li   hl,mission_system                              ; LD HL,$EFA2       ; HL -> the galaxy-arrival index
       cb   a,*hl                                          ; CP (HL)           ; jump target reached yet?
       jeq  !                                              ; RET NZ            ; not the naval base
       .ret                                                ;                   
!
       b    @documents_delivered                           ; JP $91DB          ; documents delivered
mission_on_docking_4:                                      ; >18d1
       cb   a,@bytes+>31                                   ; CP $31            ; state $31?
       jne  !                                              ; JP Z,$909F        ; mission 3: the supernova briefing
       b    @supernova_briefing                            ;                   
!
       cb   a,@bytes+>34                                   ; CP $34            ; state $34?
       jne  !                                              ; JP Z,$90FB        ; the refugees delivered
       b    @supernova_complete                            ;                   
!
       cb   a,@bytes+>50                                   ; CP $50            ; state $50?
       jne  !                                              ; JP Z,$9220        ; mission 5: the Thargoid base briefing
       b    @thargoid_base_briefing                        ;                   
!
       cb   a,@bytes+>53                                   ; CP $53            ; state $53?
       jne  !                                              ; JP Z,$920F        ; Thargoid base destroyed: the reward
       b    @thargoid_base_reward                          ;                   
!
       .ret                                                ; RET               ; none matched - stay in this state

********************************************************************************
* Recharge the energy banks and shields
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). Every 16 frames (counted
* by #R$E944) cools the laser and charges the energy banks by 1 (#R$190D),
* and once they're full charges the shields too (#R$1928). An energy unit
* (#R$F77E) makes this faster and charges the shields at the same time
* ($18FF).
* .
* At $18FF, recharges every 8 frames with an extra energy unit (#R$F77E =
* 1), or every 4 with a naval energy unit (2, the reward for mission 2),
* charging the shields as well as the energy banks.
recharge:                                                  ; >18e6
       li   hl,recharge_timer                              ; LD HL,$E944       ; HL -> the regen-tick countdown
       sb   one,*hl                                        ; DEC (HL)          ; 
       jeq  !                                              ; RET NZ            ; not time yet
       .ret                                                ;                   
!
       movb @item_energy_unit,a                            ; LD A,($F77E)      ; A = energy unit
       socb a,a                                            ; OR A              ; 
       jne  recharge_energy_unit                           ; JR NZ,$18FF       ; fitted
       movb @bytes+>10,*hl                                 ; LD (HL),$10       ; 16 frames until the next time
       .call @cool_laser_charge_energy                     ; CALL $190D        ; cool the laser, charge the energy banks
       movb @energy_gauge,a                                ; LD A,($F817)      ; A = energy
       cb   a,@bytes+>60                                   ; CP $60            ; 
       jne  !                                              ; CALL Z,$1928      ; full: charge the shields
       .call @charge_shields                               ;                   
!
       .ret                                                ; RET               ; 
recharge_energy_unit:                                      ; >18ff
       sb   one,a                                          ; DEC A             ; an extra energy unit?
       movb @bytes+>08,a                                   ; LD A,$08          ; 8 frames until the next time...
       jeq  _1906                                          ; JR Z,$1906        ; 
       movb @bytes+>04,a                                   ; LD A,$04          ; ...or 4 with a naval energy unit
_1906:                                                     ; >1906
       movb a,*hl                                          ; LD (HL),A         ; 
       .call @cool_laser_charge_energy                     ; CALL $190D        ; cool the laser, charge the energy banks
       b    @charge_shields                                ; JP $1928          ; charge the shields

********************************************************************************
* Cool the laser and charge the energy banks
* 
* Used by the routine at #R$18E6.
* .
* Cools the laser by 2 (#R$F813, not below 0), and charges the energy
* banks (#R$F817) by 1, up to 96; redrawing the gauges (#R$6B60,
* #R$6A88).
cool_laser_charge_energy:                                  ; >190d
       li   hl,laser_temp_gauge                            ; LD HL,$F813       ; HL -> laser_temp_gauge
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _191d                                          ; JR Z,$191D        ; already 0 - nothing to cool, check energy next
       sb   one,*hl                                        ; DEC (HL)          ; cool by 2...
       sb   one,*hl                                        ; DEC (HL)          ; 
       jlt  !                                              ; JP P,$191A        ; still >= 0 - redraw as-is
       b    @cool_laser_redraw                             ;                   
!
       ab   one,*hl                                        ; INC (HL)          ; overshot below 0 - correct back up to 0
cool_laser_redraw:                                         ; >191a
       .call @draw_laser_temperature                       ; CALL $6B60        ; redraw the laser temperature gauge
_191d:                                                     ; >191d
       li   hl,energy_gauge                                ; LD HL,$F817       ; HL -> energy_gauge
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>60                                   ; CP $60            ; already at the cap (96)?
       jne  !                                              ; RET Z             ; yes - nothing to charge
       .ret                                                ;                   
!
       ab   one,*hl                                        ; INC (HL)          ; charge by 1
       b    @draw_energy_banks                             ; JP $6A88          ; redraw the energy gauge

********************************************************************************
* Charge the shields
* 
* Used by the routine at #R$18E6.
* .
* Charges the fore and aft shields (#R$F80F, #R$F810) by 1 each, up to
* 24, redrawing them (#R$6B48, #R$6B54).
charge_shields:                                            ; >1928
       li   hl,fore_shield                                 ; LD HL,$F80F       ; HL -> the fore shield
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>18                                   ; CP $18            ; already at the cap (24)?
       jeq  _1934                                          ; JR Z,$1934        ; yes - nothing to charge, check the other shield
       ab   one,*hl                                        ; INC (HL)          ; charge by 1
       .call @draw_gauge_dashboard_6b48                    ; CALL $6B48        ; redraw the fore shield
_1934:                                                     ; >1934
       li   hl,aft_shield                                  ; LD HL,$F810       ; HL -> the aft shield
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>18                                   ; CP $18            ; already at the cap (24)?
       jne  !                                              ; RET Z             ; yes - done
       .ret                                                ;                   
!
       ab   one,*hl                                        ; INC (HL)          ; charge by 1
       b    @draw_gauge_dashboard_6b54                     ; JP $6B54          ; redraw the aft shield

********************************************************************************
* Damage the player's shields by B
* 
* Used by the routines at #R$2618, #R$26A9 and #R$8755.
* .
* Plays sound effect 4 (#R$7468) unless it's already playing (#R$E915).
* Then takes the damage off the fore shield ($F80F) if the attacker is in
* front of the ship (($F7D3), the sign of its Z coordinate, positive), or
* the aft shield ($F810) if it's behind, and redraws both (#R$6B48,
* #R$6B54). Damage the shield can't absorb is taken from the energy banks
* (#R$19EC); if that leaves them low (under $48), there's a 15/256 chance
* of losing the cargo ("Cargo lost", 1 in 13) or a piece of equipment
* ($19A1).
* .
* The cargo is only lost (at $1990) if there's something in the hold
* (#R$EB19).
* .
* At $19A1, the piece of equipment is the first one fitted, going through
* the equipment array (#R$F775) from a random item (3-13) and round again,
* that doesn't have bit 7 set. It's never the fuel, the missiles or the
* large cargo bay (items 0-2). It's removed, and "<item> lost" shown (the
* name from #R$10A7 and " lost" from #R$1BC3, put together at $E8DC).
* 
* I:A Amount of damage
damage_shields:                                            ; >193f
       .push af                                            ; PUSH AF           ; save the damage
       movb @sound_effect_4_playing,a                      ; LD A,($E915)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _194b                                          ; JR NZ,$194B       ; sound effect 4 already playing
       movb @bytes+>04,a                                   ; LD A,$04          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 4
_194b:                                                     ; >194b
       li   hl,fore_shield                                 ; LD HL,$F80F       ; HL -> fore shield
       movb @object_z_sign,a                               ; LD A,($F7D3)      ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$1958        ; attacker in front
       b    @damage_shields_hit                            ;                   
!
       li   hl,aft_shield                                  ; LD HL,$F810       ; behind: HL -> aft shield
damage_shields_hit:                                        ; >1958
       .pop bc                                             ; POP BC            ; B = damage
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _196f                                          ; JR Z,$196F        ; shield already down
       sb   b,a                                            ; SUB B             ; take the damage off the shield
       sb   b,b                                            ; LD B,$00          ; 
       jnc  _1966                                          ; JR NC,$1966       ; TODO: check code. absorbed it all
       neg a                                               ; NEG               ; 
       movb a,b                                            ; LD B,A            ; B = what's left over
       sb   a,a                                            ; XOR A             ; 
_1966:                                                     ; >1966
       movb a,*hl                                          ; LD (HL),A         ; store the shield
       .push bc                                            ; PUSH BC           ; 
       .call @draw_gauge_dashboard_6b48                    ; CALL $6B48        ; 
       .call @draw_gauge_dashboard_6b54                    ; CALL $6B54        ; redraw the shields
       .pop bc                                             ; POP BC            ; 
_196f:                                                     ; >196f
       movb b,a                                            ; LD A,B            ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; nothing left over
       .ret                                                ;                   
!
       .call @decay_counter_f817                           ; CALL $19EC        ; take the rest off the energy banks
       cb   a,@bytes+>48                                   ; CP $48            ; 
       jl   !                                              ; RET NC            ; energy not low
       .ret                                                ;                   
!
       .call @random_byte                                  ; CALL $2176        ; 
       cb   a,@bytes+>0f                                   ; CP $0F            ; 
       jl   !                                              ; RET NC            ; otherwise a 15/256 chance of losing something
       .ret                                                ;                   
!
_197e:                                                     ; >197e
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>0f00                                        ; AND $0F           ; 
       cb   a,@bytes+>0d                                   ; CP $0D            ; 
       jhe  _197e                                          ; JR NC,$197E       ; pick 0-12
       cb   a,@bytes+>0c                                   ; CP $0C            ; 
       jne  strip_random_equipment_item                    ; JR NZ,$19A1       ; 0-11: lose a piece of equipment
       li   hl,cargo_hold                                  ; LD HL,$EB19       ; 12: lose the cargo
       movb @bytes+>48,b                                   ; LD B,$48          ; 
_1990:                                                     ; >1990
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  cargo_scan_advance_and_loop                    ; JR Z,$199D        ; 
       .call @clear_cargo_hold                             ; CALL $9237        ; empty the hold
       li   hl,msg_cargo_lost                              ; LD HL,$1BB9       ; "Cargo lost"
       b    @show_view_message                             ; JP $39C8          ; show it
cargo_scan_advance_and_loop:                               ; >199d
       inc  hl                                             ; INC HL            ; advance to the next cargo-hold slot
       sb   one,b                                          ; DJNZ $1990        ; more slots to check - loop back into #R$1990
       jne  _1990                                          ;                   
       .ret                                                ; RET               ; none found
strip_random_equipment_item:                               ; >19a1
       ab   @bytes+>02,a                                   ; ADD A,$02         ; A = the starting item index (2-13)
       movb a,@e                                           ; LD E,A            ; E = that index, also this loop's cursor
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,fuel_level                                  ; LD HL,$F775       ; HL -> the equipment array base
       a    de,hl                                          ; ADD HL,DE         ; HL -> the starting item's byte
       movb @bytes+>0c,b                                   ; LD B,$0C          ; check up to 12 items
_19ac:                                                     ; >19ac
       movb *hl,a                                          ; LD A,(HL)         ; A = this item's current value
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$19DD        ; bit 7 set (unstealable) - skip it
       b    @advance_equipment_index_wrapping              ;                   
!
       jeq  advance_equipment_index_wrapping               ; JR Z,$19DD        ; zero (not owned) - skip it
       movb @e,a                                           ; LD A,E            ; is this the specifically-protected index 2?
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jeq  advance_equipment_index_wrapping               ; JR Z,$19DD        ; yes - skip it too
       sb   *hl,*hl                                        ; LD (HL),$00       ; no - strip it (the item is lost)
       movb @e,a                                           ; LD A,E            ; A = the item's index, for the name lookup
       li   hl,equipment_name_list2_empty_slots            ; LD HL,$10A7       ; HL -> the item-name table
       .call @skip_tokenised_strings_advancing_hl_past     ; CALL $358D        ; HL -> this item's name string
       li   de,equipment_item_name_text_buffer_text        ; LD DE,$E8DC       ; DE -> the scratch print buffer
damage_shields_copy_name:                                  ; >19c4
       movb *hl,a                                          ; LD A,(HL)         ; copy the name, byte by byte...
       andi a,>7f00                                        ; AND $7F           ; ...stripping the high-bit terminator flag
       movb a,*de                                          ; LD (DE),A         ; 
       movb *hl,r0                                         ; BIT 7,(HL)        ; was this the terminator byte?
       andi r0,>8000                                       ;                   
       inc  hl                                             ; INC HL            ; 
       inc  de                                             ; INC DE            ; 
       jlt  !                                              ; JP P,$19C4        ; no - copy the next byte
       b    @damage_shields_copy_name                      ;                   
!
       li   hl,msg_lost                                    ; LD HL,$1BC3       ; yes - append the shared " lost" suffix
       li   bc,>0005                                       ; LD BC,$0005       ; 
       .ldir                                               ; LDIR              ; 
       li   hl,equipment_item_name_text_buffer_text        ; LD HL,$E8DC       ; HL -> the assembled "<item> lost" message
       b    @show_view_message                             ; JP $39C8          ; print it
advance_equipment_index_wrapping:                          ; >19dd
       ab   one,@e                                         ; INC E             ; advance the item cursor
       inc  hl                                             ; INC HL            ; 
       movb @e,a                                           ; LD A,E            ; wrapped past the last index (14)?
       cb   a,@bytes+>0e                                   ; CP $0E            ; 
       jne  _19e9                                          ; JR NZ,$19E9       ; no - keep going
       movb @bytes+>02,@e                                  ; LD E,$02          ; yes - wrap the cursor back to index 2...
       li   hl,item_large_cargo_bay                        ; LD HL,$F777       ; ...and HL back to that slot
_19e9:                                                     ; >19e9
       sb   one,b                                          ; DJNZ $19AC        ; more items to check
       jne  _19ac                                          ;                   
       .ret                                                ; RET               ; exhausted - nothing found

********************************************************************************
* Decay the counter at $F817 by B, clamped to 0
* 
* Used by the routines at #R$13FD, #R$193F and #R$323C.
decay_counter_f817:                                        ; >19ec
       movb @energy_gauge,a                                ; LD A,($F817)      ; A = the counter
       sb   b,a                                            ; SUB B             ; subtract B
       jnc  _19f3                                          ; JR NC,$19F3       ; TODO: check code. still non-negative - keep it
       sb   a,a                                            ; XOR A             ; underflowed - clamp to 0
_19f3:                                                     ; >19f3
       movb a,@energy_gauge                                ; LD ($F817),A      ; store the decayed counter
       .push af                                            ; PUSH AF           ; 
       .call @draw_energy_banks                            ; CALL $6A88        ; redraw the energy gauge
       .pop af                                             ; POP AF            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Key Esc: launch the escape capsule
* 
* Reached via the key table at #R$419B; only in flight (#R$6DCF). Needs an
* escape capsule (#R$F77C), and doesn't work in witchspace (#R$EEC1) or in
* mission state $52 (#R$E93D) - #R$16FE beeps instead. Cancels any
* hyperspace countdown (#R$E91B), and leaves the player's Cobra Mk III
* (ship type $0E) behind, at the position and orientation in #R$1C4A, turning
* away (handler type 7, then 15, #R$2810). If there's room for it in the object
* table (#R$3037), uses up the capsule, stops the ship (#R$F814, #R$1A7D),
* clears the legal status (#R$EB65), switches to the front view (#R$64A1),
* loses the cargo (#R$9237), plays sound effect 11 and shows "Capsule
* released"; otherwise (at $1A77) "Malfunction!!!".
key_escape_capsule:                                        ; >19fc
       .call @refuse_if_docked                             ; CALL $6DCF        ; refuse if docked
       movb @item_escape_capsule,a                         ; LD A,($F77C)      ; A = the arming flag for this handler
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$16FE        ; not armed - beep and return
       b    @trigger_sfx_6                                 ;                   
!
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$16FE       ; yes - beep
       b    @trigger_sfx_6                                 ;                   
!
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>52                                   ; CP $52            ; 
       jne  !                                              ; JP Z,$16FE        ; that state - beep and return
       b    @trigger_sfx_6                                 ;                   
!
       sb   a,a                                            ; XOR A             ; 
       movb a,@hyperspace_countdown_inner                  ; LD ($E91B),A      ; clear the per-frame setup counter
       movb a,@hyperspace_trigger                          ; LD ($E920),A      ; clear the one-shot trigger
       movb one,a                                          ; LD A,$01          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; status: in use
       li   hl,escape_capsule_cobra_start                  ; LD HL,$1C4A       ; source: a fixed position/orientation record
       li   de,object_position_x                           ; LD DE,$F7CE       ; dest: the working object record
       li   bc,>0012                                       ; LD BC,$0012       ; 18 bytes
       .ldir                                               ; LDIR              ; 
       movb @bytes+>07,a                                   ; LD A,$07          ; fixed type/ship-type/scale fields for this object...
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       movb @bytes+>12,a                                   ; LD A,$12          ; 
       movb a,@handler_countdown                           ; LD ($F7EF),A      ; 
       movb @bytes+>0a,a                                   ; LD A,$0A          ; 
       movb a,@per_type_parameter_block                    ; LD ($F7F0),A      ; 
       movb @bytes+>12,a                                   ; LD A,$12          ; 
       movb a,@turn_phase_2_length                         ; LD ($F7F1),A      ; 
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       movb a,@turn_phase_2_rate                           ; LD ($F7F2),A      ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; 
       movb @bytes+>0f,a                                   ; LD A,$0F          ; 
       movb a,@next_handler_type                           ; LD ($F7F3),A      ; 
       movb @bytes+>0e,a                                   ; LD A,$0E          ; ...(this pair reuses A=6 from above too)
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       .call @add_object                                   ; CALL $3037        ; spawn it into a free ship-object slot
       jnc  _1a77                                          ; JR NC,$1A77       ; TODO: check code. no free slot - go report failure
       sb   a,a                                            ; XOR A             ; 
       movb a,@item_escape_capsule                         ; LD ($F77C),A      ; disarm - one-shot
       movb a,@speed_gauge_value                           ; LD ($F814),A      ; 
       movb a,@legal_status                                ; LD ($EB65),A      ; 
       .call @stop_roll_and_pitch                          ; CALL $1A7D        ; stop any roll and pitch
       .call @switch_to_front_view                         ; CALL $64A1        ; switch to the front view
       .call @clear_cargo_hold                             ; CALL $9237        ; clear the 71-byte $EB19 scratch area
       movb @bytes+>0b,a                                   ; LD A,$0B          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 11 (launch)
       li   hl,msg_capsule_released                        ; LD HL,$1B6D       ; the "object placed" message
       jmp  _1a7a                                          ; JR $1A7A          ; 
_1a77:                                                     ; >1a77
       li   hl,msg_malfunction                             ; LD HL,$1B98       ; the "no free slot" message
_1a7a:                                                     ; >1a7a
       b    @show_view_message                             ; JP $39C8          ; display it

********************************************************************************
* Stop rolling and pitching
* 
* Used by the routines at #R$19FC, #R$86E6 and #R$894D.
* .
* Turns the flight controls off (#R$EF8E) and clears the roll and pitch
* rates ($F815/$F816).
stop_roll_and_pitch:                                       ; >1a7d
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@roll_rate                                   ; LD ($F815),A      ; 
       movb a,@pitch_rate                                  ; LD ($F816),A      ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Key F5: show the game time, score and credits in turn
* 
* Reached via the key table at #R$419B; only in flight (#R$6DCF). Each
* press shows the next of six messages in the space view (#R$E8F3): the
* game time (#R$F742: days, hours and minutes, zero-padded), the score
* (at $1AD6, #R$EB13), and the four lines of credits (at $1AED, #R$1C42).
* They're shown for 30 frames, rather than the usual 10 (#R$E919).
key_f5_info:                                               ; >1a8a
       .call @refuse_if_docked                             ; CALL $6DCF        ; refuse if docked
       movb @info_sub_page_index_key84_handler,a           ; LD A,($E8F3)      ; A = the info-cycle state counter
       socb a,a                                            ; OR A              ; 
       jne  key_f5_score                                   ; JR NZ,$1AD6       ; not the game time
       movb @bytes+>30,a                                   ; LD A,$30          ; '0': zero-pad the fields formatted below
       movb a,@number_fill_char                            ; LD ($EF96),A      ; 
       li   ix,game_time_digits                            ; LD IX,$1BB1       ; IX -> the message's embedded digit buffer
       movb @clock_days,a                                  ; LD A,($F745)      ; C = game_clock's days field
       movb a,@c                                           ; LD C,A            ; 
       li   hl,>0000                                       ; LD HL,$0000       ; 
       movb @bytes+>82,a                                   ; LD A,$82          ; 
       .call @format_number                                ; CALL $3675        ; format it into (IX)
       szcb @bit7,@>ffffffff(ix)                           ; RES 7,(IX-$01)    ; 
       inc  ix                                             ; INC IX            ; 
       movb @clock_hours,a                                 ; LD A,($F744)      ; C = game_clock's hours field
       movb a,@c                                           ; LD C,A            ; 
       li   hl,>0000                                       ; LD HL,$0000       ; 
       movb @bytes+>82,a                                   ; LD A,$82          ; 
       .call @format_number                                ; CALL $3675        ; format it into (IX)
       szcb @bit7,@>ffffffff(ix)                           ; RES 7,(IX-$01)    ; 
       inc  ix                                             ; INC IX            ; 
       movb @clock_minutes,a                               ; LD A,($F743)      ; C = game_clock's minutes field
       movb a,@c                                           ; LD C,A            ; 
       li   hl,>0000                                       ; LD HL,$0000       ; 
       movb @bytes+>82,a                                   ; LD A,$82          ; 
       .call @format_number                                ; CALL $3675        ; format it into (IX)
       movb @bytes+>20,a                                   ; LD A,$20          ; restore the default fill character (space)
       movb a,@number_fill_char                            ; LD ($EF96),A      ; 
       li   hl,msg_game_time                               ; LD HL,$1BA6       ; the clock-display message
       jmp  _1afa                                          ; JR $1AFA          ; show it
key_f5_score:                                              ; >1ad6
       sb   one,a                                          ; DEC A             ; A = the state counter, minus 1
       jne  key_f5_credits                                 ; JR NZ,$1AED       ; not the score
       movb @score,a                                       ; LD A,($EB13)      ; C:HL = the running score total
       movb a,@c                                           ; LD C,A            ; 
       mov  @score_1,hl                                    ; LD HL,($EB14)     ; 
       sb   a,a                                            ; XOR A             ; 
       li   ix,score_digits                                ; LD IX,$1BCF       ; IX -> the message's embedded digit buffer
       .call @format_number                                ; CALL $3675        ; format it into (IX)
       li   hl,msg_score                                   ; LD HL,$1BC8       ; the score-display message
       jmp  _1afa                                          ; JR $1AFA          ; show it
key_f5_credits:                                            ; >1aed
       sb   one,a                                          ; DEC A             ; A = the state counter, minus 2
       ab   a,a                                            ; ADD A,A           ; *2 (word-sized entries)
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,credits_screen_message_pointer_table_4      ; LD HL,$1C42       ; the credits-screen message-pointer table
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb *hl,a                                          ; LD A,(HL)         ; HL = this state's credits message
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; 
_1afa:                                                     ; >1afa
       .call @show_view_message                            ; CALL $39C8        ; display HL's message
       movb @bytes+>9e,a                                   ; LD A,$9E          ; show it for 30 frames
       movb a,@message_timer                               ; LD ($E919),A      ; 
       li   hl,info_sub_page_index_key84_handler           ; LD HL,$E8F3       ; advance the info-cycle state counter...
       ab   one,*hl                                        ; INC (HL)          ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       sb   @bytes+>06,a                                   ; SUB $06           ; after the sixth, back to the first
       jne  _1b0c                                          ; JR NZ,$1B0C       ; 
       movb a,*hl                                          ; LD (HL),A         ; 
_1b0c:                                                     ; >1b0c
       .ret                                                ; RET               ; 

********************************************************************************
* Key 'I': identify the target
* 
* Reached via the key table at #R$419B. The next object in the laser
* sights has its name shown (#R$EF9D, #R$4735).
key_handler_i:                                             ; >1b0d
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@identify_target                             ; LD ($EF9D),A      ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Key 'Y': turn the cloaking device on or off
* 
* Reached via the key table at #R$419B. Beeps if no cloaking device is
* fitted (#R$F784); otherwise, if docked, does nothing (#R$6DCF), and in
* flight toggles it (#R$EF9F).
key_handler_y:                                             ; >1b13
       movb @cloaking_device_fitted,a                      ; LD A,($F784)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$16FE        ; no cloaking device
       b    @trigger_sfx_6                                 ;                   
!
       .call @refuse_if_docked                             ; CALL $6DCF        ; do nothing if docked
       movb @cloaking_active_flag,a                        ; LD A,($EF9F)      ; 
       inv  a                                              ; CPL               ; 
       movb a,@cloaking_active_flag                        ; LD ($EF9F),A      ; toggle the cloaking device
       .ret                                                ; RET               ; 

********************************************************************************
* Key 'L': turn the ECM jammer on or off
* 
* Reached via the key table at #R$419B. If docked, does nothing
* (#R$6DCF); beeps if no ECM jammer is fitted (#R$F783); otherwise toggles
* it (#R$EFA8).
key_handler_l:                                             ; >1b25
       .call @refuse_if_docked                             ; CALL $6DCF        ; do nothing if docked
       movb @ecm_jammer_fitted,a                           ; LD A,($F783)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$16FE        ; no ECM jammer
       b    @trigger_sfx_6                                 ;                   
!
       movb @jammer_active_flag,a                          ; LD A,($EFA8)      ; 
       inv  a                                              ; CPL               ; 
       movb a,@jammer_active_flag                          ; LD ($EFA8),A      ; toggle the ECM jammer
       .ret                                                ; RET               ; 

********************************************************************************
* The message "Energy Low"
msg_energy_low:                                            ; >1b37
       text 'ENERGY LO',>f7

********************************************************************************
* The message "Altitude Low"
msg_altitude_low:                                          ; >1b41
       text 'ALTITUDE LO',>f7

********************************************************************************
* The message "Countdown:"
msg_countdown:                                             ; >1b4d
       text 'COUNTDOWN:'

********************************************************************************
* Countdown digit-format buffer
* 
* The two digits printed after "Countdown:" (#R$1B4D): #R$1651 formats the
* countdown into them (#R$3675) before printing the whole message (#R$1670).
* They're 0 here because no countdown is running.
countdown_digit_buffer:                                    ; >1b57
       byte >00,>00

********************************************************************************
* The message "Fuel Scoop Activated"
msg_fuel_scoop_activated:                                  ; >1b59
       text 'FUEL SCOOP ACTIVATE',>e4

********************************************************************************
* The message "Capsule released"
msg_capsule_released:                                      ; >1b6d
       text 'CAPSULE RELEASE',>e4

********************************************************************************
* The message "Game Over"
msg_game_over_1b7d:                                        ; >1b7d
       text 'GAME OVE',>f2

********************************************************************************
* The message "Danger: Supernova!"
msg_danger_supernova:                                      ; >1b86
       text 'DANGER: SUPERNOVA',>a1

********************************************************************************
* The message "Malfunction!!!"
msg_malfunction:                                           ; >1b98
       text 'MALFUNCTION!!',>a1

********************************************************************************
* The message "Game Time: dd:hh:mm"
* 
* Shown by #R$1A8A, which first formats the days, hours and minutes of the
* game time (#R$F742) into the digits at $1BB1. The last digit ends the
* message (#R$3675 sets its bit 7).
msg_game_time:                                             ; >1ba6
       text 'GAME TIME: '
game_time_digits:                                          ; >1bb1
       text '00:00:00'                                               ; days, hours, minutes

********************************************************************************
* The message "Cargo lost"
msg_cargo_lost:                                            ; >1bb9
       text 'CARGO LOS',>f4

********************************************************************************
* The message " lost"
msg_lost:                                                  ; >1bc3
       text ' LOS',>f4

********************************************************************************
* The message "Score: " and its digits
* 
* Shown by #R$1A8A, which first formats the score (#R$EB13) into the digits
* at $1BCF. The last digit ends the message (#R$3675 sets its bit 7).
msg_score:                                                 ; >1bc8
       text 'SCORE: '
score_digits:                                              ; >1bcf
       byte >00,>00,>00,>00,>00,>00,>00,>00,>00,>00                  ; the digits

********************************************************************************
* The message "Drive repaired"
msg_drive_repaired:                                        ; >1bd9
       text 'DRIVE REPAIRE',>e4

********************************************************************************
* The message "Cloaking active"
msg_cloaking_active:                                       ; >1be7
       text 'CLOAKING ACTIV',>e5

********************************************************************************
* The message "Jammer active"
msg_jammer_active:                                         ; >1bf6
       text 'JAMMER ACTIV',>e5

********************************************************************************
* The message "Version 1.0 1987"
msg_version_1_0_1987:                                      ; >1c03
       text 'VERSION 1.0 198',>b7

********************************************************************************
* The message "MSX Conversion by"
msg_msx_conversion:                                        ; >1c13
       text 'MSX CONVERSION B',>f9

********************************************************************************
* The message "Rob Nicholson of"
msg_rob_nicholson:                                         ; >1c24
       text 'ROB NICHOLSON O',>e6

********************************************************************************
* The message "Mr. Micro Ltd."
msg_mr_micro_ltd:                                          ; >1c34
       text 'MR. MICRO LTD',>ae

********************************************************************************
* Credits-screen message pointers
* 
* The addresses of the four credits messages - #R$1C03, #R$1C13, #R$1C24 and
* #R$1C34 - which #R$1A8A shows when the player presses 1-4.
credits_screen_message_pointer_table_4:                    ; >1c42
       data msg_version_1_0_1987,msg_msx_conversion,msg_rob_nicholson,msg_mr_micro_ltd

********************************************************************************
* Escape capsule: the abandoned Cobra's position and orientation
* 
* Copied to #R$F7CE by #R$19FC for the Cobra Mk III the player leaves behind:
* X = 0, Y = -150, Z = 50, then the side vector (1, 0, 0) and the nose vector
* (0, 0, 1).
escape_capsule_cobra_start:                                ; >1c4a
       data >0000,>FF6A,>0032                                        ; X, Y, Z
       data >4000,>0000,>0000                                        ; side vector
       data >0000,>0000,>4000                                        ; nose vector

********************************************************************************
* Title screen
* 
* Used by the routines at #R$0106 and #R$9120.
* .
* Called by the main loop (#R$0106), and by #R$9120 for a mission briefing.
* Switches to the front view (#R$64A1), which also draws the cockpit
* screen, and marks the game as in flight (($E903)) with the main loop's
* per-frame pass off (($E90A)).
* .
* Normally, turns sound effects off, starts the title music (#R$7603), and
* shows the spinning "ELITE" letters (#R$1E01). Then shows each of the 14
* ships in #R$1F40 in turn: each one flies in from a distance of 2000 to a
* distance that depends on its size, turns this way and that for 150
* frames, then flies off, with its name and "Load New Commander ?" shown
* underneath. After the last ship it starts again with the letters. It only
* leaves when Y or N is pressed ($1DB5), jumping to the load commander
* screen or the docked screen.
* .
* For a mission briefing (($E93D) = $10, from #R$9120) it shows just the
* ship in #R$1F4F, with "Hit key for mission", and returns when any key is
* pressed.
* .
* At $1D3D, moves the ship in by 120 each frame until it reaches the
* distance in ($E888), then turns it about two axes by angles that swing
* back and forth (#R$1DDC). Counts down the 150 frames in ($E88B), and then
* starts the ship flying off (($E88C)). Then checks for a key (($E8F5)):
* for a mission briefing any key returns; otherwise Y or N goes to $1DB5,
* and anything else is ignored. Loops back for the next frame at #R$1CF4.
* .
* At $1DB5, stops the music (#R$7438), sets up the commander record
* (#R$A469), turns sound effects back on, and clears $EEC1, $E940, $EF8E
* and $E90C. Then Y ($E924 = $FF) goes to the load commander screen
* (#R$A30A), and N to the docked screen (#R$6276), starting with the
* default commander.
title_screen:                                              ; >1c5c
       limi 0                                              ; DI                ; backdrop colour 1 (black)
       movb one,a                                          ; LD A,$01          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>87,a                                   ; LD A,$87          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ; EI                                                ; EI                ; TODO: check code. 
       sb   a,a                                            ; XOR A             ; 
       movb a,@docked                                      ; LD ($E90A),A      ; 
       sb   one,a                                          ; DEC A             ; 
       movb a,@e940_gate_flag                              ; LD ($E940),A      ; $E940 = $FF
       .call @switch_to_front_view                         ; CALL $64A1        ; switch to the front view (drawing the cockpit screen)
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@space_view_showing                          ; LD ($E903),A      ; space view showing...
       movb a,@docked                                      ; LD ($E90A),A      ; ...and docked
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       cb   a,@bytes+>10                                   ; CP $10            ; 
       jeq  title_screen_mission                           ; JR Z,$1C93        ; mission briefing - #R$1C93
       li   hl,options                                     ; LD HL,$E914       ; 
       szcb @bit0,*hl                                      ; RES 0,(HL)        ; turn sound effects off (see #R$7468)
       li   hl,title_music                                 ; LD HL,$7AE4       ; 
       .call @start_tune                                   ; CALL $7603        ; start the music
_1c8b:                                                     ; >1c8b
       .call @title_screen_letters                         ; CALL $1E01        ; show the spinning "ELITE" letters
       li   hl,title_ships                                 ; LD HL,$1F40       ; HL -> the list of title screen ships
       jmp  _1c96                                          ; JR $1C96          ; 
title_screen_mission:                                      ; >1c93
       li   hl,mission_briefing_ship                       ; LD HL,$1F4F       ; HL -> the mission briefing ship
_1c96:                                                     ; >1c96
       mov  hl,@title_ship_ptr                             ; LD ($E890),HL     ; point at the first ship
       movb @bytes+>71,a                                   ; LD A,$71          ; 
       .call @colour_space_view                            ; CALL $3A4D        ; colour the space view ($71)
title_screen_next_ship:                                    ; >1c9e
       mov  @title_ship_ptr,hl                             ; LD HL,($E890)     ; HL -> next ship in the list
       movb *hl,a                                          ; LD A,(HL)         ; A = this step's view-type byte
       socb a,a                                            ; OR A              ; 
       jeq  _1c8b                                          ; JR Z,$1C8B        ; end of the list - start again with the letters
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@ship_type                                   ; LD ($F7E7),A      ; set the object's type
       inc  hl                                             ; INC HL            ; 
       mov  hl,@title_ship_ptr                             ; LD ($E890),HL     ; 
       movb one,a                                          ; LD A,$01          ; 
       movb a,@title_wobble_target_1                       ; LD ($E886),A      ; wobble targets start at 1
       movb a,@title_wobble_target_2                       ; LD ($E887),A      ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       li   hl,title_ship_start                            ; LD HL,$1F2E       ; set its position (Z = 2000) and orientation
       li   de,object_position_x                           ; LD DE,$F7CE       ; 
       li   bc,>0012                                       ; LD BC,$0012       ; 
       .ldir                                               ; LDIR              ; 
       .call @get_blueprint_data                           ; CALL $16E3        ; set the object up for its type (#R$16E3)
       sb   a,a                                            ; XOR A             ; 
       movb a,@title_ship_arrived                          ; LD ($E88A),A      ; not arrived yet
       movb a,@title_ship_flying_off                       ; LD ($E88C),A      ; not flying off yet
       movb a,@title_wobble                                ; LD ($E884),A      ; wobble angles start at 0
       movb a,@title_wobble_angle_2                        ; LD ($E885),A      ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       movb @bytes+>96,a                                   ; LD A,$96          ; 
       movb a,@title_ship_frames                           ; LD ($E88B),A      ; stay for 150 frames
       movb @bp_size,a                                     ; LD A,($F805)      ; A = the ship's size
       movb a,h                                            ; LD H,A            ; 
       sb   @l,@l                                          ; LD L,$00          ; HL = A:$00
       srl  h,1                                            ; SRL H             ; 
       ; RR L                                              ; RR L              ; TODO: check code. HL = HL >> 2
       srl  h,1                                            ; SRL H             ; 
       ; RR L                                              ; RR L              ; TODO: check code. 
       movb @bytes+>2c,a                                   ; LD A,$2C          ; 
       .call @divide_hl_a                                  ; CALL $2079        ; HL = size * 64 / 44
       mov  hl,@title_ship_distance                        ; LD ($E888),HL     ; the distance to fly in to
title_screen_next_frame:                                   ; >1cf4
       .call @clear_space_view                             ; CALL $388F        ; next frame: clear the space view
       movb @bytes+>d6,a                                   ; LD A,$D6          ; 
       movb a,@message_row                                 ; LD ($E92C),A      ; the ship's name at the top of the view
       mov  @bp_name,hl                                    ; LD HL,($F7FB)     ; 
       .call @show_view_message                            ; CALL $39C8        ; print the ship's name
_1d02:                                                     ; >1d02
       .call @count_message_timer                          ; CALL $39F1        ; 
       movb @bytes+>e4,a                                   ; LD A,$E4          ; 
       movb a,@message_row                                 ; LD ($E92C),A      ; the prompt at the bottom
       li   hl,msg_load_new_commander                      ; LD HL,$1ED7       ; HL = "Load New Commander ?"
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       cb   a,@bytes+>10                                   ; CP $10            ; 
       jne  _1d17                                          ; JR NZ,$1D17       ; 
       li   hl,msg_hit_key_mission                         ; LD HL,$1EF9       ; mission briefing: "Hit key for mission"
_1d17:                                                     ; >1d17
       .call @show_view_message                            ; CALL $39C8        ; print it
       .call @draw_object                                  ; CALL $422E        ; draw the ship
       .call @copy_space_view                              ; CALL $3846        ; copy the space view to the screen
       movb @title_ship_flying_off,a                       ; LD A,($E88C)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  title_screen_frame                             ; JR Z,$1D3D        ; not flying off
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; else HL = #R$EB9E (cached_range_value)
       li   de,>0005                                       ; LD DE,$0005       ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       jnc  !                                              ; JP C,$1C9E        ; TODO: check code. flown out of sight - next ship
       b    @title_screen_next_ship                        ;                   
!
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; else nudge $F7D2 towards +200...
       li   de,>00c8                                       ; LD DE,$00C8       ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; fly off: Z += 200
       jmp  _1d62                                          ; JR $1D62          ; 
title_screen_frame:                                        ; >1d3d
       movb @title_ship_arrived,a                          ; LD A,($E88A)      ; has the ship arrived?
       socb a,a                                            ; OR A              ; 
       jne  _1d62                                          ; JR NZ,$1D62       ; yes
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; no: move it closer
       li   de,>ff88                                       ; LD DE,$FF88       ; 
       a    de,hl                                          ; ADC HL,DE         ; 
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; 
       mov  @title_ship_distance,de                        ; LD DE,($E888)     ; DE = distance to stop at
       jhe  !                                              ; JP M,$1D5A        ; 
       b    @title_screen_ship_arrived                     ;                   
!
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       jnc  _1d62                                          ; JR NC,$1D62       ; TODO: check code. not there yet
title_screen_ship_arrived:                                 ; >1d5a
       mov  de,@object_position_z_lo                       ; LD ($F7D2),DE     ; there: stop at that distance
       li   hl,title_ship_arrived                          ; LD HL,$E88A       ; 
       sb   one,*hl                                        ; DEC (HL)          ; and flag it as arrived
_1d62:                                                     ; >1d62
       li   hl,title_wobble                                ; LD HL,$E884       ; 
       li   ix,title_wobble_target_1                       ; LD IX,$E886       ; 
       .call @title_screen_swing                           ; CALL $1DDC        ; swing the first angle
       li   hl,title_wobble_angle_2                        ; LD HL,$E885       ; 
       li   ix,title_wobble_target_2                       ; LD IX,$E887       ; 
       .call @title_screen_swing                           ; CALL $1DDC        ; and the second
       movb @title_wobble,a                                ; LD A,($E884)      ; 
       sra  a,1                                            ; SRA A             ; 
       .call @pitch_object                                 ; CALL $2365        ; turn the ship
       movb @title_wobble_angle_2,a                        ; LD A,($E885)      ; 
       sra  a,1                                            ; SRA A             ; 
       .call @roll_object                                  ; CALL $23D9        ; about both axes
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       cb   a,@bytes+>10                                   ; CP $10            ; 
       jeq  _1d97                                          ; JR Z,$1D97        ; mission briefing - the ship stays
       li   hl,title_ship_frames                           ; LD HL,$E88B       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       jne  _1d97                                          ; JR NZ,$1D97       ; 
       sb   one,a                                          ; DEC A             ; 
       movb a,@title_ship_flying_off                       ; LD ($E88C),A      ; time's up: start flying off
_1d97:                                                     ; >1d97
       .call @straighten_orientation                       ; CALL $4503        ; re-orthogonalise the ship's axes
       li   hl,pending_debounced_keypress_byte_status      ; LD HL,$E8F5       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _1db2                                          ; JR Z,$1DB2        ; no key pressed
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       cb   a,@bytes+>10                                   ; CP $10            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       jne  !                                              ; RET Z             ; mission briefing: any key returns
       .ret                                                ;                   
!
       cb   a,@bytes+>59                                   ; CP $59            ; 
       jeq  title_screen_key                               ; JR Z,$1DB5        ; Y
       cb   a,@bytes+>4e                                   ; CP $4E            ; 
       jeq  title_screen_key                               ; JR Z,$1DB5        ; N
_1db2:                                                     ; >1db2
       b    @title_screen_next_frame                       ; JP $1CF4          ; next frame
title_screen_key:                                          ; >1db5
       .push af                                            ; PUSH AF           ; 
       .call @stop_all_sound                               ; CALL $7438        ; stop the music
       .call @unpack_commander                             ; CALL $A469        ; set up the commander record
       li   hl,options                                     ; LD HL,$E914       ; 
       socb @bit0,*hl                                      ; SET 0,(HL)        ; sound effects on
       sb   a,a                                            ; XOR A             ; 
       movb a,@in_witchspace                               ; LD ($EEC1),A      ; 
       movb a,@e940_gate_flag                              ; LD ($E940),A      ; 
       movb a,@flight_controls_off                         ; LD ($EF8E),A      ; 
       movb a,@alert_level                                 ; LD ($E90C),A      ; 
       .pop af                                             ; POP AF            ; 
       cb   a,@bytes+>59                                   ; CP $59            ; 
       jeq  !                                              ; JP NZ,$6276       ; N - the docked screen
       b    @status_page                                   ;                   
!
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@load_new_commander                          ; LD ($E924),A      ; 
       b    @commander_menu                                ; JP $A30A          ; Y - load a commander

********************************************************************************
* Title screen: swing an angle back and forth
* 
* Used by the routine at #R$1C5C.
* .
* Steps the angle at HL by 1 towards its target at IX. On reaching it,
* picks a new random target of 20-35 with the opposite sign, so the angle
* swings back and forth by varying amounts. $1DF3 handles a negative
* target.
* 
* I:HL Pointer to the angle
* I:IX Pointer to its target
title_screen_swing:                                        ; >1ddc
       movb *ix,a                                          ; LD A,(IX+$00)     ; 
       socb a,a                                            ; OR A              ; the target negative?
       jhe  !                                              ; JP M,$1DF3        ; yes
       b    @title_screen_swing_down                       ;                   
!
       ab   one,*hl                                        ; INC (HL)          ; swing up
       cb   a,*hl                                          ; CP (HL)           ; reached the target?
       jeq  !                                              ; RET NZ            ; no
       .ret                                                ;                   
!
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>0f00                                        ; AND $0F           ; 
       ab   @bytes+>14,a                                   ; ADD A,$14         ; 
       neg a                                               ; NEG               ; 
       movb a,*ix                                          ; LD (IX+$00),A     ; new target: -(20 to 35)
       .ret                                                ; RET               ; 
title_screen_swing_down:                                   ; >1df3
       sb   one,*hl                                        ; DEC (HL)          ; swing down
       cb   a,*hl                                          ; CP (HL)           ; reached the target?
       jeq  !                                              ; RET NZ            ; no
       .ret                                                ;                   
!
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>0f00                                        ; AND $0F           ; 
       ab   @bytes+>14,a                                   ; ADD A,$14         ; 
       movb a,*ix                                          ; LD (IX+$00),A     ; new target: 20 to 35
       .ret                                                ; RET               ; 

********************************************************************************
* Title screen: the spinning "ELITE" letters
* 
* Used by the routine at #R$1C5C.
* .
* Clears the object table (#R$28D4), colours the space view ($D1), and
* adds the five letters from #R$1F0C one by one, each at its X position
* with the orientation from #R$1F1E (#R$3037). After each one it runs
* #R$1E5A for 24 frames, in which the newest letter turns one way and
* comes 7 closer per frame, while the ones before it turn the other way
* and move 7 further away. After the fifth, a short pause, then 24 more
* frames of all five turning and moving away. A keypress at any point
* ends the letters. The entry at $1E32, which adds a single object, is
* the target of the unused jump-table entry at $0088 (see #R$003B).
title_screen_letters:                                      ; >1e01
       .call @clear_all_ship_slots                         ; CALL $28D4        ; 
       movb @bytes+>d1,a                                   ; LD A,$D1          ; 
       .call @colour_space_view                            ; CALL $3A4D        ; colour the space view
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@title_letter_being_added                    ; LD ($E892),A      ; a letter is being added
       movb @bytes+>e4,a                                   ; LD A,$E4          ; 
       movb a,@message_row                                 ; LD ($E92C),A      ; messages at the bottom of the view
       li   hl,title_letters                               ; LD HL,$1F0C       ; HL -> the letters
       movb @bytes+>05,b                                   ; LD B,$05          ; 5 letters
* This entry point is used by the routine at #R$1E48.
title_screen_add_letter:                                   ; >1e18
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@ship_type                                   ; LD ($F7E7),A      ; set the letter's ship type
       movb *hl,@e                                         ; LD E,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       mov  de,@object_position_x                          ; LD ($F7CE),DE     ; set its X position
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       li   hl,title_letters_orientation                   ; LD HL,$1F1E       ; 
       li   de,object_position_y                           ; LD DE,$F7D0       ; 
       li   bc,>0010                                       ; LD BC,$0010       ; 
       .ldir                                               ; LDIR              ; set its Y, Z and orientation
spawn_fresh_ship:                                          ; >1e32
       sb   a,a                                            ; XOR A             ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       ab   one,a                                          ; INC A             ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       .call @add_object                                   ; CALL $3037        ; add it to the object table
       mov  hl,@title_letter_slot                          ; LD ($E88E),HL     ; remember which slot it's in
       .call @title_screen_letter_frames                   ; CALL $1E5A        ; run 24 frames
       jnc  title_screen_next_letter                       ; JR NC,$1E48       ; TODO: check code. no key pressed
       .pop hl                                             ; POP HL            ; 
       .pop hl                                             ; POP HL            ; 
       .ret                                                ; RET               ; key pressed - end the letters

********************************************************************************
* Title screen: next letter
* 
* Used by the routine at #R$1E01.
* .
* Continues #R$1E01 with the next letter; after the fifth, pauses briefly,
* clears ($E892), and runs 24 more frames (#R$1E5A) with all five letters
* turning and moving away.
title_screen_next_letter:                                  ; >1e48
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DEC B             ; 
       jeq  !                                              ; JP NZ,$1E18       ; next letter
       b    @title_screen_add_letter                       ;                   
!
_1e4e:                                                     ; >1e4e
       dec  bc                                             ; DEC BC            ; 
       movb b,a                                            ; LD A,B            ; 
       socb @c,a                                           ; OR C              ; 
       jne  _1e4e                                          ; JR NZ,$1E4E       ; a short pause
       sb   a,a                                            ; XOR A             ; 
       movb a,@title_letter_being_added                    ; LD ($E892),A      ; no letter being added any more
       b    @title_screen_letter_frames                    ; JP $1E5A          ; 24 more frames

********************************************************************************
* Title screen: run 24 frames of the "ELITE" letters
* 
* Used by the routines at #R$1E01 and #R$1E48.
* .
* Each frame clears the space view, and turns and moves each letter: the
* one being added (the slot in ($E88E), while ($E892) is set) turns one way
* (#R$2365, A=$7F) and comes 7 closer; the others ($1E96) turn the other
* way and move 7 away. Then prints "(c)1987 Firebird" and waits for the
* frame to end ($1EB3).
* .
* At $1E96, turns the letter (#R$2365, A=$81), moves it 7 further away,
* draws it (#R$422E) and copies its record back to the object table.
* .
* At $1EB3, prints "(c)1987 Firebird" (#R$1EEB), copies the space view to
* the screen, and waits until 7 VBlanks have passed since the frame
* started. If a key has been pressed, returns (from #R$1E5A) with carry
* set.
* .
* At $1ED0, loops back to #R$1E5C until the 24 frames are done, then
* returns with carry clear.
* 
* O:F Carry set if a key was pressed
title_screen_letter_frames:                                ; >1e5a
       movb @bytes+>18,b                                   ; LD B,$18          ; 24 frames
title_screen_letter_slot:                                  ; >1e5c
       .push bc                                            ; PUSH BC           ; 
       .call @clear_space_view                             ; CALL $388F        ; clear the space view
       sb   a,a                                            ; XOR A             ; 
       movb a,@vblank_subtick_counter                      ; LD ($F748),A      ; start timing the frame
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; HL -> the object table
_1e67:                                                     ; >1e67
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  title_screen_letter_frame_end                  ; JR Z,$1EB3        ; no more letters - end of the frame
       .push hl                                            ; PUSH HL           ; 
       .push hl                                            ; PUSH HL           ; 
       li   de,object_status_byte                          ; LD DE,$F7CD       ; 
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the letter's record to the workspace
       .call @get_blueprint_data                           ; CALL $16E3        ; 
       movb @title_letter_being_added,a                    ; LD A,($E892)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  title_screen_letter_away                       ; JR Z,$1E96        ; no letter being added
       .pop de                                             ; POP DE            ; 
       mov  @title_letter_slot,hl                          ; LD HL,($E88E)     ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       jne  _1e94                                          ; JR NZ,$1E94       ; not the one being added
       movb @bytes+>7f,a                                   ; LD A,$7F          ; 
       .call @pitch_object                                 ; CALL $2365        ; turn it 30 degrees
       movb @object_position_z_lo,a                        ; LD A,($F7D2)      ; 
       sb   @bytes+>07,a                                   ; SUB $07           ; 
       movb a,@object_position_z_lo                        ; LD ($F7D2),A      ; and move it 7 closer
_1e94:                                                     ; >1e94
       jmp  _1ea4                                          ; JR $1EA4          ; 
title_screen_letter_away:                                  ; >1e96
       .pop de                                             ; POP DE            ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; 
       .call @pitch_object                                 ; CALL $2365        ; turn it 30 degrees the other way
       movb @object_position_z_lo,a                        ; LD A,($F7D2)      ; 
       ab   @bytes+>07,a                                   ; ADD A,$07         ; 
       movb a,@object_position_z_lo                        ; LD ($F7D2),A      ; and move it 7 away
_1ea4:                                                     ; >1ea4
       .call @draw_object                                  ; CALL $422E        ; draw it
       .pop de                                             ; POP DE            ; 
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the record back
       .ex_de_hl                                           ; EX DE,HL          ; 
       jmp  _1e67                                          ; JR $1E67          ; 
title_screen_letter_frame_end:                             ; >1eb3
       li   hl,msg_copyright_1987_firebird                 ; LD HL,$1EEB       ; 
       .call @show_view_message                            ; CALL $39C8        ; print "(c)1987 Firebird"
       .call @copy_space_view                              ; CALL $3846        ; copy the space view to the screen
_1ebc:                                                     ; >1ebc
       movb @vblank_subtick_counter,a                      ; LD A,($F748)      ; 
       cb   a,@bytes+>07                                   ; CP $07            ; 
       jl   _1ebc                                          ; JR C,$1EBC        ; wait for 7 VBlanks
       movb @pending_debounced_keypress_byte_status,a      ; LD A,($E8F5)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  title_screen_letter_next_frame                 ; JR Z,$1ED0        ; no key
       sb   a,a                                            ; XOR A             ; 
       movb a,@pending_debounced_keypress_byte_status      ; LD ($E8F5),A      ; forget the key
       .pop hl                                             ; POP HL            ; 
       ; SCF                                               ; SCF               ; TODO: check code. 
       .ret                                                ; RET               ; return with carry set
title_screen_letter_next_frame:                            ; >1ed0
       .pop bc                                             ; POP BC            ; recover the slot counter
       sb   one,b                                          ; DEC B             ; 
       jeq  !                                              ; JP NZ,$1E5C       ; slots remain - render the next one
       b    @title_screen_letter_slot                      ;                   
!
       socb a,a                                            ; OR A              ; none left - carry clear (no key pressed)
       .ret                                                ; RET               ; 

********************************************************************************
* The message "Load New Commander ?"
msg_load_new_commander:                                    ; >1ed7
       text 'LOAD NEW COMMANDER ',>bf

********************************************************************************
* The message "(c)1987 Firebird"
* 
* #R$1EB3 (display_message_wait_few_frames) loads HL here directly and
* measures and prints it as one string (#R$39C8), up to the bit-7-set "d".
* Character $60 is the copyright symbol in this game's font (#R$0A9F).
msg_copyright_1987_firebird:                               ; >1eeb
       text >60,'1987 FIREBIR',>e4

********************************************************************************
* The message "Hit key for mission"
msg_hit_key_mission:                                       ; >1ef9
       text 'HIT KEY FOR MISSIO',>ee

********************************************************************************
* Title screen "ELITE" letters
* 
* 3 bytes per letter, for #R$1E01: the ship type (8, 9, 10, 11 and 8
* again - E, L, I, T, E), then the X position (-30, -15, 0, 15, 30).
title_letters:                                             ; >1f0c
       byte >08,>E2,>FF,>09,>F1,>FF,>0A,>00
       byte >00,>0B,>0F,>00,>08,>1E,>00,>0A
       byte >18,>FC

********************************************************************************
* Title screen letters' starting position and orientation
* 
* Copied to $F7D0 for each letter by #R$1E01: Y = 0, Z = 192, then the
* orientation vectors.
title_letters_orientation:                                 ; >1f1e
       byte >00,>00,>C0,>00,>00,>40,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>40

********************************************************************************
* Title screen ships' starting position and orientation
* 
* Copied to $F7CE by #R$1C5C for each ship: X = 0, Y = 0, Z = 2000, then
* the orientation vectors.
title_ship_start:                                          ; >1f2e
       byte >00,>00,>00,>00,>D0,>07,>00,>C0
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>C0

********************************************************************************
* Title screen ships
* 
* The ship types (14, 27, 1, 4, 17, 21, 18, 24, 22, 28, 26, 29, 12, 5)
* of the ships #R$1C5C shows in turn, ending with 0.
title_ships:                                               ; >1f40
       byte >0E,>1B,>01,>04,>11,>15,>12,>18
       byte >16,>1C,>1A,>1D,>0C,>05,>00

********************************************************************************
* Mission briefing ship
* 
* The ship type (31) of the ship #R$1C5C shows for a mission briefing,
* ending with 0.
mission_briefing_ship:                                     ; >1f4f
       byte >1F,>00

********************************************************************************
* Multiply: 8-bit x 8-bit -> 8-bit, unsigned, truncated
* 
* Used by the routines at #R$4BA8, #R$6164 and #R$63AA.
* .
* A = D * E via the standard double-and-add algorithm, using the same
* SRL-B/INC-B/DJNZ early-exit trick as #R$1F86 (see there for how that
* works) but on a single 8-bit accumulator/multiplicand pair instead of a
* 24-bit one - so the result silently truncates if the true product
* would exceed 255.
multiply_d_e_8bit:                                         ; >1f51
       sb   a,a                                            ; XOR A             ; A = 0, the product
       movb @e,b                                           ; LD B,E            ; B = E, the multiplier
_1f53:                                                     ; >1f53
       srl  b,1                                            ; SRL B             ; shift the next bit out of it
       jnc  _1f58                                          ; JR NC,$1F58       ; TODO: check code. 0 - don't add
       ab   d,a                                            ; ADD A,D           ; 1: add D
_1f58:                                                     ; >1f58
       sla  d,1                                            ; SLA D             ; shift D left
       ab   one,b                                          ; INC B             ; 
       sb   one,b                                          ; DJNZ $1F53        ; any bits left in the multiplier? (INC B then DJNZ tests B)
       jne  _1f53                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Multiply: HL = L * L, or A * E
* 
* Used by the routines at #R$205D and #R$8570.
* .
* Returns L squared. The entry at $1F60 returns A * E, unsigned: a shift
* and add multiplication, looping once for each bit of A (its bit length,
* from the table at #R$0200).
* 
* I:L The number to square
* O:HL The product
square_l:                                                  ; >1f5e
       movb @l,a                                           ; LD A,L            ; 
       movb a,@e                                           ; LD E,A            ; A = E = L
* This entry point is used by the routines at #R$2FF9, #R$3D76, #R$3DF4,
* #R$4C2B, #R$4C80, #R$4EEC, #R$50AA, #R$512F, #R$525F, #R$5524, #R$5E6B,
* #R$6164, #R$6A59, #R$6AAD, #R$6BB3 and #R$6BCA.
multiply_a_e_16bit:                                        ; >1f60
       movb a,@l                                           ; LD L,A            ; 
       movb @bytes+>02,h                                   ; LD H,$02          ; 
       movb *hl,b                                          ; LD B,(HL)         ; B = A's bit length (#R$0200)
       sb   d,d                                            ; LD D,$00          ; 
       movb d,h                                            ; LD H,D            ; 
       movb d,@l                                           ; LD L,D            ; HL = 0, the product; DE = E, which is shifted left
_1f68:                                                     ; >1f68
       srl  a,1                                            ; RRA               ; TODO: check code. shift the next bit out of A
       jnc  _1f6c                                          ; JR NC,$1F6C       ; TODO: check code. 0 - don't add
       a    de,hl                                          ; ADD HL,DE         ; 1: add DE
_1f6c:                                                     ; >1f6c
       ; SLA E                                             ; SLA E             ; TODO: check code. shift DE left
       sla  d,1                                            ; RL D              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $1F68        ; next bit
       jne  _1f68                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Multiply: 8-bit x 16-bit -> 16-bit, unsigned
* 
* Used by the routines at #R$5AC7, #R$5C01 and #R$5D72.
* .
* Same algorithm as #R$1F60 (same $0200 bit-length table, same RRA-driven
* double-and-add), but the multiplicand is the caller's HL rather than a
* second 8-bit value in E.
multiply_a_hl_16bit:                                       ; >1f73
       .ex_de_hl                                           ; EX DE,HL          ; DE = the multiplicand
       movb a,@l                                           ; LD L,A            ; 
       movb @bytes+>02,h                                   ; LD H,$02          ; 
       movb *hl,b                                          ; LD B,(HL)         ; B = A's bit length (#R$0200)
       li   hl,>0000                                       ; LD HL,$0000       ; HL = 0, the product
_1f7b:                                                     ; >1f7b
       srl  a,1                                            ; RRA               ; TODO: check code. shift the next bit out of A
       jnc  _1f7f                                          ; JR NC,$1F7F       ; TODO: check code. 0 - don't add
       a    de,hl                                          ; ADD HL,DE         ; 1: add DE
_1f7f:                                                     ; >1f7f
       ; SLA E                                             ; SLA E             ; TODO: check code. shift DE left
       sla  d,1                                            ; RL D              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $1F7B        ; next bit
       jne  _1f7b                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Multiply: 16-bit x 8-bit -> 24-bit, unsigned
* 
* Used by the routines at #R$24A7, #R$24D1, #R$4B76, #R$848D and #R$8F94.
* .
* Computes (A:HL) = HL * A via the standard double-and-add algorithm: for
* each set bit of the multiplier (A, tested from bit 0 upward via SRL),
* adds the current (doubling) 24-bit multiplicand C:DE into the 24-bit
* accumulator A:HL, then doubles C:DE ready for the next bit. The
* multiplicand starts zero-extended from the caller's 16-bit HL (C is
* cleared); the caller's DE is clobbered and plays no part in the result.
* .
* The INC B/DJNZ pair works around SRL B destroying B as a loop counter:
* SRL shifts the next multiplier bit into carry, and INC undoes DJNZ's
* decrement so B ends the iteration holding exactly that shifted value:
* the loop exits as soon as it reaches 0, so a multiplier with few
* significant bits needs fewer doublings than a full 8 (an early exit,
* not a fixed-length loop).
* 
* I:A 8-bit unsigned multiplier
* I:HL 16-bit unsigned multiplicand
* O:A Bits 16-23 of the product
* O:HL Bits 0-15 of the product
multiply_16x8:                                             ; >1f86
       .ex_de_hl                                           ; EX DE,HL          ; DE = the multiplicand (the caller's HL)
       movb a,b                                            ; LD B,A            ; B = multiplier
       sb   a,a                                            ; XOR A             ; 
       movb a,h                                            ; LD H,A            ; 
       movb a,@l                                           ; LD L,A            ; Accumulator A:HL := 0
       movb a,@c                                           ; LD C,A            ; Multiplicand's high byte := 0 (zero-extend DE to 24 bits)
_1f8c:                                                     ; >1f8c
       srl  b,1                                            ; SRL B             ; Next multiplier bit -> carry
       jnc  _1f92                                          ; JR NC,$1F92       ; TODO: check code. Bit was 0 - skip the add
       a    de,hl                                          ; ADD HL,DE         ; Accumulator += multiplicand (low 16 bits)...
       ab   @c,a                                           ; ADC A,C           ; ...and the high byte, with carry
_1f92:                                                     ; >1f92
       ; SLA E                                             ; SLA E             ; TODO: check code. Double the multiplicand (24-bit: C:D:E)
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       ab   one,b                                          ; INC B             ; Undo DJNZ's decrement below
       sb   one,b                                          ; DJNZ $1F8C        ; Loop while a significant bit remains
       jne  _1f8c                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Integer square root
* 
* Used by the routines at #R$2054 and #R$8570.
* .
* Returns the square root of A:HL, rounded down, using the usual
* bit-by-bit method: two bits of the number are brought down into the
* remainder (A:HL) at a time, and the trial value - the root so far with
* binary 01 appended (C:D:$40) - is subtracted if it fits, giving the next
* bit of the root. The number is first shifted left 6 bits so that it
* fills the 24 bits, so it must be less than $40000 (2^18), giving a root
* of up to 511 in 9 steps. Used for distances (#R$2054) and by the compass
* (#R$8570).
* 
* I:A:HL Number (less than $40000)
* O:HL Its square root
square_root:                                               ; >1f9c
       a    hl,hl                                          ; ADD HL,HL         ; shift A:HL left 6 bits...
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADD HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADD HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADD HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADD HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADD HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. ...so the number fills the 24 bits
       .push hl                                            ; PUSH HL           ; 
       .pop ix                                             ; POP IX            ; IX = its low 16 bits (brought down later)
       movb a,@l                                           ; LD L,A            ; remainder A:HL = its top 8 bits
       sb   a,a                                            ; XOR A             ; 
       movb a,h                                            ; LD H,A            ; 
       movb a,@c                                           ; LD C,A            ; root (C:D) = 0
       li   de,>0040                                       ; LD DE,$0040       ; E = $40: binary 01 after the root
       movb @bytes+>09,b                                   ; LD B,$09          ; 9 bits of root
_1fb4:                                                     ; >1fb4
       s    de,hl                                          ; SBC HL,DE         ; 
       sb   @c,a                                           ; SBC A,C           ; subtract the trial value from the remainder
       jnc  _1fbb                                          ; JR NC,$1FBB       ; TODO: check code. it fits
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   @c,a                                           ; ADC A,C           ; too big - add it back
_1fbb:                                                     ; >1fbb
       ; CCF                                               ; CCF               ; TODO: check code. carry = the next bit of the root
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. shift it into the root (C:D)
       a    ix,ix                                          ; ADD IX,IX         ; 
       a    hl,hl                                          ; ADC HL,HL         ; 
       ab   a,a                                            ; ADC A,A           ; bring down the next two bits of the number
       a    ix,ix                                          ; ADD IX,IX         ; 
       a    hl,hl                                          ; ADC HL,HL         ; 
       ab   a,a                                            ; ADC A,A           ; 
       sb   one,b                                          ; DJNZ $1FB4        ; next bit
       jne  _1fb4                                          ;                   
       movb @c,h                                           ; LD H,C            ; 
       movb d,@l                                           ; LD L,D            ; HL = the root
       .ret                                                ; RET               ; 

********************************************************************************
* Convert a sign-magnitude value to a sign-tagged logarithm
* 
* Used by the routines at #R$433F, #R$66DC and #R$8685.
* .
* Takes the top 9 bits of HL's 15-bit magnitude (HL >> 6) as an index
* into the word table at $0800-$0BFF, which holds log2(n) * 1024 for
* n = 0-511 (log2(1)=$0000, log2(2)=$0400, log2(4)=$0800 and so on). If HL was negative, sets bit 6 of the result's high byte to
* tag the sign. #R$2160 adds two such logs to multiply the values.
* 
* I:HL Value (sign-magnitude: bit 7 of H is the sign)
* O:HL Its logarithm, with bit 6 of H set if the value was negative
log_sign_tagged:                                           ; >1fcf
       czc  @bit7,h                                        ; BIT 7,H           ; test H's sign bit
       .ex_af_af_                                          ; EX AF,AF'         ; stash the sign flag in the shadow set
       movb h,a                                            ; LD A,H            ; A:L = HL
       srl  a,1                                            ; RRA               ; TODO: check code. shift A:L right...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...again...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...again...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...again...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...and a fifth time (A:L = HL >> 5)
       ; RR L                                              ; RR L              ; TODO: check code. 
       andi a,>0300                                        ; AND $03           ; A = one of 4 pages (0-3)
       szcb @bit0,@l                                       ; RES 0,L           ; L = an even byte offset within that page
       ab   @bytes+>08,a                                   ; ADD A,$08         ; A = $08 + page (one of $08-$0B)
       movb a,h                                            ; LD H,A            ; HL -> the table entry
       movb *hl,a                                          ; LD A,(HL)         ; read the entry (little-endian word)...
       ab   one,@l                                         ; INC L             ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; ...HL = the table entry
       .ex_af_af_                                          ; EX AF,AF'         ; restore the stashed sign flag
       jne  !                                              ; RET Z             ; HL was non-negative - return as-is
       .ret                                                ;                   
!
       socb @bit6,h                                        ; SET 6,H           ; else tag bit 6 of the result's high byte
       .ret                                                ; RET               ; 

********************************************************************************
* Convert a logarithm back to a value (antilog)
* 
* Used by the routine at #R$2160.
* .
* The inverse of #R$1FCF's log lookup: indexes the byte table at
* $0400-$07FF (an exponential curve, rising to 250 at the top) by
* HL >> 4, and returns the byte found there. Called by #R$2160 once it
* has added two logs, to turn the sum into the product.
* 
* I:HL Logarithm (as returned by #R$1FCF, or a sum of two)
* O:HL The corresponding value (0-255)
antilog:                                                   ; >1ff2
       movb h,a                                            ; LD A,H            ; A = HL's high byte
       srl  a,1                                            ; RRA               ; TODO: check code. shift A:L right...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. ...four times total...
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. ...A:L now holds HL >> 4 (roughly)
       andi a,>0300                                        ; AND $03           ; keep the low 2 bits - one of 4 pages
       ab   @bytes+>04,a                                   ; ADD A,$04         ; page 4 + that index (table lives at $0400-$07FF)
       movb a,h                                            ; LD H,A            ; H = the page
       socb @bit0,@l                                       ; SET 0,L           ; force an odd byte offset within the page
       movb *hl,@l                                         ; LD L,(HL)         ; read the table byte
       sb   h,h                                            ; LD H,$00          ; zero-extend it into HL
       .ret                                                ; RET               ; 

********************************************************************************
* Multiply two vector components
* 
* Used by the routines at #R$439D, #R$4503, #R$4599 and #R$8E62.
* .
* Returns HL * DE / $4000, where 1.0 is $4000: the inputs are
* sign-magnitude, the result a two's complement number. A shift-and-add
* multiplication, looping once for each bit of HL's magnitude (its bit
* length, from the table at #R$0200: its high byte's plus 8, or at $2028,
* if the high byte is 0, its low byte's).
* 
* I:HL First (sign-magnitude)
* I:DE Second (sign-magnitude)
* O:HL Product (two's complement)
multiply_components:                                       ; >200a
       movb h,a                                            ; LD A,H            ; 
       ; XOR D                                             ; XOR D             ; TODO: check code. the sign of the product
       .ex_af_af_                                          ; EX AF,AF'         ; save it in F'
       .push hl                                            ; PUSH HL           ; save the first number
       szcb @bit7,d                                        ; RES 7,D           ; DE = |second number|
       sb   a,a                                            ; XOR A             ; 
       li   iy,>0000                                       ; LD IY,$0000       ; 
       movb a,h                                            ; LD H,A            ; 
       movb a,@l                                           ; LD L,A            ; HL:IY = 0, the product
       movb a,b                                            ; LD B,A            ; 
       movb a,@c                                           ; LD C,A            ; BC:DE = |second number|, which is shifted left
       .exx                                                ; EXX               ; switch to the other set
       .pop bc                                             ; POP BC            ; BC = the first number
       movb @bytes+>02,h                                   ; LD H,$02          ; HL -> the bit-length table (#R$0200)
       movb b,a                                            ; LD A,B            ; 
       andi a,>7f00                                        ; AND $7F           ; A = |first number|'s high byte
       jeq  multiply_components_2                          ; JR Z,$2028        ; 0 - use the low byte's bit length
       movb a,@l                                           ; LD L,A            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; A = its bit length + 8
       jmp  _202a                                          ; JR $202A          ; 
multiply_components_2:                                     ; >2028
       movb @c,@l                                          ; LD L,C            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = the low byte's bit length
_202a:                                                     ; >202a
       movb a,@l                                           ; LD L,A            ; 
       movb b,a                                            ; LD A,B            ; A:C = |first number|
       movb @l,b                                           ; LD B,L            ; B = the number of bits
_202d:                                                     ; >202d
       srl  a,1                                            ; RRA               ; TODO: check code. shift the next bit out of the first number
       ; RR C                                              ; RR C              ; TODO: check code. 
       .exx                                                ; EXX               ; 
       jnc  _2037                                          ; JR NC,$2037       ; TODO: check code. 0 - don't add
       a    de,iy                                          ; ADD IY,DE         ; 1: add BC:DE to the product
       a    bc,hl                                          ; ADC HL,BC         ; 
_2037:                                                     ; >2037
       ; SLA E                                             ; SLA E             ; TODO: check code. shift BC:DE left
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       sla  b,1                                            ; RL B              ; TODO: check code. 
       .exx                                                ; EXX               ; 
       sb   one,b                                          ; DJNZ $202D        ; next bit
       jne  _202d                                          ;                   
       .exx                                                ; EXX               ; 
       movb iyh,a                                          ; LD A,IYH          ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; HL = the product / $4000
       .ex_af_af_                                          ; EX AF,AF'         ; the sign
       jlt  !                                              ; RET P             ; positive - done
       .ret                                                ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Distance between two points on a chart
* 
* Used by the routine at #R$6141.
* .
* Returns 4 * sqrt(dx^2 + dy^2) for the points (D,E) and (B,C), from
* #R$205D's squared distance and #R$1F9C's square root.
* 
* I:B,C One point
* I:D,E The other point
* O:HL Four times the distance between them
distance_between_two_2d_points_d:                          ; >2054
       .call @squared_distance_2d                          ; CALL $205D        ; 
       .call @square_root                                  ; CALL $1F9C        ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Squared distance between two 2D points: (D,E) and (B,C)
* 
* Used by the routines at #R$2054, #R$5325 and #R$538B.
* .
* Computes dx=|E-C| and dy=|D-B|, squares each via #R$1F5E (using the
* alternate register set to hold dx's square across the second call),
* then adds them: HL = dx^2 + dy^2. A's bit 0 on return holds any carry
* out of the 16-bit sum (ADC A,A folding the final #R$1F5E's overflow in).
squared_distance_2d:                                       ; >205d
       movb @e,a                                           ; LD A,E            ; 
       sb   @c,a                                           ; SUB C             ; 
       jnc  _2063                                          ; JR NC,$2063       ; TODO: check code. 
       neg a                                               ; NEG               ; A = |E - C|
_2063:                                                     ; >2063
       movb a,@l                                           ; LD L,A            ; L = dx
       movb d,a                                            ; LD A,D            ; 
       sb   b,a                                            ; SUB B             ; 
       jnc  _206a                                          ; JR NC,$206A       ; TODO: check code. 
       neg a                                               ; NEG               ; A = |D - B|
_206a:                                                     ; >206a
       .ex_af_af_                                          ; EX AF,AF'         ; save dy
       .call @square_l                                     ; CALL $1F5E        ; HL = dx^2 (#R$1F5E)
       .push hl                                            ; PUSH HL           ; save it
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb a,@l                                           ; LD L,A            ; L = dy
       .call @square_l                                     ; CALL $1F5E        ; HL = dy^2
       .pop de                                             ; POP DE            ; 
       sb   a,a                                            ; XOR A             ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   a,a                                            ; ADC A,A           ; A:HL = dx^2 + dy^2
       .ret                                                ; RET               ; 

********************************************************************************
* Divide: 16-bit / 8-bit -> 16-bit, unsigned
* 
* Used by the routines at #R$1C5C, #R$265E, #R$281E, #R$4DAB, #R$4EEC, #R$4F37,
* #R$512F, #R$525F, #R$5D72, #R$5E6B, #R$6A59, #R$6AAD, #R$6BB3, #R$6BCA and
* #R$9BB2.
* .
* HL = HL/A via standard restoring division (16 iterations, shift-subtract-
* restore). Frequently paired with #R$1F60 (multiply then divide, i.e.
* scale a value by a fraction) - see e.g. #R$6A59/#R$6AAD/#R$6BB3/#R$6BCA's
* dashboard gauges.
