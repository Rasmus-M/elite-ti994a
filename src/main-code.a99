********************************************************************************
* Enemy ECM on
* 
* Set by #R$25B9 when the target of the player's missile sets off its ECM,
* so that #R$323C knows it isn't the player's ECM (and doesn't drain the
* player's energy for it); cleared by #R$323C when the ECM finishes.
enemy_ecm:                                                 ; >eec0
       byte >00

********************************************************************************
* In witchspace
* 
* Set by #R$894D when a hyperspace jump goes wrong ("Drive malfunction",
* a 12/256 chance) and the ship ends up in witchspace, halfway between
* the two systems ($EEC3/$EEC4). There, only Thargoids appear (#R$2B05);
* hyperspace can't be used until enough of them have been dealt with
* (#R$EEC2); the Torus Jump Drive doesn't work (#R$86E6); and there is no
* stardust (#R$68CD) or compass (#R$85FB).
in_witchspace:                                             ; >eec1
       byte >00

********************************************************************************
* Witchspace: ships still to kill
* 
* Set by #R$894D to (rank (#R$EB12) + 1) * 2 on arriving in witchspace,
* and counted down by #R$30A9 as each object is removed. Hyperspace
* (#R$88AC) doesn't work until it's 0.
witchspace_kills_needed:                                   ; >eec2
       byte >00

********************************************************************************
* Witchspace position
* 
* The ship's position on the charts in witchspace, halfway between the
* two systems (#R$894D): x, then y. The chart cursor is put there
* (#R$4D6C, #R$527F), and distances are measured from it (#R$6153).
witchspace_position:                                       ; >eec3
       byte >00                                                      ; 
witchspace_position_y:                                     ; >eec4
       byte >00                                                      ; 

********************************************************************************
* Witchspace: number of Thargoids
* 
* How many Thargoids #R$2B05 keeps about in witchspace: set by #R$894D
* to 1-4, more the worse the player's legal status (#R$EB65).
witchspace_thargoids:                                      ; >eec5
       byte >00

********************************************************************************
* Explosion random numbers
* 
* 100 random words, each a random entry from the table at #R$0800 with a
* random sign, filled by #R$6F9F at startup. #R$47A1 reads the next two for
* each dot of an explosion (from the pointer at #R$E6DE).
explosion_random_numbers:                                  ; >eec6
       byte >D6,>5D,>11,>59,>01,>55,>A9,>AF
       byte >32,>DD,>21,>00,>00,>1E,>B9,>1F
       byte >F4,>1F,>5A,>01,>FE,>5E,>F7,>C3
       byte >16,>19,>00,>00,>4A,>11,>08,>5D
       byte >00,>50,>01,>1C,>17,>01,>2A,>FE
       byte >08,>00,>00,>14,>C6,>1E,>9B,>5E
       byte >20,>01,>5C,>19,>47,>41,>CB,>C6
       byte >00,>00,>AE,>18,>30,>1E,>18,>1A
       byte >01,>1E,>57,>45,>20,>17,>ED,>00
       byte >00,>5B,>A3,>19,>38,>5E,>84,>01
       byte >89,>1D,>56,>45,>ED,>5B,>00,>00
       byte >E0,>5C,>05,>5F,>A7,>5F,>01,>5A
       byte >DD,>20,>2A,>87,>4F,>00,>00,>57
       byte >55,>1F,>44,>58,>75,>01,>6E,>55
       byte >C9,>7C,>90,>04,>00,>00,>C2,>58
       byte >57,>4A,>E9,>56,>01,>1F,>84,>57
       byte >01,>F5,>1F,>00,>00,>4C,>00,>1E
       byte >E9,>1F,>11,>01,>57,>16,>F5,>1F
       byte >1D,>1F,>00,>00,>99,>18,>00,>5C
       byte >1B,>5D,>01,>5B,>2D,>1F,>1F,>00
       byte >C0,>00,>00,>1C,>A2,>5E,>D6,>55
       byte >05,>01,>A1,>53,>60,>01,>E6,>0F
       byte >00,>00,>E2,>5E,>FE,>18,>08,>5A
       byte >01,>5F,>39,>E6,>0F,>6D,>6F,>00
       byte >00,>5F,>00,>4C,>D1,>17,>28,>01

********************************************************************************
* Flight controls off
* 
* Set by #R$1A7D, which also stops any roll and pitch, when the escape
* capsule is launched (#R$19FC), the Torus jump drive is engaged (#R$86E6)
* or a hyperspace jump starts (#R$894D). Cleared when the Torus jump ends
* or is cut short (#R$13FD, at $14CD and $14F1), when the escape capsule's
* countdown runs out (#R$2810), on the title screen (#R$1C5C, at $1DC8) and
* by #R$707D. While it's set, #R$401C ignores the flight controls and every
* key but the pause key, attacking ships don't fire (#R$26A9, at $26E0) and
* there are no collisions (#R$8755, at $876A).
flight_controls_off:                                       ; >ef8e
       byte >00

********************************************************************************
* Shuttle countdown
* 
* Counted down by #R$2B24 in the space station's safe zone; when it
* runs out, an Orbit Shuttle or Transporter is launched. Set to a random
* value from 128 to 255 by #R$707D, like #R$EF90 and #R$EF91.
shuttle_countdown:                                         ; >ef8f
       byte >00

********************************************************************************
* Asteroid countdown
* 
* Counted down by #R$2B24 outside the safe zone; when it runs out, an
* asteroid is spawned. Set to a random value from 128 to 255 by #R$707D.
asteroid_countdown:                                        ; >ef90
       byte >00

********************************************************************************
* Trader countdown
* 
* Counted down by #R$2B24 while there are no traders about; when it
* runs out, a trader is spawned. Set to a random value from 128 to 255
* by #R$707D.
trader_countdown:                                          ; >ef91
       byte >00

********************************************************************************
* Vector X component, shifted down (#R$84A6)
* 
* #R$84A6 (at $84C0) leaves the X component here after shifting it down
* to fit in a byte (#R$8515).
ef92_scaled_magnitude_1:                                   ; >ef92
       byte >00

********************************************************************************
* Vector Y component, shifted down (#R$84A6)
* 
* As #R$EF92, for Y (#R$84A6 at $84CA).
ef93_scaled_magnitude_2:                                   ; >ef93
       byte >00

********************************************************************************
* Vector Z component, shifted down (#R$84A6)
* 
* As #R$EF92, for Z (#R$84A6 at $84D4).
ef94_scaled_magnitude_3:                                   ; >ef94
       byte >00

********************************************************************************
* Game-clock tick divider
* 
* #R$729D's own driver for #R$F742's clock: decremented each VBlank,
* reset to $32 (50) on hitting 0, at which point the clock actually
* advances - see #R$F742's description.
ef95_clock_divider:                                        ; >ef95
       byte >00

********************************************************************************
* Fill character for numbers
* 
* The character #R$3675 pads numbers with on the left: a space normally (set
* at start-up by #R$6F9F), or '0' while #R$1A8A shows the clock's days, hours
* and minutes (#R$F742).
number_fill_char:                                          ; >ef96
       byte >20

********************************************************************************
* Copy of the legal status made by #R$291E
* 
* #R$291E copies #R$EB65 here whenever the player shoots the space
* station; cleared by #R$707D.
* While it's nonzero the docking computer won't work (#R$1692) and
* #R$8755 skips its docking check (at $877B).
legal_status_copy:                                         ; >ef97
       byte >00

********************************************************************************
* Per-object flag (see #R$EF99's sibling)
* 
* Cleared alongside #R$EF99 by #R$422E; set (unconditionally, $FF) at
* $42CA within #R$4255's body; read by two
* object-type render handlers (#R$254C, and a further site at $27B6)
* to gate their own bodies.
ef98_per_object_flag:                                      ; >ef98
       byte >00

********************************************************************************
* Object in the laser sights
* 
* Cleared for each object by #R$422E and set by #R$4735 (at $4779) when
* it's in the laser sights; #R$28F6 only lets the laser hit it when it's
* set.
in_sights:                                                 ; >ef99
       byte >00

********************************************************************************
* Pirate countdown
* 
* A 16-bit countdown, run by #R$2B24 outside the safe zone; when it
* runs out, pirates are spawned (#R$2C3C). Its high byte ($EF9B) is set
* to the system's government + 2 by #R$707D and #R$2B24, so pirates come
* more often in lawless systems.
pirate_countdown:                                          ; >ef9a
       byte >00                                                      ; 
pirate_countdown_hi:                                       ; >ef9b
       byte >00                                                      ; 

********************************************************************************
* Safe-zone entry one-shot latch
* 
* The first time the ship enters the space station's safe zone while this
* is zero, #R$1549 (at $1560-$1567) sets it to $FF and calls #R$2C21. Also
* written within #R$1837 (at $1845) and cleared at startup by
* #R$707D.
safe_zone_entry_latch:                                     ; >ef9c
       byte >00

********************************************************************************
* Identify the target
* 
* Set by the 'I' key (#R$1B0D); the next object in the laser sights has
* its name shown (#R$4735), which clears it.
identify_target:                                           ; >ef9d
       byte >00

********************************************************************************
* VRAM-write-in-progress busy flag
* 
* Set to $FF (suppress) while a screen/VRAM update is under way and
* cleared to 0 (allow) once it's done. #R$3955 and
* #R$70E8/#R$7139 bracket each individual VRAM fill
* this way, set-then-clear in quick succession; #R$63F1
* (enter_flight_mode) holds it set across a longer stretch (through
* #R$7139 and #R$6433) before clearing it once at the end - so the
* flag marks "don't touch VRAM right now" for however long that takes,
* not a single atomic operation. Read by #R$7202's own header ("if
* ($EF9E) is clear") to skip certain VBlank-time work while any of
* these are in progress, avoiding VRAM contention.
vram_busy_flag:                                            ; >ef9e
       byte >00

********************************************************************************
* Cloaking device active
* 
* Toggled between 0 and $FF by the 'Y' key (#R$1B13) in flight, if a cloaking
* device is fitted (#R$F784), and cleared by #R$707D. While it's set, the
* energy (#R$F817) drains by 1 every other frame and "Cloaking active" is
* shown (#R$13FD, at $1415), attacking ships don't fire their lasers
* (#R$26A9, at $26D1) and ships don't launch missiles (#R$2A3A). In this
* snapshot it holds a byte written by the tune-restart bug (#R$7603).
cloaking_active_flag:                                      ; >ef9f
       byte >00

********************************************************************************
* Flag-nibble search result index (cached)
* 
* #R$6D24's own header describes the search (four flag-nibble bytes
* at $F779/$F781/$F77A/$F782 checked against ($EB9A)'s bit pattern);
* this caches the result (D) alongside $F818 (C) at its tail ($6D6F).
* No read site found for this specific cache in this capture.
flag_search_result_cache:                                  ; >efa0
       byte >00

********************************************************************************
* Don't worsen the legal status for this destruction
* 
* Set by #R$8755 (at $87BD/$87C3) before it destroys an object via
* #R$31AD, so that #R$31AD leaves the legal status (#R$EB65) alone.
legal_status_exempt:                                       ; >efa1
       byte >00

********************************************************************************
* Mission system
* 
* The system that matters to the current mission: the navy research
* centre the Constrictor was stolen from, then each system on its trail
* (mission 1, #R$9120, #R$894D, #R$91AA); or the naval base the Thargoid
* documents are to be delivered to (mission 2, #R$9120).
mission_system:                                            ; >efa2
       byte >00

********************************************************************************
* Mission 1: systems left on the Constrictor's trail
* 
* Set to 5 by #R$894D when the player follows the Constrictor's
* galactic jump, and counted down by #R$91AA at each system on its
* trail.
constrictor_trail_count:                                   ; >efa3
       byte >00

********************************************************************************
* End of the stardust table
* 
* Set by #R$6F9F to the end of its own code ($7044), which becomes the
* stardust table (see #R$EFA6). The chart routines (#R$4FA2, #R$502C, #R$50AA,
* #R$538B) keep their lists of systems at the address it holds. In this
* snapshot its low byte is $00 rather than $44.
reclaimed_range_end:                                       ; >efa4
       byte (startup_code_stardust_table+>00a6)%%256,(startup_code_stardust_table+>00a6)//256

********************************************************************************
* Stardust table address / reclaimed-memory range start (word)
* 
* Confirmed by the same $7003 disassembly as #R$EFA4's description:
* `LD HL,$6F9F / LD ($EFA6),HL` stores this routine's own start
* address. #R$6882 and
* #R$68EA load it directly as `IX,($EFA6)`, and it's also loaded
* within #R$66DC (at $66E9), #R$6775 (at $677E), #R$6956 (at $6963)
* and #R$699C (at $69A8) - the 15-particle stardust table (see #R$68CD),
* which occupies the reclaimed $6F9F-$7043 space.
reclaimed_range_start:                                     ; >efa6
       byte startup_code_stardust_table%%256,startup_code_stardust_table//256

********************************************************************************
* ECM jammer active
* 
* Toggled between 0 and $FF by the 'L' key (#R$1B25), if an ECM jammer is
* fitted (#R$F783), and cleared by #R$707D. While it's set, the energy
* (#R$F817) drains by 1 every other frame and "Jammer active" is shown
* (#R$13FD, at $1426), like the cloaking device (#R$EF9F).
jammer_active_flag:                                        ; >efa8
       byte >00

********************************************************************************
* Space station destroyed
* 
* Cleared on launching (#R$707D), and made nonzero by #R$291E when the
* player destroys the space station; from then on nothing is launched
* from it (#R$3187).
station_destroyed:                                         ; >efa9
       byte >00

********************************************************************************
* Random byte for market-price generation
* 
* Rolled random by #R$894D's galactic/system-arrival tail just before
* calling #R$4BA8, which reads it back (AND-masked per item) while
* building the arrival system's 17-item price table at $0A02.
market_price_roll:                                         ; >efaa
       byte >00

********************************************************************************
* RG1SAV: copy of VDP register 1
* 
* The MSX BIOS's copy of VDP register 1. #R$6F9F sets the sprite size to
* 16x16 in it, and #R$70E8 clears bit 6 (blanking the screen) and writes it
* to the VDP.
       .msxalign >f3e0
vdp_reg1_cache:                                            ; >f3e0
       byte >E2

********************************************************************************
* Menu/text buffer (128 bytes): default commander record
* 
* #R$A433 (`LD HL,$7172 / LD DE,$F6C0 / LD BC,$0080 / LDIR`) copies a
* fixed 128-byte record here as the default commander. #R$A44F and
* #R$A469 also use it to pack and unpack the commander file (see #R$A551's
* list of variables), and it holds tape-menu text at times, so its contents
* vary.
       .msxalign >f6c0
commander_menu_buffer:                                     ; >f6c0
       byte >00,>4A,>5A
       byte >48,>02,>53,>B7,>07,>03,>50,>C3            ; (TI: cash temporarily 5000.0 credits, for testing)
       byte >00,>00,>2D,>31,>01,>FF,>46,>03
       byte >00,>00,>81,>80,>00,>00,>00,>00
       byte >00,>00,>80,>80,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>01,>00,>00,>40,>00,>00
       byte >00,>00,>00,>00,>00

********************************************************************************
* Address of the cockpit screen picture (word)
* 
* Holds $CAD7, the cockpit picture (#R$CAD7). Saved here from HL by the
* one-time startup code (#R$6F9F, step 1), and read by #R$7139, which
* unpacks the picture (#R$390E) when entering flight.
cockpit_picture_addr:                                      ; >f740
       byte cockpit_picture%%256,cockpit_picture//256

********************************************************************************
* In-game clock: seconds/minutes/hours/days
* 
* #R$729D (called every VBlank from #R$7202) decrements #R$EF95 each
* call and only advances the clock once that hits 0 (resetting it to
* $32=50) - 50 VBlanks per tick. Combined with the caps below (60/60/
* 24), that's the programmer's intent unambiguously: seconds, minutes
* and hours, whatever the actual VBlank rate is (the clock runs at the
* intended speed on a 50 Hz machine, and fast on a 60 Hz one). It then
* walks these 4 bytes with HL,
* incrementing and cascading: $F742 (seconds) wraps at $3C (60) and
* bumps $F743 (minutes), which wraps at $3C and bumps $F744 (hours),
* which wraps at $18 (24) and bumps $F745 (days, uncapped). Saved with
* the commander (#R$A551).
game_clock:                                                ; >f742
       byte >12                                                      ; 
clock_minutes:                                             ; >f743
       byte >00                                                      ; 
clock_hours:                                               ; >f744
       byte >00                                                      ; 
clock_days:                                                ; >f745
       byte >00                                                      ; 

********************************************************************************
* Main-loop tick/frame counter (16-bit)
* 
* Advanced once per pass of #R$0106's main loop (`LD HL,($F746) / INC
* HL / LD ($F746),HL` at $010F-$0113) - counts loop passes, not VBlanks.
* Also read by the routines at #R$13FD (at $140F) and #R$422E (at $4249).
main_loop_tick_counter:                                    ; >f746
       byte >00,>00

********************************************************************************
* VBlank sub-tick counter since the last loop pass
* 
* Incremented by the RST $38 handler (#R$7202, see #R$0038's own
* comment) on every VBlank interrupt. Zeroed right after ($F746) is
* advanced, at $0117 (and again at $1E61), then polled until >=7 at
* #R$1EBC - a "wait a few frames" gate distinct from the free-running
* ($F746) counter.
vblank_subtick_counter:                                    ; >f748
       byte >03

********************************************************************************
* Game over flag
* 
* Set to $FF when the game ends: by #R$16BA when the ship is destroyed,
* crashes into the planet or burns up in the sun, and by #R$412C when the
* player quits from the pause screen, with the cause in #R$F74A. The main
* loop (#R$0106) runs the game until it's set, then shows the death scene
* (#R$1703) and clears it. Explosions (#R$2556) step ($F7F0) down rather
* than up while it's set.
game_over:                                                 ; >f749
       byte >00

********************************************************************************
* How the game ended
* 
* Set with #R$F749: 0 = crashed into the planet, 1 = destroyed (energy
* banks empty), 2 = burned up in the sun (cabin temperature too high), all
* set by #R$16BA; 3 = quit from the pause screen (#R$412C). The main loop
* (#R$0106) shows the death scene (#R$1703) for 0-2 but not 3.
game_over_cause:                                           ; >f74a
       byte >00

********************************************************************************
* Generated system: seed s0, low byte
* 
* #R$4C2B copies the three 16-bit seeds of the system last generated by
* #R$4C9B (s0, s1, s2, from #R$E904) to $F74B-$F750, and derives the
* system's data from them at $F751-$F759.
system_s0_lo:                                              ; >f74b
       byte >00

********************************************************************************
* Generated system: seed s0, high byte
* 
* XORed with s1's high byte (#R$F74E) to pick the species of the
* inhabitants (#R$60F8), as in BBC Elite.
system_s0_hi:                                              ; >f74c
       byte >00

********************************************************************************
* Generated system: seed s1, low byte
* 
* Bits 3-5 are added to the population (#R$6189).
system_s1_lo:                                              ; >f74d
       byte >00

********************************************************************************
* Generated system: seed s1, high byte
* 
* See #R$F74C.
system_s1_hi:                                              ; >f74e
       byte >00

********************************************************************************
* Generated system: seed s2, low byte
* 
* Shown as the average radius (#R$6189).
system_s2_lo:                                              ; >f74f
       byte >00

********************************************************************************
* Generated system: seed s2, high byte
* 
* Describes the inhabitants (#R$60F8): bits 2-4 their size, bits 5-7
* their colour, and bits 0-1 are added to the species.
system_s2_hi:                                              ; >f750
       byte >00

********************************************************************************
* Generated system: x coordinate
* 
* On the galactic chart: from s1's high byte (#R$4C2B).
system_x:                                                  ; >f751
       byte >00

********************************************************************************
* Generated system: y coordinate
* 
* On the galactic chart: s0's high byte / 2 (#R$4C2B).
system_y:                                                  ; >f752
       byte >00

********************************************************************************
* Generated system: government
* 
* 0-7 (Anarchy ... Corporate State, the names at #R$0FA7): bits 3-5 of
* s1's low byte (#R$4C2B).
system_government:                                         ; >f753
       byte >00

********************************************************************************
* Generated system: economy
* 
* 0-3 Poor, Average, Mainly and Rich Agricultural, 4-7 Poor, Average,
* Mainly and Rich Industrial (the words at #R$0F75, see #R$6189). Worked
* out by #R$4C2B from s0's high byte and the government.
system_economy:                                            ; >f754
       byte >00

********************************************************************************
* Generated system: tech level
* 
* Worked out by #R$4C2B from the economy and seeds. Shown on the Data on
* System screen, and decides the population (#R$6189).
system_tech_level:                                         ; >f755
       byte >00

********************************************************************************
* Generated system: name
* 
* Four indices into the letter pairs at #R$0E41 (#R$4CE7), which
* #R$4CB8 expands into the name; the last is 0 for a name with only
* three pairs.
system_name:                                               ; >f756
       byte >00,>00,>00,>00

********************************************************************************
* Current system: seeds
* 
* #R$4BA8 copies the generated system's data ($F74B-$F759) to
* $F75A-$F768 on arriving in a system: the seeds here (see #R$F74B), then
* its coordinates, government, economy, tech level and name.
current_system_seeds:                                      ; >f75a
       byte >00,>00,>00,>00,>00,>00

********************************************************************************
* Current system: x coordinate
* 
* See #R$F751.
current_system_x:                                          ; >f760
       byte >00

********************************************************************************
* Current system: y coordinate
* 
* See #R$F752.
current_system_y:                                          ; >f761
       byte >00

********************************************************************************
* Current system: government
* 
* See #R$F753. The more lawless the system, the more pirates (#R$2B24,
* #R$13FD) and the less chance of the police being called (#R$2C21).
current_system_government:                                 ; >f762
       byte >00

********************************************************************************
* Current system: economy
* 
* See #R$F754.
current_system_economy:                                    ; >f763
       byte >00

********************************************************************************
* Current system: tech level
* 
* See #R$F755. Decides which equipment is on sale (#R$5DBB, against the
* minimum tech levels at #R$115C).
tech_level:                                                ; >f764
       byte >00

********************************************************************************
* Current system: name
* 
* See #R$F756.
current_system_name:                                       ; >f765
       byte >00,>00,>00,>00

********************************************************************************
* The ends of the line being drawn
* 
* The x, y and z (words) of the two ends of a ship's laser beam (#R$43C2)
* or an edge (#R$496D) in the view, kept so that #R$4B22 can clip the line
* where it passes the player when one end is behind: $F769-$F76E is the end
* behind the player, $F76F-$F774 the end in front.
line_end_1_x:                                              ; >f769
       byte >00,>00                                                  ; 
line_end_1_y:                                              ; >f76b
       byte >00,>00                                                  ; 
line_end_1_z:                                              ; >f76d
       byte >00,>00                                                  ; 
line_end_2_x:                                              ; >f76f
       byte >00,>00                                                  ; 
line_end_2_y:                                              ; >f771
       byte >00,>00                                                  ; 
line_end_2_z:                                              ; >f773
       byte >00,>00                                                  ; 

********************************************************************************
* Equipment item 1: Fuel level, in tenths of a light year (0-70)
* 
* The first entry of the 14-entry, 1-byte-per-item equipment array that
* #R$5DD9's page indexes - see that routine's comment for the full
* item list (#R$0FFC's order) and the selector cascade that reads this
* array (#R$5E1F onward). Fuel and Missiles (#R$F776) are the two
* special-cased items; this one is read/written directly as a 0-70
* counter by #R$5E7D/#R$5E8B/#R$5EBB and drawn as a dashboard dial by
* #R$6AAD.
* .
* The other entries: missiles (#R$F776) are a count. A laser's entry
* (#R$F779, #R$F77A, #R$F781, #R$F782) has bit 7 set, plus a bit for each
* mount it's fitted to - bit 0 front, 1 rear, 2 left, 3 right (#R$5EFE,
* #R$6D24). Any other item is 0 if it isn't fitted and 1 if it is (#R$5EE4
* allows only one), except that the energy unit (#R$F77E) is 2 for a naval
* one (#R$91DB).
fuel_level:                                                ; >f775
       byte >00

********************************************************************************
* Equipment item 2: Missile count
* 
* The second entry of the equipment array (#R$5DD9). On the equipment
* page, #R$5ED1 refuses a purchase at exactly 4 (a full rack). Drawn on
* the flight dashboard as a 4-segment indicator by #R$6B6E, called
* alongside the fuel dial (#R$F775) from the same full-redraw routine
* (#R$6433) - classic Elite's four missile pylon lights.
missile_count:                                             ; >f776
       byte >00

********************************************************************************
* Equipment item 3: Large Cargo Bay
* 
* 0 if it isn't fitted and 1 if it is, like most of the equipment (see
* #R$F775). #R$6002 sets it when it's bought, and #R$63BA uses it to work
* out the hold's capacity.
item_large_cargo_bay:                                      ; >f777
       byte >00

********************************************************************************
* Equipment item 4: ECM system
* 
* See #R$F777's comment for the generic equipment-array mechanism this
* entry shares.
item_ecm_system:                                           ; >f778
       byte >00

********************************************************************************
* Equipment item 5: Pulse Laser
* 
* See #R$F777 for the equipment. For a laser, bit 7 is always set
* (marking it as a laser, see #R$6355), and bits 0-3 are the mounts it's
* fitted to: front, rear, left and right (#R$6D24). The default commander
* has a pulse laser on the front mount ($81).
item_pulse_laser:                                          ; >f779
       byte >00

********************************************************************************
* Equipment item 6: Beam Laser
* 
* See #R$F779.
item_beam_laser:                                           ; >f77a
       byte >00

********************************************************************************
* Equipment item 7: Fuel Scoop
* 
* See #R$F777's comment for the generic equipment-array mechanism this
* entry shares.
item_fuel_scoop:                                           ; >f77b
       byte >00

********************************************************************************
* Equipment item 8: Escape Capsule
* 
* See #R$F777's comment for the generic equipment-array mechanism this
* entry shares.
item_escape_capsule:                                       ; >f77c
       byte >00

********************************************************************************
* Equipment item 9: Energy Bomb
* 
* See #R$F777's comment for the generic equipment-array mechanism this
* entry shares.
item_energy_bomb:                                          ; >f77d
       byte >00

********************************************************************************
* Equipment item 10: energy unit
* 
* 1 for an extra energy unit (bought), 2 for a naval energy unit (the
* reward for mission 2, #R$91DB). Speeds up recharging (#R$18E6). See
* #R$F777 for the equipment array.
item_energy_unit:                                          ; >f77e
       byte >00

********************************************************************************
* Equipment item 11: Docking Computer
* 
* See #R$F777 for how the equipment entries work. Also read by the 'C' key
* handler (#R$1692), which needs the space station to be in range as well
* (#R$EB05).
item_docking_computer:                                     ; >f77f
       byte >00

********************************************************************************
* Galactic hyperdrive fitted flag, consumed on jump
* 
* Equipment item 12 of #R$5DD9's array (#R$F775+11). Set when fitted;
* #R$8926 (the 'G' key) does nothing if it's clear, and clears it when the
* jump is made, so it can only be used once.
galactic_drive_fitted:                                     ; >f780
       byte >00

********************************************************************************
* Equipment item 13: Mining Laser
* 
* See #R$F779.
item_mining_laser:                                         ; >f781
       byte >00

********************************************************************************
* Equipment item 14: Military Laser
* 
* See #R$F779.
item_military_laser:                                       ; >f782
       byte >00

********************************************************************************
* ECM jammer fitted
* 
* Set by #R$920F as the reward for mission 5 (destroying the Thargoid
* base). Needed for the 'L' key (#R$1B25).
ecm_jammer_fitted:                                         ; >f783
       byte >00

********************************************************************************
* Cloaking device fitted
* 
* Set when the player scoops the Cougar's cargo canister (#R$8BA6), the
* reward for mission 4. Needed for the 'Y' key (#R$1B13).
cloaking_device_fitted:                                    ; >f784
       byte >00

********************************************************************************
* Carrying the Thargoid documents
* 
* Set by #R$916C when mission 2 is accepted, and cleared by #R$91DB when
* the documents are delivered.
carrying_documents:                                        ; >f785
       byte >00

********************************************************************************
* Unused: end of the saved equipment record
* 
* The last 3 bytes of the 20 bytes from #R$F775 that the commander file
* saves (#R$A551). Nothing else in the game uses them, so they only ever
* hold what #R$A469 loads into them.
unused_f786:                                               ; >f786
       byte >00,>00,>00

********************************************************************************
* Market
* 
* The current system's market (#R$4BA8), 4 bytes for each of the goods:
* its price (in units of 0.4 credits, see #R$5B99), the quantity for
* sale (0-63), the units (0 tonnes, 1 kilograms, 2 grams), and how
* illegal it is (see #R$0A02).
market:                                                    ; >f789
       byte >00,>00                                                  ; Food
market_units:                                              ; >f78b
       byte >00,>00                                                  ; 
       byte >00,>00,>00,>00                                          ; Textiles
       byte >00,>00,>00,>00                                          ; Radioactives
       byte >00,>00,>00,>00                                          ; Slaves
       byte >00,>00,>00,>00                                          ; Liquor/Wines
       byte >00,>00,>00,>00                                          ; Luxuries
       byte >00,>00,>00,>00                                          ; Narcotics
       byte >00,>00,>00,>00                                          ; Computers
       byte >00,>00,>00,>00                                          ; Machinery
       byte >00,>00,>00,>00                                          ; Alloys
       byte >00,>00,>00,>00                                          ; Firearms
       byte >00,>00,>00,>00                                          ; Furs
       byte >00,>00,>00,>00                                          ; Minerals
       byte >00,>00,>00,>00                                          ; Gold
       byte >00,>00,>00,>00                                          ; Platinum
       byte >00,>00,>00,>00                                          ; Gem-Stones
       byte >00,>00,>00,>00                                          ; Alien Items

********************************************************************************
* Object status
* 
* Byte 0 of the 40-byte record of the object being processed (copied
* from the object table, #R$EBA0, by #R$13FD). Bit 0: in use. Bit 2:
* can't be shot (#R$4735). Bit 3: no collisions (#R$8755), and the
* orientation isn't rotated (#R$221B) - bits 2 and 3 are set for the
* planet, the sun and explosions (#R$31AD). Bit 5: hostile (#R$2528).
* Bit 6: no bounty when it's destroyed (#R$2556) - set for missiles and
* cargo when they're created (#R$2D7E, #R$8DB9), and for anything destroyed
* by a collision (#R$8755), the ECM (#R$323C) or the energy bomb (#R$329E).
* Bit 7: the roof vector has been worked out since
* the orientation last changed (#R$4599).
object_status_byte:                                        ; >f7cd
       byte >81

********************************************************************************
* Position X (word), per-object workspace
* 
* The object's position is (x, y, z) at $F7CE, $F7D0 and $F7D2 (see
* #R$EBA0). The player's roll and pitch (#R$221B, #R$22C0) rotate it every
* frame. Part of the object being processed, with #R$F7CD.
object_position_x:                                         ; >f7ce
       data >0000                                                 ; (TI: the position and orientation words are big-endian)
position_x_hi:
       equ  object_position_x

********************************************************************************
* Position Y (word), per-object workspace
* 
* Second word of the same position vector - see #R$F7CE's own
* comment. Within the same per-object workspace as #R$F7CD.
object_position_y:                                         ; >f7d0
       data >0000                                                 ; 
position_y_hi:
       equ  object_position_y

********************************************************************************
* Position Z (word), per-object workspace
* 
* The position vector's third word (Z) - #R$F7D3 is its high byte,
* doubling as the position's Z sign (TI: at this label, as the word is
* big-endian). Within the same
* per-object workspace as #R$F7CD.
object_position_z:                                         ; >f7d2
       data >00C0                                                 ; 

********************************************************************************
* Position's Z sign byte
* 
* High byte of the two-byte Z word starting at #R$F7CE's sibling
* $F7D2, within the same per-object workspace as #R$F7CD. Read
* throughout the render pipeline (#R$87DD, #R$8238, #R$863B) and picks
* between #R$F80F/#R$F810 in #R$193F's shield-damage routine.
object_z_sign:
       equ  object_position_z

********************************************************************************
* Side vector
* 
* The object's orientation, as three unit vectors: the side vector here
* (x, y, z), the nose vector (#R$F7DA) and the roof vector (#R$F7E0).
* Each component is sign-magnitude, with 1.0 = $4000. A vertex at (x, y,
* z) in the blueprint is at x * side + y * roof + z * nose (#R$4464).
side_vector:                                               ; >f7d4
       data >4000                                                 ; 
side_vector_y:                                             ; >f7d6
       data >0000                                                 ; 
side_vector_z:                                             ; >f7d8
       data >0000                                                 ; 

********************************************************************************
* Nose vector
* 
* See #R$F7D4. Used for docking (#R$87DD) and ships' laser beams
* (#R$43C2).
nose_vector:                                               ; >f7da
       data >0000                                                 ; 
nose_vector_x_hi:
       equ  nose_vector
nose_vector_y:                                             ; >f7dc
       data >0008                                                 ; 
nose_vector_z:                                             ; >f7de
       data >4001                                                 ; 

********************************************************************************
* Orientation vector 2: Z high byte/sign
* 
* High byte of #R$F7DA's Z word - see that entry's own comment. Read
* standalone as vector 2's Z sign byte by #R$2F2F (see #R$E866's own
* comment).
orientation_vector_2_z_sign:
       equ  nose_vector_z

********************************************************************************
* Roof vector
* 
* See #R$F7D4. Worked out as nose x side (#R$4599).
roof_vector:                                               ; >f7e0
       data >0000                                                 ; 
roof_vector_y:                                             ; >f7e2
       data >376A                                                 ; 
roof_vector_z:                                             ; >f7e4
       data >A007                                                 ; 

********************************************************************************
* Speed
* 
* The object's speed: #R$866D moves it forward by this much (scaled by
* its distance, see #R$8B66) along its axis vector each frame. Set at
* spawn (#R$3037) from byte $0D of the ship's blueprint (see #R$A817),
* unless the spawning code has set it to 0, and changed by 4 per frame
* by #R$2869 - increased up to the maximum in $F802 while ($F7F4) is set,
* otherwise reduced. The death scene (#R$1703) slows its debris down every
* 4th frame.
object_speed:                                              ; >f7e6
       byte >00

********************************************************************************
* Ship type
* 
* The working object's ship type: its blueprint number in the table at
* #R$A7D7, which lists them all (1 the Space Station, 2 a missile, 3 a
* cargo canister, ... $1F the Constrictor), or $64 for the planet and
* $65 for the sun. Byte $1A of the 40-byte object record copied to
* #R$F7CD.
ship_type:                                                 ; >f7e7
       byte >0A

********************************************************************************
* Rotations since the orientation was straightened out
* 
* Counted by the rotation routines (#R$221B, #R$22C0); at 200, #R$4503
* straightens out the orientation and resets it.
rotation_count:                                            ; >f7e8
       byte >60

********************************************************************************
* Energy
* 
* The object's energy: set at spawn (#R$3037) from byte $0C of its
* blueprint (see #R$A817), and reduced by laser hits (#R$291E) and
* collisions (#R$8755). When it runs out, the object is destroyed.
object_energy:                                             ; >f7e9
       byte >00

********************************************************************************
* Missiles
* 
* How many missiles the object has: set at spawn (#R$3037) from bits 0-6
* of byte $13 of its blueprint (see #R$A817). While it has any, each
* laser hit gives a 20/256 chance that it fires one back (#R$291E); a
* Thargoid releases its Thargons instead (#R$2A94, which zeroes this).
object_missiles:                                           ; >f7ea
       byte >00

********************************************************************************
* Thargon's Thargoid
* 
* For a Thargon, the object-table slot of the Thargoid that released it
* (#R$2A94); when that Thargoid is destroyed, its Thargons leave
* (#R$31AD).
thargons_thargoid:                                         ; >f7eb
       byte >00

********************************************************************************
* Cargo type
* 
* What the object gives if it's scooped (#R$8BA6): 0-16 for the goods
* (see #R$0D9F), or negative for the cloaking device. Set for cargo
* canisters by #R$8DB9, 3 (slaves) for escape capsules (#R$2A71), and 16
* (alien items) for Thargons (#R$2A94). A cargo canister whose cargo
* type isn't negative can't be damaged by the laser (#R$291E).
cargo_type:                                                ; >f7ec
       byte >00

********************************************************************************
* Turn number
* 
* 1-3, given to each object in turn when it's added to the object table
* (#R$3037, from #R$E92F); some handler work is done only on the object's
* turn (#R$2542), i.e. every third frame.
turn_number:                                               ; >f7ed
       byte >02

********************************************************************************
* Handler type
* 
* Which handler (#R$2528) runs for the object each frame, from the table
* at #R$288D: 0 none, 1 explosion, 2 space station, 3 the player's
* missile, 4-12 ships' tactics, 14 a missile fired at the player.
handler_type:                                              ; >f7ee
       byte >00

********************************************************************************
* Handler countdown
* 
* Used by the handlers (#R$2528): the length of a turning phase or of
* flying on (#R$2758, #R$27A1), an explosion's countdown (#R$2556), and
* for the player's missile the slot of its target (#R$2D7E, #R$25B9).
handler_countdown:                                         ; >f7ef
       byte >00

********************************************************************************
* Per-type parameter block
* 
* Tail of the 40-byte per-object workspace starting at #R$F7CD (the LDIR
* at #R$13FD/#R$1703 copies exactly 40 bytes, ending here at $F7F4). Its
* meaning depends on the handler type. For the ship handler types (4-12):
* .
* #R$F7F0 is the turn rate for the first turn-away phase, whose length
* is #R$F7EF (just before this block); $F7F1/$F7F2 are the second
* phase's length and rate (see #R$2758 and #R$281E). $F7F3 is the handler
* type to switch to after turning away. $F7F4 is #R$2869's speed-up flag
* (1 = speed up, 0 = slow down).
* .
* For explosions (type 1, #R$2556), #R$F7F0 is a value stepped by an
* amount derived from #R$F7EF's countdown, upwards (saturating at $FF)
* normally and downwards once the game is over. #R$4AEC also uses
* #R$F7F0 as an index into the page-$0800 log table.
per_type_parameter_block:                                  ; >f7f0
       byte >00
turn_phase_2_length:                                       ; >f7f1
       byte >00                                                      ; 
turn_phase_2_rate:                                         ; >f7f2
       byte >00                                                      ; 
next_handler_type:                                         ; >f7f3
       byte >00                                                      ; 
speed_up_flag:                                             ; >f7f4
       byte >00                                                      ; 

********************************************************************************
* Blueprint: vertex data
* 
* Bytes $00-$01 of the object's blueprint header (copied to $F7F5-$F80E
* by #R$16E3, see #R$A817): the address of its vertices.
bp_vertices:                                               ; >f7f5
       byte >C9,>92

********************************************************************************
* Blueprint: edge data
* 
* Bytes $02-$03 of the object's blueprint header (see #R$F7F5): the
* address of its edges.
bp_edges:                                                  ; >f7f7
       byte >C9,>DA

********************************************************************************
* Blueprint: faces
* 
* Bytes $04-$05 of the object's blueprint header (see #R$F7F5): the
* address of its faces, drawn by #R$4255: each an optional scale byte and
* normal (#R$F804), then a count and the numbers of its edges.
bp_faces:                                                  ; >f7f9
       byte >C9,>F2

********************************************************************************
* Blueprint: name
* 
* Bytes $06-$07 of the object's blueprint header (see #R$F7F5): the
* address of its name, shown by the 'I' key (#R$4735) and the title
* screen (#R$1C5C).
bp_name:                                                   ; >f7fb
       byte >C9,>92

********************************************************************************
* Blueprint: number of faces
* 
* Byte $08 of the object's blueprint header (see #R$F7F5).
bp_face_count:                                             ; >f7fd
       byte >01

********************************************************************************
* Blueprint: number of edges
* 
* Byte $09 of the object's blueprint header (see #R$F7F5). #R$4255 clears
* one byte per edge at $E7B6.
bp_edge_count:                                             ; >f7fe
       byte >0C

********************************************************************************
* Blueprint: number of vertices
* 
* Byte $0A of the object's blueprint header (see #R$F7F5). #R$4255 clears
* one byte per vertex at $E784.
bp_vertex_count:                                           ; >f7ff
       byte >0C

********************************************************************************
* Blueprint: targetable area
* 
* Byte $0B of the object's blueprint header (see #R$F7F5): how close to
* the crosshairs the object has to be to be hit by the laser (projected
* by #R$46CA for #R$4735). For an explosion, #R$4255 puts its size here.
bp_targetable_area:                                        ; >f800
       byte >00

********************************************************************************
* Blueprint: energy
* 
* Byte $0C of the object's blueprint header (see #R$F7F5): the energy it
* starts with (#R$F7E9, set by #R$3037).
bp_energy:                                                 ; >f801
       byte >00

********************************************************************************
* Blueprint: maximum speed
* 
* Byte $0D of the object's blueprint header (see #R$F7F5): the speed
* #R$2869 speeds up to.
bp_max_speed:                                              ; >f802
       byte >00

********************************************************************************
* Blueprint: gun vertex
* 
* Byte $0E of the object's blueprint header (see #R$F7F5): the vertex its
* laser beam is drawn from (#R$43C2).
bp_gun_vertex:                                             ; >f803
       byte >FF

********************************************************************************
* Blueprint: faces have normals
* 
* Byte $0F of the object's blueprint header (see #R$F7F5): nonzero if
* each face in the face list (#R$F7F9) starts with a scale byte and a
* normal, used to hide the faces that face away (#R$4255).
bp_face_normals:                                           ; >f804
       byte >00

********************************************************************************
* Blueprint: size
* 
* Byte $10 of the object's blueprint header (see #R$F7F5): how close
* things come to it before they collide (#R$8755) or a missile hits it
* (#R$25FF).
bp_size:                                                   ; >f805
       byte >0C

********************************************************************************
* Blueprint: manoeuvrability
* 
* Byte $11 of the object's blueprint header (see #R$F7F5): its turn rate,
* and how close it gets to the player before turning away (#R$2744,
* #R$281E).
bp_manoeuvrability:                                        ; >f806
       byte >00

********************************************************************************
* Blueprint: class
* 
* Byte $12 of the object's blueprint header (see #R$F7F5). Bits 2-4 are
* the class: 0 trader, 4 pirate, 8 shuttle or escape capsule, $0C
* asteroid, $10 police, $14 bounty hunter, $18 station, missile or cargo,
* $1C Thargoid or Constrictor. Bits 0-1 say how it reacts to being shot
* (#R$28F6).
bp_class:                                                  ; >f807
       byte >00

********************************************************************************
* Blueprint: ECM and missiles
* 
* Byte $13 of the object's blueprint header (see #R$F7F5): bit 7 set if
* it has an ECM (#R$25B9), bits 0-6 the number of missiles (#R$F7EA).
bp_ecm_missiles:                                           ; >f808
       byte >00

********************************************************************************
* Blueprint: cargo
* 
* Byte $14 of the object's blueprint header (see #R$F7F5): what it leaves
* when destroyed (#R$8DB9).
bp_cargo:                                                  ; >f809
       byte >00

********************************************************************************
* Blueprint: aggression
* 
* Byte $15 of the object's blueprint header (see #R$F7F5): the chance of
* a ship firing at the player each frame (#R$26A9).
bp_aggression:                                             ; >f80a
       byte >00

********************************************************************************
* Blueprint: bounty
* 
* Bytes $16-$17 of the object's blueprint header (see #R$F7F5): the
* bounty paid when it's destroyed (#R$2578).
bp_bounty:                                                 ; >f80b
       byte >00,>00

********************************************************************************
* Blueprint: score value
* 
* Bytes $18-$19 of the object's blueprint header (see #R$F7F5): added to
* the score when it's destroyed (#R$32E7).
bp_score:                                                  ; >f80d
       byte >00,>00

********************************************************************************
* Fore shield
* 
* Recharged by one (up to $18) each regeneration tick (#R$1928), drawn on the
* dashboard by #R$6B48, and reduced by #R$193F when the player is hit from in
* front. Damage it can't absorb is taken from the energy (#R$F817).
fore_shield:                                               ; >f80f
       byte >00

********************************************************************************
* Aft shield
* 
* Like #R$F80F, but reduced when the player is hit from behind, and drawn
* by #R$6B54.
aft_shield:                                                ; >f810
       byte >00

********************************************************************************
* Cabin temperature gauge
* 
* Worked out by #R$1577 from the distance to the sun (#R$E725): the
* closer, the hotter. Drawn by #R$6AD0. Above $15, the fuel scoop works
* (#R$1577) and the alert level rises (#R$E90C).
cabin_temperature:                                         ; >f811
       byte >00

********************************************************************************
* Altitude gauge
* 
* Quantized by #R$15CB from ($E727), drawn by #R$6AC4. Triggers
* "Altitude Low" (#R$15E7) once below 4.
altitude_gauge:                                            ; >f812
       byte >00

********************************************************************************
* Laser temperature gauge
* 
* Goes up by 2 each time the laser fires (#R$2AD0, at $2AF8), which it won't
* do once this reaches 48, and down by 2 (#R$190D) every 16 frames - or 8
* or 4 with an energy unit (#R$18E6). Drawn halved by #R$6B60.
laser_temp_gauge:                                          ; >f813
       byte >00

********************************************************************************
* Speed (cached at #R$E87A on hyperspace engage)
* 
* Read by #R$1577 (update_altitude_and_e725_gauges_then_scoop) as the
* speed, gating the Fuel Scoop's activation on being "fast enough".
* #R$6805 scales the stardust's velocity by it. Cached to #R$E87A when a hyperspace jump is engaged.
speed_gauge_value:                                         ; >f814
       byte >00

********************************************************************************
* Roll rate
* 
* -16 to +16. Ramped by the roll keys (#R$6A15), and stopped when they're
* released with option D (#R$6BE1). #R$2209 sets up the rotation from it.
roll_rate:                                                 ; >f815
       byte >00

********************************************************************************
* Pitch rate
* 
* -16 to +16. Ramped by the pitch keys (#R$6A15), and stopped when
* they're released with option D (#R$6BE1). #R$2212 sets up the rotation
* from it.
pitch_rate:                                                ; >f816
       byte >00

********************************************************************************
* Energy gauge
* 
* Drawn by #R$6A88, and topped up by #R$190D (see #R$E944) to at most $60.
* Drained by #R$19EC: by 1 every other frame while the cloaking device or
* the ECM jammer is on (#R$13FD), and by any shield damage left over once
* the shields (#R$F80F/#R$F810) are down (#R$193F). Below $18, "Energy Low"
* is shown (#R$15E7).
energy_gauge:                                              ; >f817
       byte >00

********************************************************************************
* Current view's laser
* 
* The type of laser fitted to the current view (#R$6D24): 0 pulse, 1
* mining, 2 beam, 3 military, or $FF (negative) for none - when the laser
* can't be fired (#R$2AD0) and nothing is in its sights (#R$4735). On the
* Equip Ship screen, #R$5EFE uses it to hold the item number of the laser
* being bought instead (4, 12, 5 or 13; see #R$5AC3).
view_laser_type:                                           ; >f818
       byte >FF

********************************************************************************
* Laser cooldown
* 
* How many frames must pass between shots of the current view's laser,
* set by #R$6D82 for the laser type. Loaded into #R$F81B when the laser
* fires.
laser_cooldown:                                            ; >f819
       byte >00

********************************************************************************
* Laser power
* 
* The damage the current view's laser does per hit (#R$291E), set by
* #R$6D82 for the laser type.
laser_power:                                               ; >f81a
       byte >00

********************************************************************************
* Laser fired / cooling down
* 
* Set to $80 by #R$2AD0 when the laser fires. In that frame (bit 7 set),
* objects in the sights can be hit (#R$28F6) and the beams are drawn
* (#R$2DC8), which reloads it with the cooldown (#R$F819); #R$2DEF then
* counts it down, and the laser can't fire again until it's 0.
laser_state:                                               ; >f81b
       byte >00
