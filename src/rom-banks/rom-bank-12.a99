* ROM bank 12: the math tables, and code: more of the flight logic
* Assembled for real by code-bank-12.a99, and DORG in the other builds for its labels
       .ifdef code_bank_12
       aorg >6000
       .else
       dorg >6000
       .endif
       bss  >40
       .ifdef code_bank_12
       bcopy "../../bin/math-tables.bin" ; the math tables, as in the other banks
       .else
       bss  math_tables_end-math_tables
       .endif

* More of the flight logic (TI: called with .far_call): scooping, destroying
* objects, explosions and the score

********************************************************************************
* Handler type 1: explosion
* 
* Counts ($F7EF) down; until it runs out, adds ($F7EF) / 8 to ($F7F0) each
* frame (up to $FF) - or subtracts it (at $2573) once the game is over
* (#R$F749), as in the death scene (#R$1703).
* .
* When the count runs out (at $2578), removes the object (#R$30A9). Then,
* unless bit 6 of its status byte (#R$F7CD) says there's no bounty for it
* (because it was destroyed by a collision, the ECM or the energy bomb, or
* is a missile or cargo), shows the bounty for it (($F80B), in tenths of a
* credit: "Bounty: <n> credits", #R$28AD) and adds it to the cash (#R$EB16)
* - or shows "No bounty!" (at $25B3) if it's 0.
handler_explosion:                                         ; >2556
       .proc                                               ;                   ; 
       sb   one,@handler_countdown                         ; LD HL,$F7EF / DEC (HL); count down
       jeq  deactivate_and_award_bounty                    ; JR Z,$2578        ; run out - remove the object, pay the bounty
       movb @handler_countdown,r0                          ; LD A,(HL)         ; 
       srl  r0,3                                           ; RRA x 3           ; 
       andi r0,>1f00                                       ; AND $1F           ; 
       movb r0,@c                                          ; LD C,A            ; C = countdown / 8
       movb @per_type_parameter_block,a                    ; LD A,($F7F0)      ; 
       movb @game_over,r0                                  ; LD A,($F749) / OR A; game over?
       jne  step_f7f0_down_by_c                            ; JR NZ,$2573       ; yes - subtract instead
       ab   @c,a                                           ; ADD A,C           ; 
       jnc  _2574                                          ; JR NC,$2571       ; 
       movb @b255,a                                        ; LD A,$FF          ; (up to $FF)
       jmp  _2574                                          ; JR $2574          ; 
step_f7f0_down_by_c:                                       ; >2573
       sb   @c,a                                           ; SUB C             ; 
_2574:                                                     ; >2574
       movb a,@per_type_parameter_block                    ; LD ($F7F0),A      ; store it back
       jmp  _2556_end                                      ; RET               ; 
deactivate_and_award_bounty:                               ; >2578
       .far_call code_bank_11_select,remove_object         ; CALL $30A9        ; deactivate the current object
       movb @object_status_byte,r0                         ; LD A,($F7CD) / AND $40; no bounty for it (bit 6)?
       czc  @bit6,r0                                       ;                   ; 
       jne  _2556_end                                      ; RET NZ            ; none - done
       movb @bp_bounty+1,hl                                ; LD HL,($F80B)     ; the bounty
       movb @bp_bounty,@l                                  ;                   ; 
       mov  hl,hl                                          ; LD A,H / OR L     ; zero?
       jeq  print_no_bounty                                ; JR Z,$25B3        ; yes - "No bounty!"
       movb @l,@c                                          ; LD C,L            ; C = the bounty's low byte
       movb h,@l                                           ; LD L,H            ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>c5,a                                   ; LD A,$C5          ; pad to width 5, with a decimal point
       li   ix,bounty_digit_buffer                         ; LD IX,$28B4       ; IX -> the digits
       bl   @format_number                                 ; CALL $3675        ; format the bounty
       szcb @bit7,@-1(ix)                                  ; RES 7,(IX-$01)    ; so that " credits" follows
       li   hl,msg_bounty                                  ; LD HL,$28AD       ; "Bounty: <n> credits"
       bl   @show_view_message                             ; CALL $39C8        ; 
       movb @player_cash+1,r0                              ; LD HL,($EB16) / LD A,($EB18); add it to the cash...
       movb @player_cash,@r0lb                             ;                   ; 
       movb @bp_bounty+1,r1                                ; LD DE,($F80B)     ; 
       movb @bp_bounty,@r1lb                               ;                   ; 
       a    r1,r0                                          ; ADD HL,DE         ; 
       movb r0,@player_cash+1                              ; LD ($EB16),HL     ; 
       movb @r0lb,@player_cash                             ;                   ; 
       jnc  _2556_end                                      ; ADC A,$00         ; 
       ab   one,@cash_2                                    ; LD ($EB18),A      ; ...with the carry
       jmp  _2556_end                                      ; RET               ; 
print_no_bounty:                                           ; >25b3
       li   hl,msg_no_bounty                               ; LD HL,$28C1       ; "No bounty!"
       bl   @show_view_message                             ; JP $39C8          ; 
_2556_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Destroy an object
* 
* Used by the routines at #R$25B9, #R$2618, #R$28F6, #R$323C, #R$329E and
* #R$8755.
* .
* Turns the object record at IX into an explosion: handler type 1
* (#R$2556) with a 64-frame countdown and an initial ($F7F0) of 40, speed
* 0, and bits 2 and 3 of its status byte set (bit 3 marks it as
* exploding, see #R$323C). Sets #R$E869 to say something was destroyed,
* and adds the object's value to the score (#R$32E7). Unless ($EFA1) is
* set, destroying a trader or a police ship (class 0 or $10 in its
* blueprint's byte $12) worsens the player's legal status (#R$EB65) by
* 64. Destroying a Thargoid (ship type $13) also sends its Thargons
* (type 6, whose byte $1E holds the Thargoid's slot number) away, by
* switching them to handler type 12 (#R$27F4).
* .
* Called for the player's missile hitting its target (#R$25FF), a
* missile hitting the player (#R$2618), the ECM destroying missiles
* (#R$323C), the energy bomb (#R$329E), and from #R$291E and #R$8755.
* 
* I:IX Pointer to the object's record
* TI: reads the blueprint through blueprint_byte, and the score value is
* passed to #R$32E7 in HL.
destroy_object:                                            ; >31ad
       .proc                                               ;                   ; 
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       .push hl                                            ; PUSH HL           ; 
       .push ix                                            ; PUSH IX           ; 
       movb @bytes+>40,@>22(ix)                            ; LD (IX+$22),$40   ; explosion countdown: 64 frames
       movb @bytes+>28,@>23(ix)                            ; LD (IX+$23),$28   ; ($F7F0) = 40
       sb   @>19(ix),@>19(ix)                              ; LD (IX+$19),$00   ; speed 0
       movb one,@>21(ix)                                   ; LD (IX+$21),$01   ; handler type 1: explosion
       socb @bit2,*ix                                      ; SET 2,(IX+$00)    ; 
       socb @bit3,*ix                                      ; SET 3,(IX+$00)    ; exploding
       seto r0                                             ; LD A,$FF          ; 
       movb r0,@something_destroyed                        ; LD ($E869),A      ; something was destroyed
       movb @>1a(ix),a                                     ; LD A,(IX+$1A) / CALL $2FE9; the score value (bytes $18-$19 of the blueprint)
       li   r2,>19                                         ;                   ; 
       bl   @blueprint_byte                                ;                   ; 
       .push a                                             ;                   ; 
       movb @>1a(ix),a                                     ;                   ; 
       li   r2,>18                                         ;                   ; 
       bl   @blueprint_byte                                ;                   ; 
       .pop hl                                             ;                   ; 
       movb a,@l                                           ;                   ; 
       bl   @add_score                                     ; CALL $32E7        ; add it to the score
       movb @legal_status_exempt,r0                        ; LD A,($EFA1) / OR A; 
       jne  _31f4                                          ; JR NZ,$31F4       ; legal status unaffected
       movb @>1a(ix),a                                     ; LD A,(IY+$12)     ; 
       li   r2,>12                                         ;                   ; 
       bl   @blueprint_byte                                ;                   ; 
       andi a,>1c00                                        ; AND $1C           ; A = its class
       jeq  _31e9                                          ; JR Z,$31E9        ; a trader
       cb   a,@bytes+>10                                   ; CP $10            ; 
       jne  _31f4                                          ; JR NZ,$31F4       ; not police either
_31e9:                                                     ; >31e9
       ab   @bytes+>40,@legal_status                       ; LD A,($EB65) / ADD A,$40; legal status += 64...
       jnc  _31f4                                          ; JR NC,$31F1       ; 
       seto r0                                             ; SBC A,A           ; ...up to $FF
       movb r0,@legal_status                               ; LD ($EB65),A      ; 
_31f4:                                                     ; >31f4
       cb   @>1a(ix),@bytes+>13                            ; LD A,(IX+$1A) / CP $13; a Thargoid?
       jne  _321d                                          ; JR NZ,$321D       ; no
       li   ix,ship_object_table                           ; LD IX,$EBA0       ; IX -> the object table
       movb @current_slot,@c                               ; LD A,($E911) / LD C,A; C = the Thargoid's slot
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_3208:                                                     ; >3208
       cb   @>1a(ix),@bytes+>06                            ; LD A,(IX+$1A) / CP $06; a Thargon?
       jne  _3219                                          ; JR NZ,$3219       ; 
       cb   @>1e(ix),@c                                    ; LD A,(IX+$1E) / CP C; one of this Thargoid's?
       jne  _3219                                          ; JR NZ,$3219       ; 
       movb @bytes+>0c,@>21(ix)                            ; LD (IX+$21),$0C   ; yes - send it away (handler type 12)
_3219:                                                     ; >3219
       ai   ix,>0028                                       ; LD DE,$0028 / ADD IX,DE; 
       sb   one,b                                          ; DJNZ $3208        ; next slot
       jne  _3208                                          ;                   ; 
_321d:                                                     ; >321d
       .pop ix                                             ; POP IX            ; 
       .pop hl                                             ; POP HL            ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Add to the score, and promote the player's combat rank
* 
* Used by the routine at #R$31AD.
* .
* Called by #R$31AD when an object is destroyed. Adds its score value
* (bytes $18-$19 of its blueprint, see #R$A817) to the 24-bit score
* (#R$EB13). If that reaches the threshold for the next rank (#R$336D), the
* combat rank (#R$EB12) goes up and "Right On Commander" is shown;
* otherwise $331B.
* .
* At $331B, counts the kills that don't bring a promotion (#R$E930), and
* shows "Right On Commander" every 256 of them - as BBC Elite does every
* 256 kills. The entry at $3320 shows the message.
* 
* I:IY Pointer to the object's blueprint
* TI: the score value is in HL rather than read through IY.
add_score:                                                 ; >32e7
       movb @score+1,r0                                    ; LD HL,($EB13)     ; R1:R0 = the score (24 bits)
       movb @score,@r0lb                                   ;                   ; 
       clr  r1                                             ; LD A,($EB15)      ; 
       movb @score_2,r1                                    ;                   ; 
       swpb r1                                             ;                   ; 
       a    hl,r0                                          ; LD E,(IY+$18) / LD D,(IY+$19) / ADD HL,DE; add the value
       jnc  _32e7_1                                        ; ADC A,$00         ; 
       inc  r1                                             ;                   ; 
_32e7_1:                                                   
       movb r0,@score+1                                    ; LD ($EB13),HL     ; 
       movb @r0lb,@score                                   ;                   ; 
       swpb r1                                             ;                   ; 
       movb r1,@score_2                                    ; LD ($EB15),A      ; 
       movb r0,@r1lb                                       ;                   ; R1 = the score / 256
       clr  r2                                             ; LD A,($EB12) / ADD A,A / LD E,A / LD D,$00; 
       movb @combat_rank,r2                                ;                   ; 
       srl  r2,7                                           ; LD HL,$336D / ADD HL,DE; 
       c    r1,@combat_rank_thresholds(r2)                 ; LD E,$00 / LD D,(HL) / INC HL / LD C,(HL) / SBC HL,DE / SBC A,C; reached the next rank's threshold?
       jl   right_on_commander                             ; JR C,$331B        ; not yet
       ab   one,@combat_rank                               ; LD HL,$EB12 / INC (HL); promotion
       jmp  _3320                                          ; JR $3320          ; "Right On Commander"
right_on_commander:                                        ; >331b
       ab   one,@kill_count                                ; LD HL,$E930 / INC (HL); one more kill
       jne  _32e7_end                                      ; RET NZ            ; not a multiple of 256
_3320:                                                     ; >3320
       li   hl,msg_right_commander                         ; LD HL,$3396       ; "Right On Commander"
       b    @show_view_message                             ; JP $39C8          ; display it
_32e7_end:                                                 
       rt                                                  ;                   ; 

********************************************************************************
* Combat rank thresholds
* 
* The score (#R$EB13) needed for each promotion (#R$32E7): the middle and
* high bytes of a 24-bit number (the low byte being 0).
* TI: the high and middle bytes of the score needed, as big-endian words.
combat_rank_thresholds:                                    ; >336d
       data >0008                                                 ; 2048: Mostly Harmless
       data >0010                                                 ; 4096: Poor
       data >0020                                                 ; 8192: Average
       data >0040                                                 ; 16384: Above average
       data >0080                                                 ; 32768: Competent
       data >0200                                                 ; 131072: Dangerous
       data >0a00                                                 ; 655360: Deadly
       data >1900                                                 ; 1638400: E-L-I-T-E

********************************************************************************
* Scoop an object
* 
* Used by the routine at #R$8755.
* .
* Part of #R$8755, for a cargo canister, escape capsule or Thargon. It's
* scooped if fuel scoops are fitted (#R$F77B) and it's in front of the ship
* and below it (the signs of its Z and Y coordinates): if its cargo type
* (#R$F7EC) is negative it's the cloaking device ($F784, from the Cougar,
* see #R$8DB9), otherwise 1-4 units of that cargo ($8BC7).
* .
* At $8BC7, takes on a random 1-4 units of cargo type A - fewer if the hold
* hasn't room for them (#R$63BA, #R$63E0), none if it has no room at all.
* .
* At $8BF9, adds C units of the cargo to the hold (#R$EB19) and announces
* it by name. The entry at $8C2F announces the message at HL, removes the
* object (#R$30A9) and plays the scooping sound.
* 
* O:F Carry set if it has been scooped
* TI: returns the carry with .retc and .retnc.
scoop_object:                                              ; >8ba6
       .proc                                               ;                   ; 
       movb @item_fuel_scoop,r0                            ; LD A,($F77B) / OR A; 
       jeq  _8ba6_no                                       ; RET Z             ; no fuel scoops
       movb @object_z_sign,r0                              ; LD A,($F7D3) / OR A; 
       jlt  _8ba6_no                                       ; RET M             ; behind the ship
       movb @position_y_hi,r0                              ; LD A,($F7D1) / OR A; 
       jgt  _8ba6_no                                       ; RET P             ; above the ship
       jeq  _8ba6_no                                       ;                   ; 
       movb @cargo_type,a                                  ; LD A,($F7EC) / OR A; 
       jgt  scoop_cargo                                    ; JP P,$8BC7        ; ordinary cargo
       jeq  scoop_cargo                                    ;                   ; 
       movb one,@cloaking_device_fitted                    ; LD A,$01 / LD ($F784),A; the cloaking device
       li   hl,msg_cloaking_device_8c85                    ; LD HL,$8C85       ; "Cloaking device"
       jmp  scoop_announce                                 ; JP $8C2F          ; 
scoop_cargo:                                               ; >8bc7
       clr  r1                                             ; ADD A,A / ADD A,A / LD E,A / LD D,$00; 
       movb a,r1                                           ;                   ; 
       srl  r1,6                                           ;                   ; R1 = cargo type * 4
       movb @market_units(r1),a                            ; LD HL,$F78B / ADD HL,DE / LD A,(HL); its units
       bl   @unit_size                                     ; CALL $639C        ; HL -> the size of a unit
       .push hl                                            ; LD ($E87D),HL     ; (TI: on the stack)
       bl   @random_byte                                   ; LD A,R            ; (TI: a random byte for the R register)
       andi a,>0300                                        ; AND $03           ; 
       ab   one,a                                          ; INC A             ; 
       clr  bc                                             ; LD B,$00          ; 
       movb a,@c                                           ; LD C,A            ; BC = a random quantity, 1-4
_8bdf:                                                     ; >8bdf
       .push bc                                            ; PUSH BC / PUSH BC ; 
       bl   @work_out_free_space                           ; CALL $63BA        ; the hold's free space
       mov  @-2(sp),bc                                     ; POP BC            ; 
       mov  @-4(sp),hl                                     ; LD HL,($E87D)     ; 
       bl   @take_off_free_space                           ; CALL $63E0        ; room for this many?
       .pop bc                                             ; POP BC            ; 
       movb @free_space_hi,r0                              ; LD A,($EB64) / OR A; 
       jgt  scoop_into_hold                                ; JP P,$8BF9        ; yes - add them to the hold
       jeq  scoop_into_hold                                ;                   ; 
       dec  bc                                             ; DEC BC            ; no - one fewer
       jne  _8bdf                                          ; LD A,B / OR C / JR NZ,$8BDF; 
       dect sp                                             ;                   ; (drop the size)
_8ba6_no:                                                  
       .retnc                                              ; RET               ; none fit - not scooped
scoop_into_hold:                                           ; >8bf9
       movb @cargo_type,r1                                 ; LD A,($F7EC) / ADD A,A / ADD A,A / LD E,A / LD D,$00; 
       srl  r1,6                                           ;                   ; 
       li   de,cargo_hold                                  ; LD HL,$EB19 / ADD HL,DE / EX DE,HL; DE -> its place in the hold
       a    r1,de                                          ;                   ; 
       .pop hl                                             ; LD HL,($E87D)     ; HL -> the size of a unit
       movb @c,a                                           ; LD A,C            ; 
       .push a                                             ; PUSH AF           ; the quantity
_8c08:                                                     ; >8c08
       bl   @add_4byte_de_hl                               ; CALL $21C4        ; one more unit
       sb   one,@c                                         ; DEC C             ; 
       jne  _8c08                                          ; JR NZ,$8C08       ; 
       movb @cargo_type,r1                                 ; LD A,($F7EC) / ADD A,A / ADD A,A; 
       srl  r1,6                                           ;                   ; 
       li   ix,market                                      ; LD DE,$F789 / ADD IX,DE; IX -> its entry in the market
       a    r1,ix                                          ;                   ; 
       .pop a                                              ; POP AF            ; A = the quantity
       bl   @illegal_goods                                 ; CALL $63AA        ; worsen the legal status for illegal goods
       movb @cargo_type,a                                  ; LD A,($F7EC)      ; 
       li   hl,msg_food                                    ; LD HL,$0D9F       ; the names of the goods
       bl   @skip_tokenised_strings_advancing_hl_past      ; CALL $358D        ; HL -> this one's
scoop_announce:                                            ; >8c2f
       bl   @show_view_message                             ; CALL $39C8        ; announce it
       .far_call code_bank_11_select,remove_object         ; CALL $30A9        ; remove the object
* TI: no sound effect 13 (#R$7468), as the sound effects aren't converted yet
       .retc                                               ; SCF / RET         ; scooped


********************************************************************************
* Recharge the energy banks and shields
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). Every 16 frames (counted
* by #R$E944) cools the laser and charges the energy banks by 1 (#R$190D),
* and once they're full charges the shields too (#R$1928). An energy unit
* (#R$F77E) makes this faster and charges the shields at the same time
* ($18FF).
* .
* At $18FF, recharges every 8 frames with an extra energy unit (#R$F77E =
* 1), or every 4 with a naval energy unit (2, the reward for mission 2),
* charging the shields as well as the energy banks.
recharge:                                                  ; >18e6
       .proc                                               ;                   ; 
       sb   one,@recharge_timer                            ; LD HL,$E944 / DEC (HL); 
       jne  _18e6_end                                      ; RET NZ            ; not time yet
       movb @item_energy_unit,a                            ; LD A,($F77E) / OR A; energy unit?
       jne  recharge_energy_unit                           ; JR NZ,$18FF       ; fitted
       movb @bytes+>10,@recharge_timer                     ; LD (HL),$10       ; 16 frames until the next time
       bl   @cool_laser_charge_energy                      ; CALL $190D        ; cool the laser, charge the energy banks
       cb   @energy_gauge,@bytes+>60                       ; LD A,($F817) / CP $60; 
       jne  _18e6_end                                      ; CALL Z,$1928      ; 
       bl   @charge_shields                                ;                   ; full: charge the shields
       jmp  _18e6_end                                      ; RET               ; 
recharge_energy_unit:                                      ; >18ff
       movb @bytes+>08,r0                                  ; DEC A / LD A,$08  ; 8 frames until the next time...
       cb   a,one                                          ;                   ; 
       jeq  _1906                                          ; JR Z,$1906        ; 
       movb @bytes+>04,r0                                  ; LD A,$04          ; ...or 4 with a naval energy unit
_1906:                                                     ; >1906
       movb r0,@recharge_timer                             ; LD (HL),A         ; 
       bl   @cool_laser_charge_energy                      ; CALL $190D        ; cool the laser, charge the energy banks
       bl   @charge_shields                                ; JP $1928          ; charge the shields
_18e6_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Cool the laser and charge the energy banks
* 
* Used by the routine at #R$18E6.
* .
* Cools the laser by 2 (#R$F813, not below 0), and charges the energy
* banks (#R$F817) by 1, up to 96; redrawing the gauges (#R$6B60,
* #R$6A88).
cool_laser_charge_energy:                                  ; >190d
       .proc                                               ;                   ; 
       movb @laser_temp_gauge,r0                           ; LD HL,$F813 / LD A,(HL) / OR A; 
       jeq  _191d                                          ; JR Z,$191D        ; already 0
       sb   @bytes+>02,@laser_temp_gauge                   ; DEC (HL) / DEC (HL); cool by 2...
       jgt  cool_laser_redraw                              ; JP P,$191A        ; 
       jeq  cool_laser_redraw                              ;                   ; 
       ab   one,@laser_temp_gauge                          ; INC (HL)          ; overshot below 0 - back up to 0
cool_laser_redraw:                                         ; >191a
       bl   @draw_laser_temperature                        ; CALL $6B60        ; redraw the laser temperature gauge
_191d:                                                     ; >191d
       cb   @energy_gauge,@bytes+>60                       ; LD HL,$F817 / LD A,(HL) / CP $60; full (96)?
       jeq  _190d_end                                      ; RET Z             ; yes
       ab   one,@energy_gauge                              ; INC (HL)          ; charge by 1
       bl   @draw_energy_banks                             ; JP $6A88          ; redraw the energy gauge
_190d_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Charge the shields
* 
* Used by the routine at #R$18E6.
* .
* Charges the fore and aft shields (#R$F80F, #R$F810) by 1 each, up to
* 24, redrawing them (#R$6B48, #R$6B54).
charge_shields:                                            ; >1928
       .proc                                               ;                   ; 
       cb   @fore_shield,@bytes+>18                        ; LD HL,$F80F / LD A,(HL) / CP $18; full (24)?
       jeq  _1934                                          ; JR Z,$1934        ; 
       ab   one,@fore_shield                               ; INC (HL)          ; charge by 1
       bl   @draw_gauge_dashboard_6b48                     ; CALL $6B48        ; redraw the fore shield
_1934:                                                     ; >1934
       cb   @aft_shield,@bytes+>18                         ; LD HL,$F810 / LD A,(HL) / CP $18; full (24)?
       jeq  _1928_end                                      ; RET Z             ; 
       ab   one,@aft_shield                                ; INC (HL)          ; charge by 1
       bl   @draw_gauge_dashboard_6b54                     ; JP $6B54          ; redraw the aft shield
_1928_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Check whether the player's laser has hit the object
* 
* Used by the routine at #R$13FD.
* .
* Called for each object by the main loop (#R$13FD). Only acts in the frame
* the laser is fired (bit 7 of ($F81B), see #R$2AD0), if the object is in
* the sights (($EF99), set by #R$4735) and the shot hasn't already hit
* something (($E873) zero). Unless the ship is already attacking (type 6)
* or turning away (7), it reacts according to bits 0-1 of its class byte
* ($F807): 0 not at all, 1 by turning away and leaving (type 12), 2 or 3 by
* turning away and then attacking. Then works out the damage.
* .
* At $291E, makes the ship turn away (#R$281E) and then attack: type 11
* (break off, then attack) if it was flying on (type 8), otherwise type 6.
* At $2929, sets the handler type to switch to after turning away.
* .
* At $292F, works out the damage from the laser's power (($F81A), set by
* #R$6D82 for the current view's laser): for the space station (ship type
* 1) none - unless a mission ($E93D = $52) needs it destroyed, when it's a
* quarter - but the player's legal status worsens by 10 (#R$EB65); a
* quarter for ship types $1E and $1F; none for a cargo canister (ship type
* 3) unless ($F7EC) is negative; otherwise the full power.
* .
* At $2977, the damage is taken off the object's energy ($F7E9). If that
* leaves none, the object is destroyed: for the Constrictor (ship type $1F)
* the mission state ($E93D) advances first; for the space station, ($EFA9)
* records that it has gone (which stops #R$3187 launching ships) and the
* mission state advances. Then (at $299A) the object is removed (#R$31AD),
* the explosion sound plays, #R$8DB9 spawns its debris and any missile lock
* on it is cancelled (#R$30EA).
* .
* If the object survives (at $29AE) with at most one more shot's worth of
* energy left, there's a 10/256 chance that - if it's a trader, pirate or
* shuttle (class 0-2, see #R$A817) - its pilot ejects in an escape capsule
* (#R$2A71). Then, if it still has missiles (($F7EA)), a 20/256 chance that
* it fires one at the player (#R$2A3A) - or, for a Thargoid (ship type
* $13), releases Thargons (#R$2A94).
* .
* Finally (at $29E0, for every hit) calls the police (#R$2A1C) if the
* player is in the station's safe zone (#R$EB05), fewer than 2 Vipers (ship
* type $0C, count at $E850) are about, none are already due, and the target
* was the station itself, a trader or shuttle (class 0 or 8), or a
* Thargoid-class ship during mission state $52; then marks the shot as used
* (($E873)) and plays the hit sound (effect 9).
* TI: process_frame only calls this when the laser has fired this frame.
laser_hit_check:                                           ; >28f6
       .proc                                               ;                   ; 
       movb @laser_state,r0                                ; LD A,($F81B) / OR A; 
       jgt  _28f6_exit                                     ; RET P             ; laser not fired this frame
       jeq  _28f6_exit                                     ;                   ; 
       movb @in_sights,r0                                  ; LD A,($EF99) / OR A; 
       jeq  _28f6_exit                                     ; RET Z             ; not in the sights
       movb @laser_shot_used,r0                            ; LD A,($E873) / OR A; 
       jne  _28f6_exit                                     ; RET NZ            ; the shot has already hit something
       jmp  laser_hit_check_1                              ;                   ; 
_28f6_exit:
       .endproc                                            ;                   ; 
laser_hit_check_1:
       movb @handler_type,a                                ; LD A,($F7EE)      ; 
       cb   a,@bytes+>06                                   ; CP $06            ; 
       jeq  _292f                                          ; JR Z,$292F        ; attacking - no reaction
       cb   a,@bytes+>07                                   ; CP $07            ; 
       jeq  _292f                                          ; JR Z,$292F        ; turning away - no reaction
       movb @bp_class,r0                                   ; LD A,($F807)      ; 
       andi r0,>0300                                       ; AND $03           ; how it reacts to being shot
       jeq  _292f                                          ; JR Z,$292F        ; 0: no reaction
       cb   r0,one                                         ; DEC A             ; 
       jne  laser_hit_react                                ; JR NZ,$291E       ; 2 or 3
       movb @bytes+>0c,a                                   ; LD A,$0C          ; 1: turn away, then leave (type 12)
       jmp  _2929                                          ; JR $2929          ; 
laser_hit_react:                                           ; >291e
       movb @bytes+>0b,r0                                  ; LD A,$0B          ; 
       cb   a,@bytes+>08                                   ; LD A,($F7EE) / CP $08; 
       jeq  laser_hit_react_1                              ; JR Z,$2929        ; was flying on - break off (11)
       movb @bytes+>06,r0                                  ; LD A,$06          ; otherwise attack (6)
laser_hit_react_1:                                         
       movb r0,a                                           ;                   ; 
_2929:                                                     ; >2929
       movb a,@next_handler_type                           ; LD ($F7F3),A      ; handler type after turning away
       .far_call code_bank_11_select,start_turning_away    ; CALL $281E        ; turn away
_292f:                                                     ; >292f
       movb @laser_power,@c                                ; LD A,($F81A) / LD C,A; C = laser power
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       cb   a,one                                          ; CP $01            ; 
       jne  laser_quarter_damage                           ; JR NZ,$2959       ; not the space station
       ab   @bytes+>0a,@legal_status                       ; LD A,($EB65) / ADD A,$0A; station: legal status += 10...
       jnc  _2942                                          ; JR NC,$2942       ; 
       seto r0                                             ; SBC A,A           ; ...up to $FF
       movb r0,@legal_status                               ;                   ; 
_2942:                                                     ; >2942
       movb @legal_status,@legal_status_copy               ; LD ($EB65),A / LD ($EF97),A; ...and copied to $EF97
       sb   a,a                                            ;                   ; 
       cb   @mission_state,@bytes+>52                      ; LD A,($E93D) / CP $52; 
       jne  _2977                                          ; JR NZ,$2956 / XOR A; no mission - no damage
       movb @c,a                                           ; LD A,C            ; 
       srl  a,2                                            ; SRL A / SRL A     ; a quarter of the power
       andi a,>3f00                                        ;                   ; 
       jmp  _2977                                          ; JR $2977          ; 
laser_quarter_damage:                                      ; >2959
       cb   a,@bytes+>1f                                   ; CP $1F            ; 
       jeq  _2961                                          ; JR Z,$2961        ; 
       cb   a,@bytes+>1e                                   ; CP $1E            ; 
       jne  laser_cargo_damage                             ; JR NZ,$2968       ; 
_2961:                                                     ; >2961
       movb @c,a                                           ; LD A,C            ; 
       srl  a,2                                            ; SRL A / SRL A     ; a quarter of the power
       andi a,>3f00                                        ;                   ; 
       jmp  _2977                                          ; JR $2977          ; 
laser_cargo_damage:                                        ; >2968
       cb   a,@bytes+>03                                   ; CP $03            ; a cargo canister?
       jne  laser_damage                                   ; JR NZ,$2976       ; no - full damage
       sb   a,a                                            ;                   ; 
       movb @cargo_type,r0                                 ; LD A,($F7EC) / OR A; 
       jlt  _2977                                          ; JP P,$2976 / XOR A; the cloaking device - no damage
laser_damage:                                              ; >2976
       movb @c,a                                           ; LD A,C            ; full damage
_2977:                                                     ; >2977
       movb a,@c                                           ; LD C,A            ; C = damage
       movb @object_energy,a                               ; LD A,($F7E9)      ; 
       sb   @c,a                                           ; SUB C             ; 
       movb a,@object_energy                               ; LD ($F7E9),A      ; take it off the energy
       joc  laser_survived                                 ; JR NC,$29AE       ; still has some
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       cb   a,@bytes+>1f                                   ; CP $1F            ; the Constrictor?
       jne  laser_destroy                                  ; JR NZ,$298E       ; 
       ab   one,@mission_state                             ; LD HL,$E93D / INC (HL); yes - advance the mission
       jmp  _299a                                          ; JR $299A          ; 
laser_destroy:                                             ; >298e
       cb   a,one                                          ; CP $01            ; the space station?
       jne  _299a                                          ; JR NZ,$299A       ; 
       sb   one,@station_destroyed                         ; LD HL,$EFA9 / DEC (HL); yes - it has gone
       ab   one,@mission_state                             ; LD HL,$E93D / INC (HL); advance the mission
_299a:                                                     ; >299a
       li   ix,object_status_byte                          ; LD IX,$F7CD       ; IX -> the working object
       bl   @destroy_object                                ; CALL $31AD        ; destroy it
* TI: no sound effect 2 (#R$7468), as the sound effects aren't converted yet
       bl   @spawn_cargo                                   ; CALL $8DB9        ; its cargo
       .far_call code_bank_11_select,cancel_missile_lock_on_object; CALL $30EA        ; cancel any missile lock on it
       jmp  _29e0                                          ; JR $29E0          ; maybe call the police
laser_survived:                                            ; >29ae
       sb   @c,a                                           ; SUB C             ; would another shot destroy it?
       joc  _29c4                                          ; JR NC,$29C4       ; no
       bl   @random_byte                                   ; CALL $2176        ; 
       cb   a,@bytes+>0a                                   ; CP $0A            ; 
       jhe  _29c4                                          ; JR NC,$29C4       ; 10/256 chance
       movb @bp_class,a                                    ; LD A,($F807)      ; 
       srl  a,2                                            ; RRA / RRA         ; 
       andi a,>0700                                        ; AND $07           ; A = class
       cb   a,@bytes+>03                                   ; CP $03            ; 
       jhe  _29c4                                          ;                   ; 
       bl   @eject_escape_capsule                          ; CALL C,$2A71      ; trader, pirate or shuttle: eject an escape capsule
_29c4:                                                     ; >29c4
       movb @object_missiles,r0                            ; LD A,($F7EA) / OR A; any missiles left?
       jeq  _29e0                                          ; JR Z,$29E0        ; no
       bl   @random_byte                                   ; CALL $2176        ; 
       cb   a,@bytes+>14                                   ; CP $14            ; 
       jhe  _29e0                                          ; JR NC,$29E0       ; 20/256 chance
       cb   @ship_type,@bytes+>13                          ; LD A,($F7E7) / CP $13; 
       jne  laser_fire_back_and_police                     ; JR NZ,$29DD       ; not a Thargoid - fire a missile
       bl   @release_thargons                              ; CALL $2A94        ; Thargoid: release Thargons
       jmp  _29e0                                          ; JR $29E0          ; 
laser_fire_back_and_police:                                ; >29dd
       bl   @enemy_fires_missile                           ; CALL $2A3A        ; fire a missile at the player
_29e0:                                                     ; >29e0
       cb   @num_vipers,@bytes+>02                         ; LD A,($E850) / CP $02; 
       jhe  _2a13                                          ; JR NC,$2A13       ; 2 or more Vipers - no more police
       movb @police_to_launch,r0                           ; LD A,($E934) / OR A; 
       jne  _2a13                                          ; JR NZ,$2A13       ; police already due
       movb @station_in_range,r0                           ; LD A,($EB05) / OR A; 
       jeq  _2a13                                          ; JR Z,$2A13        ; not in the safe zone
       cb   @ship_type,one                                 ; LD A,($F7E7) / CP $01; 
       jeq  _2a10                                          ; JR Z,$2A10        ; shot the station - call the police
       movb @bp_class,a                                    ; LD A,($F807)      ; 
       andi a,>1c00                                        ; AND $1C           ; 
       jeq  _2a10                                          ; JR Z,$2A10        ; a trader
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jeq  _2a10                                          ; JR Z,$2A10        ; a shuttle
       cb   a,@bytes+>1c                                   ; CP $1C            ; 
       jne  _2a13                                          ; JR NZ,$2A13       ; 
       cb   @mission_state,@bytes+>52                      ; LD A,($E93D) / CP $52; 
       jne  _2a13                                          ; JR NZ,$2A13       ; 
_2a10:                                                     ; >2a10
       bl   @call_police                                   ; CALL $2A1C        ; call the police
_2a13:                                                     ; >2a13
       sb   one,@laser_shot_used                           ; LD HL,$E873 / DEC (HL); the shot has hit something
* TI: no sound effect 9 (#R$7468), as the sound effects aren't converted yet
_28f6_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Call the police
* 
* Used by the routines at #R$28F6 and #R$2C21.
* .
* Arms the countdown for #R$315C to launch Vipers from the space station:
* ($E934) = how many (a random number from 1 to twice the player's rank
* (#R$EB12) + 2, at most 6), and a 40-frame wait until the first ($E870).
* 
* O:($E934) Number of Vipers to launch (1-6)
* O:($E870) Frames until the first
call_police:                                               ; >2a1c
       .proc                                               ;                   ; 
       movb @combat_rank,a                                 ; LD A,($EB12)      ; 
       ab   one,a                                          ; INC A             ; 
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; C = (rank + 1) * 2
_2a22:                                                     ; >2a22
       bl   @random_byte                                   ; CALL $2176        ; 
       andi a,>1f00                                        ; AND $1F           ; 
       cb   a,@c                                           ; CP C              ; 
       jhe  _2a22                                          ; JR NC,$2A22       ; too many - pick again
       ab   one,a                                          ; INC A             ; 1 to (rank + 1) * 2
       cb   a,@bytes+>07                                   ; CP $07            ; 
       jl   _2a31                                          ; JR C,$2A31        ; 
       movb @bytes+>06,a                                   ; LD A,$06          ; at most 6
_2a31:                                                     ; >2a31
       movb a,@police_to_launch                            ; LD ($E934),A      ; number of Vipers to launch
       movb @bytes+>28,@police_launch_timer                ; LD A,$28 / LD ($E870),A; 40 frames until the first
       .endproc                                            ; RET               ; 

********************************************************************************
* A ship fires a missile at the player
* 
* Used by the routine at #R$28F6.
* .
* Does nothing if the ship is too close (distance under $200) or the
* player is cloaked (#R$EF9F). Otherwise, keeping the working object's
* record safe (#R$3341, #R$334D), spawns a missile (ship type 2) with
* handler type 14 (#R$2618) at speed $41, and if there was room for it
* announces "Incoming missile" and plays the launch sound. Also
* decrements the byte at $009D, in unused space, which nothing reads.
enemy_fires_missile:                                       ; >2a3a
       .proc                                               ;                   ; 
       cb   @object_distance_hi,@bytes+>02                 ; LD A,($EB8F) / CP $02; 
       jl   _2a3a_end                                      ; RET C             ; too close - don't fire
       movb @cloaking_active_flag,r0                       ; LD A,($EF9F) / OR A; 
       jne  _2a3a_end                                      ; RET NZ            ; player cloaked - don't fire
       .far_call code_bank_11_select,save_working_object_to_scratch; CALL $3341        ; save the working object
       movb @bytes+>41,a                                   ; LD A,$41          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed $41
       movb @bytes+>0e,@handler_type                       ; LD A,$0E / LD ($F7EE),A; handler type 14: missile homing in on the player
       movb @bytes+>02,@ship_type                          ; LD A,$02 / LD ($F7E7),A; ship type 2: missile
       bl   @add_object                                    ; CALL $3037        ; spawn it
       jnc  _2a6e                                          ; JR NC,$2A6E       ; no room for it
       li   hl,msg_incoming_missile                        ; LD HL,$33B7       ; "Incoming missile"
       bl   @show_view_message                             ; CALL $39C8        ; announce it
* TI: no DEC ($009D) (nothing reads it, and it's console ROM on the TI), and no
* sound effect 11 (#R$7468)
_2a6e:                                                     ; >2a6e
       .far_call code_bank_11_select,restore_working_object_from_scratch; JP $334D          ; restore the working object
_2a3a_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Eject an escape capsule
* 
* Used by the routine at #R$28F6.
* .
* Called by #R$291E when a nearly-destroyed trader, pirate or shuttle's
* pilot ejects. Spawns an escape capsule (ship type 5) near the ship
* with a random orientation (#R$8E45), at speed 1, which flies away
* (handler type 12), keeping the
* working object's record safe meanwhile (#R$3341, #R$334D).
eject_escape_capsule:                                      ; >2a71
       .proc                                               ;                   ; 
       .far_call code_bank_11_select,save_working_object_to_scratch; CALL $3341        ; save the working object
       movb one,@object_status_byte                        ; LD A,$01 / LD ($F7CD),A; status: in use
       movb one,@object_speed                              ; LD ($F7E6),A      ; speed 1
       movb @bytes+>05,@ship_type                          ; LD A,$05 / LD ($F7E7),A; ship type 5: escape capsule
       movb @bytes+>03,@cargo_type                         ; LD A,$03 / LD ($F7EC),A; cargo type 3: slaves (the pilot, if scooped)
       .far_call code_bank_11_select,random_orientation    ; CALL $8E45        ; point it in a random direction
       movb @bytes+>0c,@handler_type                       ; LD A,$0C / LD ($F7EE),A; handler type 12: leave
       bl   @add_object                                    ; CALL $3037        ; spawn it
       .far_call code_bank_11_select,restore_working_object_from_scratch; JP $334D          ; restore the working object
       .endproc                                            ;                   ; 

********************************************************************************
* A Thargoid releases its Thargons
* 
* Used by the routine at #R$28F6.
* .
* Called by #R$291E when a Thargoid fires back. Spawns 4-7 Thargons
* (ship type 6) at the Thargoid's position, pointing in random directions
* (#R$8E45), speeding up and then
* attacking (handler type 8, #R$2859). Each remembers its Thargoid's
* slot (#R$F7EB), so they can be sent away when it's destroyed (#R$31AD),
* and holds alien items (cargo type 16, #R$F7EC) if scooped. The
* Thargoid has none left afterwards (#R$F7EA).
release_thargons:                                          ; >2a94
       .proc                                               ;                   ; 
       sb   @object_missiles,@object_missiles              ; XOR A / LD ($F7EA),A; no more Thargons
       .far_call code_bank_11_select,save_working_object_to_scratch; CALL $3341        ; save the Thargoid
       movb @current_slot,@thargons_thargoid               ; LD A,($E911) / LD ($F7EB),A; remember the Thargoid's slot
       bl   @random_byte                                   ; CALL $2176        ; 
       andi a,>0300                                        ; AND $03           ; 
       ab   @bytes+>04,a                                   ; ADD A,$04         ; 4-7 Thargons
       movb a,b                                            ; LD B,A            ; 
       movb one,@object_status_byte                        ; LD A,$01 / LD ($F7CD),A; status: in use
       movb one,@object_speed                              ; LD ($F7E6),A      ; speed 1
       movb @bytes+>08,@handler_type                       ; LD A,$08 / LD ($F7EE),A; handler type 8: fly on, then attack
       movb @bytes+>06,@ship_type                          ; LD A,$06 / LD ($F7E7),A; ship type 6: Thargon
       movb @bytes+>10,@cargo_type                         ; LD A,$10 / LD ($F7EC),A; cargo type 16: alien items
_2ac0:                                                     ; >2ac0
       .push bc                                            ; PUSH BC           ; 
       .far_call code_bank_11_select,random_orientation    ; CALL $8E45        ; point it in a random direction
       .far_call code_bank_11_select,countdown_and_speed_up; CALL $2859        ; speed up for a while
       bl   @add_object                                    ; CALL $3037        ; add it to the object table
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $2AC0        ; next Thargon
       jne  _2ac0                                          ;                   ; 
       .far_call code_bank_11_select,restore_working_object_from_scratch; JP $334D          ; restore the Thargoid
       .endproc                                            ;                   ; 

********************************************************************************
* Fire the laser (fire button or 'A')
* 
* Used by the routine at #R$401C.
* .
* Called by #R$401C while the fire control is held. Does nothing if the
* current view has no laser (($F818) negative), the laser has overheated
* (temperature ($F813) at 48) or it's still cooling down from the last
* shot (($F81B) nonzero). Otherwise fires: sets ($F81B) to $80 so that
* this frame's objects can be hit (#R$28F6) and the beams are drawn
* (#R$2DC8), clears ($E873) so that the shot can hit one object, picks
* the point the beams meet ($E867/$E868, near the centre of the view,
* randomly jittered by up to 7 pixels), raises the laser temperature by
* 2, plays the laser sound and redraws the temperature gauge (#R$6B60).
fire_laser:                                                ; >2ad0
       .proc                                               ;                   ; 
       movb @view_laser_type,r0                            ; LD A,($F818) / OR A; 
       jlt  _2ad0_end                                      ; RET M             ; no laser in this view
       cb   @laser_temp_gauge,@bytes+>30                   ; LD A,($F813) / CP $30; 
       jeq  _2ad0_end                                      ; RET Z             ; overheated
       movb @laser_state,r0                                ; LD HL,$F81B / LD A,(HL) / OR A; 
       jne  _2ad0_end                                      ; RET NZ            ; still cooling down
       movb r0,@laser_shot_used                            ; LD ($E873),A      ; the shot hasn't hit anything yet
       movb @bytes+>80,@laser_state                        ; LD (HL),$80       ; fired this frame
       bl   @random_byte                                   ; LD A,R            ; (TI: a random byte for the R register)
       andi a,>0700                                        ; AND $07           ; 
       ab   @bytes+>55,a                                   ; ADD A,$55         ; 
       movb a,@laser_target_x                              ; LD ($E867),A      ; the beams meet at X = $55-$5C...
       bl   @random_byte                                   ; LD A,R            ; 
       andi a,>0700                                        ; AND $07           ; 
       ab   @bytes+>3d,a                                   ; ADD A,$3D         ; 
       movb a,@laser_target_y                              ; LD ($E868),A      ; ...and Y = $3D-$44
       ab   @bytes+>02,@laser_temp_gauge                   ; LD HL,$F813 / INC (HL) / INC (HL); laser temperature += 2
* TI: no sound effect 3 (#R$7468), as the sound effects aren't converted yet
       bl   @draw_laser_temperature                        ; JP $6B60          ; redraw the laser temperature gauge
_2ad0_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Draw the laser beams
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD); does nothing if the
* dashboard isn't shown (#R$6C9E). In the frame the laser fires (($F81B)
* negative, see #R$2AD0), starts the cooldown - loads ($F81B) with the
* laser's cooldown (#R$F819) - and draws four beams, from the corners of
* the view (the table at #R$3365) to the point ($E867) where they meet.
* While ($F81B) is positive, counts the cooldown down ($2DEF).
draw_laser_beams:                                          ; >2dc8
       .proc                                               ;                   ; 
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; 
       movb @laser_state,r0                                ; LD HL,$F81B / LD A,(HL) / OR A; 
       jeq  _2dc8_end                                      ; RET Z             ; laser ready - nothing to do
       jlt  _2dd2                                          ; JP P,$2DEF        ; 
       sb   one,@laser_state                               ; DEC (HL)          ; cooling down: one fewer frame
       jmp  _2dc8_end                                      ; RET               ; 
_2dd2:                                                     ; >2dd2
       movb @laser_cooldown,@laser_state                   ; LD A,($F819) / LD (HL),A; fired this frame: start the cooldown
       li   hl,laser_beam_start_points                     ; LD HL,$3365       ; the four corners of the view
       movb @bytes+>04,b                                   ; LD B,$04          ; 
_2ddd:                                                     ; >2ddd
       movb *hl+,@e                                        ; LD E,(HL) / INC HL; 
       movb *hl+,d                                         ; LD D,(HL) / INC HL; 
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @laser_target_x,@c                             ; LD BC,($E867)     ; BC = the point where the beams meet
       movb @laser_target_y,b                              ;                   ; 
       .call @setup_bresenham_line                         ; CALL $3C48        ; draw a beam
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $2DDD        ; 
       jne  _2ddd                                          ;                   ; 
_2dc8_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Laser beam start points
* 
* The (x, y) screen coordinates #R$2DC8 draws the laser beams from: two
* beams from each bottom corner of the space view.
laser_beam_start_points:                                   ; >3365
       byte >00,>7F                                               ; bottom left
       byte >00,>76                                               ; bottom left, a little higher
       byte >AF,>7F                                               ; bottom right
       byte >AF,>76                                               ; bottom right, a little higher

********************************************************************************
* Draw a ship's laser beam
* 
* Used by the routine at #R$13FD.
* .
* Called by the main loop (#R$13FD) when a ship has fired at the player
* (#R$E92D, see #R$26A9) and is drawn this frame (#R$E6F3). Draws a line
* from the ship's gun (vertex #R$F803) to a point 3000 ahead along its nose
* vector (#R$439D, #R$F7DA). If that point is in front of the player, $442A
* draws the beam; otherwise, if the gun is, the beam is clipped where it
* passes the player (#R$4B22).
* .
* At $442A, projects the far end (#R$47C4); then the gun vertex (#R$4A5C)
* is projected too if it's in front of the player (at $4455), otherwise the
* beam is clipped (#R$4B22). Draws the line (#R$3AC2).
* TI: process_frame only calls this when the ship has fired (#R$E92D).
draw_ship_laser:                                           ; >43c2
       .proc                                               ;                   ; 
       movb @ship_fired,r0                                 ; LD A,($E92D) / OR A; has the ship fired?
       jeq  _4463                                          ; RET Z             ; no
       movb @nothing_changed_flag,r0                       ; LD A,($E6F3) / OR A; 
       jne  _4463                                          ; RET NZ            ; not drawn this frame
       movb @vector_cache_valid_flag,r0                    ; LD A,($E6F0) / OR A; 
       jne  _43d3                                          ; CALL Z,$433F      ; 
       bl   @cache_orientation                             ;                   ; cache the orientation
_43d3:                                                     ; >43d3
       mov  @view_z,hl                                     ; LD HL,($E6DC)     ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       mov  hl,@view_z2                                    ; LD ($E6DA),HL     ; twice the ship's z
       li   hl,>0bb8                                       ; LD HL,$0BB8       ; 3000...
       li   ix,nose_vector                                 ; LD IX,$F7DA       ; ...along the nose vector
       .far_call code_bank_11_select,multiply_vector       ; CALL $439D        ; 
       bl   @convert_to_view                               ; CALL $44CE        ; convert to the view
       bl   @add_object_position                           ; CALL $44D2        ; add the ship's position
       movb de,@line_end_1_x+1                             ; LD ($F769),DE     ; the far end
       movb @e,@line_end_1_x                               ;                   ; 
       movb bc,@line_end_1_y+1                             ; LD ($F76B),BC     ; 
       movb @c,@line_end_1_y                               ;                   ; 
       movb hl,@line_end_1_z+1                             ; LD ($F76D),HL     ; 
       movb @l,@line_end_1_z                               ;                   ; 
       mov  hl,hl                                          ; JR Z,$43FC / LD A,H / OR A; 
       jgt  draw_ship_laser_2                              ; JP P,$442A        ; in front of the player
_43fc:                                                     ; >43fc
       bl   @gun_vertex_relative                           ; LD A,($F803) / LD E,A / CALL $4A5C; the gun vertex relative to the player
       jnc  _4463                                          ; JR NC,$4428       ; behind the player too
       movb de,@line_end_2_x+1                             ; LD ($F76F),DE     ; the gun
       movb @e,@line_end_2_x                               ;                   ; 
       movb bc,@line_end_2_y+1                             ; LD ($F771),BC     ; 
       movb @c,@line_end_2_y                               ;                   ; 
       movb hl,@line_end_2_z+1                             ; LD ($F773),HL     ; 
       movb @l,@line_end_2_z                               ;                   ; 
       bl   @project_point                                 ; CALL $47C4        ; project the gun
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; 
       mov  de,@clip_point1_y                              ; LD ($EB94),DE     ; 
       bl   @clip_line_at_player                           ; CALL $4B22        ; clip the beam where it passes the player
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; 
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; 
       bl   @clip_and_draw_line                            ; CALL $3AC2        ; draw the line
       jmp  _4463                                          ; JR $4428 / JR $4463; 
draw_ship_laser_2:                                         ; >442a
       bl   @project_point                                 ; CALL $47C4        ; project the far end
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; 
       mov  de,@clip_point1_y                              ; LD ($EB94),DE     ; 
       bl   @gun_vertex_relative                           ; LD A,($F803) / LD E,A / CALL $4A5C; the gun vertex relative to the player
       joc  draw_ship_laser_3                              ; JR C,$4455        ; in front of the player
       movb de,@line_end_2_x+1                             ; LD ($F76F),DE     ; 
       movb @e,@line_end_2_x                               ;                   ; 
       movb bc,@line_end_2_y+1                             ; LD ($F771),BC     ; 
       movb @c,@line_end_2_y                               ;                   ; 
       movb hl,@line_end_2_z+1                             ; LD ($F773),HL     ; 
       movb @l,@line_end_2_z                               ;                   ; 
       bl   @clip_line_at_player                           ; CALL $4B22        ; clip the beam where it passes the player
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; 
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; 
       jmp  _4460                                          ; JR $4460          ; 
draw_ship_laser_3:                                         ; >4455
       bl   @project_point                                 ; CALL $47C4        ; project the gun
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; 
       mov  de,@clip_point2_y                              ; LD ($EB98),DE     ; 
_4460:                                                     ; >4460
       bl   @clip_and_draw_line                            ; CALL $3AC2        ; draw the line
_4463:                                                     ; >4463
       .endproc                                            ; RET               ; 

********************************************************************************
* Spawn the cargo of a destroyed ship
* 
* Used by the routines at #R$25B9 and #R$28F6.
* .
* Called when a ship is destroyed (#R$25FF, #R$291E), with IX pointing at
* its object record. Byte $14 of the ship's blueprint ($F809, see #R$A817)
* gives the cargo: its low nibble the most cargo canisters that can appear
* (a random number from 0 up to that, at most 7), its high nibble the cargo
* type. $FF means just one canister (the Cougar's, holding the cloaking
* device). An asteroid (ship type 4) breaks into platlets (ship type 7)
* instead. Each canister's cargo type (#R$F7EC) is the ship's (with a
* 27/256 chance of a random one instead), except that cargo type 15 from
* the blueprint becomes $FF - the cloaking device (see #R$8BA6). The pieces
* fly apart from the ship's position in random directions (#R$8E45) at
* speed $FF, as handler type 9 (spin, fly on and leave).
* .
* At $8DCA, picks how many pieces there are. At $8E33, picks a random cargo
* type.
* .
* At $8E37, turns cargo type 15 into $FF, the cloaking device. At $8E38,
* gives the piece its cargo type and adds it to the object table.
* 
* I:IX Pointer to the destroyed ship's object record
* TI: for an asteroid, the number of pieces is in asteroid_pieces (see #R$2BAC).
spawn_cargo:                                               ; >8db9
       .proc                                               ;                   ; 
       movb @bp_cargo,a                                    ; LD A,($F809)      ; A = the ship's cargo byte
       cb   @>1a(ix),@bytes+>04                            ;                   ; (TI: an asteroid's is in asteroid_pieces)
       jne  _8db9_1                                        ;                   ; 
       movb @asteroid_pieces,a                             ;                   ; 
_8db9_1:                                                   
       movb a,a                                            ; OR A              ; 
       jeq  _8db9_end                                      ; RET Z             ; no cargo
       .push a                                             ;                   ; 
       .far_call code_bank_11_select,save_working_object_to_scratch; CALL $3341        ; save the working object
       .pop a                                              ;                   ; 
       movb a,@c                                           ; LD C,A            ; 
       cb   a,@b255                                        ; CP $FF            ; the Cougar?
       jne  spawn_cargo_2                                  ; JR NZ,$8DCA       ; no
       movb one,a                                          ; LD A,$01          ; one canister
       jmp  _8dd9                                          ; JR $8DD9          ; 
spawn_cargo_2:                                             ; >8dca
       andi a,>0f00                                        ; AND $0F           ; A = the most canisters
       movb a,b                                            ; LD B,A            ; 
_8dcd:                                                     ; >8dcd
       bl   @random_byte                                   ; CALL $2176        ; 
       andi a,>0700                                        ; AND $07           ; A = 0-7
       cb   a,b                                            ; CP B              ; 
       jh   _8dcd                                          ; JR Z,$8DD7 / JR NC,$8DCD; too many - pick again
       movb a,a                                            ; OR A              ; 
       jeq  _8db9_end                                      ; RET Z             ; none
_8dd9:                                                     ; >8dd9
       movb a,b                                            ; LD B,A            ; B = number of canisters
       movb @c,a                                           ; LD A,C            ; 
       srl  a,4                                            ; RRA x 4           ; 
       andi a,>0f00                                        ; AND $0F           ; 
       movb a,@c                                           ; LD C,A            ; C = cargo type
       movb @1(ix),@object_position_x                      ; LD L,(IX+$01) / LD H,(IX+$02) / LD ($F7CE),HL; start at the ship's position (TI: big-endian)
       movb @2(ix),@object_position_x+1                    ;                   ; 
       movb @3(ix),@object_position_y                      ; LD L,(IX+$03) / LD H,(IX+$04) / LD ($F7D0),HL; 
       movb @4(ix),@object_position_y+1                    ;                   ; 
       movb @5(ix),@object_position_z                      ; LD L,(IX+$05) / LD H,(IX+$06) / LD ($F7D2),HL; 
       movb @6(ix),@object_position_z+1                    ;                   ; 
       movb @bytes+>41,@object_status_byte                 ; LD A,$41 / LD ($F7CD),A; 
       movb @bytes+>07,a                                   ; LD A,$07          ; an asteroid breaks into platlets...
       cb   @>1a(ix),@bytes+>04                            ; LD A,(IX+$1A) / CP $04; 
       jeq  _8e0d                                          ; JR Z,$8E0D        ; 
       movb @bytes+>03,a                                   ; LD A,$03          ; ...anything else leaves cargo canisters
_8e0d:                                                     ; >8e0d
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       movb @bytes+>09,@handler_type                       ; LD A,$09 / LD ($F7EE),A; handler type 9: spin, fly on and leave
       movb @b255,@object_speed                            ; LD A,$FF / LD ($F7E6),A; speed $FF
_8e1a:                                                     ; >8e1a
       .push bc                                            ;                   ; 
       .far_call code_bank_11_select,random_orientation    ; CALL $8E45        ; point it in a random direction
       .pop bc                                             ;                   ; 
       movb @c,a                                           ; LD A,C            ; A = cargo type
       cb   @ship_type,@bytes+>03                          ; LD A,($F7E7) / CP $03; a cargo canister?
       jne  _8e38                                          ; JR NZ,$8E38       ; a platlet
       cb   a,@bytes+>0f                                   ; SUB $0F           ; cargo type 15?
       jeq  spawn_cargo_cloaking_device                    ; JR Z,$8E37        ; yes - $FF, the cloaking device
       bl   @random_byte                                   ; CALL $2176        ; 
       cb   a,@bytes+>e5                                   ; CP $E5            ; 27/256 chance...
       jhe  spawn_cargo_random                             ; JR NC,$8E33       ; ...of a random cargo type
       movb @c,a                                           ; LD A,C            ; otherwise the ship's
       jmp  _8e38                                          ; JR $8E35 / JR $8E38; 
spawn_cargo_random:                                        ; >8e33
       andi a,>0f00                                        ; AND $0F           ; a random cargo type
       jmp  _8e38                                          ; JR $8E38          ; 
spawn_cargo_cloaking_device:                               ; >8e37
       movb @b255,a                                        ; DEC A             ; $FF: the cloaking device
_8e38:                                                     ; >8e38
       movb a,@cargo_type                                  ; LD ($F7EC),A      ; cargo type
       .push bc                                            ; PUSH BC           ; 
       bl   @add_object                                    ; CALL $3037        ; add it to the object table
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $8E1A        ; next canister
       jne  _8e1a                                          ;                   ; 
       .far_call code_bank_11_select,restore_working_object_from_scratch; JP $334D          ; restore the working object
_8db9_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Key Esc: launch the escape capsule
* 
* Reached via the key table at #R$419B; only in flight (#R$6DCF). Needs an
* escape capsule (#R$F77C), and doesn't work in witchspace (#R$EEC1) or in
* mission state $52 (#R$E93D) - #R$16FE beeps instead. Cancels any
* hyperspace countdown (#R$E91B), and leaves the player's Cobra Mk III
* (ship type $0E) behind, at the position and orientation in #R$1C4A, turning
* away (handler type 7, then 15, #R$2810). If there's room for it in the object
* table (#R$3037), uses up the capsule, stops the ship (#R$F814, #R$1A7D),
* clears the legal status (#R$EB65), switches to the front view (#R$64A1),
* loses the cargo (#R$9237), plays sound effect 11 and shows "Capsule
* released"; otherwise (at $1A77) "Malfunction!!!".
key_escape_capsule:                                        ; >19fc
       .proc                                               ;                   ; 
       bl   @refuse_if_docked                              ; CALL $6DCF        ; refuse if docked
       movb @item_escape_capsule,r0                        ; LD A,($F77C) / OR A; an escape capsule?
       jeq  _19fc_end                                      ; JP Z,$16FE        ; no (TI: no beep yet)
       movb @in_witchspace,r0                              ; LD A,($EEC1) / OR A; in witchspace?
       jne  _19fc_end                                      ; JP NZ,$16FE       ; yes
       cb   @mission_state,@bytes+>52                      ; LD A,($E93D) / CP $52; 
       jeq  _19fc_end                                      ; JP Z,$16FE        ; that mission state
       sb   @hyperspace_countdown_inner,@hyperspace_countdown_inner; XOR A / LD ($E91B),A; cancel any hyperspace countdown
       sb   @hyperspace_trigger,@hyperspace_trigger        ; LD ($E920),A      ; 
       movb one,@object_status_byte                        ; LD A,$01 / LD ($F7CD),A; status: in use
       li   hl,escape_capsule_cobra_start                  ; LD HL,$1C4A       ; the Cobra's position and orientation
       li   de,object_position_x                           ; LD DE,$F7CE       ; 
       li   bc,>0012                                       ; LD BC,$0012       ; 18 bytes
       .ldir                                               ; LDIR              ; 
       movb @bytes+>07,@handler_type                       ; LD A,$07 / LD ($F7EE),A; handler type 7: turn away...
       movb @bytes+>12,@handler_countdown                  ; LD A,$12 / LD ($F7EF),A; 
       movb @bytes+>0a,@per_type_parameter_block           ; LD A,$0A / LD ($F7F0),A; 
       movb @bytes+>12,@turn_phase_2_length                ; LD A,$12 / LD ($F7F1),A; 
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       movb a,@turn_phase_2_rate                           ; LD ($F7F2),A      ; 
       movb a,@speed_up_flag                               ; LD ($F7F4),A      ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed 6
       movb @bytes+>0f,@next_handler_type                  ; LD A,$0F / LD ($F7F3),A; ...then 15: the escape capsule's countdown
       movb @bytes+>0e,@ship_type                          ; LD A,$0E / LD ($F7E7),A; ship type $0E: Cobra Mk III
       bl   @add_object                                    ; CALL $3037        ; add it to the object table
       jnc  _1a77                                          ; JR NC,$1A77       ; no room for it
       sb   @item_escape_capsule,@item_escape_capsule      ; XOR A / LD ($F77C),A; the capsule is used up
       sb   @speed_gauge_value,@speed_gauge_value          ; LD ($F814),A      ; stop
       sb   @legal_status,@legal_status                    ; LD ($EB65),A      ; clean
       bl   @stop_roll_and_pitch                           ; CALL $1A7D        ; stop any roll and pitch
       bl   @switch_to_front_view                          ; CALL $64A1        ; switch to the front view
       .far_call code_bank_11_select,clear_cargo_hold      ; CALL $9237        ; lose the cargo
* TI: no sound effect 11 (#R$7468), as the sound effects aren't converted yet
       li   hl,msg_capsule_released                        ; LD HL,$1B6D       ; "Capsule released"
       jmp  _1a7a                                          ; JR $1A7A          ; 
_1a77:                                                     ; >1a77
       li   hl,msg_malfunction                             ; LD HL,$1B98       ; "Malfunction!!!"
_1a7a:                                                     ; >1a7a
       bl   @show_view_message                             ; JP $39C8          ; show it
_19fc_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Stop rolling and pitching
* 
* Used by the routines at #R$19FC, #R$86E6 and #R$894D.
* .
* Turns the flight controls off (#R$EF8E) and clears the roll and pitch
* rates ($F815/$F816).
stop_roll_and_pitch:                                       ; >1a7d
       seto r0                                             ; LD A,$FF          ; 
       movb r0,@flight_controls_off                        ; LD ($EF8E),A      ; flight controls off
       sb   @roll_rate,@roll_rate                          ; XOR A / LD ($F815),A; no roll
       sb   @pitch_rate,@pitch_rate                        ; LD ($F816),A      ; no pitch
       rt                                                  ; RET               ; 

********************************************************************************
* Escape capsule: the abandoned Cobra's position and orientation
* 
* Copied to #R$F7CE by #R$19FC for the Cobra Mk III the player leaves behind:
* X = 0, Y = -150, Z = 50, then the side vector (1, 0, 0) and the nose vector
* (0, 0, 1).
* TI: big-endian, as the object workspace's words are
escape_capsule_cobra_start:                                ; >1c4a
       data >0000,>ff6a,>0032                                     ; X, Y, Z
       data >4000,>0000,>0000                                     ; side vector
       data >0000,>0000,>4000                                     ; nose vector

********************************************************************************
* Key 'T': target a missile
* 
* Reached only via #R$419B's (key code, handler) table - not a literal
* CALL/JP.
* .
* Begins arming a missile lock: bails if #R$E910 (the missile
* lock-on state - 0 idle, 1 while acquiring, 2 once locked; #R$4735
* advances 1 -> 2 once #R$E911's candidate target is confirmed still
* live via #R$3016, caching it to #R$E928) is already nonzero, or if
* #R$F776 (the missile count) is 0 (nothing to fire). Otherwise
* advances #R$E910 from 0 to 1 and redraws the missile indicator.
key_handler_t:                                             ; >2d58
       .proc                                               ;                   ; 
       bl   @refuse_if_docked                              ; CALL $6DCF        ; refuse if docked
       movb @missile_state,r0                              ; LD A,($E910) / OR A; 
       jne  _2d58_end                                      ; JP NZ,$16FE       ; already arming or locked (TI: no beep yet)
       movb @missile_count,r0                              ; LD A,($F776) / OR A; 
       jeq  _2d58_end                                      ; JP Z,$16FE        ; no missiles left
       ab   one,@missile_state                             ; LD HL,$E910 / INC (HL); start arming (state 0 -> 1)
       bl   @draw_missile_indicator                        ; JP $6B6E          ; redraw the missile indicator
_2d58_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Key 'M': fire the missile
* 
* Reached via the key table at #R$419B. Needs the missile to be locked on
* to a target (#R$E910 = 2). Adds a missile (ship type 2, handler type 3)
* to the object table (#R$3037), at the position and orientation in #R$3429,
* with the target (#R$E928) in ($F7EF). If there's room for it, plays sound
* effect 11 and takes one off the number of missiles (#R$F776); otherwise
* (at $2DBC) shows "Missile jammed!".
key_fire_missile:                                          ; >2d7e
       .proc                                               ;                   ; 
       movb @missile_state,a                               ; LD A,($E910)      ; 
       sb   @bytes+>02,a                                   ; SUB $02           ; locked on?
       jne  _2d7e_end                                      ; JP NZ,$16FE       ; no (TI: no beep yet)
       movb a,@missile_state                               ; LD ($E910),A      ; yes - clear the lock
       movb @bytes+>41,a                                   ; LD A,$41          ; 
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; 
       li   hl,missile_launch_start                        ; LD HL,$3429       ; the missile's position and orientation
       li   de,object_position_x                           ; LD DE,$F7CE       ; 
       li   bc,>0012                                       ; LD BC,$0012       ; 18 bytes
       .ldir                                               ; LDIR              ; 
       movb @bytes+>02,@ship_type                          ; LD A,$02 / LD ($F7E7),A; ship type 2: missile
       movb @bytes+>03,@handler_type                       ; LD A,$03 / LD ($F7EE),A; handler type 3: the player's missile
       movb @missile_target,@handler_countdown             ; LD A,($E928) / LD ($F7EF),A; its target
       bl   @add_object                                    ; CALL $3037        ; add it to the object table
       jnc  continue_2d7e_missile_jammed                   ; JR NC,$2DBC       ; no room for it
* TI: no sound effect 11 (#R$7468), as the sound effects aren't converted yet
       sb   one,@missile_count                             ; LD HL,$F776 / DEC (HL); one fewer missile
       jmp  _2dc5                                          ; JR $2DC5          ; 
continue_2d7e_missile_jammed:                              ; >2dbc
       li   hl,msg_missile_jammed                          ; CALL $16FE / LD HL,$33A8; "Missile jammed!" (TI: no beep yet)
       bl   @show_view_message                             ; CALL $39C8        ; 
_2dc5:                                                     ; >2dc5
       bl   @draw_missile_indicator                        ; JP $6B6E          ; redraw the missile indicator
_2d7e_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Key 'E': set off the ECM
* 
* Reached via the key table at #R$419B; only in flight (#R$6DCF). Needs an
* ECM system (#R$F778), and doesn't work while the jammer is on (#R$EFA8) -
* #R$16FE beeps instead. Plays the ECM sound effect, which runs the ECM
* (#R$782B), and shows the "E" indicator (#R$6B12).
key_handler_e:                                             ; >3223
       .proc                                               ;                   ; 
       bl   @refuse_if_docked                              ; CALL $6DCF        ; refuse if docked
       movb @item_ecm_system,r0                            ; LD A,($F778) / OR A; ECM fitted?
       jeq  _3223_end                                      ; JP Z,$16FE        ; no (TI: no beep yet)
       movb @jammer_active_flag,r0                         ; LD A,($EFA8) / OR A; jammer on?
       jne  _3223_end                                      ; JP NZ,$16FE       ; yes
* TI: no sound effect 8 (#R$7468); the countdown it starts (#R$7815) is set here
       movb @bytes+>78,@ecm_countdown                      ; LD A,$08 / CALL $7468; the ECM's countdown
       bl   @draw_ecm_indicator                            ; JP $6B12          ; show the "E" indicator
_3223_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* ECM: drain energy and destroy missiles while it's on
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). Does nothing unless the
* ECM countdown (#R$E912) is running; once it has run out, turns the ECM
* off ($3294). While it's running, and the countdown (decremented on every
* VBlank) happens to be odd - about half the frames - it drains the energy
* banks by 1 (#R$19EC) and plays sound effect 4 if it isn't already playing
* (#R$E915); neither happens if it was an enemy's ECM (#R$EEC0 set, see
* #R$25B9). Then destroys (#R$31AD) every missile (ship type 2) that isn't
* already exploding - the player's as well as enemies' - and plays the
* explosion sound if there were any.
* .
* At $3294, once the ECM countdown has run out, clears the countdown and
* #R$EEC0, and hides the "E" indicator (#R$6B12).
* TI: process_frame only calls this while the ECM countdown is running, and
* ti_poll_vblank counts it down (#R$7246).
ecm_active:                                                ; >323c
       .proc                                               ;                   ; 
       movb @ecm_countdown,a                               ; LD A,($E912) / OR A; A = ECM countdown
       jeq  _323c_end                                      ; RET Z             ; ECM off
       jgt  _3244                                          ; JP M,$3294        ; 
       bl   @ecm_off                                       ;                   ; finished - turn it off
       jmp  _323c_end                                      ;                   ; 
_3244:                                                     
       czc  @bit0,a                                        ; BIT 0,A           ; 
       jeq  _325e                                          ; JR Z,$325E        ; countdown even - skip the energy drain
       movb @enemy_ecm,r0                                  ; LD A,($EEC0) / OR A; an enemy's ECM?
       jne  _325e                                          ; JR NZ,$325E       ; yes - no cost to the player
* TI: no sound effect 4 (#R$7468), as the sound effects aren't converted yet
       movb one,b                                          ; LD B,$01          ; 
       .far_call code_bank_11_select,decay_counter_f817    ; CALL $19EC        ; drain the energy banks by 1
_325e:                                                     ; >325e
       sb   @something_destroyed,@something_destroyed      ; XOR A / LD ($E869),A; nothing destroyed yet
       li   ix,ship_object_table                           ; LD IX,$EBA0       ; IX -> the object table
       li   de,>0028                                       ; LD DE,$0028       ; DE = 40 (one object record)
       movb @bytes+>14,b                                   ; LD B,$14          ; 20 slots
_326b:                                                     ; >326b
       movb *ix,r0                                         ; BIT 0,(IX+$00)    ; in use?
       andi r0,>0100                                       ;                   ; 
       jeq  _3285                                          ; JR Z,$3285        ; no - next slot
       movb *ix,r0                                         ; BIT 3,(IX+$00)    ; already exploding?
       andi r0,>0800                                       ;                   ; 
       jne  _3285                                          ; JR NZ,$3285       ; yes - next slot
       cb   @>1a(ix),@bytes+>02                            ; LD A,(IX+$1A) / CP $02; a missile?
       jne  _3285                                          ; JR NZ,$3285       ; no - next slot
       socb @bit6,*ix                                      ; SET 6,(IX+$00)    ; no bounty for it
       .push bc                                            ;                   ; 
       .push de                                            ;                   ; 
       bl   @destroy_object                                ; CALL $31AD        ; destroy it
       .pop de                                             ;                   ; 
       .pop bc                                             ;                   ; 
_3285:                                                     ; >3285
       a    de,ix                                          ; ADD IX,DE         ; IX -> the next slot
       sb   one,b                                          ; DJNZ $326B        ; 
       jne  _326b                                          ;                   ; 
* TI: no sound effect 2 (#R$7468), as the sound effects aren't converted yet
_323c_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Turn the ECM off
ecm_off:                                                   ; >3294
       sb   @enemy_ecm,@enemy_ecm                          ; XOR A / LD ($EEC0),A; clear the enemy-ECM flag
       sb   @ecm_countdown,@ecm_countdown                  ; LD ($E912),A      ; clear the ECM countdown
       b    @draw_ecm_indicator                            ; JP $6B12          ; hide the "E" indicator

********************************************************************************
* Key TAB: set off the energy bomb
* 
* Reached only via #R$419B's (key code, handler) table - not a literal
* CALL/JP. Beeps (#R$16FE) and returns unless an energy bomb is fitted
* (#R$F77D, entry 8 of the equipment array at #R$F775); if it is, uses it up
* and destroys (#R$31AD) every active object except Thargoids (ship type
* $13), over the 17 (or, with #R$EEC1 set, 20) slots from slot 3 onward.
key_handler_tab:                                           ; >329e
       .proc                                               ;                   ; 
       bl   @refuse_if_docked                              ; CALL $6DCF        ; refuse if docked
       movb @item_energy_bomb,r0                           ; LD A,($F77D) / OR A; an energy bomb?
       jeq  _329e_end                                      ; JP Z,$16FE        ; no (TI: no beep yet)
       sb   @item_energy_bomb,@item_energy_bomb            ; XOR A / LD ($F77D),A; it's used up
       sb   @something_destroyed,@something_destroyed      ; LD ($E869),A      ; nothing destroyed yet
       li   ix,object_slot_3                               ; LD IX,$EC18       ; IX -> slot 3 (after the planet, the sun and the station)
       movb @bytes+>11,b                                   ; LD B,$11          ; 17 slots
       movb @in_witchspace,r0                              ; LD A,($EEC1) / OR A; in witchspace?
       jeq  _32c1                                          ; JR Z,$32C1        ; 
       movb @bytes+>14,b                                   ; LD IX,$EC18 / LD B,$14; 20 slots (3 past the end of the table, as on the MSX)
_32c1:                                                     ; >32c1
       li   de,>0028                                       ; LD DE,$0028       ; DE = 40 (one object record)
_32c4:                                                     ; >32c4
       movb *ix,r0                                         ; BIT 0,(IX+$00)    ; in use?
       andi r0,>0100                                       ;                   ; 
       jeq  _32d8                                          ; JR Z,$32D8        ; no - next slot
       cb   @>1a(ix),@bytes+>13                            ; LD A,(IX+$1A) / CP $13; a Thargoid?
       jeq  _32d8                                          ; JR Z,$32D8        ; yes - the bomb doesn't affect it
       socb @bit6,*ix                                      ; SET 6,(IX+$00)    ; no bounty for it
       .push bc                                            ;                   ; 
       .push de                                            ;                   ; 
       bl   @destroy_object                                ; CALL $31AD        ; destroy it
       .pop de                                             ;                   ; 
       .pop bc                                             ;                   ; 
_32d8:                                                     ; >32d8
       a    de,ix                                          ; ADD IX,DE         ; IX -> the next slot
       sb   one,b                                          ; DJNZ $32C4        ; 
       jne  _32c4                                          ;                   ; 
* TI: no sound effect 2 (#R$7468), as the sound effects aren't converted yet
_329e_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Missile launch position and orientation
* 
* Copied to #R$F7CE by #R$2D7E for a missile fired by the player: X = 0, Y =
* -50, Z = 20, then the side vector (1, 0, 0) and the nose vector (0, 0, 1).
* TI: big-endian, as the object workspace's words are
missile_launch_start:                                      ; >3429
       data >0000,>ffce,>0014                                     ; X, Y, Z
       data >4000,>0000,>0000                                     ; side vector
       data >0000,>0000,>4000                                     ; nose vector

********************************************************************************
* Update the altitude and cabin temperature gauges, then maybe scoop fuel
* 
* Used by the routine at #R$13FD.
* .
* Quantizes the distance from the planet ($E727, offset +1000) via
* #R$15CB into #R$F812 (the altitude gauge), redrawing it with #R$6AC4
* only when it changes. Does the same for the distance from the sun
* (#R$E725, offset +2048, then negated and rebiased by $18) into #R$F811
* (the cabin temperature gauge, which rises as the sun gets closer),
* redrawn via #R$6AD0. If #R$F811 is then below $15 (21), stops there. Otherwise, only with #R$F77B (the Fuel Scoop, see
* #R$F775's own header for the equipment array) fitted and #R$F814 at
* least $0F: bumps #R$F775 (fuel) up
* by one tenth-of-a-light-year (capped at 70 - a no-op once full),
* redraws the fuel dial (#R$6AAD) and prints "Fuel Scoop Activated"
* ($1B59) - the sun-scooping mechanic, gated on being close enough to
* the sun (#R$F811 high) and going fast enough (speed #R$F814).
update_altitude_and_temperature:                           ; >1577
       .proc                                               ;                   ; 
       movb @planet_distance+1,hl                          ; LD HL,($E727)     ; HL = distance from the planet
       movb @planet_distance,@l                            ;                   ; 
       ai   hl,1000                                        ; LD DE,$03E8 / ADD HL,DE; + 1000
       li   bc,>04e0                                       ; LD BC,$04E0       ; B = shift count, C = mask
       li   de,>f000                                       ; LD DE,$F000       ; DE = -4096, the baseline
       bl   @distance_to_gauge                             ; CALL $15CB        ; A = the altitude (0-24)
       cb   a,@altitude_gauge                              ; LD HL,$F812 / CP (HL); changed?
       jeq  _158f                                          ; LD (HL),A / CALL NZ,$6AC4; 
       movb a,@altitude_gauge                              ;                   ; yes - store it...
       bl   @draw_altitude                                 ;                   ; ...and redraw the gauge
_158f:                                                     ; >158f
       movb @sun_distance+1,hl                             ; LD HL,($E725)     ; HL = distance from the sun
       movb @sun_distance,@l                               ;                   ; 
       li   bc,>03f0                                       ; LD BC,$03F0       ; B = shift count, C = mask
       li   de,>f800                                       ; LD DE,$F800       ; DE = -2048, the baseline
       bl   @distance_to_gauge                             ; CALL $15CB        ; A = 0-24
       movb @bytes+>18,r0                                  ; SUB $18 / NEG     ; 
       sb   a,r0                                           ;                   ; 24 - that: the cabin temperature
       cb   r0,@cabin_temperature                          ; LD HL,$F811 / CP (HL); changed?
       jeq  _15a7                                          ; LD (HL),A / CALL NZ,$6AD0; 
       movb r0,@cabin_temperature                          ;                   ; yes - store it...
       bl   @draw_cabin_temperature                        ;                   ; ...and redraw the gauge
_15a7:                                                     ; >15a7
       cb   @cabin_temperature,@bytes+>15                  ; LD A,($F811) / CP $15; 21 or more?
       jl   _1577_end                                      ; RET C             ; no
       movb @item_fuel_scoop,r0                            ; LD A,($F77B) / OR A; a fuel scoop?
       jeq  _1577_end                                      ; RET Z             ; no
       cb   @speed_gauge_value,@bytes+>0f                  ; LD A,($F814) / CP $0F; speed 15 or more?
       jl   _1577_end                                      ; RET C             ; no
       cb   @fuel_level,@bytes+>46                         ; LD A,($F775) / CP $46; full (70)?
       jeq  _1577_end                                      ; RET Z             ; yes
       ab   one,@fuel_level                                ; INC A / LD ($F775),A; scoop 0.1 light years
       bl   @draw_fuel_gauge                               ; CALL $6AAD        ; redraw the fuel gauge
       movb @message_timer,r0                              ; LD HL,$1B59 / JP $39E9; (TI: #R$39E9 inline) a message showing?
       jne  _1577_end                                      ;                   ; yes
       li   hl,msg_fuel_scoop_activated                    ;                   ; no - "Fuel Scoop Activated"
       bl   @show_view_message                             ;                   ; 
_1577_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Convert a distance into a dashboard gauge value
* 
* Used by the routine at #R$1577.
* .
* Used by #R$1577 for the altitude and cabin temperature gauges. Returns
* (HL - baseline) * 24 / 2^B / 256, which is 0-24 for a distance from the
* baseline to twice the baseline: 0 for a distance below the baseline (at
* $15D2), and 24 for one with any of C's bits set in its high byte.
* 
* I:B Shift count (so that twice the baseline gives 24)
* I:C Mask for the high byte of a distance that's out of range
* I:DE Baseline (negated)
* I:HL Distance
* O:A The gauge value (0-24)
* TI: works out (HL - baseline) * 24 / 2^(8 + B) with MPY and one shift.
distance_to_gauge:                                         ; >15cb
       movb @c,r0                                          ; LD A,H / AND C    ; 
       inv  r0                                             ;                   ; 
       movb hl,r1                                          ;                   ; 
       szcb r0,r1                                          ;                   ; R1 = the high byte's bits in C
       jeq  subtract_baseline_then_scale                   ; JR Z,$15D2        ; in range
       movb @bytes+>18,a                                   ; LD A,$18          ; out of range: 24
       rt                                                  ; RET               ; 
subtract_baseline_then_scale:                              ; >15d2
       a    de,hl                                          ; ADD HL,DE         ; HL -= the baseline
       joc  scale_remainder_by_1_5                         ; JR C,$15D7        ; 
       sb   a,a                                            ; XOR A             ; below it: 0
       rt                                                  ; RET               ; 
scale_remainder_by_1_5:                                    ; >15d7
       li   r0,24                                          ; ADD HL,HL x 3 / ... / ADD HL,DE; R0:R1 = HL * 24
       mpy  hl,r0                                          ;                   ; 
       srl  r1,8                                           ;                   ; 
       sla  r0,8                                           ;                   ; 
       soc  r0,r1                                          ;                   ; R1 = HL * 24 / 256
       movb b,r0                                           ; SRL A / RR H / DJNZ $15DF; 
       srl  r0,8                                           ;                   ; R0 = B
       srl  r1,0                                           ;                   ; / 2^B
       swpb r1                                             ;                   ; 
       movb r1,a                                           ; LD A,H            ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Check whether the ship has been destroyed, crashed or burned up
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop's per-frame pass (#R$13FD). Ends the
* game (($F749) = $FF, with the cause in ($F74A)) if the altitude gauge
* ($F812) has reached 0 (crashed into the planet: cause 0), the energy
* banks ($F817) are empty (destroyed: cause 1, via $16C9), or the cabin
* temperature ($F811) is at its maximum of 24 (burned up: cause 2, via
* $16D4).
* .
* At $16DE, stores the flag and the cause.
check_for_death:                                           ; >16ba
       movb @altitude_gauge,r0                             ; LD A,($F812) / OR A; 
       jne  check_for_death_energy                         ; JR NZ,$16C9       ; altitude not zero
       li   r0,>ff00                                       ; LD BC,$00FF       ; crashed: cause 0
       jmp  _16de                                          ; JR $16DE          ; 
check_for_death_energy:                                    ; >16c9
       movb @energy_gauge,r0                               ; LD A,($F817) / OR A; 
       jne  check_for_death_heat                           ; JR NZ,$16D4       ; energy left
       li   r0,>ff01                                       ; LD BC,$01FF       ; destroyed: cause 1
       jmp  _16de                                          ; JR $16DE          ; 
check_for_death_heat:                                      ; >16d4
       cb   @cabin_temperature,@bytes+>18                  ; LD A,($F811) / CP $18; 
       jne  _16ba_end                                      ; JR NZ,$16DE       ; not too hot
       li   r0,>ff02                                       ; LD BC,$02FF       ; burned up: cause 2
_16de:                                                     ; >16de
       movb r0,@game_over                                  ; LD ($F749),BC     ; the game-over flag...
       swpb r0                                             ;                   ; 
       movb r0,@game_over_cause                            ;                   ; ...and the cause
_16ba_end:                                                 
       rt                                                  ; RET               ; 

********************************************************************************
* Death scene
* 
* Used by the routine at #R$0106.
* .
* Called by the main loop (#R$0106) when the game is over because the ship
* was destroyed, crashed into the planet or burned up in the sun (($F74A)
* = 0-2, see #R$16BA), but not when the player quit (($F74A) = 3).
* .
* Switches to the front view and clears the object table. Adds four
* pieces of debris ("Platlet", ship type 7) at a distance of 200, each
* at a random orientation, then two explosions (handler type 1, see
* #R$2556) at distances of 250 and 150, and plays sound effect 2
* (the explosion). Then, each frame, runs each object's handler
* and draws it, with "Game Over" underneath (the debris slowing down
* every 4th frame), and gives the space
* view random colours on the first frame (#R$180B). Stops once the last
* explosion's 64-frame countdown has run out and it has been removed.
death_scene:                                               ; >1703
       .proc                                               ;                   ; 
       sb   @docked,@docked                                ; XOR A / LD ($E90A),A; not docked
       bl   @switch_to_front_view                          ; CALL $64A1        ; switch to the front view
       movb @bytes+>e4,@message_row                        ; LD A,$E4 / LD ($E92C),A; messages at the bottom of the view
       bl   @clear_all_ship_slots                          ; CALL $28D4        ; clear the object table
       movb one,@object_status_byte                        ; LD A,$01 / LD ($F7CD),A; status: in use
       movb one,@object_speed                              ; LD ($F7E6),A      ; 
       movb one,@death_scene_colours_flag                  ; LD ($E945),A      ; random colours on the first frame
       sb   @handler_type,@handler_type                    ; LD A,$00 / LD ($F7EE),A; handler type 0 for the debris
       movb @bytes+>07,@ship_type                          ; LD A,$07 / LD ($F7E7),A; ship type 7 (Platlet)
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 pieces of debris
_1729:                                                     ; >1729
       .push bc                                            ; PUSH BC           ; 
       clr  @object_position_x                             ; LD HL,$0000 / LD ($F7CE),HL; 
       clr  @object_position_y                             ; LD ($F7D0),HL     ; X = Y = 0
       li   r0,200                                         ; LD HL,$00C8       ; 
       mov  r0,@object_position_z                          ; LD ($F7D2),HL     ; Z = 200
       li   de,nose_vector                                 ; LD DE,$F7DA       ; DE -> the nose vector
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 words
_173e:                                                     ; >173e
       bl   @random_byte                                   ; CALL $2176        ; fill it with random values
       movb a,@1(de)                                       ; LD (DE),A / INC DE; (TI: big-endian, the low byte second)
       bl   @random_byte                                   ; CALL $2176        ; 
       andi a,>bf00                                        ; AND $BF           ; clear bit 6
       movb a,*de                                          ; LD (DE),A / INC DE; 
       inct de                                             ;                   ; 
       sb   one,b                                          ; DJNZ $173E        ; 
       jne  _173e                                          ;                   ; 
       socb @bit7,@nose_vector_z                           ; DEC DE / EX DE,HL / SET 7,(HL); make the last component negative
       .far_call code_bank_11_select,orientation_from_nose ; CALL $8E62        ; work out the other axes
       movb @bytes+>fa,@object_speed                       ; LD A,$FA / LD ($F7E6),A; speed $FA
       bl   @move_object                                   ; CALL $866D x 3    ; move it forward three times
       bl   @move_object                                   ;                   ; 
       bl   @move_object                                   ;                   ; 
       li   r1,>8000                                       ; LD DE,$F7DB / LD B,$03; 
       a    r1,@nose_vector                                ; LD A,(DE) / XOR $80 / LD (DE),A; negate the vector
       a    r1,@nose_vector_y                              ;                   ; 
       a    r1,@nose_vector_z                              ;                   ; 
       .far_call code_bank_11_select,orientation_from_nose ; CALL $8E62        ; work out the other axes again
       bl   @add_object                                    ; CALL $3037        ; add the piece to the object table
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $1729        ; next piece
       jne  _1729                                          ;                   ; 
       clr  @object_position_x                             ; LD HL,$0000 / LD ($F7CE),HL; 
       clr  @object_position_y                             ; LD ($F7D0),HL     ; X = Y = 0
       li   r0,250                                         ; LD HL,$00FA       ; 
       mov  r0,@object_position_z                          ; LD ($F7D2),HL     ; Z = 250
       sb   @object_speed,@object_speed                    ; XOR A / LD ($F7E6),A; 
       movb @bytes+>40,@handler_countdown                  ; LD A,$40 / LD ($F7EF),A; explosion lasts 64 frames
       movb @b255,@per_type_parameter_block                ; LD A,$FF / LD ($F7F0),A; (see #R$2556)
       movb one,@handler_type                              ; LD A,$01 / LD ($F7EE),A; handler type 1: explosion
       movb @bytes+>02,b                                   ; LD B,$02          ; 2 explosions
_179b:                                                     ; >179b
       .push bc                                            ; PUSH BC           ; 
       bl   @add_object                                    ; CALL $3037        ; add one to the object table
       li   r0,-100                                        ; LD HL,($F7D2) / LD DE,$FF9C / ADD HL,DE; 
       a    r0,@object_position_z                          ; LD ($F7D2),HL     ; Z -= 100
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $179B        ; 
       jne  _179b                                          ;                   ; 
* TI: no sound effect 2 (#R$7468), as the sound effects aren't converted yet
_17b1:                                                     ; >17b1
       bl   @clear_space_view                              ; CALL $388F        ; next frame: clear the space view
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; 
       movb @bytes+>06,b                                   ; LD B,$06          ; 6 objects
_17b9:                                                     ; >17b9
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       li   de,object_status_byte                          ; LD DE,$F7CD       ; 
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the object's record to the workspace
       bl   @get_blueprint_data                            ; CALL $16E3        ; set it up for its ship type
       bl   @work_out_distance                             ; CALL $883D        ; work out its distance
       cb   @handler_type,one                              ; LD A,($F7EE) / CP $01; 
       jeq  _17dd                                          ; JR Z,$17DD        ; explosion - skip this
       ab   one,@handler_countdown                         ; LD HL,$F7EF / INC (HL); 
       movb @handler_countdown,r0                          ; LD A,(HL)         ; 
       andi r0,>0300                                       ; AND $03           ; 
       jne  _17dd                                          ; JR NZ,$17DD       ; 
       sb   one,@object_speed                              ; LD HL,$F7E6 / DEC (HL); debris: slow down every 4th frame
_17dd:                                                     ; >17dd
       .far_call code_bank_11_select,run_object_handler    ; CALL $2528        ; run its handler (#R$2556 for the explosions)
       bl   @draw_object                                   ; CALL $422E        ; draw it
       bl   @move_object                                   ; CALL $866D        ; move it forward
       .pop de                                             ; POP DE            ; DE = this slot's address again
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the record back
       mov  de,hl                                          ; EX DE,HL          ; HL -> the next slot
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $17B9        ; next object
       jne  _17b9                                          ;                   ; 
       li   hl,msg_game_over_1b7d                          ; LD HL,$1B7D       ; 
       bl   @show_view_message                             ; CALL $39C8        ; "Game Over"
       bl   @copy_space_view                               ; CALL $3846        ; copy the space view to the screen
       movb @death_scene_colours_flag,r0                   ; LD A,($E945) / OR A; 
       jeq  _1803                                          ; CALL NZ,$180B     ; 
       bl   @death_scene_colours                           ;                   ; first frame: random colours
_1803:                                                     ; >1803
       movb @object_status_byte,r0                         ; LD A,($F7CD) / BIT 0,A; the last explosion
       andi r0,>0100                                       ;                   ; 
       jne  _17b1                                          ; JR NZ,$17B1       ; still there - next frame
       .endproc                                            ; RET               ; 

********************************************************************************
* Death scene: give the space view random colours
* 
* Used by the routine at #R$1703.
* .
* Called once, on the first frame of the death scene (#R$1703). Fills the
* space view's part of the colour table (from $2128, 14 character rows of
* 176 bytes) with random foreground colours (2-15) on black, using the R
* register as a source of noise.
* TI: the colours come from random_byte, as there is no R register.
death_scene_colours:                                       ; >180b
       .proc                                               ;                   ; 
       sb   @death_scene_colours_flag,@death_scene_colours_flag; XOR A / LD ($E945),A; clear the flag
       li   hl,color_table+>0128+>4000                     ; LD HL,$2128       ; the colour table at row 1, column 5 (to write)
       movb @bytes+>0e,@c                                  ; LD C,$0E          ; 14 rows
_1814:                                                     ; >1814
       bl   @ti_poll_vblank                                ; DI                ; (TI: not between the two address bytes)
       swpb hl                                             ; LD A,L / OUT ($99),A; 
       movb hl,@vdpwa                                      ;                   ; 
       swpb hl                                             ;                   ; 
       movb hl,@vdpwa                                      ; LD A,H / OR $40 / OUT ($99),A; point the VDP at the row
       movb @bytes+>b0,b                                   ; LD B,$B0          ; 176 bytes (22 characters)
_181f:                                                     ; >181f
       bl   @random_byte                                   ; LD A,R            ; a random colour...
       andi a,>0f00                                        ; AND $0F           ; 
       cb   a,@bytes+>02                                   ; CP $02            ; 
       jl   _181f                                          ; JR C,$181F        ; ...from 2 to 15
       sla  a,4                                            ; ADD A,A x 4       ; 
       ori  a,>0100                                        ; OR $01            ; on black
       movb a,@vdpwd                                       ; OUT ($98),A       ; write it
       sb   one,b                                          ; DJNZ $181F        ; 
       jne  _181f                                          ;                   ; 
       ai   hl,>0100                                       ; INC H             ; next row
       sb   one,@c                                         ; DEC C             ; 
       jne  _1814                                          ; JR NZ,$1814       ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* "REAR VIEW" bitmap
* 
* The view name shown when switching to the rear view (#R$64B5): 7
* characters of 5 pixel rows each, one character per line, which #R$645B
* copies into rows 1-5 of the character patterns at VRAM $0060-$0097.
* TI: the view names are in ROM bank 12 with the code that switches to them
view_name_rear:                                            ; >11b2
       byte >3C,>36,>3C,>34,>32                                   ; 
       byte >F9,>C3,>F3,>C3,>FB                                   ; 
       byte >CF,>6D,>EF,>6D,>6C                                   ; 
       byte >03,>83,>03,>01,>80                                   ; 
       byte >6F,>66,>66,>46,>8F                                   ; 
       byte >7D,>61,>79,>61,>7C                                   ; 
       byte >B0,>B0,>B0,>F0,>A0                                   ; 
view_name_left:                                            ; >11d5
       byte >30,>30,>30,>30,>3E                                   ; 
       byte >FB,>C3,>F3,>C3,>FB                                   ; 
       byte >EF,>06,>C6,>06,>06                                   ; 
       byte >03,>03,>03,>01,>00                                   ; 
       byte >6F,>66,>66,>46,>8F                                   ; 
       byte >7D,>61,>79,>61,>7C                                   ; 
       byte >B0,>B0,>B0,>F0,>A0                                   ; 
view_name_right:                                           ; >11f8
       byte >F3,>D9,>F1,>D1,>CB                                   ; 
       byte >CF,>98,>9B,>99,>CF                                   ; 
       byte >6D,>6C,>7C,>6C,>6C                                   ; 
       byte >E0,>C0,>C0,>C0,>C0                                   ; 
       byte >6D,>6C,>6C,>28,>11                                   ; 
       byte >EF,>CC,>CF,>CC,>EF                                   ; 
       byte >B6,>36,>36,>3E,>94                                   ; 
       even                                                       ; 

********************************************************************************
* Key '2': buy cargo, or switch to the rear view
* 
* Reached via the key table at #R$419B.
key_handler_2:                                             ; >417d
       .proc                                               ;                   ; 
       movb @docked,r0                                     ; LD A,($E90A) / OR A; 
       jeq  key_handler_2_1                                ; JP NZ,$5BBD       ; 
       .far_call code_bank_7_select,buy_cargo              ;                   ; docked - buy cargo
       jmp  key_handler_2_2                                ;                   ; 
key_handler_2_1:                                           
       bl   @switch_to_rear_view                           ; JP $64B5          ; in flight - the rear view
key_handler_2_2:                                           
       .endproc                                            ;                   ; 

********************************************************************************
* Key '3': sell cargo, or switch to the left view
* 
* Reached via the key table at #R$419B.
key_handler_3:                                             ; >4187
       .proc                                               ;                   ; 
       movb @docked,r0                                     ; LD A,($E90A) / OR A; 
       jeq  key_handler_3_1                                ; JP NZ,$5CEE       ; 
       .far_call code_bank_7_select,sell_cargo             ;                   ; docked - sell cargo
       jmp  key_handler_3_2                                ;                   ; 
key_handler_3_1:                                           
       bl   @switch_to_left_view                           ; JP $64C9          ; in flight - the left view
key_handler_3_2:                                           
       .endproc                                            ;                   ; 

********************************************************************************
* Key '4': equip ship, or switch to the right view
* 
* Reached via the key table at #R$419B.
key_handler_4:                                             ; >4191
       .proc                                               ;                   ; 
       movb @docked,r0                                     ; LD A,($E90A) / OR A; 
       jeq  key_handler_4_1                                ; JP NZ,$5DBB       ; 
       .far_call code_bank_7_select,equip_ship             ;                   ; docked - equip the ship
       jmp  key_handler_4_2                                ;                   ; 
key_handler_4_1:                                           
       bl   @switch_to_right_view                          ; JP $64DD          ; in flight - the right view
key_handler_4_2:                                           
       .endproc                                            ;                   ; 

********************************************************************************
* Switch to the rear view
* 
* Used by the routine at #R$417D.
* .
* Rear view counterpart of #R$64A1 (key '2').
switch_to_rear_view:                                       ; >64b5
       .proc                                               ;                   ; 
       bl   @refuse_if_docked                              ; CALL $6DCF        ; 
       li   hl,view_rear                                   ; LD HL,$44E6       ; the rear view's conversion
       mov  hl,@convert_to_view+>0002                      ; LD ($44CF),HL     ; patch the view conversion (#R$44CE)
       movb @bytes+>01,b                                   ; LD B,$01          ; B = 1 (rear view)
       li   hl,stardust_rear_view                          ; LD HL,$656B       ; the rear view's stardust handler
       li   de,view_name_rear                              ; LD DE,$11B2       ; the rear view's name
       b    @switch_view                                   ; JP $645B          ; switch view

********************************************************************************
* Switch to the left view
* 
* Used by the routine at #R$4187.
* .
* Left view counterpart of #R$64A1 (key '3').
switch_to_left_view:                                       ; >64c9
       .proc                                               ;                   ; 
       bl   @refuse_if_docked                              ; CALL $6DCF        ; 
       li   hl,view_left                                   ; LD HL,$44F3       ; the left view's conversion
       mov  hl,@convert_to_view+>0002                      ; LD ($44CF),HL     ; patch the view conversion (#R$44CE)
       movb @bytes+>02,b                                   ; LD B,$02          ; B = 2 (left view)
       li   hl,stardust_left_view                          ; LD HL,$6628       ; the left view's stardust handler
       li   de,view_name_left                              ; LD DE,$11D5       ; the left view's name
       b    @switch_view                                   ; JP $645B          ; switch view

********************************************************************************
* Switch to the right view
* 
* Used by the routine at #R$4191.
* .
* Right view counterpart of #R$64A1 (key '4').
switch_to_right_view:                                      ; >64dd
       .proc                                               ;                   ; 
       bl   @refuse_if_docked                              ; CALL $6DCF        ; 
       li   hl,view_right                                  ; LD HL,$44FB       ; the right view's conversion
       mov  hl,@convert_to_view+>0002                      ; LD ($44CF),HL     ; patch the view conversion (#R$44CE)
       movb @bytes+>03,b                                   ; LD B,$03          ; B = 3 (right view)
       li   hl,stardust_right_view                         ; LD HL,$6682       ; the right view's stardust handler
       li   de,view_name_right                             ; LD DE,$11F8       ; the right view's name
       b    @switch_view                                   ; JP $645B          ; switch view

********************************************************************************
* The Torus jump in the main loop
*
* TI: the Torus jump part of the main loop ($14BE-$1500), in ROM bank 12.
* process_frame only calls it while a jump is in progress or being cut
* short.
torus_jump_frame:                                          ; >14be
       .proc                                               ;                   ; 
       movb @torus_jump_countdown,a                        ; LD A,($E918) / OR A; A = Torus jump countdown
       jeq  _14ea                                          ; JR Z,$14EA        ; no jump in progress
       sb   one,a                                          ; DEC A             ; 
       movb a,@torus_jump_countdown                        ; LD ($E918),A      ; count down one frame
       jne  _14ea                                          ; JR NZ,$14EA       ; jump not over yet
       sb   @jump_in_progress,@jump_in_progress            ; LD ($E722),A      ; jump over: clear the jump-in-progress flag
       sb   @flight_controls_off,@flight_controls_off      ; LD ($EF8E),A      ; and turn the flight controls back on
       bl   @restore_speed                                 ; CALL $8B8F        ; restore the speed from before the jump
       bl   @random_byte                                   ; CALL $2176        ; the jump may end near a hostile ship:
       movb a,@c                                           ; LD C,A            ; C = random 0-255
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       sb   @bytes+>21,a                                   ; SUB $21           ; 
       jeq  _14e6                                          ; JR Z,$14E6        ; state $21 - A = 0, so almost certainly a hostile
       movb @current_system_government,a                   ; LD A,($F762)      ; 
       andi a,>ff00                                        ;                   ; 
       sla  a,5                                            ; ADD A,A x 5       ; A = government * 32 (mod 256)
_14e6:                                                     ; >14e6
       cb   a,@c                                           ; CP C              ; random number above A?
       jhe  _14ea                                          ; CALL C,$2C3C      ; 
       .far_call code_bank_11_select,condition_red         ;                   ; yes - "Condition RED!" and spawn a hostile ship
_14ea:                                                     ; >14ea
       movb @secondary_flag_counter_pair,r0                ; LD A,($E933) / OR A; jump being cut short?
       jeq  _14be_end                                      ; JR Z,$1503        ; no
       sb   @flight_controls_off,@flight_controls_off      ; XOR A / LD ($EF8E),A; turn the flight controls back on
       sb   @secondary_flag_counter_pair,@secondary_flag_counter_pair; LD ($E933),A      ; and this flag
       sb   @torus_jump_countdown,@torus_jump_countdown    ; LD ($E918),A      ; end the jump
       sb   @jump_in_progress,@jump_in_progress            ; LD ($E722),A      ; 
* TI: no beep (#R$16FE), as the sound effects aren't converted yet
       bl   @restore_speed                                 ; CALL $8B8F        ; restore the speed from before the jump
_14be_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Key 'C': dock using the docking computer
* 
* Reached via the key table at #R$419B. Beeps unless a docking computer
* is fitted (#R$F77F), the player is in the space station's safe zone
* (#R$EB05) and hasn't shot at the station ($EF97, see #R$291E), and the
* station hasn't been taken over by the Thargoids (mission state $52).
* Does nothing in witchspace (#R$EEC1). Otherwise docks at once (#R$E917).
key_handler_c:                                             ; >1692
       movb @item_docking_computer,r0                      ; LD A,($F77F) / OR A; 
       jeq  _1692_end                                      ; JP Z,$16FE        ; no docking computer (TI: no beep yet)
       movb @station_in_range,r0                           ; LD A,($EB05) / OR A; 
       jeq  _1692_end                                      ; JP Z,$16FE        ; not in the safe zone
       movb @legal_status_copy,r0                          ; LD A,($EF97) / OR A; 
       jne  _1692_end                                      ; JP NZ,$16FE       ; the player has shot at the station
       movb @in_witchspace,r0                              ; LD A,($EEC1) / OR A; 
       jne  _1692_end                                      ; RET NZ            ; in witchspace
       cb   @mission_state,@bytes+>52                      ; LD A,($E93D) / CP $52; 
       jeq  _1692_end                                      ; JP Z,$16FE        ; the Thargoids' station
       seto r0                                             ; LD A,$FF          ; 
       movb r0,@docking                                    ; LD ($E917),A      ; dock
_1692_end:                                                 
       rt                                                  ; RET               ; 

********************************************************************************
* Engage the Torus Jump Drive ('J')
* 
* Used by the routine at #R$401C.
* .
* The manual's "Torus Jump Drive (J)", which "does not function ... if
* there is another ship, a planet or a sun in the immediate vicinity".
* Refuses with a beep (#R$16FE) if ($EEC1) is set, if #R$3359 reports
* one of its three flags set, or if the magnitude at $E727 is 10000 or
* less. Otherwise saves the current speed at $E87A, stops any roll and
* pitch (#R$1A7D), brings the speed down to 0 (#R$8B7B), and starts a
* 25-frame jump (($E918), counted down by #R$13FD, which restores the
* speed via #R$8B8F at the end) during which #R$872E draws the stardust
* as lengthening streaks. Also sets $E878 to 200 (see #R$8B00).
engage_torus_jump_drive:                                   ; >86e6
       .proc                                               ;                   ; 
       movb @in_witchspace,r0                              ; LD A,($EEC1) / OR A; 
       jne  _86e6_end                                      ; JP NZ,$16FE       ; in witchspace (TI: no beep yet)
       movb @trader_count,r0                               ; CALL $3359        ; any traders,
       socb @pirate_count,r0                               ;                   ; pirates
       socb @num_thargoids,r0                              ;                   ; or Thargoids about?
       jne  _86e6_end                                      ; JP NZ,$16FE       ; yes
       movb @planet_distance+1,r0                          ; LD DE,($E727)     ; R0 = the distance from the planet
       movb @planet_distance,@r0lb                         ;                   ; 
       li   r1,10000                                       ; LD HL,$2710 / OR A / SBC HL,DE; 
       c    r0,r1                                          ;                   ; 
       jle  _86e6_end                                      ; JP NC,$16FE       ; 10000 or less
       movb @speed_gauge_value,@cached_f814_at_engage      ; LD A,($F814) / LD ($E87A),A; save the speed
       bl   @stop_roll_and_pitch                           ; CALL $1A7D        ; stop any roll and pitch
       .far_call code_bank_13_select,stop_ship             ; CALL $8B7B        ; bring the speed down to 0
       movb @bytes+>19,@torus_jump_countdown               ; LD A,$19 / LD ($E918),A; the jump lasts 25 frames
       movb @bytes+>02,@jump_in_progress                   ; LD A,$02 / LD ($E722),A; flag the jump as in progress
       movb @bytes+>c8,@jump_speed                         ; LD HL,$00C8 / LD ($E878),HL; (little-endian)
       sb   @jump_speed+1,@jump_speed+1                    ;                   ; 
       movb @bytes+>05,@stardust_passes_interval           ; LD A,$05 / LD ($E87C),A; lengthen the stardust streaks every 5 frames...
       movb one,@stardust_passes                           ; LD A,$01 / LD ($E723),A; ...starting from 1 pass per frame
       movb one,@stardust_passes_countdown                 ; LD ($E87B),A      ; 
* TI: no sound effect 10 (#R$7468), as the sound effects aren't converted yet
_86e6_end:                                                 
       .endproc                                            ;                   ; 

********************************************************************************
* Restore the speed after a Torus jump
* 
* Used by the routine at #R$13FD.
* .
* Called by the main loop (#R$13FD) when the jump ends. Brings the speed
* (#R$F814) back up to what it was before the jump (#R$E87A) one step at a
* time (#R$6956), without redrawing the speed gauge each time (#R$E92B);
* $8BA1 turns the redrawing back on.
restore_speed:                                             ; >8b8f
       .proc                                               ;                   ; 
       sb   @redraw_speed_gauge,@redraw_speed_gauge        ; XOR A / LD ($E92B),A; don't redraw the speed gauge
_8b93:                                                     ; >8b93
       cb   @speed_gauge_value,@cached_f814_at_engage      ; LD A,($F814) / LD HL,$E87A / CP (HL); back to the speed before the jump?
       jeq  restore_speed_2                                ; JR Z,$8BA1        ; yes
       bl   @speed_up                                      ; CALL $6956        ; speed up
       jmp  _8b93                                          ; JR $8B93          ; 
restore_speed_2:                                           ; >8ba1
       sb   one,@redraw_speed_gauge                        ; LD HL,$E92B / DEC (HL); redraw the speed gauge again
       .endproc                                            ; RET               ; 

********************************************************************************
* Key STOP: freeze the game
* 
* Reached via the key table at #R$419B. Stops any hyperspace countdown
* (#R$E91B) for the time being, and shows "Game Frozen" - over the space
* view if it's showing (#R$E903), or on the dashboard otherwise ($40F9).
* Then waits for one of the keys at #R$41FE (#R$4102).
* .
* At $40F9, when docked, shows "Game Frozen" on the dashboard. The entry at
* $4102 waits for one of the keys at #R$41FE, with a click: STOP unfreezes
* the game, restarting any hyperspace countdown; the others are options
* ($412C), after which it waits for another key.
* .
* At $412C, '1' ends the game (#R$F749) with cause 3, so the main loop
* (#R$0106) skips the death scene and goes back to the title screen; the
* `POP AF` discards the saved hyperspace countdown. Any other key goes on
* to $413C.
* .
* At $413C, sets bit 0 of the options (#R$E914), unless muted (bit 6).
* .
* At $414B, clears bit 0 of the options (#R$E914), unless muted (bit 6).
* .
* At $4157, toggles bit 6 of the options (#R$E914); unmuting also turns the
* sound on (bit 0).
* .
* At $4165, toggles the key's bit of the options (#R$E914), from the table
* at #R$4208. The entry at $4171 waits for another key.
freeze_game:                                               ; >40de
       .proc                                               ;                   ; 
       movb @hyperspace_countdown_inner,a                  ; LD HL,$E91B / LD A,(HL); A = hyperspace countdown
       .push af                                            ; PUSH AF           ; save it
       sb   @hyperspace_countdown_inner,@hyperspace_countdown_inner; LD (HL),$00       ; stop it
       movb @space_view_showing,r0                         ; LD A,($E903) / OR A; 
       jeq  freeze_game_2                                  ; JR Z,$40F9        ; no space view showing
       li   hl,msg_game_frozen                             ; LD HL,$420D       ; "Game Frozen"
       bl   @show_view_message                             ; CALL $39C8        ; show it
       bl   @copy_space_view                               ; CALL $3846        ; copy the space view to the screen
       jmp  _4102                                          ; JR $4102          ; 
freeze_game_2:                                             ; >40f9
       bl   @clear_message_line                            ; CALL $3955        ; clear the message line
       li   hl,msg_game_frozen_4223                        ; LD HL,$4223       ; "Game Frozen"
       bl   @rst_08_target_print_tokenised_string          ; CALL $357A        ; show it
_4102:                                                     ; >4102
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, which reads the keyboard)
       movb @pending_debounced_keypress_byte_status,a      ; LD HL,$E8F5 / LD A,(HL) / OR A; 
       jeq  _4102                                          ; JR Z,$4105        ; wait for a key
       sb   @pending_debounced_keypress_byte_status,@pending_debounced_keypress_byte_status; LD (HL),$00       ; 
       clr  r1                                             ; LD HL,$41FE / LD BC,$000A; R1 = the key's position in the keys for the frozen game
_4111:                                                     ; >4111
       cb   a,@frozen_keys(r1)                             ; CPIR              ; search for a match
       jeq  _4115                                          ;                   ; 
       inc  r1                                             ;                   ; 
       ci   r1,10                                          ;                   ; 
       jne  _4111                                          ;                   ; 
       jmp  _4102                                          ; JR NZ,$4102       ; not one of them
_4115:                                                     ; >4115
* TI: no click (sound effect 0, #R$7468), as the sound effects aren't converted yet
       cb   a,@bytes+>86                                   ; CP $86            ; STOP?
       jne  pause_quit                                     ; JR NZ,$412C       ; no - an option
       movb @space_view_showing,r0                         ; LD A,($E903) / OR A; 
       jne  _4127                                          ; CALL Z,$3955      ; 
       bl   @clear_message_line                            ;                   ; clear the message line
_4127:                                                     ; >4127
       .pop af                                             ; POP AF            ; restart the hyperspace countdown
       movb a,@hyperspace_countdown_inner                  ; LD ($E91B),A      ; 
       .endproc                                            ; RET               ; 
pause_quit:                                                ; >412c
       cb   a,@bytes+>31                                   ; CP $31            ; '1'?
       jne  pause_sound_on                                 ; JR NZ,$413C       ; 
       .pop af                                             ; POP AF            ; 
       movb @b255,@game_over                               ; LD A,$FF / LD ($F749),A; game over...
       movb @bytes+>03,@game_over_cause                    ; LD A,$03 / LD ($F74A),A; ...because the player quit
       .endproc                                            ; RET               ; 
pause_sound_on:                                            ; >413c
       movb @options,r0                                    ; LD HL,$E914       ; R0 = the options
       cb   a,@bytes+>53                                   ; CP $53            ; 'S'?
       jne  pause_sound_off                                ; JR NZ,$414B       ; no - try the next key
       czc  @bit6,r0                                       ; BIT 6,(HL)        ; muted?
       jne  _4102                                          ; JR NZ,$4149       ; yes
       socb @bit0,@options                                 ; SET 0,(HL)        ; sound on
       jmp  _4102                                          ; JR $4171          ; wait for another key
pause_sound_off:                                           ; >414b
       cb   a,@bytes+>51                                   ; CP $51            ; 'Q'?
       jne  pause_mute                                     ; JR NZ,$4157       ; no - try the next key
       czc  @bit6,r0                                       ; BIT 6,(HL)        ; muted?
       jne  _4102                                          ; JR NZ,$4155       ; yes
       szcb @bit0,@options                                 ; RES 0,(HL)        ; sound off
       jmp  _4102                                          ; JR $4171          ; wait for another key
pause_mute:                                                ; >4157
       cb   a,@bytes+>4d                                   ; CP $4D            ; 'M'?
       jne  pause_toggle_option                            ; JR NZ,$4165       ; no - try the remaining keys
       li   r2,>4000                                       ; LD A,(HL) / XOR $40; toggle mute
       xor  r2,r0                                          ;                   ; 
       movb r0,@options                                    ; LD (HL),A         ; 
       jne  _4102                                          ; JR NZ,$4163       ; muted
       socb @bit0,@options                                 ; SET 0,(HL)        ; unmuted - sound on
       jmp  _4102                                          ; JR $4171          ; wait for another key
pause_toggle_option:                                       ; >4165
       movb @option_bits(r1),r2                            ; LD A,$09 / SUB C / LD C,A / LD HL,$4208 / ADD HL,BC; the key's bit
       xor  r2,r0                                          ; LD A,(DE) / XOR (HL); toggle it
       movb r0,@options                                    ; LD (DE),A         ; 
       jmp  _4102                                          ; JR $4102          ; wait for another key

********************************************************************************
* Keys for the frozen game
* 
* Used by the routine at #R$40DE.
* .
* The keys #R$4102 waits for while the game is frozen: 'R', 'D', 'Y',
* 'B' and 'F' toggle options (#R$4165, #R$4208), 'M' mutes (#R$4157),
* 'S' and 'Q' turn the sound on and off (#R$413C, #R$414B), '1' quits
* (#R$412C), and STOP ($86) unfreezes the game.
frozen_keys:                                               ; >41fe
       byte >52,>44,>59,>42,>46,>4D,>53,>51                       ; 'R', 'D', 'Y', 'B', 'F', 'M', 'S', 'Q'
       byte >31,>86                                               ; '1', STOP

********************************************************************************
* Option bits
* 
* The bit of the options (#R$E914) toggled by each of 'R', 'D', 'Y', 'B'
* and 'F' while the game is frozen (#R$4165).
option_bits:                                               ; >4208
       byte >04,>02,>10,>08,>20                                   ; 

********************************************************************************
* The message "Game Frozen"
msg_game_frozen_4223:                                      ; >4223
       text 'Game Froze',>ee                                      ; 
       even                                                       ; 

rom_bank_12_end:
       equ  $
       bss  >8000-$
