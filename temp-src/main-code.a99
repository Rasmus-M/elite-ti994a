* 
* #R$9120 passes this to #R$90D3 as the message to show on the mission
* screen. #R$90D3 prints it with RST $20 (#R$3596), whose list ends at the
* first record with a negative column byte - this one - so all it shows is
* the frame and the header. #R$9120 then prints the briefing itself: the
* name of the system it has picked, followed by #R$9483 (mission 1) or
* #R$96DA (mission 2).
empty_mission_message:                                     ; >9a4a
       byte >FF                                                      ; the end of the list

********************************************************************************
* Goatsoup: show the system's description
* 
* Used by the routine at #R$6164.
* .
* As BBC Elite does, generates the selected system's description (#R$E72B)
* from the goatsoup template at #R$A2EB (#R$9AB9) into the buffer at $E9D7,
* with its random choices seeded from the system's seeds (#R$EAD7, #R$EAD9,
* from #R$F74B-#R$F750). Then prints it from row 15, column 5, word-wrapped
* at 33 characters: at $9A9E, goes back from the 34th character to the last
* space, and (at $9AA6) prints the line up to there and moves on to the
* next row.
show_system_description:                                   ; >9a4b
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       .call @generate_system_name                         ; CALL $4CAF        ; generate its name-seed fields
       mov  @system_s0_lo,hl                               ; LD HL,($F74B)     ; combine two per-object fields...
       mov  @system_s1_lo,de                               ; LD DE,($F74D)     ; 
       movb h,a                                            ; LD A,H            ; 
       ; XOR D                                             ; XOR D             ; TODO: check code. 
       movb a,h                                            ; LD H,A            ; 
       movb @l,a                                           ; LD A,L            ; 
       ; XOR E                                             ; XOR E             ; TODO: check code. 
       movb a,@l                                           ; LD L,A            ; 
       mov  hl,@goatsoup_seed_word1                        ; LD ($EAD7),HL     ; ...into the first seed word
       mov  @system_s2_lo,de                               ; LD DE,($F74F)     ; combine with a third field...
       movb h,a                                            ; LD A,H            ; 
       ; XOR D                                             ; XOR D             ; TODO: check code. 
       movb a,h                                            ; LD H,A            ; 
       movb @l,a                                           ; LD A,L            ; 
       ; XOR E                                             ; XOR E             ; TODO: check code. 
       movb a,@l                                           ; LD L,A            ; 
       mov  hl,@goatsoup_seed_word2                        ; LD ($EAD9),HL     ; ...into the second seed word
       li   hl,shared_blit_or_goatsoup_buffer              ; LD HL,$E9D6       ; the line buffer
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,shared_blit_or_goatsoup_buffer+>0001        ; LD DE,$E9D7       ; 
       li   bc,>00ff                                       ; LD BC,$00FF       ; 255 bytes
       .ldir                                               ; LDIR              ; 
       li   bc,>050f                                       ; LD BC,$050F       ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       li   ix,goatsoup_description_template_a2eb          ; LD IX,$A2EB       ; IX -> the goatsoup template
       li   iy,shared_blit_or_goatsoup_buffer+>0001        ; LD IY,$E9D7       ; IY -> the expanded-text buffer
       .call @goatsoup_expand_one_byte                     ; CALL $9AB9        ; expand the whole template
       sb   *iy,*iy                                        ; LD (IY+$00),$00   ; null-terminate it
       li   de,shared_blit_or_goatsoup_buffer+>0001        ; LD DE,$E9D7       ; DE -> the start of the expanded text
_9a93:                                                     ; >9a93
       li   hl,>0021                                       ; LD HL,$0021       ; look 33 columns ahead
       a    de,hl                                          ; ADD HL,DE         ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; ran off the end of the text?
       jne  _9a9e                                          ; JR NZ,$9A9E       ; no - find a place to wrap
       .ex_de_hl                                           ; EX DE,HL          ; yes - print the rest as one final line
       .rst >08                                            ; RST $08           ; 
       .ret                                                ; RET               ; 
_9a9e:                                                     ; >9a9e
       movb *hl,a                                          ; LD A,(HL)         ; this character a space?
       cb   a,@bytes+>20                                   ; CP $20            ; 
       jeq  _9aa6                                          ; JR Z,$9AA6        ; yes - split the line there
       dec  hl                                             ; DEC HL            ; no - look one character earlier
       jmp  _9a9e                                          ; JR $9A9E          ; 
_9aa6:                                                     ; >9aa6
       sb   *hl,*hl                                        ; LD (HL),$00       ; split the line there (temporarily)
       .push hl                                            ; PUSH HL           ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       .rst >08                                            ; RST $08           ; print this line
       mov  @cursor_vram_addr_row,bc                       ; LD BC,($E710)     ; advance to the next row
       ab   one,@c                                         ; INC C             ; 
       movb @bytes+>05,b                                   ; LD B,$05          ; 
       .call @set_cursor_position                          ; CALL $3548        ; position the cursor
       .pop de                                             ; POP DE            ; recover the split point
       inc  de                                             ; INC DE            ; DE -> the next line's start
       jmp  _9a93                                          ; JR $9A93          ; wrap the rest

********************************************************************************
* Goatsoup: expand one template byte from (IX) into (IY)
* 
* Used by the routines at #R$9A4B, #R$9B35, #R$9B43 and #R$9B7C.
* .
* $00 ends the expansion. $01-$1F dispatch through the #R$A2F2 word table
* to a control-code handler (#R$9B34's `JP (HL)` trampoline -
* #R$9B35/$9B43/$9B6E/$9B71/$9B77/$9B7C are the Ctrl-A..Ctrl-F handlers).
* $20 (space) and above fall to $9ADA.
* .
* At $9ADA, $20-$7F are literal characters, printed via $9B0A. $80 and
* above ($9A/$A5/$A6/etc in the word lists - see #R$9BCB) are symbol
* references: index (byte AND $7F) into a 6-byte-stride table at $A201 to
* get a new IX (a sub-template to recurse into), rolling a random choice
* among that symbol's alternatives via #R$9BB2 (which also advances the
* ship-name seed) if it returns nonzero. Either way recurses via #R$9AB9
* for the chosen sub-template, then continues expanding the outer template.
* .
* At $9B0A, collapses a run of spaces into one. If auto-capitalise
* (#R$EAD6) is armed and the previous character was a space following
* (elsewhere) a full stop, and this character is lowercase, clears its bit
* 5 to capitalise it.
goatsoup_expand_one_byte:                                  ; >9ab9
       movb *ix,a                                          ; LD A,(IX+$00)     ; A = the next template byte
       inc  ix                                             ; INC IX            ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; end of template
       .ret                                                ;                   
!
       cb   a,@bytes+>20                                   ; CP $20            ; a control code (1-31)?
       jhe  goatsoup_expand_literal_or_symbol              ; JR NC,$9ADA       ; no
       ab   a,a                                            ; ADD A,A           ; yes: *2 (word-sized pointers)
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,goatsoup_control_code_dispatch              ; LD HL,$A2F2       ; the control-code handler table
       a    de,hl                                          ; ADD HL,DE         ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL -> this control code's handler
       .push ix                                            ; PUSH IX           ; 
       .call @goatsoup_dispatch_trampoline                 ; CALL $9B34        ; run it
       .pop ix                                             ; POP IX            ; 
       b    @goatsoup_expand_one_byte                      ; JP $9AB9          ; expand the next byte
goatsoup_expand_literal_or_symbol:                         ; >9ada
       socb a,a                                            ; OR A              ; a literal character?
       jlt  !                                              ; JP P,$9B0A        ; yes - print it
       b    @goatsoup_print_literal_capitalise             ;                   
!
       .push ix                                            ; PUSH IX           ; no - a symbol reference
       andi a,>7f00                                        ; AND $7F           ; the symbol's index
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; 
       a    hl,hl                                          ; ADD HL,HL         ; *6 (the symbol table's stride)
       movb h,d                                            ; LD D,H            ; 
       movb @l,@e                                          ; LD E,L            ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       li   de,goatsoup_symbols                            ; LD DE,$A201       ; the symbol table
       a    de,hl                                          ; ADD HL,DE         ; HL -> this symbol's entry
       movb *hl,a                                          ; LD A,(HL)         ; the entry's default sub-template pointer
       movb a,@ixl                                         ; LD IXL,A          ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,ixh                                          ; LD IXH,A          ; 
       .call @goatsoup_advance_seed_roll_0_51              ; CALL $9BB2        ; roll a random alternative (also advances the ship-name seed)
       socb a,a                                            ; OR A              ; 
       jeq  _9b02                                          ; JR Z,$9B02        ; none rolled - use the default sub-template
       movb a,@e                                           ; LD E,A            ; an alternative was rolled - look up its offset
       sb   d,d                                            ; LD D,$00          ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       movb *hl,@e                                         ; LD E,(HL)         ; 
       a    de,ix                                          ; ADD IX,DE         ; -> that alternative's sub-template
_9b02:                                                     ; >9b02
       .call @goatsoup_expand_one_byte                     ; CALL $9AB9        ; recurse into the sub-template
       .pop ix                                             ; POP IX            ; restore the outer template
       b    @goatsoup_expand_one_byte                      ; JP $9AB9          ; continue expanding it
goatsoup_print_literal_capitalise:                         ; >9b0a
       cb   a,@bytes+>20                                   ; CP $20            ; a space?
       jne  _9b13                                          ; JR NZ,$9B13       ; no - print it as-is
       cb   a,@>ffffffff(iy)                               ; CP (IY-$01)       ; yes - was the previous character a space too?
       jeq  goatsoup_expand_one_byte                       ; JR Z,$9AB9        ; yes - collapse it (skip printing this one)
_9b13:                                                     ; >9b13
       movb a,@c                                           ; LD C,A            ; C = the character to print
       movb @goatsoup_capitalize_flag,a                    ; LD A,($EAD6)      ; A = the auto-capitalise flag
       socb a,a                                            ; OR A              ; 
       jeq  _9b2c                                          ; JR Z,$9B2C        ; not armed - print as-is
       movb @>ffffffff(iy),a                               ; LD A,(IY-$01)     ; armed: was the previous character a space?
       cb   a,@bytes+>20                                   ; CP $20            ; 
       jne  _9b2c                                          ; JR NZ,$9B2C       ; no - print as-is
       movb @c,a                                           ; LD A,C            ; yes: is this character lowercase?
       cb   a,@bytes+>61                                   ; CP $61            ; 
       jl   _9b2c                                          ; JR C,$9B2C        ; no - print as-is
       cb   a,@bytes+>7b                                   ; CP $7B            ; 
       jhe  _9b2c                                          ; JR NC,$9B2C       ; no - print as-is
       szcb @bit5,@c                                       ; RES 5,C           ; yes - capitalise it
_9b2c:                                                     ; >9b2c
       movb @c,*iy                                         ; LD (IY+$00),C     ; store the character
       inc  iy                                             ; INC IY            ; 
       b    @goatsoup_expand_one_byte                      ; JP $9AB9          ; expand the next byte

********************************************************************************
* Goatsoup: control-code dispatch trampoline
* 
* Used by the routine at #R$9AB9.
goatsoup_dispatch_trampoline:                              ; >9b34
       b    *hl                                            ; JP (HL)           ; TODO. 

********************************************************************************
* Goatsoup Ctrl-A: expand $E717's contents into the output, plus a space
* 
* Reached only through the control-code handler table at #R$A2F2, indexed by
* the code doubled - not a literal CALL/JP. #R$E717 is the same buffer
* #R$4C9B/$4CB8 and the value-formatting helpers write generated
* names/numbers into, so this control code inserts whatever was most
* recently generated there into the goatsoup output.
line_editor_ctrl_a:                                        ; >9b35
       li   ix,text_buffer                                 ; LD IX,$E717       ; IX -> the last-generated text
       .call @goatsoup_expand_one_byte                     ; CALL $9AB9        ; expand it into the output
       movb @bytes+>20,*iy                                 ; LD (IY+$00),$20   ; append a space
       inc  iy                                             ; INC IY            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Goatsoup control code 2: the system's name as an adjective
* 
* Reached via the table at #R$A2F2. Turns the system's name in #R$E717
* into an adjective, as BBC Elite does ("Lave" becomes "Lavian"): finds
* the end of the name, and adds "ian " (#R$A300) to it - replacing its
* last letter if that's a vowel (#R$A305) - and expands it into the
* description (#R$9AB9). Then generates the selected system's name
* (#R$E72B, #R$4CAF) into #R$E717 again.
goatsoup_adjective:                                        ; >9b43
       li   de,text_buffer                                 ; LD DE,$E717       ; the system's name
_9b46:                                                     ; >9b46
       movb *de,a                                          ; LD A,(DE)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  goatsoup_adjective_2                           ; JR Z,$9B4D        ; found the end
       inc  de                                             ; INC DE            ; 
       jmp  _9b46                                          ; JR $9B46          ; 
goatsoup_adjective_2:                                      ; >9b4d
       dec  de                                             ; DEC DE            ; DE -> the last letter
       movb *de,a                                          ; LD A,(DE)         ; 
       li   hl,vowels                                      ; LD HL,$A305       ; the vowels
       li   bc,>0005                                       ; LD BC,$0005       ; 
       ; CPIR                                              ; CPIR              ; TODO: check code. a vowel?
       jeq  _9b5a                                          ; JR Z,$9B5A        ; yes - replace it
       inc  de                                             ; INC DE            ; no - add after it
_9b5a:                                                     ; >9b5a
       li   hl,adjective_ending                            ; LD HL,$A300       ; "ian "
       movb @bytes+>06,@c                                  ; LD C,$06          ; "ian " and the terminator (and one more)
       .ldir                                               ; LDIR              ; add it
       li   ix,text_buffer                                 ; LD IX,$E717       ; expand the result
       .call @goatsoup_expand_one_byte                     ; CALL $9AB9        ; expand the name into the description
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       b    @generate_system_name                          ; JP $4CAF          ; generate its name again

********************************************************************************
* Goatsoup Ctrl-D: back up the output cursor by one character
* 
* Reached only via the same $A2F2 dispatch table as #R$9B35 (index 4) - not
* a literal CALL/JP.
line_editor_ctrl_d:                                        ; >9b6e
       dec  iy                                             ; DEC IY            ; back up the output cursor
       .ret                                                ; RET               ; 

********************************************************************************
* Goatsoup Ctrl-E: arm auto-capitalisation
* 
* Reached only via the same $A2F2 dispatch table as #R$9B35 (index 5) - not a
* literal CALL/JP. Never triggered in this capture.
line_editor_ctrl_e:                                        ; >9b71
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@goatsoup_capitalize_flag                    ; LD ($EAD6),A      ; arm #R$9B0A's auto-capitalise flag
       .ret                                                ; RET               ; 

********************************************************************************
* Goatsoup Ctrl-F: disarm auto-capitalisation
* 
* Reached only via the same $A2F2 dispatch table as #R$9B35 (index 6) - not
* a literal CALL/JP.
line_editor_ctrl_f:                                        ; >9b77
       sb   a,a                                            ; XOR A             ; 
       movb a,@goatsoup_capitalize_flag                    ; LD ($EAD6),A      ; disarm #R$9B0A's auto-capitalise flag
       .ret                                                ; RET               ; 

********************************************************************************
* Goatsoup Ctrl-C: generate and insert a random ship name
* 
* Reached only via the same $A2F2 dispatch table as #R$9B35 (index 3) - not a
* literal CALL/JP. Never triggered in this capture. Advances rotating_
* accumulator from the two seed words #R$9A4B derived (#R$EAD7/$EAD9,
* XORed together into #R$E904/$E906/$E908), then generates 4 more
* name-seed bytes (#R$4CE7) and expands them into a name via #R$4CB8 -
* the same machinery #R$4C9B/#R$4CE7 use for system names - before
* expanding the result into the output (#R$9AB9) and appending a space.
line_editor_ctrl_c:                                        ; >9b7c
       mov  @goatsoup_seed_word1,hl                        ; LD HL,($EAD7)     ; combine the two seed words...
       mov  hl,@system_seeds                               ; LD ($E904),HL     ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       mov  @goatsoup_seed_word2,hl                        ; LD HL,($EAD9)     ; 
       mov  hl,@seed_s1                                    ; LD ($E906),HL     ; 
       movb h,a                                            ; LD A,H            ; 
       ; XOR D                                             ; XOR D             ; TODO: check code. 
       movb a,h                                            ; LD H,A            ; 
       movb @l,a                                           ; LD A,L            ; 
       ; XOR E                                             ; XOR E             ; TODO: check code. 
       movb a,@l                                           ; LD L,A            ; 
       mov  hl,@seed_s2                                    ; LD ($E908),HL     ; ...into rotating_accumulator
       li   ix,goatsoup_name_pairs                         ; LD IX,$EADB       ; 
       .call @system_name_from_seeds                       ; CALL $4CE7        ; build 4 more name-seed bytes
       li   hl,goatsoup_name_pairs                         ; LD HL,$EADB       ; expand the name-seed digrams via $E717...
       .call @expand_name                                  ; CALL $4CB8        ; 
       li   ix,text_buffer                                 ; LD IX,$E717       ; ...and expand the generated name into the output
       .call @goatsoup_expand_one_byte                     ; CALL $9AB9        ; 
       movb @bytes+>20,*iy                                 ; LD (IY+$00),$20   ; append a space
       inc  iy                                             ; INC IY            ; 
       movb @selected_system,a                             ; LD A,($E72B)      ; then overwrite $E717 with the selected system's
       b    @generate_system_name                          ; JP $4CAF          ; name too, and return

********************************************************************************
* Goatsoup: advance the ship-name seed (Fibonacci-style), roll a 0-51 value
* 
* Used by the routine at #R$9AB9.
* .
* Advances the two seed words #R$9A4B set up (#R$EAD7/$EAD9) in a
* Fibonacci-like fashion (new second word = sum of both, old second
* word becomes the new first), then scales the high byte of the sum by
* 52/256 (#R$2079) to roll a value 0-51 - #R$9ADA's random-alternative
* selector for a symbol's weighted choices.
goatsoup_advance_seed_roll_0_51:                           ; >9bb2
       .push hl                                            ; PUSH HL           ; 
       mov  @goatsoup_seed_word2,hl                        ; LD HL,($EAD9)     ; HL = the second seed word
       mov  @goatsoup_seed_word1,de                        ; LD DE,($EAD7)     ; DE = the first seed word
       mov  hl,@goatsoup_seed_word1                        ; LD ($EAD7),HL     ; the second word becomes the new first
       a    de,hl                                          ; ADD HL,DE         ; sum them
       mov  hl,@goatsoup_seed_word2                        ; LD ($EAD9),HL     ; the sum becomes the new second word
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>34,a                                   ; LD A,$34          ; 52
       .call @divide_hl_a                                  ; CALL $2079        ; scale the sum's high byte by 52/256
       movb @l,a                                           ; LD A,L            ; A = the rolled value, 0-51
       .pop hl                                             ; POP HL            ; 
       .ret                                                ; RET               ; 

