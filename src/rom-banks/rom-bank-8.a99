********************************************************************************
* Goatsoup: the system description template
* 
* The top-level template for a system's description, which #R$9A4B (at
* $9A81) expands with #R$9AB9. Control code 4 takes back the space after
* the last word, so that the full stop follows it directly. The last two
* bytes, at $A2F2, double as entry 0 of the control-code handler table
* (#R$A2F4), which is never used.
goatsoup_description_template_a2eb:                        ; >a2eb
       byte >06,>92                                               ; control code 6 (#R$9B77), symbol $92
       text 'is '                                                 ; 
       byte >93,>04                                               ; symbol $93, control code 4 (#R$9B6E)
goatsoup_control_code_dispatch:                            ; >a2f2
       text '.',>00                                               ; a full stop, and the end
_a2f4:                                                     ; >a2f4
       byte line_editor_ctrl_a%%256,line_editor_ctrl_a//256       ; 1: #R$9B35
       byte goatsoup_adjective%%256,goatsoup_adjective//256       ; 2: #R$9B43
       byte line_editor_ctrl_c%%256,line_editor_ctrl_c//256       ; 3: #R$9B7C
       byte line_editor_ctrl_d%%256,line_editor_ctrl_d//256       ; 4: #R$9B6E
       byte line_editor_ctrl_e%%256,line_editor_ctrl_e//256       ; 5: #R$9B71
       byte line_editor_ctrl_f%%256,line_editor_ctrl_f//256       ; 6: #R$9B77
adjective_ending:                                          ; >a300
       text 'ian ',>00                                            ; 
vowels:                                                    ; >a305
       text 'aeiou'                                               ; 

rom_bank_8_end:
       equ  $
       bss  >8000-$
