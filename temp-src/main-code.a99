       data sound_effect_14                                          ; 14

********************************************************************************
* Title music
* 
* The tune header #R$1C5C passes to #R$7603: the number of channels, then
* for each channel the address of its pattern list (#R$7AEE) and its PSG
* volume.
title_music:                                               ; >7ae4
       byte >03                                                      ; 3 channels
       data title_music_patterns                                     ; channel 1: pattern list
       byte >08                                                      ; channel 1: volume
       data title_music_channel_2                                    ; channel 2: pattern list
       byte >08                                                      ; channel 2: volume
       data title_music_channel_3                                    ; channel 3: pattern list
       byte >07                                                      ; channel 3: volume

********************************************************************************
* Title music: pattern lists
* 
* One list per channel: the addresses of the patterns (note data in
* #R$7B18) to play in turn, ending with 0.
title_music_patterns:                                      ; >7aee
       data title_music_pattern_1                                    ; channel 1: pattern 1
       data title_music_pattern_2                                    ; pattern 2
       data title_music_pattern_3                                    ; pattern 3
       data title_music_pattern_4                                    ; pattern 4
       data title_music_pattern_3                                    ; pattern 3
       data title_music_end                                          ; a long rest
       data >0000                                                    ; end of list
title_music_channel_2:                                     ; >7afc
       data title_music_pattern_5                                    ; channel 2: pattern 5
       data title_music_pattern_6                                    ; pattern 6
       data title_music_pattern_7                                    ; pattern 7
       data title_music_pattern_8                                    ; pattern 8
       data title_music_pattern_7                                    ; pattern 7
       data title_music_end                                          ; a long rest
       data >0000                                                    ; end of list
title_music_channel_3:                                     ; >7b0a
       data title_music_pattern_9                                    ; channel 3: pattern 9
       data title_music_pattern_10                                   ; pattern 10
       data title_music_pattern_11                                   ; pattern 11
       data title_music_pattern_12                                   ; pattern 12
       data title_music_pattern_11                                   ; pattern 11
       data title_music_end                                          ; a long rest
       data >0000                                                    ; end of list

