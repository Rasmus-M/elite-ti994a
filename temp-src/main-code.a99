********************************************************************************
* Scratch buffer
* 
* Used for different things at different times: #R$34A8 shifts a character's
* pattern here before printing it; #R$3DF4 and #R$3EAD keep the filled disc's
* ragged edge here ($E600-$E604); and #R$8205 and #R$8F25 use the first few
* bytes too. It is also the start of the vertex cache (#R$E61D).
scratch_buffer:                                            ; >e600
       byte >FA                                                      ; 
scratch_buffer_1:                                          ; >e601
       byte >FF                                                      ; 

********************************************************************************
* "No previous point yet" gate (Bresenham circle-line connector)
* 
* #R$5584 (connect_circle_point) skips drawing a line from the cached
* previous point unless this is set - see its own header.
circle_connector_no_prev_point_gate:                       ; >e602
       byte >02

********************************************************************************
* Reused 16-byte scratch buffer, $E600-$E60F
* 
* Remainder of #R$E600's buffer - see that entry's own comment.
lineplot_scratch_vars_e603:                                ; >e603
       byte >00                                                      ; 
scratch_buffer_4:                                          ; >e604
       byte >FB                                                      ; 
scratch_buffer_5:                                          ; >e605
       byte >FF,>02,>00,>FB,>FF,>FF                                  ; 
       byte >FF,>FD,>FF,>FF,>FF

********************************************************************************
* Unused
* 
* Nothing has been found that uses them, except as part of the vertex cache
* (see #R$E61D).
unused_e610:                                               ; >e610
       byte >FD,>FF,>FE

********************************************************************************
* Nearest system's distance
* 
* The square of the distance to the nearest system found so far by #R$5325 and
* #R$538B, a 24-bit number ($E613-$E615).
nearest_distance:                                          ; >e613
       byte >FF,>FA                                                  ; 
nearest_distance_hi:                                       ; >e615
       byte >FF,>FE                                                  ; 

********************************************************************************
* Furthest system's distance
* 
* The square of the distance to the furthest system found so far by #R$5325, a
* 24-bit number ($E617-$E619).
furthest_distance:                                         ; >e617
       byte >FF,>F8                                                  ; 
furthest_distance_hi:                                      ; >e619
       byte >FF,>00                                                  ; 

********************************************************************************
* System search point
* 
* The point (x, y) #R$5325 and #R$538B measure the distances from.
system_search_point:                                       ; >e61b
       byte >00,>F6

********************************************************************************
* Vertex cache
* 
* The screen positions (two words) of the vertices #R$49FD has projected while
* drawing an object, 4 bytes each, at $E600 + 4 * the vertex number - so the
* cache starts at $E600, sharing its first 29 bytes with the variables at
* #R$E600-#R$E61B, which aren't used while an object is being drawn.
vertex_cache:                                              ; >e61d
       byte >FF,>00,>00,>F6,>FF,>FF,>FF,>F8
       byte >FF,>FF,>FF,>F8,>FF,>FE,>FF,>F5
       byte >FF,>FE,>FF,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
