*********************************************************************
*
* Copy B bytes from address in HL to VDP unrolled.
* r0 is expected to contain VDPWD.
*
copy_bc_bytes_from_hl_to_vdp_unrolled:
       mov  bc,r2
       srl  r2,4
       jeq  copy_bc_bytes_from_hl_to_vdp_unrolled_2
copy_bc_bytes_from_hl_to_vdp_unrolled_1:
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       movb *hl+,*r0
       dec  r2
       jne  copy_bc_bytes_from_hl_to_vdp_unrolled_1
copy_bc_bytes_from_hl_to_vdp_unrolled_2:
       andi bc,>000f
       jeq  copy_bc_bytes_from_hl_to_vdp_unrolled_4
copy_bc_bytes_from_hl_to_vdp_unrolled_3:
       movb *hl+,*r0
       dec  bc
       jne  copy_bc_bytes_from_hl_to_vdp_unrolled_3
copy_bc_bytes_from_hl_to_vdp_unrolled_4:
       rt
copy_bc_bytes_from_hl_to_vdp_unrolled_end:
       equ  $

*********************************************************************
*
* VDP Single Byte Multiple Write
*
* R0: Write address in VDP RAM
* R1: MSB of R1 sent to VDP RAM
* R2: Number of bytes to write to VDP RAM
*
vsmw:
       swpb r0
       movb  r0,@vdpwa                 ; Send low byte of VDP RAM write address
       swpb r0
       ori  r0,>4000                   ; Set read/write bits 14 and 15 to write (01)
       movb r0,@vdpwa                  ; Send high byte of VDP RAM write address
       li   r0,vdpwd
vsmw_1:
       movb r1,*r0                     ; Write byte to VDP RAM
       dec  r2                         ; Byte counter
       jne  vsmw_1
       rt
*// vsmw

