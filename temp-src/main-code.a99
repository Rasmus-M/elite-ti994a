       movb a,@object_speed                                ; LD ($F7E6),A      ; 
       movb a,@death_scene_colours_flag                    ; LD ($E945),A      ; random colours on the first frame
       sb   a,a                                            ; LD A,$00          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 0 for the debris
       movb @bytes+>07,a                                   ; LD A,$07          ; 
       movb a,@ship_type                                   ; LD ($F7E7),A      ; ship type 7 (Platlet)
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 pieces of debris
_1729:                                                     ; >1729
       .push bc                                            ; PUSH BC           ; 
       li   hl,>0000                                       ; LD HL,$0000       ; 
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; 
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; X = Y = 0
       li   hl,>00c8                                       ; LD HL,$00C8       ; 
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; Z = 200
       li   de,nose_vector                                 ; LD DE,$F7DA       ; DE -> one of the orientation vectors
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 word pairs
_173e:                                                     ; >173e
       .call @random_byte                                  ; CALL $2176        ; fill it with random values
       movb a,*de                                          ; LD (DE),A         ; 
       inc  de                                             ; INC DE            ; 
       .call @random_byte                                  ; CALL $2176        ; Random byte -> high half
       andi a,>bf00                                        ; AND $BF           ; Clear bit 6
       movb a,*de                                          ; LD (DE),A         ; 
       inc  de                                             ; INC DE            ; 
       sb   one,b                                          ; DJNZ $173E        ; 
       jne  _173e                                          ;                   
       dec  de                                             ; DEC DE            ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       socb @bit7,*hl                                      ; SET 7,(HL)        ; make the last component negative
       .call @orientation_from_nose                        ; CALL $8E62        ; work out the other axes
       movb @bytes+>fa,a                                   ; LD A,$FA          ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed $FA
       movb @bytes+>03,b                                   ; LD B,$03          ; 
_175a:                                                     ; >175a
       .push bc                                            ; PUSH BC           ; 
       .call @move_object                                  ; CALL $866D        ; move it forward
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $175A        ; 
       jne  _175a                                          ;                   
       li   de,nose_vector_x_hi                            ; LD DE,$F7DB       ; 
       movb @bytes+>03,b                                   ; LD B,$03          ; 
_1766:                                                     ; >1766
       movb *de,a                                          ; LD A,(DE)         ; 
       li   r0,128*256                                     ; XOR $80           ; Flip the sign bit
       xor  r0,a                                           ;                   
       movb a,*de                                          ; LD (DE),A         ; 
       inc  de                                             ; INC DE            ; 
       inc  de                                             ; INC DE            ; 
       sb   one,b                                          ; DJNZ $1766        ; negate the vector
       jne  _1766                                          ;                   
       .call @orientation_from_nose                        ; CALL $8E62        ; work out the other axes again
       .call @add_object                                   ; CALL $3037        ; add the piece to the object table
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $1729        ; next piece
       jne  _1729                                          ;                   
       li   hl,>0000                                       ; LD HL,$0000       ; 
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; 
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; X = Y = 0
       li   hl,>00fa                                       ; LD HL,$00FA       ; 
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; Z = 250
       sb   a,a                                            ; XOR A             ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; 
       movb a,@handler_countdown                           ; LD ($F7EF),A      ; explosion lasts 64 frames
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@per_type_parameter_block                    ; LD ($F7F0),A      ; $F7F0 = $FF (see #R$2556)
       movb one,a                                          ; LD A,$01          ; 
       movb a,@handler_type                                ; LD ($F7EE),A      ; handler type 1: explosion
       movb @bytes+>02,b                                   ; LD B,$02          ; 2 explosions
_179b:                                                     ; >179b
       .push bc                                            ; PUSH BC           ; 
       .call @add_object                                   ; CALL $3037        ; add one to the object table
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; 
       li   de,>ff9c                                       ; LD DE,$FF9C       ; 
       a    de,hl                                          ; ADD HL,DE         ; Z -= 100
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $179B        ; 
       jne  _179b                                          ;                   
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 2 (explosion)
_17b1:                                                     ; >17b1
       .call @clear_space_view                             ; CALL $388F        ; next frame: clear the space view
       li   hl,ship_object_table                           ; LD HL,$EBA0       ; 
       movb @bytes+>06,b                                   ; LD B,$06          ; 6 objects
_17b9:                                                     ; >17b9
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       li   de,object_status_byte                          ; LD DE,$F7CD       ; 
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the object's record to the workspace
       .call @get_blueprint_data                           ; CALL $16E3        ; set it up for its ship type
       .call @work_out_distance                            ; CALL $883D        ; work out its distance
       movb @handler_type,a                                ; LD A,($F7EE)      ; 
       cb   a,one                                          ; CP $01            ; 
       jeq  _17dd                                          ; JR Z,$17DD        ; explosion - skip this
       li   hl,handler_countdown                           ; LD HL,$F7EF       ; 
       ab   one,*hl                                        ; INC (HL)          ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       andi a,>0300                                        ; AND $03           ; 
       jne  _17dd                                          ; JR NZ,$17DD       ; 
       li   hl,object_speed                                ; LD HL,$F7E6       ; 
       sb   one,*hl                                        ; DEC (HL)          ; debris: slow down every 4th frame
_17dd:                                                     ; >17dd
       .call @run_object_handler                           ; CALL $2528        ; run its handler (#R$2556 for the explosions)
       .call @draw_object                                  ; CALL $422E        ; draw it
       .call @move_object                                  ; CALL $866D        ; move it forward
       .pop de                                             ; POP DE            ; DE = this slot's address again
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; 
       li   bc,>0028                                       ; LD BC,$0028       ; 
       .ldir                                               ; LDIR              ; copy the record back
       .ex_de_hl                                           ; EX DE,HL          ; HL -> just past this slot, ready for the next
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $17B9        ; next object
       jne  _17b9                                          ;                   
       li   hl,msg_game_over_1b7d                          ; LD HL,$1B7D       ; 
       .call @show_view_message                            ; CALL $39C8        ; print "Game Over"
       .call @copy_space_view                              ; CALL $3846        ; copy the space view to the screen
       movb @death_scene_colours_flag,a                    ; LD A,($E945)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; CALL NZ,$180B     ; first frame: random colours
       .call @death_scene_colours                          ;                   
!
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = last explosion's status byte
       czc  @bit0,a                                        ; BIT 0,A           ; 
       jne  _17b1                                          ; JR NZ,$17B1       ; still there - next frame
       .ret                                                ; RET               ; Only reached once it clears

********************************************************************************
* Death scene: give the space view random colours
* 
* Used by the routine at #R$1703.
* .
* Called once, on the first frame of the death scene (#R$1703). Fills the
* space view's part of the colour table (from $2128, 14 character rows of
* 176 bytes) with random foreground colours (2-15) on black, using the R
* register as a source of noise.
death_scene_colours:                                       ; >180b
       sb   a,a                                            ; XOR A             ; 
       movb a,@death_scene_colours_flag                    ; LD ($E945),A      ; clear the flag (#R$E945)
       li   hl,>2128                                       ; LD HL,$2128       ; HL = $2128: the colour table at row 1, column 5
       movb @bytes+>0e,@c                                  ; LD C,$0E          ; 14 rows
