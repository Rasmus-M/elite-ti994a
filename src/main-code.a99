       ab   one,*hl                                        ; INC (HL)          ; one more edge skipped
       .pop hl                                             ; POP HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@draw_face_edge_skipped+>0005                ; LD ($4953),A      ; point (IX+d) at the edge's flag (#R$4951+2)
draw_face_edge_skipped:                                    ; >4951
       movb @b255,@>00(ix)                                 ; LD (IX+$00),$FF   ; the edge is skipped
_4955:                                                     ; >4955
       jmp  draw_face_next_edge                            ; JR $4969          ; next edge
draw_face_edges_3:                                         ; >4957
       jgt  draw_face_next_edge                            ; JP P,$4969        ; already drawn - next edge
       jeq  draw_face_next_edge                            ;                   ; 
!
       movb *hl,a                                          ; LD A,(HL)         ; skipped:
       movb a,@draw_face_edge_drawn_2+>0003                ; LD ($4960),A      ; point (IX+d) at the edge's flag (#R$495E+2)
draw_face_edge_drawn_2:                                    ; >495e
       movb one,@>00(ix)                                   ; LD (IX+$00),$01   ; the edge is drawn
       movb @skipped_edges_count,a                         ; LD A,($E6EE)      ; one fewer edge skipped
       sb   one,a                                          ; DEC A             ; 
       movb a,@skipped_edges_count                         ; LD ($E6EE),A      ; 
draw_face_next_edge:                                       ; >4969
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $491C        ; next edge
       jne  _491c                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw an edge
* 
* Used by the routine at #R$491A.
* .
* Projects vertex E (#R$49FD) and, if it's in front of the player, vertex D
* ($49B6), and draws the line between them (#R$3AC2). If vertex E is behind
* the player, draws a line worked out from vertex D alone (#R$4A5C,
* #R$47C4, #R$4B22) instead - or nothing if D is behind the player too.
* .
* At $49B6, with the first vertex projected ($EB92), projects the second
* (#R$49FD): if it's in front of the player, draws the edge ($49EE);
* otherwise clips the edge where it passes the player (#R$4A5C, #R$4B22)
* and draws that.
* .
* At $49EE, stores the second point (BC, HL) and draws the line (#R$3AC2).
* 
* I:D Second vertex
* I:E First vertex
draw_edge:                                                 ; >496d
       .proc
       .push bc                                            ; PUSH BC           ; save the caller's BC
       .push ix                                            ; PUSH IX           ; and IX
       .push de                                            ; PUSH DE           ; save the vertex-index pair for later
       bl   @project_vertex                                ; CALL $49FD        ; project vertex E
       joc  draw_edge_2                                    ; JR C,$49B6        ; valid - go project the second vertex too
       movb de,@line_end_1_x+1                             ; LD ($F769),DE     ; invalid: cache #R$49FD's raw output anyway (unused further here)
       movb @e,@line_end_1_x                               ;                   ;
       movb bc,@line_end_1_y+1                             ; LD ($F76B),BC     ; 
       movb @c,@line_end_1_y                               ;                   ;
       movb hl,@line_end_1_z+1                             ; LD ($F76D),HL     ; 
       movb @l,@line_end_1_z                               ;                   ;
       .exx                                                ; EXX               ; (scratch use of the shadow set)
       movb @e,a                                           ; LD A,E            ; 
       movb a,@draw_edge_clear_flag_e+>0005                ; LD ($4988),A      ; point (IY+d) at vertex E's flag (#R$4986+2)
draw_edge_clear_flag_e:                                    ; >4986
       movb @zero,@>00(iy)                                 ; LD (IY+$00),$00   ; clear the per-vertex cache flag for E
       .pop de                                             ; POP DE            ; DE = the original vertex-index pair
       movb d,a                                            ; LD A,D            ; A = the second vertex's index
       bl   @vertex_relative                               ; CALL $4A5C        ; project it directly (no caching)
       jnc  _49b4                                          ; JR NC,$49B4       ; also invalid - no edge to draw
       movb de,@line_end_2_x+1                             ; LD ($F76F),DE     ; cache the raw projection
       movb @e,@line_end_2_x                               ;                   ;
       movb bc,@line_end_2_y+1                             ; LD ($F771),BC     ; 
       movb @c,@line_end_2_y                               ;                   ;
       movb hl,@line_end_2_z+1                             ; LD ($F773),HL     ; 
       movb @l,@line_end_2_z                               ;                   ;
       bl   @project_point                                 ; CALL $47C4        ; finishing step -> point 1
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; -> point 1's X
       mov  de,@clip_point1_y                              ; LD ($EB94),DE     ; -> point 1's Y
       bl   @clip_line_at_player                           ; CALL $4B22        ; a different finishing step -> point 2
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; -> point 2's X
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; -> point 2's Y
       bl   @clip_and_draw_line                            ; CALL $3AC2        ; clip and draw the substitute edge
_49b4:                                                     ; >49b4
       jmp  _49f9                                          ; JR $49F9          ; join the shared return
draw_edge_2:                                               ; >49b6
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; point 1 = vertex E's projection (BC,HL from #R$49FD)
       mov  hl,@clip_point1_y                              ; LD ($EB94),HL     ; 
       .pop de                                             ; POP DE            ; DE = the original vertex-index pair
       .push de                                            ; PUSH DE           ; (peek, restore it)
       movb d,@e                                           ; LD E,D            ; E = the second vertex's index
       bl   @project_vertex                                ; CALL $49FD        ; project it
       joc  draw_edge_draw_clipped                         ; JR C,$49EE        ; valid - go store it as point 2 and draw
       movb de,@line_end_1_x+1                             ; LD ($F769),DE     ; invalid: cache #R$49FD's raw output anyway
       movb @e,@line_end_1_x                               ;                   ;
       movb bc,@line_end_1_y+1                             ; LD ($F76B),BC     ; 
       movb @c,@line_end_1_y                               ;                   ;
       movb hl,@line_end_1_z+1                             ; LD ($F76D),HL     ; 
       movb @l,@line_end_1_z                               ;                   ;
       .exx                                                ; EXX               ; (scratch use of the shadow set)
       movb @e,a                                           ; LD A,E            ; 
       movb a,@draw_edge_clear_flag_d+>0005                ; LD ($49D7),A      ; point (IY+d) at vertex D's flag (#R$49D5+2)
draw_edge_clear_flag_d:                                    ; >49d5
       movb @zero,@>00(iy)                                 ; LD (IY+$00),$00   ; clear the per-vertex cache flag for D
