********************************************************************************
* Give the object a random orientation
* 
* Used by the routines at #R$2A71, #R$2A94, #R$2D3B and #R$8DB9.
* .
* Gives the object a random nose vector (#R$F7DA, #R$8E51) and works out
* the rest of its orientation from it (#R$8E62). Used for escape
* capsules, Thargons, ships spawned near the player, and cargo and
* platlets, so that they fly off in random directions. Preserves BC.
random_orientation:                                        ; >8e45
       .push bc                                            ; PUSH BC           ; 
       li   de,nose_vector                                 ; LD DE,$F7DA       ; the nose vector
       .call @random_vector                                ; CALL $8E51        ; make it random
       .call @orientation_from_nose                        ; CALL $8E62        ; work out the rest
       .pop bc                                             ; POP BC            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Make a random vector
* 
* Used by the routines at #R$8E45 and #R$8E62.
* .
* Fills the vector at DE with three random sign-magnitude components, each
* less than $4000 (1.0).
* 
* I:DE The vector
random_vector:                                             ; >8e51
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 components
_8e53:                                                     ; >8e53
       .call @random_byte                                  ; CALL $2176        ; low byte
       movb a,*de                                          ; LD (DE),A         ; 
       inc  de                                             ; INC DE            ; 
       .call @random_byte                                  ; CALL $2176        ; 
       andi a,>bf00                                        ; AND $BF           ; high byte: keep the sign, under $4000
       movb a,*de                                          ; LD (DE),A         ; 
       inc  de                                             ; INC DE            ; 
       sb   one,b                                          ; DJNZ $8E53        ; 
       jne  _8e53                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Work out an orientation from the nose vector
* 
* Used by the routines at #R$1703, #R$8D8E and #R$8E45.
* .
* Normalises the nose vector (#R$F7DA, #R$4642). Then picks random
* vectors (#R$8E51) for the roof (#R$F7E0) until one isn't too close to
* the nose's direction - otherwise their cross product would be too small
* to normalise reliably: at $8E74, the dot product of the two (the roof's
* component along the nose) must be between -$3F07 and $3F07 (about
* 0.98).
* .
* At $8EAA, sets the side vector (#R$F7D4) to roof x nose, in
* sign-magnitude form, and normalises it (#R$4642). The random roof is
* only a helper: it isn't normalised or at right angles to the nose, but
* the roof is worked out properly, as nose x side (#R$4599), before the
* object is drawn.
* .
* Used after a random nose (#R$8E45), a nose pointing at the player
* (#R$8D8E), and in the death scene (#R$1703).
orientation_from_nose:                                     ; >8e62
       li   hl,nose_vector                                 ; LD HL,$F7DA       ; 
       .call @normalise_vector                             ; CALL $4642        ; normalise the nose vector
_8e68:                                                     ; >8e68
       li   de,roof_vector                                 ; LD DE,$F7E0       ; the roof vector
       .call @random_vector                                ; CALL $8E51        ; make it random
       li   hl,roof_vector                                 ; LD HL,$F7E0       ; (no effect)
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; HL = nose.x
orientation_check_parallel:                                ; >8e74
       mov  @roof_vector,de                                ; LD DE,($F7E0)     ; DE = roof.x
       .call @multiply_components                          ; CALL $200A        ; nose.x * roof.x
       .push hl                                            ; PUSH HL           ; 
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = nose.y
       mov  @roof_vector_y,de                              ; LD DE,($F7E2)     ; DE = roof.y
       .call @multiply_components                          ; CALL $200A        ; nose.y * roof.y
       .push hl                                            ; PUSH HL           ; 
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; HL = nose.z
       mov  @roof_vector_z,de                              ; LD DE,($F7E4)     ; DE = roof.z
       .call @multiply_components                          ; CALL $200A        ; nose.z * roof.z
       .pop de                                             ; POP DE            ; recover the Y product...
       a    de,hl                                          ; ADD HL,DE         ; ...and sum it with the Z product
       .pop de                                             ; POP DE            ; recover the X product...
       socb a,a                                            ; OR A              ; 
       a    de,hl                                          ; ADC HL,DE         ; HL = the dot product
       jhe  !                                              ; JP M,$8EA2        ; negative
       b    @orientation_check_parallel_2                  ;                   
!
       li   de,>c0f9                                       ; LD DE,$C0F9       ; a negative bias
       a    de,hl                                          ; ADD HL,DE         ; under $3F07?
       jnc  orientation_side                               ; JR NC,$8EAA       ; TODO: check code. yes - fine
       jmp  _8ea8                                          ; JR $8EA8          ; no - try again
orientation_check_parallel_2:                              ; >8ea2
       li   de,>3f07                                       ; LD DE,$3F07       ; 
       a    de,hl                                          ; ADD HL,DE         ; over -$3F07?
       joc  orientation_side                               ; JR C,$8EAA        ; TODO: check code. yes - fine
_8ea8:                                                     ; >8ea8
       jmp  _8e68                                          ; JR $8E68          ; no - try again
orientation_side:                                          ; >8eaa
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; roof.y * nose.z
       mov  @nose_vector_z,de                              ; LD DE,($F7DE)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; roof.z * nose.y
       mov  @nose_vector_y,de                              ; LD DE,($F7DC)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       .pop hl                                             ; POP HL            ; 
       sb   a,a                                            ; XOR A             ; 
       s    de,hl                                          ; SBC HL,DE         ; side.x = the difference
       jlt  !                                              ; JP P,$8ECE        ; positive - keep it
       b    @orientation_side_x                            ;                   
!
       sb   @l,a                                           ; SUB L             ; negative: make it sign-magnitude
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       socb @bytes+>80,a                                   ; OR $80            ; 
       movb a,h                                            ; LD H,A            ; 
orientation_side_x:                                        ; >8ece
       mov  hl,@side_vector                                ; LD ($F7D4),HL     ; side.x
       mov  @roof_vector_z,hl                              ; LD HL,($F7E4)     ; roof.z * nose.x
       mov  @nose_vector,de                                ; LD DE,($F7DA)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; roof.x * nose.z
       mov  @nose_vector_z,de                              ; LD DE,($F7DE)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       .pop hl                                             ; POP HL            ; 
       sb   a,a                                            ; XOR A             ; 
       s    de,hl                                          ; SBC HL,DE         ; side.y
       jlt  !                                              ; JP P,$8EF5        ; positive - keep it
       b    @orientation_side_y                            ;                   
!
       sb   @l,a                                           ; SUB L             ; negative: make it sign-magnitude
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       socb @bytes+>80,a                                   ; OR $80            ; 
       movb a,h                                            ; LD H,A            ; 
orientation_side_y:                                        ; >8ef5
       mov  hl,@side_vector_y                              ; LD ($F7D6),HL     ; side.y
       mov  @roof_vector,hl                                ; LD HL,($F7E0)     ; roof.x * nose.y
       mov  @nose_vector_y,de                              ; LD DE,($F7DC)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @roof_vector_y,hl                              ; LD HL,($F7E2)     ; roof.y * nose.x
       mov  @nose_vector,de                                ; LD DE,($F7DA)     ; 
       .call @multiply_components                          ; CALL $200A        ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       .pop hl                                             ; POP HL            ; 
       sb   a,a                                            ; XOR A             ; 
       s    de,hl                                          ; SBC HL,DE         ; side.z
       jlt  !                                              ; JP P,$8F1C        ; positive - keep it
       b    @orientation_side_z                            ;                   
!
       sb   @l,a                                           ; SUB L             ; negative: make it sign-magnitude
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       socb @bytes+>80,a                                   ; OR $80            ; 
       movb a,h                                            ; LD H,A            ; 
orientation_side_z:                                        ; >8f1c
       mov  hl,@side_vector_z                              ; LD ($F7D8),HL     ; side.z
