unused_sound_effect:                                       ; >79a8
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >03,>0F                                                  ; command 3: volume 15
       byte >08                                                      ; command 8: noise on
       byte >04,>05                                                  ; command 4: countdown 5
       byte >05,>0F                                                  ; command 5: parameter 15
       byte >00,>B9,>79                                              ; command 0: per-frame handler #R$79B9
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Fade out the noise
* 
* The per-frame handler of #R$79A8 and of the second part of sound effect 14
* (#R$79EB): uses the countdown (#R$E897) as the noise period, and every 5
* frames sets the volume to #R$E89B and lowers it by one, ending the effect
* (#R$740C) when it reaches 0.
sound_fade_noise:                                          ; >79b9
       movb @sound_channel_countdown,a                     ; LD A,($E897)      ; 
       movb a,@c                                           ; LD C,A            ; C = the countdown
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       .call @write_psg_register                           ; CALL $751D        ; as the noise period
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       movb @bytes+>05,a                                   ; LD A,$05          ; 
       movb a,@sound_channel_countdown                     ; LD ($E897),A      ; every 5 frames:
       movb @sound_channel_parameter,a                     ; LD A,($E89B)      ; 
       .call @cache_write_channel_data_byte_sound          ; CALL $74EC        ; set the volume to #R$E89B
       li   hl,sound_channel_parameter                     ; LD HL,$E89B       ; 
       sb   one,*hl                                        ; DEC (HL)          ; turn it down
       jne  !                                              ; JP Z,$740C        ; 0 - end the effect (#R$740C)
       b    @end_sound_effect                              ;                   
!
       .ret                                                ; RET               ; 

********************************************************************************
* Sound effect 14
* 
* Started by #R$7468 (entry 14 of the effect table at #R$7AC6). Runs the
* script that follows (#R$753F), which sets #R$79EB as the per-frame handler.
* .
* Nothing plays this effect.
sound_effect_14:                                           ; >79da
       .call @sound_effect_music_command_interpreter_loop  ; CALL $753F        ; run the script that follows
       byte >03,>00                                                  ; command 3: volume 0
       byte >08                                                      ; command 8: noise on
       byte >04,>02                                                  ; command 4: countdown 2
       byte >05,>10                                                  ; command 5: parameter 16
       byte >00,>EB,>79                                              ; command 0: per-frame handler #R$79EB
       byte >07                                                      ; command 7: end of script
       b    @save_active_sound_channel_context_back        ; JP $7505          ; save the channel and return

********************************************************************************
* Sound effect 14: per-frame handler
* 
* Sets noise period 18. Every 2 frames turns the volume (#R$E898) up by one,
* 16 times (#R$E89B), then switches to #R$79B9 to fade it out.
sound_effect_14_handler:                                   ; >79eb
       movb @bytes+>12,@c                                  ; LD C,$12          ; 
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       .call @write_psg_register                           ; CALL $751D        ; noise period 18
       li   hl,sound_channel_countdown                     ; LD HL,$E897       ; 
       sb   one,*hl                                        ; DEC (HL)          ; count down
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@sound_channel_countdown                     ; LD ($E897),A      ; every 2 frames:
       movb @sound_channel_last_data,a                     ; LD A,($E898)      ; 
       .call @cache_write_channel_data_byte_sound          ; CALL $74EC        ; set the volume (#R$74EC)
       li   hl,sound_channel_last_data                     ; LD HL,$E898       ; 
       ab   one,*hl                                        ; INC (HL)          ; and turn it up
       li   hl,sound_channel_parameter                     ; LD HL,$E89B       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       jeq  !                                              ; RET NZ            ; not 16 times yet
       .ret                                                ;                   
!
       movb @bytes+>05,a                                   ; LD A,$05          ; 
       movb a,@sound_channel_countdown                     ; LD ($E897),A      ; 
       movb @bytes+>0f,a                                   ; LD A,$0F          ; 
       movb a,@sound_channel_parameter                     ; LD ($E89B),A      ; 
       li   hl,sound_fade_noise                            ; LD HL,$79B9       ; 
       mov  hl,@sound_channel_data_pointer                 ; LD ($E899),HL     ; then fade out (#R$79B9), every 5 frames from 15
       .ret                                                ; RET               ; 

********************************************************************************
