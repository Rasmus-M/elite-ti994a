       movb a,@docked                                      ; LD ($E90A),A      ; not docked
       .call @switch_to_front_view                         ; CALL $64A1        ; switch to the front view
       movb @bytes+>e4,a                                   ; LD A,$E4          ; 
       movb a,@message_row                                 ; LD ($E92C),A      ; messages at the bottom of the view
       .call @clear_all_ship_slots                         ; CALL $28D4        ; clear the object table
       movb one,a                                          ; LD A,$01          ; 
