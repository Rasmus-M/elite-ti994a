       byte >04,>00,>01,>02,>03

* Title letter E: ship-blueprint header
*
* The letter "E" shown on the title screen (ship type 8, see #R$1F0C). See
* #R$A817 for the blueprint format. 12 vertices and 12 edges, going once
* round the letter's outline. The letters have no name: the name pointer
* points to the vertex array, which reads as "WJJ" (see #R$A7D7). It
* has one face, made of all its edges (#R$C91A).
ship_letter_e_header:                                      ; >c8a0
       data ship_letter_e_vertices
       data ship_letter_e_edges
       data ship_letter_e_faces
       data ship_letter_e_vertices
       byte >01,>0C,>0C,>00,>00,>00,>FF,>00
       byte >0C,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00

