********************************************************************************
* Main loop: the pass run over and over while a game is on
*
* The part of #R$0106 from $010F, reached from the title screen (#R$1C5C) once
* a game has started. Counts the pass (#R$F746), restarts the frame timing
* (#R$F748), and reads the controls and keys (#R$401C).
* .
* TI: polls for VBlank first (interrupts are off). In flight it runs the
* per-frame pass (#R$13FD), and it goes back to the title screen when the game
* is over (#R$F749).
main_loop_wait_tick:                                       ; >010f
       movb @main_loop_tick_counter+1,hl                   ; LD HL,($F746)     ; 
       movb @main_loop_tick_counter,@l                     ;                   ; 
       inc  hl                                             ; INC HL            ; 
       movb hl,@main_loop_tick_counter+1                   ; LD ($F746),HL     ; advance the frame counter
       movb @l,@main_loop_tick_counter                     ;                   ; 
       sb   @vblank_subtick_counter,@vblank_subtick_counter; XOR A / LD ($F748),A; 
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, interrupts are off)
       bl   @read_controls                                 ; CALL $401C        ; 
       movb @docked,a                                      ; LD A,($E90A)      ; docked?
       jne  !                                              ; OR A              ; 
       bl   @process_frame                                 ; CALL Z,$13FD      ; no - run the per-frame pass
!
       movb @game_over,a                                   ; LD A,($F749) / OR A; 
       jeq  main_loop_wait_tick                            ; JR Z,$010F        ; loop until the game is over
       sb   @alert_level,@alert_level                      ; XOR A / LD ($E90C),A; 
       sb   @mission_state,@mission_state                  ; LD ($E93D),A      ; 
       blwp @music_stop_vector                             ; CALL $7438        ; stop the sound
       blwp @sound_stop_vector                             ;                   ; (TI: and the sound effects)
       cb   @game_over_cause,@bytes+>03                    ; LD A,($F74A) / CP $03; 
       jeq  !                                              ; CALL NZ,$1703     ; 
       .far_call code_bank_12_select,death_scene           ;                   ; show the death scene, unless the player quit
!
       sb   @game_over,@game_over                          ; XOR A / LD ($F749),A; clear the game-over flag
       .select_bank code_bank_10_select                    ; JP $010C          ; back to the title screen (in ROM bank 10)
       b    @title_screen                                  ;                   ; 

********************************************************************************
* Market prices
* 
* The goods' prices and availability, as in BBC Elite (QQ23), 5 bytes
* each: the base price; the economic factor (bit 7 its sign, bits 0-4
* its size) and the units (bits 5-6: 0 tonnes, 1 kilograms, 2 grams);
* the base quantity; a mask for the random variation (#R$EFAA); and how
* illegal the goods are. #R$4BA8 works out each system's market from
* them (#R$F789).
market_prices:                                             ; >0a02
       byte >13,>82,>06,>01,>00                                   ; Food
       byte >14,>81,>0A,>03,>00                                   ; Textiles
       byte >41,>83,>02,>07,>00                                   ; Radioactives
       byte >28,>85,>E2,>1F,>04                                   ; Slaves
       byte >53,>85,>FB,>0F,>00                                   ; Liquor/Wines
       byte >C4,>08,>36,>03,>00                                   ; Luxuries
       byte >EB,>1D,>08,>78,>04                                   ; Narcotics
       byte >9A,>0E,>38,>03,>00                                   ; Computers
       byte >75,>06,>28,>07,>00                                   ; Machinery
       byte >4E,>01,>11,>1F,>00                                   ; Alloys
       byte >9C,>0D,>1D,>07,>02                                   ; Firearms
       byte >B0,>89,>DC,>3F,>00                                   ; Furs
       byte >18,>A1,>60,>03,>00                                   ; Minerals
       byte >61,>A1,>42,>07,>00                                   ; Gold
       byte >AB,>A2,>37,>1F,>00                                   ; Platinum
       byte >2D,>C1,>FA,>0F,>00                                   ; Gem-Stones
       byte >35,>0F,>F8,>07,>00                                   ; Alien Items

