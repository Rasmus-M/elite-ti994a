********************************************************************************
* Font: 8x8 character bitmaps for codes $20-$7F
* 
* 96 glyphs of 8 bytes each (one byte per pixel row, top row first, bit
* 7 leftmost), running from $0A9F to $0D9E, directly before the
* commodity name table at #R$0D9F. Most are standard ASCII shapes, but
* codes $5E-$60 hold an up arrow, a pound sign and a copyright sign, and
* codes $7E-$7F a checkerboard and a solid block. No code loads the
* table's address directly.
* .
* On the TI it's in ROM bank 6 (font_bank_select).
font:                                                      ; >0a9f
       byte >00,>00,>00,>00,>00,>00,>00,>00                          ; space
       byte >20,>20,>20,>20,>20,>00,>20,>00                          ; "!"
       byte >50,>50,>50,>00,>00,>00,>00,>00                          ; """
       byte >50,>50,>F8,>50,>F8,>50,>50,>00                          ; "#"
       byte >20,>78,>A0,>70,>28,>F0,>20,>00                          ; "$"
       byte >C0,>C8,>10,>20,>40,>98,>18,>00                          ; "%"
       byte >40,>A0,>A0,>40,>A8,>90,>68,>00                          ; "&"
       byte >20,>20,>20,>00,>00,>00,>00,>00                          ; "'"
       byte >20,>40,>80,>80,>80,>40,>20,>00                          ; "("
       byte >20,>10,>08,>08,>08,>10,>20,>00                          ; ")"
       byte >20,>A8,>70,>20,>70,>A8,>20,>00                          ; "*"
       byte >00,>20,>20,>F8,>20,>20,>00,>00                          ; "+"
       byte >00,>00,>00,>00,>00,>20,>20,>40                          ; ","
       byte >00,>00,>00,>F8,>00,>00,>00,>00                          ; "-"
       byte >00,>00,>00,>00,>00,>10,>00,>00                          ; "."
       byte >00,>08,>10,>20,>40,>80,>00,>00                          ; "/"
       byte >70,>88,>98,>A8,>C8,>88,>70,>00                          ; "0"
       byte >20,>60,>20,>20,>20,>20,>70,>00                          ; "1"
       byte >70,>88,>08,>10,>20,>40,>F8,>00                          ; "2"
       byte >F8,>08,>10,>30,>08,>88,>70,>00                          ; "3"
       byte >10,>30,>50,>90,>F8,>10,>10,>00                          ; "4"
       byte >F8,>80,>F0,>08,>08,>88,>70,>00                          ; "5"
       byte >30,>40,>80,>F0,>88,>88,>70,>00                          ; "6"
       byte >F8,>08,>10,>20,>40,>40,>40,>00                          ; "7"
       byte >70,>88,>88,>70,>88,>88,>70,>00                          ; "8"
       byte >70,>88,>88,>78,>08,>10,>60,>00                          ; "9"
       byte >00,>00,>20,>00,>00,>20,>00,>00                          ; ":"
       byte >00,>00,>20,>00,>00,>20,>20,>40                          ; ";"
       byte >10,>20,>40,>80,>40,>20,>10,>00                          ; "<"
       byte >00,>00,>F8,>00,>F8,>00,>00,>00                          ; "="
       byte >40,>20,>10,>08,>10,>20,>40,>00                          ; ">"
       byte >70,>88,>10,>20,>20,>00,>20,>00                          ; "?"
       byte >70,>88,>A8,>B8,>B0,>80,>78,>00                          ; "@"
       byte >20,>50,>88,>88,>F8,>88,>88,>00                          ; "A"
       byte >F0,>88,>88,>F0,>88,>88,>F0,>00                          ; "B"
       byte >70,>88,>80,>80,>80,>88,>70,>00                          ; "C"
       byte >F0,>88,>88,>88,>88,>88,>F0,>00                          ; "D"
       byte >F8,>80,>80,>F0,>80,>80,>F8,>00                          ; "E"
       byte >F8,>80,>80,>F0,>80,>80,>80,>00                          ; "F"
       byte >78,>80,>80,>80,>98,>88,>78,>00                          ; "G"
       byte >88,>88,>88,>F8,>88,>88,>88,>00                          ; "H"
       byte >70,>20,>20,>20,>20,>20,>70,>00                          ; "I"
       byte >08,>08,>08,>08,>08,>88,>70,>00                          ; "J"
       byte >88,>90,>A0,>C0,>A0,>90,>88,>00                          ; "K"
       byte >80,>80,>80,>80,>80,>80,>F8,>00                          ; "L"
       byte >88,>D8,>A8,>A8,>88,>88,>88,>00                          ; "M"
       byte >88,>88,>C8,>A8,>98,>88,>88,>00                          ; "N"
       byte >70,>88,>88,>88,>88,>88,>70,>00                          ; "O"
       byte >F0,>88,>88,>F0,>80,>80,>80,>00                          ; "P"
       byte >70,>88,>88,>88,>A8,>90,>68,>00                          ; "Q"
       byte >F0,>88,>88,>F0,>A0,>90,>88,>00                          ; "R"
       byte >70,>88,>80,>70,>08,>88,>70,>00                          ; "S"
       byte >F8,>20,>20,>20,>20,>20,>20,>00                          ; "T"
       byte >88,>88,>88,>88,>88,>88,>70,>00                          ; "U"
       byte >88,>88,>88,>88,>88,>50,>20,>00                          ; "V"
       byte >88,>88,>88,>A8,>A8,>D8,>88,>00                          ; "W"
       byte >88,>88,>50,>20,>50,>88,>88,>00                          ; "X"
       byte >88,>88,>50,>20,>20,>20,>20,>00                          ; "Y"
       byte >F8,>08,>10,>20,>40,>80,>F8,>00                          ; "Z"
       byte >78,>40,>40,>40,>40,>40,>78,>00                          ; "["
       byte >00,>80,>40,>20,>10,>08,>00,>00                          ; "\"
       byte >F0,>10,>10,>10,>10,>10,>F0,>00                          ; "]"
       byte >20,>50,>A8,>20,>20,>20,>20,>00                          ; up arrow (in place of "^")
       byte >38,>40,>40,>40,>F0,>40,>F8,>00                          ; pound sign (in place of "_")
       byte >30,>48,>B4,>A4,>A4,>B4,>48,>30                          ; copyright sign (in place of "`")
       byte >00,>00,>70,>08,>78,>88,>78,>00                          ; "a"
       byte >80,>80,>F0,>88,>88,>88,>F0,>00                          ; "b"
       byte >00,>00,>78,>80,>80,>80,>78,>00                          ; "c"
       byte >08,>08,>78,>88,>88,>88,>78,>00                          ; "d"
       byte >00,>00,>70,>88,>F8,>80,>78,>00                          ; "e"
       byte >30,>48,>40,>F0,>40,>40,>40,>00                          ; "f"
       byte >00,>00,>70,>88,>88,>78,>08,>70                          ; "g"
       byte >80,>80,>F0,>88,>88,>88,>88,>00                          ; "h"
       byte >20,>00,>60,>20,>20,>20,>70,>00                          ; "i"
       byte >10,>00,>30,>10,>10,>10,>90,>60                          ; "j"
       byte >80,>80,>88,>90,>E0,>90,>88,>00                          ; "k"
       byte >60,>20,>20,>20,>20,>20,>70,>00                          ; "l"
       byte >00,>00,>D8,>A8,>A8,>A8,>88,>00                          ; "m"
       byte >00,>00,>F0,>88,>88,>88,>88,>00                          ; "n"
       byte >00,>00,>70,>88,>88,>88,>70,>00                          ; "o"
       byte >00,>00,>F0,>88,>88,>F0,>80,>80                          ; "p"
       byte >00,>00,>78,>88,>88,>78,>08,>08                          ; "q"
       byte >00,>00,>B8,>C0,>80,>80,>80,>00                          ; "r"
       byte >00,>00,>78,>80,>70,>08,>F0,>00                          ; "s"
       byte >40,>40,>F0,>40,>40,>48,>30,>00                          ; "t"
       byte >00,>00,>88,>88,>88,>98,>68,>00                          ; "u"
       byte >00,>00,>88,>88,>88,>50,>20,>00                          ; "v"
       byte >00,>00,>88,>88,>A8,>A8,>D8,>00                          ; "w"
       byte >00,>00,>88,>50,>20,>50,>88,>00                          ; "x"
       byte >00,>00,>88,>88,>88,>78,>08,>70                          ; "y"
       byte >00,>00,>F8,>10,>20,>40,>F8,>00                          ; "z"
       byte >38,>60,>60,>C0,>60,>60,>38,>00                          ; "{"
       byte >20,>20,>20,>20,>20,>20,>20,>20                          ; "|"
       byte >E0,>30,>30,>18,>30,>30,>E0,>00                          ; "}"
       byte >A8,>54,>A8,>54,>A8,>54,>A8,>54                          ; checkerboard (in place of "~")
       byte >FC,>FC,>FC,>FC,>FC,>FC,>FC,>00                          ; solid block
