       byte >00                                                      ; $06: Thargon
       byte >00                                                      ; $07: Platlet
       byte >00                                                      ; $08: letter E (title screen)
       byte >00                                                      ; $09: letter L (title screen)
       byte >00                                                      ; $0A: letter I (title screen)
       byte >00                                                      ; $0B: letter T (title screen)
num_vipers:                                                ; >e850
       byte >00                                                      ; $0C: Viper
       byte >00                                                      ; $0D: Fer-De-Lance
       byte >00                                                      ; $0E: Cobra MkIII
