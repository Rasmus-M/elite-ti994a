* centred on, stored by #R$502C; used by #R$4F09 and #R$4F37.
local_chart_centre:                                        ; >e830
       byte >00                                                      ; 
local_chart_centre_y:                                      ; >e831
       byte >00                                                      ; 

********************************************************************************
* Count of nearby systems found by #R$502C
* 
* Set by #R$502C (`LD ($E832),A` at $50A6): the number of systems it
* found nearby, read back by #R$50B1/$53AA to index/iterate that list.
nearby_systems_count:                                      ; >e832
       byte >00

********************************************************************************
* Local chart: width of a label
* 
* In character cells: the width of the system's name in 6-pixel
* characters, rounded up (#R$4FA5). #R$50CE colours this many cells.
chart_label_width:                                         ; >e833
       byte >00

********************************************************************************
* Local chart: width of a label in pixels, minus 1
* 
* Set by #R$4FA5, and used by #R$512F to keep the label on the chart.
chart_label_width_limit:                                   ; >e834
       byte >00

********************************************************************************
* Local chart: half the width of a label
* 
* In pixels, set by #R$4FA5: #R$512F places labels at percentages of it
* from the system.
ring_position_scale_limit:                                 ; >e835
       byte >00

********************************************************************************
* Local chart: column of a label
* 
* Set by #R$512F; the low byte of the label's position (with #R$E837),
* read by #R$50CE.
chart_label_settled_column:                                ; >e836
       byte >00

********************************************************************************
* Local chart: row of a label
* 
* Set by #R$512F (see #R$E836).
chart_label_settled_row:                                   ; >e837
       byte >00

********************************************************************************
* Local chart: direction of a label (x)
* 
* $00 to place the label to the right of the system, $FF to the left;
* flipped by #R$50CE after all 9 positions have been tried (see #R$512F).
ring_position_bit_state_1:                                 ; >e838
       byte >00

********************************************************************************
* Local chart: direction of a label (y)
* 
* $00 to place the label below the system, $FF above; flipped by #R$50CE
* when #R$E838 comes back round to $00.
ring_position_bit_state_2:                                 ; >e839
       byte >00

********************************************************************************
* Local chart: label position being tried
* 
* 0-8: which of the 9 positions from the tables at $56BD and $56C6
* #R$512F tries (#R$50CE).
ring_position_attempt_counter:                             ; >e83a
       byte >00

********************************************************************************
* Local chart: colour of a label
* 
* The system's government + 2, on black (#R$4FA5): the colour #R$50CE
* gives the label's cells.
chart_label_fill_pattern:                                  ; >e83b
       byte >00

********************************************************************************
* Chosen/displayed system index (star chart)
* 
* See #R$4F87's own code (`LD ($E83C),A`): the system index chosen by
* #R$4F64's mode dispatch, read back throughout the chart-drawing flow.
chart_chosen_system_index:                                 ; >e83c
       byte >00

********************************************************************************
* Furthest system
* 
* The system furthest from the point #R$5325 was given.
furthest_system:                                           ; >e83d
       byte >00

********************************************************************************
* Expanding selection box: "which sides still animating" flag (4 bits)
* 
* See #R$541E's own header: all 4 bits set initially, each cleared as
