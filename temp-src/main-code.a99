* I:HL Dividend
* I:A Divisor
* O:HL Quotient
divide_hl_a:                                               ; >2079
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; DE = the divisor
       movb @l,@c                                          ; LD C,L            ; 
       movb h,a                                            ; LD A,H            ; A:C = the dividend
       movb d,h                                            ; LD H,D            ; 
       movb d,@l                                           ; LD L,D            ; HL = 0, the remainder
       movb @bytes+>10,b                                   ; LD B,$10          ; 16 bits
_2082:                                                     ; >2082
       ; CCF                                               ; CCF               ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. shift the next quotient bit in (complemented)...
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; ...and the next dividend bit into the remainder
       s    de,hl                                          ; SBC HL,DE         ; subtract the divisor
       jnc  _208d                                          ; JR NC,$208D       ; TODO: check code. it fits
       a    de,hl                                          ; ADD HL,DE         ; it doesn't: add it back
_208d:                                                     ; >208d
       sb   one,b                                          ; DJNZ $2082        ; 
       jne  _2082                                          ;                   
       ; CCF                                               ; CCF               ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       movb @c,@l                                          ; LD L,C            ; 
       movb a,h                                            ; LD H,A            ; HL = the quotient
       .ret                                                ; RET               ; 

********************************************************************************
* Divide HL by DE (signed)
* 
* Nothing calls this. Returns HL / DE, with HL signed and DE positive: the
* absolute value of HL (at $20A2 if it's positive) is divided by DE, a
* restoring division like #R$20C6's, and the quotient is negated if HL was
* negative.
* 
* I:HL Dividend
* I:DE Divisor
* O:HL Quotient
divide_signed:                                             ; >2096
       czc  @bit7,h                                        ; BIT 7,H           ; is HL negative?
       .push af                                            ; PUSH AF           ; save the sign
       jeq  abs_hl_into_ca_then_divide                     ; JR Z,$20A2        ; no
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; yes: A:C = -HL
       jmp  _20a4                                          ; JR $20A4          ; 
abs_hl_into_ca_then_divide:                                ; >20a2
       movb @l,@c                                          ; LD C,L            ; C = HL's low byte (HL is already non-negative here)
       movb h,a                                            ; LD A,H            ; A = HL's high byte - C:A now holds |HL|
_20a4:                                                     ; >20a4
       li   hl,>0000                                       ; LD HL,$0000       ; HL = 0 (the running remainder/quotient)
       movb @bytes+>10,b                                   ; LD B,$10          ; 16 iterations
_20a9:                                                     ; >20a9
       ; RL C                                              ; RL C              ; TODO: check code. shift the next dividend bit in...
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADC HL,HL         ; 
       s    de,hl                                          ; SBC HL,DE         ; trial-subtract the divisor
       jnc  _20b3                                          ; JR NC,$20B3       ; TODO: check code. it fit - keep the subtraction
       a    de,hl                                          ; ADD HL,DE         ; it didn't - restore
_20b3:                                                     ; >20b3
       sb   one,b                                          ; DJNZ $20A9        ; 
       jne  _20a9                                          ;                   
       ; RL C                                              ; RL C              ; TODO: check code. shift the last bit of the quotient in
       sla  a,1                                            ; RLA               ; TODO: check code. 
       inv  a                                              ; CPL               ; 
       movb a,h                                            ; LD H,A            ; 
       movb @c,a                                           ; LD A,C            ; 
       inv  a                                              ; CPL               ; 
       movb a,@l                                           ; LD L,A            ; HL = the quotient (its bits came in complemented)
       .pop af                                             ; POP AF            ; 
       jne  !                                              ; RET Z             ; HL was positive - done
       .ret                                                ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate the quotient
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Divide: 24-bit / 10, extracting one decimal digit
* 
* Used by the routines at #R$3675 and #R$5E6B.
* .
* Same shift-subtract-restore shape as #R$2079's 16-bit divide, but
