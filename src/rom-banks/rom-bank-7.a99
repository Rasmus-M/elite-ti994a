********************************************************************************
* Y/N confirmation prompt: print " ? ", wait for Esc/Y/N
* 
* Used by the routines at #R$5CEE, #R$909F, #R$9120 and #R$A41B.
* .
* Prints " ? " (#R$382C), then loops on #R$35E7 until the key pressed is
* Esc, 'Y' or 'N'. Esc returns with carry as #R$35E7 leaves it; 'Y' or 'N'
* (at $3829) is printed, and returns with carry set.
* 
* O:A The key pressed ($1B/'Y'/'N')
* O:carry Set for 'Y'/'N', per #R$35E7 for Esc
confirm_prompt_yn:                                         ; >3815
       .proc                                               ;                   ; 
       li   hl,msg_382c                                    ; LD HL,$382C       ; the " ? " message
       bl   @rst_08_target_print_tokenised_string          ; RST $08           ; print it
_3819:                                                     ; >3819
       bl   @wait_for_keypress_blinking_cursor             ; CALL $35E7        ; A = the next key (blocks until one is available)
       cb   a,@bytes+>1b                                   ; CP $1B            ; Esc?
       jeq  _3815_esc                                      ; RET Z             ; yes - return as-is
       cb   a,@bytes+>59                                   ; CP $59            ; 'Y'?
       jeq  continue_3815_echo_confirm                     ; JR Z,$3829        ; yes - confirm
       cb   a,@bytes+>4e                                   ; CP $4E            ; 'N'?
       jne  _3819                                          ; JR Z,$3829        ; neither - keep waiting
continue_3815_echo_confirm:                                ; >3829
       bl   @print_char                                    ; RST $00           ; echo the key just pressed (still in A)
       .retc                                               ; SCF / RET         ; carry set = confirmed (Y or N, not Esc)
_3815_esc:                                                 
       .retnc                                              ;                   ; carry clear = Esc

