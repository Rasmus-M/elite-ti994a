********************************************************************************
* Empty entries, #R$0E91's word-select table
* 
* Each lone $80 byte is an empty tokenised string (RST $08 prints nothing
* before reaching its bit-7-set terminator). #R$60F8 selects
* index (($F750)>>2)&7 from this table via RST $10; only 3 of the 8
* possible indices have real words ("Large "/"Fierce "/"Small ", at
* #R$0E91/#R$0E97/#R$0E9E) - these 5 bytes are the other 5 (indices
* 3-7), each printing as nothing.
size_word_table_empty_slots:                               ; >0ea4
       byte >80,>80,>80,>80,>80

