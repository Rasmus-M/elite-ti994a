_8355:                                                     ; >8355
       movb *hl,@e                                         ; LD E,(HL)         ; DE = link to the previous record
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       .push de                                            ; PUSH DE           ; Save the link for the end of this pass
       movb *hl,@e                                         ; LD E,(HL)         ; DE = VRAM address
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = run height, bit 7 = two columns
       inc  hl                                             ; INC HL            ; 
       .push af                                            ; PUSH AF           ; 
       andi a,>7f00                                        ; AND $7F           ; 
       movb a,b                                            ; LD B,A            ; B = run height
       .ex_de_hl                                           ; EX DE,HL          ; HL = VRAM address, DE -> saved bytes
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       sb   a,a                                            ; XOR A             ; no mask
       .call @or_vram_block                                ; CALL $854B        ; restore the first column
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$837A        ; one column only
       b    @scanner_erase_one_column                      ;                   
!
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; next column to the right
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; XOR A             ; 
       .call @or_vram_block                                ; CALL $854B        ; restore the second column
scanner_erase_one_column:                                  ; >837a
       .pop hl                                             ; POP HL            ; HL = link
       movb h,a                                            ; LD A,H            ; 
       socb @l,a                                           ; OR L              ; 
       jne  _8355                                          ; JR NZ,$8355       ; loop until the end of the list
       .ret                                                ; RET               ; 

********************************************************************************
* Scanner: draw this frame's blips and sticks
* 
* Used by the routine at #R$7202.
* .
* Called by the VBlank interrupt handler (#R$7202, at $727D) once #R$13FD
* has set ($EB02) to say the frame's scanner queue is complete. First
* erases last frame's blips (#R$834D). Then, for each record in the scanner
* queue at #R$E94A (see #R$82A0 for the format): unpacks it into
* $E760-$E769, saves the VRAM bytes about to be drawn over (#R$8528; one or
* two columns, blip height + stick length rows) in a new record in the list
* at #R$E9D6 for #R$834D to restore next frame, and then ORs the blip and
* stick into VRAM: blip first then stick for an object above the ship,
* stick first then blip ($843C) for one below.
* 
* I:$E948 Number of records in the queue
scanner_draw:                                              ; >8380
       .call @scanner_erase                                ; CALL $834D        ; erase last frame's blips
       movb @scanner_queue_count,a                         ; LD A,($E948)      ; 
       movb a,@scanner_drawn_count                         ; LD ($E949),A      ; remember how many are drawn, for #R$834D
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$845C        ; nothing to draw
       b    @scanner_draw_done                             ;                   
!
       li   hl,>0000                                       ; LD HL,$0000       ; 
       mov  hl,@scanner_saved_last                         ; LD ($E75E),HL     ; first saved-background record's link = 0
       li   hl,scanner_queue                               ; LD HL,$E94A       ; HL -> the scanner queue
       li   de,shared_blit_or_goatsoup_buffer              ; LD DE,$E9D6       ; DE -> the saved-background list
       movb a,b                                            ; LD B,A            ; B = number of records
scanner_draw_record:                                       ; >839a
       mov  de,@scanner_saved_first                        ; LD ($E75C),DE     ; this record becomes the head of the list
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       .push de                                            ; PUSH DE           ; 
       li   hl,scanner_saved_last                          ; LD HL,$E75E       ; 
       .ldi                                                ; LDI               ; link to the previous record
       .ldi                                                ; LDI               ; record's 2-byte link
       .pop bc                                             ; POP BC            ; 
       mov  bc,@scanner_saved_last                         ; LD ($E75E),BC     ; remember this record for the next one's link
       .pop hl                                             ; POP HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,*de                                          ; LD (DE),A         ; copy the VRAM address low byte
       movb a,@scanner_vram_addr                           ; LD ($E760),A      ; 
       inc  hl                                             ; INC HL            ; 
       inc  de                                             ; INC DE            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@scanner_below_flag                          ; LD ($E762),A      ; $E762 = address high byte, bit 7 = object below
       andi a,>7f00                                        ; AND $7F           ; 
       movb a,*de                                          ; LD (DE),A         ; copy it without bit 7
       inc  hl                                             ; INC HL            ; 
       inc  de                                             ; INC DE            ; 
       movb a,@scanner_vram_addr_hi                        ; LD ($E761),A      ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@c                                           ; LD C,A            ; 
       andi a,>8000                                        ; AND $80           ; 
       movb a,@scanner_two_columns                         ; LD ($E763),A      ; $E763 = bit 7: two columns
       movb @c,a                                           ; LD A,C            ; 
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sla  a,1                                            ; RLCA              ; TODO: check code. C's top 2 bits, rotated down...
       andi a,>0300                                        ; AND $03           ; 
       movb a,@scanner_heights                             ; LD ($E764),A      ; $E764 = blip height
       movb a,b                                            ; LD B,A            ; 
       movb @c,a                                           ; LD A,C            ; 
       andi a,>1f00                                        ; AND $1F           ; C's low 5 bits...
       movb a,@scanner_stick_length                        ; LD ($E765),A      ; $E765 = stick length
       ab   b,a                                            ; ADD A,B           ; 
       movb a,b                                            ; LD B,A            ; B = run height
       .ex_af_af_                                          ; EX AF,AF'         ; Stash it in the alternate set
       movb @scanner_two_columns,a                         ; LD A,($E763)      ; 
       socb b,a                                            ; OR B              ; 
       movb a,*de                                          ; LD (DE),A         ; save the height and two-column flag
       inc  de                                             ; INC DE            ; 
       mov  de,@scanner_background_save_address            ; LD ($E76A),DE     ; where to save the background (#R$E76A)
       li   de,scanner_masks_copy                          ; LD DE,$E766       ; 
       .ldi                                                ; LDI               ; copy the 4 masks to $E766-$E769
       .ldi                                                ; LDI               ; (fixed OR-mask bytes for the immediate edge writes
       .ldi                                                ; LDI               ; below)
       .ldi                                                ; LDI               ; 
       .ex_af_af_                                          ; EX AF,AF'         ; Recover the earlier count sum...
       movb a,b                                            ; LD B,A            ; 
       .ex_af_af_                                          ; EX AF,AF'         ; ...as the byte count for the VRAM read below
       .push hl                                            ; PUSH HL           ; 
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760)     ; 
       mov  @scanner_background_save_address,de            ; LD DE,($E76A)     ; 
       .call @read_vram_block                              ; CALL $8528        ; save the first column's background
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb a,b                                            ; LD B,A            ; 
       movb @scanner_two_columns,a                         ; LD A,($E763)      ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$8412        ; one column
       b    @scanner_draw_one_column                       ;                   
!
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760)     ; 
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; 
       movb a,@l                                           ; LD L,A            ; 
       .call @read_vram_block                              ; CALL $8528        ; save the second column's background
scanner_draw_one_column:                                   ; >8412
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760)     ; 
       mov  @scanner_background_save_address,de            ; LD DE,($E76A)     ; 
       movb @scanner_below_flag,a                          ; LD A,($E762)      ; 
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$843C        ; object below - stick first
       b    @scanner_draw_below                            ;                   
!
       .call @scanner_or_blip_1                            ; CALL $845D        ; OR the blip into the first column
       .call @scanner_or_stick_1                           ; CALL $8469        ; then the stick
       movb @scanner_two_columns,a                         ; LD A,($E763)      ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$843A        ; one column
       b    @scanner_draw_above_done                       ;                   
!
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760)     ; 
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; 
       movb a,@l                                           ; LD L,A            ; 
       .call @scanner_or_blip_2                            ; CALL $8475        ; OR the blip into the second column
       .call @scanner_or_stick_2                           ; CALL $8481        ; then the stick
scanner_draw_above_done:                                   ; >843a
       jmp  scanner_draw_next                              ; JR $8456          ; 
scanner_draw_below:                                        ; >843c
       .call @scanner_or_stick_1                           ; CALL $8469        ; OR the stick into the first column
       .call @scanner_or_blip_1                            ; CALL $845D        ; then the blip
       movb @scanner_two_columns,a                         ; LD A,($E763)      ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$8456        ; 
       b    @scanner_draw_next                             ;                   
!
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760)     ; 
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; 
       movb a,@l                                           ; LD L,A            ; 
       .call @scanner_or_stick_2                           ; CALL $8481        ; stick, second column
       .call @scanner_or_blip_2                            ; CALL $8475        ; then the blip
scanner_draw_next:                                         ; >8456
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DEC B             ; 
       jeq  !                                              ; JP NZ,$839A       ; next record
       b    @scanner_draw_record                           ;                   
!
scanner_draw_done:                                         ; >845c
       .ret                                                ; RET               ; 

********************************************************************************
* Scanner: OR a blip into VRAM (first column)
* 
* Used by the routine at #R$8380.
* .
* Writes ($E764) rows downwards from HL, each the saved background byte
* at DE ORed with the mask at $E767 (#R$854B). Does nothing if the
* blip height is 0.
* 
* I:DE Pointer to the saved background bytes
* I:HL VRAM address
scanner_or_blip_1:                                         ; >845d
       movb @scanner_heights,a                             ; LD A,($E764)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; 
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; 
       movb @scanner_mask_blip_1,a                         ; LD A,($E767)      ; 
       b    @or_vram_block                                 ; JP $854B          ; 

********************************************************************************
* Scanner: OR a stick into VRAM (first column)
* 
* Used by the routine at #R$8380.
* .
* Writes ($E765) rows downwards from HL, each the saved background byte
* at DE ORed with the mask at $E769 (#R$854B). Does nothing if the
* stick length is 0.
* 
* I:DE Pointer to the saved background bytes
* I:HL VRAM address
scanner_or_stick_1:                                        ; >8469
       movb @scanner_stick_length,a                        ; LD A,($E765)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; 
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; 
       movb @scanner_mask_stick_1,a                        ; LD A,($E769)      ; 
       b    @or_vram_block                                 ; JP $854B          ; 

********************************************************************************
* Scanner: OR a blip into VRAM (second column)
* 
* Used by the routine at #R$8380.
* .
* Writes ($E764) rows downwards from HL, each the saved background byte
* at DE ORed with the mask at $E766 (#R$854B). Does nothing if the
* blip height is 0.
* 
* I:DE Pointer to the saved background bytes
* I:HL VRAM address
scanner_or_blip_2:                                         ; >8475
       movb @scanner_heights,a                             ; LD A,($E764)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; 
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; 
       movb @scanner_masks_copy,a                          ; LD A,($E766)      ; 
       b    @or_vram_block                                 ; JP $854B          ; 

********************************************************************************
* Scanner: OR a stick into VRAM (second column)
* 
* Used by the routine at #R$8380.
* .
* Writes ($E765) rows downwards from HL, each the saved background byte
* at DE ORed with the mask at $E768 (#R$854B). Does nothing if the
* stick length is 0.
* 
* I:DE Pointer to the saved background bytes
* I:HL VRAM address
scanner_or_stick_2:                                        ; >8481
       movb @scanner_stick_length,a                        ; LD A,($E765)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; 
       .ret                                                ;                   
!
       movb a,b                                            ; LD B,A            ; 
       movb @scanner_mask_stick_2,a                        ; LD A,($E768)      ; 
       b    @or_vram_block                                 ; JP $854B          ; 

********************************************************************************
* Scale an unsigned magnitude by a fixed-point factor, then apply a sign
* 
* Used by the routine at #R$8205.
* .
* Computes a signed 8-bit result = +/-((HL * C) >> 12), where the sign
* comes from the caller's A rather than from HL or C, which are both
* treated as unsigned. Multiplies via #R$1F86 to get a 24-bit product in
* A:HL, then rotates the top two bytes (A:H) left by 4 bits at a time
* (through L, which is otherwise untouched) to bring product bits 12-19
* down into A - equivalent to product >> 12, keeping only the low 8 bits
* of that shifted result. C is therefore a scale factor out of 4096.
* 
* I:A Sign of the result (only the sign bit matters)
* I:HL Unsigned 16-bit magnitude to scale
* I:C Fixed-point scale factor, numerator over 4096
* O:A Signed result; not clamped if the shifted magnitude exceeds 127
scale_signed_coordinate:                                   ; >848d
       .ex_af_af_                                          ; EX AF,AF'         ; Stash the caller's sign byte
       movb @c,a                                           ; LD A,C            ; 
       .call @multiply_16x8                                ; CALL $1F86        ; A:HL = HL * C (24-bit product)
       sla  h,1                                            ; RL H              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. A:H rotated left 4 - A now holds (product >> 12) & $FF
       movb a,@l                                           ; LD L,A            ; 
       .ex_af_af_                                          ; EX AF,AF'         ; Recover the caller's sign byte
       socb a,a                                            ; OR A              ; 
       movb @l,a                                           ; LD A,L            ; 
       jlt  !                                              ; RET P             ; Positive sign - return the magnitude as-is
       .ret                                                ;                   
!
       neg a                                               ; NEG               ; Negative sign - negate it
       .ret                                                ; RET               ; 

********************************************************************************
* Length of a vector
* 
* Used by the routines at #R$2DF1, #R$3113 and #R$883D.
* .
* Returns roughly sqrt(X^2 + Y^2 + Z^2) for the vector at $EB82/$EB84/$EB86
* (an object's distances from a reference point along each axis), to
* within about 2% (slightly low) - the distance to the object. Works
* with logarithms: shifts the components down together so that the
* biggest fits in a byte (the shift count, from the bit-length table at
* #R$0200, goes in ($EB9B)), squares each (#R$8515) and adds the squares;
* then takes the log of the sum (#R$0800), halves it - a square root -
* adds back the shift, and converts it back (#R$21A3). The shifted-down
* components are also left in $EF92-$EF94.
* 
* I:$EB82-$EB87 The vector's components (magnitudes)
* O:HL Its length
vector_length:                                             ; >84a6
       movb @delta_x_hi,a                                  ; LD A,($EB83)      ; combine the three components' high bytes
       li   hl,delta_y_hi                                  ; LD HL,$EB85       ; HL -> value 2's high byte
       socb *hl,a                                          ; OR (HL)           ; A |= it
       li   hl,delta_z_hi                                  ; LD HL,$EB87       ; HL -> value 3's high byte
       socb *hl,a                                          ; OR (HL)           ; 
       jeq  _84b7                                          ; JR Z,$84B7        ; all under 256 - no shift
       movb a,@l                                           ; LD L,A            ; else: L = the combined OR
       movb @bytes+>02,h                                   ; LD H,$02          ; HL -> the $0200 bit-length table
       movb *hl,a                                          ; LD A,(HL)         ; A = shift needed to fit the biggest in a byte
_84b7:                                                     ; >84b7
       movb a,@depth_shift                                 ; LD ($EB9B),A      ; 
       mov  @abs_delta_x,hl                                ; LD HL,($EB82)     ; HL = value 1
       .call @vector_length_square                         ; CALL $8515        ; square X (shifted down)
       movb a,@ef92_scaled_magnitude_1                     ; LD ($EF92),A      ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @abs_delta_y,hl                                ; LD HL,($EB84)     ; HL = value 2
       .call @vector_length_square                         ; CALL $8515        ; square Y
       movb a,@ef93_scaled_magnitude_2                     ; LD ($EF93),A      ; cache #R$8515's A result
       .push hl                                            ; PUSH HL           ; save the scaled value 2
       mov  @abs_delta_z,hl                                ; LD HL,($EB86)     ; HL = value 3
       .call @vector_length_square                         ; CALL $8515        ; square Z
       movb a,@ef94_scaled_magnitude_3                     ; LD ($EF94),A      ; cache #R$8515's A result
       sb   a,a                                            ; XOR A             ; 
       movb a,b                                            ; LD B,A            ; B = 0 (used to extend the carry into A below)
       .pop de                                             ; POP DE            ; DE = scaled value 2
       a    de,hl                                          ; ADD HL,DE         ; add the squares...
       ab   b,a                                            ; ADC A,B           ; extend the carry into A (24-bit sum so far)
       .pop de                                             ; POP DE            ; DE = scaled value 1
       a    de,hl                                          ; ADD HL,DE         ; 
       .ex_de_hl                                           ; EX DE,HL          ; DE = the 16-bit sum; HL = the old DE (value 1, recovered for free)
       ab   b,a                                            ; ADC A,B           ; ...into A:DE
       jeq  _84e6                                          ; JR Z,$84E6        ; under 65536
       movb d,@e                                           ; LD E,D            ; too big: divide by 256...
       movb a,d                                            ; LD D,A            ; D = A (the overflow byte becomes the new high byte)
       movb @bytes+>08,a                                   ; LD A,$08          ; ...remembering the 8-bit shift
_84e6:                                                     ; >84e6
       movb a,@c                                           ; LD C,A            ; C = that shift (0 or 8)
       movb d,a                                            ; LD A,D            ; A = the (possibly rescaled) sum's high byte
       socb a,a                                            ; OR A              ; test it
       jeq  _84f5                                          ; JR Z,$84F5        ; sum under 256
       movb a,@l                                           ; LD L,A            ; else: L = that high byte
       movb @bytes+>02,h                                   ; LD H,$02          ; HL -> the $0200 bit-length table
       movb *hl,b                                          ; LD B,(HL)         ; B = shift to fit the sum in a byte
_84ef:                                                     ; >84ef
       srl  a,1                                            ; RRA               ; TODO: check code. shift A (still the sum's high byte) right...
       ; RR E                                              ; RR E              ; TODO: check code. ...and E right too, chaining the carry - D:E shifts right as a pair
       sb   one,b                                          ; DJNZ $84EF        ; shift it down
       jne  _84ef                                          ;                   
       movb *hl,a                                          ; LD A,(HL)         ; A = that shift
_84f5:                                                     ; >84f5
       ab   @c,a                                           ; ADD A,C           ; plus the 8-bit shift
       ab   a,a                                            ; ADD A,A           ; A *= 2
       ab   a,a                                            ; ADD A,A           ; times 4 (1024 per bit in the log, in H)
       .ex_af_af_                                          ; EX AF,AF'         ; 
       sb   a,a                                            ; XOR A             ; A = 0
       ; SLA E                                             ; SLA E             ; TODO: check code. shift the normalized sum (E) left by 1 into carry
       ab   @bytes+>08,a                                   ; ADC A,$08         ; page $08 or $09 of the log table
       movb @e,@l                                          ; LD L,E            ; L = the shifted E - the table index
       movb a,h                                            ; LD H,A            ; HL -> a 2-byte entry in the #R$1FCF-style $0800 lookup table
       movb *hl,a                                          ; LD A,(HL)         ; A = the entry's first byte
       ab   one,@l                                         ; INC L             ; advance to the entry's second byte
       movb *hl,h                                          ; LD H,(HL)         ; H = that second byte
       movb a,@l                                           ; LD L,A            ; HL = log of the shifted-down sum
       .ex_af_af_                                          ; EX AF,AF'         ; restore the earlier exponent contribution into A
       ab   h,a                                            ; ADD A,H           ; add the shifts back
       movb a,h                                            ; LD H,A            ; H = that sum
       srl  h,1                                            ; SRL H             ; HL >>= 1...
       ; RR L                                              ; RR L              ; TODO: check code. halve the log: a square root
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; A = the original shared exponent
       ab   a,a                                            ; ADD A,A           ; A *= 2
       ab   a,a                                            ; ADD A,A           ; A *= 2 (A is now 4x the original exponent)
       ab   h,a                                            ; ADD A,H           ; add back the components' shift
       movb a,h                                            ; LD H,A            ; H = that final combined value
       b    @antilog16                                     ; JP $21A3          ; convert back: HL = the length

********************************************************************************
* Vector length: square one component
* 
* Used by the routine at #R$84A6.
* .
* Shifts the component in HL right by the shared exponent in ($EB9B)
* (set by #R$84A6 so that the biggest component fits in a byte) and
* squares it (#R$2191).
* 
* I:HL Vector component
* O:A The component, shifted down
* O:HL Its square
vector_length_square:                                      ; >8515
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _8522                                          ; JR Z,$8522        ; no shift needed
       movb a,b                                            ; LD B,A            ; 
       movb h,a                                            ; LD A,H            ; 
_851d:                                                     ; >851d
       srl  a,1                                            ; RRA               ; TODO: check code. 
       ; RR L                                              ; RR L              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $851D        ; shift the component down
       jne  _851d                                          ;                   
_8522:                                                     ; >8522
       movb @l,@e                                          ; LD E,L            ; save it
       .call @square                                       ; CALL $2191        ; HL = its square
       movb @e,a                                           ; LD A,E            ; A = the component, shifted down
       .ret                                                ; RET               ; 

********************************************************************************
* Read a block of VRAM into a Z80 RAM buffer
* 
* Used by the routine at #R$8380.
* .
* Sets the VDP address for reading (no $40 on the high byte - that bit
* selects write mode), then copies B bytes from VRAM to (DE). Uses the same
* one-name-table-row-per-8-bytes addressing as #R$35B8/#R$854B: every 8th
* byte the VRAM address drops to the same column one row down (+256 bytes)
* instead of continuing into the next character.
* 
* I:HL VRAM address to start reading from
* I:DE Destination buffer in Z80 RAM
* I:B Number of bytes to read
* O:DE Advanced past the last byte written
read_vram_block:                                           ; >8528
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; point the VDP at the address, for reading
       .push hl                                            ; PUSH HL           ; 
       .pop hl                                             ; POP HL            ; (a short delay for the VDP)
       movb @bytes+>07,@c                                  ; LD C,$07          ; C = 7, to spot the end of a character's 8 rows
_8532:                                                     ; >8532
       movb @vdprd,a                                       ; IN A,($98)        ; read a byte
       movb a,*de                                          ; LD (DE),A         ; 
       inc  de                                             ; INC DE            ; 
       ab   one,@l                                         ; INC L             ; 
       movb @l,a                                           ; LD A,L            ; 
       ; AND C                                             ; AND C             ; TODO: check code. 
       jne  _8548                                          ; JR NZ,$8548       ; still within the character
       movb @l,a                                           ; LD A,L            ; 
       sb   one,a                                          ; DEC A             ; 
       andi a,>f800                                        ; AND $F8           ; back to the character's first row...
       movb a,@l                                           ; LD L,A            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ab   one,h                                          ; INC H             ; ...one character row down
       movb h,a                                            ; LD A,H            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       .push hl                                            ; PUSH HL           ; 
       .pop hl                                             ; POP HL            ; (a short delay)
_8548:                                                     ; >8548
       sb   one,b                                          ; DJNZ $8532        ; 
       jne  _8532                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* OR a Z80 RAM buffer into VRAM
* 
* Used by the routines at #R$834D, #R$845D, #R$8469, #R$8475 and #R$8481.
* .
* The mirror of #R$8528: sets the VDP address for writing, then for B bytes
* reads a byte from (DE), ORs it with C, and writes the result to VRAM -
* merging new pixels into whatever was already there rather than
* overwriting it. Same one-row-per-8-bytes addressing as #R$8528/#R$35B8.
* 
* I:A Byte to OR into every byte written (becomes C)
* I:HL VRAM address to start writing to
* I:DE Source buffer in Z80 RAM
* I:B Number of bytes to write
* O:DE Advanced past the last byte read
or_vram_block:                                             ; >854b
       movb a,@c                                           ; LD C,A            ; C = the byte to OR in
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; point the VDP at the address, for writing
_8554:                                                     ; >8554
       movb *de,a                                          ; LD A,(DE)         ; 
       inc  de                                             ; INC DE            ; 
       socb @c,a                                           ; OR C              ; OR in C
       movb a,@vdpwd                                       ; OUT ($98),A       ; write the byte
       ab   one,@l                                         ; INC L             ; 
       movb @l,a                                           ; LD A,L            ; 
       andi a,>0700                                        ; AND $07           ; 
       jeq  !                                              ; JP NZ,$856D       ; still within the character
       b    @or_vram_next_byte                             ;                   
!
       movb @l,a                                           ; LD A,L            ; 
       sb   one,a                                          ; DEC A             ; 
       andi a,>f800                                        ; AND $F8           ; back to the character's first row...
       movb a,@l                                           ; LD L,A            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ab   one,h                                          ; INC H             ; ...one character row down
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
or_vram_next_byte:                                         ; >856d
       sb   one,b                                          ; DJNZ $8554        ; 
       jne  _8554                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Compass: work out one coordinate of the compass dot
* 
* Used by the routine at #R$85FB.
* .
* Returns k * |v| / sqrt(v^2 + Z^2), with the sign of v, where v is HL (the
* target's X or Y) and Z is ($EB86) (|Z|, the target's depth). v and Z are
* first shifted right together until both fit in a byte (using the
* bit-length table at #R$0200), then squared (#R$1F5E), and the square root
* of the sum (#R$1F9C) scaled back up. |v| * k ($85CC; *8 is done with
* shifts) is then divided by that root. The result is at most k in size.
* .
* At $85CC, for k other than 8, multiplies |v| (HL) by k. The tail at $85DA
* (shared with #R$8570's k=8 path) divides the product by the distance
* sqrt(v^2 + Z^2) in DE, and gives the result the sign of v.
* 
* I:A Scale k (8 for Y, 1-6 for X)
* I:HL v (two's complement)
* O:A The signed result
* O:L Its magnitude
compass_coordinate:                                        ; >8570
       .push hl                                            ; PUSH HL           ; save v
       .push af                                            ; PUSH AF           ; save k
       czc  @bit7,h                                        ; BIT 7,H           ; is v negative?
       jeq  _857c                                          ; JR Z,$857C        ; 
       sb   a,a                                            ; XOR A             ; yes: HL = |v|
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; 
_857c:                                                     ; >857c
       .push hl                                            ; PUSH HL           ; save |v|
       movb @delta_z_hi,a                                  ; LD A,($EB87)      ; A = |Z|'s high byte...
       socb h,a                                            ; OR H              ; ...ORed with |v|'s
       jeq  _8587                                          ; JR Z,$8587        ; both under 256 - no shift needed
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>02,b                                   ; LD B,$02          ; 
       movb *bc,a                                          ; LD A,(BC)         ; A = the bit length of the larger (#R$0200), the shift needed
_8587:                                                     ; >8587
       movb a,@depth_shift                                 ; LD ($EB9B),A      ; save the shift count
       socb a,a                                            ; OR A              ; 
       jeq  _8594                                          ; JR Z,$8594        ; no shift
       movb a,b                                            ; LD B,A            ; 
       movb h,a                                            ; LD A,H            ; 
_858f:                                                     ; >858f
       srl  a,1                                            ; RRA               ; TODO: check code. shift |v| right...
       ; RR L                                              ; RR L              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $858F        ; ...to fit in a byte
       jne  _858f                                          ;                   
_8594:                                                     ; >8594
       .call @square_l                                     ; CALL $1F5E        ; HL = |v|^2 (#R$1F5E)
       .push hl                                            ; PUSH HL           ; save it
       mov  @abs_delta_z,hl                                ; LD HL,($EB86)     ; HL = |Z|
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _85a8                                          ; JR Z,$85A8        ; no shift
       movb a,b                                            ; LD B,A            ; 
       movb h,a                                            ; LD A,H            ; 
_85a3:                                                     ; >85a3
       srl  a,1                                            ; RRA               ; TODO: check code. shift |Z| right...
       ; RR L                                              ; RR L              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $85A3        ; ...by the same amount
       jne  _85a3                                          ;                   
_85a8:                                                     ; >85a8
       .call @square_l                                     ; CALL $1F5E        ; HL = |Z|^2
       .pop de                                             ; POP DE            ; DE = |v|^2
       sb   a,a                                            ; XOR A             ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   a,a                                            ; ADC A,A           ; A:HL = v^2 + Z^2
       .call @square_root                                  ; CALL $1F9C        ; HL = sqrt(v^2 + Z^2) (#R$1F9C)
       movb @depth_shift,a                                 ; LD A,($EB9B)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _85bc                                          ; JR Z,$85BC        ; no shift
       movb a,b                                            ; LD B,A            ; 
_85b9:                                                     ; >85b9
       a    hl,hl                                          ; ADD HL,HL         ; shift the root back up
       sb   one,b                                          ; DJNZ $85B9        ; 
       jne  _85b9                                          ;                   
_85bc:                                                     ; >85bc
       .ex_de_hl                                           ; EX DE,HL          ; DE = the distance sqrt(v^2 + Z^2)
       .pop hl                                             ; POP HL            ; HL = |v|
       .pop af                                             ; POP AF            ; A = k
       cb   a,@bytes+>08                                   ; CP $08            ; k = 8?
       jne  compass_scale                                  ; JR NZ,$85CC       ; no - multiply by k at $85CC
       sb   a,a                                            ; XOR A             ; yes: A:HL = |v| * 8
       a    hl,hl                                          ; ADD HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADD HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       a    hl,hl                                          ; ADD HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       jmp  _85da                                          ; JR $85DA          ; 
compass_scale:                                             ; >85cc
       movb a,b                                            ; LD B,A            ; B = the multiplier count
       sb   a,a                                            ; XOR A             ; A = 0 (top byte of the running A:HL result)
       sb   one,b                                          ; DEC B             ; count == 1?
       jeq  _85da                                          ; JR Z,$85DA        ; yes - no scaling needed, join the finishing tail
       .push de                                            ; PUSH DE           ; save the distance
       movb h,d                                            ; LD D,H            ; DE = |v|
       movb @l,@e                                          ; LD E,L            ; 
_85d4:                                                     ; >85d4
       a    de,hl                                          ; ADD HL,DE         ; accumulate one more copy...
       ab   @zero,a                                        ; ADC A,$00         ; 
       sb   one,b                                          ; DJNZ $85D4        ; ...k-1 times (A:HL = |v| * k)
       jne  _85d4                                          ;                   
       .pop de                                             ; POP DE            ; 
_85da:                                                     ; >85da
       movb @l,@c                                          ; LD C,L            ; 
       movb h,@l                                           ; LD L,H            ; 
       movb a,h                                            ; LD H,A            ; H:L:C = |v| * k
       sb   a,a                                            ; XOR A             ; A = 0; A:HL will hold the remainder
       movb @bytes+>08,b                                   ; LD B,$08          ; 8 bits of quotient
_85e0:                                                     ; >85e0
       ; RL C                                              ; RL C              ; TODO: check code. shift the next bit of the dividend in...
       a    hl,hl                                          ; ADC HL,HL         ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       s    de,hl                                          ; SBC HL,DE         ; ...and subtract the distance
       sb   @zero,a                                        ; SBC A,$00         ; 
       jnc  _85ee                                          ; JR NC,$85EE       ; TODO: check code. it fits (the quotient bit is the complement of the carry)
       a    de,hl                                          ; ADD HL,DE         ; doesn't fit: add it back
       ab   @zero,a                                        ; ADC A,$00         ; 
_85ee:                                                     ; >85ee
       sb   one,b                                          ; DJNZ $85E0        ; next bit
       jne  _85e0                                          ;                   
       movb @c,a                                           ; LD A,C            ; A = the quotient...
       sla  a,1                                            ; RLA               ; TODO: check code. 
       inv  a                                              ; CPL               ; ...with its bits complemented back
       .pop hl                                             ; POP HL            ; H = v's high byte (for its sign)
       movb a,@l                                           ; LD L,A            ; L = the magnitude
       czc  @bit7,h                                        ; BIT 7,H           ; v positive?
       jne  !                                              ; RET Z             ; yes - done
       .ret                                                ;                   
!
       neg a                                               ; NEG               ; no: negate the result
       .ret                                                ; RET               ; 

********************************************************************************
* Compass: position the compass dot
* 
* Used by the routine at #R$13FD.
* .
* Called for each object by the main loop, but only acts for the object
* the compass is tracking: the one whose slot number (#R$E911) matches
* ($EB05) - slot 0, the planet, or slot 1, the space station, once the
* ship is inside the station's safe zone (see #R$1549). Does nothing
* after a drive malfunction (($EEC1) set) or when the dashboard isn't
* shown (#R$6C9E).
* .
* The compass dot is sprite 8 (pattern $18). From the target's position
* relative to the ship (X, Y, Z at $F7CE/$F7D0/$F7D2) it is placed
* 8*Y/sqrt(Y^2+Z^2) pixels above the compass centre and k*X/sqrt(X^2+Z^2)
* pixels to the right of it (#R$8570), where k comes from the table at
* #R$8664 and narrows the horizontal range the further the dot is from
* the centre line, keeping it inside the compass circle. The dot is
* green (colour 2) if the target is in front of the ship and light blue
* (colour 5) if it is behind.
compass:                                                   ; >85fb
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; no compass after a drive malfunction
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       movb @current_slot,a                                ; LD A,($E911)      ; A = this object's slot number
       li   hl,station_in_range                            ; LD HL,$EB05       ; HL -> the compass target's slot number
       cb   a,*hl                                          ; CP (HL)           ; 
       jeq  !                                              ; RET NZ            ; not the compass target
       .ret                                                ;                   
!
       .call @gate_dashboard_hidden                        ; CALL $6C9E        ; return if the dashboard isn't shown
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; HL = Z
       czc  @bit7,h                                        ; BIT 7,H           ; test its sign
       jeq  _8618                                          ; JR Z,$8618        ; non-negative - keep it
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; HL = |Z|
_8618:                                                     ; >8618
       mov  hl,@abs_delta_z                                ; LD ($EB86),HL     ; $EB86 = |Z|
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; HL = Y
       movb @bytes+>08,a                                   ; LD A,$08          ; A = 8 (vertical range)
       .call @compass_coordinate                           ; CALL $8570        ; A = 8 * Y / sqrt(Y^2 + Z^2), L = its magnitude
       .push af                                            ; PUSH AF           ; save it
       sb   h,h                                            ; LD H,$00          ; HL = its magnitude (0-8)
       li   bc,compass_range_table                         ; LD BC,$8664       ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = horizontal range for that height (#R$8664)
       mov  @object_position_x,hl                          ; LD HL,($F7CE)     ; HL = X
       .call @compass_coordinate                           ; CALL $8570        ; A = k * X / sqrt(X^2 + Z^2)
       .pop bc                                             ; POP BC            ; B = vertical offset
       ab   @bytes+>a5,a                                   ; ADD A,$A5         ; C = sprite X ($A5 = compass centre)
       movb a,@c                                           ; LD C,A            ; C = that sum
       movb @bytes+>91,a                                   ; LD A,$91          ; 
       sb   b,a                                            ; SUB B             ; A -= B (the first result)
       movb a,b                                            ; LD B,A            ; B = sprite Y ($91 = compass centre)
       movb @bytes+>02,@e                                  ; LD E,$02          ; colour 2 (green)...
_863b:                                                     ; >863b
       movb @object_z_sign,a                               ; LD A,($F7D3)      ; A = sign of Z
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$8644        ; target in front
       b    @compass_set_dot                               ;                   
!
       movb @bytes+>05,@e                                  ; LD E,$05          ; behind: colour 5 (light blue)
compass_set_dot:                                           ; >8644
       movb @bytes+>18,d                                   ; LD D,$18          ; pattern $18
       limi 0                                              ; DI                ; disable interrupts
       movb @bytes+>20,a                                   ; LD A,$20          ; A = $20 (VRAM address low byte)
       movb a,@vdpwa                                       ; OUT ($99),A       ; set it
       movb @bytes+>5b,a                                   ; LD A,$5B          ; A = $5B ($1B with bit 6 set - write mode, VRAM address high byte)
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1B20: sprite 8's attributes
       .call @set_sprite                                   ; CALL $39A4        ; write Y, X, pattern and colour
       ; EI                                                ; EI                ; TODO: check code. re-enable interrupts
       .ret                                                ; RET               ; 

********************************************************************************
* Scanner blip and stick masks
* 
* Two 8-entry tables indexed by the object's pixel position within its
* screen byte (0-7), used by #R$82A7 (positions 2-7) and #R$82F3 (positions
* 0 and 1). $8654 is the 3-pixel blip mask ending at that pixel, $865C the
* 2-pixel stick mask; at positions 0 and 1 the rest spills into the byte to
* the left (see #R$82F3).
scanner_blip_masks:                                        ; >8654
       byte >80,>C0,>E0,>70,>38,>1C,>0E,>07
scanner_stick_masks:                                       ; >865c
       byte >80,>C0,>60,>30,>18,>0C,>06,>03

********************************************************************************
* Compass dot horizontal range table
* 
* Entry n (0-8) is how far (in pixels) the compass dot may be placed left
* or right of the compass centre when it is n pixels above or below it -
* roughly the half-width of the compass circle at that height. Used by
* #R$85FB as the scale for the dot's horizontal offset.
compass_range_table:                                       ; >8664
       byte >06,>06,>06,>05,>05,>04,>04,>03,>01

********************************************************************************
* Move the object forward
* 
* Used by the routines at #R$13FD and #R$1703.
* .
* Called for each object by the main loop (#R$13FD) and the death scene
* (#R$1703). Clears bit 4 of #R$F7CD. Does nothing if the object's speed
* (#R$F7E6) is 0; otherwise moves it along its nose vector (#R$8685) by
* its speed, halved once for each distance band (#R$8B66).
move_object:                                               ; >866d
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; HL -> the object status byte
       szcb @bit4,*hl                                      ; RES 4,(HL)        ; 
       movb @object_speed,a                                ; LD A,($F7E6)      ; A = speed
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; not moving
       .ret                                                ;                   
!
       .call @distance_band                                ; CALL $8B66        ; A = distance band
       movb a,b                                            ; LD B,A            ; B = its result (a shift count)
       movb @object_speed,a                                ; LD A,($F7E6)      ; 
_867e:                                                     ; >867e
       srl  a,1                                            ; SRL A             ; halve the speed...
       sb   one,b                                          ; DJNZ $867E        ; ...once per band
       jne  _867e                                          ;                   
       b    @move_along_axis                               ; JP $8685          ; move it

********************************************************************************
* Move the object along its axis vector
* 
* Used by the routines at #R$3187 and #R$866D.
* .
* Adds speed * the object's axis vector ($F7DA/$F7DC/$F7DE) to its
* position ($F7CE/$F7D0/$F7D2), multiplying by adding logarithms: the log
* of the speed (from the log table at #R$0800) goes in $E874 and the logs
* of the vector's components (#R$1FCF) in $EB68-$EB6D, and #R$86DC does
* each coordinate. Also sets bit 4 of the status byte ($F7CD).
* 
* I:A Speed
move_along_axis:                                           ; >8685
       movb a,@l                                           ; LD L,A            ; L = speed
       sb   h,h                                            ; LD H,$00          ; H = 0
       a    hl,hl                                          ; ADD HL,HL         ; HL = index * 2 (word index)
       li   bc,log_table                                   ; LD BC,$0800       ; BC = the table base
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this type's table entry
       li   de,type_entry_cache                            ; LD DE,$E874       ; $E874 = log(speed)
       .ldi                                                ; LDI               ; copy the 2-byte entry...
       .ldi                                                ; LDI               ; ...(both bytes)
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; HL = the scale vector's first component
       .call @log_sign_tagged                              ; CALL $1FCF        ; log of the vector's X component
       mov  hl,@nose_vector_logs                           ; LD ($EB68),HL     ; cache the result
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = the second component
       .call @log_sign_tagged                              ; CALL $1FCF        ; log of its Y component
       mov  hl,@nose_vector_log_y                          ; LD ($EB6A),HL     ; cache the result
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; HL = the third component
       .call @log_sign_tagged                              ; CALL $1FCF        ; log of its Z component
       mov  hl,@nose_vector_log_z                          ; LD ($EB6C),HL     ; cache the result
       li   hl,object_status_byte                          ; LD HL,$F7CD       ; HL -> the object status byte
       socb @bit4,*hl                                      ; SET 4,(HL)        ; set bit 4
       mov  @object_position_x,hl                          ; LD HL,($F7CE)     ; HL = the roll-rotated vector's first half
       mov  @nose_vector_logs,bc                           ; LD BC,($EB68)     ; BC = the quantized first component
       .call @move_one_coordinate                          ; CALL $86DC        ; X += speed * vector X
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; store the combined result
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; HL = the shared middle vector component
       mov  @nose_vector_log_y,bc                          ; LD BC,($EB6A)     ; BC = the quantized second component
       .call @move_one_coordinate                          ; CALL $86DC        ; Y += speed * vector Y
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; store the combined result
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; HL = the pitch-rotated vector's second half
       mov  @nose_vector_log_z,bc                          ; LD BC,($EB6C)     ; BC = the quantized third component
       .call @move_one_coordinate                          ; CALL $86DC        ; Z += speed * vector Z
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; store the combined result
       .ret                                                ; RET               ; 

********************************************************************************
* Add speed * one component of the axis vector to a coordinate
* 
* Used by the routine at #R$8685.
* .
* 
* I:BC Log of the axis vector component
* I:HL The coordinate
* I:($E874) Log of the speed
* O:HL The new coordinate
move_one_coordinate:                                       ; >86dc
       .push hl                                            ; PUSH HL           ; save the caller's position component
       mov  @type_entry_cache,hl                           ; LD HL,($E874)     ; HL = the per-type table entry
       .call @multiply_logs                                ; CALL $2160        ; HL = speed * component (#R$2160)
       .pop de                                             ; POP DE            ; DE = the caller's original position component
       a    de,hl                                          ; ADD HL,DE         ; add it to the coordinate
       .ret                                                ; RET               ; 

********************************************************************************
* Engage the Torus Jump Drive ('J')
* 
* Used by the routine at #R$401C.
* .
* The manual's "Torus Jump Drive (J)", which "does not function ... if
* there is another ship, a planet or a sun in the immediate vicinity".
* Refuses with a beep (#R$16FE) if ($EEC1) is set, if #R$3359 reports
* one of its three flags set, or if the magnitude at $E727 is 10000 or
* less. Otherwise saves the current speed at $E87A, stops any roll and
* pitch (#R$1A7D), brings the speed down to 0 (#R$8B7B), and starts a
* 25-frame jump (($E918), counted down by #R$13FD, which restores the
* speed via #R$8B8F at the end) during which #R$872E draws the stardust
* as lengthening streaks. Also sets $E878 to 200 (see #R$8B00).
engage_torus_jump_drive:                                   ; >86e6
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$16FE       ; ($EEC1) set - beep
       b    @trigger_sfx_6                                 ;                   
!
       .call @any_ships_about                              ; CALL $3359        ; 
       jeq  !                                              ; JP NZ,$16FE       ; one of #R$3359's flags set - beep
       b    @trigger_sfx_6                                 ;                   
!
       mov  @planet_distance,de                            ; LD DE,($E727)     ; 
       li   hl,>2710                                       ; LD HL,$2710       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       joc  !                                              ; JP NC,$16FE       ; TODO: check code. ($E727) <= 10000 - beep
       b    @trigger_sfx_6                                 ;                   
!
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; 
       movb a,@cached_f814_at_engage                       ; LD ($E87A),A      ; save the speed
       .call @stop_roll_and_pitch                          ; CALL $1A7D        ; stop any roll and pitch
       .call @stop_ship                                    ; CALL $8B7B        ; bring the speed down to 0
       movb @bytes+>19,a                                   ; LD A,$19          ; 
       movb a,@torus_jump_countdown                        ; LD ($E918),A      ; the jump lasts 25 frames
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@jump_in_progress                            ; LD ($E722),A      ; flag the jump as in progress
       li   hl,>00c8                                       ; LD HL,$00C8       ; 
       mov  hl,@jump_speed                                 ; LD ($E878),HL     ; 
       movb @bytes+>05,a                                   ; LD A,$05          ; 
       movb a,@stardust_passes_interval                    ; LD ($E87C),A      ; lengthen the stardust streaks every 5 frames...
       movb one,a                                          ; LD A,$01          ; 
       movb a,@stardust_passes                             ; LD ($E723),A      ; ...starting from 1 pass per frame
       movb a,@stardust_passes_countdown                   ; LD ($E87B),A      ; 
       movb @bytes+>0a,a                                   ; LD A,$0A          ; 
       b    @play_sound_effect                             ; JP $7468          ; play sound effect 10 (Torus Jump Drive)

********************************************************************************
* Update the stardust (several times per frame during a jump)
* 
* Used by the routines at #R$13FD and #R$894D.
* .
* Normally just moves and plots the stardust once (#R$68CD). While a jump
* is in progress (($E722) set by #R$86E6's in-system jump or #R$894D's
* hyperspace sequence) it runs #R$68CD ($E723) times instead, and every
* ($E87C) calls ($E723) goes up by one, to a maximum of 7. Every pass
* moves each particle on and plots it again into the same frame's buffer,
* so the dots turn into streaks that lengthen as the jump builds up.
update_stardust:                                           ; >872e
       movb @jump_in_progress,a                            ; LD A,($E722)      ; A = jump-in-progress flag
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$68CD        ; no jump - move and plot the stardust once
       b    @move_and_plot_stardust                        ;                   
!
       movb @stardust_passes,a                             ; LD A,($E723)      ; A = the number of passes per frame
       movb a,b                                            ; LD B,A            ; B = that pass count
       li   hl,stardust_passes_countdown                   ; LD HL,$E87B       ; HL -> the calls-until-next-increase counter
       sb   one,*hl                                        ; DEC (HL)          ; count this call
       jne  _874d                                          ; JR NZ,$874D       ; not time to lengthen the streaks yet
       movb @stardust_passes_interval,a                    ; LD A,($E87C)      ; reload the counter from its reset value
       movb a,*hl                                          ; LD (HL),A         ; 
       movb @bytes+>07,a                                   ; LD A,$07          ; 
       cb   a,b                                            ; CP B              ; already at the maximum of 7 passes?
       jeq  _874d                                          ; JR Z,$874D        ; yes - leave it
       ab   one,b                                          ; INC B             ; no - one more pass per frame from now on
       movb b,a                                            ; LD A,B            ; 
       movb a,@stardust_passes                             ; LD ($E723),A      ; 
_874d:                                                     ; >874d
       .push bc                                            ; PUSH BC           ; save the pass counter
       .call @move_and_plot_stardust                       ; CALL $68CD        ; move and plot the stardust
       .pop bc                                             ; POP BC            ; restore the pass counter
       sb   one,b                                          ; DJNZ $874D        ; repeat for each pass
       jne  _874d                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Check for a collision with the object
* 
* Used by the routine at #R$13FD.
* .
* Does nothing for missiles, the Cougar, explosions, objects that are
* already exploding (bit 3 of #R$F7CD), while the flight controls are off
* (#R$EF8E), or if the object is further away (#R$EB8E) than its size
* ($F805, byte $10 of its blueprint, see #R$A817). Otherwise:
* .
* The space station goes on to the docking check ($87DD), unless the player
* has shot at it ($EF97) or the Thargoids have taken it over (mission state
* $52, #R$E93D), when it's a collision.
* .
* A cargo canister, escape capsule or Thargon may be scooped (#R$8BA6).
* .
* Anything else - and the station, and objects not scooped - is a
* collision: the object loses 50 energy (#R$F7E9), and is destroyed if that
* uses it all up (without affecting the player's legal status, #R$EFA1);
* and the player's shields take 20 damage - or $FF from the Constrictor
* (#R$193F).
* .
* At $87DD, if the station is in front (($F7D3), the sign of its Z
* coordinate) and more than 110 away (#R$EB8E), nothing happens. The player
* docks (#R$E917) if the ship is lined up with the slot - X distance under
* 30 and Y under 20 ($EB82/$EB84, see #R$883D) - the station is facing the
* player (its $F7DE and $F7D6 orientation components, see #R$4503, both at
* least $3DD1 with the right signs), and it's no more than 79 in front
* (($F7D2)). Missing the slot is a collision ($8838).
* .
* At $8838, the player's shields take 10 damage (#R$193F).
check_collision:                                           ; >8755
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>02                                   ; CP $02            ; is it 2?
       jne  !                                              ; RET Z             ; a missile
       .ret                                                ;                   
!
       cb   a,@bytes+>1e                                   ; CP $1E            ; is it $1E?
       jne  !                                              ; RET Z             ; the Cougar
       .ret                                                ;                   
!
       movb @handler_type,a                                ; LD A,($F7EE)      ; A = the object's type
       cb   a,one                                          ; CP $01            ; is it 1?
       jne  !                                              ; RET Z             ; an explosion
       .ret                                                ;                   
!
       movb @object_status_byte,a                          ; LD A,($F7CD)      ; A = a flag byte at $F7CD
       andi a,>0800                                        ; AND $08           ; test bit 3
       jeq  !                                              ; RET NZ            ; already exploding
       .ret                                                ;                   
!
       movb @flight_controls_off,a                         ; LD A,($EF8E)      ; flight controls off?
       socb a,a                                            ; OR A              ; test it (also clears carry for the SBC below)
       jeq  !                                              ; RET NZ            ; yes - no collisions
       .ret                                                ;                   
!
       mov  @object_distance,de                            ; LD DE,($EB8E)     ; DE = the object's distance
       mov  @bp_size,hl                                    ; LD HL,($F805)     ; HL = its size
       sb   h,h                                            ; LD H,$00          ; H = 0 - just the low byte, zero-extended
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE
       jnc  !                                              ; RET C             ; TODO: check code. too far away - no collision
       .ret                                                ;                   
!
       movb @legal_status_copy,a                           ; LD A,($EF97)      ; nonzero if the player has shot the station
       socb a,a                                            ; OR A              ; test it
       jne  _878f                                          ; JR NZ,$878F       ; yes - no docking
       movb @mission_state,a                               ; LD A,($E93D)      ; A = the mission state
       cb   a,@bytes+>52                                   ; CP $52            ; is it $52?
       jeq  _878f                                          ; JR Z,$878F        ; the Thargoids' station
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,one                                          ; CP $01            ; is it 1?
       jeq  check_docking                                  ; JR Z,$87DD        ; the station: check for docking
_878f:                                                     ; >878f
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>03                                   ; CP $03            ; is it 3?
       jeq  _879e                                          ; JR Z,$879E        ; cargo canister
       cb   a,@bytes+>05                                   ; CP $05            ; is it 5?
       jeq  _879e                                          ; JR Z,$879E        ; escape capsule
       cb   a,@bytes+>06                                   ; CP $06            ; is it 6?
       jne  _87a2                                          ; JR NZ,$87A2       ; not a Thargon either
_879e:                                                     ; >879e
       .call @scoop_object                                 ; CALL $8BA6        ; scoop it?
       jnc  !                                              ; RET C             ; TODO: check code. scooped
       .ret                                                ;                   
!
_87a2:                                                     ; >87a2
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,one                                          ; CP $01            ; is it 1?
       jeq  _87cf                                          ; JR Z,$87CF        ; the station itself doesn't lose energy
       movb @object_energy,a                               ; LD A,($F7E9)      ; A = the object's energy
       sb   @bytes+>32,a                                   ; SUB $32           ; minus 50
       movb a,@object_energy                               ; LD ($F7E9),A      ; store it back
       jnc  _87cf                                          ; JR NC,$87CF       ; TODO: check code. still some left
       li   ix,object_status_byte                          ; LD IX,$F7CD       ; underflowed: IX -> $F7CD
       socb @bit6,*ix                                      ; SET 6,(IX+$00)    ; no bounty for it
       movb @b255,a                                        ; LD A,$FF          ; A = $FF
       movb a,@legal_status_exempt                         ; LD ($EFA1),A      ; destroying it doesn't affect the legal status
       .call @destroy_object                               ; CALL $31AD        ; destroy it
       li   hl,legal_status_exempt                         ; LD HL,$EFA1       ; HL -> $EFA1
       ab   one,*hl                                        ; INC (HL)          ; 
       .call @cancel_missile_lock_on_object                ; CALL $30EA        ; cancel any missile lock on it
       movb @bytes+>02,a                                   ; LD A,$02          ; A = 2
       .call @play_sound_effect                            ; CALL $7468        ; play the explosion sound
_87cf:                                                     ; >87cf
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>1f                                   ; CP $1F            ; the Constrictor?
       movb @bytes+>14,a                                   ; LD A,$14          ; damage 20...
       jne  _87da                                          ; JR NZ,$87DA       ; not $1F - keep $14, skipping the override below
       movb @b255,a                                        ; LD A,$FF          ; ...or $FF for the Constrictor
_87da:                                                     ; >87da
       b    @damage_shields                                ; JP $193F          ; damage the player's shields
check_docking:                                             ; >87dd
       movb @object_z_sign,a                               ; LD A,($F7D3)      ; A = the position's Z sign byte
       socb a,a                                            ; OR A              ; test its sign (also clears carry for the SBC below)
       jhe  !                                              ; JP M,$87EA        ; behind the player
       b    @check_collision_in_front                      ;                   
!
       li   hl,>006e                                       ; LD HL,$006E       ; HL = $006E (110)
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE (the magnitude)
       jnc  !                                              ; RET C             ; TODO: check code. too far away
       .ret                                                ;                   
!
check_collision_in_front:                                  ; >87ea
       mov  @abs_delta_x,hl                                ; LD HL,($EB82)     ; HL = X distance
       li   de,>001e                                       ; LD DE,$001E       ; DE = $001E (30)
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE
       jnc  crash_into_station                             ; JR NC,$8838       ; TODO: check code. not lined up - crash
       mov  @abs_delta_y,hl                                ; LD HL,($EB84)     ; HL = Y distance
       li   de,>0014                                       ; LD DE,$0014       ; DE = $0014 (20)
       socb a,a                                            ; OR A              ; clear carry
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE
       jnc  crash_into_station                             ; JR NC,$8838       ; TODO: check code. not lined up - crash
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; 
       movb @object_z_sign,a                               ; LD A,($F7D3)      ; A = the position's Z sign byte again
       socb a,a                                            ; OR A              ; test its sign
       jlt  !                                              ; JP P,$8810        ; 
       b    @check_docking_2                               ;                   
!
       czc  @bit7,h                                        ; BIT 7,H           ; negative: test $F7DE's own sign
       jne  crash_into_station                             ; JR NZ,$8838       ; not facing - crash
       jmp  _8816                                          ; JR $8816          ; 
check_docking_2:                                           ; >8810
       czc  @bit7,h                                        ; BIT 7,H           ; test $F7DE's sign
       jeq  crash_into_station                             ; JR Z,$8838        ; not facing - crash
       szcb @bit7,h                                        ; RES 7,H           ; 
_8816:                                                     ; >8816
       li   de,>3dd1                                       ; LD DE,$3DD1       ; 
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE
       joc  crash_into_station                             ; JR C,$8838        ; TODO: check code. not facing - crash
       mov  @side_vector_y,hl                              ; LD HL,($F7D6)     ; 
       szcb @bit7,h                                        ; RES 7,H           ; force it positive - unlike $F7DE above, its sign isn't tested first
       li   de,>3dd1                                       ; LD DE,$3DD1       ; DE = $3DD1 again
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE
       jnc  !                                              ; JP C,$8838        ; TODO: check code. not facing - crash
       b    @crash_into_station                            ;                   
!
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; HL = Z distance
       li   de,>ffb0                                       ; LD DE,$FFB0       ; DE = -80
       a    de,hl                                          ; ADD HL,DE         ; HL += -80 (wraps unless Z was already within [0,79])
       jnc  !                                              ; RET C             ; TODO: check code. more than 79 away - not docked yet
       .ret                                                ;                   
!
       movb @b255,a                                        ; LD A,$FF          ; within the band: A = $FF
       movb a,@docking                                     ; LD ($E917),A      ; docked
       .ret                                                ; RET               ; done
crash_into_station:                                        ; >8838
       movb @bytes+>0a,a                                   ; LD A,$0A          ; damage 10
       b    @damage_shields                                ; JP $193F          ; damage the player's shields

********************************************************************************
* Work out the object's distance
* 
* Used by the routines at #R$13FD, #R$1703 and #R$8C94.
* .
* Stores the size of each of the object's coordinates (#R$F7CE) at $EB82,
* $EB84 and $EB86 (z also at $E941), works out its distance (#R$84A6) and
* stores it in #R$EB8E - and for the planet (ship type $64) in #R$E727, for
* the sun ($65, at $887F) in #R$E725, and for the space station (1, at
* $88A1) in #R$E729. In mission states $32 and $33 (the sun about to go
* supernova, see #R$909F), the sun's distance is first reduced by an amount
* (#R$E93E) that grows by 100 every frame, so the sun gets closer and the
* cabin temperature rises (#R$15CB).
* 
* O:HL The distance
work_out_distance:                                         ; >883d
       mov  @object_position_x,hl                          ; LD HL,($F7CE)     ; HL = the first rotated component
       czc  @bit7,h                                        ; BIT 7,H           ; test its sign
       jeq  _884a                                          ; JR Z,$884A        ; non-negative - keep it
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...H:L = abs(HL)
_884a:                                                     ; >884a
       mov  hl,@abs_delta_x                                ; LD ($EB82),HL     ; X for #R$84A6
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; HL = the second rotated component
       czc  @bit7,h                                        ; BIT 7,H           ; test its sign
       jeq  _885a                                          ; JR Z,$885A        ; non-negative - keep it
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...H:L = abs(HL)
_885a:                                                     ; >885a
       mov  hl,@abs_delta_y                                ; LD ($EB84),HL     ; Y for #R$84A6
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; HL = the third rotated component
       czc  @bit7,h                                        ; BIT 7,H           ; test its sign
       jeq  _886a                                          ; JR Z,$886A        ; non-negative - keep it
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...H:L = abs(HL)
_886a:                                                     ; >886a
       mov  hl,@abs_delta_z                                ; LD ($EB86),HL     ; Z for #R$84A6
       mov  hl,@object_depth                               ; LD ($E941),HL     ; also mirror the Z magnitude to $E941
       .call @vector_length                                ; CALL $84A6        ; HL = the object's distance
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>64                                   ; CP $64            ; is it $64?
       jne  sun_distance_supernova                         ; JR NZ,$887F       ; no
       mov  hl,@planet_distance                            ; LD ($E727),HL     ; yes: cache the magnitude to $E727
       jmp  _88a8                                          ; JR $88A8          ; join the shared tail at $88A8
sun_distance_supernova:                                    ; >887f
       cb   a,@bytes+>65                                   ; CP $65            ; is the ship type $65?
       jne  ship_type_1_case_else_join                     ; JR NZ,$88A1       ; not the sun
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>32                                   ; CP $32            ; is it $32?
       jeq  _888e                                          ; JR Z,$888E        ; 
       cb   a,@bytes+>33                                   ; CP $33            ; is it $33?
       jne  _889c                                          ; JR NZ,$889C       ; no supernova
_888e:                                                     ; >888e
       mov  @supernova_offset,de                           ; LD DE,($E93E)     ; DE = the running total at $E93E
       a    de,hl                                          ; ADD HL,DE         ; add the offset (which is negative)
       .push hl                                            ; PUSH HL           ; save the adjusted magnitude
       li   hl,>ff9c                                       ; LD HL,$FF9C       ; HL = -100
       a    de,hl                                          ; ADD HL,DE         ; the offset shrinks by 100 every frame
       mov  hl,@supernova_offset                           ; LD ($E93E),HL     ; store the advanced running total back
       .pop hl                                             ; POP HL            ; restore the adjusted magnitude
_889c:                                                     ; >889c
       mov  hl,@sun_distance                               ; LD ($E725),HL     ; the sun's distance
       jmp  _88a8                                          ; JR $88A8          ; join the shared tail at $88A8
ship_type_1_case_else_join:                                ; >88a1
       cb   a,one                                          ; CP $01            ; is the ship type 1?
       jne  _88a8                                          ; JR NZ,$88A8       ; no - join the shared tail with the magnitude untouched
       mov  hl,@station_distance                           ; LD ($E729),HL     ; yes: cache the magnitude to $E729
_88a8:                                                     ; >88a8
       mov  hl,@object_distance                            ; LD ($EB8E),HL     ; every path also caches the magnitude to $EB8E
       .ret                                                ; RET               ; done

********************************************************************************
* Key 'H': hyperspace
* 
* Reached via the key table at #R$419B. Doesn't work while docked
* (#R$6DCF), while a jump is already counting down (#R$E91B), or in
* witchspace until enough Thargoids have been destroyed (#R$EEC2). On a
* chart (#R$E902 = 4 or 6), first selects the system nearest the cursor.
* Then shows "Select System!" if no system is selected (#R$E91A) or it's
* the current one (unless in witchspace), and "Beyond Range!" if there
* isn't enough fuel (#R$F775) for the distance (#R$6141). Otherwise, at
* $8910, starts a 10-second countdown (#R$E91B, #R$E91C) to the jump
* (#R$894D), remembering its fuel cost ($E87F).
key_handler_h:                                             ; >88ac
       .call @refuse_if_docked                             ; CALL $6DCF        ; do nothing if docked
       movb @hyperspace_countdown_inner,a                  ; LD A,($E91B)      ; A = countdown
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$16FE       ; already counting down
       b    @trigger_sfx_6                                 ;                   
!
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _88c3                                          ; JR Z,$88C3        ; not in witchspace
       movb @witchspace_kills_needed,a                     ; LD A,($EEC2)      ; A = kills still needed
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$16FE       ; hyperspace not working yet
       b    @trigger_sfx_6                                 ;                   
!
_88c3:                                                     ; >88c3
       movb @hyperspace_target_selected,a                  ; LD A,($E91A)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _88d2                                          ; JR NZ,$88D2       ; 
_88c9:                                                     ; >88c9
       .call @trigger_sfx_6                                ; CALL $16FE        ; beep
       li   hl,msg_select_system                           ; LD HL,$8C3C       ; "Select System!"
       b    @show_message_anywhere                         ; JP $1683          ; show it
_88d2:                                                     ; >88d2
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,@bytes+>06                                   ; CP $06            ; 
       jne  _88e1                                          ; JR NZ,$88E1       ; 
       .call @local_chart_select                           ; CALL $538B        ; on a chart: select the system
       .call @local_chart_cursor_to_selected               ; CALL $53ED        ; nearest the cursor
       jmp  _88eb                                          ; JR $88EB          ; 
_88e1:                                                     ; >88e1
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  _88eb                                          ; JR NZ,$88EB       ; 
       .call @galactic_chart_select                        ; CALL $5314        ; on a chart: select the system
       .call @galactic_chart_cursor_to_selected            ; CALL $53FD        ; nearest the cursor
_88eb:                                                     ; >88eb
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _88fa                                          ; JR NZ,$88FA       ; in witchspace - any system will do
       movb @selected_system,a                             ; LD A,($E72B)      ; A = the selected system
       li   hl,current_system                              ; LD HL,$EB67       ; 
       cb   a,*hl                                          ; CP (HL)           ; the current system?
       jeq  _88c9                                          ; JR Z,$88C9        ; yes - "Select System!"
_88fa:                                                     ; >88fa
       .call @distance_to_selected_system                  ; CALL $6141        ; HL = fuel needed
       .ex_de_hl                                           ; EX DE,HL          ; 
       mov  @fuel_level,hl                                 ; LD HL,($F775)     ; L = fuel
       sb   a,a                                            ; XOR A             ; 
       movb a,h                                            ; LD H,A            ; 
       s    de,hl                                          ; SBC HL,DE         ; enough fuel?
       jnc  _8910                                          ; JR NC,$8910       ; TODO: check code. yes
       .call @trigger_sfx_6                                ; CALL $16FE        ; no - beep
       li   hl,msg_beyond_range                            ; LD HL,$8C4A       ; "Beyond Range!"
       b    @show_message_anywhere                         ; JP $1683          ; show it
_8910:                                                     ; >8910
       movb @e,a                                           ; LD A,E            ; 
       movb a,@hyperspace_fuel_cost                        ; LD ($E87F),A      ; the jump's fuel cost
       movb @bytes+>32,a                                   ; LD A,$32          ; 
       movb a,@hyperspace_countdown_outer                  ; LD ($E91C),A      ; 50 frames per second
       movb @bytes+>0a,a                                   ; LD A,$0A          ; 
       movb a,@hyperspace_countdown_inner                  ; LD ($E91B),A      ; 10 seconds
       sb   a,a                                            ; XOR A             ; 
       movb a,@countdown_shown                             ; LD ($E91D),A      ; 
       movb a,@galactic_jump_flag                          ; LD ($E925),A      ; not a galactic jump
       .ret                                                ; RET               ; 

********************************************************************************
* Key 'G': galactic hyperspace
* 
* Reached via the key table at #R$419B. Needs a galactic hyperdrive
* (#R$F780), which is used up by the jump (#R$894D), and not to be docked
* (#R$6DCF) or already counting down (#R$E91B). Starts a 30-second
* countdown to a jump that costs no fuel, flagged as galactic (#R$E925).
key_handler_g:                                             ; >8926
       .call @refuse_if_docked                             ; CALL $6DCF        ; do nothing if docked
       movb @galactic_drive_fitted,a                       ; LD A,($F780)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$16FE        ; no galactic hyperdrive
       b    @trigger_sfx_6                                 ;                   
!
       movb @hyperspace_countdown_inner,a                  ; LD A,($E91B)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; JP NZ,$16FE       ; already counting down
       b    @trigger_sfx_6                                 ;                   
!
       sb   a,a                                            ; XOR A             ; 
       movb a,@countdown_shown                             ; LD ($E91D),A      ; 
       movb a,@hyperspace_fuel_cost                        ; LD ($E87F),A      ; no fuel cost
       ab   one,a                                          ; INC A             ; 
       movb a,@galactic_jump_flag                          ; LD ($E925),A      ; a galactic jump
       movb @bytes+>32,a                                   ; LD A,$32          ; 
       movb a,@hyperspace_countdown_outer                  ; LD ($E91C),A      ; 50 frames per second
       movb @bytes+>1e,a                                   ; LD A,$1E          ; 
       movb a,@hyperspace_countdown_inner                  ; LD ($E91B),A      ; 30 seconds
       .ret                                                ; RET               ; 

********************************************************************************
* Hyperspace jump
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD); does nothing until the
* countdown started by 'H' (#R$88AC) or 'G' (#R$8926) has run out
* (#R$E920, set by #R$7202). Then updates the mission state (#R$8AC8),
* stops the ship and leaves witchspace and the safe zone, and shows the
* hyperspace tunnel: "Hyperdrive Engaged" over stardust streaks
* (#R$872E) that get longer, in colours that cycle, for about 110
* frames.
* .
* There's a 12/256 chance of a drive malfunction, which puts the ship in
* witchspace (#R$EEC1). A galactic jump (#R$E925) uses up the galactic
* hyperdrive (#R$F780), moves on to the next galaxy (#R$EB66, rotating
* the galaxy seeds at $E711) and arrives at the system nearest the
* middle of the chart (#R$5325); and in mission 1, state $12, starts the
* Constrictor's trail (#R$EFA2, #R$EFA3).
* .
* In witchspace ($8A0E): the ship is halfway between the two systems
* ($EEC3/$EEC4); the kills needed before hyperspace works again
* (#R$EEC2) and the number of Thargoids (#R$EEC5) are set; the object
* table is cleared; "Drive malfunction!" is shown, and only half the
* fuel is used.
* .
* Otherwise ($8A4D): outside the first galaxy, counts the jumps to the
* next mission (#R$E93B, #R$908C); then arrives in the selected system
* (#R$EB67), building its market (#R$4BA8) and placing the planet, sun
* and station (#R$8C94).
* .
* Either way ($8A76): the legal status (#R$EB65) is halved, the fuel
* used, and the gauges redrawn. Finally, at the start of mission 3
* (state $30), a "Fuel Leak!" drains all the fuel (see #R$909F).
hyperspace_jump:                                           ; >894d
       movb @hyperspace_trigger,a                          ; LD A,($E920)      ; A = the trigger flag
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; not time yet
       .ret                                                ;                   
!
       .call @mission_on_hyperspace                        ; CALL $8AC8        ; update the mission state
       .call @stop_roll_and_pitch                          ; CALL $1A7D        ; stop any roll and pitch
       .call @switch_to_front_view                         ; CALL $64A1        ; switch to the front view
       .call @stop_ship                                    ; CALL $8B7B        ; bring the speed down to 0
       sb   a,a                                            ; XOR A             ; 
       movb a,@hyperspace_trigger                          ; LD ($E920),A      ; 
       movb a,@in_witchspace                               ; LD ($EEC1),A      ; out of witchspace
       movb a,@alert_level                                 ; LD ($E90C),A      ; alert level 0
       movb a,@station_in_range                            ; LD ($EB05),A      ; out of the safe zone
       movb one,a                                          ; LD A,$01          ; 
       movb a,@jump_in_progress                            ; LD ($E722),A      ; stardust: hyperspace streaks
       movb a,@stardust_passes                             ; LD ($E723),A      ; the fast-forward ramp counter, starts at 1
       movb a,@stardust_passes_countdown                   ; LD ($E87B),A      ; 
       movb @bytes+>0a,a                                   ; LD A,$0A          ; 
       movb a,@stardust_passes_interval                    ; LD ($E87C),A      ; 
       movb @bytes+>21,a                                   ; LD A,$21          ; 
       movb a,@hyperspace_flash_colour                     ; LD ($E880),A      ; the first colour
       movb @bytes+>0c,a                                   ; LD A,$0C          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 12 (hyperspace)
_8985:                                                     ; >8985
       .push bc                                            ; PUSH BC           ; save this pass's B (#R$872E clobbers it)
       .call @clear_space_view                             ; CALL $388F        ; clear the space view
       li   hl,msg_hyperdrive_engaged                      ; LD HL,$8C57       ; "Hyperdrive Engaged"
       .call @show_view_message                            ; CALL $39C8        ; print it
       .call @update_stardust                              ; CALL $872E        ; draw the stardust streaks (lengthening as ($E723) ramps up)
       .call @copy_space_view                              ; CALL $3846        ; copy the space view to the screen
       movb @hyperspace_flash_colour,a                     ; LD A,($E880)      ; 
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       jnc  _899e                                          ; JR NC,$899E       ; TODO: check code. 
       movb @bytes+>21,a                                   ; LD A,$21          ; wrap the colour back to $21
_899e:                                                     ; >899e
       movb a,@hyperspace_flash_colour                     ; LD ($E880),A      ; 
       .call @colour_space_view                            ; CALL $3A4D        ; recolour with it
       .pop bc                                             ; POP BC            ; restore this pass's B
       movb @stardust_passes,a                             ; LD A,($E723)      ; 
       cb   a,@bytes+>07                                   ; CP $07            ; 
       jhe  _89ae                                          ; JR NC,$89AE       ; ($E723)>=7 - let B decay naturally
       movb @bytes+>3c,b                                   ; LD B,$3C          ; still <7 - force another 60 passes
_89ae:                                                     ; >89ae
       sb   one,b                                          ; DJNZ $8985        ; 
       jne  _8985                                          ;                   
       .call @random_byte                                  ; CALL $2176        ; A = a random byte
       cb   a,@bytes+>0c                                   ; CP $0C            ; 
       jhe  _89c0                                          ; JR NC,$89C0       ; no malfunction
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@in_witchspace                               ; LD ($EEC1),A      ; 12/256 chance: witchspace
       movb @bytes+>51,a                                   ; LD A,$51          ; in witchspace colours
       jmp  _89c2                                          ; JR $89C2          ; 
_89c0:                                                     ; >89c0
       movb @bytes+>a1,a                                   ; LD A,$A1          ; 
_89c2:                                                     ; >89c2
       .call @colour_space_view                            ; CALL $3A4D        ; recolour with A
       sb   a,a                                            ; XOR A             ; 
       movb a,@message_timer                               ; LD ($E919),A      ; 
       .call @tunnel_rings                                 ; CALL $6CB2        ; flash the dashboard
       movb @galactic_jump_flag,a                          ; LD A,($E925)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _8a05                                          ; JR Z,$8A05        ; not a galactic jump
       sb   a,a                                            ; XOR A             ; 
       movb a,@galactic_drive_fitted                       ; LD ($F780),A      ; the galactic hyperdrive is used up
       movb @current_galaxy,a                              ; LD A,($EB66)      ; A = galaxy number
       ab   one,a                                          ; INC A             ; 
       andi a,>0700                                        ; AND $07           ; galaxy number, mod 8
       movb a,@current_galaxy                              ; LD ($EB66),A      ; next galaxy (0-7)
       li   hl,galaxy_seeds                                ; LD HL,$E711       ; the galaxy seeds
       movb @bytes+>06,b                                   ; LD B,$06          ; 
_89e4:                                                     ; >89e4
       ; RLC (HL)                                          ; RLC (HL)          ; TODO: check code. rotate them
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $89E4        ; 
       jne  _89e4                                          ;                   
       li   bc,>6060                                       ; LD BC,$6060       ; the middle of the chart
       .call @nearest_and_furthest_systems                 ; CALL $5325        ; find the system nearest to it
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>12                                   ; CP $12            ; 
       jne  _8a05                                          ; JR NZ,$8A05       ; not following the Constrictor
       ab   one,a                                          ; INC A             ; 
       movb a,@mission_state                               ; LD ($E93D),A      ; state $13
       movb @selected_system,a                             ; LD A,($E72B)      ; the Constrictor's trail
       movb a,@mission_system                              ; LD ($EFA2),A      ; starts at the selected system
       movb @bytes+>05,a                                   ; LD A,$05          ; 
       movb a,@constrictor_trail_count                     ; LD ($EFA3),A      ; and is five systems long
_8a05:                                                     ; >8a05
       .call @reset_flight                                 ; CALL $707D        ; reset the flight variables
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _8a4d                                          ; JR Z,$8A4D        ; no malfunction
       mov  @current_system_x,de                           ; LD DE,($F760)     ; DE = the current system's coordinates
       movb @selected_system,a                             ; LD A,($E72B)      ; 
       .call @generate_system                              ; CALL $4C9B        ; generate the selected system
       mov  @system_x,bc                                   ; LD BC,($F751)     ; BC = its coordinates
       movb @c,a                                           ; LD A,C            ; 
       ab   @e,a                                           ; ADD A,E           ; 
       sra  a,1                                            ; RR A              ; TODO: check code. 
       movb a,@witchspace_position                         ; LD ($EEC3),A      ; witchspace is halfway between them
       movb b,a                                            ; LD A,B            ; 
       ab   d,a                                            ; ADD A,D           ; 
       sra  a,1                                            ; RR A              ; TODO: check code. 
       movb a,@witchspace_position_y                       ; LD ($EEC4),A      ; 
       movb @combat_rank,a                                 ; LD A,($EB12)      ; A = combat rank
       ab   one,a                                          ; INC A             ; 
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@witchspace_kills_needed                     ; LD ($EEC2),A      ; kills needed: (rank + 1) * 2
       movb @legal_status,a                                ; LD A,($EB65)      ; A = legal status
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       andi a,>0300                                        ; AND $03           ; 
       ab   one,a                                          ; INC A             ; 
       movb a,@witchspace_thargoids                        ; LD ($EEC5),A      ; Thargoids: 1-4
       .call @clear_all_ship_slots                         ; CALL $28D4        ; clear the object table
       li   hl,msg_drive_malfunction                       ; LD HL,$8C73       ; "Drive malfunction!"
       .call @show_view_message                            ; CALL $39C8        ; show it
       li   hl,hyperspace_fuel_cost                        ; LD HL,$E87F       ; 
       ; SRL (HL)                                          ; SRL (HL)          ; TODO: check code. half the fuel
       jmp  _8a76                                          ; JR $8A76          ; 
_8a4d:                                                     ; >8a4d
       movb @current_galaxy,a                              ; LD A,($EB66)      ; A = the galaxy number
       socb a,a                                            ; OR A              ; 
       jeq  _8a64                                          ; JR Z,$8A64        ; the first galaxy - no missions
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _8a64                                          ; JR NZ,$8A64       ; a mission under way
       li   hl,jumps_to_next_mission                       ; LD HL,$E93B       ; 
       sb   one,*hl                                        ; DEC (HL)          ; one fewer jump to the next mission
       jne  _8a64                                          ; JR NZ,$8A64       ; not yet zero
       movb @bytes+>40,*hl                                 ; LD (HL),$40       ; 64 jumps until the next one
       .call @start_next_mission                           ; CALL $908C        ; start the next mission
_8a64:                                                     ; >8a64
       .call @random_byte                                  ; CALL $2176        ; A = a random byte
       movb a,@market_price_roll                           ; LD ($EFAA),A      ; seed the market prices
       movb @selected_system,a                             ; LD A,($E72B)      ; 
       movb a,@current_system                              ; LD ($EB67),A      ; arrive at the selected system
       .call @arrive_in_system                             ; CALL $4BA8        ; build its market
       .call @place_planet_station_sun                     ; CALL $8C94        ; place the planet, sun and station
_8a76:                                                     ; >8a76
       sb   a,a                                            ; XOR A             ; 
       movb a,@hyperspace_target_selected                  ; LD ($E91A),A      ; no system selected
       li   hl,legal_status                                ; LD HL,$EB65       ; 
       ; SRL (HL)                                          ; SRL (HL)          ; TODO: check code. halve the legal status
       movb @fuel_level,a                                  ; LD A,($F775)      ; 
       li   hl,hyperspace_fuel_cost                        ; LD HL,$E87F       ; 
       sb   *hl,a                                          ; SUB (HL)          ; use the fuel
       movb a,@fuel_level                                  ; LD ($F775),A      ; 
       .call @redraw_all_dashboard_gauges                  ; CALL $6433        ; redraw the gauges
       movb @mission_state,a                               ; LD A,($E93D)      ; 
       cb   a,@bytes+>30                                   ; CP $30            ; 
       jeq  !                                              ; RET NZ            ; no fuel leak
       .ret                                                ;                   
!
       .call @clear_space_view                             ; CALL $388F        ; mission 3: a fuel leak - clear the space view
       movb @bytes+>f8,a                                   ; LD A,$F8          ; 
       .call @colour_space_view                            ; CALL $3A4D        ; colour its top row white on red
       li   hl,msg_fuel_leak                               ; LD HL,$8C69       ; "Fuel Leak!"
       .call @show_view_message                            ; CALL $39C8        ; show it
       .call @copy_space_view                              ; CALL $3846        ; copy the space view to the screen
       movb @bytes+>46,a                                   ; LD A,$46          ; 
       li   hl,fuel_level                                  ; LD HL,$F775       ; 
       sb   *hl,a                                          ; SUB (HL)          ; 
       .push af                                            ; PUSH AF           ; 
_8aaa:                                                     ; >8aaa
       li   hl,fuel_level                                  ; LD HL,$F775       ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  _8ab9                                          ; JR Z,$8AB9        ; 
       sb   one,*hl                                        ; DEC (HL)          ; drain the fuel gauge by 1
       .call @draw_fuel_gauge                              ; CALL $6AAD        ; redraw the fuel gauge
       .halt                                               ; HALT              ; 
       .halt                                               ; HALT              ; 
       jmp  _8aaa                                          ; JR $8AAA          ; 
_8ab9:                                                     ; >8ab9
