inventory_screen_headings:                                 ; >58d7
       text >10,>01,'Inventor',>f9                                ; 
       text >05,>03,'Fuel',>ba                                    ; 
       text >05,>04,'Cash',>ba                                    ; 
       text >05,>05,'Hold',>ba                                    ; 
