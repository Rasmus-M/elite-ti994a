       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; HL = the second (unscaled) component
       bl   @multiply_small_by_word                        ; CALL $48EC        ; multiply it against DE via #R$48EC
       .push af                                            ; PUSH AF           ; save the product's high byte (A)
       .push hl                                            ; PUSH HL           ; save the product's HL
