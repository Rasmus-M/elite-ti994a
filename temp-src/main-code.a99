       movb a,b                                            ; LD B,A            ; B = that bit count (loop counter)
       movb @face_scale,a                                  ; LD A,($E7E8)      ; A = the shared multiplier byte
       movb d,h                                            ; LD H,D            ; HL = 0 (the running product)
       movb d,@l                                           ; LD L,D            ; 
_485d:                                                     ; >485d
       srl  a,1                                            ; RRA               ; TODO: check code. shift the multiplier bit into carry
       jnc  _4861                                          ; JR NC,$4861       ; TODO: check code. clear - skip the add
       a    de,hl                                          ; ADD HL,DE         ; set - accumulate DE into the product
_4861:                                                     ; >4861
       ; SLA E                                             ; SLA E             ; TODO: check code. double DE (shift the double-and-add idiom along)...
       sla  d,1                                            ; RL D              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $485D        ; ...B times
       jne  _485d                                          ;                   
       .pop af                                             ; POP AF            ; restore the value's original sign
       movb h,@l                                           ; LD L,H            ; L = the product's high byte
       sb   h,h                                            ; LD H,$00          ; H = 0
       jlt  !                                              ; RET P             ; non-negative - return as-is
       .ret                                                ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...H:L = -H:L
       .ret                                                ; RET               ; return with the original sign reapplied

********************************************************************************
* Draw a ship: does a face face the player?
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Rotates the face's normal (#R$E7EA) into the view
* (#R$4464), scales it by the face's scale byte (#R$4847), and adds up
* its products with the ship's position (#R$48EC) - a dot product,
* negative if the face can be seen.
* 
* O:A,HL The dot product (A the high byte)
face_visible:                                              ; >4873
       .push hl                                            ; PUSH HL           ; save the caller's HL
       .call @rotate_vertex                                ; CALL $4464        ; transform the vector via #R$4464 (BC/DE/HL = its three components)
       mov  de,@rotated_vector                             ; LD ($E7EA),DE     ; cache the first component
       mov  bc,@rotated_vector_y                           ; LD ($E7EC),BC     ; cache the second component
       mov  hl,@rotated_vector_z                           ; LD ($E7EE),HL     ; cache the third component
       .ex_de_hl                                           ; EX DE,HL          ; HL = the first component
       .call @scale_normal_component                       ; CALL $4847        ; scale it via #R$4847
       .push hl                                            ; PUSH HL           ; save the scaled result
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; HL = the second component
       .call @scale_normal_component                       ; CALL $4847        ; scale it too
       .push hl                                            ; PUSH HL           ; save that result
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; HL = the third component
       .call @scale_normal_component                       ; CALL $4847        ; scale it too
       .pop bc                                             ; POP BC            ; BC = the second scaled result
       .pop de                                             ; POP DE            ; DE = the first scaled result
       .call @add_object_position                          ; CALL $44D2        ; combine (third scaled result in HL) with BC/DE via #R$44D2
       czc  @bit7,d                                        ; BIT 7,D           ; test D's sign bit
       jeq  _48a5                                          ; JR Z,$48A5        ; clear - skip the negate below
       sb   a,a                                            ; XOR A             ; set: negate DE...
       sb   @e,a                                           ; SUB E             ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow...
       sb   d,a                                            ; SUB D             ; 
       socb @bytes+>80,a                                   ; OR $80            ; ...and force the sign bit set (sign-magnitude form)
       movb a,d                                            ; LD D,A            ; 
_48a5:                                                     ; >48a5
       czc  @bit7,b                                        ; BIT 7,B           ; test B's sign bit
       jeq  _48b1                                          ; JR Z,$48B1        ; clear - skip the negate below
       sb   a,a                                            ; XOR A             ; set: negate BC...
       sb   @c,a                                           ; SUB C             ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow...
       sb   b,a                                            ; SUB B             ; 
       socb @bytes+>80,a                                   ; OR $80            ; ...and force the sign bit set
       movb a,b                                            ; LD B,A            ; 
_48b1:                                                     ; >48b1
       mov  bc,@face_visible_workspace_1                   ; LD ($E6EA),BC     ; cache the sign-magnitude BC
       czc  @bit7,h                                        ; BIT 7,H           ; test H's sign bit
       jeq  _48c1                                          ; JR Z,$48C1        ; clear - skip the negate below
       sb   a,a                                            ; XOR A             ; set: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow...
       sb   h,a                                            ; SUB H             ; 
       socb @bytes+>80,a                                   ; OR $80            ; ...and force the sign bit set
       movb a,h                                            ; LD H,A            ; 
_48c1:                                                     ; >48c1
       mov  hl,@face_visible_workspace_2                   ; LD ($E6EC),HL     ; cache the sign-magnitude HL
       mov  @rotated_vector,hl                             ; LD HL,($E7EA)     ; HL = the first (unscaled) component again
       .call @multiply_small_by_word                       ; CALL $48EC        ; multiply it against DE (the sign-magnitude D from above) via #R$48EC
       .push af                                            ; PUSH AF           ; save the product's high byte (A)
       .push hl                                            ; PUSH HL           ; save the product's HL
       mov  @face_visible_workspace_1,de                   ; LD DE,($E6EA)     ; DE = the cached sign-magnitude BC ($E6EA)
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; HL = the second (unscaled) component
       .call @multiply_small_by_word                       ; CALL $48EC        ; multiply it against DE via #R$48EC
       .push af                                            ; PUSH AF           ; save the product's high byte (A)
       .push hl                                            ; PUSH HL           ; save the product's HL
       mov  @face_visible_workspace_2,de                   ; LD DE,($E6EC)     ; DE = the cached sign-magnitude HL ($E6EC)
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; HL = the third (unscaled) component
       .call @multiply_small_by_word                       ; CALL $48EC        ; multiply it against DE via #R$48EC
       .pop de                                             ; POP DE            ; DE = the second product's HL
       .pop bc                                             ; POP BC            ; BC = the second product's high byte
       a    de,hl                                          ; ADD HL,DE         ; HL += DE (sum the second product in)
       ab   b,a                                            ; ADC A,B           ; A += B, with carry
       .pop de                                             ; POP DE            ; DE = the first product's HL
       .pop bc                                             ; POP BC            ; BC = the first product's high byte
       a    de,hl                                          ; ADD HL,DE         ; HL += DE (sum the first product in)
       ab   b,a                                            ; ADC A,B           ; A += B, with carry
       .pop hl                                             ; POP HL            ; restore the caller's HL
       .ret                                                ; RET               ; return with A:HL = the summed 24-bit accumulator

********************************************************************************
* Multiply a small signed number by a sign-magnitude word
* 
* Used by the routine at #R$4873.
* .
* Returns A:HL = L * DE, where L is a signed number from -128 to 127 (H
* being its sign, so only bit 7 of H matters) and DE is sign-magnitude.
* The sign of the result is the XOR of the two signs, kept in F' while the
* magnitudes are multiplied by shift and add (stopping once no bits of |L|
* are left); the result is a 24-bit two's complement number.
* 
* I:HL The first number (L, with H its sign)
* I:DE The second number (sign-magnitude)
* O:A:HL The product
multiply_small_by_word:                                    ; >48ec
       movb h,a                                            ; LD A,H            ; 
       ; XOR D                                             ; XOR D             ; TODO: check code. the sign of the product
       .ex_af_af_                                          ; EX AF,AF'         ; save it in F'
       szcb @bit7,d                                        ; RES 7,D           ; DE = |DE|
       czc  @bit7,h                                        ; BIT 7,H           ; L negative?
       jeq  _48f9                                          ; JR Z,$48F9        ; no
       movb @l,a                                           ; LD A,L            ; 
       neg a                                               ; NEG               ; 
       movb a,@l                                           ; LD L,A            ; yes: L = |L|
_48f9:                                                     ; >48f9
       movb @l,b                                           ; LD B,L            ; B = |L|, the multiplier
       sb   a,a                                            ; XOR A             ; 
       movb a,h                                            ; LD H,A            ; 
       movb a,@l                                           ; LD L,A            ; 
       movb a,@c                                           ; LD C,A            ; A:HL = 0, the product; C:DE = |DE|, which is shifted left
_48fe:                                                     ; >48fe
       srl  b,1                                            ; SRL B             ; shift the next bit out of the multiplier
       jnc  _4904                                          ; JR NC,$4904       ; TODO: check code. 0 - don't add
       a    de,hl                                          ; ADD HL,DE         ; 1: add C:DE to A:HL
       ab   @c,a                                           ; ADC A,C           ; 
_4904:                                                     ; >4904
       ; SLA E                                             ; SLA E             ; TODO: check code. shift C:DE left
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       ab   one,b                                          ; INC B             ; any bits left in the multiplier? (INC B then DJNZ tests B)
       sb   one,b                                          ; DJNZ $48FE        ; 
       jne  _48fe                                          ;                   
       movb a,@c                                           ; LD C,A            ; 
       .ex_af_af_                                          ; EX AF,AF'         ; the sign
       movb @c,a                                           ; LD A,C            ; A:HL = the product
       jlt  !                                              ; RET P             ; positive - done
       .ret                                                ;                   
!
       movb b,a                                            ; LD A,B            ; negative: A:HL = 0 - A:HL (B is 0 here)
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       movb b,a                                            ; LD A,B            ; 
       sb   h,a                                            ; SBC A,H           ; 
       movb a,h                                            ; LD H,A            ; 
       movb b,a                                            ; LD A,B            ; 
       sb   @c,a                                           ; SBC A,C           ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a ship: draw a face's edges
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. For each edge in the face's list (a count, then edge
* numbers), looks up its two vertices in the edge data (#R$F7F7) and,
* unless it has already been drawn (its flag at $E7B6, read and written by
* patching the displacement of an (IX+d) instruction), draws it (#R$496D)
* and marks it drawn. An edge whose first vertex has bit 7 set isn't drawn
* but flagged $FF and counted in $E6EE ($4948); when it turns up again
* ($4957) it's flagged 1 and the count goes down.
* .
* At $4969, moves on to the next edge.
draw_face_edges:                                           ; >491a
       movb *hl,b                                          ; LD B,(HL)         ; B = the number of edges
       inc  hl                                             ; INC HL            ; 
_491c:                                                     ; >491c
       movb *hl,a                                          ; LD A,(HL)         ; A = the next edge
       movb a,@draw_face_edge_flag+>0002                   ; LD ($4922),A      ; point (IX+d) at the edge's flag (#R$4920+2)
draw_face_edge_flag:                                       ; >4920
       movb @>05(ix),a                                     ; LD A,(IX+$05)     ; A = the edge's flag
       socb a,a                                            ; OR A              ; 
       jne  draw_face_edges_3                              ; JR NZ,$4957       ; already drawn or skipped
       .push hl                                            ; PUSH HL           ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       mov  @bp_edges,hl                                   ; LD HL,($F7F7)     ; HL = the edge data
       ab   a,a                                            ; ADD A,A           ; 
       ab   @l,a                                           ; ADD A,L           ; 
       movb a,@l                                           ; LD L,A            ; 
       joc  !                                              ; JP NC,$4932       ; TODO: check code. 
       b    @draw_face_edge                                ;                   
!
       ab   one,h                                          ; INC H             ; 
draw_face_edge:                                            ; >4932
       movb *hl,a                                          ; LD A,(HL)         ; A = the edge's first vertex
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$4948        ; bit 7 set - skip it
       b    @draw_face_edges_2                             ;                   
!
       movb a,@e                                           ; LD E,A            ; E = the first vertex
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; D = the second vertex
       .call @draw_edge                                    ; CALL $496D        ; draw the edge
       .pop hl                                             ; POP HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@draw_face_edge_drawn+>0002                  ; LD ($4944),A      ; point (IX+d) at the edge's flag (#R$4942+2)
draw_face_edge_drawn:                                      ; >4942
       movb one,@>05(ix)                                   ; LD (IX+$05),$01   ; the edge is drawn
       jmp  _4955                                          ; JR $4955          ; 
draw_face_edges_2:                                         ; >4948
       li   hl,skipped_edges_count                         ; LD HL,$E6EE       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more edge skipped
       .pop hl                                             ; POP HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@draw_face_edge_skipped+>0002                ; LD ($4953),A      ; point (IX+d) at the edge's flag (#R$4951+2)
draw_face_edge_skipped:                                    ; >4951
       movb @b255,*ix                                      ; LD (IX+$00),$FF   ; the edge is skipped
_4955:                                                     ; >4955
       jmp  draw_face_next_edge                            ; JR $4969          ; next edge
draw_face_edges_3:                                         ; >4957
       jlt  !                                              ; JP P,$4969        ; already drawn - next edge
       b    @draw_face_next_edge                           ;                   
!
       movb *hl,a                                          ; LD A,(HL)         ; skipped:
       movb a,@draw_face_edge_drawn_2+>0002                ; LD ($4960),A      ; point (IX+d) at the edge's flag (#R$495E+2)
draw_face_edge_drawn_2:                                    ; >495e
       movb one,*ix                                        ; LD (IX+$00),$01   ; the edge is drawn
       movb @skipped_edges_count,a                         ; LD A,($E6EE)      ; one fewer edge skipped
       sb   one,a                                          ; DEC A             ; 
       movb a,@skipped_edges_count                         ; LD ($E6EE),A      ; 
draw_face_next_edge:                                       ; >4969
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $491C        ; next edge
       jne  _491c                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Draw an edge
* 
* Used by the routine at #R$491A.
* .
* Projects vertex E (#R$49FD) and, if it's in front of the player, vertex D
* ($49B6), and draws the line between them (#R$3AC2). If vertex E is behind
* the player, draws a line worked out from vertex D alone (#R$4A5C,
* #R$47C4, #R$4B22) instead - or nothing if D is behind the player too.
* .
* At $49B6, with the first vertex projected ($EB92), projects the second
* (#R$49FD): if it's in front of the player, draws the edge ($49EE);
* otherwise clips the edge where it passes the player (#R$4A5C, #R$4B22)
* and draws that.
* .
* At $49EE, stores the second point (BC, HL) and draws the line (#R$3AC2).
* 
* I:D Second vertex
* I:E First vertex
draw_edge:                                                 ; >496d
       .push bc                                            ; PUSH BC           ; save the caller's BC
       .push ix                                            ; PUSH IX           ; and IX
       .push de                                            ; PUSH DE           ; save the vertex-index pair for later
       .call @project_vertex                               ; CALL $49FD        ; project vertex E
       joc  draw_edge_2                                    ; JR C,$49B6        ; TODO: check code. valid - go project the second vertex too
       mov  de,@line_end_1_x                               ; LD ($F769),DE     ; invalid: cache #R$49FD's raw output anyway (unused further here)
       mov  bc,@line_end_1_y                               ; LD ($F76B),BC     ; 
       mov  hl,@line_end_1_z                               ; LD ($F76D),HL     ; 
       .exx                                                ; EXX               ; (scratch use of the shadow set)
       movb @e,a                                           ; LD A,E            ; 
       movb a,@draw_edge_clear_flag_e+>0002                ; LD ($4988),A      ; point (IY+d) at vertex E's flag (#R$4986+2)
draw_edge_clear_flag_e:                                    ; >4986
       sb   *iy,*iy                                        ; LD (IY+$00),$00   ; clear the per-vertex cache flag for E
       .pop de                                             ; POP DE            ; DE = the original vertex-index pair
       movb d,a                                            ; LD A,D            ; A = the second vertex's index
       .call @vertex_relative                              ; CALL $4A5C        ; project it directly (no caching)
       jnc  _49b4                                          ; JR NC,$49B4       ; TODO: check code. also invalid - no edge to draw
       mov  de,@line_end_2_x                               ; LD ($F76F),DE     ; cache the raw projection
       mov  bc,@line_end_2_y                               ; LD ($F771),BC     ; 
       mov  hl,@line_end_2_z                               ; LD ($F773),HL     ; 
       .call @project_point                                ; CALL $47C4        ; finishing step -> point 1
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; -> point 1's X
       mov  de,@clip_point1_y                              ; LD ($EB94),DE     ; -> point 1's Y
       .call @clip_line_at_player                          ; CALL $4B22        ; a different finishing step -> point 2
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; -> point 2's X
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; -> point 2's Y
       .call @clip_and_draw_line                           ; CALL $3AC2        ; clip and draw the substitute edge
_49b4:                                                     ; >49b4
       jmp  _49f9                                          ; JR $49F9          ; join the shared return
draw_edge_2:                                               ; >49b6
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; point 1 = vertex E's projection (BC,HL from #R$49FD)
       mov  hl,@clip_point1_y                              ; LD ($EB94),HL     ; 
       .pop de                                             ; POP DE            ; DE = the original vertex-index pair
       .push de                                            ; PUSH DE           ; (peek, restore it)
       movb d,@e                                           ; LD E,D            ; E = the second vertex's index
       .call @project_vertex                               ; CALL $49FD        ; project it
       joc  draw_edge_draw_clipped                         ; JR C,$49EE        ; TODO: check code. valid - go store it as point 2 and draw
       mov  de,@line_end_1_x                               ; LD ($F769),DE     ; invalid: cache #R$49FD's raw output anyway
       mov  bc,@line_end_1_y                               ; LD ($F76B),BC     ; 
       mov  hl,@line_end_1_z                               ; LD ($F76D),HL     ; 
       .exx                                                ; EXX               ; (scratch use of the shadow set)
       movb @e,a                                           ; LD A,E            ; 
       movb a,@draw_edge_clear_flag_d+>0002                ; LD ($49D7),A      ; point (IY+d) at vertex D's flag (#R$49D5+2)
draw_edge_clear_flag_d:                                    ; >49d5
       sb   *iy,*iy                                        ; LD (IY+$00),$00   ; clear the per-vertex cache flag for D
       .pop de                                             ; POP DE            ; DE = the vertex-index pair again
       movb @e,a                                           ; LD A,E            ; A = the FIRST vertex's index (E, already known valid)
       .call @vertex_relative                              ; CALL $4A5C        ; project it directly (no caching)
       mov  de,@line_end_2_x                               ; LD ($F76F),DE     ; cache the raw projection
       mov  bc,@line_end_2_y                               ; LD ($F771),BC     ; 
       mov  hl,@line_end_2_z                               ; LD ($F773),HL     ; 
       .call @clip_line_at_player                          ; CALL $4B22        ; finishing step (only one here - see #R$49EF for where it lands)
       jmp  _49ef                                          ; JR $49EF          ; 
draw_edge_draw_clipped:                                    ; >49ee
       .pop de                                             ; POP DE            ; discard the saved vertex-index pair (draw is now unconditional)
_49ef:                                                     ; >49ef
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; point 2's X
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; point 2's Y
       .call @clip_and_draw_line                           ; CALL $3AC2        ; clip and draw
_49f9:                                                     ; >49f9
       .pop ix                                             ; POP IX            ; restore the caller's IX
       .pop bc                                             ; POP BC            ; and BC
       .ret                                                ; RET               ; 

********************************************************************************
* Project a vertex
* 
* Used by the routine at #R$496D.
* .
* Each vertex is projected at most once per frame: if its flag in the table
* at IY (#R$E784, read by patching the displacement of an (IY+d) instruction)
* is set, its screen position is read back from the vertex cache (#R$E61D, at $4A4C). Otherwise the vertex (6 bytes, from #R$F7F5) is rotated into
* the view (#R$4464), added to the ship's position (#R$44D2) and, if it's
* in front of the player, projected (#R$47C4) and cached.
* .
* At $4A4C, reads the cached position from $E6C8 + E * 4, and returns with
* carry set (only vertices in front of the player are cached).
* 
* I:E Vertex number
* O:F Carry set if it's in front of the player
* O:BC,HL Its screen position
project_vertex:                                            ; >49fd
       movb @e,a                                           ; LD A,E            ; A = the vertex index
       movb a,@project_vertex_flag+>0002                   ; LD ($4A03),A      ; patch the (IY+d) read to (IY+E) (#R$4A01+2)
project_vertex_flag:                                       ; >4a01
       movb *iy,a                                          ; LD A,(IY+$00)     ; A = this vertex's cache flag
       socb a,a                                            ; OR A              ; 
       jne  project_vertex_from_cache                      ; JR NZ,$4A4C       ; already cached - read it back
       movb @e,a                                           ; LD A,E            ; not cached: A = the vertex index again
       movb a,@project_vertex_set_flag+>0002               ; LD ($4A0D),A      ; patch the (IY+d) write to (IY+E) (#R$4A0B+2)
project_vertex_set_flag:                                   ; >4a0b
       movb @b255,@>05(iy)                                 ; LD (IY+$05),$FF   ; set a second, fixed-offset flag
       .exx                                                ; EXX               ; (scratch use of the shadow set)
       mov  @bp_vertices,hl                                ; LD HL,($F7F5)     ; HL = the vector-record table's base pointer
       ab   a,a                                            ; ADD A,A           ; A = index * 2
       movb a,@c                                           ; LD C,A            ; C = it
       sb   b,b                                            ; LD B,$00          ; BC = index * 2, widened
       ab   a,a                                            ; ADD A,A           ; A = index * 4
       movb a,@vertex_cache_slot                           ; LD ($E6C8),A      ; low byte of this vertex's cache-slot pointer
       ab   @l,a                                           ; ADD A,L           ; A += table base low byte
       movb a,@l                                           ; LD L,A            ; L = table base low byte + index*4
       joc  !                                              ; JP NC,$4A21       ; TODO: check code. no carry - skip the high-byte bump
       b    @project_vertex_record                         ;                   
!
       ab   one,h                                          ; INC H             ; carry into the high byte
project_vertex_record:                                     ; >4a21
       a    bc,hl                                          ; ADD HL,BC         ; HL = table base + index*4 + index*2 = + index*6 (6 bytes/record)
       li   de,rotated_vector                              ; LD DE,$E7EA       ; DE -> the shared vector staging buffer
       .ldi                                                ; LDI               ; copy the 6-byte record...
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; ...done
       .call @rotate_vertex                                ; CALL $4464        ; combine via #R$4464
       .call @add_object_position                          ; CALL $44D2        ; combine that result via #R$44D2
       movb h,a                                            ; LD A,H            ; test the combined result's sign
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; RET M             ; negative - no valid projection, carry clear
       .ret                                                ;                   
!
       socb @l,a                                           ; OR L              ; exactly zero?
       jne  !                                              ; RET Z             ; yes - no valid projection, carry clear
       .ret                                                ;                   
!
       .call @project_point                                ; CALL $47C4        ; finish the projection
       mov  @vertex_cache_slot,hl                          ; LD HL,($E6C8)     ; HL -> this vertex's cache slot
       movb @c,*hl                                         ; LD (HL),C         ; cache (C,B,E,D) - the projected point
       ab   one,@l                                         ; INC L             ; 
       movb b,*hl                                          ; LD (HL),B         ; 
       ab   one,@l                                         ; INC L             ; 
       movb @e,*hl                                         ; LD (HL),E         ; 
       ab   one,@l                                         ; INC L             ; 
       movb d,*hl                                          ; LD (HL),D         ; 
       .ex_de_hl                                           ; EX DE,HL          ; HL = the projected point's second word
       ; SCF                                               ; SCF               ; TODO: check code. carry set - valid
       .ret                                                ; RET               ; 
project_vertex_from_cache:                                 ; >4a4c
       movb @e,a                                           ; LD A,E            ; A = the vertex index
       ab   a,a                                            ; ADD A,A           ; A *= 4 (2 doublings)...
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@l                                           ; LD L,A            ; L = the slot offset within the $E6xx page
       movb @bytes+>e6,h                                   ; LD H,$E6          ; H = the page - HL -> this vertex's cache slot
       movb *hl,@c                                         ; LD C,(HL)         ; C = the slot's first byte
       ab   one,@l                                         ; INC L             ; 
       movb *hl,b                                          ; LD B,(HL)         ; B = the second byte - BC is the first cached word
       ab   one,@l                                         ; INC L             ; 
       movb *hl,@e                                         ; LD E,(HL)         ; E = the third byte
       ab   one,@l                                         ; INC L             ; 
       movb *hl,d                                          ; LD D,(HL)         ; D = the fourth byte - DE is the second cached word
       .ex_de_hl                                           ; EX DE,HL          ; HL = the second cached word (DE becomes a leftover pointer, unused)
       ; SCF                                               ; SCF               ; TODO: check code. carry set - always valid
       .ret                                                ; RET               ; 

********************************************************************************
* Get a vertex relative to the player
* 
* Used by the routines at #R$43C2 and #R$496D.
* .
* Copies vertex A (6 bytes, from #R$F7F5) to #R$E7EA, rotates it into the
* view (#R$4464) and adds the object's position (#R$44D2).
* 
* I:A Vertex number
* O:DE,BC,HL x, y and z
* O:F Carry set if it's in front of the player (z positive)
vertex_relative:                                           ; >4a5c
       mov  @bp_vertices,hl                                ; LD HL,($F7F5)     ; HL = the vector-record table's base pointer
       ab   a,a                                            ; ADD A,A           ; A = the record index * 2
       movb a,@c                                           ; LD C,A            ; C = that doubled index
       sb   b,b                                            ; LD B,$00          ; B = 0 (widen to BC)
       ab   a,a                                            ; ADD A,A           ; A = the index * 4
       ab   @l,a                                           ; ADD A,L           ; A += the table base's low byte
       movb a,@l                                           ; LD L,A            ; L = table base low byte + index*4
       joc  !                                              ; JP NC,$4A6A       ; TODO: check code. no carry from that add - skip the high-byte bump
       b    @vertex_relative_record                        ;                   
!
       ab   one,h                                          ; INC H             ; else carry into the high byte
vertex_relative_record:                                    ; >4a6a
       a    bc,hl                                          ; ADD HL,BC         ; HL = table base + index*4 + index*2 = table base + index*6
       li   de,rotated_vector                              ; LD DE,$E7EA       ; DE -> the $E7EA staging buffer
       .ldi                                                ; LDI               ; copy 6 bytes from the record into the staging buffer...
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .call @rotate_vertex                                ; CALL $4464        ; combine the copied vector via #R$4464
       .call @add_object_position                          ; CALL $44D2        ; combine that result with cached deltas via #R$44D2
       jne  !                                              ; RET Z             ; zero (from #R$44D2's result) - return with its data-dependent carry
       .ret                                                ;                   
!
       movb h,a                                            ; LD A,H            ; A = the combined result's high byte
       socb a,a                                            ; OR A              ; test its sign (also clears carry)
       jhe  !                                              ; RET M             ; negative - return with carry clear
       .ret                                                ;                   
!
       ; SCF                                               ; SCF               ; TODO: check code. non-negative - set carry
       .ret                                                ; RET               ; and return with carry set

********************************************************************************
* Draw a ship: too small or far away
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Draws the object as a circle of its radius on screen
* (#R$EB9E): the planet as an outline (#R$3D0E), anything else - the sun,
* or a distant ship - as a filled disc (#R$3DF4).
draw_small:                                                ; >4a86
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; HL = the cached range value (see #R$4735/#R$4738)
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>64                                   ; CP $64            ; is it mode $64?
       jeq  !                                              ; JP NZ,$3DF4       ; no - dispatch to #R$3DF4
       b    @draw_disc                                     ;                   
!
       li   de,>0002                                       ; LD DE,$0002       ; yes: DE = 2
       movb @bytes+>0a,b                                   ; LD B,$0A          ; B = 10
       b    @draw_circle                                   ; JP $3D0E          ; dispatch to #R$3D0E instead

********************************************************************************
* Draw a ship: is it on screen?
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Checks whether the object's circle on screen - its
* position (BC, DE) and radius (#R$EB9E) - overlaps the view, which runs
* from x = -116 to 118 and y = -63 to 65 (the edges at $E6E0-$E6E6 are
* biased by $8000).
* 
* I:BC x on screen
* I:DE y on screen
* O:A $FF if it's on screen, 0 if not
on_screen:                                                 ; >4a99
       movb @bytes+>80,a                                   ; LD A,$80          ; A = $80
       ab   d,a                                            ; ADD A,D           ; sign-flip D (of DE, the second scaled result)...
       movb a,d                                            ; LD D,A            ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; A = $80 again
       ab   b,a                                            ; ADD A,B           ; sign-flip B (of BC, the first scaled result)...
       movb a,b                                            ; LD B,A            ; 
       .push de                                            ; PUSH DE           ; save the sign-flipped D and original E
       mov  @screen_radius,de                              ; LD DE,($EB9E)     ; DE = the cached range value (see #R$4735/#R$4738)
       movb b,h                                            ; LD H,B            ; HL = the sign-flipped B, original C
       movb @c,@l                                          ; LD L,C            ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = (flipped-B:C) - range
       mov  hl,@on_screen_left                             ; LD ($E6E0),HL     ; store the lower bound
       movb b,h                                            ; LD H,B            ; HL = (flipped-B:C) again
       movb @c,@l                                          ; LD L,C            ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = (flipped-B:C) + range
       mov  hl,@on_screen_right                            ; LD ($E6E2),HL     ; store the upper bound
       .pop bc                                             ; POP BC            ; BC = the sign-flipped D, original E (saved above)
       movb b,h                                            ; LD H,B            ; HL = that pair
       movb @c,@l                                          ; LD L,C            ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = (flipped-D:E) - range
       mov  hl,@on_screen_bottom                           ; LD ($E6E6),HL     ; store a second lower bound
       movb b,h                                            ; LD H,B            ; HL = (flipped-D:E) again
       movb @c,@l                                          ; LD L,C            ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = (flipped-D:E) + range
       mov  hl,@on_screen_top                              ; LD ($E6E4),HL     ; store a second upper bound
       sb   a,a                                            ; XOR A             ; A = 0 (the "out of range" return value)
       mov  @on_screen_left,hl                             ; LD HL,($E6E0)     ; HL = the first lower bound
       li   de,>8076                                       ; LD DE,$8076       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $8076
       joc  !                                              ; RET NC            ; TODO: check code. still >= - out of range, return with A=0
       .ret                                                ;                   
!
       mov  @on_screen_right,hl                            ; LD HL,($E6E2)     ; HL = the first upper bound
       li   de,>7f8c                                       ; LD DE,$7F8C       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $7F8C
       jnc  !                                              ; RET C             ; TODO: check code. below it - out of range, return with A=0
       .ret                                                ;                   
!
       mov  @on_screen_top,hl                              ; LD HL,($E6E4)     ; HL = the second upper bound
       li   de,>7fc1                                       ; LD DE,$7FC1       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $7FC1
       jnc  !                                              ; RET C             ; TODO: check code. below it - out of range, return with A=0
       .ret                                                ;                   
!
       mov  @on_screen_bottom,hl                           ; LD HL,($E6E6)     ; HL = the second lower bound
       li   de,>8041                                       ; LD DE,$8041       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $8041
       joc  !                                              ; RET NC            ; TODO: check code. still >= - out of range, return with A=0
       .ret                                                ;                   
!
       sb   one,a                                          ; DEC A             ; all four checks passed - A = $FF (in range)
       .ret                                                ; RET               ; return with A nonzero

********************************************************************************
* Draw an explosion
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Draws a cloud of dots: one for each of the next
* ($F7EF + 1, at most 50) random offsets in the table at $EEC6 (#R$47A1),
* each multiplied by the explosion's size (#R$F7F0, as a logarithm at
* #R$EB90), added to its position (#R$44D2), projected (#R$47C4) and
* plotted (#R$3DD7). As the explosion's countdown runs out there are
* fewer dots, and they spread as the size grows (#R$2556).
draw_explosion:                                            ; >4aec
       movb @per_type_parameter_block,a                    ; LD A,($F7F0)      ; A = the table index at $F7F0
       ab   a,a                                            ; ADD A,A           ; A *= 2 - 2 bytes per entry
       movb a,@l                                           ; LD L,A            ; L = that offset
       sb   a,a                                            ; LD A,$00          ; A = 0
       ab   @bytes+>08,a                                   ; ADC A,$08         ; A = 8 + the carry from doubling - the page selector (same idiom as #R$1FCF)
       movb a,h                                            ; LD H,A            ; H = the page (8 or 9)
       li   de,perentry_loop_pointer                       ; LD DE,$EB90       ; DE -> $EB90, #R$47A1's pointer input
       .ldi                                                ; LDI               ; copy the entry's first byte to $EB90 (BC isn't set up first - each LDI just decrements whatever BC the caller left)
       .ldi                                                ; LDI               ; copy the entry's second byte to $EB91 (same - BC is now that caller value minus 2, unused as a counter)
       li   hl,explosion_random_numbers                    ; LD HL,$EEC6       ; HL = $EEC6 - the list #R$47A1 walks
       mov  hl,@explosion_random_pointer                   ; LD ($E6DE),HL     ; store it to $E6DE
       movb @handler_countdown,a                           ; LD A,($F7EF)      ; A = a count at $F7EF
       ab   one,a                                          ; INC A             ; A += 1
       cb   a,@bytes+>32                                   ; CP $32            ; compare against 50
       jl   _4b0d                                          ; JR C,$4B0D        ; below 50 - keep it
       movb @bytes+>32,a                                   ; LD A,$32          ; else clamp to 50
_4b0d:                                                     ; >4b0d
       movb a,b                                            ; LD B,A            ; B = the clamped loop count
_4b0e:                                                     ; >4b0e
       .push bc                                            ; PUSH BC           ; save BC across this iteration's calls
       .call @explosion_dot                                ; CALL $47A1        ; the next dot's offset (#R$47A1)
       .call @add_object_position                          ; CALL $44D2        ; add the explosion's position (#R$44D2)
       .call @project_point                                ; CALL $47C4        ; project it (#R$47C4)
       .ex_de_hl                                           ; EX DE,HL          ; HL = y on screen
       movb b,d                                            ; LD D,B            ; 
       movb @c,@e                                          ; LD E,C            ; DE = x on screen
       .call @clip_test_and_plot_single_point              ; CALL $3DD7        ; plot the dot (#R$3DD7)
       .pop bc                                             ; POP BC            ; restore the loop counter
       sb   one,b                                          ; DJNZ $4B0E        ; loop
       jne  _4b0e                                          ;                   
       .ret                                                ; RET               ; done

********************************************************************************
* Clip a line where it passes the player
* 
* Used by the routines at #R$43C2 and #R$496D.
* .
* For a line from a point behind the player (#R$F769) to one in front
* (#R$F76F), finds where it crosses z = 1 - a fraction (1 - z1) / (z2 - z1)
* of the way along (#R$4B76) - and projects that point.
* 
* O:BC,HL The point on screen
clip_line_at_player:                                       ; >4b22
       mov  @line_end_2_z,hl                               ; LD HL,($F773)     ; HL = the front end's z
       mov  @line_end_1_z,de                               ; LD DE,($F76D)     ; DE = the back end's z
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = z2 - z1
       jlt  !                                              ; JP P,$4B35        ; non-negative - keep it
       b    @clip_line_dz                                  ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...HL = |z2 - z1|
clip_line_dz:                                              ; >4b35
       .ex_de_hl                                           ; EX DE,HL          ; DE = that absolute difference
       li   hl,>0001                                       ; LD HL,$0001       ; HL = 1
       mov  @line_end_1_z,bc                               ; LD BC,($F76D)     ; BC = z1
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; HL = 1 - z1
       jlt  !                                              ; JP P,$4B49        ; non-negative - keep it
       b    @clip_line_divide                              ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...HL = |1 - z1|
clip_line_divide:                                          ; >4b49
       sb   a,a                                            ; XOR A             ; A = 0 (division setup)
       movb h,@c                                           ; LD C,H            ; C = H
       movb a,b                                            ; LD B,A            ; B = 0
       sb   @l,a                                           ; SUB L             ; A -= L
       s    bc,hl                                          ; SBC HL,BC         ; HL -= BC, with the borrow from above
       movb @bytes+>08,b                                   ; LD B,$08          ; B = 8 (loop count)
_4b51:                                                     ; >4b51
       sla  a,1                                            ; RLA               ; TODO: check code. rotate A left through carry...
       a    hl,hl                                          ; ADC HL,HL         ; ...and HL left, pulling that bit in
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE (the difference computed earlier)
       jnc  _4b59                                          ; JR NC,$4B59       ; TODO: check code. still non-negative - keep the subtraction
       a    de,hl                                          ; ADD HL,DE         ; else undo it (add DE back)
_4b59:                                                     ; >4b59
       sb   one,b                                          ; DJNZ $4B51        ; loop 8 times (one division bit per iteration)
       jne  _4b51                                          ;                   
       sla  a,1                                            ; RLA               ; TODO: check code. shift the last quotient bit into A
       inv  a                                              ; CPL               ; A = 256 * |1 - z1| / |z2 - z1|, the fraction of the way along
       mov  @line_end_2_y,hl                               ; LD HL,($F771)     ; HL = y2
       mov  @line_end_1_y,de                               ; LD DE,($F76B)     ; DE = y1
       .call @lerp_towards                                 ; CALL $4B76        ; HL = y1 + (y2 - y1) * A / 256 (#R$4B76)
       .push hl                                            ; PUSH HL           ; save it
       mov  @line_end_2_x,hl                               ; LD HL,($F76F)     ; HL = x2
       mov  @line_end_1_x,de                               ; LD DE,($F769)     ; DE = x1
       .call @lerp_towards                                 ; CALL $4B76        ; HL = x1 + (x2 - x1) * A / 256
       movb h,b                                            ; LD B,H            ; BC = x
       movb @l,@c                                          ; LD C,L            ; 
       .pop hl                                             ; POP HL            ; HL = y
       .ret                                                ; RET               ; 

********************************************************************************
* Linear interpolation: DE + (HL-DE) * A/256
* 
* Used by the routine at #R$4B22.
* .
* Moves A/256 of the way from DE towards HL - a standard lerp/easing
* step. A is an unsigned 0-255 fraction (0 leaves DE unchanged, 255
* lands one 256th short of HL); the sign of (HL-DE) is preserved
* through the #R$1F86 multiply by working in sign-magnitude form and
* only truncating (not rounding) the low byte of the product, unlike
* #R$24D1/#R$848D's rounded scaling.
* 
* I:A Unsigned interpolation fraction, 0-255 (0=DE, 255~HL)
* I:HL Target value
* I:DE Starting value
* O:HL Interpolated result
lerp_towards:                                              ; >4b76
       .push af                                            ; PUSH AF           ; Save the caller's A/flags for the final RET
       .push de                                            ; PUSH DE           ; Save DE (the starting value) for the final add
       .ex_af_af_                                          ; EX AF,AF'         ; Stash the interpolation fraction
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL := HL - DE
       .push af                                            ; PUSH AF           ; Save the difference's sign for later
       jlt  !                                              ; JP P,$4B86        ; 
       b    @lerp_multiply                                 ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; HL := |HL-DE|
lerp_multiply:                                             ; >4b86
       .ex_af_af_                                          ; EX AF,AF'         ; Recover the interpolation fraction
       .call @multiply_16x8                                ; CALL $1F86        ; A:HL := |HL-DE| * A (24-bit product)
       movb h,@l                                           ; LD L,H            ; 
       movb a,h                                            ; LD H,A            ; Keep the product's top 16 bits (product >> 8), truncated
       .pop af                                             ; POP AF            ; Recover the difference's sign
       jlt  !                                              ; JP P,$4B96        ; 
       b    @lerp_add                                      ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; Reapply the sign of (HL-DE)
lerp_add:                                                  ; >4b96
       .pop de                                             ; POP DE            ; DE := the original starting value
       a    de,hl                                          ; ADD HL,DE         ; HL := DE + (HL-DE)*A/256
       .pop af                                             ; POP AF            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* The message "Missile Locked"
msg_missile_locked:                                        ; >4b9a
       text 'MISSILE LOCKE',>e4

********************************************************************************
* Arrive in a system: its data and market
* 
* Used by the routines at #R$894D and #R$A469.
* .
* Generates the data for the current system (#R$EB67, #R$4C9B) and copies
* it to #R$F75A. Sets the price of fuel ($E724) to s0_lo AND 15. Then works
* out the market (#R$F789) from the market prices (#R$0A02), as BBC Elite
* does, with E = 7 - the economy (#R$F754) and a random byte (#R$EFAA) for
* the variation: for each of the goods, the price is the base price +
* (random AND mask) + E * factor, and the quantity the base quantity +
* (random AND mask) - E * factor (0-63, or 0 if negative).
arrive_in_system:                                          ; >4ba8
       movb @current_system,a                              ; LD A,($EB67)      ; A = the current system
       .call @generate_system                              ; CALL $4C9B        ; generate the current system
       li   hl,system_s0_lo                                ; LD HL,$F74B       ; 
       li   de,current_system_seeds                        ; LD DE,$F75A       ; 
       li   bc,>000f                                       ; LD BC,$000F       ; 15 bytes
       .ldir                                               ; LDIR              ; copy its data to $F75A
       movb @system_economy,a                              ; LD A,($F754)      ; A = economy
       li   r0,7*256                                       ; XOR $07           ; E = 7 - economy (0 for Rich Industrial, 7 for Poor Agricultural)
       xor  r0,a                                           ;                   
       movb a,@e                                           ; LD E,A            ; 
       movb @system_seeds,a                                ; LD A,($E904)      ; rotating_accumulator's low byte
       andi a,>0f00                                        ; AND $0F           ; 
       movb a,@fuel_price                                  ; LD ($E724),A      ; the price of fuel
       li   ix,market_prices                               ; LD IX,$0A02       ; IX -> the market prices
       li   iy,market                                      ; LD IY,$F789       ; IY -> the market
       movb @market_price_roll,a                           ; LD A,($EFAA)      ; C = random byte
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>11,b                                   ; LD B,$11          ; 17 goods
_4bd5:                                                     ; >4bd5
       .push bc                                            ; PUSH BC           ; 
       .push de                                            ; PUSH DE           ; 
       movb @>03(ix),a                                     ; LD A,(IX+$03)     ; 
       ; AND C                                             ; AND C             ; TODO: check code. L = random AND mask
       movb a,@l                                           ; LD L,A            ; 
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; 
       andi a,>1f00                                        ; AND $1F           ; 
       movb a,d                                            ; LD D,A            ; D = factor
       .call @multiply_d_e_8bit                            ; CALL $1F51        ; A = E * factor
       movb a,@c                                           ; LD C,A            ; 
       movb b,h                                            ; LD H,B            ; 
       .push hl                                            ; PUSH HL           ; 
       a    bc,hl                                          ; ADD HL,BC         ; DE = random AND mask + E * factor
       .ex_de_hl                                           ; EX DE,HL          ; 
       .pop hl                                             ; POP HL            ; 
       s    bc,hl                                          ; SBC HL,BC         ; HL = random AND mask - E * factor
       movb @>01(ix),r0                                    ; BIT 7,(IX+$01)    ; this record's sign bit?
       andi r0,>8000                                       ;                   
       jne  _4bf4                                          ; JR NZ,$4BF4       ; a negative factor
       .ex_de_hl                                           ; EX DE,HL          ; a positive factor: swap them
_4bf4:                                                     ; >4bf4
       movb *ix,@c                                         ; LD C,(IX+$00)     ; 
       a    bc,hl                                          ; ADD HL,BC         ; add the base price
       movb @l,*iy                                         ; LD (IY+$00),L     ; price
       movb @>02(ix),@c                                    ; LD C,(IX+$02)     ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       a    bc,hl                                          ; ADD HL,BC         ; add the base quantity
       movb @l,a                                           ; LD A,L            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$4C08        ; 
       b    @arrive_in_system_2                            ;                   
!
       sb   a,a                                            ; XOR A             ; negative - none
       jmp  _4c0a                                          ; JR $4C0A          ; 
arrive_in_system_2:                                        ; >4c08
       andi a,>3f00                                        ; AND $3F           ; 0-63
_4c0a:                                                     ; >4c0a
       movb a,@>01(iy)                                     ; LD (IY+$01),A     ; quantity
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; 
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       andi a,>0300                                        ; AND $03           ; 
       movb a,@>02(iy)                                     ; LD (IY+$02),A     ; units
       movb @>04(ix),a                                     ; LD A,(IX+$04)     ; 
       movb a,@>03(iy)                                     ; LD (IY+$03),A     ; how illegal
       li   bc,>0005                                       ; LD BC,$0005       ; 
       a    bc,ix                                          ; ADD IX,BC         ; next of the goods
       sb   one,@c                                         ; DEC C             ; 
       a    bc,iy                                          ; ADD IY,BC         ; 
       .pop de                                             ; POP DE            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $4BD5        ; 
       jne  _4bd5                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Work out a system's data from its seeds
* 
* Used by the routines at #R$4C9B and #R$55A3.
* .
* Copies the seeds (#R$E904) to #R$F74B, and works out the system's
* coordinates (#R$F751, #R$F752), government (#R$F753), economy
* (#R$F754) and tech level (#R$F755), then its name (#R$4CE7).
system_data_from_seeds:                                    ; >4c2b
       li   hl,system_seeds                                ; LD HL,$E904       ; source: rotating_accumulator
       li   de,system_s0_lo                                ; LD DE,$F74B       ; 
       li   bc,>0006                                       ; LD BC,$0006       ; 6 bytes
       .ldir                                               ; LDIR              ; copy the seeds
       movb @seed_s0_hi,a                                  ; LD A,($E905)      ; A = s0_hi
       srl  a,1                                            ; SRL A             ; 
       movb a,@system_y                                    ; LD ($F752),A      ; y = s0_hi / 2
       movb @seed_s1_hi,a                                  ; LD A,($E907)      ; A = s1_hi
       movb @bytes+>fc,@e                                  ; LD E,$FC          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       ab   h,a                                            ; ADD A,H           ; 
       movb a,@system_x                                    ; LD ($F751),A      ; x = 2 + s1_hi * 252 / 256
       movb @seed_s1,a                                     ; LD A,($E906)      ; A = s1_lo
       srl  a,1                                            ; RRCA              ; TODO: check code. 
       srl  a,1                                            ; RRCA              ; TODO: check code. 
       srl  a,1                                            ; RRCA              ; TODO: check code. 
       andi a,>0700                                        ; AND $07           ; 
       movb a,@system_government                           ; LD ($F753),A      ; government = bits 3-5 of s1_lo
       cb   a,@bytes+>02                                   ; CP $02            ; 
       sb   a,a                                            ; SBC A,A           ; 
       andi a,>0200                                        ; AND $02           ; 
       movb a,@c                                           ; LD C,A            ; C = 2 for Anarchy or Feudal, 0 otherwise
       movb @seed_s0_hi,a                                  ; LD A,($E905)      ; 
       andi a,>0700                                        ; AND $07           ; 
       socb @c,a                                           ; OR C              ; 
       li   r0,7*256                                       ; XOR $07           ; 
       xor  r0,a                                           ;                   
       movb a,@system_economy                              ; LD ($F754),A      ; economy
       ab   @bytes+>03,a                                   ; ADD A,$03         ; 
       li   hl,seed_s1_hi                                  ; LD HL,$E907       ; 
       ; AND (HL)                                          ; AND (HL)          ; TODO: check code. 
       movb a,b                                            ; LD B,A            ; 
       movb @seed_s2,a                                     ; LD A,($E908)      ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       movb b,a                                            ; LD A,B            ; 
       ab   @zero,a                                        ; ADC A,$00         ; 
       movb a,@system_tech_level                           ; LD ($F755),A      ; tech level
       li   ix,system_name                                 ; LD IX,$F756       ; 
       b    @system_name_from_seeds                        ; JP $4CE7          ; work out the name

********************************************************************************
* Get the coordinates of the next system
* 
* Used by the routines at #R$4D0B, #R$502C and #R$5325.
* .
* Works out the current system's coordinates from the seeds at #R$E904,
* as #R$4C2B does, and moves the seeds on to the next system (#R$5613).
* Used for going through all 256 systems in turn.
* 
* O:B y coordinate
* O:C x coordinate
next_system_coordinates:                                   ; >4c80
       .exx                                                ; EXX               ; switch to the shadow register set
       movb @seed_s0_hi,a                                  ; LD A,($E905)      ; 
       srl  a,1                                            ; SRL A             ; y = s0_hi / 2
       .push af                                            ; PUSH AF           ; 
       movb @seed_s1_hi,a                                  ; LD A,($E907)      ; 
       movb @bytes+>fc,@e                                  ; LD E,$FC          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       ab   h,a                                            ; ADD A,H           ; x = 2 + s1_hi * 252 / 256
       .push af                                            ; PUSH AF           ; 
       .call @next_system_seeds                            ; CALL $5613        ; move on to the next system
       .exx                                                ; EXX               ; back to the main register set
       .pop af                                             ; POP AF            ; 
       .pop bc                                             ; POP BC            ; recover the $F752-style byte (in B)
       movb a,@c                                           ; LD C,A            ; C = x, B = y
       .ret                                                ; RET               ; 

********************************************************************************
* Generate the data for a system
* 
* Used by the routines at #R$4BA8, #R$4CAF, #R$4DAB, #R$4F64, #R$538B, #R$53ED,
* #R$53FD, #R$6141 and #R$894D.
* .
* As in BBC Elite, each system's seeds are those of the one before,
* twisted four times: starts from the galaxy's seeds (#R$5607), twists
* them 4 * A times (#R$5613), and works out the system's data from the
* result (#R$4C2B). Preserves BC, DE and HL.
* 
* I:A System number (0-255)
generate_system:                                           ; >4c9b
       .exx                                                ; EXX               ; 
       .call @galaxy_seeds_to_system                       ; CALL $5607        ; start from the galaxy's seeds
       socb a,a                                            ; OR A              ; 
       jeq  _4caa                                          ; JR Z,$4CAA        ; system 0
_4ca2:                                                     ; >4ca2
       .ex_af_af_                                          ; EX AF,AF'         ; 
       .call @next_system_seeds                            ; CALL $5613        ; move on to the next system
       .ex_af_af_                                          ; EX AF,AF'         ; 
       sb   one,a                                          ; DEC A             ; 
       jne  _4ca2                                          ; JR NZ,$4CA2       ; 
_4caa:                                                     ; >4caa
       .call @system_data_from_seeds                       ; CALL $4C2B        ; work out the system's data
       .exx                                                ; EXX               ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Generate a system's name
* 
* Used by the routines at #R$4F64, #R$52CE, #R$6066, #R$6164, #R$6276, #R$9120,
* #R$91AA, #R$9A4B, #R$9B43 and #R$9B7C.
* .
* Generates the data for system A (#R$4C9B), then expands its name from
* the digram indices at $F756 into #R$E717 (#R$4CB8).
* 
* I:A System number
* O:A Length of the name
generate_system_name:                                      ; >4caf
       .call @generate_system                              ; CALL $4C9B        ; 
       li   hl,system_name                                 ; LD HL,$F756       ; 
       b    @expand_name                                   ; JP $4CB8          ; 

********************************************************************************
* Expand a name from its letter pairs
* 
* Used by the routines at #R$4CAF, #R$55A3 and #R$9B7C.
* .
* Builds a name in #R$E717 from the four letter-pair indices at HL (0-31,
* into the table at #R$0E41), leaving out spaces (so index 0 adds
* nothing), and capitalises its first letter. Used for system names
* (#R$4CAF, #R$55D2) and the random names in descriptions (#R$9B7C).
* 
* I:HL The four indices
* O:A The name's length
expand_name:                                               ; >4cb8
       li   de,text_buffer                                 ; LD DE,$E717       ; DE -> the output buffer
       sb   @c,@c                                          ; LD C,$00          ; C = output character count
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 index bytes
_4cbf:                                                     ; >4cbf
       movb *hl,a                                          ; LD A,(HL)         ; A = the next index byte
       inc  hl                                             ; INC HL            ; 
       .push hl                                            ; PUSH HL           ; 
       ab   a,a                                            ; ADD A,A           ; HL = $0E41 + 2*A: this index's digram entry
       ab   @bytes+>41,a                                   ; ADD A,$41         ; 
       movb a,@l                                           ; LD L,A            ; 
       movb @bytes+>0e,h                                   ; LD H,$0E          ; 
       jnc  _4ccb                                          ; JR NC,$4CCB       ; TODO: check code. 
       ab   one,h                                          ; INC H             ; 
_4ccb:                                                     ; >4ccb
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>02,b                                   ; LD B,$02          ; up to 2 characters from this digram
_4cce:                                                     ; >4cce
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       cb   a,@bytes+>20                                   ; CP $20            ; a space (padding, not a real letter)?
       jeq  _4cd7                                          ; JR Z,$4CD7        ; yes - skip it
       movb a,*de                                          ; LD (DE),A         ; no - append it
       inc  de                                             ; INC DE            ; 
       ab   one,@c                                         ; INC C             ; 
_4cd7:                                                     ; >4cd7
       sb   one,b                                          ; DJNZ $4CCE        ; 
       jne  _4cce                                          ;                   
       .pop af                                             ; POP AF            ; recover the outer loop's counter (via B:C -> A:F)
       movb a,b                                            ; LD B,A            ; 
       .pop hl                                             ; POP HL            ; recover the position in the index-byte buffer
       sb   one,b                                          ; DJNZ $4CBF        ; next index byte
       jne  _4cbf                                          ;                   
       sb   a,a                                            ; XOR A             ; 
       movb a,*de                                          ; LD (DE),A         ; null-terminate the name
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       szcb @bit5,*hl                                      ; RES 5,(HL)        ; force the first character to uppercase
       movb @c,a                                           ; LD A,C            ; A = the character count
       .ret                                                ; RET               ; 

********************************************************************************
* Work out a system's name
* 
* Used by the routines at #R$4C2B and #R$9B7C.
* .
* Stores four indices (0-31) into the letter pairs at #R$0E41, from the
* seeds (#R$E904), twisting them between each (#R$2147). As in BBC Elite,
* the name has only three pairs (the fourth index being 0) if bit 6 of
* s0_lo is clear.
* 
* I:IX Where to store them (#R$F756)
system_name_from_seeds:                                    ; >4ce7
       movb @system_seeds,a                                ; LD A,($E904)      ; A = s0_lo
       .push af                                            ; PUSH AF           ; 
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 bytes
_4ced:                                                     ; >4ced
       movb @seed_s2_hi,a                                  ; LD A,($E909)      ; A = s2_hi
       andi a,>1f00                                        ; AND $1F           ; 0-31
       movb a,*ix                                          ; LD (IX+$00),A     ; store the index
       .push bc                                            ; PUSH BC           ; 
       .call @twist_seeds                                  ; CALL $2147        ; twist the seeds
       .pop bc                                             ; POP BC            ; 
       movb b,a                                            ; LD A,B            ; was this the last iteration?
       sb   one,a                                          ; DEC A             ; 
       jne  _4d06                                          ; JR NZ,$4D06       ; not the fourth pair
       .pop af                                             ; POP AF            ; yes - recover the original #R$E904 byte
       andi a,>4000                                        ; AND $40           ; bit 6 of s0_lo set?
       jne  _4d06                                          ; JR NZ,$4D06       ; yes - four pairs
       movb a,*ix                                          ; LD (IX+$00),A     ; no - three
_4d06:                                                     ; >4d06
       inc  ix                                             ; INC IX            ; 
       sb   one,b                                          ; DJNZ $4CED        ; 
       jne  _4ced                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Key '5': show the galactic chart
* 
* Reached via the key table at #R$419B. Does nothing if the chart is
* already showing (#R$E902 = 4). Prints "Galaxy" and the galaxy's number
* (#R$EB66 + 1), gives the chart area random colours (20 rows of the colour
* table from $2118, from the R register), and plots all 256 systems
* (#R$4C80, #R$4EEC, #R$3793). Then sets up the cursor sprite (#R$4D8A) and
* puts it on the selected system (#R$53FD) - or, in witchspace, on the
* ship's position ($4D6C).
* .
* At $4D6C, puts the cursor on the ship's position in witchspace ($EEC3).
* At $4D76, turns the chart cursor on (#R$E70B), draws the sprite for the
* current system's marker (#R$4DAB, #R$4E4D), and marks the chart as
* showing (#R$E902 = 4).
galactic_chart:                                            ; >4d0b
       movb @current_screen,a                              ; LD A,($E902)      ; 
       cb   a,@bytes+>04                                   ; CP $04            ; 
       jne  !                                              ; RET Z             ; already showing
       .ret                                                ;                   
!
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide the sprites
       li   hl,galactic_chart_title                        ; LD HL,$566C       ; "Galaxy #"
       .rst >20                                            ; RST $20           ; print it
       movb @current_galaxy,a                              ; LD A,($EB66)      ; 
       movb a,@c                                           ; LD C,A            ; 
       ab   one,@c                                         ; INC C             ; C = galaxy number + 1
       sb   a,a                                            ; XOR A             ; 
       s    hl,hl                                          ; SBC HL,HL         ; 
       .rst >18                                            ; RST $18           ; print it
       li   hl,>2118                                       ; LD HL,$2118       ; the colour table for the chart
       movb @bytes+>14,@c                                  ; LD C,$14          ; 20 rows
_4d26:                                                     ; >4d26
       limi 0                                              ; DI                ; 
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb h,a                                            ; LD A,H            ; 
       socb @bytes+>40,a                                   ; OR $40            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb r,a                                            ; LD A,R            ; random colours
       movb a,@e                                           ; LD E,A            ; 
       movb @bytes+>d0,b                                   ; LD B,$D0          ; 208 bytes
_4d34:                                                     ; >4d34
       movb @e,a                                           ; LD A,E            ; 
       andi a,>f000                                        ; AND $F0           ; 
       cb   a,@bytes+>11                                   ; CP $11            ; 
       jhe  _4d3d                                          ; JR NC,$4D3D       ; 
       movb @bytes+>f0,a                                   ; LD A,$F0          ; no black on black
_4d3d:                                                     ; >4d3d
       socb one,a                                          ; OR $01            ; on black
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       ; RLC E                                             ; RLC E             ; TODO: check code. 
       sb   one,b                                          ; DJNZ $4D34        ; 
       jne  _4d34                                          ;                   
       ; EI                                                ; EI                ; TODO: check code. 
       ab   one,h                                          ; INC H             ; next row
       sb   one,@c                                         ; DEC C             ; 
       jne  _4d26                                          ; JR NZ,$4D26       ; 
       .call @galaxy_seeds_to_system                       ; CALL $5607        ; start at system 0
_4d4d:                                                     ; >4d4d
       li   ix,pixel_bitmask_table                         ; LD IX,$E700       ; 
_4d51:                                                     ; >4d51
       .push bc                                            ; PUSH BC           ; 
       .call @next_system_coordinates                      ; CALL $4C80        ; BC = the system's coordinates
       .call @galactic_chart_coordinates                   ; CALL $4EEC        ; convert them to screen coordinates
       .call @plot_line_pixel                              ; CALL $3793        ; plot it
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $4D51        ; next system
       jne  _4d51                                          ;                   
       .call @set_up_chart_cursor                          ; CALL $4D8A        ; set up the cursor sprite
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; 
       socb a,a                                            ; OR A              ; 
       jne  galactic_chart_2                               ; JR NZ,$4D6C       ; in witchspace
       .call @galactic_chart_cursor_to_selected            ; CALL $53FD        ; put the cursor on the selected system
       jmp  _4d76                                          ; JR $4D76          ; 
galactic_chart_2:                                          ; >4d6c
       mov  @witchspace_position,bc                        ; LD BC,($EEC3)     ; the ship's position in witchspace
       .call @galactic_chart_coordinates                   ; CALL $4EEC        ; convert it to screen coordinates
       .call @move_cursor_to_position                      ; CALL $540D        ; move the cursor there
_4d76:                                                     ; >4d76
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@chart_cursor_active_flag                    ; LD ($E70B),A      ; turn the chart cursor on
       .call @draw_fuel_range_sprite                       ; CALL $4DAB        ; 
       .call @place_fuel_range_sprites                     ; CALL $4E4D        ; 
       movb @bytes+>04,a                                   ; LD A,$04          ; 
       movb a,@current_screen                              ; LD ($E902),A      ; the galactic chart is showing
       movb a,@hyperspace_target_selected                  ; LD ($E91A),A      ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Set up the chart cursor sprite
* 
* Used by the routines at #R$4D0B and #R$4F64.
* .
* Used by both charts (#R$4D0B, #R$4FA2). Uploads the cursor's pattern
* (#R$5647) to sprite patterns 16-19 ($3880), and sets sprite 4's
* attributes ($1B10, #R$3830) from #R$5658: y $DF (out
* of sight until it's moved, #R$540D), x 0, pattern 16 and colour 5.
set_up_chart_cursor:                                       ; >4d8a
       limi 0                                              ; DI                ; VDP address/data access must not be interrupted
       movb @bytes+>80,a                                   ; LD A,$80          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb @bytes+>78,a                                   ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, write mode: $3880
       li   hl,chart_cursor_pattern                        ; LD HL,$5647       ; the cursor's pattern
       .call @write_run_length_encoded_byte_stream         ; CALL $39B9        ; upload it
       movb @bytes+>10,a                                   ; LD A,$10          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb @bytes+>5b,a                                   ; LD A,$5B          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, write mode: $1B10
       li   hl,chart_cursor_attributes                     ; LD HL,$5658       ; sprite 4's attributes
       movb @bytes+>04,b                                   ; LD B,$04          ; 
       .call @copy_to_vram                                 ; CALL $3830        ; set them
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Draw the fuel range circle
* 
* Used by the routine at #R$4D0B.
* .
* Draws the circle showing how far the ship can jump into a 32x32-pixel
* image at $D600, and uploads it as the four 16x16 sprite patterns at
* $3800. The circle is centred on the current system - or in witchspace (at
* $4DCA) on the ship's position (#R$EEC3) - converted to chart coordinates
* (#R$4EEC) in $E82E/$E82F. Its points come from the table at #R$13ED,
* indexed by the fuel (#R$F775) / 10; each is plotted in all four quadrants
* (#R$4EA5).
draw_fuel_range_sprite:                                    ; >4dab
       li   hl,space_view_buffer                           ; LD HL,$D600       ; clear the 32x32-pixel image (4 bytes a row)
       sb   *hl,*hl                                        ; LD (HL),$00       ; 
       li   de,space_view_buffer+>0001                     ; LD DE,$D601       ; 
       li   bc,>007f                                       ; LD BC,$007F       ; 
       .ldir                                               ; LDIR              ; 
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jne  other_origin_bc_shared_marker_plot             ; JR NZ,$4DCA       ; yes - centre on the ship's position
       movb @current_system,a                              ; LD A,($EB67)      ; A = the current system
       .call @generate_system                              ; CALL $4C9B        ; generate its data (#R$4C9B)
       mov  @system_x,bc                                   ; LD BC,($F751)     ; BC = its coordinates
       jmp  _4dce                                          ; JR $4DCE          ; 
other_origin_bc_shared_marker_plot:                        ; >4dca
       mov  @witchspace_position,bc                        ; LD BC,($EEC3)     ; 
_4dce:                                                     ; >4dce
       .call @galactic_chart_coordinates                   ; CALL $4EEC        ; convert them to chart coordinates (#R$4EEC)
       mov  bc,@chart_marker_screen_position               ; LD ($E82E),BC     ; the circle's centre
       mov  @fuel_level,hl                                 ; LD HL,($F775)     ; L = the fuel
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>0a,a                                   ; LD A,$0A          ; 
       .call @divide_hl_a                                  ; CALL $2079        ; HL = fuel / 10, the radius / 2 (#R$2079)
       a    hl,hl                                          ; ADD HL,HL         ; 
       li   bc,circle_point_lists                          ; LD BC,$13ED       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> its entry in #R$13ED
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL -> the circle's point list (#R$133F)
       movb *hl,b                                          ; LD B,(HL)         ; B = the number of points
       inc  hl                                             ; INC HL            ; 
_4dea:                                                     ; >4dea
       li   ix,pixel_bitmask_table                         ; LD IX,$E700       ; IX -> the pixel masks (#R$E700), for #R$4EA5
_4dee:                                                     ; >4dee
       .push bc                                            ; PUSH BC           ; save the point counter
       movb *hl,@e                                         ; LD E,(HL)         ; E = the point's x offset
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; D = its y offset
       inc  hl                                             ; INC HL            ; 
       .push hl                                            ; PUSH HL           ; save the list pointer
       movb @e,@c                                          ; LD C,E            ; 
       movb d,b                                            ; LD B,D            ; 
       .call @fuel_range_sprite_point                      ; CALL $4EA5        ; plot (x, y)
       movb @e,a                                           ; LD A,E            ; 
       neg a                                               ; NEG               ; 
       movb a,@c                                           ; LD C,A            ; 
       movb d,b                                            ; LD B,D            ; 
       .call @fuel_range_sprite_point                      ; CALL $4EA5        ; plot (-x, y)
       movb @e,a                                           ; LD A,E            ; 
       neg a                                               ; NEG               ; 
       movb a,@c                                           ; LD C,A            ; 
       movb d,a                                            ; LD A,D            ; 
       neg a                                               ; NEG               ; 
       movb a,b                                            ; LD B,A            ; 
       .call @fuel_range_sprite_point                      ; CALL $4EA5        ; plot (-x, -y)
       movb @e,@c                                          ; LD C,E            ; 
       movb d,a                                            ; LD A,D            ; 
       neg a                                               ; NEG               ; 
       movb a,b                                            ; LD B,A            ; 
       .call @fuel_range_sprite_point                      ; CALL $4EA5        ; plot (x, -y)
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $4DEE        ; next point
       jne  _4dee                                          ;                   
       limi 0                                              ; DI                ; 
       sb   a,a                                            ; LD A,$00          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>78,a                                   ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $3800: sprite patterns 0-3
       li   hl,space_view_buffer                           ; LD HL,$D600       ; HL -> the image
       li   de,>0004                                       ; LD DE,$0004       ; DE = 4, one row
       movb @bytes+>02,@c                                  ; LD C,$02          ; 2 halves, left and right
_4e29:                                                     ; >4e29
       .push hl                                            ; PUSH HL           ; save the half's address
       movb @bytes+>02,b                                   ; LD B,$02          ; 2 quarters, top and bottom
_4e2c:                                                     ; >4e2c
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; save the quarter's address
       movb @bytes+>02,@c                                  ; LD C,$02          ; 2 bytes across
_4e30:                                                     ; >4e30
       .push hl                                            ; PUSH HL           ; 
       movb @bytes+>10,b                                   ; LD B,$10          ; 16 rows
_4e33:                                                     ; >4e33
       movb *hl,a                                          ; LD A,(HL)         ; copy a byte of the quarter to its sprite pattern
       a    de,hl                                          ; ADD HL,DE         ; the next row
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       sb   one,b                                          ; DJNZ $4E33        ; 
       jne  _4e33                                          ;                   
       .pop hl                                             ; POP HL            ; 
       inc  hl                                             ; INC HL            ; the next byte across
       sb   one,@c                                         ; DEC C             ; 
       jne  _4e30                                          ; JR NZ,$4E30       ; 
       .pop hl                                             ; POP HL            ; 
       movb @bytes+>40,@c                                  ; LD C,$40          ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> the bottom quarter (16 rows down)
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $4E2C        ; 
       jne  _4e2c                                          ;                   
       .pop hl                                             ; POP HL            ; 
       inc  hl                                             ; INC HL            ; 
       inc  hl                                             ; INC HL            ; HL -> the right half (2 bytes across)
       sb   one,@c                                         ; DEC C             ; 
       jne  _4e29                                          ; JR NZ,$4E29       ; 
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Show the fuel range circle
* 
* Used by the routine at #R$4D0B.
* .
* Places the four 16x16 sprites (0-3) that show the fuel range circle's 32x32
* image (#R$4DAB), in red, centred on the circle's centre (#R$E82E):
* patterns 0 and 4 on the left, 8 and 12 on the right.
place_fuel_range_sprites:                                  ; >4e4d
       limi 0                                              ; DI                ; 
       sb   a,a                                            ; LD A,$00          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>5b,a                                   ; LD A,$5B          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1B00: sprite 0's attributes
       sb   d,d                                            ; LD D,$00          ; pattern 0
       .call @fuel_range_sprite_left                       ; CALL $4E86        ; C = the left column's x (#R$4E86)
       movb @bytes+>f0,b                                   ; LD B,$F0          ; 
       .call @fuel_range_sprite_row                        ; CALL $4E9D        ; B = the top row's y (#R$4E9D)
       .call @set_sprite                                   ; CALL $39A4        ; sprite 0: top left (#R$39A4)
       .call @fuel_range_sprite_left                       ; CALL $4E86        ; 
       sb   b,b                                            ; LD B,$00          ; 
       .call @fuel_range_sprite_row                        ; CALL $4E9D        ; B = the bottom row's y
       .call @set_sprite                                   ; CALL $39A4        ; sprite 1: bottom left
       .call @fuel_range_sprite_right                      ; CALL $4E95        ; C = the right column's x (#R$4E95)
       movb @bytes+>f0,b                                   ; LD B,$F0          ; 
       .call @fuel_range_sprite_row                        ; CALL $4E9D        ; 
       .call @set_sprite                                   ; CALL $39A4        ; sprite 2: top right
       .call @fuel_range_sprite_right                      ; CALL $4E95        ; 
       sb   b,b                                            ; LD B,$00          ; 
       .call @fuel_range_sprite_row                        ; CALL $4E9D        ; 
       .call @set_sprite                                   ; CALL $39A4        ; sprite 3: bottom right
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Show the fuel range circle: left column
* 
* Used by the routine at #R$4E4D.
* .
* Sets C to the x of the left-hand sprites: the circle's centre - 15. If that
* would be off the left of the screen, adds 32 and sets the early clock bit in
* the colour, which moves the sprite 32 pixels left.
* 
* O:C x
* O:E Colour (red, with the early clock bit if needed)
fuel_range_sprite_left:                                    ; >4e86
       movb @bytes+>08,@e                                  ; LD E,$08          ; red
       movb @chart_marker_screen_position,a                ; LD A,($E82E)      ; 
       sb   @bytes+>0f,a                                   ; SUB $0F           ; 
       jnc  _4e93                                          ; JR NC,$4E93       ; TODO: check code. on the screen
       movb @bytes+>88,@e                                  ; LD E,$88          ; red, with the early clock bit
       ab   @bytes+>20,a                                   ; ADD A,$20         ; 
_4e93:                                                     ; >4e93
       movb a,@c                                           ; LD C,A            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Show the fuel range circle: right column
* 
* Used by the routine at #R$4E4D.
* .
* Sets C to the x of the right-hand sprites: the circle's centre + 1.
* 
* O:C x
* O:E Colour (red)
fuel_range_sprite_right:                                   ; >4e95
       movb @bytes+>08,@e                                  ; LD E,$08          ; red
       movb @chart_marker_screen_position,a                ; LD A,($E82E)      ; 
       ab   one,a                                          ; INC A             ; 
       movb a,@c                                           ; LD C,A            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Show the fuel range circle: row
* 
* Used by the routine at #R$4E4D.
* .
* Adds the circle's centre's y to B: -16 for the top sprites, 0 for the bottom
* ones.
* 
* I:B -16 or 0
* O:B y
* O:E Colour (red)
fuel_range_sprite_row:                                     ; >4e9d
       movb @bytes+>08,@e                                  ; LD E,$08          ; red
       movb @chart_position_y,a                            ; LD A,($E82F)      ; 
       ab   b,a                                            ; ADD A,B           ; 
       movb a,b                                            ; LD B,A            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Draw the fuel range circle: plot a point
* 
* Used by the routine at #R$4DAB.
* .
* Adds the offset (C, B) to the circle's centre ($E82E, $E82F) - or
* subtracts it (at $4EAF, $4EC1) - and, unless that's off the chart, plots
* the point in the image at $D600 (#R$4DAB).
* 
* I:B y offset (bit 7 set if negative)
* I:C x offset (bit 7 set if negative)
* I:D Size of the y offset
* I:E Size of the x offset
fuel_range_sprite_point:                                   ; >4ea5
       movb @chart_marker_screen_position,a                ; LD A,($E82E)      ; A = the centre's x on the chart
       movb @c,r0                                          ; BIT 7,C           ; negative x offset?
       andi r0,>8000                                       ;                   
       jne  negative_offset_x_case_bounds_check            ; JR NZ,$4EAF       ; yes - subtract it
       ab   @e,a                                           ; ADD A,E           ; no: add it
       jmp  _4eb0                                          ; JR $4EB0          ; 
negative_offset_x_case_bounds_check:                       ; >4eaf
       sb   @e,a                                           ; SUB E             ; 
_4eb0:                                                     ; >4eb0
       jnc  !                                              ; RET C             ; TODO: check code. off the chart
       .ret                                                ;                   
!
       cb   a,@bytes+>18                                   ; CP $18            ; 
       jhe  !                                              ; RET C             ; left of the chart
       .ret                                                ;                   
!
       cb   a,@bytes+>e8                                   ; CP $E8            ; 
       jl   !                                              ; RET NC            ; right of the chart
       .ret                                                ;                   
!
       movb @chart_position_y,a                            ; LD A,($E82F)      ; A = the centre's y on the chart
       czc  @bit7,b                                        ; BIT 7,B           ; negative y offset?
       jne  negative_offset_y_case_bounds_check            ; JR NZ,$4EC1       ; yes - subtract it
       ab   d,a                                            ; ADD A,D           ; no: add it
       jmp  _4ec2                                          ; JR $4EC2          ; 
negative_offset_y_case_bounds_check:                       ; >4ec1
       sb   d,a                                            ; SUB D             ; 
_4ec2:                                                     ; >4ec2
       jnc  !                                              ; RET C             ; TODO: check code. off the chart
       .ret                                                ;                   
!
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jhe  !                                              ; RET C             ; above the chart
       .ret                                                ;                   
!
       cb   a,@bytes+>a8                                   ; CP $A8            ; 
       jl   !                                              ; RET NC            ; below the chart
       .ret                                                ;                   
!
       movb b,a                                            ; LD A,B            ; 
       ab   @bytes+>0f,a                                   ; ADD A,$0F         ; the image's row: y offset + 15...
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@l                                           ; LD L,A            ; ...times 4 bytes a row
       movb @c,a                                           ; LD A,C            ; 
       ab   @bytes+>0f,a                                   ; ADD A,$0F         ; the image's column: x offset + 15
       movb a,@c                                           ; LD C,A            ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; 
       ab   @l,a                                           ; ADD A,L           ; 
       movb a,@l                                           ; LD L,A            ; L = the byte's offset in the image
       movb @c,a                                           ; LD A,C            ; 
       andi a,>0700                                        ; AND $07           ; 
       movb a,@fuel_range_pixel_mask+>0002                 ; LD ($4EE2),A      ; patch the pixel's bit position in (#R$4EE0+2)
fuel_range_pixel_mask:                                     ; >4ee0
       movb *ix,a                                          ; LD A,(IX+$00)     ; A = the pixel's mask (#R$E700)
       li   bc,space_view_buffer                           ; LD BC,$D600       ; 
       sb   h,h                                            ; LD H,$00          ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> the byte in the image (#R$D600)
       socb *hl,a                                          ; OR (HL)           ; 
       movb a,*hl                                          ; LD (HL),A         ; plot the pixel
       .ret                                                ; RET               ; 

********************************************************************************
* Galactic chart: convert coordinates to screen coordinates
* 
* Used by the routines at #R$4D0B, #R$4DAB, #R$527F and #R$53FD.
* .
* Scales galaxy coordinates (0-255) to the galactic chart: y * 159 / 127
* + 8, and x * 207 / 256 + 24.
* 
* I:B y coordinate
* I:C x coordinate
* O:B,C Screen coordinates
galactic_chart_coordinates:                                ; >4eec
       .push bc                                            ; PUSH BC           ; 
       movb b,a                                            ; LD A,B            ; 
       movb @bytes+>9f,@e                                  ; LD E,$9F          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = y * 159 (#R$1F60)
       movb @bytes+>7f,a                                   ; LD A,$7F          ; 
       .call @divide_hl_a                                  ; CALL $2079        ; HL = y * 159 / 127 (#R$2079)
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; add 8
       .pop bc                                             ; POP BC            ; 
       .push af                                            ; PUSH AF           ; save it
       movb @c,a                                           ; LD A,C            ; 
       movb @bytes+>cf,@e                                  ; LD E,$CF          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = x * 207
       movb h,a                                            ; LD A,H            ; 
       ab   @bytes+>18,a                                   ; ADD A,$18         ; A = x * 207 / 256 + 24
       .pop bc                                             ; POP BC            ; B = the screen y
       movb a,@c                                           ; LD C,A            ; C = the screen x
       .ret                                                ; RET               ; 

********************************************************************************
* Local chart: convert galaxy coordinates to screen coordinates
* 
* Used by the routines at #R$4F64, #R$502C, #R$50CE, #R$527F and #R$53ED.
* .
* The local chart is centred on the system at #R$E830 and magnified: x
* = 3 * (x - centre x) + $81, y = 4 * (y - centre y) + $59.
* 
* I:B y (galaxy)
* I:C x (galaxy)
* O:B y (screen)
* O:C x (screen)
local_chart_coordinates:                                   ; >4f09
       movb @c,a                                           ; LD A,C            ; A = C (the X coordinate)
       li   hl,local_chart_centre                          ; LD HL,$E830       ; HL -> the cached origin's X
       sb   *hl,a                                          ; SUB (HL)          ; A = delta X (signed)
       movb a,@c                                           ; LD C,A            ; C = the signed delta
       jlt  !                                              ; JP P,$4F14        ; positive - keep it
       b    @local_chart_x                                 ;                   
!
       neg a                                               ; NEG               ; negative - take the magnitude
local_chart_x:                                             ; >4f14
       movb a,@e                                           ; LD E,A            ; E = |delta X|
       ab   a,a                                            ; ADD A,A           ; A = |delta X| * 3
       ab   @e,a                                           ; ADD A,E           ; 
       movb @c,r0                                          ; BIT 7,C           ; was the original delta negative?
       andi r0,>8000                                       ;                   
       jeq  _4f1d                                          ; JR Z,$4F1D        ; no - keep it positive
       neg a                                               ; NEG               ; yes - re-apply the sign
_4f1d:                                                     ; >4f1d
       ab   @bytes+>81,a                                   ; ADD A,$81         ; offset into the display range
       movb a,@c                                           ; LD C,A            ; C = the scaled X
       movb b,a                                            ; LD A,B            ; A = B (the Y coordinate)
       li   hl,local_chart_centre_y                        ; LD HL,$E831       ; HL -> the cached origin's Y
       sb   *hl,a                                          ; SUB (HL)          ; A = delta Y (signed)
       movb a,b                                            ; LD B,A            ; B = the signed delta
       jlt  !                                              ; JP P,$4F2B        ; positive - keep it
       b    @local_chart_y                                 ;                   
!
       neg a                                               ; NEG               ; negative - take the magnitude
local_chart_y:                                             ; >4f2b
       ab   a,a                                            ; ADD A,A           ; A = |delta Y| * 4
       ab   a,a                                            ; ADD A,A           ; 
       czc  @bit7,b                                        ; BIT 7,B           ; was the original delta negative?
       jeq  _4f33                                          ; JR Z,$4F33        ; no - keep it positive
       neg a                                               ; NEG               ; yes - re-apply the sign
_4f33:                                                     ; >4f33
       ab   @bytes+>59,a                                   ; ADD A,$59         ; offset into the display range
       movb a,b                                            ; LD B,A            ; B = the scaled Y
       .ret                                                ; RET               ; 

********************************************************************************
* Local chart: convert screen coordinates to galaxy coordinates
* 
* Used by the routine at #R$538B.
* .
* The reverse of #R$4F09, for the cursor (#R$538B).
* 
* I:B y (screen)
* I:C x (screen)
* O:B y (galaxy)
* O:C x (galaxy)
local_chart_galaxy_coordinates:                            ; >4f37
       .push bc                                            ; PUSH BC           ; 
       movb b,a                                            ; LD A,B            ; A = B (the screen Y)
       sb   @bytes+>59,a                                   ; SUB $59           ; undo the offset
       sra  a,1                                            ; SRA A             ; undo the *4 scale (signed /4)
       sra  a,1                                            ; SRA A             ; 
       li   hl,local_chart_centre_y                        ; LD HL,$E831       ; 
       ab   *hl,a                                          ; ADD A,(HL)        ; += the cached origin's Y
       .pop bc                                             ; POP BC            ; 
       .push af                                            ; PUSH AF           ; stash the reconstructed Y
       movb @c,a                                           ; LD A,C            ; A = C (the screen X)
       sb   @bytes+>81,a                                   ; SUB $81           ; undo the offset
       .push af                                            ; PUSH AF           ; stash its sign
       jlt  !                                              ; JP P,$4F4E        ; positive - keep it
       b    @local_chart_galaxy_x                          ;                   
!
       neg a                                               ; NEG               ; negative - take the magnitude
local_chart_galaxy_x:                                      ; >4f4e
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       .call @divide_hl_a                                  ; CALL $2079        ; undo the *3 scale (/3)
       .pop af                                             ; POP AF            ; recover the original sign
       movb @l,a                                           ; LD A,L            ; 
       jlt  !                                              ; JP P,$4F5D        ; positive - keep it
       b    @local_chart_galaxy_x_add                      ;                   
!
       neg a                                               ; NEG               ; negative - re-apply the sign
local_chart_galaxy_x_add:                                  ; >4f5d
       li   hl,local_chart_centre                          ; LD HL,$E830       ; 
       ab   *hl,a                                          ; ADD A,(HL)        ; += the cached origin's X
       .pop bc                                             ; POP BC            ; recover the reconstructed Y
       movb a,@c                                           ; LD C,A            ; C = the reconstructed X
       .ret                                                ; RET               ; 

********************************************************************************
* Key '6': show the Local Navigation Chart
* 
* Used by the routine at #R$527F.
* .
* Also used by #R$52A4 to redraw the chart. Picks the system to centre the
* chart on: on the local chart itself (($E902) = 6), the system nearest the
* cursor (#R$538B); on the galactic chart (($E902) = 4), the system nearest
* its cursor, after an expanding-box effect (#R$541E, via $4F78); otherwise
* the current system (#R$EB67, via $4F84). Nothing happens on the local
* chart after a drive malfunction (($EEC1) set). Then draws the chart (at
* $4F87).
* .
* At $4F78, on the galactic chart (($E902) = 4), selects the system nearest
* the cursor with an expanding-box effect (#R$541E) and centres on it;
* otherwise goes on to $4F84.
* .
* At $4F84, centres the chart on the current system (#R$EB67). At $4F87,
* saves the centre system in #R$E83C, hides the sprites and prints the
* title, then generates the centre system's data (#R$4C9B) to get its
* galaxy coordinates (($F751)) for #R$4FA5. After a drive malfunction
* (($EEC1) set) the chart is centred on the ship's position instead
* ($4FA2).
* .
* At $4FA2, after a drive malfunction, centres on the ship's position
* (#R$EEC3). At $4FA5, lists every system within 25 in X and 15 in Y of the
* centre (#R$502C) and, for each one, generates its data (#R$4C9B), sets
* the label colour from its government ($F753 + 2 on black, in #R$E83B),
* works out the size of its name label from the length of the name
* (#R$4CAF, into $E833-$E835), and plots it (#R$50CE). Then draws the
* fuel-range circle (#R$5524) if the chart is centred on the current
* system, updates the cursor (#R$527F, unless the selected system was among
* those listed), uploads the cursor sprite (#R$4D8A) and puts the cursor on
* the selected system (#R$53ED) - or, after a drive malfunction, on the
* ship's position ($5014). Finally marks the local chart as showing
* (($E902) = 6).
* .
* At $5014, after a drive malfunction, puts the cursor at the ship's
* position (#R$EEC3). Then, at $501E, turns on the target readout
* (#R$E70B), and marks the local chart as showing (($E902) = 6) and a
* system as selected (#R$E91A).
local_chart:                                               ; >4f64
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,@bytes+>06                                   ; CP $06            ; already on the local chart?
       jne  local_chart_from_galactic                      ; JR NZ,$4F78       ; no
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; yes: in witchspace?
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; after a drive malfunction - nothing to do
       .ret                                                ;                   
!
       .call @local_chart_select                           ; CALL $538B        ; select the system nearest the cursor
       movb @selected_system,a                             ; LD A,($E72B)      ; centre on it
       jmp  _4f87                                          ; JR $4F87          ; 
local_chart_from_galactic:                                 ; >4f78
       cb   a,@bytes+>04                                   ; CP $04            ; on the galactic chart?
       jne  local_chart_draw                               ; JR NZ,$4F84       ; no - centre on the current system
       .call @animate_expanding_selection_box              ; CALL $541E        ; select the system nearest its cursor
       movb @selected_system,a                             ; LD A,($E72B)      ; centre on it
       jmp  _4f87                                          ; JR $4F87          ; 
local_chart_draw:                                          ; >4f84
       movb @current_system,a                              ; LD A,($EB67)      ; centre on the current system
_4f87:                                                     ; >4f87
       movb a,@chart_chosen_system_index                   ; LD ($E83C),A      ; save the centre system
       .call @hide_sprites_clear_page                      ; CALL $608C        ; hide sprites
       li   hl,local_chart_title                           ; LD HL,$5688       ; 
       .rst >20                                            ; RST $20           ; print "Local Nagivation Chart"
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jne  local_chart_plot                               ; JR NZ,$4FA2       ; drive malfunction
       movb @chart_chosen_system_index,a                   ; LD A,($E83C)      ; clear - generate this system's name
       .call @generate_system                              ; CALL $4C9B        ; generate the centre system's data
       mov  @system_x,hl                                   ; LD HL,($F751)     ; HL = its galaxy coordinates
       jmp  _4fa5                                          ; JR $4FA5          ; 
local_chart_plot:                                          ; >4fa2
       mov  @witchspace_position,hl                        ; LD HL,($EEC3)     ; drive malfunction: centre on the ship's position
_4fa5:                                                     ; >4fa5
       movb @b255,a                                        ; LD A,$FF          ; 
       .call @scan_systems_in_box_around_origin            ; CALL $502C        ; list the systems near the centre
       mov  @reclaimed_range_end,iy                        ; LD IY,($EFA4)     ; IY -> the list
       movb a,b                                            ; LD B,A            ; B = number of systems
_4faf:                                                     ; >4faf
       .push bc                                            ; PUSH BC           ; 
       movb *iy,a                                          ; LD A,(IY+$00)     ; 
       .call @generate_system                              ; CALL $4C9B        ; generate this system's data
       movb @system_government,a                           ; LD A,($F753)      ; A = its government
       ab   @bytes+>02,a                                   ; ADD A,$02         ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       socb one,a                                          ; OR $01            ; 
       movb a,@chart_label_fill_pattern                    ; LD ($E83B),A      ; label colour: government + 2, on black
       movb *iy,a                                          ; LD A,(IY+$00)     ; 
       .call @generate_system_name                         ; CALL $4CAF        ; A = length of its name
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   @c,a                                           ; ADD A,C           ; 
       sb   one,a                                          ; DEC A             ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; 
       ab   one,a                                          ; INC A             ; 
       movb a,@chart_label_width                           ; LD ($E833),A      ; label width in bytes
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       sb   one,a                                          ; DEC A             ; 
       movb a,@chart_label_width_limit                     ; LD ($E834),A      ; label width in pixels - 1
       ab   one,a                                          ; INC A             ; 
       srl  a,1                                            ; SRL A             ; 
       movb a,@ring_position_scale_limit                   ; LD ($E835),A      ; half the label width
       movb @>19(iy),a                                     ; LD A,(IY+$19)     ; 
       ab   @bytes+>03,a                                   ; ADD A,$03         ; 
       movb a,@shared_normalize_mantissa                   ; LD ($EB9C),A      ; 
       .call @local_chart_label_system                     ; CALL $50CE        ; plot this system
       .pop bc                                             ; POP BC            ; 
       inc  iy                                             ; INC IY            ; -> the next system in the list
       sb   one,b                                          ; DJNZ $4FAF        ; next system
       jne  _4faf                                          ;                   
       movb @chart_chosen_system_index,a                   ; LD A,($E83C)      ; A = the centre system
       li   hl,current_system                              ; LD HL,$EB67       ; 
       cb   a,*hl                                          ; CP (HL)           ; is it the current system?
       jne  !                                              ; CALL Z,$5524      ; yes - draw the fuel-range circle
       .call @draw_fuel_range_circle                       ;                   
!
       movb @system_search_found_current,a                 ; LD A,($E83F)      ; was the selected system listed?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; CALL Z,$527F      ; no - update the cursor
       .call @update_chart_cursor                          ;                   
!
       .call @set_up_chart_cursor                          ; CALL $4D8A        ; upload the cursor sprite
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jne  local_chart_finish                             ; JR NZ,$5014       ; drive malfunction
       .call @local_chart_cursor_to_selected               ; CALL $53ED        ; put the cursor on the selected system
       jmp  _501e                                          ; JR $501E          ; 
local_chart_finish:                                        ; >5014
       mov  @witchspace_position,bc                        ; LD BC,($EEC3)     ; BC = the ship's position
       .call @local_chart_coordinates                      ; CALL $4F09        ; convert it to a screen position
       .call @move_cursor_to_position                      ; CALL $540D        ; move the cursor there
_501e:                                                     ; >501e
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@chart_cursor_active_flag                    ; LD ($E70B),A      ; turn the chart cursor on
       movb @bytes+>06,a                                   ; LD A,$06          ; 
       movb a,@current_screen                              ; LD ($E902),A      ; the local chart is showing
       movb a,@hyperspace_target_selected                  ; LD ($E91A),A      ; a system is selected
       .ret                                                ; RET               ; 

********************************************************************************
* Scan all 256 systems for ones within a box around (HL), listing matches
* 
* Used by the routines at #R$4F64 and #R$50AA.
* .
* The galaxy system-search behind the chart: caches the mode flag A
* (nonzero also computes each match's scaled screen position) and the
* origin HL to $E82C/$E830-$E831, then builds a bounding box around it
* (+-25 in X, +-15 in Y, clamped to 0-127/0-255) into D:E (min) and
* H:L (max). Seeds rotating_accumulator from $E711 (#R$5607), then
* loops all 256 systems (B=0 so DJNZ wraps once): #R$4C80 regenerates
* each candidate system's (X, Y) from the mixing seed exactly like
* #R$4C2B/#R$4CE7's name-seed derivation, and mixes the seed onward
* for the next candidate either way. A candidate outside the box is
* skipped; one inside has its system index (recovered from the
* countdown via NEG) stored to (IY), flags $E83F if it's the current
* system (#R$E72B), and - only if the mode flag was nonzero - has its
* screen position computed (#R$4F09) and stored (#R$5204) before IY
* advances. Finally returns (and caches to $E832) how many systems
* were listed, as IY's total advance since $EFA4.
* 
* I:A Mode: 0 = just list matches, nonzero = also compute screen positions
* I:HL The search origin (a system's galaxy coordinates)
* O:A The number of systems listed
* O:($EFA4 list) Each match's system index (mode 0) or index + position
scan_systems_in_box_around_origin:                         ; >502c
       movb a,@system_search_mode                          ; LD ($E82C),A      ; cache the mode flag
       mov  hl,@local_chart_centre                         ; LD ($E830),HL     ; cache the origin (E830=X, E831=Y)
       movb @l,a                                           ; LD A,L            ; 
       sb   @bytes+>19,a                                   ; SUB $19           ; box min X = X-25, clamped to 0
       jnc  _5038                                          ; JR NC,$5038       ; TODO: check code. 
       sb   a,a                                            ; XOR A             ; 
_5038:                                                     ; >5038
       movb a,@e                                           ; LD E,A            ; 
       movb h,a                                            ; LD A,H            ; 
       sb   @bytes+>0f,a                                   ; SUB $0F           ; box min Y = Y-15, clamped to 0
       jnc  _503f                                          ; JR NC,$503F       ; TODO: check code. 
       sb   a,a                                            ; XOR A             ; 
_503f:                                                     ; >503f
       movb a,d                                            ; LD D,A            ; 
       movb @bytes+>19,a                                   ; LD A,$19          ; 
       ab   @l,a                                           ; ADD A,L           ; box max X = X+25, clamped to 127
       jnc  _5046                                          ; JR NC,$5046       ; TODO: check code. 
       sb   a,a                                            ; SBC A,A           ; 
_5046:                                                     ; >5046
       movb a,@l                                           ; LD L,A            ; 
       movb @bytes+>0f,a                                   ; LD A,$0F          ; 
       ab   h,a                                            ; ADD A,H           ; box max Y = Y+15, clamped to 127
       jlt  !                                              ; JP P,$504F        ; 
       b    @scan_systems_box_max_y                        ;                   
!
       movb @bytes+>7f,a                                   ; LD A,$7F          ; 
scan_systems_box_max_y:                                    ; >504f
       movb a,h                                            ; LD H,A            ; 
       .exx                                                ; EXX               ; 
       .call @galaxy_seeds_to_system                       ; CALL $5607        ; seed rotating_accumulator from $E711
       .exx                                                ; EXX               ; 
       mov  @reclaimed_range_end,iy                        ; LD IY,($EFA4)     ; IY -> the output list
       sb   a,a                                            ; XOR A             ; 
       movb a,@system_search_found_current                 ; LD ($E83F),A      ; clear the "found the current system" flag
       movb a,b                                            ; LD B,A            ; B = 0 (DJNZ below runs 256 times)
_505e:                                                     ; >505e
       .push bc                                            ; PUSH BC           ; stash the loop counter (0-255, counting DOWN)
       .call @next_system_coordinates                      ; CALL $4C80        ; B:C = this candidate system's (Y, X), and mix onward
       movb @c,a                                           ; LD A,C            ; 
       cb   a,@e                                           ; CP E              ; X < box min?
       jl   _5098                                          ; JR C,$5098        ; yes - out of the box, skip
       cb   a,@l                                           ; CP L              ; X > box max?
       jeq  _506b                                          ; JR Z,$506B        ; 
       jnc  _5098                                          ; JR NC,$5098       ; TODO: check code. yes - out of the box, skip
_506b:                                                     ; >506b
       movb b,a                                            ; LD A,B            ; 
       cb   a,d                                            ; CP D              ; Y < box min?
       jl   _5098                                          ; JR C,$5098        ; yes - out of the box, skip
       cb   a,h                                            ; CP H              ; Y > box max?
       jeq  _5074                                          ; JR Z,$5074        ; 
       jnc  _5098                                          ; JR NC,$5098       ; TODO: check code. yes - out of the box, skip
_5074:                                                     ; >5074
       .pop af                                             ; POP AF            ; in the box: recover the loop counter (B->A, via the stack)
       .push af                                            ; PUSH AF           ; ...and put it straight back for later
       .push de                                            ; PUSH DE           ; stash the box bounds (needed again next iteration)
       .push hl                                            ; PUSH HL           ; 
       neg a                                               ; NEG               ; A = the true system index (256 - countdown)
       movb a,*iy                                          ; LD (IY+$00),A     ; store it
       li   hl,selected_system                             ; LD HL,$E72B       ; the selected system
       cb   a,*hl                                          ; CP (HL)           ; is this candidate it?
       jne  _5088                                          ; JR NZ,$5088       ; no - move on
       movb @b255,a                                        ; LD A,$FF          ; yes - flag it
       movb a,@system_search_found_current                 ; LD ($E83F),A      ; 
_5088:                                                     ; >5088
       movb @system_search_mode,a                          ; LD A,($E82C)      ; A = the mode flag
       socb a,a                                            ; OR A              ; 
       jeq  _5094                                          ; JR Z,$5094        ; 0 - just list the index, no position
       .call @local_chart_coordinates                      ; CALL $4F09        ; scale this system's (B,C) relative to the origin
       .call @draw_system_chart_marker                     ; CALL $5204        ; store its screen position
_5094:                                                     ; >5094
       inc  iy                                             ; INC IY            ; -> the next output slot
       .pop hl                                             ; POP HL            ; recover the box bounds
       .pop de                                             ; POP DE            ; 
_5098:                                                     ; >5098
       .pop bc                                             ; POP BC            ; recover the loop counter
       sb   one,b                                          ; DJNZ $505E        ; next system
       jne  _505e                                          ;                   
       mov  @reclaimed_range_end,bc                        ; LD BC,($EFA4)     ; 
       socb a,a                                            ; OR A              ; 
       .push iy                                            ; PUSH IY           ; 
       .pop hl                                             ; POP HL            ; 
       s    bc,hl                                          ; SBC HL,BC         ; HL = IY - $EFA4 = the number of systems listed
       movb @l,a                                           ; LD A,L            ; 
       movb a,@nearby_systems_count                        ; LD ($E832),A      ; cache the count
       .ret                                                ; RET               ; 

********************************************************************************
* Pick a random system near the current one
* 
* Used by the routine at #R$91AA.
* .
* Scans (#R$502C, mode 0) for systems near the current one's
* coordinates ($F760), then repeatedly picks a random entry from the
* results (#R$2176 scaled by the count at #R$E832, via #R$1F60) until
* it finds one that isn't the current system (#R$EB67), storing
* its index in #R$EFA2: the next system on the Constrictor's trail
* (mission 1).
pick_random_nearby_system_not_target:                      ; >50aa
       mov  @current_system_x,hl                           ; LD HL,($F760)     ; the current system's galaxy coordinates
       sb   a,a                                            ; XOR A             ; mode 0 - just list matches
       .call @scan_systems_in_box_around_origin            ; CALL $502C        ; find nearby systems
_50b1:                                                     ; >50b1
       .call @random_byte                                  ; CALL $2176        ; A = a random byte
       movb @l,@e                                          ; LD E,L            ; 
       movb @nearby_systems_count,a                        ; LD A,($E832)      ; A = the number of systems found
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; scale the random byte into a list index
       movb h,@l                                           ; LD L,H            ; 
       sb   h,h                                            ; LD H,$00          ; 
       mov  @reclaimed_range_end,de                        ; LD DE,($EFA4)     ; the results list
       a    de,hl                                          ; ADD HL,DE         ; HL -> the randomly picked entry
       movb *hl,a                                          ; LD A,(HL)         ; A = that system's index
       li   hl,current_system                              ; LD HL,$EB67       ; the current system
       cb   a,*hl                                          ; CP (HL)           ; picked the current system?
       jeq  _50b1                                          ; JR Z,$50B1        ; the current system - pick again
       movb a,@mission_system                              ; LD ($EFA2),A      ; the next system on the trail
       .ret                                                ; RET               ; 

********************************************************************************
* Local chart: label a system
* 
* Used by the routine at #R$4F64.
* .
* Works out the system's position on the chart (#R$4F09) into $E82E, and
* looks for a place for its name label that's on the chart and clear of the
* other labels (#R$512F): 9 positions around the system, in each of the
* four directions ($E838, $E839). If there's no room, the system isn't
* labelled. At $5104, colours the label's box (#R$35B8: #R$E833 wide, 8
* high, in the colour in #R$E83B) and prints the name (#R$E717) in it.
local_chart_label_system:                                  ; >50ce
       mov  @system_x,bc                                   ; LD BC,($F751)     ; this system's name-seed X/Y
       .call @local_chart_coordinates                      ; CALL $4F09        ; scale it relative to the chart's origin
       mov  bc,@chart_marker_screen_position               ; LD ($E82E),BC     ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@ring_position_attempt_counter               ; LD ($E83A),A      ; candidate-position attempt counter
       movb a,@ring_position_bit_state_1                   ; LD ($E838),A      ; 
       movb a,@ring_position_bit_state_2                   ; LD ($E839),A      ; angle-like bit pattern state
_50e3:                                                     ; >50e3
       .call @local_chart_try_label                        ; CALL $512F        ; try this candidate label position
       jnc  continue_50ce_draw_name_label                  ; JR NC,$5104       ; TODO: check code. found one - draw the label
       li   hl,ring_position_attempt_counter               ; LD HL,$E83A       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more attempt
       movb *hl,a                                          ; LD A,(HL)         ; 
       cb   a,@bytes+>09                                   ; CP $09            ; all 9 tried?
       jne  _5102                                          ; JR NZ,$5102       ; no - try the next
       sb   *hl,*hl                                        ; LD (HL),$00       ; yes - wrap the attempt counter...
       li   hl,ring_position_bit_state_1                   ; LD HL,$E838       ; ...and advance the bit-pattern state
       movb *hl,a                                          ; LD A,(HL)         ; 
       li   r0,255*256                                     ; XOR $FF           ; 
       xor  r0,a                                           ;                   
       movb a,*hl                                          ; LD (HL),A         ; 
       jne  _5102                                          ; JR NZ,$5102       ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       li   r0,255*256                                     ; XOR $FF           ; 
       xor  r0,a                                           ;                   
       jne  !                                              ; RET Z             ; exhausted every state - give up, draw nothing
       .ret                                                ;                   
!
       movb a,*hl                                          ; LD (HL),A         ; 
_5102:                                                     ; >5102
       jmp  _50e3                                          ; JR $50E3          ; try again
continue_50ce_draw_name_label:                             ; >5104
       li   hl,unused_counter_e70d                         ; LD HL,$E70D       ; a nesting/reentrancy counter
       ab   one,*hl                                        ; INC (HL)          ; 
       mov  @chart_label_settled_column,bc                 ; LD BC,($E836)     ; the settled label row/column
       .call @pixel_address                                ; CALL $37D1        ; -> a VRAM address
       mov  hl,@cursor_vram_addr                           ; LD ($E70F),HL     ; set the text cursor there
       movb h,a                                            ; LD A,H            ; 
       ab   @bytes+>20,a                                   ; ADD A,$20         ; 
       movb a,h                                            ; LD H,A            ; 
       movb @chart_label_width,a                           ; LD A,($E833)      ; A = the box width
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>08,b                                   ; LD B,$08          ; 8 pixel-rows tall
       movb @chart_label_fill_pattern,a                    ; LD A,($E83B)      ; A = the fill pattern
       .call @fill_vram_rect                               ; CALL $35B8        ; fill the box
       sb   a,a                                            ; XOR A             ; 
       movb a,@cursor_subpixel_offset                      ; LD ($E70E),A      ; clear the cursor's sub-pixel shift
       li   hl,text_buffer                                 ; LD HL,$E717       ; the generated name
       .rst >08                                            ; RST $08           ; print it
       li   hl,unused_counter_e70d                         ; LD HL,$E70D       ; 
       sb   one,*hl                                        ; DEC (HL)          ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Local chart: try a place for a system's label
* 
* Used by the routine at #R$50CE.
* .
* Works out the label's position (#R$E836, #R$E837) for the current try
* (#R$E83A): the system's position plus or minus (at $5180, $51B2, by
* direction) percentages of the label's size (#R$E835) from the tables at
* #R$56BD and #R$56C6, with the column rounded to a multiple of 8. Returns with
* carry set if that's off the chart, or (at $51E4) the box behind the label
* has anything drawn in it already (at $5202).
* 
* O:F Carry set if the label doesn't fit there
local_chart_try_label:                                     ; >512f
       movb @ring_position_attempt_counter,a               ; LD A,($E83A)      ; the attempt counter (0-8)
       li   ix,label_offset_cosines                        ; LD IX,$56BD       ; the first axis's table
       movb a,@label_offset_cos+>0002                      ; LD ($513B),A      ; patch the displacement (#R$5139+2)
label_offset_cos:                                          ; >5139
       movb *ix,a                                          ; LD A,(IX+$00)     ; 
       .push af                                            ; PUSH AF           ; 
       mov  @ring_position_scale_limit,de                  ; LD DE,($E835)     ; a scale/limit value
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; 
       movb @bytes+>64,a                                   ; LD A,$64          ; /100
       .call @divide_hl_a                                  ; CALL $2079        ; 
       movb @shared_normalize_mantissa,a                   ; LD A,($EB9C)      ; a per-item base value
       ab   @l,a                                           ; ADD A,L           ; 
       .pop de                                             ; POP DE            ; 
       .push af                                            ; PUSH AF           ; 
       movb d,@e                                           ; LD E,D            ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; 
       movb @bytes+>64,a                                   ; LD A,$64          ; /100
       .call @divide_hl_a                                  ; CALL $2079        ; 
       movb @l,a                                           ; LD A,L            ; 
       .pop de                                             ; POP DE            ; 
       .push af                                            ; PUSH AF           ; 
       movb @ring_position_attempt_counter,a               ; LD A,($E83A)      ; the attempt counter again
       li   ix,label_offset_sines                          ; LD IX,$56C6       ; the second axis's table
       movb a,@label_offset_sin+>0002                      ; LD ($5167),A      ; patch the displacement (#R$5165+2)
label_offset_sin:                                          ; >5165
       movb *ix,a                                          ; LD A,(IX+$00)     ; 
       movb d,@e                                           ; LD E,D            ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; 
       movb @bytes+>64,a                                   ; LD A,$64          ; /100
       .call @divide_hl_a                                  ; CALL $2079        ; 
       .pop de                                             ; POP DE            ; 
       movb @l,@e                                          ; LD E,L            ; 
       movb @ring_position_bit_state_1,a                   ; LD A,($E838)      ; the angle-like bit-pattern state
       socb a,a                                            ; OR A              ; 
       movb @chart_marker_screen_position,a                ; LD A,($E82E)      ; A = the marker's own scaled position
       jne  continue_512f_settle_candidate_column          ; JR NZ,$5180       ; 
       ab   d,a                                            ; ADD A,D           ; 
       jnc  !                                              ; RET C             ; TODO: check code. 
       .ret                                                ;                   
!
       jmp  _5182                                          ; JR $5182          ; 
continue_512f_settle_candidate_column:                     ; >5180
       sb   d,a                                            ; SUB D             ; combine with the first offset
       jnc  !                                              ; RET C             ; TODO: check code. out of range - reject this candidate
       .ret                                                ;                   
!
_5182:                                                     ; >5182
       movb a,@c                                           ; LD C,A            ; 
       li   hl,ring_position_scale_limit                   ; LD HL,$E835       ; 
       sb   *hl,a                                          ; SUB (HL)          ; check against the scale/limit value
       jnc  !                                              ; RET C             ; TODO: check code. out of range - reject this candidate
       .ret                                                ;                   
!
       movb a,@c                                           ; LD C,A            ; 
       andi a,>f800                                        ; AND $F8           ; round down to a multiple of 8...
       movb a,b                                            ; LD B,A            ; 
       movb @c,a                                           ; LD A,C            ; 
       andi a,>0700                                        ; AND $07           ; ...nudging up by 8 if the remainder was >= 4
       cb   a,@bytes+>04                                   ; CP $04            ; 
       movb b,a                                            ; LD A,B            ; 
       joc  _5196                                          ; JR C,$5196        ; TODO: check code. 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; 
_5196:                                                     ; >5196
       cb   a,@bytes+>18                                   ; CP $18            ; still within range?
       jhe  !                                              ; RET C             ; no - reject this candidate
       .ret                                                ;                   
!
       movb a,@chart_label_settled_column                  ; LD ($E836),A      ; yes - settle the column
       li   hl,chart_label_width_limit                     ; LD HL,$E834       ; a width-related limit
       ab   *hl,a                                          ; ADD A,(HL)        ; does the label fit without running off the right edge?
       jnc  !                                              ; RET C             ; TODO: check code. no - reject this candidate
       .ret                                                ;                   
!
       cb   a,@bytes+>e8                                   ; CP $E8            ; too close to the edge anyway?
       jhe  reject_label_placement_candidate               ; JR NC,$5202       ; yes - reject this candidate
       movb @ring_position_bit_state_2,a                   ; LD A,($E839)      ; the row axis's angle-state sign
       socb a,a                                            ; OR A              ; 
       movb @chart_position_y,a                            ; LD A,($E82F)      ; A = the marker's other coordinate
       jne  continue_5180_subtract_row_offset              ; JR NZ,$51B2       ; set - subtract the row offset instead
       ab   @e,a                                           ; ADD A,E           ; clear - add the row offset
       jnc  !                                              ; RET C             ; TODO: check code. out of range - reject this candidate
       .ret                                                ;                   
!
       jmp  _51b4                                          ; JR $51B4          ; 
continue_5180_subtract_row_offset:                         ; >51b2
       sb   @e,a                                           ; SUB E             ; subtract the row offset
       jnc  !                                              ; RET C             ; TODO: check code. out of range - reject this candidate
       .ret                                                ;                   
!
_51b4:                                                     ; >51b4
       sb   @bytes+>04,a                                   ; SUB $04           ; finish settling the row
       jnc  !                                              ; RET C             ; TODO: check code. out of range - reject this candidate
       .ret                                                ;                   
!
       cb   a,@bytes+>08                                   ; CP $08            ; too close to the top?
       jhe  !                                              ; RET C             ; yes - reject this candidate
       .ret                                                ;                   
!
       movb a,@chart_label_settled_row                     ; LD ($E837),A      ; settle the row
       ab   @bytes+>07,a                                   ; ADD A,$07         ; does the label fit without running off the bottom?
       jnc  !                                              ; RET C             ; TODO: check code. no - reject this candidate
       .ret                                                ;                   
!
       cb   a,@bytes+>a8                                   ; CP $A8            ; too close to the bottom anyway?
       jhe  reject_label_placement_candidate               ; JR NC,$5202       ; yes - reject this candidate
       mov  @chart_label_settled_column,bc                 ; LD BC,($E836)     ; BC = the settled (column, row)
       .call @pixel_address                                ; CALL $37D1        ; -> a VRAM pattern-table address
       movb @chart_label_width,a                           ; LD A,($E833)      ; A = the label's width
       movb a,@c                                           ; LD C,A            ; 
_51cf:                                                     ; >51cf
       .push hl                                            ; PUSH HL           ; 
       limi 0                                              ; DI                ; VDP address/data access must not be interrupted
       movb @l,a                                           ; LD A,L            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb h,a                                            ; LD A,H            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, read mode
       .push hl                                            ; PUSH HL           ; (timing delay - let the VDP latch the address)
       .pop hl                                             ; POP HL            ; 
       movb @bytes+>08,b                                   ; LD B,$08          ; 8 pixel-rows
_51db:                                                     ; >51db
       movb @vdprd,a                                       ; IN A,($98)        ; A = the current pattern byte there
       socb a,a                                            ; OR A              ; already occupied (nonzero)?
       jeq  continue_51b2_step_check_collision             ; JR Z,$51E4        ; no - check the next row
       .pop hl                                             ; POP HL            ; yes - collides with something already drawn
       ; EI                                                ; EI                ; TODO: check code. 
       ; SCF                                               ; SCF               ; TODO: check code. reject this candidate
       .ret                                                ; RET               ; 
continue_51b2_step_check_collision:                        ; >51e4
       ab   one,@l                                         ; INC L             ; -> the next row within this column
       movb @l,a                                           ; LD A,L            ; 
       andi a,>0700                                        ; AND $07           ; 
       jne  _51f6                                          ; JR NZ,$51F6       ; still within this character - keep going
       movb @l,a                                           ; LD A,L            ; crossed an 8-byte pattern-table boundary -
       sb   one,a                                          ; DEC A             ; ...snap back to its start...
       andi a,>f800                                        ; AND $F8           ; 
       movb a,@l                                           ; LD L,A            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       ab   one,h                                          ; INC H             ; ...and move into the next bank
       movb h,a                                            ; LD A,H            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       nop                                                 ; NOP               ; 
_51f6:                                                     ; >51f6
       sb   one,b                                          ; DJNZ $51DB        ; next row
       jne  _51db                                          ;                   
       ; EI                                                ; EI                ; TODO: check code. 
       .pop hl                                             ; POP HL            ; recover the column's start address
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; -> the next column
       movb a,@l                                           ; LD L,A            ; 
       sb   one,@c                                         ; DEC C             ; one fewer column to check
       jne  _51cf                                          ; JR NZ,$51CF       ; more columns - check the next one
       .ret                                                ; RET               ; no collision found - accept (carry clear)
reject_label_placement_candidate:                          ; >5202
       ; SCF                                               ; SCF               ; TODO: check code. carry set = reject
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a system's chart marker: short vertical strokes from #R$13ED
* 
* Used by the routine at #R$502C.
* .
* Caches the marker's position to $E82E. Picks one of the first 4
* circle point lists (#R$13ED, also used for the fuel range circle by
* #R$4DAB, but here indexed just 1-4 by `(IX+4) AND 3`, cached
* to (IY+$19) too), then for each (X, Y) offset pair in that record:
* computes marker_X-offsetX and marker_X+offsetX (each clamped/
* rejected near the screen edges, $18/$E8), and for each one that
* survives, calls #R$523A to draw a short vertical stroke at that X,
* spanning marker_Y-offsetY to marker_Y+offsetY (also clamped). The
* whole record's strokes together build the visible marker shape -
* and, as a side effect, mark those pattern-table bytes non-zero,
* which is exactly what #R$51DB's later label-placement collision
* check reads back.
* 
* I:BC The marker's screen position (as #R$4F09 produced)
* I:IX -> the system record #R$4BA8 also reads (for its +4 field)
* I:IY -> this chart entry's own record
draw_system_chart_marker:                                  ; >5204
       mov  bc,@chart_marker_screen_position               ; LD ($E82E),BC     ; cache the marker's position
       movb @>04(ix),a                                     ; LD A,(IX+$04)     ; 
       andi a,>0300                                        ; AND $03           ; pick one of the first 4 #R$13ED records
       ab   one,a                                          ; INC A             ; 
       movb a,@>19(iy)                                     ; LD (IY+$19),A     ; cache which one
       ab   a,a                                            ; ADD A,A           ; *2 (word-sized pointers)
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,circle_point_lists                          ; LD HL,$13ED       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this record's pointer
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL -> the record itself
       movb *hl,b                                          ; LD B,(HL)         ; B = its point count
       inc  hl                                             ; INC HL            ; 
_521f:                                                     ; >521f
       movb @chart_marker_screen_position,a                ; LD A,($E82E)      ; A = the marker's X
       sb   *hl,a                                          ; SUB (HL)          ; -offsetX
       joc  _522a                                          ; JR C,$522A        ; TODO: check code. underflowed - too close to the left edge, skip
       cb   a,@bytes+>18                                   ; CP $18            ; still too close?
       jl   !                                              ; CALL NC,$523A     ; no - draw a stroke at this X
       .call @draw_marker_stroke_vertical                  ;                   
!
_522a:                                                     ; >522a
       movb @chart_marker_screen_position,a                ; LD A,($E82E)      ; A = the marker's X
       ab   *hl,a                                          ; ADD A,(HL)        ; +offsetX
       joc  _5235                                          ; JR C,$5235        ; TODO: check code. overflowed - too close to the right edge, skip
       cb   a,@bytes+>e8                                   ; CP $E8            ; still too close?
       ; CALL C,$523A                                      ; CALL C,$523A      ; TODO: check code. no - draw a stroke at this X
_5235:                                                     ; >5235
       inc  hl                                             ; INC HL            ; -> the next point's X
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $521F        ; next point
       jne  _521f                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Draw one vertical stroke of #R$5204's marker, spanning Y +-offset
* 
* Used by the routine at #R$5204.
* .
* I:A The stroke's X (column)
* I:HL -> the current point's X-offset byte (Y-offset is at HL+1)
* I:($E82F) The marker's Y
draw_marker_stroke_vertical:                               ; >523a
       .push bc                                            ; PUSH BC           ; save the caller's point-count loop
       .push hl                                            ; PUSH HL           ; 
       movb a,@c                                           ; LD C,A            ; C = the stroke's X
       movb @chart_position_y,a                            ; LD A,($E82F)      ; A = the marker's Y
       inc  hl                                             ; INC HL            ; -> this point's Y-offset
       sb   *hl,a                                          ; SUB (HL)          ; -offsetY
       joc  _5248                                          ; JR C,$5248        ; TODO: check code. underflowed - clamp to the top edge
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jhe  _524a                                          ; JR NC,$524A       ; not too close - keep it
_5248:                                                     ; >5248
       movb @bytes+>08,a                                   ; LD A,$08          ; clamp to the top edge
_524a:                                                     ; >524a
       movb a,b                                            ; LD B,A            ; B = the stroke's starting Y
       movb @chart_position_y,a                            ; LD A,($E82F)      ; A = the marker's Y
       ab   *hl,a                                          ; ADD A,(HL)        ; +offsetY
       joc  _5255                                          ; JR C,$5255        ; TODO: check code. overflowed - clamp to the bottom edge
       cb   a,@bytes+>a8                                   ; CP $A8            ; 
       jl   _5257                                          ; JR C,$5257        ; not too close - keep it
_5255:                                                     ; >5255
       movb @bytes+>a7,a                                   ; LD A,$A7          ; clamp to the bottom edge
_5257:                                                     ; >5257
       movb a,d                                            ; LD D,A            ; D = the stroke's ending Y
       movb @c,@e                                          ; LD E,C            ; E = the same X (a vertical stroke)
       .call @draw_bresenham_line_372b                     ; CALL $372B        ; draw it
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; restore the caller's point-count loop
       .ret                                                ; RET               ; 

********************************************************************************
* Undo #R$4EEC's scaling: screen (B, C) back to chart units
* 
* Used by the routine at #R$5314.
* .
* The inverse of #R$4EEC (`B := B*$9F/$7F + 8, C := C*$CF/$7F + $18`):
* C := (C-$18) * (-1/$CF via $FF) * $7F, B := (B-8) similarly via $9F.
* Converts a screen position (e.g. a cursor) back into the chart's own
* coordinate units.
unscale_4eec_coordinate_pair:                              ; >525f
       .push bc                                            ; PUSH BC           ; 
       movb @c,a                                           ; LD A,C            ; A = C (the screen X)
       sb   @bytes+>18,a                                   ; SUB $18           ; undo the offset
       movb @b255,@e                                       ; LD E,$FF          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; undo the *$CF scale
       movb @bytes+>cf,a                                   ; LD A,$CF          ; 
       .call @divide_hl_a                                  ; CALL $2079        ; 
       .pop af                                             ; POP AF            ; 
       .push hl                                            ; PUSH HL           ; 
       sb   @bytes+>08,a                                   ; SUB $08           ; undo the offset (the screen Y)
       movb @bytes+>7f,@e                                  ; LD E,$7F          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; undo the *$9F scale
       movb @bytes+>9f,a                                   ; LD A,$9F          ; 
       .call @divide_hl_a                                  ; CALL $2079        ; 
       movb @l,a                                           ; LD A,L            ; 
       .pop bc                                             ; POP BC            ; 
       movb a,b                                            ; LD B,A            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Update the chart cursor
* 
* Used by the routines at #R$4F64 and #R$A469.
* .
* In witchspace (#R$EEC1), puts the cursor on the ship's position ($EEC3)
* on the local chart (#R$4F09) or the galactic chart (#R$4EEC, at $5298).
* .
* Otherwise (at $52A4), selects the current system (#R$E72B, #R$EB67) and
* moves the cursor to it: on the local chart (at $52C3, #R$53ED), first
* redrawing the chart centred on it (#R$4F64) unless it already is
* (#R$E83C); on the galactic chart at $52C8 (#R$53FD).
update_chart_cursor:                                       ; >527f
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jeq  select_current_system                          ; JR Z,$52A4        ; no
       mov  @witchspace_position,bc                        ; LD BC,($EEC3)     ; BC = the ship's position in witchspace
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,@bytes+>06                                   ; CP $06            ; the local chart?
       jne  update_chart_cursor_2                          ; JR NZ,$5298       ; no - try the next mode
       .call @local_chart_coordinates                      ; CALL $4F09        ; scale relative to the chart's origin
       .call @move_cursor_to_position                      ; CALL $540D        ; move the cursor there
       jmp  _52a2                                          ; JR $52A2          ; 
update_chart_cursor_2:                                     ; >5298
       cb   a,@bytes+>04                                   ; CP $04            ; the galactic chart?
       jne  _52a2                                          ; JR NZ,$52A2       ; no
       .call @galactic_chart_coordinates                   ; CALL $4EEC        ; convert to screen coordinates
       .call @move_cursor_to_position                      ; CALL $540D        ; move the cursor there
_52a2:                                                     ; >52a2
       jmp  _52cd                                          ; JR $52CD          ; 
select_current_system:                                     ; >52a4
       movb @current_system,a                              ; LD A,($EB67)      ; the current system
       movb a,@selected_system                             ; LD ($E72B),A      ; select the current system
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,@bytes+>06                                   ; CP $06            ; the local chart?
       jne  select_current_system_3                        ; JR NZ,$52C8       ; no
       movb @current_system,a                              ; LD A,($EB67)      ; yes: A = the target again
       li   hl,chart_chosen_system_index                   ; LD HL,$E83C       ; HL -> the chart's last-chosen system
       cb   a,*hl                                          ; CP (HL)           ; is the chart centred on it?
       jeq  select_current_system_2                        ; JR Z,$52C3        ; yes
       sb   a,a                                            ; XOR A             ; 
       movb a,@current_screen                              ; LD ($E902),A      ; 
       .call @local_chart                                  ; CALL $4F64        ; redraw the local chart around it
       jmp  _52c6                                          ; JR $52C6          ; 
select_current_system_2:                                   ; >52c3
       .call @local_chart_cursor_to_selected               ; CALL $53ED        ; move the cursor to the selected system
_52c6:                                                     ; >52c6
       jmp  _52cd                                          ; JR $52CD          ; 
select_current_system_3:                                   ; >52c8
       cb   a,@bytes+>04                                   ; CP $04            ; the galactic chart?
       jne  !                                              ; CALL Z,$53FD      ; yes - move the cursor to the selected system
       .call @galactic_chart_cursor_to_selected            ;                   
!
_52cd:                                                     ; >52cd
       .ret                                                ; RET               ; 

********************************************************************************
* Key 'D': show the distance to the selected system
* 
* Used by the routine at #R$55A3.
* .
* Reached via the key table at #R$419B, and after finding a system by
* name (#R$55F6). Does nothing unless a chart is showing (#R$E70B).
* Selects the system nearest the cursor and moves the cursor to it - on
* the galactic chart (#R$5314, #R$53FD) unless a system has just been
* found by name (#R$E82D), or on the local chart (#R$538B, #R$53ED).
* .
* At $52F4, clears the message line and prints the selected system's
* name, ": ", its distance (#R$6141, to one decimal place) and " Light
* Years".
key_distance:                                              ; >52ce
       movb @chart_cursor_active_flag,a                    ; LD A,($E70B)      ; A = chart cursor on?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no chart showing
       .ret                                                ;                   
!
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,@bytes+>04                                   ; CP $04            ; the galactic chart?
       jne  key_distance_3                                 ; JR NZ,$52EE       ; no - the local chart
       movb @found_by_name,a                               ; LD A,($E82D)      ; just found by name?
       socb a,a                                            ; OR A              ; 
       jne  key_distance_2                                 ; JR NZ,$52E8       ; yes
       .call @galactic_chart_select                        ; CALL $5314        ; select the system nearest the cursor
       .call @galactic_chart_cursor_to_selected            ; CALL $53FD        ; move the cursor to it
       jmp  _52ec                                          ; JR $52EC          ; show the distance
key_distance_2:                                            ; >52e8
       sb   a,a                                            ; XOR A             ; 
       movb a,@found_by_name                               ; LD ($E82D),A      ; clear the found-by-name flag
_52ec:                                                     ; >52ec
       jmp  _52f4                                          ; JR $52F4          ; show the distance
key_distance_3:                                            ; >52ee
       .call @local_chart_select                           ; CALL $538B        ; select the system nearest the cursor
       .call @local_chart_cursor_to_selected               ; CALL $53ED        ; move the cursor to it
_52f4:                                                     ; >52f4
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       .call @generate_system_name                         ; CALL $4CAF        ; generate its name
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       .rst >08                                            ; RST $08           ; print it
       li   hl,msg_colon_separator                         ; LD HL,$5678       ; ": "
       .rst >08                                            ; RST $08           ; print it
       .call @distance_to_selected_system                  ; CALL $6141        ; HL = distance (in tenths)
       movb @l,@c                                          ; LD C,L            ; 
       movb h,@l                                           ; LD L,H            ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; with a decimal point
       .rst >18                                            ; RST $18           ; print it
       li   hl,msg_light_years                             ; LD HL,$567B       ; " Light Years"
       .rst >08                                            ; RST $08           ; print it
       .ret                                                ; RET               ; 

********************************************************************************
* Galactic chart: select the system nearest the cursor
* 
* Used by the routines at #R$52CE, #R$541E, #R$6164 and #R$88AC.
* .
* Converts the cursor position (#R$E709, plus half a character) to galaxy
* coordinates (#R$525F), and selects the nearest system (#R$5325).
galactic_chart_select:                                     ; >5314
       mov  @chart_cursor_x,hl                             ; LD HL,($E709)     ; the raw cursor position
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>07,a                                   ; ADD A,$07         ; 
       movb a,@c                                           ; LD C,A            ; 
       movb h,a                                            ; LD A,H            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; 
       movb a,b                                            ; LD B,A            ; 
       .call @unscale_4eec_coordinate_pair                 ; CALL $525F        ; unscale to chart units
       b    @nearest_and_furthest_systems                  ; JP $5325          ; find the nearest system to it

********************************************************************************
* Find the nearest and furthest systems to a point
* 
* Used by the routines at #R$5314, #R$894D and #R$9120.
* .
* Goes through all 256 systems in the galaxy (#R$4C80), working out the
* square of each one's distance from the point (#R$205D), and selects the
* nearest (#R$E72B). Also finds the furthest (#R$E83D), for the missions
* (#R$9120).
* 
* I:BC The point (B y, C x)
* O:A The furthest system (also in #R$E83D)
nearest_and_furthest_systems:                              ; >5325
       mov  bc,@system_search_point                        ; LD ($E61B),BC     ; the point
       li   hl,>ffff                                       ; LD HL,$FFFF       ; 
       mov  hl,@nearest_distance                           ; LD ($E613),HL     ; the nearest so far: none
       mov  hl,@nearest_distance_hi                        ; LD ($E615),HL     ; 
       inc  hl                                             ; INC HL            ; 
       mov  hl,@furthest_distance                          ; LD ($E617),HL     ; the furthest so far: none
       mov  hl,@furthest_distance_hi                       ; LD ($E619),HL     ; 
       .call @galaxy_seeds_to_system                       ; CALL $5607        ; start at system 0
_533c:                                                     ; >533c
       .push bc                                            ; PUSH BC           ; 
       .call @next_system_coordinates                      ; CALL $4C80        ; BC = this system's coordinates
       mov  @system_search_point,de                        ; LD DE,($E61B)     ; DE = the point
       .call @squared_distance_2d                          ; CALL $205D        ; AHL = distance squared
       movb a,@e                                           ; LD E,A            ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @nearest_distance,bc                           ; LD BC,($E613)     ; 
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; 
       mov  @nearest_distance_hi,bc                        ; LD BC,($E615)     ; 
       sb   @c,a                                           ; SBC A,C           ; 
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       jnc  _5366                                          ; JR NC,$5366       ; TODO: check code. not nearer
       mov  hl,@nearest_distance                           ; LD ($E613),HL     ; the nearest so far
       mov  de,@nearest_distance_hi                        ; LD ($E615),DE     ; 
       movb b,a                                            ; LD A,B            ; 
       neg a                                               ; NEG               ; 
       movb a,@selected_system                             ; LD ($E72B),A      ; select it
_5366:                                                     ; >5366
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       mov  @furthest_distance,bc                          ; LD BC,($E617)     ; 
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; 
       mov  @furthest_distance_hi,bc                       ; LD BC,($E619)     ; 
       sb   @c,a                                           ; SBC A,C           ; 
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       joc  _5385                                          ; JR C,$5385        ; TODO: check code. not further
       mov  hl,@furthest_distance                          ; LD ($E617),HL     ; the furthest so far
       mov  de,@furthest_distance_hi                       ; LD ($E619),DE     ; 
       movb b,a                                            ; LD A,B            ; and its system index
       neg a                                               ; NEG               ; 
       movb a,@furthest_system                             ; LD ($E83D),A      ; 
_5385:                                                     ; >5385
       sb   one,b                                          ; DJNZ $533C        ; next system
       jne  _533c                                          ;                   
       movb @furthest_system,a                             ; LD A,($E83D)      ; A = the furthest system
       .ret                                                ; RET               ; 

********************************************************************************
* Local chart: select the system nearest the cursor
* 
* Used by the routines at #R$4F64, #R$52CE, #R$6164 and #R$88AC.
* .
* Converts the cursor position (#R$E709, plus half a character) to galaxy
* coordinates (#R$4F37), and selects the nearest of the systems on the
* chart (#R$EFA4, #R$E832, listed by #R$502C) (#R$E72B).
local_chart_select:                                        ; >538b
       mov  @chart_cursor_x,hl                             ; LD HL,($E709)     ; the raw cursor position
       movb @l,a                                           ; LD A,L            ; 
       ab   @bytes+>07,a                                   ; ADD A,$07         ; 
       movb a,@c                                           ; LD C,A            ; 
       movb h,a                                            ; LD A,H            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; 
       movb a,b                                            ; LD B,A            ; 
       .call @local_chart_galaxy_coordinates               ; CALL $4F37        ; unscale to chart units
       mov  bc,@system_search_point                        ; LD ($E61B),BC     ; cache the search point
       li   hl,>ffff                                       ; LD HL,$FFFF       ; 
       mov  hl,@nearest_distance                           ; LD ($E613),HL     ; the running minimum starts at "maximally far"
       mov  hl,@nearest_distance_hi                        ; LD ($E615),HL     ; 
       mov  @reclaimed_range_end,ix                        ; LD IX,($EFA4)     ; IX -> #R$502C's already-found nearby-systems list
       movb @nearby_systems_count,a                        ; LD A,($E832)      ; A = how many are in it
       movb a,b                                            ; LD B,A            ; 
_53ae:                                                     ; >53ae
       .push bc                                            ; PUSH BC           ; 
       .push ix                                            ; PUSH IX           ; 
       movb *ix,a                                          ; LD A,(IX+$00)     ; A = this list entry's system index
       .call @generate_system                              ; CALL $4C9B        ; generate its name-seed coordinates
       mov  @system_x,de                                   ; LD DE,($F751)     ; DE = its (X, Y)
       mov  @system_search_point,bc                        ; LD BC,($E61B)     ; BC = the search point
       .call @squared_distance_2d                          ; CALL $205D        ; HL:A = the squared distance to it
       .ex_de_hl                                           ; EX DE,HL          ; 
       .push iy                                            ; PUSH IY           ; 
       .pop hl                                             ; POP HL            ; 
       socb a,a                                            ; OR A              ; 
       mov  @nearest_distance,bc                           ; LD BC,($E613)     ; compare against the running minimum
       s    bc,hl                                          ; SBC HL,BC         ; 
       movb d,h                                            ; LD H,D            ; 
       movb @e,@l                                          ; LD L,E            ; 
       mov  @nearest_distance_hi,bc                        ; LD BC,($E615)     ; 
       s    bc,hl                                          ; SBC HL,BC         ; 
       .pop ix                                             ; POP IX            ; 
       .pop bc                                             ; POP BC            ; 
       jnc  _53e8                                          ; JR NC,$53E8       ; TODO: check code. not closer - next entry
       mov  iy,@nearest_distance                           ; LD ($E613),IY     ; closer - update the running minimum
       mov  de,@nearest_distance_hi                        ; LD ($E615),DE     ; 
       movb *ix,a                                          ; LD A,(IX+$00)     ; and select this entry
       movb a,@selected_system                             ; LD ($E72B),A      ; 
_53e8:                                                     ; >53e8
       inc  ix                                             ; INC IX            ; -> the next list entry
       sb   one,b                                          ; DJNZ $53AE        ; 
       jne  _53ae                                          ;                   
       .ret                                                ; RET               ; 

********************************************************************************
* Local chart: move the cursor to the selected system
* 
* Used by the routines at #R$4F64, #R$527F, #R$52CE and #R$88AC.
* .
* Generates the selected system (#R$E72B, #R$4C9B), and moves the cursor
* (#R$540D) to its position on the local chart (#R$4F09).
local_chart_cursor_to_selected:                            ; >53ed
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       .call @generate_system                              ; CALL $4C9B        ; generate its data
       mov  @system_x,bc                                   ; LD BC,($F751)     ; 
       .call @local_chart_coordinates                      ; CALL $4F09        ; convert to local chart coordinates
       b    @move_cursor_to_position                       ; JP $540D          ; move the cursor there

********************************************************************************
* Galactic chart: move the cursor to the selected system
* 
* Used by the routines at #R$4D0B, #R$527F, #R$52CE, #R$541E, #R$55A3 and
* #R$88AC.
* .
* Generates the selected system (#R$E72B, #R$4C9B), and moves the cursor
* (#R$540D) to its position on the galactic chart (#R$4EEC).
galactic_chart_cursor_to_selected:                         ; >53fd
       movb @selected_system,a                             ; LD A,($E72B)      ; the selected system
       .call @generate_system                              ; CALL $4C9B        ; generate its data
       mov  @system_x,bc                                   ; LD BC,($F751)     ; 
       .call @galactic_chart_coordinates                   ; CALL $4EEC        ; convert to galactic chart coordinates
       b    @move_cursor_to_position                       ; JP $540D          ; move the cursor there

********************************************************************************
* Move the cursor/marker sprite to screen position (B, C)
* 
* Used by the routines at #R$4D0B, #R$4F64, #R$527F, #R$53ED and #R$53FD.
* .
* Undoes #R$5314's own (+7,+8) cell-centring nudge and stores the
* result to #R$E709 (the cursor position), then calls #R$73A6 to
* actually redraw the sprite there.
move_cursor_to_position:                                   ; >540d
       movb @c,a                                           ; LD A,C            ; A = C (the target X)
       sb   @bytes+>07,a                                   ; SUB $07           ; undo #R$5314's nudge
       movb a,@l                                           ; LD L,A            ; 
       movb b,a                                            ; LD A,B            ; A = B (the target Y)
       sb   @bytes+>08,a                                   ; SUB $08           ; undo #R$5314's nudge
       movb a,h                                            ; LD H,A            ; 
       mov  hl,@chart_cursor_x                             ; LD ($E709),HL     ; set the cursor position
       limi 0                                              ; DI                ; 
       .call @move_chart_cursor_sprite                     ; CALL $73A6        ; redraw the sprite there
       ; EI                                                ; EI                ; TODO: check code. 
       .ret                                                ; RET               ; 

********************************************************************************
* Animate an expanding box out from the cursor (a list-selection effect)
* 
* Used by the routine at #R$4F64.
* .
* Picks the nearest system to the cursor and moves it there (#R$5314/
* #R$53FD), then self-modifies #R$3793's `OR (IX+d)` opcode to XOR ($AE) at
* $37C0, so #R$372B's lines toggle pixels instead of setting them - letting
* each side be drawn once to show it and again later to erase it. Sets up a
* small starting rectangle around the cursor ($F769/$F76B=top-left,
* $F76F/$F771=bottom-right) and a 4-bit "which sides are still animating"
* flag at #R$E83E (all 4 set initially).
* .
* Each pass (#R$5444): draws whichever of the 4 sides still has its bit set
* (top #R$372B call at $5465, right at $547F, bottom at $5499, left at
* $54B3 - each XOR-toggling that edge), waits a short delay, then expands
* the rectangle by 16 in each direction, clamping each side at the screen
* edge and clearing its bit once it gets there. Repeats until all 4 sides
* have stopped (#R$E83E=0). Then, at $551E, changes the XOR back to OR.
animate_expanding_selection_box:                           ; >541e
       .call @galactic_chart_select                        ; CALL $5314        ; pick the nearest system to the cursor
       .call @galactic_chart_cursor_to_selected            ; CALL $53FD        ; move the cursor there
       movb @bytes+>ae,a                                   ; LD A,$AE          ; XOR opcode
       movb a,@plot_pixel_op+>0001                         ; LD ($37C0),A      ; change the OR into XOR (#R$37BF+1)
       movb @chart_cursor_x,a                              ; LD A,($E709)      ; the cursor's X
       ab   @bytes+>07,a                                   ; ADD A,$07         ; 
       movb a,@line_end_1_x                                ; LD ($F769),A      ; the box's left edge
       movb a,@line_end_2_x                                ; LD ($F76F),A      ; and initial right edge
       movb @chart_cursor_y,a                              ; LD A,($E70A)      ; the cursor's Y
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       movb a,@line_end_1_y                                ; LD ($F76B),A      ; the box's top edge
       movb a,@line_end_2_y                                ; LD ($F771),A      ; and initial bottom edge
       movb @bytes+>0f,a                                   ; LD A,$0F          ; all 4 sides still animating
       movb a,@selection_box_sides_animating               ; LD ($E83E),A      ; 
selection_box_pass:                                        ; >5444
       movb @selection_box_sides_animating,a               ; LD A,($E83E)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; JP Z,$551E        ; all sides finished - done
       b    @restore_3793_or_opcode                        ;                   
!
       movb one,b                                          ; LD B,$01          ; 
selection_box_side:                                        ; >544d
       .push bc                                            ; PUSH BC           ; 
       li   hl,selection_box_sides_animating               ; LD HL,$E83E       ; 
       movb *hl,r0                                         ; BIT 0,(HL)        ; top side still animating?
       andi r0,>0100                                       ;                   
       jeq  _5468                                          ; JR Z,$5468        ; 
       movb @line_end_1_x,a                                ; LD A,($F769)      ; draw/erase the top edge
       movb a,@c                                           ; LD C,A            ; 
       movb @line_end_1_y,a                                ; LD A,($F76B)      ; 
       movb a,b                                            ; LD B,A            ; 
       movb @line_end_2_x,a                                ; LD A,($F76F)      ; 
       movb a,@e                                           ; LD E,A            ; 
       movb @line_end_1_y,a                                ; LD A,($F76B)      ; 
       movb a,d                                            ; LD D,A            ; 
       .call @draw_bresenham_line_372b                     ; CALL $372B        ; 
_5468:                                                     ; >5468
       li   hl,selection_box_sides_animating               ; LD HL,$E83E       ; 
       movb *hl,r0                                         ; BIT 1,(HL)        ; right side still animating?
       andi r0,>0200                                       ;                   
       jeq  _5482                                          ; JR Z,$5482        ; 
       movb @line_end_2_x,a                                ; LD A,($F76F)      ; draw/erase the right edge
       movb a,@c                                           ; LD C,A            ; 
       movb @line_end_1_y,a                                ; LD A,($F76B)      ; 
       movb a,b                                            ; LD B,A            ; 
       movb @line_end_2_x,a                                ; LD A,($F76F)      ; 
       movb a,@e                                           ; LD E,A            ; 
       movb @line_end_2_y,a                                ; LD A,($F771)      ; 
       movb a,d                                            ; LD D,A            ; 
       .call @draw_bresenham_line_372b                     ; CALL $372B        ; 
_5482:                                                     ; >5482
       li   hl,selection_box_sides_animating               ; LD HL,$E83E       ; 
       movb *hl,r0                                         ; BIT 2,(HL)        ; bottom side still animating?
       andi r0,>0400                                       ;                   
       jeq  _549c                                          ; JR Z,$549C        ; 
       movb @line_end_2_x,a                                ; LD A,($F76F)      ; draw/erase the bottom edge
       movb a,@c                                           ; LD C,A            ; 
       movb @line_end_2_y,a                                ; LD A,($F771)      ; 
       movb a,b                                            ; LD B,A            ; 
       movb @line_end_1_x,a                                ; LD A,($F769)      ; 
       movb a,@e                                           ; LD E,A            ; 
       movb @line_end_2_y,a                                ; LD A,($F771)      ; 
       movb a,d                                            ; LD D,A            ; 
       .call @draw_bresenham_line_372b                     ; CALL $372B        ; 
_549c:                                                     ; >549c
       li   hl,selection_box_sides_animating               ; LD HL,$E83E       ; 
       movb *hl,r0                                         ; BIT 3,(HL)        ; left side still animating?
       andi r0,>0800                                       ;                   
       jeq  _54b6                                          ; JR Z,$54B6        ; 
       movb @line_end_1_x,a                                ; LD A,($F769)      ; draw/erase the left edge
       movb a,@c                                           ; LD C,A            ; 
       movb @line_end_2_y,a                                ; LD A,($F771)      ; 
       movb a,b                                            ; LD B,A            ; 
       movb @line_end_1_x,a                                ; LD A,($F769)      ; 
       movb a,@e                                           ; LD E,A            ; 
       movb @line_end_1_y,a                                ; LD A,($F76B)      ; 
       movb a,d                                            ; LD D,A            ; 
       .call @draw_bresenham_line_372b                     ; CALL $372B        ; 
_54b6:                                                     ; >54b6
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DEC B             ; 
       jne  _54c4                                          ; JR NZ,$54C4       ; 
       .push af                                            ; PUSH AF           ; a short delay
       li   de,>07d0                                       ; LD DE,$07D0       ; 
_54be:                                                     ; >54be
       dec  de                                             ; DEC DE            ; 
       movb d,a                                            ; LD A,D            ; 
       socb @e,a                                           ; OR E              ; 
       jne  _54be                                          ; JR NZ,$54BE       ; 
       .pop af                                             ; POP AF            ; 
_54c4:                                                     ; >54c4
       jlt  !                                              ; JP P,$544D        ; 
       b    @selection_box_side                            ;                   
!
       movb @line_end_1_y,a                                ; LD A,($F76B)      ; expand the top edge by 16...
       ab   @bytes+>f0,a                                   ; ADD A,$F0         ; 
       jnc  _54d2                                          ; JR NC,$54D2       ; TODO: check code. 
       cb   a,@bytes+>08                                   ; CP $08            ; 
       jhe  _54d9                                          ; JR NC,$54D9       ; 
_54d2:                                                     ; >54d2
       movb @bytes+>07,a                                   ; LD A,$07          ; ...clamping at the screen edge...
       li   hl,selection_box_sides_animating               ; LD HL,$E83E       ; 
       szcb @bit0,*hl                                      ; RES 0,(HL)        ; ...and stopping this side once it gets there
_54d9:                                                     ; >54d9
       movb a,@line_end_1_y                                ; LD ($F76B),A      ; 
       movb @line_end_2_x,a                                ; LD A,($F76F)      ; expand the right edge by 16...
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       joc  _54e7                                          ; JR C,$54E7        ; TODO: check code. 
       cb   a,@bytes+>e8                                   ; CP $E8            ; 
       jl   _54ee                                          ; JR C,$54EE        ; 
_54e7:                                                     ; >54e7
       movb @bytes+>e8,a                                   ; LD A,$E8          ; ...clamping at the screen edge...
       li   hl,selection_box_sides_animating               ; LD HL,$E83E       ; 
       szcb @bit1,*hl                                      ; RES 1,(HL)        ; ...and stopping this side once it gets there
_54ee:                                                     ; >54ee
       movb a,@line_end_2_x                                ; LD ($F76F),A      ; 
       movb @line_end_2_y,a                                ; LD A,($F771)      ; expand the bottom edge by 16...
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       joc  _54fc                                          ; JR C,$54FC        ; TODO: check code. 
       cb   a,@bytes+>a8                                   ; CP $A8            ; 
       jl   _5503                                          ; JR C,$5503        ; 
_54fc:                                                     ; >54fc
       movb @bytes+>a8,a                                   ; LD A,$A8          ; ...clamping at the screen edge...
       li   hl,selection_box_sides_animating               ; LD HL,$E83E       ; 
       szcb @bit2,*hl                                      ; RES 2,(HL)        ; ...and stopping this side once it gets there
_5503:                                                     ; >5503
       movb a,@line_end_2_y                                ; LD ($F771),A      ; 
       movb @line_end_1_x,a                                ; LD A,($F769)      ; expand the left edge by 16...
       ab   @bytes+>f0,a                                   ; ADD A,$F0         ; 
       jnc  _5511                                          ; JR NC,$5511       ; TODO: check code. 
       cb   a,@bytes+>18                                   ; CP $18            ; 
       jhe  _5518                                          ; JR NC,$5518       ; 
_5511:                                                     ; >5511
       movb @bytes+>17,a                                   ; LD A,$17          ; ...clamping at the screen edge...
       li   hl,selection_box_sides_animating               ; LD HL,$E83E       ; 
       szcb @bit3,*hl                                      ; RES 3,(HL)        ; ...and stopping this side once it gets there
_5518:                                                     ; >5518
       movb a,@line_end_1_x                                ; LD ($F769),A      ; 
       b    @selection_box_pass                            ; JP $5444          ; next pass
restore_3793_or_opcode:                                    ; >551e
       movb @bytes+>b6,a                                   ; LD A,$B6          ; the OR opcode
       movb a,@plot_pixel_op+>0001                         ; LD ($37C0),A      ; change the XOR back to OR (#R$37BF+1)
       .ret                                                ; RET               ; 

********************************************************************************
* Draw a jump-range circle around the current position, scaled by fuel
* 
* Used by the routine at #R$4F64.
* .
* Does nothing if #R$F775 (the fuel level) is 0. Otherwise enables
* #R$3793's background-check gate (#R$E90F) and, for 19 points around
* #R$1311's coarse trig table (trig_table_coarse), scales each
* coordinate by the fuel level (#R$1F60) and draws it, mirrored into
* all 4 quadrants via #R$5584 (which connects consecutive points with
* a line, tracing out the circle's outline) - a visual jump-range ring
* scaled to how far the current fuel would reach.
draw_fuel_range_circle:                                    ; >5524
       movb @fuel_level,a                                  ; LD A,($F775)      ; A = the fuel level
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; none - nothing to draw
       .ret                                                ;                   
!
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@e90f_equip_op_flag                          ; LD ($E90F),A      ; enable #R$3793's background-check gate
       movb a,@circle_connector_no_prev_point_gate         ; LD ($E602),A      ; mark "no previous point yet" (skip the first connect)
       li   hl,trig_table_coarse                           ; LD HL,$1311       ; the coarse trig table
       movb @bytes+>13,b                                   ; LD B,$13          ; 19 points around the circle
_5536:                                                     ; >5536
       .push bc                                            ; PUSH BC           ; 
       movb *hl,@e                                         ; LD E,(HL)         ; E:C = this point's raw (cos, sin)-style pair
       inc  hl                                             ; INC HL            ; 
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       .push hl                                            ; PUSH HL           ; 
       movb @fuel_level,a                                  ; LD A,($F775)      ; scale the first component by the fuel level
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; 
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. 
       movb h,@l                                           ; LD L,H            ; L = the scaled first component
       movb @bytes+>03,h                                   ; LD H,$03          ; 
       movb @c,@e                                          ; LD E,C            ; 
       movb *hl,@c                                         ; LD C,(HL)         ; C = 3/4 of it (#R$0300)
       movb @fuel_level,a                                  ; LD A,($F775)      ; scale the second component by the fuel level
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; 
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  h,1                                            ; RL H              ; TODO: check code. 
       movb h,b                                            ; LD B,H            ; 
       li   hl,lineplot_scratch_vars_e603                  ; LD HL,$E603       ; the "previous point" buffer
       movb b,d                                            ; LD D,B            ; 
       movb @c,@e                                          ; LD E,C            ; 
       .call @connect_circle_point                         ; CALL $5584        ; plot/connect quadrant (+,+)
       movb @c,a                                           ; LD A,C            ; 
       neg a                                               ; NEG               ; 
       movb a,@e                                           ; LD E,A            ; 
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb b,d                                            ; LD D,B            ; 
       .call @connect_circle_point                         ; CALL $5584        ; plot/connect quadrant (-,+)
       movb @c,@e                                          ; LD E,C            ; 
       movb b,a                                            ; LD A,B            ; 
       neg a                                               ; NEG               ; 
       movb a,d                                            ; LD D,A            ; 
       .push af                                            ; PUSH AF           ; 
       .call @connect_circle_point                         ; CALL $5584        ; plot/connect quadrant (+,-)
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb a,@e                                           ; LD E,A            ; 
       .pop af                                             ; POP AF            ; 
       movb a,d                                            ; LD D,A            ; 
       .call @connect_circle_point                         ; CALL $5584        ; plot/connect quadrant (-,-)
       sb   a,a                                            ; XOR A             ; 
       movb a,@circle_connector_no_prev_point_gate         ; LD ($E602),A      ; clear the "no previous point" mark (only true once)
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $5536        ; next point
       jne  _5536                                          ;                   
       sb   a,a                                            ; XOR A             ; 
       movb a,@e90f_equip_op_flag                          ; LD ($E90F),A      ; disable the background-check gate again
       .ret                                                ; RET               ; 

********************************************************************************
* Connect the previous circle point to a new one, then store it
* 
* Used by the routine at #R$5524.
* .
* Offsets (D, E) by the screen centre ($58, $80), and - unless
* #R$E602 says there's no previous point yet - draws a line from the
* point cached at (HL) to this one (#R$372B), then stores this point
* back to (HL) for next time.
connect_circle_point:                                      ; >5584
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; 
       ab   @e,a                                           ; ADD A,E           ; centre-offset X
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>58,a                                   ; LD A,$58          ; 
       ab   d,a                                            ; ADD A,D           ; centre-offset Y
       movb a,b                                            ; LD B,A            ; 
       .push bc                                            ; PUSH BC           ; 
       movb @circle_connector_no_prev_point_gate,a         ; LD A,($E602)      ; any previous point to connect from?
       socb a,a                                            ; OR A              ; 
       jne  _559b                                          ; JR NZ,$559B       ; no - just store this one
       movb *hl,@e                                         ; LD E,(HL)         ; yes: DE = the previous point
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       .call @draw_bresenham_line_372b                     ; CALL $372B        ; draw the connecting line
_559b:                                                     ; >559b
       .pop de                                             ; POP DE            ; 
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       movb @e,*hl                                         ; LD (HL),E         ; store this point as "previous" for next time
       inc  hl                                             ; INC HL            ; 
       movb d,*hl                                          ; LD (HL),D         ; 
       inc  hl                                             ; INC HL            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Key 'F': find a system by name
* 
* Reached via the key table at #R$419B; only works on the galactic chart
* (#R$E902 = 4). Turns the chart cursor off (#R$E70B) while asking "Planet
* name ? " and reading up to 10 capital letters (#R$3631), then lower-cases
* all but the first letter, as names are shown, and looks for the system
* ($55D2).
* .
* At $55D2, generates the systems' names in turn (#R$5607, #R$4C2B,
* #R$4CB8) and compares each with the name typed (#R$3A69); if one matches,
* $55F6 selects it; otherwise shows "<name> not found.". All 256 systems
* are searched: #R$5607's LDIR leaves B at 0, so the loop runs 256 times.
* .
* At $55F6, works out the system's number from the loop counter, selects
* it, moves the cursor to it (#R$53FD), and shows its distance (#R$52CE,
* #R$E82D).
key_find_system:                                           ; >55a3
       movb @current_screen,a                              ; LD A,($E902)      ; A = the current screen
       cb   a,@bytes+>04                                   ; CP $04            ; the galactic chart?
       jeq  !                                              ; RET NZ            ; no
       .ret                                                ;                   
!
       sb   a,a                                            ; XOR A             ; 
       movb a,@chart_cursor_active_flag                    ; LD ($E70B),A      ; turn the chart cursor off while typing
       .call @clear_message_line                           ; CALL $3955        ; clear the message line
       li   hl,msg_planet_name                             ; LD HL,$56A2       ; "Planet name ? "
       .rst >08                                            ; RST $08           ; print it
       li   de,>415a                                       ; LD DE,$415A       ; 'A' to 'Z'...
       movb @bytes+>0a,@c                                  ; LD C,$0A          ; ...up to 10 of them
       .call @read_line_keyboard_input                     ; CALL $3631        ; read them into $E8F7
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@chart_cursor_active_flag                    ; LD ($E70B),A      ; turn it back on
       joc  !                                              ; RET NC            ; TODO: check code. ESC
       .ret                                                ;                   
!
       li   hl,keyboard_input_buffer                       ; LD HL,$E8F7       ; the typed name
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; nothing typed
       .ret                                                ;                   
!
_55c8:                                                     ; >55c8
       inc  hl                                             ; INC HL            ; lower-case all but the first letter
       movb *hl,a                                          ; LD A,(HL)         ; 
       socb a,a                                            ; OR A              ; 
       jeq  key_find_system_2                              ; JR Z,$55D2        ; ...until its terminator
       ab   @bytes+>20,a                                   ; ADD A,$20         ; 
       movb a,*hl                                          ; LD (HL),A         ; 
       jmp  _55c8                                          ; JR $55C8          ; 
key_find_system_2:                                         ; >55d2
       .call @galaxy_seeds_to_system                       ; CALL $5607        ; start at system 0 (and B = 0: all 256 systems)
_55d5:                                                     ; >55d5
       .push bc                                            ; PUSH BC           ; 
       .call @system_data_from_seeds                       ; CALL $4C2B        ; work out its data, and move on to the next
       li   hl,system_name                                 ; LD HL,$F756       ; 
       .call @expand_name                                  ; CALL $4CB8        ; its name
       li   hl,text_buffer                                 ; LD HL,$E717       ; 
       li   de,keyboard_input_buffer                       ; LD DE,$E8F7       ; the name typed
       .call @compare_null_terminated_strings              ; CALL $3A69        ; the same?
       jeq  continue_55d2_match_found                      ; JR Z,$55F6        ; yes - select it
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $55D5        ; next system
       jne  _55d5                                          ;                   
       li   hl,keyboard_input_buffer                       ; LD HL,$E8F7       ; the name typed
       .rst >08                                            ; RST $08           ; 
       li   hl,msg_not_found                               ; LD HL,$56B1       ; " not found."
       .rst >08                                            ; RST $08           ; 
       .ret                                                ; RET               ; 
continue_55d2_match_found:                                 ; >55f6
       .pop af                                             ; POP AF            ; recover the loop counter
       sb   one,a                                          ; DEC A             ; 
       inv  a                                              ; CPL               ; A = 256 - B, the system's number
       movb a,@selected_system                             ; LD ($E72B),A      ; -> the selected system
       .call @galactic_chart_cursor_to_selected            ; CALL $53FD        ; move the cursor there
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@found_by_name                               ; LD ($E82D),A      ; pre-arm the gate
       b    @key_distance                                  ; JP $52CE          ; show its distance

********************************************************************************
* Start from the galaxy's seeds
* 
* Used by the routines at #R$4C9B, #R$4D0B, #R$502C, #R$5325 and #R$55A3.
* .
* Copies the galaxy's seeds (#R$E711) to the seeds of the system being
* generated (#R$E904): the seeds of system 0.
galaxy_seeds_to_system:                                    ; >5607
       li   hl,galaxy_seeds                                ; LD HL,$E711       ; source: a per-call seed value
       li   de,system_seeds                                ; LD DE,$E904       ; dest: rotating_accumulator
       li   bc,>0006                                       ; LD BC,$0006       ; 6 bytes
       .ldir                                               ; LDIR              ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Move on to the next system: twist the seeds four times
* 
* Used by the routines at #R$4C80 and #R$4C9B.
* .
* Each twist, as in BBC Elite, turns the three 16-bit seeds (s0, s1, s2)
* at #R$E904 into (s1, s2, s0 + s1 + s2).
next_system_seeds:                                         ; >5613
       mov  @system_seeds,hl                               ; LD HL,($E904)     ; HL = s0
       mov  @seed_s1,de                                    ; LD DE,($E906)     ; DE = s1
       mov  @seed_s2,bc                                    ; LD BC,($E908)     ; BC = s2
       a    de,hl                                          ; ADD HL,DE         ; twist 1: HL = s0 + s1 + s2
       a    bc,hl                                          ; ADD HL,BC         ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       movb b,a                                            ; LD A,B            ; 
       movb d,b                                            ; LD B,D            ; 
       movb a,d                                            ; LD D,A            ; 
       movb @c,a                                           ; LD A,C            ; 
       movb @e,@c                                          ; LD C,E            ; 
       movb a,@e                                           ; LD E,A            ; now HL = s1, DE = s2, BC = the sum
       a    de,hl                                          ; ADD HL,DE         ; twist 2
       a    bc,hl                                          ; ADD HL,BC         ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       movb b,a                                            ; LD A,B            ; 
       movb d,b                                            ; LD B,D            ; 
       movb a,d                                            ; LD D,A            ; 
       movb @c,a                                           ; LD A,C            ; 
       movb @e,@c                                          ; LD C,E            ; 
       movb a,@e                                           ; LD E,A            ; 
       a    de,hl                                          ; ADD HL,DE         ; twist 3
       a    bc,hl                                          ; ADD HL,BC         ; 
       .ex_de_hl                                           ; EX DE,HL          ; 
       movb b,a                                            ; LD A,B            ; 
       movb d,b                                            ; LD B,D            ; 
       movb a,d                                            ; LD D,A            ; 
       movb @c,a                                           ; LD A,C            ; 
       movb @e,@c                                          ; LD C,E            ; 
       movb a,@e                                           ; LD E,A            ; 
       a    de,hl                                          ; ADD HL,DE         ; twist 4
       a    bc,hl                                          ; ADD HL,BC         ; 
       mov  de,@system_seeds                               ; LD ($E904),DE     ; store the new seeds
       mov  bc,@seed_s1                                    ; LD ($E906),BC     ; 
       mov  hl,@seed_s2                                    ; LD ($E908),HL     ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Chart cursor sprite pattern
* 
* The 16x16 pattern of the cursor on the galactic and local charts: a run-
* length encoded stream (see #R$39B9) of (count, byte) pairs ending with 0,
* uploaded to sprite pattern 16 by #R$4D8A. It draws a cross with a gap in the
* middle.
chart_cursor_pattern:                                      ; >5647
       byte >05,>01
       byte >02,>00
       byte >01,>F8
       byte >02,>00
       byte >05,>01
       byte >08,>00
       byte >01,>3E
       byte >08,>00
       byte >00

********************************************************************************
* Chart cursor sprite attributes
* 
* Copied to sprite 4 by #R$4D8A: y $DF (off the screen until the cursor is
* moved, #R$540D), x 0, pattern 16 and colour 5.
chart_cursor_attributes:                                   ; >5658
       byte >DF,>00,>10,>05

********************************************************************************
* Fuel range circle sprite attributes
* 
* Four sets of sprite attributes - y $DF (off the screen), x 0, patterns 0, 4,
* 8 and 12 and colour 8 - for the four sprites that make up the fuel range
* circle (#R$4DAB). Nothing has been found that reads them.
fuel_range_sprite_attributes:                              ; >565c
       byte >DF,>00,>00,>08
       byte >DF,>00,>04,>08
       byte >DF,>00,>08,>08
       byte >DF,>00,>0C,>08

********************************************************************************
* Galactic chart title
* 
* Printed by #R$4D0B (RST $20), followed by the galaxy number. A list of
* (column, row, string) records ending with $FF (see #R$3596).
galactic_chart_title:                                      ; >566c
       text >11,>16,'GALAXY #',>00
       byte >FF

********************************************************************************
* The message ": "
* 
* #R$52CE loads this
* directly (`LD HL,$5678`) and prints it via RST $08 between the
* selected system's name and its distance - a separator, not
* "Distance:" (that word isn't present in these bytes). No character
* here has bit 7 set, so the trailing $00 is its own terminator (the
* same convention #R$56A2/#R$56B1 use).
msg_colon_separator:                                       ; >5678
       text ': ',>00

