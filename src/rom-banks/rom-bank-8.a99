********************************************************************************
* Goatsoup: symbol table
* 
* One 6-byte entry for each of the symbols $80-$A6 in the system description
* templates (#R$A2EB), looked up by #R$9ADA: the address of the first of the
* symbol's five alternative words or phrases, then the offsets of the other
* four from it. #R$9BB2 picks one at random.
goatsoup_symbols:                                          ; >a201
       byte goatsoup_symbol_00%%256,goatsoup_symbol_00//256       ; symbol $80
       byte >08,>11,>1D,>25                                       ; 
       byte goatsoup_symbol_01%%256,goatsoup_symbol_01//256       ; symbol $81
       byte >06,>0E,>14,>20                                       ; 
       byte goatsoup_symbol_02%%256,goatsoup_symbol_02//256       ; symbol $82
       byte >09,>0B,>12,>18                                       ; 
       byte goatsoup_symbol_03%%256,goatsoup_symbol_03//256       ; symbol $83
       byte >12,>1D,>1F,>29                                       ; 
       byte goatsoup_symbol_04%%256,goatsoup_symbol_04//256       ; symbol $84
       byte >02,>0C,>14,>1A                                       ; 
       byte goatsoup_symbol_05%%256,goatsoup_symbol_05//256       ; symbol $85
       byte >02,>04,>0B,>0D                                       ; 
       byte goatsoup_symbol_06%%256,goatsoup_symbol_06//256       ; symbol $86
       byte >0A,>10,>15,>1C                                       ; 
       byte goatsoup_symbol_07%%256,goatsoup_symbol_07//256       ; symbol $87
       byte >09,>16,>21,>2C                                       ; 
       byte goatsoup_symbol_08%%256,goatsoup_symbol_08//256       ; symbol $88
       byte >09,>14,>27,>35                                       ; 
       byte goatsoup_symbol_09%%256,goatsoup_symbol_09//256       ; symbol $89
       byte >0F,>19,>21,>29                                       ; 
       byte goatsoup_symbol_10%%256,goatsoup_symbol_10//256       ; symbol $8A
       byte >07,>0F,>23,>26                                       ; 
       byte goatsoup_symbol_11%%256,goatsoup_symbol_11//256       ; symbol $8B
       byte >07,>10,>19,>21                                       ; 
       byte goatsoup_symbol_12%%256,goatsoup_symbol_12//256       ; symbol $8C
       byte >0C,>13,>1F,>2E                                       ; 
       byte goatsoup_symbol_13%%256,goatsoup_symbol_13//256       ; symbol $8D
