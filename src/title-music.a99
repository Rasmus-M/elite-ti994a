* Title music, converted from the MSX version (#R$7A1C-#R$8204) for the SN76489
*
* Generated by tools/convert-title-music.py - don't edit by hand.
* The tone periods are the MSX ones (the PSG and the SN76489 give the same
* frequency for the same period), converted to the SN76489's command bytes.
* The SN76489 can't play periods above 1023, so 55 bass notes on channel 3 are
* an octave higher than on the MSX.

********************************************************************************
* Note tone periods
*
* For each of 72 notes (#R$7A1C), lowest first, the high byte is the low 4
* bits of the tone period (for the first command byte) and the low byte the
* high 6 bits (the second byte). Indexed by the note byte (note * 2).
* Notes at or above >90 are silent.
       even
note_tone_periods:
       data >0f3f,>0f3f,>0f3f,>0f3f,>0f3f,>0f3f,>0f3f,>0f3f
       data >0f3f,>0f3f,>0f3f,>043f,>0c3b,>0638,>0335,>0432
       data >062f,>0c2c,>042a,>0e27,>0a25,>0823,>0821,>0a1f
       data >0e1d,>031c,>0a1a,>0219,>0b17,>0616,>0215,>0f13
       data >0d12,>0c11,>0c10,>0d0f,>0f0e,>010e,>050d,>090c
       data >0e0b,>030b,>090a,>0f09,>0609,>0e08,>0608,>0f07
       data >0707,>0107,>0a06,>0406,>0f05,>0905,>0405,>0005
       data >0b04,>0704,>0304,>0f03,>0c03,>0803,>0503,>0203
       data >0f02,>0d02,>0a02,>0802,>0602,>0402,>0202,>0002

********************************************************************************
* Title music
*
* The tune header (#R$7AE4): the number of channels, then for each channel
* the address of its pattern list and its attenuation (15 - the MSX volume).
title_music:
       data 3
       data title_music_patterns,7          ; channel 1
       data title_music_channel_2,7         ; channel 2
       data title_music_channel_3,8         ; channel 3

********************************************************************************
* Title music: pattern lists
*
* One list per channel (#R$7AEE): the patterns to play in turn, ending with 0.
title_music_patterns:
       data title_music_pattern_1
       data title_music_pattern_2
       data title_music_pattern_3
       data title_music_pattern_4
       data title_music_pattern_3
       data title_music_rest
       data 0
title_music_channel_2:
       data title_music_pattern_5
       data title_music_pattern_6
       data title_music_pattern_7
       data title_music_pattern_8
       data title_music_pattern_7
       data title_music_rest
       data 0
title_music_channel_3:
       data title_music_pattern_9
       data title_music_pattern_10
       data title_music_pattern_11
       data title_music_pattern_12
       data title_music_pattern_11
       data title_music_rest
       data 0

