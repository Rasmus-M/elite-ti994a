scanner_mask_blip_1:                                       ; >e767
       byte >00                                                      ; 
scanner_mask_stick_2:                                      ; >e768
       byte >00                                                      ; 
scanner_mask_stick_1:                                      ; >e769
       byte >00                                                      ; 

