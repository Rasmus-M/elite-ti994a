* Used by the routines at #R$1928, #R$193F and #R$6433.
draw_gauge_dashboard_6b48:                                 ; >6b48
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; 
       movb @fore_shield,a                                 ; LD A,($F80F)      ; 
       li   hl,>113b                                       ; LD HL,$113B       ; 
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; 

********************************************************************************
* Draw the aft shield gauge [dashboard]
* 
* Used by the routines at #R$1928, #R$193F and #R$6433.
draw_gauge_dashboard_6b54:                                 ; >6b54
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; 
       movb @aft_shield,a                                  ; LD A,($F810)      ; 
       li   hl,>123a                                       ; LD HL,$123A       ; 
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; 

********************************************************************************
* Draw the laser temperature gauge [dashboard]
* 
* Used by the routines at #R$190D, #R$2AD0 and #R$6433.
* .
* Draws the laser temperature (#R$F813) / 2 as a bar (#R$6C37). Does nothing
* if the dashboard isn't shown (#R$6C9E).
draw_laser_temperature:                                    ; >6b60
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @laser_temp_gauge,a                            ; LD A,($F813)      ; 
       srl  a,1                                            ; SRL A             ; A = the laser temperature / 2
       li   hl,>1539                                       ; LD HL,$1539       ; the laser temperature gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the missile indicator
* 
* Used by the routines at #R$2D58, #R$2D70, #R$2D7E, #R$46CA and #R$6433.
* .
* Does nothing unless the dashboard is showing (#R$6C9E). Sets the four
* sprites 4-7 (from $1B10 in the sprite attribute table, #R$39A4) along the
* dashboard: one for each missile the ship can carry, in green for each
* missile it has (#R$F776) - except the next to be fired, which is light
* red when armed and dark red when locked on (#R$E910) - and an empty
* pattern for the rest.
* .
* At $6B8F, uses the missile pattern, coloured light red if it's the next
* to be fired and armed, dark red if locked on, otherwise green ($6BA3).
* .
* At $6BA5, sets this missile's sprite (#R$39A4) and moves on to the next,
* 6 pixels to the right.
draw_missile_indicator:                                    ; >6b6e
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; do nothing unless the dashboard is showing
;      limi 0                                              ; DI                ; 
       movb @bytes+>10,a                                   ; LD A,$10          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+sprite_attr_write_hi,a                  ; LD A,$5B          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1B10: sprite 4's attributes
       ; EI                                                ; EI                ;
       li   bc,>b838                                       ; LD BC,$B838       ; y = $B8, x = $38
       movb @missile_count+1,hl                            ; LD HL,($F776)     ; L = number of missiles
       movb @missile_count,@l                              ;                   ;
       movb one,h                                          ; LD H,$01          ; H = 1 for the first
_6b83:                                                     ; >6b83
       movb h,a                                            ; LD A,H            ; 
       cb   a,@l                                           ; CP L              ; 
       jeq  draw_missile_indicator_2                       ; JR Z,$6B8F        ; the next to be fired
       jl   draw_missile_indicator_2                       ; JR C,$6B8F        ; one the ship has
       movb @bytes+>14,d                                   ; LD D,$14          ; no missile: the empty pattern...
       movb @bytes+>0f,@e                                  ; LD E,$0F          ; ...in white
       jmp  _6ba5                                          ; JR $6BA5          ; 
draw_missile_indicator_2:                                  ; >6b8f
       movb @bytes+>10,d                                   ; LD D,$10          ; the missile pattern
       cb   h,@l                                           ;                   ; (test again: the load changed the status)
       jne  draw_missile_indicator_3                       ; JR NZ,$6BA3       ; not the next to be fired
       movb @missile_state,a                               ; LD A,($E910) / OR A; A = missile state
       jeq  draw_missile_indicator_3                       ; JR Z,$6BA3        ; not armed
       movb @bytes+>09,@e                                  ; LD E,$09          ; armed: light red
       cb   a,@bytes+>02                                   ; CP $02            ; (compared after the load, which changes the status on the TI)
       jne  _6ba1                                          ; JR NZ,$6BA1       ; 
       movb @bytes+>06,@e                                  ; LD E,$06          ; locked on: dark red
_6ba1:                                                     ; >6ba1
       jmp  _6ba5                                          ; JR $6BA5          ; 
draw_missile_indicator_3:                                  ; >6ba3
       movb @bytes+>02,@e                                  ; LD E,$02          ; green
_6ba5:                                                     ; >6ba5
       bl   @set_sprite                                    ; CALL $39A4        ; set the sprite
       movb @c,a                                           ; LD A,C            ; 
       ab   @bytes+>06,a                                   ; ADD A,$06         ; 6 pixels to the right
       movb a,@c                                           ; LD C,A            ; 
       ab   one,h                                          ; INC H             ; next missile
       movb h,a                                            ; LD A,H            ; 
       cb   a,@bytes+>05                                   ; CP $05            ; all four done?
       jne  _6b83                                          ; JR NZ,$6B83       ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw the roll dial [dashboard]
* 
* Used by the routines at #R$6433 and #R$6BE1.
* .
* Draws the roll rate (#R$F815, -16 to 16) as a pixel at (rate + 16) * 22 / 32
* + 1 on the roll dial (#R$6C71).
draw_roll_dial:                                            ; >6bb3
       .proc
       movb @roll_rate,a                                   ; LD A,($F815)      ; A = the roll rate
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       movb @bytes+>16,@e                                  ; LD E,$16          ; 
       bl   @multiply_a_e_16bit                            ; CALL $1F60        ; HL = (rate + 16) * 22 (#R$1F60)
       movb @bytes+>20,a                                   ; LD A,$20          ; 
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = (rate + 16) * 22 / 32 (#R$2079)
       movb @l,a                                           ; LD A,L            ; 
       ab   one,a                                          ; INC A             ; 
       li   hl,>12b3                                       ; LD HL,$12B3       ; the roll dial
       b    @draw_dial_gauge                               ; JP $6C71          ; draw it (#R$6C71)

********************************************************************************
* Draw the pitch dial [dashboard]
* 
* Used by the routines at #R$6433 and #R$6BE1.
* .
* Draws the pitch rate (#R$F816, -16 to 16) as a pixel at (rate + 16) * 22 /
* 32 + 1 on the pitch dial (#R$6C71).
draw_pitch_dial:                                           ; >6bca
       .proc
       movb @pitch_rate,a                                  ; LD A,($F816)      ; A = the pitch rate
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       movb @bytes+>16,@e                                  ; LD E,$16          ; 
       bl   @multiply_a_e_16bit                            ; CALL $1F60        ; HL = (rate + 16) * 22 (#R$1F60)
       movb @bytes+>20,a                                   ; LD A,$20          ; 
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = (rate + 16) * 22 / 32 (#R$2079)
       movb @l,a                                           ; LD A,L            ; 
       ab   one,a                                          ; INC A             ; 
       li   hl,>13b3                                       ; LD HL,$13B3       ; the pitch dial
       b    @draw_dial_gauge                               ; JP $6C71          ; draw it (#R$6C71)

********************************************************************************
* Roll and pitch: stop them when the keys are released
* 
* Used by the routine at #R$13FD.
* .
* Called every frame by the main loop (#R$13FD). After launching, the
* ship is rolling ($E929, #R$1837): this slows the roll down by 1 a frame
* (redrawing its dial and setting up the rotation) until it's stopped or
* reversed.
* .
* Otherwise (at $6BFE), with option D (bit 1 of #R$E914), stops the roll
* and pitch if their keys weren't held this frame (#R$E774, #R$E775),
* redrawing the dial and setting up the rotation. Then clears the
* key-held flags for the next frame.
settle_roll_pitch:                                         ; >6be1
       .proc                                               ;                   ; 
       movb @launch_roll,a                                 ; LD A,($E929) / OR A; still rolling after launching?
       jeq  _6bfe                                          ; JR Z,$6BFE        ; no
       movb @roll_rate,a                                   ; LD A,($F815) / OR A; A = the roll rate
       jeq  settle_roll_pitch_dials                        ; JR Z,$6BFA        ; stopped
       jlt  settle_roll_pitch_dials                        ; JP M,$6BFA        ; or reversed
       sb   one,@roll_rate                                 ; DEC A / LD ($F815),A; slow it down
       bl   @draw_roll_dial                                ; CALL $6BB3        ; draw the roll dial
       .pop r11                                            ;                   ; 
       b    @refresh_roll_table                            ; JP $2209          ; set up the roll
settle_roll_pitch_dials:                                   ; >6bfa
       sb   @launch_roll,@launch_roll                      ; XOR A / LD ($E929),A; done rolling after launching
_6bfe:                                                     ; >6bfe
       movb @options,r0                                    ; LD A,($E914)      ; 
       czc  @bit1,r0                                       ; BIT 1,A           ; option D?
       jeq  _6c2f                                          ; JR Z,$6C2F        ; no
       movb @roll_key_held,a                               ; LD A,($E774) / OR A; roll key held?
       jne  _6c1a                                          ; JR NZ,$6C1A       ; yes
       movb @roll_rate,a                                   ; LD HL,$F815 / LD A,(HL) / OR A; A = the roll rate
       jeq  _6c1a                                          ; JR Z,$6C1A        ; already stopped
       sb   @roll_rate,@roll_rate                          ; LD (HL),$00       ; stop the roll
       bl   @draw_roll_dial                                ; CALL $6BB3        ; draw the roll dial
       bl   @refresh_roll_table                            ; CALL $2209        ; set up the roll
_6c1a:                                                     ; >6c1a
       movb @pitch_key_held,a                              ; LD A,($E775) / OR A; pitch key held?
       jne  _6c2f                                          ; JR NZ,$6C2F       ; yes
       movb @pitch_rate,a                                  ; LD HL,$F816 / LD A,(HL) / OR A; A = the pitch rate
       jeq  _6c2f                                          ; JR Z,$6C2F        ; already stopped
       sb   @pitch_rate,@pitch_rate                        ; LD (HL),$00       ; stop the pitch
       bl   @draw_pitch_dial                               ; CALL $6BCA        ; draw the pitch dial
       bl   @refresh_pitch_table                           ; CALL $2212        ; set up the pitch
_6c2f:                                                     ; >6c2f
       sb   @roll_key_held,@roll_key_held                  ; XOR A / LD ($E774),A; clear the key-held flags
       sb   @pitch_key_held,@pitch_key_held                ; LD ($E775),A      ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw a bar gauge [dashboard]
* 
* Used by the routines at #R$6A59, #R$6A88, #R$6AAD, #R$6AC4, #R$6AD0, #R$6B48,
* #R$6B54 and #R$6B60.
* .
* Draws a bar A pixels long (0-24) across the three 8-pixel character cells
* of a dashboard gauge, 4 pixel rows tall (#R$6CA8): A / 8 full cells, a
* cell with the first A mod 8 pixels set (from #R$6DE3), then empty cells.
* Does nothing if the dashboard isn't shown (#R$6C9E).
* 
* I:A The bar's length in pixels (0-24)
* I:HL The VRAM address of the gauge's first cell
draw_bar_gauge:                                            ; >6c37
       .proc
draw_bar_gauge_jmp:
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb a,@e                                           ; LD E,A            ; E = the length
       sb   d,d                                            ; LD D,$00          ; D = 0, the number of cells drawn
       srl  a,3                                            ; RRA               ; 
       ;                                                   ; RRA               ; 
       ;                                                   ; RRA               ; 
       andi a,>1f00                                        ; AND $1F           ; A = the number of full cells
       jeq  _6c52                                          ; JR Z,$6C52        ; none
       movb a,@c                                           ; LD C,A            ; C = the number of full cells
       movb a,d                                            ; LD D,A            ; D = the cells drawn
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       sb   @e,a                                           ; SUB E             ; 
       andi a,>ff00                                        ;                   ; (NEG negates the whole of R4, so clear F first)
       neg a                                               ; NEG               ; 
       movb a,@e                                           ; LD E,A            ; E = the pixels left over (length mod 8)
       movb @b255,a                                        ; LD A,$FF          ; all pixels set
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw the full cells (#R$6CA8)
_6c52:                                                     ; >6c52
       movb @e,a                                           ; LD A,E / OR A     ; 
       jeq  _6c66                                          ; JR Z,$6C66        ; no pixels left over
       ab   one,d                                          ; INC D             ; one more cell drawn
       li   ix,gauge_bar_patterns                          ; LD IX,$6DE3       ; IX -> the partial cell patterns (#R$6DE3)
       movb a,@bar_gauge_partial_pattern+>0003             ; LD ($6C60),A      ; patch the displacement (#R$6C5E+2)
bar_gauge_partial_pattern:                                 ; >6c5e
       movb @>00(ix),a                                     ; LD A,(IX+$00)     ; A = the pattern for that many pixels
       movb one,@c                                         ; LD C,$01          ; one cell
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw it
_6c66:                                                     ; >6c66
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       sb   d,a                                            ; SUB D             ; 
       jeq  _6c70                                          ; JR Z,$6C70        ; all 3 cells drawn
       movb a,@c                                           ; LD C,A            ; C = the cells left
       sb   a,a                                            ; XOR A             ; empty
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw them
_6c70:                                                     ; >6c70
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw a dial gauge [dashboard]
* 
* Used by the routines at #R$6BB3 and #R$6BCA.
* .
* Draws a single pixel at position A (0-23) across the three 8-pixel
* character cells of a dashboard gauge, 4 pixel rows tall (#R$6CA8): empty
* cells up to the one with the pixel, the pixel (from #R$E700), then empty
* cells. Used for the roll and pitch dials. Does nothing if the dashboard
* isn't shown (#R$6C9E).
* 
* I:A The pixel's position (0-23)
* I:HL The VRAM address of the gauge's first cell
draw_dial_gauge:                                           ; >6c71
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb one,d                                          ; LD D,$01          ; D = 1 (counting the cell with the pixel)
       movb a,@e                                           ; LD E,A            ; E = the position
       srl  a,3                                            ; RRA               ; 
       ;                                                   ; RRA               ; 
       ;                                                   ; RRA               ; 
       andi a,>1f00                                        ; AND $1F           ; A = the number of empty cells before the pixel
       jeq  _6c85                                          ; JR Z,$6C85        ; none
       movb a,@c                                           ; LD C,A            ; 
       ab   d,a                                            ; ADD A,D           ; 
       movb a,d                                            ; LD D,A            ; D = the cells drawn
       sb   a,a                                            ; XOR A             ; empty
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw them (#R$6CA8)
_6c85:                                                     ; >6c85
       movb @e,a                                           ; LD A,E            ; 
       andi a,>0700                                        ; AND $07           ; the pixel's position in its cell
       mov  a,r1                                           ; LD ($6C8C),A      ; index the table with A (instead of patching the operand)
       srl  r1,8                                           ;                   ;
dial_gauge_pixel_mask:                                     ; >6c8b
       movb @pixel_bitmask_table(r1),a                     ; LD A,($E704)      ; A = the pixel's mask (#R$E700)
       movb one,@c                                         ; LD C,$01          ; one cell
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw it
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       sb   d,a                                            ; SUB D             ; 
       jeq  _6c9d                                          ; JR Z,$6C9D        ; all 3 cells drawn
       movb a,@c                                           ; LD C,A            ; C = the cells left
       sb   a,a                                            ; XOR A             ; empty
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw them
_6c9d:                                                     ; >6c9d
       .ret                                                ; RET               ; 

********************************************************************************
* Dashboard-hidden gate: skip both this routine and its caller if $E903=0
* 
* Used by the routines at #R$2DC8, #R$6A88, #R$6AAD, #R$6AC4, #R$6AD0, #R$6ADC,
* #R$6B12, #R$6B48, #R$6B54, #R$6B60, #R$6B6E, #R$6C37, #R$6C71 and #R$85FB.
* .
* All the dashboard-gauge-drawing routines below call this first. When the
* dashboard is hidden ($E903=0) it POPs the caller's own return address off
* the stack before returning, so RET here unwinds two levels - both this
* routine and whichever gauge routine called it - skipping the drawing work
* entirely.
gate_dashboard_hidden:                                     ; >6c9e
       .proc
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb @space_view_showing,a                          ; LD A,($E903) / OR A; 
       jne  _6ca6                                          ; JR NZ,$6CA6       ; 
       .pop af                                             ; POP AF            ; 
_6ca6:                                                     ; >6ca6
       .ex_af_af_                                          ; EX AF,AF'         ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw C tiles (4 pixel-rows tall) at HL using pattern A [dashboard]
* 
* Used by the routines at #R$6A59, #R$6C37 and #R$6C71.
* .
* A thin wrapper around #R$35B8 with the height fixed at 4; HL (the VRAM
* address) and C (the tile count) are left set by the caller.
draw_gauge_tiles:                                          ; >6ca8
       .proc
       .push de                                            ; PUSH DE           ; 
       movb a,@e                                           ; LD E,A            ; 
       movb @bytes+>04,b                                   ; LD B,$04          ; 
       bl   @fill_vram_rect                                ; CALL $35B8        ; 
       ; EI                                                ; EI                ;
       .pop de                                             ; POP DE            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Show the tunnel rings
* 
* Used by the routines at #R$1873, #R$645B and #R$894D.
* .
* The effect for launching (#R$645B, when $E8F6 is set by #R$1837),
* docking (#R$1873) and hyperspace (#R$894D): clears the space view
* (#R$388F), plays sound effect 7, and draws three circles (#R$3D0E)
* that grow outwards - radii starting at 2, 26 and 68 and growing by 4,
* 7 and 10 each frame - 6 frames at a time (#R$3846), four times over.
* The line drawing is switched from OR to XOR meanwhile (at $3CA8 and
* $3CE7), so that each ring is drawn over the last.
tunnel_rings:                                              ; >6cb2
       .proc
       bl   @clear_space_view                              ; CALL $388F        ; clear the space view
       mov  @line_plot_xor,@line_shallow_plot_op_pad       ; LD A,$A9          ; draw lines with XOR
       mov  @line_plot_xor,@line_steep_plot_op_pad         ; LD ($3CA8),A      ; 
       ;                                                   ; LD ($3CE7),A      ; 
       movb @bytes+>07,a                                   ; LD A,$07          ; 
       .sfx 7                                              ; CALL $7468        ; play the tunnel rings
       movb @bytes+>04,b                                   ; LD B,$04          ; four times
_6cc4:                                                     ; >6cc4
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@tunnel_ring_radii                           ; LD ($E776),A      ; first ring's radius
       movb @bytes+>1a,a                                   ; LD A,$1A          ; 
       movb a,@tunnel_ring_radius_2                        ; LD ($E777),A      ; second's
       movb @bytes+>44,a                                   ; LD A,$44          ; 
       movb a,@tunnel_ring_radius_3                        ; LD ($E778),A      ; third's
       movb @bytes+>06,b                                   ; LD B,$06          ; 6 frames
_6cd6:                                                     ; >6cd6
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>04,@c                                  ; LD C,$04          ; 
       li   hl,tunnel_ring_radii                           ; LD HL,$E776       ; the radii
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 rings
_6cde:                                                     ; >6cde
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb *hl,@l                                         ; LD L,(HL)         ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>03,b                                   ; LD B,$03          ; 
       li   de,>0010                                       ; LD DE,$0010       ; 
       li   ix,>0000                                       ; LD IX,$0000       ; 
       li   iy,>0000                                       ; LD IY,$0000       ; 
       movb hl,@tunnel_ring_radius+1                       ; LD ($E921),HL     ; 
       movb @l,@tunnel_ring_radius                         ;                   ;
       bl   @draw_circle                                   ; CALL $3D0E        ; draw a ring
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       ab   @c,a                                           ; ADD A,C           ; 
       movb a,*hl                                          ; LD (HL),A         ; grow it by 4, 7 or 10
       inc  hl                                             ; INC HL            ; 
       ab   one,@c                                         ; INC C             ; 
       ab   one,@c                                         ; INC C             ; 
       ab   one,@c                                         ; INC C             ; 
       sb   one,b                                          ; DJNZ $6CDE        ; next ring
       jne  _6cde                                          ;                   
       movb @message_timer,a                               ; LD A,($E919) / OR A; 
       jgt  tunnel_rings_show                              ; JP P,$6D0D        ; 
       jeq  tunnel_rings_show                              ;                   ; 
!
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@message_timer                               ; LD ($E919),A      ; 
tunnel_rings_show:                                         ; >6d0d
       bl   @copy_space_view                               ; CALL $3846        ; copy the space view to the screen
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6CD6        ; next frame
       jne  _6cd6                                          ;                   
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6CC4        ; 
       jne  _6cc4                                          ;                   
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@tunnel_rings_finished                       ; LD ($E923),A      ; 
       mov  @line_plot_or,@line_shallow_plot_op_pad        ; LD A,$B1          ; draw lines with OR again
       mov  @line_plot_or,@line_steep_plot_op_pad          ; LD ($3CA8),A      ; 
       ;                                                   ; LD ($3CE7),A      ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Set up the laser for the current view
* 
* Used by the routine at #R$645B.
* .
* Called when the view changes (#R$645B). Finds which laser is fitted to
* the current view (#R$EB9A): each laser's entry in the equipment has one
* bit per mount (bit 0 front, 1 rear, 2 left, 3 right), and they're checked
* in the order pulse (#R$F779), mining (#R$F781), beam (#R$F77A) and
* military (#R$F782) - the last one fitted wins. On the title screen
* ($E940) there's none. Stores the laser type (0-3, or $FF for none) in
* #R$F818; with none, hides the crosshair sprites, otherwise sets up the
* laser ($6D82).
* .
* At $6D82, looks up the laser type's record at #R$6EB3: its cooldown
* between shots (#R$F819) and power (#R$F81A), and its crosshair pattern
* (#R$6DEB), which it uploads to the sprite patterns at $3800 (#R$39B9);
* then sets up the crosshair as four 16x16 sprites around the middle of the
* view (#R$39A4), in the laser type's colour.
view_laser:                                                ; >6d24
       .proc
       movb @b255,@c                                       ; LD C,$FF          ; no laser yet
       movb @e940_gate_flag,a                              ; LD A,($E940) / OR A; 
       jne  _6d6e                                          ; JR NZ,$6D6E       ; the title screen - no laser
       movb @current_view,a                                ; LD A,($EB9A)      ; A = current view
       movb a,b                                            ; LD B,A            ; 
       ab   one,b                                          ; INC B             ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; 
_6d33:                                                     ; >6d33
       movb a,r0                                           ; RLCA              ; 
       movb a,@r0lb                                        ;                   ; 
       sla  r0,1                                           ;                   ; 
       movb r0,a                                           ;                   ; rotate A left (8 bits)
       sb   one,b                                          ; DJNZ $6D33        ; A = the view's mount bit
       jne  _6d33                                          ;                   
       movb b,d                                            ; LD D,B            ; 
       movb @b255,@c                                       ; LD C,$FF          ; 
       movb a,@e                                           ; LD E,A            ; E = mount bit
       movb @item_pulse_laser,a                            ; LD A,($F779)      ; pulse laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d46                                          ; JR Z,$6D46        ; not fitted
       movb b,d                                            ; LD D,B            ; 
       movb @e,r0                                          ; AND E             ;
       inv  r0                                             ;                   ; 
       szcb r0,a                                           ;                   ; 
       jeq  _6d46                                          ; JR Z,$6D46        ; not on this mount
       movb b,@c                                           ; LD C,B            ; type 0
_6d46:                                                     ; >6d46
       ab   one,b                                          ; INC B             ; 
       movb @item_mining_laser,a                           ; LD A,($F781)      ; mining laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d53                                          ; JR Z,$6D53        ; 
       movb b,d                                            ; LD D,B            ; 
       movb @e,r0                                          ; AND E             ;
       inv  r0                                             ;                   ; 
       szcb r0,a                                           ;                   ; 
       jeq  _6d53                                          ; JR Z,$6D53        ; 
       movb b,@c                                           ; LD C,B            ; type 1
_6d53:                                                     ; >6d53
       ab   one,b                                          ; INC B             ; 
       movb @item_beam_laser,a                             ; LD A,($F77A)      ; beam laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d60                                          ; JR Z,$6D60        ; 
       movb b,d                                            ; LD D,B            ; 
       movb @e,r0                                          ; AND E             ;
       inv  r0                                             ;                   ; 
       szcb r0,a                                           ;                   ; 
       jeq  _6d60                                          ; JR Z,$6D60        ; 
       movb b,@c                                           ; LD C,B            ; type 2
_6d60:                                                     ; >6d60
       ab   one,b                                          ; INC B             ; 
       movb @item_military_laser,a                         ; LD A,($F782)      ; military laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d6d                                          ; JR Z,$6D6D        ; 
       movb b,d                                            ; LD D,B            ; 
       movb @e,r0                                          ; AND E             ;
       inv  r0                                             ;                   ; 
       szcb r0,a                                           ;                   ; 
       jeq  _6d6d                                          ; JR Z,$6D6D        ; 
       movb b,@c                                           ; LD C,B            ; type 3
_6d6d:                                                     ; >6d6d
       ab   one,b                                          ; INC B             ; 
_6d6e:                                                     ; >6d6e
       movb d,a                                            ; LD A,D            ; 
       movb a,@flag_search_result_cache                    ; LD ($EFA0),A      ; 
       movb @c,a                                           ; LD A,C            ; 
       movb a,@view_laser_type                             ; LD ($F818),A / OR A; the laser type for this view
       jgt  set_up_laser                                   ; JP P,$6D82        ; there is one - set it up
       jeq  set_up_laser                                   ;                   ; 
!
       li   hl,sprite_attr_table                           ; LD HL,$1B00       ; none: hide the crosshair sprites
       movb @bytes+>04,b                                   ; LD B,$04          ; 
       b    @hide_sprites_jmp                              ; JP $3942          ; 
set_up_laser:                                              ; >6d82
       movb a,@e                                           ; LD E,A            ; E = the laser type
       ab   a,a                                            ; ADD A,A           ; A = type * 6 (5 bytes plus a pad byte, so the pointer is word-aligned)
       ab   @e,a                                           ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,E           ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,laser_types                                 ; LD HL,$6EB3       ; the laser types
       a    de,hl                                          ; ADD HL,DE         ; HL -> this type's record
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@laser_cooldown                              ; LD ($F819),A      ; laser cooldown
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@laser_power                                 ; LD ($F81A),A      ; laser power
       movb *hl,@e                                         ; LD E,(HL)         ; E = the crosshair colour
       inc  hl                                             ; INC HL            ; 
       inc  hl                                             ;                   ; skip the pad byte
       mov  *hl,hl                                         ; LD L,A            ; HL = the RLE pattern stream pointer (record bytes 4-5)
;      limi 0                                              ; DI                ; 
       sb   a,a                                            ; LD A,$00          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb @bytes+sprite_pattern_write_hi,a               ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, write mode: $3800 (sprite pattern table)
       bl   @write_run_length_encoded_byte_stream          ; CALL $39B9        ; write the RLE-encoded pattern
       sb   a,a                                            ; LD A,$00          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb @bytes+sprite_attr_write_hi,a                  ; LD A,$5B          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, write mode: $1B00 (sprite attribute table)
       li   bc,>3870                                       ; LD BC,$3870       ; initial (row, column)
       sb   d,d                                            ; LD D,$00          ; pattern/colour base
       movb @bytes+>02,@l                                  ; LD L,$02          ; 2 columns
_6db8:                                                     ; >6db8
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>02,h                                   ; LD H,$02          ; 2 rows
_6dbb:                                                     ; >6dbb
       bl   @set_sprite                                    ; CALL $39A4        ; write this quadrant's sprite-attribute entry
       movb b,a                                            ; LD A,B            ; 
       ab   @bytes+>10,a                                   ; ADD A,$10         ; next row, 16 pixels down
       movb a,b                                            ; LD B,A            ; 
       sb   one,h                                          ; DEC H             ; 
       jne  _6dbb                                          ; JR NZ,$6DBB       ; next row
       .pop bc                                             ; POP BC            ; 
       movb @c,a                                           ; LD A,C            ; 
       ab   @bytes+>10,a                                   ; ADD A,$10         ; next column, 16 pixels across
       movb a,@c                                           ; LD C,A            ; 
       sb   one,@l                                         ; DEC L             ; 
       jne  _6db8                                          ; JR NZ,$6DB8       ; next column
       ; EI                                                ; EI                ;
       .endproc                                            ; RET               ; 

********************************************************************************
* Refuse a flight command while docked
* 
* Used by the routines at #R$19FC, #R$1A8A, #R$1B13, #R$1B25, #R$2D58, #R$3223,
* #R$329E, #R$64A1, #R$64B5, #R$64C9, #R$64DD, #R$88AC and #R$8926.
* .
* Called by the handlers for keys that only work in flight. If the
* player is docked (#R$E90A), beeps, shows "Docked!" on the message line
* (#R$3955, #R$5FFB) and returns to the key handler's caller; otherwise returns normally.
refuse_if_docked:                                          ; >6dcf
       .proc
       movb @docked,a                                      ; LD A,($E90A) / OR A; 
       jeq  _6de2                                          ; JR Z,$6DE2        ; in flight
       .sfx 6                                              ; CALL $16FE        ; beep
       bl   @clear_message_line                            ; CALL $3955        ; clear the message line
       li   hl,msg_docked                                  ; LD HL,$6F17       ; "Docked!"
       bl   @show_message                                  ; CALL $5FFB        ; show it for a while
       .pop hl                                             ; POP HL            ; return to the key handler's caller
_6de2:                                                     ; >6de2
       .endproc                                            ; RET               ; 

********************************************************************************
* Gauge bar patterns
* 
* The patterns for the end of a gauge's bar (#R$6C37), 0-7 pixels long.
       .msxalign >6de3
gauge_bar_patterns:                                        ; >6de3
       byte >00,>80,>C0,>E0,>F0,>F8,>FC,>FE

********************************************************************************
* Crosshair patterns
* 
* The crosshair sprite patterns for the four laser types (#R$6EB3), which
* #R$6D82 uploads to sprite patterns 0-15 at $3800 and shows as four 16x16
* sprites making up a 32x32 crosshair. Each is a run-length encoded stream
* (#R$39B9) of (count, value) pairs, ending with 0, that expands to the 128
* bytes of the four sprite patterns: pulse laser at #R$6DEB, mining laser
* at #R$6E1A, beam laser at #R$6E47 and military laser at #R$6E80.
* .
* The beam laser's stream expands to only 127 bytes, so the last byte of
* sprite pattern 15 keeps whatever the previous crosshair left there. The
* other three streams all end with a run of zeros, so it's 0.
       .msxalign >6deb
crosshair_patterns:                                        ; >6deb
       byte >0F,>00,>01,>3F,>02,>00,>07,>01                          ; pulse laser: a cross with a gap in the middle
       byte >06,>00,>01,>80,>01,>3F,>0F,>00
       byte >01,>80,>06,>00,>07,>01,>04,>00
       byte >07,>80,>06,>00,>01,>01,>0F,>00
       byte >01,>FC,>01,>01,>06,>00,>07,>80
       byte >02,>00,>01,>FC,>0F,>00
       byte >00                                                      ; end
crosshair_mining:                                          ; >6e1a
       byte >05,>00,>01,>0F,>05,>0C,>05,>00                          ; mining laser: a box, open at the sides
       byte >05,>00,>01,>FF,>0F,>00,>05,>0C
       byte >01,>0F,>0F,>00,>01,>FF,>0A,>00
       byte >01,>FF,>0F,>00,>01,>F0,>05,>30
       byte >0F,>00,>01,>FF,>0A,>00,>05,>30
       byte >01,>F0,>05,>00
       byte >00                                                      ; end
crosshair_beam:                                            ; >6e47
       byte >01,>00,>01,>60,>01,>30,>01,>18                          ; beam laser: an X with a gap in the middle (127 bytes)
       byte >01,>0C,>01,>06,>01,>03,>22,>00
       byte >01,>03,>01,>06,>01,>0C,>01,>18
       byte >01,>30,>01,>60,>22,>00,>01,>06
       byte >01,>0C,>01,>18,>01,>30,>01,>60
       byte >01,>C0,>22,>00,>01,>C0,>01,>60
       byte >01,>30,>01,>18,>01,>0C,>01,>06
       byte >00                                                      ; end
crosshair_military:                                        ; >6e80
       byte >07,>00,>01,>0F,>03,>0C,>09,>00                          ; military laser: a box with a tick above and below
       byte >03,>01,>01,>FF,>0D,>00,>03,>0C
       byte >01,>0F,>0F,>00,>01,>FF,>03,>01
       byte >08,>00,>03,>80,>01,>FF,>0F,>00
       byte >01,>F0,>03,>30,>0D,>00,>01,>FF
       byte >03,>80,>09,>00,>03,>30,>01,>F0
       byte >07,>00
       byte >00                                                      ; end

********************************************************************************
* Laser types
* 
* Five bytes for each type of laser (six on the TI: a pad byte keeps the
* pointer word-aligned), read by #R$6D82: the cooldown between shots
* (#R$F819), the power (#R$F81A), the colour of the crosshair sprites, and
* the address of the crosshair pattern (#R$6DEB).
       even
laser_types:                                               ; >6eb3
       byte >05,>05,>02,>00                                          ; 0: pulse laser - cooldown 5, power 5, medium green
       data crosshair_patterns                                       ; the crosshair pattern
       byte >04,>0A,>06,>00                                          ; 1: mining laser - cooldown 4, power 10, dark red
       data crosshair_mining                                         ; the crosshair pattern
       byte >02,>05,>07,>00                                          ; 2: beam laser - cooldown 2, power 5, cyan
       data crosshair_beam                                           ; the crosshair pattern
       byte >00,>0A,>0D,>00                                          ; 3: military laser - cooldown 0, power 10, magenta
       data crosshair_military                                       ; the crosshair pattern

********************************************************************************
* Flight sprite patterns
* 
* Two run-length encoded sprite pattern streams (see #R$39B9), each ending
* with 0, uploaded whenever the cockpit screen is set up (#R$63F1). The
* first fills the 16x16 sprite patterns $10 and $14 at $3880: a filled 5x5
* square (a missile the ship has) and a hollow one (an empty missile slot),
* as used by #R$6B6E. The second fills pattern $18 at $38C0: the compass
* dot used by #R$85FB.
       .msxalign >6ec7
flight_sprite_patterns:                                    ; >6ec7
       byte >05,>F8,>1B,>00,>01,>F8,>03,>88,>01,>F8,>1B,>00,>00      ; $3880: missile, empty missile slot
compass_dot_pattern:                                       ; >6ed4
       byte >01,>40,>02,>E0,>01,>40,>1C,>00,>00                      ; $38C0: compass dot

********************************************************************************
* Stardust roll handlers
* 
* The handlers that roll the stardust in each view, indexed by the current
* view (see #R$67A8, #R$68CD).
       .msxalign >6edd
stardust_roll_handlers:                                    ; >6edd
       data stardust_roll_front                                      ; front
       data stardust_roll_rear                                       ; rear
       data stardust_roll_left                                       ; left
       data stardust_roll_right                                      ; right

********************************************************************************
* Stardust pitch handlers
* 
* The handlers that pitch the stardust in each view, indexed by the current
* view (see #R$67A8, #R$68CD).
       .msxalign >6ee5
stardust_pitch_handlers:                                   ; >6ee5
       data stardust_pitch_front                                     ; front
       data stardust_pitch_rear                                      ; rear
       data stardust_pitch_left                                      ; left
       data stardust_pitch_right                                     ; right

********************************************************************************
* Station indicator glyph
* 
* The 12 pixel rows of the console's "S" (space station in range)
* indicator, drawn by #R$6ADC: the first 8 into one character cell's
* pattern and the last 4 into the top of the cell below.
       .msxalign >6eff
station_indicator_glyph:                                   ; >6eff
       byte >1F,>3F,>30,>30,>30,>3E,>1F,>03                          ; upper cell
       byte >03,>03,>3F,>3E                                          ; lower cell

********************************************************************************
* ECM indicator glyph
* 
* The 12 pixel rows of the console's "E" (ECM on) indicator, drawn by
* #R$6B12: the first 8 into one character cell's pattern and the last 4
* into the top of the cell below.
       .msxalign >6f0b
ecm_indicator_glyph:                                       ; >6f0b
       byte >1F,>1F,>18,>18,>18,>1E,>1E,>18                          ; upper cell
       byte >18,>18,>1F,>1F                                          ; lower cell

********************************************************************************
* The message "Docked!"
       .msxalign >6f17
msg_docked:                                                ; >6f17
       text 'Docked!',>00

********************************************************************************
* Stardust direction vectors
* 
* An 8x8 table of direction vectors of length 63, used by #R$6805 to point
* a stardust particle's velocity. Entry (C,B), at $6F1F+2*(8*C+B), holds
* the vector (C,B) scaled up to length 63: first the X component,
* 63*C/sqrt(C^2+B^2), then the Y component, 63*B/sqrt(C^2+B^2), both
* rounded. Each line below is one value of C, for B = 0 to 7. Entry (0,0),
* which has no direction, holds (0,63) like the rest of its line.
       .msxalign >6f1f
stardust_directions:                                       ; >6f1f
       byte >00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F ; C=0
       byte >3F,>00,>2D,>2D,>1C,>38,>14,>3C,>0F,>3D,>0C,>3E,>0A,>3E,>09,>3E ; C=1
       byte >3F,>00,>38,>1C,>2D,>2D,>23,>34,>1C,>38,>17,>3A,>14,>3C,>11,>3D ; C=2
       byte >3F,>00,>3C,>14,>34,>23,>2D,>2D,>26,>32,>20,>36,>1C,>38,>19,>3A ; C=3
       byte >3F,>00,>3D,>0F,>38,>1C,>32,>26,>2D,>2D,>27,>31,>23,>34,>1F,>37 ; C=4
       byte >3F,>00,>3E,>0C,>3A,>17,>36,>20,>31,>27,>2D,>2D,>28,>30,>25,>33 ; C=5
       byte >3F,>00,>3E,>0A,>3C,>14,>38,>1C,>34,>23,>30,>28,>2D,>2D,>29,>30 ; C=6
       byte >3F,>00,>3E,>09,>3D,>11,>3A,>19,>37,>1F,>33,>25,>30,>29,>2D,>2D ; C=7

********************************************************************************
* Startup code, now the stardust table
* 
* Used by the routine at #R$0106.
* .
* The startup code, which #R$0106 calls once. It is disassembled as
* #R$6F9F@startup, from a snapshot taken before it ran. Its last job is to
* hand its own memory over to the stardust table: it stores its start
* ($6F9F) in #R$EFA6 and its end ($7044) in #R$EFA4, and #R$68CD keeps the
* 15 particles here (11 bytes each). So in this snapshot these bytes are
* the stardust table.
* .
* Each particle's 11 bytes:
* .
* #TABLE
* { =h Offset | =h Contents }
* { $00-$01 | X: the horizontal position relative to the centre of the space
* view (#R$68CD), in signed 8.8 fixed point - the high byte is the pixel
* offset, negative to the left; the view is 176 pixels across }
* { $02-$03 | Y: the vertical position, in the same format - negative
* upwards; the view is 128 pixels high }
* { $04-$05 | The X velocity: the amount added to X each time the
* particle moves, in the same format (#R$6805) }
* { $06-$07 | The Y velocity, likewise }
* { $08 | The respawn flag: $FF when the particle has left the view and
* needs a new position (#R$68CD), 0 once it has one (#R$6805) }
* { $09 | The amount added to the X velocity for each step up in the
* ship's speed, and taken away for each step down (#R$6956, #R$699C): a
* quarter of the direction vector's X component (#R$6F1F) }
* { $0A | The same for the Y velocity }
* TABLE#
* .
* The startup code:
* .
* 1. Saves HL (the address of the cockpit screen picture) in #R$F740.
* 2. Clears $D600-$EFAA.
* 3. Writes 23 JPs, 8 bytes apart from $0000, from the table of addresses
* at #R$71F2: the RST vectors (#R$0000 to #R$0038), and 15 more that
* nothing uses (see #R$003B).
* 4. Copies the pixel masks at $1187 to #R$E700.
* 5. Initialises some variables, loads the default commander (#R$A433) and
* relocates the ship blueprints (#R$7045).
* 6. Seeds the random number generator (#R$2176) from the R register.
* 7. Hands its memory over to the stardust table, as above.
* 8. Fills the explosion's table of random numbers (#R$EEC6).
* 9. Sets the sprite size to 16x16 (VDP register 1, #R$F3E0).
       .msxalign >6f9f
startup_code_stardust_table:                               ; >6f9f
       byte >00,>15,>00,>19,>28,>00,>30,>00,>00,>0A,>0C              ; particle 0
       byte >00,>37,>00,>CB,>2D,>00,>D3,>FF,>00,>0B,>F4              ; particle 1
       byte >00,>EB,>00,>1B,>D8,>FF,>30,>00,>00,>F6,>0C              ; particle 2
       byte >00,>3B,>00,>E0,>37,>00,>E1,>FF,>00,>0D,>F8              ; particle 3
       byte >00,>13,>00,>EC,>27,>00,>CF,>FF,>00,>09,>F3              ; particle 4
       byte >00,>3F,>00,>DD,>37,>00,>E1,>FF,>00,>0D,>F8              ; particle 5
       byte >00,>30,>00,>2C,>30,>00,>28,>00,>00,>0C,>0A              ; particle 6
       byte >00,>EF,>00,>16,>D9,>FF,>31,>00,>00,>F6,>0C              ; particle 7
       byte >00,>DD,>00,>2F,>D9,>FF,>31,>00,>00,>F6,>0C              ; particle 8
       byte >00,>E8,>00,>12,>CC,>FF,>23,>00,>00,>F3,>08              ; particle 9
       byte >00,>29,>00,>C7,>25,>00,>CD,>FF,>00,>09,>F3              ; particle 10
       byte >00,>CB,>00,>32,>D3,>FF,>2D,>00,>00,>F4,>0B              ; particle 11
       byte >00,>3E,>00,>35,>30,>00,>29,>00,>00,>0C,>0A              ; particle 12
       byte >00,>24,>00,>CA,>23,>00,>CC,>FF,>00,>08,>F3              ; particle 13
       byte >00,>3F,>00,>21,>37,>00,>1F,>00,>00,>0D,>07              ; particle 14

********************************************************************************
* Clear the screen and draw its frame
* 
* Used by the routine at #R$60B1.
* .
* Called when a text screen replaces the space view (#R$60B1). Turns the
* display off (VDP register 1), clears the pattern table, sets the colour
* table to white on black ($F1), draws the frame (#R$7161, #R$37E9), and
* turns the display back on.
clear_screen_draw_frame:                                   ; >70e8
       .proc                                               ;                   ; 
       movb @vdp_reg1_cache,a                              ; LD A,($F3E0)      ; 
       .push af                                            ; PUSH AF           ; 
       andi a,>bf00                                        ; AND $BF           ; display off
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,@vdpwa                              ; LD A,$81 / OUT ($99),A; VDP register 1
       seto r0                                             ; LD A,$FF          ; 
       movb r0,@vram_busy_flag                             ; LD ($EF9E),A      ; VRAM busy
       movb @zero,@vdpwa                                   ; LD A,$00 / OUT ($99),A; 
       movb @bytes+>40,@vdpwa                              ; LD A,$40 / OUT ($99),A; VRAM address $0000
       movb @bytes+>18,@c                                  ; LD C,$18          ; 24 rows of the pattern table...
       sb   a,a                                            ; LD A,$00          ; 
       bl   @fill_vram_256                                 ; CALL $35AD        ; ...cleared
       movb @zero,@vdpwa                                   ; LD A,$00 / OUT ($99),A; 
       movb @bytes+>60,@vdpwa                              ; LD A,$60 / OUT ($99),A; VRAM address $2000
       movb @bytes+>18,@c                                  ; LD C,$18          ; 24 rows of the colour table...
       movb @bytes+>f1,a                                   ; LD A,$F1          ; 
       bl   @fill_vram_256                                 ; CALL $35AD        ; ...white on black
       sb   a,a                                            ; XOR A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; 
       li   hl,screen_frame                                ; LD HL,$7161       ; the frame
       bl   @draw_lines                                    ; CALL $37E9        ; draw it
       .pop af                                             ; POP AF            ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,@vdpwa                              ; LD A,$81 / OUT ($99),A; display back on
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw the cockpit picture
* 
* Used by the routine at #R$63F1.
* .
* Turns the display off (bit 6 of VDP register 1, cached at $F3E0),
* decompresses the cockpit picture (#R$F740, #R$390E) - recolouring the
* space view in witchspace (#R$EEC1, #R$3A4D, colour $51) - and turns the
* display back on.
blank_screen_decompress_picture_recolour:                  ; >7139
       .proc
;      limi 0                                              ; DI                ; 
       movb @vdp_reg1_cache,a                              ; LD A,($F3E0)      ; A = VDP register 1 (#R$F3E0)
       .push af                                            ; PUSH AF           ; save it
       andi a,>bf00                                        ; AND $BF           ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; turn the display off
       .save_bank                                          ;                   ; (TI: select the caller's bank again afterwards)
       .select_bank cockpit_picture_bank_select            ;                   ; the picture is in ROM bank 6 on the TI
       movb @cockpit_picture_addr+1,hl                     ; LD HL,($F740)     ; HL -> the cockpit picture (#R$F740)
       movb @cockpit_picture_addr,@l                       ;                   ;
       bl   @decompress_picture                            ; CALL $390E        ; decompress it (#R$390E)
       .restore_bank                                       ;                   ; 
       movb @in_witchspace,a                               ; LD A,($EEC1) / OR A; in witchspace?
       jeq  _7157                                          ; JR Z,$7157        ; no
       movb @bytes+>51,a                                   ; LD A,$51          ; yes: colour the space view $51
       bl   @colour_space_view                             ; CALL $3A4D        ; (#R$3A4D)
_7157:                                                     ; >7157
       .pop af                                             ; POP AF            ; 
;      limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; turn the display back on
       ; EI                                                ; EI                ;
       .endproc                                            ; RET               ; 

********************************************************************************
* Screen frame
* 
* Used by the routine at #R$70E8.
* .
* The lines drawn round text screens by #R$70E8 (see #R$37E9): a box from
* (22, 3) to (233, 188), and a line across at y = 171 above the message
* line.
screen_frame:                                              ; >7161
       byte >03,>16                                               ; box: from (22, 3)
       byte >03,>E9                                               ; to (233, 3)
       byte >BC,>E9                                               ; to (233, 188)
       byte >BC,>16                                               ; to (22, 188)
       byte >03,>16                                               ; back to (22, 3)
       byte >FF                                                   ; 
       byte >AB,>17                                               ; line: from (23, 171)
       byte >AB,>E8                                               ; to (232, 171)
       byte >FF                                                   ; 
       byte >FF                                                   ; end of the list

********************************************************************************
* Move sprite 0 to the cursor position $E709
* 
* Used by the routines at #R$540D and #R$7373.
move_chart_cursor_sprite:                                  ; >73a6
       movb @bytes+>10,@vdpwa                              ; LD A,$10 / OUT ($99),A; VRAM address low byte
       movb @bytes+sprite_attr_write_hi,@vdpwa             ; LD A,$5B / OUT ($99),A; ...high byte, write mode: $1B10 (sprite 4's attributes)
       movb @chart_cursor_x+1,@vdpwd                       ; LD HL,($E709) / LD A,H / OUT ($98),A; sprite 4's Y
       movb @chart_cursor_x,@vdpwd                         ; LD A,L / OUT ($98),A; sprite 4's X
       rt                                                  ; RET               ; 

********************************************************************************
* Add an object to the 3D scanner
* 
* Used by the routine at #R$13FD.
* .
* Called for each object by the main loop (#R$13FD). Works out where the
* object's blip and stick go on the scanner and adds a 7-byte record for
* them to the scanner queue at #R$E94A, which #R$8380 draws during the next
* VBlank. Objects are skipped (no record) on alternate frames if bit 5 of
* ($E914) is set, if bit 3 of their status byte ($F7CD) is set, when not in
* flight, in ship types $1E and $1F, and when they are $1000 or more away
* on any axis.
* .
* The object's distances ($EB82 X, $EB84 Y, $EB86 Z, sign-magnitude with
* the signs at $F7CF/$F7D1/$F7D3) are scaled (#R$848D) to scanner units: X
* to +/-35 columns, Z (depth) to +/-15 rows and Y (height) to +/-28 rows.
* For an object above the ship (Y >= 0) the blip is drawn Y+Z rows above
* the scanner's centre line, with a stick Y rows long running down from it
* to the depth-plane point at Z; the blip is cut off (and the stick
* shortened) if that would be above the top of the scanner. An object below
* is handled by $8288.
* .
* At $8283, when the blip fits below the top row, the blip is 2 rows tall
* (E=2), and the stick takes the rest of the Y rows (D=Y-1).
* .
* At $8288, for an object below the ship (Y negative), the run starts at
* the depth-plane point (row $A5 - Z) and goes down: stick first, blip at
* the bottom. If Y + Z is -15 or more, the blip fits above the bottom of
* the scanner and (at $82A0) there's a 2-row blip with a stick |Y|-1 rows
* long. Otherwise there is no blip (E=0) and the stick runs to the bottom
* row (D = Z + 16). The `INC E` at $8298 is never reached, since the result
* tested at $8296 is always nonzero.
* .
* At $82A7, converts the scanner position to a screen position - column $7A
* + X and row $A5 - B, the scanner's centre being at column 122, row 165 -
* and then to a VRAM address (#R$37D1), and writes the record at the queue
* write pointer (#R$E946):
* .
* Bytes 0-1: VRAM address of the top of the run; bit 7 of byte 1 is set if
* the object is below the ship (stick first, blip at the bottom).
* .
* Byte 2: bits 0-4 the stick length, bits 5-6 the blip height, and bit 7
* set if the blip and stick straddle two character columns.
* .
* Bytes 3-6: pixel masks. Byte 4 (blip) and byte 6 (stick) are for the
* first column, bytes 3 (blip) and 5 (stick) for the second. The blip is 3
* pixels wide and the stick 2, both ending at the object's pixel column;
* #R$8654 and $865C hold the masks for each pixel position. If the pixel is
* 2-7 in its byte, both fit in one column and bytes 3 and 5 are left
* unwritten. If it's 0 or 1, $82F3 moves the address one column left and
* fills in both columns.
* .
* At $82F3, when the object's pixel is 0 or 1 in its byte, the 3-pixel blip
* (and, for pixel 0, the 2-pixel stick) spills into the character column to
* the left. Moves the record's VRAM address one column left and writes the
* masks for both columns: left-hand blip and stick masks in bytes 4 and 6
* (%11 and %1 for pixel 0, %1 and none for pixel 1), right-hand ones from
* #R$8654 and $865C in bytes 3 and 5. Doubles ($E602), since the background
* under two columns will be saved.
* .
* The tail at #R$8332 (also used by $82A0) adds the record to the queue,
* provided the list of saved background bytes at #R$E9D6 has room for it
* (#R$EB03, 300 bytes a frame): ($E602)+5 bytes. Otherwise the object just
* isn't shown this frame.
* TI: the queue pointer ($E946) is a big-endian word (only the TI scanner
* code reads it).
scanner_add_object:                                        ; >8205
       .proc                                               ;                   ; 
       movb @options,r0                                    ; LD A,($E914) / AND $20; skip on alternate frames if bit 5
       czc  @bit5,r0                                       ;                   ; 
       jeq  _8212                                          ; JR Z,$8212        ; 
       movb @current_turn,r0                               ; LD A,($E92E) / AND $01; of ($E914) is set
       czc  @bit0,r0                                       ;                   ; 
       jne  _8205_exit                                     ; RET NZ            ; 
_8212:                                                     ; >8212
       movb @object_status_byte,r0                         ; LD A,($F7CD) / BIT 3,A; A = object status byte
       czc  @bit3,r0                                       ;                   ; 
       jne  _8205_exit                                     ; RET NZ            ; bit 3 set - not shown on the scanner
       movb @space_view_showing,r0                         ; LD A,($E903) / OR A; 
       jeq  _8205_exit                                     ; RET Z             ; not in flight
       movb @ship_type,r0                                  ; LD A,($F7E7)      ; A = ship type
       cb   r0,@bytes+>1e                                  ; CP $1E            ; 
       jeq  _8205_exit                                     ; RET Z             ; $1E - not shown
       cb   r0,@bytes+>1f                                  ; CP $1F            ; 
       jeq  _8205_exit                                     ; RET Z             ; $1F - not shown
       movb @delta_x_hi,r0                                 ; LD A,($EB83) / AND $F0 / RET NZ; X, Y or Z 4096 or more?
       socb @delta_y_hi,r0                                 ; LD A,($EB85) / AND $F0 / RET NZ; 
       socb @delta_z_hi,r0                                 ; LD A,($EB87) / AND $F0 / RET NZ; 
       andi r0,>f000                                       ;                   ; 
       jeq  scanner_add_object_1                           ;                   ; yes - out of scanner range
_8205_exit:
       .endproc                                            ; RET               ; 
scanner_add_object_1:
       movb @object_z_sign,r0                              ; LD A,($F7D3)      ; A = sign of Z
       movb @delta_z_hi,hl                                 ; LD HL,($EB86)     ; HL = the size of Z
       movb @abs_delta_z,@l                                ;                   ; 
       li   r1,>0f                                         ; LD C,$0F          ; 
       bl   @scale_signed_coordinate                       ; CALL $848D        ; A = Z * 15 / 4096 (depth, +/-15 rows)
       movb a,@scratch_buffer_1                            ; LD ($E601),A      ; 
       movb @position_x_hi,r0                              ; LD A,($F7CF)      ; A = sign of X
       movb @delta_x_hi,hl                                 ; LD HL,($EB82)     ; HL = the size of X
       movb @abs_delta_x,@l                                ;                   ; 
       li   r1,>23                                         ; LD C,$23          ; 
       bl   @scale_signed_coordinate                       ; CALL $848D        ; A = X * 35 / 4096 (+/-35 columns)
       movb a,@scratch_buffer                              ; LD ($E600),A      ; 
       movb @position_y_hi,r0                              ; LD A,($F7D1)      ; A = sign of Y
       movb @delta_y_hi,hl                                 ; LD HL,($EB84)     ; HL = the size of Y
       movb @abs_delta_y,@l                                ;                   ; 
       li   r1,>1c                                         ; LD C,$1C          ; 
       bl   @scale_signed_coordinate                       ; CALL $848D        ; A = Y * 28 / 4096 (height, +/-28 rows)
       movb @scratch_buffer,@c                             ; LD BC,($E600)     ; C = X...
       movb @scratch_buffer_1,b                            ;                   ; ...B = Z
       .push a                                             ; PUSH AF           ; save Y; its sign goes in the record
       movb a,a                                            ; OR A              ; 
       jlt  scanner_object_below                           ; JP M,$8288        ; object below the ship
       jne  _826b                                          ; JR NZ,$826B       ; 
       ab   one,a                                          ; INC A             ; treat Y = 0 as 1
_826b:                                                     ; >826b
       movb a,d                                            ; LD D,A            ; D = stick length (Y)
       ab   b,a                                            ; ADD A,B           ; 
       movb a,b                                            ; LD B,A            ; B = Y + Z (blip's height above the centre line)
       sb   @bytes+>1d,a                                   ; SUB $1D           ; 
       jlt  scanner_object_above                           ; JP M,$8283        ; blip below the top row
       jeq  _8277                                          ; JR Z,$8277        ; 
       movb @b255,a                                        ; LD A,$FF          ; 
_8277:                                                     ; >8277
       ab   one,a                                          ; INC A             ; E = blip height: 1 if Y + Z = 29, else 0
       movb a,@e                                           ; LD E,A            ; 
       movb @bytes+>1d,a                                   ; LD A,$1D          ; 
       sb   b,a                                            ; SUB B             ; 
       ab   d,a                                            ; ADD A,D           ; 
       sb   @e,a                                           ; SUB E             ; D = stick length, from the top row down to Z
       movb a,d                                            ; LD D,A            ; 
       movb @bytes+>1c,b                                   ; LD B,$1C          ; B = 28 (blip at the top row)
       jmp  _82a7                                          ; JR $8286 / JR $82A7; 
scanner_object_above:                                      ; >8283
       movb @bytes+>02,@e                                  ; LD E,$02          ; E = blip height (2 rows)
       sb   one,d                                          ; DEC D             ; D = stick length (Y - 1)
       jmp  _82a7                                          ; JR $82A7          ; 
scanner_object_below:                                      ; >8288
       cb   a,@b255                                        ; CP $FF            ; treat Y = -1 as -2
       jne  _828d                                          ; JR NZ,$828D       ; 
       sb   one,a                                          ; DEC A             ; 
_828d:                                                     ; >828d
       movb a,d                                            ; LD D,A            ; D = Y
       ab   b,a                                            ; ADD A,B           ; 
       sb   @bytes+>f1,a                                   ; SUB $F1           ; A = Y + Z + 15
       jlt  _8294                                          ; JP P,$82A0        ; blip fits?
scanner_queue_object:                                      ; >82a0
       movb @bytes+>02,@e                                  ; LD E,$02          ; yes: blip height 2
       movb d,r0                                           ; LD A,D / NEG / DEC A; D = stick length (-Y - 1)
       inv  r0                                             ;                   ; 
       movb r0,d                                           ; LD D,A            ; 
       jmp  _82a7                                          ;                   ; 
_8294:                                                     ; >8294
       sb   @e,@e                                          ; LD E,$00          ; no: no blip
       movb b,a                                            ; LD A,B            ; 
       sb   @bytes+>f0,a                                   ; SUB $F0           ; 
       movb a,d                                            ; SUB E / LD D,A    ; D = stick length, to the bottom row (Z + 16)
_82a7:                                                     ; >82a7
       movb d,a                                            ; LD A,D            ; 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@circle_connector_no_prev_point_gate         ; LD ($E602),A      ; $E602 = stick + blip height
       movb @c,a                                           ; LD A,C            ; 
       ab   @bytes+>7a,a                                   ; ADD A,$7A         ; column = $7A + X
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>a5,a                                   ; LD A,$A5          ; 
       sb   b,a                                            ; SUB B             ; row = $A5 - B
       movb a,b                                            ; LD B,A            ; 
       bl   @pixel_address                                 ; CALL $37D1        ; HL = VRAM address
       mov  @scanner_queue_ptr,ix                          ; LD HL,($E946)     ; IX -> the queue record
       movb @l,*ix                                         ; LD (HL),E         ; byte 0: address low byte
       .pop r0                                             ; POP AF            ; R0 = Y
       andi r0,>8000                                       ; AND $80           ; 
       socb h,r0                                           ; OR B              ; 
       movb r0,@1(ix)                                      ; LD (HL),A         ; byte 1: address high byte, bit 7 = object below
       movb @e,r0                                          ; LD A,E / RRCA x 3 ; 
       sla  r0,5                                           ;                   ; 
       socb d,r0                                           ; OR D              ; R0 = blip height << 5 / stick length
       movb @c,r1                                          ; LD A,C            ; 
       srl  r1,8                                           ;                   ; 
       andi r1,>0007                                       ; AND $07           ; R1 = pixel within the byte (0-7)
       ci   r1,2                                           ; CP $02            ; 
       jl   scanner_queue_object_two_columns               ; JR C,$82F3        ; 0-1 - the run straddles two columns
       movb r0,@2(ix)                                      ; LD (HL),E         ; byte 2: heights, one column
       movb @scanner_blip_masks(r1),@4(ix)                 ; LD A,(IX+$00) / LD (HL),A; byte 4: 3-pixel blip mask
       movb @scanner_stick_masks(r1),@6(ix)                ; LD A,(IX+$00) / LD (HL),A; byte 6: 2-pixel stick mask
       jmp  _8332                                          ; JR $8332          ; add the record to the queue
scanner_queue_object_two_columns:                          ; >82f3
       ab   @circle_connector_no_prev_point_gate,@circle_connector_no_prev_point_gate; LD A,($E602) / ADD A,A / LD ($E602),A; two columns of background to save
       sb   @bytes+>08,*ix                                 ; LD A,(HL) / SUB $08 / LD (HL),A; move the address one column left
       socb @bytes+>80,r0                                  ; SET 7,E           ; 
       movb r0,@2(ix)                                      ; LD (HL),E         ; byte 2: heights, bit 7 = two columns
       movb @scanner_blip_masks(r1),@3(ix)                 ; LD A,(IX+$00) / LD (HL),A; byte 3: right-hand blip mask
       movb @scanner_stick_masks(r1),@5(ix)                ; LD A,(IX+$00) / LD (HL),A; byte 5: right-hand stick mask
       mov  r1,r1                                          ; LD A,D / OR A     ; pixel 0?
       jne  _82f3_pixel_1                                  ;                   ; 
       movb @bytes+>03,@4(ix)                              ; LD A,$03 / LD (HL),A; yes: byte 4: left-hand blip mask %11...
       movb one,@6(ix)                                     ; LD A,$01 / LD (HL),A; ...byte 6: left-hand stick mask %1
       jmp  _8332                                          ;                   ; 
_82f3_pixel_1:                                             
       movb one,@4(ix)                                     ; RRA / LD (HL),A   ; no: byte 4: %1...
       sb   @6(ix),@6(ix)                                  ; XOR A / LD (HL),A ; ...byte 6: none
_8332:                                                     ; >8332
       clr  r0                                             ; LD A,($E602)      ; 
       movb @circle_connector_no_prev_point_gate,r0        ;                   ; 
       swpb r0                                             ;                   ; 
       ai   r0,5                                           ; ADD A,$05 / LD C,A / XOR A / LD B,A; R0 = size of the saved-background record
       movb @scanner_background_space+1,r1                 ; LD HL,($EB03)     ; R1 = space left in the saved-background list
       movb @scanner_background_space,@r1lb                ;                   ; 
       c    r0,r1                                          ; SBC HL,BC         ; 
       jh   _8205_end                                      ; RET C             ; no room - don't show this object
       s    r0,r1                                          ;                   ; 
       movb r1,@scanner_background_space+1                 ; LD ($EB03),HL     ; 
       movb @r1lb,@scanner_background_space                ;                   ; 
       ai   ix,7                                           ; LD ($E946),DE     ; advance the queue write pointer
       mov  ix,@scanner_queue_ptr                          ;                   ; 
       ab   one,@scanner_queue_count                       ; LD HL,$E948 / INC (HL); one more object in the queue
_8205_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Scanner: erase last frame's blips and sticks
* 
* Used by the routine at #R$8380.
* .
* Walks the list of saved-background records that #R$8380 built on the
* previous frame (at #R$E9D6, newest first, chained through their first
* two bytes) and writes the saved bytes back to VRAM (#R$854B with no
* mask), restoring the scanner background under each blip and stick. Each
* record is: link to the previous record (0 at the end), VRAM address,
* run height (bit 7 set for two columns), then the saved bytes (for two
* columns, the second column's follow the first's).
* 
* I:$E949 Nonzero if there are records to restore
* I:$E75C Pointer to the newest record
* TI: the records' words are big-endian, and the head pointer ($E75C) is a
* big-endian word (only the TI scanner code reads them).
scanner_erase:                                             ; >834d
       .proc                                               ;                   ; 
       movb @scanner_drawn_count,r0                        ; LD A,($E949) / OR A; any blips drawn last frame?
       jeq  _834d_end                                      ; RET Z             ; 
       mov  @scanner_saved_first,iy                        ; LD HL,($E75C)     ; IY -> the newest record
_8355:                                                     ; >8355
       movb *iy,r0                                         ; LD E,(HL) / INC HL / LD D,(HL) / INC HL; the link to the previous record
       movb @1(iy),@r0lb                                   ;                   ; 
       .push r0                                            ; PUSH DE           ; save it for the end of this pass
       movb @2(iy),r1                                      ; LD E,(HL) / INC HL / LD D,(HL) / INC HL; R1 = VRAM address
       movb @3(iy),@r1lb                                   ;                   ; 
       movb @4(iy),r2                                      ; LD A,(HL) / INC HL / PUSH AF; R2 = run height, bit 7 = two columns
       mov  iy,de                                          ;                   ; DE -> the saved bytes
       ai   de,5                                           ;                   ; 
       mov  r1,hl                                          ; EX DE,HL          ; HL = VRAM address
       movb r2,b                                           ; AND $7F / LD B,A  ; B = run height
       andi b,>7f00                                        ;                   ; 
       clr  a                                              ; XOR A             ; no mask
       bl   @or_vram_block                                 ; CALL $854B        ; restore the first column
       movb r2,r2                                          ; POP AF / OR A     ; 
       jgt  scanner_erase_one_column                       ; JP P,$837A        ; one column only
       jeq  scanner_erase_one_column                       ;                   ; 
       mov  r1,hl                                          ; LD A,L / ADD A,$08 / LD L,A; next column to the right
       ab   @bytes+>08,@l                                  ;                   ; 
       movb r2,b                                           ;                   ; 
       andi b,>7f00                                        ;                   ; 
       clr  a                                              ; XOR A             ; 
       bl   @or_vram_block                                 ; CALL $854B        ; restore the second column
scanner_erase_one_column:                                  ; >837a
       .pop iy                                             ; POP HL            ; IY = link
       mov  iy,iy                                          ; LD A,H / OR L     ; 
       jne  _8355                                          ; JR NZ,$8355       ; loop until the end of the list
_834d_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Scanner: draw this frame's blips and sticks
* 
* Used by the routine at #R$7202.
* .
* Called by the VBlank interrupt handler (#R$7202, at $727D) once #R$13FD
* has set ($EB02) to say the frame's scanner queue is complete. First
* erases last frame's blips (#R$834D). Then, for each record in the scanner
* queue at #R$E94A (see #R$82A0 for the format): unpacks it into
* $E760-$E769, saves the VRAM bytes about to be drawn over (#R$8528; one or
* two columns, blip height + stick length rows) in a new record in the list
* at #R$E9D6 for #R$834D to restore next frame, and then ORs the blip and
* stick into VRAM: blip first then stick for an object above the ship,
* stick first then blip ($843C) for one below.
* 
* I:$E948 Number of records in the queue
* TI: called at the end of #R$13FD rather than by the VBlank handler. The
* pointers at $E75C, $E75E, $E760 and $E76A, and the records' words, are
* big-endian (only the TI scanner code reads them).
scanner_draw:                                              ; >8380
       .proc                                               ;                   ; 
       bl   @scanner_erase                                 ; CALL $834D        ; erase last frame's blips
       movb @scanner_queue_count,b                         ; LD A,($E948)      ; 
       movb b,@scanner_drawn_count                         ; LD ($E949),A      ; remember how many are drawn, for #R$834D
       jne  scanner_draw_1                                 ; OR A / JP Z,$845C ; 
       .endproc                                            ;                   ; nothing to draw
scanner_draw_1:
       clr  @scanner_saved_last                            ; LD HL,$0000 / LD ($E75E),HL; first saved-background record's link = 0
       li   ix,scanner_queue                               ; LD HL,$E94A       ; IX -> the scanner queue
       li   iy,shared_blit_or_goatsoup_buffer              ; LD DE,$E9D6       ; IY -> the saved-background list
scanner_draw_record:                                       ; >839a
       .push bc                                            ; PUSH BC           ; 
       mov  iy,@scanner_saved_first                        ; LD ($E75C),DE     ; this record becomes the head of the list
       mov  @scanner_saved_last,r0                         ; LD HL,$E75E / LDI / LDI; link to the previous record
       movb r0,*iy+                                        ;                   ; 
       movb @r0lb,*iy+                                     ;                   ; 
       mov  @scanner_saved_first,@scanner_saved_last       ; LD ($E75E),BC     ; remember this record for the next one's link
       movb @1(ix),r0                                      ; LD A,(HL) ...     ; R0 = the VRAM address, bit 15 = object below
       movb *ix,@r0lb                                      ;                   ; 
       mov  r0,r1                                          ;                   ; 
       andi r1,>7fff                                       ; AND $7F           ; 
       mov  r1,@scanner_vram_addr                          ; LD ($E760),A / LD ($E761),A; 
       movb r1,*iy+                                        ; LD (DE),A         ; copy the address without bit 15
       movb @r1lb,*iy+                                     ;                   ; 
       andi r0,>8000                                       ;                   ; 
       movb r0,@scanner_below_flag                         ; LD ($E762),A      ; $E762 = bit 7: object below
       movb @2(ix),r0                                      ; LD A,(HL) / LD C,A; 
       mov  r0,r1                                          ;                   ; 
       andi r1,>8000                                       ; AND $80           ; 
       movb r1,@scanner_two_columns                        ; LD ($E763),A      ; $E763 = bit 7: two columns
       mov  r0,r1                                          ; RLCA x 3 / AND $03; 
       srl  r1,5                                           ;                   ; 
       andi r1,>0300                                       ;                   ; 
       movb r1,@scanner_heights                            ; LD ($E764),A      ; $E764 = blip height
       andi r0,>1f00                                       ; AND $1F           ; 
       movb r0,@scanner_stick_length                       ; LD ($E765),A      ; $E765 = stick length
       ab   r1,r0                                          ; ADD A,B / LD B,A  ; R0 = run height
       movb r0,r1                                          ;                   ; 
       socb @scanner_two_columns,r1                        ; LD A,($E763) / OR B; 
       movb r1,*iy+                                        ; LD (DE),A / INC DE; save the height and two-column flag
       mov  iy,@scanner_background_save_address            ; LD ($E76A),DE     ; where to save the background
       movb @3(ix),@scanner_masks_copy                     ; LD DE,$E766 / LDI x 4; copy the 4 masks to $E766-$E769
       movb @4(ix),@scanner_masks_copy+1                   ;                   ; 
       movb @5(ix),@scanner_masks_copy+2                   ;                   ; 
       movb @6(ix),@scanner_masks_copy+3                   ;                   ; 
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760)     ; 
       mov  iy,de                                          ; LD DE,($E76A)     ; 
       movb r0,b                                           ; EX AF,AF' / LD B,A; 
       bl   @read_vram_block                               ; CALL $8528        ; save the first column's background
       movb @scanner_two_columns,r0                        ; LD A,($E763) / OR A; 
       jgt  scanner_draw_one_column                        ; JP P,$8412        ; one column
       jeq  scanner_draw_one_column                        ;                   ; 
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760) / LD A,L / ADD A,$08 / LD L,A; 
       ab   @bytes+>08,@l                                  ;                   ; 
       movb @scanner_heights,b                             ; EX AF,AF' / LD B,A; 
       ab   @scanner_stick_length,b                        ;                   ; 
       bl   @read_vram_block                               ; CALL $8528        ; save the second column's background
scanner_draw_one_column:                                   ; >8412
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760)     ; 
       mov  @scanner_background_save_address,de            ; LD DE,($E76A)     ; 
       movb @scanner_below_flag,r0                         ; LD A,($E762) / OR A; 
       jne  scanner_draw_below                             ; JP M,$843C        ; object below - stick first
       bl   @scanner_or_blip_1                             ; CALL $845D        ; OR the blip into the first column
       bl   @scanner_or_stick_1                            ; CALL $8469        ; then the stick
       movb @scanner_two_columns,r0                        ; LD A,($E763) / OR A; 
       jeq  scanner_draw_next                              ; JP P,$843A        ; one column
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760) / LD A,L / ADD A,$08 / LD L,A; 
       ab   @bytes+>08,@l                                  ;                   ; 
       bl   @scanner_or_blip_2                             ; CALL $8475        ; OR the blip into the second column
       bl   @scanner_or_stick_2                            ; CALL $8481        ; then the stick
       jmp  scanner_draw_next                              ; JR $8456          ; 
scanner_draw_below:                                        ; >843c
       bl   @scanner_or_stick_1                            ; CALL $8469        ; OR the stick into the first column
       bl   @scanner_or_blip_1                             ; CALL $845D        ; then the blip
       movb @scanner_two_columns,r0                        ; LD A,($E763) / OR A; 
       jeq  scanner_draw_next                              ; JP P,$8456        ; 
       mov  @scanner_vram_addr,hl                          ; LD HL,($E760) / LD A,L / ADD A,$08 / LD L,A; 
       ab   @bytes+>08,@l                                  ;                   ; 
       bl   @scanner_or_stick_2                            ; CALL $8481        ; stick, second column
       bl   @scanner_or_blip_2                             ; CALL $8475        ; then the blip
scanner_draw_next:                                         ; >8456
       mov  de,iy                                          ;                   ; IY -> the next saved-background record
       ai   ix,7                                           ; POP HL            ; IX -> the next queue record
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DEC B             ; 
       jeq  _845c                                          ; JP NZ,$839A       ; 
       b    @scanner_draw_record                           ;                   ; next record
_845c:                                                     ; >845c
       .endproc                                            ; RET               ; 

********************************************************************************
* Scanner: OR a blip into VRAM (first column)
* 
* Used by the routine at #R$8380.
* .
* Writes ($E764) rows downwards from HL, each the saved background byte
* at DE ORed with the mask at $E767 (#R$854B). Does nothing if the
* blip height is 0.
* 
* I:DE Pointer to the saved background bytes
* I:HL VRAM address
scanner_or_blip_1:                                         ; >845d
       movb @scanner_heights,b                             ; LD A,($E764) / OR A / LD B,A; 
       jne  _8463                                          ; RET Z             ; 
       rt                                                  ;                   ; 
_8463:                                                     ; >8463
       movb @scanner_masks_copy+1,a                        ; LD A,($E767)      ; 
       b    @or_vram_block                                 ; JP $854B          ; 

********************************************************************************
* Scanner: OR a stick into VRAM (first column)
* 
* Used by the routine at #R$8380.
* .
* Writes ($E765) rows downwards from HL, each the saved background byte
* at DE ORed with the mask at $E769 (#R$854B). Does nothing if the
* stick length is 0.
* 
* I:DE Pointer to the saved background bytes
* I:HL VRAM address
scanner_or_stick_1:                                        ; >8469
       movb @scanner_stick_length,b                        ; LD A,($E765) / OR A / LD B,A; 
       jne  _846f                                          ; RET Z             ; 
       rt                                                  ;                   ; 
_846f:                                                     ; >846f
       movb @scanner_masks_copy+3,a                        ; LD A,($E769)      ; 
       b    @or_vram_block                                 ; JP $854B          ; 

********************************************************************************
* Scanner: OR a blip into VRAM (second column)
* 
* Used by the routine at #R$8380.
* .
* Writes ($E764) rows downwards from HL, each the saved background byte
* at DE ORed with the mask at $E766 (#R$854B). Does nothing if the
* blip height is 0.
* 
* I:DE Pointer to the saved background bytes
* I:HL VRAM address
scanner_or_blip_2:                                         ; >8475
       movb @scanner_heights,b                             ; LD A,($E764) / OR A / LD B,A; 
       jne  _847b                                          ; RET Z             ; 
       rt                                                  ;                   ; 
_847b:                                                     ; >847b
       movb @scanner_masks_copy,a                          ; LD A,($E766)      ; 
       b    @or_vram_block                                 ; JP $854B          ; 

********************************************************************************
* Scanner: OR a stick into VRAM (second column)
* 
* Used by the routine at #R$8380.
* .
* Writes ($E765) rows downwards from HL, each the saved background byte
* at DE ORed with the mask at $E768 (#R$854B). Does nothing if the
* stick length is 0.
* 
* I:DE Pointer to the saved background bytes
* I:HL VRAM address
scanner_or_stick_2:                                        ; >8481
       movb @scanner_stick_length,b                        ; LD A,($E765) / OR A / LD B,A; 
       jne  _8487                                          ; RET Z             ; 
       rt                                                  ;                   ; 
_8487:                                                     ; >8487
       movb @scanner_masks_copy+2,a                        ; LD A,($E768)      ; 
       b    @or_vram_block                                 ; JP $854B          ; 

********************************************************************************
* Scale an unsigned magnitude by a fixed-point factor, then apply a sign
* 
* Used by the routine at #R$8205.
* .
* Computes a signed 8-bit result = +/-((HL * C) >> 12), where the sign
* comes from the caller's A rather than from HL or C, which are both
* treated as unsigned. Multiplies via #R$1F86 to get a 24-bit product in
* A:HL, then rotates the top two bytes (A:H) left by 4 bits at a time
* (through L, which is otherwise untouched) to bring product bits 12-19
* down into A - equivalent to product >> 12, keeping only the low 8 bits
* of that shifted result. C is therefore a scale factor out of 4096.
* 
* I:A Sign of the result (only the sign bit matters)
* I:HL Unsigned 16-bit magnitude to scale
* I:C Fixed-point scale factor, numerator over 4096
* O:A Signed result; not clamped if the shifted magnitude exceeds 127
* TI: the sign is in R0 and the factor in R1.
scale_signed_coordinate:                                   ; >848d
       mpy  hl,r1                                          ; LD A,C / CALL $1F86; R1:R2 = HL * C
       sla  r1,4                                           ; RL H / RLA x 4    ; (product >> 12) and $FF...
       srl  r2,12                                          ;                   ; 
       soc  r2,r1                                          ;                   ; 
       swpb r1                                             ;                   ; 
       movb r1,a                                           ; LD L,A            ; ...in A
       movb r0,r0                                          ; EX AF,AF' / OR A  ; 
       jlt  _84a3                                          ; LD A,L / RET P    ; positive sign - return the magnitude as-is
       rt                                                  ;                   ; 
_84a3:                                                     ; >84a3
       andi a,>ff00                                        ;                   ; 
       neg  a                                              ; NEG               ; negative sign - negate it
       rt                                                  ; RET               ; 

********************************************************************************
* Length of a vector
* 
* Used by the routines at #R$2DF1, #R$3113 and #R$883D.
* .
* Returns roughly sqrt(X^2 + Y^2 + Z^2) for the vector at $EB82/$EB84/$EB86
* (an object's distances from a reference point along each axis), to
* within about 2% (slightly low) - the distance to the object. Works
* with logarithms: shifts the components down together so that the
* biggest fits in a byte (the shift count, from the bit-length table at
* #R$0200, goes in ($EB9B)), squares each (#R$8515) and adds the squares;
* then takes the log of the sum (#R$0800), halves it - a square root -
* adds back the shift, and converts it back (#R$21A3). The shifted-down
* components are also left in $EF92-$EF94.
* 
* I:$EB82-$EB87 The vector's components (magnitudes)
* O:HL Its length
vector_length:                                             ; >84a6
       .proc                                               ;                   ; 
       clr  r0                                             ;                   ; 
       movb @delta_x_hi,r0                                 ; LD A,($EB83)      ; combine the three components' high bytes
       socb @delta_y_hi,r0                                 ; LD HL,$EB85 / OR (HL); 
       socb @delta_z_hi,r0                                 ; LD HL,$EB87 / OR (HL); 
       jeq  _84b7                                          ; JR Z,$84B7        ; all under 256 - no shift
       mov  r0,r1                                          ; LD L,A / LD H,$02 ; 
       srl  r1,8                                           ;                   ; 
       movb @bit_length_table(r1),r0                       ; LD A,(HL)         ; A = shift needed to fit the biggest in a byte
_84b7:                                                     ; >84b7
       movb r0,@depth_shift                                ; LD ($EB9B),A      ; 
       movb @delta_x_hi,hl                                 ; LD HL,($EB82)     ; HL = X
       movb @abs_delta_x,@l                                ;                   ; 
       bl   @vector_length_square                          ; CALL $8515        ; square X (shifted down)
       movb a,@ef92_scaled_magnitude_1                     ; LD ($EF92),A      ; 
       mov  hl,de                                          ; PUSH HL           ; BC:DE = the sum of the squares (TI: in registers)
       clr  bc                                             ;                   ; 
       movb @delta_y_hi,hl                                 ; LD HL,($EB84)     ; HL = Y
       movb @abs_delta_y,@l                                ;                   ; 
       bl   @vector_length_square                          ; CALL $8515        ; square Y
       movb a,@ef93_scaled_magnitude_2                     ; LD ($EF93),A      ; 
       a    hl,de                                          ; ADD HL,DE / ADC A,B; add it
       jnc  vector_length_1                                ;                   ; 
       inc  bc                                             ;                   ; 
vector_length_1:                                           
       movb @delta_z_hi,hl                                 ; LD HL,($EB86)     ; HL = Z
       movb @abs_delta_z,@l                                ;                   ; 
       bl   @vector_length_square                          ; CALL $8515        ; square Z
       movb a,@ef94_scaled_magnitude_3                     ; LD ($EF94),A      ; 
       a    hl,de                                          ; ADD HL,DE / ADC A,B; add it
       jnc  vector_length_2                                ;                   ; 
       inc  bc                                             ;                   ; 
vector_length_2:                                           
       clr  r2                                             ;                   ; R2 = the shift so far
       mov  bc,bc                                          ;                   ; under 65536?
       jeq  _84e6                                          ; JR Z,$84E6        ; yes
       srl  de,8                                           ; LD E,D / LD D,A   ; no: divide it by 256...
       swpb bc                                             ;                   ; 
       soc  bc,de                                          ;                   ; 
       li   r2,8                                           ; LD A,$08          ; ...remembering the 8-bit shift
_84e6:                                                     ; >84e6
       clr  r1                                             ;                   ; 
       movb de,r1                                          ; LD A,D / OR A     ; under 256?
       jeq  _84f5                                          ; JR Z,$84F5        ; yes
       swpb r1                                             ; LD L,A / LD H,$02 ; 
       movb @bit_length_table(r1),r1                       ; LD B,(HL)         ; B = shift to fit the sum in a byte
       swpb r1                                             ;                   ; 
       a    r1,r2                                          ; LD A,(HL) / ADD A,C; add it to the shift
       mov  r1,r0                                          ;                   ; 
       srl  de,0                                           ; RRA / RR E / DJNZ $84EF; shift the sum down (by R0)
_84f5:                                                     ; >84f5
       sla  r2,10                                          ; ADD A,A / ADD A,A / EX AF,AF'; the shift * 4 (1024 per bit in the log), in the high byte
       sla  de,1                                           ; SLA E / ADC A,$08 / LD L,E / LD H,A; 
       mov  @log_table(de),hl                              ; LD A,(HL) / INC L / LD H,(HL) / LD L,A; HL = log of the shifted-down sum
       a    r2,hl                                          ; EX AF,AF' / ADD A,H / LD H,A; add the shifts back
       srl  hl,1                                           ; SRL H / RR L      ; halve the log: a square root
       clr  r0                                             ;                   ; 
       movb @depth_shift,r0                                ; LD A,($EB9B)      ; A = the components' shift
       sla  r0,2                                           ; ADD A,A / ADD A,A ; times 4
       a    r0,hl                                          ; ADD A,H / LD H,A  ; add it back
       .pop r11                                            ;                   ; 
       b    @antilog16                                     ; JP $21A3          ; convert back: HL = the length

********************************************************************************
* Vector length: square one component
* 
* Used by the routine at #R$84A6.
* .
* Shifts the component in HL right by the shared exponent in ($EB9B)
* (set by #R$84A6 so that the biggest component fits in a byte) and
* squares it (#R$2191).
* 
* I:HL Vector component
* O:A The component, shifted down
* O:HL Its square
vector_length_square:                                      ; >8515
       clr  r0                                             ;                   ; 
       movb @depth_shift,r0                                ; LD A,($EB9B) / OR A; 
       jeq  _8522                                          ; JR Z,$8522        ; no shift needed
       swpb r0                                             ; LD B,A            ; 
       srl  hl,0                                           ; LD A,H / RRA / RR L / DJNZ $851D; shift the component down (by R0)
_8522:                                                     ; >8522
       movb @l,a                                           ; LD E,L / ... / LD A,E; A = the component, shifted down
* TI: the square (#R$2191) is worked out here, the same way: L's log, doubled
* and converted back (#R$21A3, inline, as it changes A).
       sla  hl,1                                           ; SLA L / ADC A,$08 / LD H,A; 
       mov  @log_table(hl),hl                              ; LD A,(HL) / INC L / LD H,(HL) / LD L,A; HL = log(L)
       a    hl,hl                                          ; ADD HL,HL         ; HL = log(L * L)
       joc  vector_length_square_0                         ; JP NC,$21A3       ; 
       mov  hl,r1                                          ; LD A,H            ; 
       andi r1,>4000                                       ; BIT 6,A           ; HL >= $4000?
       jne  vector_length_square_max                       ; JR NZ,$21C0       ; too big - return $FFFF
       mov  hl,r1                                          ;                   ; 
       srl  r1,4                                           ;                   ; 
       andi r1,>03fe                                       ;                   ; 
       mov  @antilog_table(r1),hl                          ;                   ; HL = 2^(log / 1024)
       rt                                                  ; RET               ; 
vector_length_square_max:                                  
       seto hl                                             ; LD HL,$FFFF       ; 
       rt                                                  ; RET               ; 
vector_length_square_0:                                    
       clr  hl                                             ; LD HL,$0000       ; L = 0: return 0
       rt                                                  ; RET               ; 

********************************************************************************
* Read a block of VRAM into a Z80 RAM buffer
* 
* Used by the routine at #R$8380.
* .
* Sets the VDP address for reading (no $40 on the high byte - that bit
* selects write mode), then copies B bytes from VRAM to (DE). Uses the same
* one-name-table-row-per-8-bytes addressing as #R$35B8/#R$854B: every 8th
* byte the VRAM address drops to the same column one row down (+256 bytes)
* instead of continuing into the next character.
* 
* I:HL VRAM address to start reading from
* I:DE Destination buffer in Z80 RAM
* I:B Number of bytes to read
* O:DE Advanced past the last byte written
read_vram_block:                                           ; >8528
       movb @l,@vdpwa                                      ; LD A,L / OUT ($99),A; 
       movb h,@vdpwa                                       ; LD A,H / OUT ($99),A; point the VDP at the address, for reading
_8532:                                                     ; >8532
       movb @vdprd,*de+                                    ; IN A,($98) / LD (DE),A / INC DE; read a byte
       ab   one,@l                                         ; INC L             ; 
       movb @l,r0                                          ; LD A,L / AND C    ; 
       andi r0,>0700                                       ;                   ; 
       jne  _8548                                          ; JR NZ,$8548       ; still within the character
       movb @l,r0                                          ; LD A,L            ; 
       sb   one,r0                                         ; DEC A             ; 
       andi r0,>f800                                       ; AND $F8           ; back to the character's first row...
       movb r0,@l                                          ; LD L,A            ; 
       movb r0,@vdpwa                                      ; OUT ($99),A       ; 
       ab   one,h                                          ; INC H             ; ...one character row down
       movb h,@vdpwa                                       ; LD A,H / OUT ($99),A; 
_8548:                                                     ; >8548
       sb   one,b                                          ; DJNZ $8532        ; 
       jne  _8532                                          ;                   ; 
       rt                                                  ; RET               ; 

********************************************************************************
* OR a Z80 RAM buffer into VRAM
* 
* Used by the routines at #R$834D, #R$845D, #R$8469, #R$8475 and #R$8481.
* .
* The mirror of #R$8528: sets the VDP address for writing, then for B bytes
* reads a byte from (DE), ORs it with C, and writes the result to VRAM -
* merging new pixels into whatever was already there rather than
* overwriting it. Same one-row-per-8-bytes addressing as #R$8528/#R$35B8.
* 
* I:A Byte to OR into every byte written (becomes C)
* I:HL VRAM address to start writing to
* I:DE Source buffer in Z80 RAM
* I:B Number of bytes to write
* O:DE Advanced past the last byte read
* TI: the byte to OR in is in A rather than C.
or_vram_block:                                             ; >854b
       movb @l,@vdpwa                                      ; LD C,A / LD A,L / OUT ($99),A; 
       movb h,r0                                           ; LD A,H            ; 
       socb @bytes+>40,r0                                  ; OR $40            ; 
       movb r0,@vdpwa                                      ; OUT ($99),A       ; point the VDP at the address, for writing
_8554:                                                     ; >8554
       movb *de+,r0                                        ; LD A,(DE) / INC DE; 
       socb a,r0                                           ; OR C              ; OR in A
       movb r0,@vdpwd                                      ; OUT ($98),A       ; write the byte
       ab   one,@l                                         ; INC L             ; 
       movb @l,r0                                          ; LD A,L / AND $07  ; 
       andi r0,>0700                                       ;                   ; 
       jne  or_vram_next_byte                              ; JP NZ,$856D       ; still within the character
       movb @l,r0                                          ; LD A,L            ; 
       sb   one,r0                                         ; DEC A             ; 
       andi r0,>f800                                       ; AND $F8           ; back to the character's first row...
       movb r0,@l                                          ; LD L,A            ; 
       movb r0,@vdpwa                                      ; OUT ($99),A       ; 
       ab   one,h                                          ; INC H             ; ...one character row down
       movb h,r0                                           ; LD A,H            ; 
       socb @bytes+>40,r0                                  ; OR $40            ; 
       movb r0,@vdpwa                                      ; OUT ($99),A       ; 
or_vram_next_byte:                                         ; >856d
       sb   one,b                                          ; DJNZ $8554        ; 
       jne  _8554                                          ;                   ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Compass: work out one coordinate of the compass dot
* 
* Used by the routine at #R$85FB.
* .
* Returns k * |v| / sqrt(v^2 + Z^2), with the sign of v, where v is HL (the
* target's X or Y) and Z is ($EB86) (|Z|, the target's depth). v and Z are
* first shifted right together until both fit in a byte (using the
* bit-length table at #R$0200), then squared (#R$1F5E), and the square root
* of the sum (#R$1F9C) scaled back up. |v| * k ($85CC; *8 is done with
* shifts) is then divided by that root. The result is at most k in size.
* .
* At $85CC, for k other than 8, multiplies |v| (HL) by k. The tail at $85DA
* (shared with #R$8570's k=8 path) divides the product by the distance
* sqrt(v^2 + Z^2) in DE, and gives the result the sign of v.
* 
* I:A Scale k (8 for Y, 1-6 for X)
* I:HL v (two's complement)
* O:A The signed result
* O:L Its magnitude
* TI: k is in R0, and the magnitude is returned in R1; the square, square
* root and division are done with MPY and DIV.
compass_coordinate:                                        ; >8570
       .proc                                               ;                   ; 
       .push hl                                            ; PUSH HL           ; save v
       .push r0                                            ; PUSH AF           ; save k
       abs  hl                                             ; BIT 7,H / ...     ; HL = the size of v
       .push hl                                            ; PUSH HL           ; save its size
       clr  r1                                             ;                   ; 
       movb @delta_z_hi,r1                                 ; LD A,($EB87)      ; A = the high byte of Z...
       socb hl,r1                                          ; OR H              ; ...ORed with v's
       jeq  _8587                                          ; JR Z,$8587        ; both under 256 - no shift needed
       swpb r1                                             ; LD C,A / LD B,$02 ; 
       movb @bit_length_table(r1),r1                       ; LD A,(BC)         ; the shift needed
_8587:                                                     ; >8587
       movb r1,@depth_shift                                ; LD ($EB9B),A      ; save the shift count
       jeq  _8594                                          ; OR A / JR Z,$8594 ; no shift
       mov  r1,r0                                          ; LD B,A            ; 
       srl  r0,8                                           ;                   ; 
       srl  hl,0                                           ; RRA / RR L / DJNZ $858F; shift the size of v right to fit in a byte
_8594:                                                     ; >8594
       bl   @square_l                                      ; CALL $1F5E        ; HL = its square
       .push hl                                            ; PUSH HL           ; save it
       movb @delta_z_hi,hl                                 ; LD HL,($EB86)     ; HL = the size of Z
       movb @abs_delta_z,@l                                ;                   ; 
       clr  r0                                             ;                   ; 
       movb @depth_shift,r0                                ; LD A,($EB9B) / OR A; 
       jeq  _85a8                                          ; JR Z,$85A8        ; no shift
       swpb r0                                             ; LD B,A            ; 
       srl  hl,0                                           ; RRA / RR L / DJNZ $85A3; shift the size of Z right by the same amount
_85a8:                                                     ; >85a8
       bl   @square_l                                      ; CALL $1F5E        ; HL = Z squared
       .pop de                                             ; POP DE            ; DE = v squared
       clr  a                                              ; XOR A             ; 
       a    de,hl                                          ; ADD HL,DE         ; 
       jnc  _85af                                          ; ADC A,A           ; A:HL = v^2 + Z^2
       movb one,a                                          ;                   ; 
_85af:                                                     ; >85af
       bl   @square_root                                   ; CALL $1F9C        ; HL = sqrt(v^2 + Z^2)
       clr  r0                                             ;                   ; 
       movb @depth_shift,r0                                ; LD A,($EB9B) / OR A; 
       jeq  _85bc                                          ; JR Z,$85BC        ; no shift
       swpb r0                                             ; LD B,A            ; 
       sla  hl,0                                           ; ADD HL,HL / DJNZ $85B9; shift the root back up
_85bc:                                                     ; >85bc
       mov  hl,de                                          ; EX DE,HL          ; DE = the distance sqrt(v^2 + Z^2)
       .pop r1                                             ; POP HL            ; R1 = the size of v
       .pop r0                                             ; POP AF            ; R0 = k
       mpy  r0,r1                                          ; CP $08 / ...      ; R1:R2 = the size of v * k
       c    r1,de                                          ;                   ; does the quotient fit?
       jl   compass_divide                                 ;                   ; yes
       clr  r1                                             ;                   ; no (a distance of 0): 0
       jmp  _85f3                                          ;                   ; 
compass_divide:                                            
       div  de,r1                                          ; LD B,$08 / ... / DJNZ $85E0; R1 = the size of v * k / the distance
_85f3:                                                     ; >85f3
       .pop r0                                             ; POP HL            ; R0 = v (for its sign)
       mov  r1,a                                           ; LD L,A            ; A = the magnitude...
       swpb a                                              ;                   ; 
       mov  r0,r0                                          ; BIT 7,H           ; v positive?
       jlt  _85f8                                          ; RET Z             ; 
       jmp  compass_coordinate_exit                        ;                   ; yes - done
_85f8:                                                     ; >85f8
       neg  a                                              ; NEG               ; no: negate the result
compass_coordinate_exit:
       .endproc                                            ; RET               ; 

********************************************************************************
* Compass: position the compass dot
* 
* Used by the routine at #R$13FD.
* .
* Called for each object by the main loop, but only acts for the object
* the compass is tracking: the one whose slot number (#R$E911) matches
* ($EB05) - slot 0, the planet, or slot 1, the space station, once the
* ship is inside the station's safe zone (see #R$1549). Does nothing
* after a drive malfunction (($EEC1) set) or when the dashboard isn't
* shown (#R$6C9E).
* .
* The compass dot is sprite 8 (pattern $18). From the target's position
* relative to the ship (X, Y, Z at $F7CE/$F7D0/$F7D2) it is placed
* 8*Y/sqrt(Y^2+Z^2) pixels above the compass centre and k*X/sqrt(X^2+Z^2)
* pixels to the right of it (#R$8570), where k comes from the table at
* #R$8664 and narrows the horizontal range the further the dot is from
* the centre line, keeping it inside the compass circle. The dot is
* green (colour 2) if the target is in front of the ship and light blue
* (colour 5) if it is behind.
compass:                                                   ; >85fb
       .proc                                               ;                   ; 
       movb @in_witchspace,r0                              ; LD A,($EEC1) / OR A; no compass after a drive malfunction
       jne  _85fb_end                                      ; RET NZ            ; 
       cb   @current_slot,@station_in_range                ; LD A,($E911) / LD HL,$EB05 / CP (HL); the compass target?
       jne  _85fb_end                                      ; RET NZ            ; no
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown
       mov  @object_position_z,hl                          ; LD HL,($F7D2)     ; HL = Z
       abs  hl                                             ; BIT 7,H / ...     ; HL = the size of Z
       movb hl,@delta_z_hi                                 ; LD ($EB86),HL     ; $EB86 = the size of Z
       movb @l,@abs_delta_z                                ;                   ; 
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; HL = Y
       li   r0,8                                           ; LD A,$08          ; 8 (vertical range)
       bl   @compass_coordinate                            ; CALL $8570        ; A = 8 * Y / sqrt(Y^2 + Z^2), R1 = its magnitude
       .push a                                             ; PUSH AF           ; save it
       movb @compass_range_table(r1),r0                    ; LD H,$00 / LD BC,$8664 / ADD HL,BC / LD A,(HL); the horizontal range for that height
       srl  r0,8                                           ;                   ; 
       mov  @object_position_x,hl                          ; LD HL,($F7CE)     ; HL = X
       bl   @compass_coordinate                            ; CALL $8570        ; A = k * X / sqrt(X^2 + Z^2)
       .pop r2                                             ; POP BC            ; R2 = vertical offset
       ab   @bytes+>a5,a                                   ; ADD A,$A5         ; C = sprite X ($A5 = compass centre)
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>91,a                                   ; LD A,$91          ; 
       sb   r2,a                                           ; SUB B             ; 
       movb a,b                                            ; LD B,A            ; B = sprite Y ($91 = compass centre)
       movb @bytes+>02,@e                                  ; LD E,$02          ; colour 2 (green)...
       movb @object_z_sign,r0                              ; LD A,($F7D3) / OR A; A = sign of Z
       jgt  compass_set_dot                                ; JP P,$8644        ; target in front
       jeq  compass_set_dot                                ;                   ; 
       movb @bytes+>05,@e                                  ; LD E,$05          ; behind: colour 5 (light blue)
compass_set_dot:                                           ; >8644
       movb @bytes+>18,d                                   ; LD D,$18          ; pattern $18
       movb @bytes+>20,@vdpwa                              ; LD A,$20 / OUT ($99),A; 
       movb @bytes+sprite_attr_write_hi,@vdpwa             ; LD A,$5B / OUT ($99),A; VRAM address $1B20: sprite 8's attributes
       bl   @set_sprite                                    ; CALL $39A4        ; write Y, X, pattern and colour
_85fb_end:                                                 
       .endproc                                            ; RET               ; 

********************************************************************************
* Scanner blip and stick masks
* 
* Two 8-entry tables indexed by the object's pixel position within its
* screen byte (0-7), used by #R$82A7 (positions 2-7) and #R$82F3 (positions
* 0 and 1). $8654 is the 3-pixel blip mask ending at that pixel, $865C the
* 2-pixel stick mask; at positions 0 and 1 the rest spills into the byte to
* the left (see #R$82F3).
scanner_blip_masks:                                        ; >8654
       byte >80,>C0,>E0,>70,>38,>1C,>0E,>07                       ; 
scanner_stick_masks:                                       ; >865c
       byte >80,>C0,>60,>30,>18,>0C,>06,>03                       ; 

********************************************************************************
* Compass dot horizontal range table
* 
* Entry n (0-8) is how far (in pixels) the compass dot may be placed left
* or right of the compass centre when it is n pixels above or below it -
* roughly the half-width of the compass circle at that height. Used by
* #R$85FB as the scale for the dot's horizontal offset.
compass_range_table:                                       ; >8664
       byte >06,>06,>06,>05,>05,>04,>04,>03,>01                   ; 
       even                                                       ; 

********************************************************************************
* Move the object forward
* 
* Used by the routines at #R$13FD and #R$1703.
* .
* Called for each object by the main loop (#R$13FD) and the death scene
* (#R$1703). Clears bit 4 of #R$F7CD. Does nothing if the object's speed
* (#R$F7E6) is 0; otherwise moves it along its nose vector (#R$8685) by
* its speed, halved once for each distance band (#R$8B66).
move_object:                                               ; >866d
       szcb @bit4,@object_status_byte                      ; LD HL,$F7CD / RES 4,(HL); 
       movb @object_speed,a                                ; LD A,($F7E6) / OR A; A = speed
       jne  _8677                                          ; RET Z             ; not moving
       rt                                                  ;                   ; 
_8677:                                                     ; >8677
       .proc                                               ;                   ; 
       bl   @distance_band                                 ; CALL $8B66        ; A = distance band
       movb a,b                                            ; LD B,A            ; 
       movb @object_speed,a                                ; LD A,($F7E6)      ; 
_867e:                                                     ; >867e
       srl  a,1                                            ; SRL A             ; halve the speed...
       sb   one,b                                          ; DJNZ $867E        ; ...once per band
       jne  _867e                                          ;                   ; 
       .pop r11                                            ;                   ; 
       b    @move_along_axis                               ; JP $8685          ; move it

********************************************************************************
* Move the object along its axis vector
* 
* Used by the routines at #R$3187 and #R$866D.
* .
* Adds speed * the object's axis vector ($F7DA/$F7DC/$F7DE) to its
* position ($F7CE/$F7D0/$F7D2), multiplying by adding logarithms: the log
* of the speed (from the log table at #R$0800) goes in $E874 and the logs
* of the vector's components (#R$1FCF) in $EB68-$EB6D, and #R$86DC does
* each coordinate. Also sets bit 4 of the status byte ($F7CD).
* 
* I:A Speed
move_along_axis:                                           ; >8685
       .proc                                               ;                   ; 
       clr  r1                                             ;                   ; 
       movb a,r1                                           ; LD L,A / LD H,$00 ; 
       srl  r1,7                                           ; ADD HL,HL         ; R1 = speed * 2
       mov  @log_table(r1),@type_entry_cache               ; LD BC,$0800 / ADD HL,BC / LD DE,$E874 / LDI / LDI; $E874 = log(speed) (TI: a big-endian word)
       mov  @nose_vector,hl                                ; LD HL,($F7DA)     ; HL = nose.x
       bl   @log_sign_tagged                               ; CALL $1FCF        ; its log
       mov  hl,@nose_vector_logs                           ; LD ($EB68),HL     ; 
       mov  @nose_vector_y,hl                              ; LD HL,($F7DC)     ; HL = nose.y
       bl   @log_sign_tagged                               ; CALL $1FCF        ; its log
       mov  hl,@nose_vector_log_y                          ; LD ($EB6A),HL     ; 
       mov  @nose_vector_z,hl                              ; LD HL,($F7DE)     ; HL = nose.z
       bl   @log_sign_tagged                               ; CALL $1FCF        ; its log
       mov  hl,@nose_vector_log_z                          ; LD ($EB6C),HL     ; 
       socb @bit4,@object_status_byte                      ; LD HL,$F7CD / SET 4,(HL); set bit 4
       li   de,object_position_x                           ; LD HL,($F7CE)     ; x...
       mov  @nose_vector_logs,bc                           ; LD BC,($EB68)     ; 
       bl   @move_one_coordinate                           ; CALL $86DC / LD ($F7CE),HL; ...+= speed * nose.x
       li   de,object_position_y                           ; LD HL,($F7D0)     ; y...
       mov  @nose_vector_log_y,bc                          ; LD BC,($EB6A)     ; 
       bl   @move_one_coordinate                           ; CALL $86DC / LD ($F7D0),HL; ...+= speed * nose.y
       li   de,object_position_z                           ; LD HL,($F7D2)     ; z...
       mov  @nose_vector_log_z,bc                          ; LD BC,($EB6C)     ; 
       bl   @move_one_coordinate                           ; CALL $86DC / LD ($F7D2),HL; ...+= speed * nose.z
       .endproc                                            ; RET               ; 

********************************************************************************
* Add speed * one component of the axis vector to a coordinate
* 
* Used by the routine at #R$8685.
* .
* 
* I:BC Log of the axis vector component
* I:HL The coordinate
* I:($E874) Log of the speed
* O:HL The new coordinate
* TI: the coordinate is read and written here, through DE, rather than
* passed in HL.
*
* I:BC Log of the axis vector component
* I:DE -> The coordinate
* I:($E874) Log of the speed
move_one_coordinate:                                       ; >86dc
       .proc                                               ;                   ; 
       mov  @type_entry_cache,hl                           ; PUSH HL / LD HL,($E874); HL = log(speed)
       bl   @multiply_logs                                 ; CALL $2160        ; HL = speed * component
       mov  *de,r0                                         ; POP DE            ; R0 = the coordinate
       a    r0,hl                                          ; ADD HL,DE         ; add it
       mov  hl,*de                                         ;                   ; (TI: store it)
       .endproc                                            ; RET               ; 

********************************************************************************
* Update the stardust (several times per frame during a jump)
* 
* Used by the routines at #R$13FD and #R$894D.
* .
* Normally just moves and plots the stardust once (#R$68CD). While a jump
* is in progress (($E722) set by #R$86E6's in-system jump or #R$894D's
* hyperspace sequence) it runs #R$68CD ($E723) times instead, and every
* ($E87C) calls ($E723) goes up by one, to a maximum of 7. Every pass
* moves each particle on and plots it again into the same frame's buffer,
* so the dots turn into streaks that lengthen as the jump builds up.
update_stardust:                                           ; >872e
       .proc                                               ;                   ; 
       movb @jump_in_progress,a                            ; LD A,($E722) / OR A; A = jump-in-progress flag
       jne  _8735                                          ; JP Z,$68CD        ; no jump - move and plot the stardust once
       bl   @move_and_plot_stardust                        ;                   ; 
       jmp  update_stardust_exit                           ;                   ; 
_8735:                                                     ; >8735
       movb @stardust_passes,b                             ; LD A,($E723) / LD B,A; B = the number of passes per frame
       li   hl,stardust_passes_countdown                   ; LD HL,$E87B       ; HL -> the calls-until-next-increase counter
       sb   one,*hl                                        ; DEC (HL)          ; count this call
       jne  _874d                                          ; JR NZ,$874D       ; not time to lengthen the streaks yet
       movb @stardust_passes_interval,*hl                  ; LD A,($E87C) / LD (HL),A; reload the counter
       cb   b,@bytes+>07                                   ; LD A,$07 / CP B   ; already at the maximum of 7 passes?
       jeq  _874d                                          ; JR Z,$874D        ; yes - leave it
       ab   one,b                                          ; INC B             ; no - one more pass per frame from now on
       movb b,@stardust_passes                             ; LD A,B / LD ($E723),A; 
_874d:                                                     ; >874d
       .push bc                                            ; PUSH BC           ; save the pass counter
       bl   @move_and_plot_stardust                        ; CALL $68CD        ; move and plot the stardust
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $874D        ; repeat for each pass
       jne  _874d                                          ;                   ; 
update_stardust_exit:
       .endproc                                            ; RET               ; 

********************************************************************************
* Work out the object's distance
* 
* Used by the routines at #R$13FD, #R$1703 and #R$8C94.
* .
* Stores the size of each of the object's coordinates (#R$F7CE) at $EB82,
* $EB84 and $EB86 (z also at $E941), works out its distance (#R$84A6) and
* stores it in #R$EB8E - and for the planet (ship type $64) in #R$E727, for
* the sun ($65, at $887F) in #R$E725, and for the space station (1, at
* $88A1) in #R$E729. In mission states $32 and $33 (the sun about to go
* supernova, see #R$909F), the sun's distance is first reduced by an amount
* (#R$E93E) that grows by 100 every frame, so the sun gets closer and the
* cabin temperature rises (#R$15CB).
* 
* O:HL The distance
work_out_distance:                                         ; >883d
       .proc                                               ;                   ; 
       mov  @object_position_x,hl                          ; LD HL,($F7CE)     ; HL = x
       abs  hl                                             ; BIT 7,H / ...     ; its size
       movb hl,@delta_x_hi                                 ; LD ($EB82),HL     ; X for #R$84A6
       movb @l,@abs_delta_x                                ;                   ; 
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; HL = y
       abs  hl                                             ; BIT 7,H / ...     ; its size
       movb hl,@delta_y_hi                                 ; LD ($EB84),HL     ; Y for #R$84A6
       movb @l,@abs_delta_y                                ;                   ; 
       mov  @object_position_z,hl                          ; LD HL,($F7D2)     ; HL = z
       abs  hl                                             ; BIT 7,H / ...     ; its size
       movb hl,@delta_z_hi                                 ; LD ($EB86),HL     ; Z for #R$84A6
       movb @l,@abs_delta_z                                ;                   ; 
       movb hl,@object_depth+1                             ; LD ($E941),HL     ; and the depth
       movb @l,@object_depth                               ;                   ; 
       bl   @vector_length                                 ; CALL $84A6        ; HL = the object's distance
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>64                                   ; CP $64            ; the planet?
       jne  sun_distance_supernova                         ; JR NZ,$887F       ; no
       movb hl,@planet_distance+1                          ; LD ($E727),HL     ; yes: the planet's distance
       movb @l,@planet_distance                            ;                   ; 
       jmp  _88a8                                          ; JR $88A8          ; 
sun_distance_supernova:                                    ; >887f
       cb   a,@bytes+>65                                   ; CP $65            ; the sun?
       jne  ship_type_1_case_else_join                     ; JR NZ,$88A1       ; no
       movb @mission_state,a                               ; LD A,($E93D)      ; A = mission state
       cb   a,@bytes+>32                                   ; CP $32            ; 
       jeq  _888e                                          ; JR Z,$888E        ; 
       cb   a,@bytes+>33                                   ; CP $33            ; 
       jne  _889c                                          ; JR NZ,$889C       ; no supernova
_888e:                                                     ; >888e
       movb @supernova_offset+1,de                         ; LD DE,($E93E)     ; DE = the offset
       movb @supernova_offset,@e                           ;                   ; 
       a    de,hl                                          ; ADD HL,DE         ; add it (it's negative)
       li   r0,-100                                        ; LD HL,$FF9C       ; the offset grows by 100 every frame
       a    de,r0                                          ; ADD HL,DE         ; 
       movb r0,@supernova_offset+1                         ; LD ($E93E),HL     ; 
       movb @r0lb,@supernova_offset                        ;                   ; 
_889c:                                                     ; >889c
       movb hl,@sun_distance+1                             ; LD ($E725),HL     ; the sun's distance
       movb @l,@sun_distance                               ;                   ; 
       jmp  _88a8                                          ; JR $88A8          ; 
ship_type_1_case_else_join:                                ; >88a1
       cb   a,one                                          ; CP $01            ; the space station?
       jne  _88a8                                          ; JR NZ,$88A8       ; no
       movb hl,@station_distance+1                         ; LD ($E729),HL     ; yes: the station's distance
       movb @l,@station_distance                           ;                   ; 
_88a8:                                                     ; >88a8
       movb hl,@object_distance+1                          ; LD ($EB8E),HL     ; the object's distance
       movb @l,@object_distance                            ;                   ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Move the object past the player
* 
* Used by the routine at #R$13FD.
* .
* Called for each object by the main loop (#R$13FD). The player's
* movement is done by taking an amount off each object's z (at $8B58),
* remembering it (#R$E876). The space station (ship type 1) moves by the
* same amount as the planet before it, so that they stay together.
* .
* Normally (at $8B4F) the amount is the player's speed (#R$F814), halved
* once for each distance band (#R$8B66).
* .
* During a Torus jump (#R$E918), an object behind the player in distance
* band 5 doesn't move; anything else moves by the jump's speed (at $8B27,
* #R$E878, set to 200 by #R$86E6). The planet (ship type $64) never comes
* closer than 10000: if it would, it moves only as far as that, which
* sets the jump's speed for the rest of the objects, and the jump is cut
* short ($E933, see #R$13FD).
move_past_player:                                          ; >8b00
       .proc                                               ;                   ; 
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,one                                          ; CP $01            ; the space station?
       jne  move_past_player_2                             ; JR NZ,$8B0D       ; no
       movb @last_move+1,de                                ; LD DE,($E876)     ; yes: the same as the planet
       movb @last_move,@e                                  ;                   ; 
       jmp  _8b58                                          ; JR $8B58          ; move it
move_past_player_2:                                        ; >8b0d
       bl   @distance_band                                 ; CALL $8B66        ; A = distance band
       movb a,b                                            ; LD B,A            ; 
       movb @torus_jump_countdown,a                        ; LD A,($E918) / OR A; 
       jeq  move_past_player_normal                        ; JR Z,$8B4F        ; no Torus jump
       movb @object_z_sign,a                               ; LD A,($F7D3) / OR A; 
       jgt  move_past_player_jump                          ; JP P,$8B27        ; in front of the player
       jeq  move_past_player_jump                          ;                   ; 
       cb   b,@bytes+>05                                   ; LD A,B / SUB $05  ; 
       jne  move_past_player_jump                          ; JR NZ,$8B27       ; not band 5
       clr  de                                             ; LD D,A / LD E,A   ; behind, in band 5: don't move
       jmp  _8b58                                          ; JR $8B4D / JR $8B58; 
move_past_player_jump:                                     ; >8b27
       movb @jump_speed+1,de                               ; LD DE,($E878)     ; DE = the jump's speed
       movb @jump_speed,@e                                 ;                   ; 
       movb @ship_type,a                                   ; LD A,($F7E7)      ; 
       cb   a,@bytes+>64                                   ; CP $64            ; the planet?
       jne  _8b58                                          ; JR NZ,$8B4D       ; no
       movb @object_distance+1,hl                          ; LD HL,($EB8E)     ; HL = its distance
       movb @object_distance,@l                            ;                   ; 
       s    de,hl                                          ; OR A / SBC HL,DE  ; after the move...
       ci   hl,>2710                                       ; LD BC,$2710 / OR A / SBC HL,BC; ...10000 or more?
       jhe  _8b58                                          ; JR NC,$8B4D       ; yes - still far enough away
       movb @object_distance+1,hl                          ; LD HL,($EB8E)     ; too close:
       movb @object_distance,@l                            ;                   ; 
       ai   hl,-10000                                      ; OR A / SBC HL,BC  ; HL = distance - 10000
       movb hl,@jump_speed+1                               ; LD ($E878),HL     ; the jump's new speed
       movb @l,@jump_speed                                 ;                   ; 
       mov  hl,de                                          ; EX DE,HL          ; DE = it
       movb a,@secondary_flag_counter_pair                 ; LD ($E933),A      ; cut the jump short
       jmp  _8b58                                          ; JR $8B58          ; move it
move_past_player_normal:                                   ; >8b4f
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = the player's speed
_8b52:                                                     ; >8b52
       srl  a,1                                            ; SRL A             ; halve it...
       sb   one,b                                          ; DJNZ $8B52        ; ...once per band
       jne  _8b52                                          ;                   ; 
       clr  de                                             ; LD E,A / LD D,B   ; DE = the amount
       movb a,@e                                           ;                   ; 
_8b58:                                                     ; >8b58
       movb de,@last_move+1                                ; LD ($E876),DE     ; remember the amount
       movb @e,@last_move                                  ;                   ; 
       mov  @object_position_z,hl                          ; LD HL,($F7D2)     ; HL = z
       s    de,hl                                          ; OR A / SBC HL,DE  ; take the amount off
       mov  hl,@object_position_z                          ; LD ($F7D2),HL     ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Get the object's distance band
* 
* Used by the routines at #R$866D and #R$8B00.
* .
* Returns 1 if the object's depth (#R$E941) is up to 10000, and one more
* for each further 5750. Movement is halved for each band (#R$866D,
* #R$8B00), so distant objects move less.
* 
* O:A Distance band (1 upwards)
distance_band:                                             ; >8b66
       movb @object_depth+1,r1                             ; LD BC,($E941)     ; R1 = depth
       movb @object_depth,@r1lb                            ;                   ; 
       movb one,a                                          ; LD A,$01          ; band 1
       li   r0,>2710                                       ; LD HL,$2710       ; up to 10000
_8b6f:                                                     ; >8b6f
       c    r0,r1                                          ; LD D,H / LD E,L / SBC HL,BC; (TI: as if the carry is clear)
       jhe  _8b66_end                                      ; RET NC            ; within this band
       ai   r0,>1676                                       ; LD HL,$1676 / ADD HL,DE; 5750 more
       ab   one,a                                          ; INC A             ; next band
       jmp  _8b6f                                          ; JR $8B6F          ; 
_8b66_end:                                                 
       rt                                                  ;                   ; 

