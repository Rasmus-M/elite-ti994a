* Transporter: ship-blueprint header
*
* See #R$A817 for the format. 38 vertices, 46 edges.
ship_transporter_header:                                   ; >c2a7
       data ship_transporter_vertices
       data ship_transporter_edges
       data ship_transporter_faces
       data ship_transporter_name
       byte >0E,>2E,>26,>19,>50,>1E,>0C,>01
       byte >27,>10,>09,>00,>00,>32,>00,>00
       byte >0A,>00

* Transporter name text
*
* The message "Transporter".
ship_transporter_name:                                     ; >c2c1
       text 'TRANSPORTE',>f2

* Transporter: vertex array (6 bytes/vertex)
ship_transporter_vertices:                                 ; >c2cc
       byte >FF,>FF,>4A,>0D,>CD,>52,>93,>52
       byte >00,>08,>CD,>52,>3B,>53,>57,>46
       byte >CD,>52,>93,>52,>00,>4C,>CD,>52
       byte >CD,>12,>00,>4C,>CD,>52,>6F,>13
       byte >57,>46,>CD,>52,>CD,>12,>00,>08
       byte >CD,>52,>FF,>FF,>57,>0A,>57,>0E
       byte >A1,>53,>00,>40,>57,>0E,>2D,>54
       byte >00,>4C,>57,>0E,>2D,>14,>00,>4C
       byte >57,>0E,>A1,>13,>00,>40,>57,>0E
       byte >D6,>4D,>00,>44,>A1,>13,>CD,>4E
       byte >00,>4C,>A1,>13,>3B,>0F,>00,>4C
       byte >A1,>13,>D6,>0D,>00,>44,>A1,>13
       byte >4A,>49,>57,>0A,>00,>04,>AE,>50
       byte >57,>06,>00,>04,>4A,>49,>3B,>0B
       byte >3B,>4B,>AE,>50,>00,>08,>3B,>4B
       byte >D6,>4D,>57,>0A,>3B,>4F,>D6,>4D
       byte >4A,>09,>3B,>4B,>4A,>09,>3B,>0B
       byte >3B,>4F,>AE,>10,>00,>08,>3B,>4F
       byte >D6,>0D,>4A,>09,>3B,>4B,>4A,>09
       byte >57,>0A,>57,>46,>AE,>10,>57,>06
       byte >57,>46,>D6,>0D,>00,>08,>00,>0C
       byte >D6,>0D,>4A,>09,>57,>46,>00,>50
       byte >00,>4C,>CD,>4E,>00,>50,>00,>4C
       byte >00,>10,>5A,>10,>00,>4C,>CD,>4E
       byte >5A,>10,>00,>4C,>00,>10,>CD,>4E
       byte >57,>46,>CD,>52,>CD,>0E,>57,>46
       byte >CD,>52,>AE,>0C,>57,>06,>CD,>52
       byte >00,>4C,>57,>06,>CD,>52,>FF,>FF
       byte >00,>44,>A1,>13

