       sb   a,a                                            ; SBC A,A           ; 
       sb   d,a                                            ; SUB D             ; 
       movb a,d                                            ; LD D,A            ; DE = -DE
       .call @draw_circle_point                            ; CALL $3D8C        ; plot quadrant 2: (-DE,BC)
