       ab   one,*hl                                        ; INC (HL)          ; state $31
       movb @bytes+>a1,a                                   ; LD A,$A1          ; 
       b    @colour_space_view                             ; JP $3A4D          ; normal colours

********************************************************************************
* Missions: update the mission state on a hyperspace jump
* 
* Used by the routine at #R$894D.
* .
* Called by #R$894D. In mission 1, state $14 goes back to $13 (on the
* Constrictor's trail, see #R$91AA) and $18 to $17 (the Constrictor
* follows the player to the next system). Mission 3 ends (state 0),
* unless the player has taken the refugees (state $33), when it moves on
* to state $34 (#R$90FB). In mission 4 the Cougar appears again in the
* next system (state $40, see #R$2B24). In mission 5, state $51 becomes
* $52: the system arrived at has been invaded by the Thargoids
* (#R$9220).
mission_on_hyperspace:                                     ; >8ac8
       movb @mission_state,a                               ; LD A,($E93D)      ; A = the state byte
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no mission
       .ret                                                ;                   
!
       cb   a,@bytes+>14                                   ; CP $14            ; 
       jeq  _8ad5                                          ; JR Z,$8AD5        ; 
       cb   a,@bytes+>18                                   ; CP $18            ; 
       jne  _8ada                                          ; JR NZ,$8ADA       ; neither $14 nor $18 - continue below
_8ad5:                                                     ; >8ad5
       sb   one,a                                          ; DEC A             ; $14 -> $13, $18 -> $17
       movb a,@mission_state                               ; LD ($E93D),A      ; 
       .ret                                                ; RET               ; 
_8ada:                                                     ; >8ada
       movb a,@c                                           ; LD C,A            ; C = the full original value
       andi a,>f000                                        ; AND $F0           ; A = mission * 16
       cb   a,@bytes+>30                                   ; CP $30            ; 
       jne  _8aee                                          ; JR NZ,$8AEE       ; not mission 3
       movb @c,a                                           ; LD A,C            ; back to the full value
       cb   a,@bytes+>33                                   ; CP $33            ; 
       jne  _8ae9                                          ; JR NZ,$8AE9       ; 
       ab   one,a                                          ; INC A             ; refugees on board: $33 -> $34
       jmp  _8aea                                          ; JR $8AEA          ; 
_8ae9:                                                     ; >8ae9
       sb   a,a                                            ; XOR A             ; otherwise mission 3 ends
_8aea:                                                     ; >8aea
       movb a,@mission_state                               ; LD ($E93D),A      ; 
       .ret                                                ; RET               ; 
_8aee:                                                     ; >8aee
       cb   a,@bytes+>40                                   ; CP $40            ; still the masked high nibble from above
       jne  _8af6                                          ; JR NZ,$8AF6       ; not mission 4
       movb a,@mission_state                               ; LD ($E93D),A      ; mission 4: back to $40 (the Cougar appears again)
       .ret                                                ; RET               ; 
_8af6:                                                     ; >8af6
       movb @c,a                                           ; LD A,C            ; back to the full original value
       cb   a,@bytes+>51                                   ; CP $51            ; 
       jne  _8aff                                          ; JR NZ,$8AFF       ; 
       ab   one,a                                          ; INC A             ; $51 -> $52: an invaded system
       movb a,@mission_state                               ; LD ($E93D),A      ; 
_8aff:                                                     ; >8aff
       .ret                                                ; RET               ; 

********************************************************************************
* Move the object past the player
* 
* Used by the routine at #R$13FD.
* .
* Called for each object by the main loop (#R$13FD). The player's
* movement is done by taking an amount off each object's z (at $8B58),
* remembering it (#R$E876). The space station (ship type 1) moves by the
* same amount as the planet before it, so that they stay together.
* .
* Normally (at $8B4F) the amount is the player's speed (#R$F814), halved
* once for each distance band (#R$8B66).
* .
* During a Torus jump (#R$E918), an object behind the player in distance
* band 5 doesn't move; anything else moves by the jump's speed (at $8B27,
* #R$E878, set to 200 by #R$86E6). The planet (ship type $64) never comes
* closer than 10000: if it would, it moves only as far as that, which
* sets the jump's speed for the rest of the objects, and the jump is cut
* short ($E933, see #R$13FD).
move_past_player:                                          ; >8b00
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,one                                          ; CP $01            ; is it 1?
       jne  move_past_player_2                             ; JR NZ,$8B0D       ; not the station
       mov  @last_move,de                                  ; LD DE,($E876)     ; the same as the planet
       jmp  _8b58                                          ; JR $8B58          ; move it
move_past_player_2:                                        ; >8b0d
       .call @distance_band                                ; CALL $8B66        ; A = distance band
       movb a,b                                            ; LD B,A            ; 
       movb @torus_jump_countdown,a                        ; LD A,($E918)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  move_past_player_normal                        ; JR Z,$8B4F        ; no Torus jump
       movb @object_z_sign,a                               ; LD A,($F7D3)      ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$8B27        ; in front of the player
       b    @move_past_player_jump                         ;                   
!
       movb b,a                                            ; LD A,B            ; 
       sb   @bytes+>05,a                                   ; SUB $05           ; 
       jne  move_past_player_jump                          ; JR NZ,$8B27       ; not band 5
       movb a,d                                            ; LD D,A            ; behind, in band 5: don't move
       movb a,@e                                           ; LD E,A            ; 
       jmp  _8b4d                                          ; JR $8B4D          ; 
move_past_player_jump:                                     ; >8b27
       mov  @jump_speed,de                                 ; LD DE,($E878)     ; DE = the jump's speed
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>64                                   ; CP $64            ; is it $64 (100)?
       jne  _8b4d                                          ; JR NZ,$8B4D       ; not the planet
       mov  @object_distance,hl                            ; LD HL,($EB8E)     ; HL = its distance
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; 
       li   bc,>2710                                       ; LD BC,$2710       ; BC = 10000
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; minus 10000
       jnc  _8b4d                                          ; JR NC,$8B4D       ; TODO: check code. still far enough away
       mov  @object_distance,hl                            ; LD HL,($EB8E)     ; too close:
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; HL = distance - 10000
       mov  hl,@jump_speed                                 ; LD ($E878),HL     ; the jump's new speed
       .ex_de_hl                                           ; EX DE,HL          ; DE = it
       movb a,@secondary_flag_counter_pair                 ; LD ($E933),A      ; cut the jump short
_8b4d:                                                     ; >8b4d
       jmp  _8b58                                          ; JR $8B58          ; move it
move_past_player_normal:                                   ; >8b4f
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = the player's speed
_8b52:                                                     ; >8b52
       srl  a,1                                            ; SRL A             ; halve it...
       sb   one,b                                          ; DJNZ $8B52        ; ...once per band
       jne  _8b52                                          ;                   
       movb a,@e                                           ; LD E,A            ; DE = the amount
       movb b,d                                            ; LD D,B            ; (B is 0)
_8b58:                                                     ; >8b58
       mov  de,@last_move                                  ; LD ($E876),DE     ; remember the amount
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; HL = z
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; take the amount off
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Get the object's distance band
* 
* Used by the routines at #R$866D and #R$8B00.
* .
* Returns 1 if the object's depth (#R$E941) is up to 10000, and one more
* for each further 5750. Movement is halved for each band (#R$866D,
* #R$8B00), so distant objects move less.
* 
* O:A Distance band (1 upwards)
distance_band:                                             ; >8b66
       mov  @object_depth,bc                               ; LD BC,($E941)     ; BC = depth
       movb one,a                                          ; LD A,$01          ; band 1
       li   hl,>2710                                       ; LD HL,$2710       ; up to 10000
_8b6f:                                                     ; >8b6f
       movb h,d                                            ; LD D,H            ; 
       movb @l,@e                                          ; LD E,L            ; 
       s    bc,hl                                          ; SBC HL,BC         ; 
       joc  !                                              ; RET NC            ; TODO: check code. within this band
       .ret                                                ;                   
!
       li   hl,>1676                                       ; LD HL,$1676       ; 5750 more
       a    de,hl                                          ; ADD HL,DE         ; 
       ab   one,a                                          ; INC A             ; next band
       jmp  _8b6f                                          ; JR $8B6F          ; 

********************************************************************************
* Stop the ship
* 
* Used by the routines at #R$86E6 and #R$894D.
* .
* Brings the speed (#R$F814) down to 0 one step at a time (#R$699C),
* without redrawing the speed gauge each time (#R$E92B); $8B8A turns the
* redrawing back on. Used for hyperspace (#R$894D) and the Torus Jump Drive
* (#R$86E6).
stop_ship:                                                 ; >8b7b
       sb   a,a                                            ; XOR A             ; 
       movb a,@redraw_speed_gauge                          ; LD ($E92B),A      ; don't redraw the speed gauge
_8b7f:                                                     ; >8b7f
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = speed
       socb a,a                                            ; OR A              ; 
       jeq  stop_ship_2                                    ; JR Z,$8B8A        ; stopped
       .call @speed_down                                   ; CALL $699C        ; slow down
       jmp  _8b7f                                          ; JR $8B7F          ; 
stop_ship_2:                                               ; >8b8a
       li   hl,redraw_speed_gauge                          ; LD HL,$E92B       ; HL -> the frame counter
       sb   one,*hl                                        ; DEC (HL)          ; redraw the speed gauge again
       .ret                                                ; RET               ; 

********************************************************************************
* Restore the speed after a Torus jump
* 
* Used by the routine at #R$13FD.
* .
* Called by the main loop (#R$13FD) when the jump ends. Brings the speed
* (#R$F814) back up to what it was before the jump (#R$E87A) one step at a
* time (#R$6956), without redrawing the speed gauge each time (#R$E92B);
* $8BA1 turns the redrawing back on.
restore_speed:                                             ; >8b8f
       sb   a,a                                            ; XOR A             ; 
       movb a,@redraw_speed_gauge                          ; LD ($E92B),A      ; don't redraw the speed gauge
_8b93:                                                     ; >8b93
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = speed
       li   hl,cached_f814_at_engage                       ; LD HL,$E87A       ; the speed before the jump
       cb   a,*hl                                          ; CP (HL)           ; reached it?
       jeq  restore_speed_2                                ; JR Z,$8BA1        ; back to it
       .call @speed_up                                     ; CALL $6956        ; speed up
       jmp  _8b93                                          ; JR $8B93          ; and recheck
restore_speed_2:                                           ; >8ba1
       li   hl,redraw_speed_gauge                          ; LD HL,$E92B       ; HL -> the frame counter
       sb   one,*hl                                        ; DEC (HL)          ; redraw the speed gauge again
       .ret                                                ; RET               ; 

********************************************************************************
* Scoop an object
* 
* Used by the routine at #R$8755.
* .
* Part of #R$8755, for a cargo canister, escape capsule or Thargon. It's
* scooped if fuel scoops are fitted (#R$F77B) and it's in front of the ship
* and below it (the signs of its Z and Y coordinates): if its cargo type
* (#R$F7EC) is negative it's the cloaking device ($F784, from the Cougar,
* see #R$8DB9), otherwise 1-4 units of that cargo ($8BC7).
* .
* At $8BC7, takes on a random 1-4 units of cargo type A - fewer if the hold
* hasn't room for them (#R$63BA, #R$63E0), none if it has no room at all.
* .
* At $8BF9, adds C units of the cargo to the hold (#R$EB19) and announces
* it by name. The entry at $8C2F announces the message at HL, removes the
* object (#R$30A9) and plays the scooping sound.
* 
* O:F Carry set if it has been scooped
scoop_object:                                              ; >8ba6
       movb @item_fuel_scoop,a                             ; LD A,($F77B)      ; A = a flag at $F77B
       socb a,a                                            ; OR A              ; test it
       jne  !                                              ; RET Z             ; no fuel scoops
       .ret                                                ;                   
!
       movb @object_z_sign,a                               ; LD A,($F7D3)      ; A = the position's Z sign byte (see #R$87DD)
       socb a,a                                            ; OR A              ; test its sign
       jhe  !                                              ; RET M             ; behind the ship
       .ret                                                ;                   
!
       movb @position_y_hi,a                               ; LD A,($F7D1)      ; A = sign of its Y coordinate
       socb a,a                                            ; OR A              ; test its sign
       jlt  !                                              ; RET P             ; above the ship
       .ret                                                ;                   
!
       movb @cargo_type,a                                  ; LD A,($F7EC)      ; A = its cargo type
       socb a,a                                            ; OR A              ; test its sign
       jlt  !                                              ; JP P,$8BC7        ; ordinary cargo
       b    @scoop_cargo                                   ;                   
!
       movb one,a                                          ; LD A,$01          ; negative: A = 1
       movb a,@cloaking_device_fitted                      ; LD ($F784),A      ; the cloaking device
       li   hl,msg_cloaking_device_8c85                    ; LD HL,$8C85       ; "Cloaking device"
       b    @scoop_announce                                ; JP $8C2F          ; announce it
scoop_cargo:                                               ; >8bc7
       ab   a,a                                            ; ADD A,A           ; A = the item's type field * 4
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,market_units                                ; LD HL,$F78B       ; the per-type record table
       a    de,hl                                          ; ADD HL,DE         ; HL -> this type's record
       movb *hl,a                                          ; LD A,(HL)         ; 
       .call @unit_size                                    ; CALL $639C        ; HL -> its per-type data
       mov  hl,@call_scoped_hl_cache_word                  ; LD ($E87D),HL     ; cache it
       movb r,a                                            ; LD A,R            ; A = a random byte
       andi a,>0300                                        ; AND $03           ; 
       ab   one,a                                          ; INC A             ; C = a random quantity, 1-4
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
_8bdf:                                                     ; >8bdf
       .push bc                                            ; PUSH BC           ; 
       .push bc                                            ; PUSH BC           ; 
       .call @work_out_free_space                          ; CALL $63BA        ; recompute the hold's free space
       .pop bc                                             ; POP BC            ; 
       mov  @call_scoped_hl_cache_word,hl                  ; LD HL,($E87D)     ; 
       .call @take_off_free_space                          ; CALL $63E0        ; check for room for this many units
       .pop bc                                             ; POP BC            ; 
       movb @free_space_hi,a                               ; LD A,($EB64)      ; A = the resulting overflow flag
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$8BF9        ; fits - add it to the hold
       b    @scoop_into_hold                               ;                   
!
       dec  bc                                             ; DEC BC            ; doesn't fit - one fewer unit
       movb b,a                                            ; LD A,B            ; 
       socb @c,a                                           ; OR C              ; 
       jne  _8bdf                                          ; JR NZ,$8BDF       ; still some left to try - retry
       .ret                                                ; RET               ; none fit at all - give up
scoop_into_hold:                                           ; >8bf9
       movb @c,a                                           ; LD A,C            ; A = the quantity that fit
       .push af                                            ; PUSH AF           ; 
       movb @cargo_type,a                                  ; LD A,($F7EC)      ; A = the dropped item's type
       ab   a,a                                            ; ADD A,A           ; *4
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,cargo_hold                                  ; LD HL,$EB19       ; the cargo-hold table
       a    de,hl                                          ; ADD HL,DE         ; HL -> this type's slot
       .ex_de_hl                                           ; EX DE,HL          ; 
_8c08:                                                     ; >8c08
       .push de                                            ; PUSH DE           ; 
       mov  @call_scoped_hl_cache_word,hl                  ; LD HL,($E87D)     ; the per-type data
       .call @add_4byte_de_hl                              ; CALL $21C4        ; grow the hold by one unit
       .pop de                                             ; POP DE            ; 
       sb   one,@c                                         ; DEC C             ; 
       jne  _8c08                                          ; JR NZ,$8C08       ; repeat for each unit
       movb @cargo_type,a                                  ; LD A,($F7EC)      ; 
       ab   a,a                                            ; ADD A,A           ; *4
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@ixl                                         ; LD IXL,A          ; 
       sb   ixh,ixh                                        ; LD IXH,$00        ; 
       li   de,market                                      ; LD DE,$F789       ; the per-item value table
       a    de,ix                                          ; ADD IX,DE         ; IX -> this item's record
       .pop af                                             ; POP AF            ; A = the quantity picked up
       .call @illegal_goods                                ; CALL $63AA        ; accumulate into the type-specific total
       movb @cargo_type,a                                  ; LD A,($F7EC)      ; 
       li   hl,msg_food                                    ; LD HL,$0D9F       ; the item-name list
       .call @skip_tokenised_strings_advancing_hl_past     ; CALL $358D        ; build the pickup message, naming the item
scoop_announce:                                            ; >8c2f
       .call @show_view_message                            ; CALL $39C8        ; display it
       .call @remove_object                                ; CALL $30A9        ; remove the object
       movb @bytes+>0d,a                                   ; LD A,$0D          ; 
       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 13 (cargo scooped)
       ; SCF                                               ; SCF               ; TODO: check code. scooped
       .ret                                                ; RET               ; 

********************************************************************************
* The message "Select System!"
msg_select_system:                                         ; >8c3c
       text 'SELECT SYSTEM',>a1

********************************************************************************
* The message "Beyond Range!"
msg_beyond_range:                                          ; >8c4a
       text 'BEYOND RANGE',>a1

********************************************************************************
* The message "Hyperdrive Engaged"
msg_hyperdrive_engaged:                                    ; >8c57
       text 'HYPERDRIVE ENGAGE',>e4

********************************************************************************
* The message "Fuel Leak!"
msg_fuel_leak:                                             ; >8c69
       text 'FUEL LEAK',>a1

********************************************************************************
* The message "Drive malfunction!"
msg_drive_malfunction:                                     ; >8c73
       text 'DRIVE MALFUNCTION',>a1

********************************************************************************
* The message "Cloaking device"
msg_cloaking_device_8c85:                                  ; >8c85
       text 'CLOAKING DEVIC',>e5

********************************************************************************
* Place the planet, the space station and the sun
* 
* Used by the routine at #R$894D.
* .
* Clears the object table (#R$28D4). Puts the planet (ship type $64,
* handler type 0, speed 0) in slot 0, $5FB4 (about 24500) from the player
* in a random direction (#R$8F25), picking again until its z is at least
* $1D4C. At $8CB1, the space station (ship type 1, handler type 2) goes
* $1D4C (about 7500) from the planet in a random direction, pointing at it
* (#R$8D8E), picking again while it's closer to the player than $5FB4
* (#R$883D). The sun (ship type $65) goes opposite the station, at minus
* its position. Ship types $64 and $65 are drawn as a circle (#R$3D0E) and
* a filled disc (#R$3DF4) by #R$4A86.
place_planet_station_sun:                                  ; >8c94
       .call @clear_all_ship_slots                         ; CALL $28D4        ; clear the ship-object table
       movb @bytes+>0d,a                                   ; LD A,$0D          ; status: in use, can't be shot, no collisions
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
_8c9c:                                                     ; >8c9c
       li   hl,>5fb4                                       ; LD HL,$5FB4       ; HL = the candidate radius
       ; SCF                                               ; SCF               ; TODO: check code. in any direction
       .call @random_point                                 ; CALL $8F25        ; HL:... = a random point of that magnitude
       czc  @bit7,h                                        ; BIT 7,H           ; is it on the disallowed side?
       jne  _8caf                                          ; JR NZ,$8CAF       ; yes - reroll
       li   de,>e2b4                                       ; LD DE,$E2B4       ; a negative bias (~-$1D4C)
       a    de,hl                                          ; ADC HL,DE         ; is |HL| big enough to stay positive after biasing?
       jlt  !                                              ; JP P,$8CB1        ; yes - accept it, place the sun and system
       b    @place_planet_station_and_sun                  ;                   
!
_8caf:                                                     ; >8caf
       jmp  _8c9c                                          ; JR $8C9C          ; no - reroll
place_planet_station_and_sun:                              ; >8cb1
       sb   a,a                                            ; LD A,$00          ; handler type 0
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       movb @bytes+>64,a                                   ; LD A,$64          ; ship type 100 (the planet)
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed 0
       .call @add_object                                   ; CALL $3037        ; spawn the planet (slot 0)
       movb one,a                                          ; LD A,$01          ; status: in use
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
_8cc7:                                                     ; >8cc7
       li   hl,>1d4c                                       ; LD HL,$1D4C       ; HL = the candidate offset radius
       ; SCF                                               ; SCF               ; TODO: check code. in any direction
       .call @random_point                                 ; CALL $8F25        ; HL:... = a random offset of that magnitude
       .call @point_at_player                              ; CALL $8D8E        ; point it at the planet
       mov  @planet_position,bc                            ; LD BC,($EBA1)     ; BC = the planet's X (table slot 0)
       mov  @object_position_x,hl                          ; LD HL,($F7CE)     ; 
       a    bc,hl                                          ; ADD HL,BC         ; offset the candidate by the planet's position...
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; 
       mov  @planet_position_y,bc                          ; LD BC,($EBA3)     ; ...and Y...
       mov  @object_position_y,hl                          ; LD HL,($F7D0)     ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; 
       mov  @planet_position_z,bc                          ; LD BC,($EBA5)     ; ...and Z
       mov  @object_position_z_lo,hl                       ; LD HL,($F7D2)     ; 
       a    bc,hl                                          ; ADD HL,BC         ; 
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; 
       .call @work_out_distance                            ; CALL $883D        ; work out its distance
       li   de,>5fb4                                       ; LD DE,$5FB4       ; at least $5FB4 from the player?
       s    de,hl                                          ; SBC HL,DE         ; 
       joc  _8cc7                                          ; JR C,$8CC7        ; TODO: check code. too close - reroll
       movb one,a                                          ; LD A,$01          ; ship type 1...
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; ...type 2
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       .call @add_object                                   ; CALL $3037        ; spawn the space station
       movb @bytes+>0d,a                                   ; LD A,$0D          ; status: in use, can't be shot, no collisions
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       li   hl,object_position_x                           ; LD HL,$F7CE       ; negate the position (3 words) in place...
       movb @bytes+>03,b                                   ; LD B,$03          ; 
_8d13:                                                     ; >8d13
       sb   a,a                                            ; XOR A             ; 
       sb   *hl,a                                          ; SUB (HL)          ; 
       movb a,*hl                                          ; LD (HL),A         ; 
       inc  hl                                             ; INC HL            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   *hl,a                                          ; SUB (HL)          ; 
       movb a,*hl                                          ; LD (HL),A         ; 
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $8D13        ; ...to put the sun on the opposite side
       jne  _8d13                                          ;                   
       sb   a,a                                            ; LD A,$00          ; handler type 0
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       movb @bytes+>65,a                                   ; LD A,$65          ; ship type 101 (the sun)
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       b    @add_object                                    ; JP $3037          ; spawn the sun

********************************************************************************
* Launch from the station: place the planet, station and sun
* 
* Used by the routine at #R$1837.
* .
* Called when launching (#R$1837). Clears the object table (#R$28D4) and
* adds (#R$3037), at speed 0 and with handler types 0, 2 and 0:
* .
* #LIST
* { the planet (ship type $64) in slot 0, 7000 straight ahead }
* { the space station (ship type 1) in slot 1, 500 behind the player, 7500
* from the planet as on arriving in a system (#R$8CB1), facing forward
* (#R$9080), so the player has just come out of its slot }
* { the sun (ship type $65) in slot 2, 24500 away, somewhere beside, above
* or below the player (#R$8F25 with carry clear) }
* LIST#
* .
* The planet and sun can't be shot and don't collide (status $0D, see
* #R$F7CD); the station can (status 1).
launch_place_planet_station_and_sun:                       ; >8d2a
       .call @clear_all_ship_slots                         ; CALL $28D4        ; clear the object table
       movb @bytes+>0d,a                                   ; LD A,$0D          ; status: in use, can't be shot, no collisions
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       li   hl,>0000                                       ; LD HL,$0000       ; x = 0, y = 0...
       mov  hl,@object_position_x                          ; LD ($F7CE),HL     ; 
       mov  hl,@object_position_y                          ; LD ($F7D0),HL     ; 
       li   hl,>1b58                                       ; LD HL,$1B58       ; ...z = 7000: straight ahead
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; 
       sb   a,a                                            ; LD A,$00          ; handler type 0
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       movb @bytes+>64,a                                   ; LD A,$64          ; ship type $64: the planet
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       sb   a,a                                            ; XOR A             ; 
       movb a,@object_speed                                ; LD ($F7E6),A      ; speed 0
       .call @add_object                                   ; CALL $3037        ; add the planet (slot 0)
       movb one,a                                          ; LD A,$01          ; status: in use
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       li   hl,>fe0c                                       ; LD HL,$FE0C       ; z = -500: just behind the player
       mov  hl,@object_position_z_lo                       ; LD ($F7D2),HL     ; 
       li   hl,station_launch_orientation                  ; LD HL,$9080       ; the station's orientation at launch...
       li   de,side_vector                                 ; LD DE,$F7D4       ; ...into its side and nose vectors
       li   bc,>000c                                       ; LD BC,$000C       ; 
       .ldir                                               ; LDIR              ; 
       movb one,a                                          ; LD A,$01          ; ship type 1: the station
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; handler type 2: space station
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       .call @add_object                                   ; CALL $3037        ; add the station (slot 1)
       movb @bytes+>0d,a                                   ; LD A,$0D          ; status: in use, can't be shot, no collisions
       movb a,@object_status_byte                          ; LD ($F7CD),A      ; 
       li   hl,>5fb4                                       ; LD HL,$5FB4       ; 24500 away...
       socb a,a                                            ; OR A              ; ...beside, above or below the player
       .call @random_point                                 ; CALL $8F25        ; pick a random point
       sb   a,a                                            ; LD A,$00          ; handler type 0
       movb a,@handler_type                                ; LD ($F7EE),A      ; 
       movb @bytes+>65,a                                   ; LD A,$65          ; ship type $65: the sun
       movb a,@ship_type                                   ; LD ($F7E7),A      ; 
       b    @add_object                                    ; JP $3037          ; add the sun (slot 2)

********************************************************************************
* Point the object at the player
* 
* Used by the routines at #R$2B05, #R$2C3C and #R$8C94.
* .
* Sets the nose vector (#R$F7DA) to minus the object's position (#R$F7CE),
* in sign-magnitude form - negative components become positive magnitudes,
* and positive ones get the sign bit ($8DAD) - and works out the rest of
* the orientation from it (#R$8E62). Used for asteroids (#R$2B24) and
* pirates (#R$2C3C); and for the space station (#R$8CB1), whose position at
* that point is its offset from the planet, so that it points at the
* planet.
* .
* At $8DAD, makes a positive component negative; at $8DAF, stores it and
* moves on to the next.
point_at_player:                                           ; >8d8e
       li   hl,object_position_x                           ; LD HL,$F7CE       ; the position
       li   de,nose_vector                                 ; LD DE,$F7DA       ; to the nose vector
       li   bc,>0006                                       ; LD BC,$0006       ; 6 bytes
       .ldir                                               ; LDIR              ; 
       li   hl,nose_vector                                 ; LD HL,$F7DA       ; 
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 components
_8d9e:                                                     ; >8d9e
       movb *hl,@e                                         ; LD E,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; 
       movb d,a                                            ; LD A,D            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$8DAD        ; positive
       b    @point_at_player_2                             ;                   
!
       sb   a,a                                            ; XOR A             ; negative: make it positive
       sb   @e,a                                           ; SUB E             ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   d,a                                            ; SUB D             ; 
       jmp  _8daf                                          ; JR $8DAF          ; 
point_at_player_2:                                         ; >8dad
       socb @bytes+>80,a                                   ; OR $80            ; make it negative
_8daf:                                                     ; >8daf
       movb a,*hl                                          ; LD (HL),A         ; 
       dec  hl                                             ; DEC HL            ; 
       movb @e,*hl                                         ; LD (HL),E         ; store the low byte
       inc  hl                                             ; INC HL            ; 
       inc  hl                                             ; INC HL            ; -> the next word
       sb   one,b                                          ; DJNZ $8D9E        ; next component
       jne  _8d9e                                          ;                   
       b    @orientation_from_nose                         ; JP $8E62          ; work out the rest of the orientation

********************************************************************************
* Spawn the cargo of a destroyed ship
* 
* Used by the routines at #R$25B9 and #R$28F6.
* .
* Called when a ship is destroyed (#R$25FF, #R$291E), with IX pointing at
* its object record. Byte $14 of the ship's blueprint ($F809, see #R$A817)
* gives the cargo: its low nibble the most cargo canisters that can appear
* (a random number from 0 up to that, at most 7), its high nibble the cargo
* type. $FF means just one canister (the Cougar's, holding the cloaking
* device). An asteroid (ship type 4) breaks into platlets (ship type 7)
* instead. Each canister's cargo type (#R$F7EC) is the ship's (with a
* 27/256 chance of a random one instead), except that cargo type 15 from
* the blueprint becomes $FF - the cloaking device (see #R$8BA6). The pieces
* fly apart from the ship's position in random directions (#R$8E45) at
* speed $FF, as handler type 9 (spin, fly on and leave).
* .
* At $8DCA, picks how many pieces there are. At $8E33, picks a random cargo
* type.
* .
* At $8E37, turns cargo type 15 into $FF, the cloaking device. At $8E38,
* gives the piece its cargo type and adds it to the object table.
* 
* I:IX Pointer to the destroyed ship's object record
spawn_cargo:                                               ; >8db9
       movb @bp_cargo,a                                    ; LD A,($F809)      ; A = the ship's cargo byte
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; no cargo
       .ret                                                ;                   
!
       .call @save_working_object_to_scratch               ; CALL $3341        ; save the working object
       movb a,@c                                           ; LD C,A            ; 
       cb   a,@b255                                        ; CP $FF            ; the Cougar?
       jne  spawn_cargo_2                                  ; JR NZ,$8DCA       ; no - roll an actual pack size
       movb one,a                                          ; LD A,$01          ; one canister
       jmp  _8dd9                                          ; JR $8DD9          ; 
spawn_cargo_2:                                             ; >8dca
       andi a,>0f00                                        ; AND $0F           ; A = the most canisters
       movb a,b                                            ; LD B,A            ; B = that limit
_8dcd:                                                     ; >8dcd
       .call @random_byte                                  ; CALL $2176        ; A = a random byte
       andi a,>0700                                        ; AND $07           ; A = 0-7
       cb   a,b                                            ; CP B              ; 
       jeq  _8dd7                                          ; JR Z,$8DD7        ; yes - use it
       jnc  _8dcd                                          ; JR NC,$8DCD       ; TODO: check code. too many - pick again
_8dd7:                                                     ; >8dd7
