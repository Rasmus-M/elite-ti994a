********************************************************************************
* Scratch buffer
* 
* Used for different things at different times: #R$34A8 shifts a character's
* pattern here before printing it; #R$3DF4 and #R$3EAD keep the filled disc's
* ragged edge here ($E600-$E604); and #R$8205 and #R$8F25 use the first few
* bytes too. It is also the start of the vertex cache (#R$E61D).
scratch_buffer:                                            ; >e600
       byte >FA                                                      ; 
scratch_buffer_1:                                          ; >e601
       byte >FF                                                      ; 

********************************************************************************
* Reused 16-byte scratch buffer, $E600-$E60F
* 
* Remainder of #R$E600's buffer - see that entry's own comment.
lineplot_scratch_vars_e603:                                ; >e603
       byte >00                                                      ; 
scratch_buffer_4:                                          ; >e604
       byte >FB                                                      ; 
scratch_buffer_5:                                          ; >e605
       byte >FF,>02,>00,>FB,>FF,>FF                                  ; 
       byte >FF,>FD,>FF,>FF,>FF

********************************************************************************
* Vertex cache: address of the slot being written
* 
* The high byte is always $E6 (#R$422E); #R$49FD sets the low byte to 4 * the
* vertex number.
vertex_cache_slot:                                         ; >e6c8
       byte >14                                                      ; 
vertex_cache_slot_hi:                                      ; >e6c9
       byte >E6                                                      ; 

********************************************************************************
* Logarithms of the side vector
* 
* The x, y and z of the object's side vector (#R$F7D4) as sign-tagged
* logarithms (#R$1FCF), cached by #R$433F for #R$4464.
side_vector_logs:                                          ; >e6cc
       data >2000                                                    ; 
side_vector_log_y:                                         ; >e6ce
       data >ffff                                                    ; 
side_vector_log_z:                                         ; >e6d0
       data >ffff                                                    ; 

********************************************************************************
* Logarithms of the roof vector
* 
* The x, y and z of the object's roof vector (#R$F7E0) as sign-tagged
* logarithms (#R$1FCF), cached by #R$433F for #R$4464.
roof_vector_logs:                                          ; >e6d2
       data >ffff                                                    ; 
roof_vector_log_y:                                         ; >e6d4
       data >2000                                                    ; 
roof_vector_log_z:                                         ; >e6d6
       data >ffff                                                    ; 

********************************************************************************
* Object's position in the view: x
* 
* Set by #R$422E (at $4255) from the object's position, converted to the
* current view (#R$44E5).
view_x:                                                    ; >e6d8
       data >0000

********************************************************************************
* Object's position in the view: z * 2
* 
* Twice #R$E6DC, set by #R$422E (at $4255) and #R$43C2: the depth that #R$44D2
* adds to a vertex and #R$46CA projects with.
view_z2:                                                   ; >e6da
       data >0180

********************************************************************************
* Object's position in the view: z
* 
* Set by #R$422E (at $4255); negative if the object is behind the player.
view_z:                                                    ; >e6dc
       data >00C0

********************************************************************************
* Explosion: random table pointer
* 
* Where #R$47A1 reads the next pair of random numbers for an explosion's dots,
* set by #R$4AEC.
explosion_random_pointer:                                  ; >e6de
       data >0000

********************************************************************************
* On-screen check: left edge
* 
* The object's x on screen minus its radius, biased by $8000, worked out by
* #R$4A99.
on_screen_left:                                            ; >e6e0
       byte >FC,>7F

********************************************************************************
* On-screen check: right edge
* 
* The object's x on screen plus its radius, biased by $8000, worked out by
* #R$4A99.
on_screen_right:                                           ; >e6e2
       byte >04,>80

********************************************************************************
* On-screen check: top edge
* 
* The object's y on screen plus its radius, biased by $8000, worked out by
* #R$4A99.
on_screen_top:                                             ; >e6e4
       byte >04,>80

********************************************************************************
* On-screen check: bottom edge
* 
* The object's y on screen minus its radius, biased by $8000, worked out by
* #R$4A99.
on_screen_bottom:                                          ; >e6e6
       byte >FC,>7F

********************************************************************************
* Face visibility: workspace
* 
* A sign-magnitude value #R$4873 keeps while it works out the dot product.
face_visible_workspace_1:                                  ; >e6ea
       data >0000

********************************************************************************
* Face visibility: more workspace
* 
* Another sign-magnitude value #R$4873 keeps while it works out the dot
* product.
face_visible_workspace_2:                                  ; >e6ec
       data >0000

********************************************************************************
* Number of edges skipped
* 
* #R$491A adds 1 for each edge it skips because the edge's first vertex has
* bit 7 set (at $4948), and takes 1 off when the edge turns up again in
* another face (at $4962). Nothing reads it otherwise, so it has no effect.
skipped_edges_count:                                       ; >e6ee
       byte >00

********************************************************************************
* Object's targetable area on the screen
* 
* The object's targetable area (#R$F800) projected by #R$46CA: how close to
* the centre of the view its x and y must be for it to be in the laser sights.
* #R$46CA writes it as a word, so the high byte (always 0) goes into #R$E6F0.
targetable_area:                                           ; >e6ef
       byte >00

********************************************************************************
* Vector-cache-valid flag
* 
* Cleared by #R$422E alongside #R$E6F3, set by #R$433F once it
* refreshes the cached vectors at $EB68-$EB6C, and checked by
* #R$43C2's redraw gate before deciding whether to call #R$433F again.
vector_cache_valid_flag:                                   ; >e6f0
       byte >00

********************************************************************************
* Logarithm of the object's depth
* 
* Set by #R$46CA and #R$47C4, for projecting (#R$47F0).
log_depth:                                                 ; >e6f1
       data >1E57

********************************************************************************
* "Nothing changed" flag (redraw gate)
* 
* Cleared and, separately, set to $FF by #R$422E (to mark the current
* frame's projection as unchanged, skipping #R$4255); read by #R$43C2's
* redraw gate, which bails out early if this is already set. Within
* the same "nothing moved this frame" mechanism as #R$E92D.
nothing_changed_flag:                                      ; >e6f3
       byte >00

********************************************************************************
* Pixel bit-mask table
* 
* 8 single-bit masks, $80 down to $01 - one bit set per byte-position
* within a screen byte. Copied from $1187 at startup (see #R$7045's
* step 4). #R$3C48/#R$3CFD's line-drawing code looks this up via IX
* (see #R$372B/#R$4D4D/#R$4DEA), indexed by a coordinate's low 3 bits
* via a self-modified operand at $3D07.
pixel_bitmask_table:                                       ; >e700
       byte >80,>40,>20,>10,>08,>04,>02,>01

********************************************************************************
* Chart cursor on
* 
* Set ($FF) by #R$4D6C (entering the $E902=4 screen) and #R$501E, a
* mid-block entry in #R$5014's routine (entering the $E902=6 screen);
* cleared by #R$6097 (leaving
* either screen for another) and #R$63F1 (returning to flight). Gates
* #R$73BA - called from #R$7202's VBLANK handler only on frames where
* neither ($E91B) nor ($EF9E) is set (see #R$7202's own header) - so
* the #R$E708/#R$E709/#R$E70A cursor-nudge mechanism only runs on
* those gated frames, and is a no-op whenever this flag is clear.
chart_cursor_active_flag:                                  ; >e70b
       byte >00

********************************************************************************
* Unused counter
* 
* Cleared by #R$3548, and incremented and decremented again around printing a
* system's label (#R$50CE); nothing reads it.
unused_counter_e70d:                                       ; >e70d
       byte >00

********************************************************************************
* Cursor position: sub-pixel bit offset (0-7)
* 
* The low 3 bits of #R$3548's (set_cursor_position) B*6 stride (or
* #R$3564's (set_cursor_position_combined) A*6); read back by #R$34A8
* to shift a glyph's pixels before plotting it - see that routine's
* header comment.
cursor_subpixel_offset:                                    ; >e70e
       byte >00

********************************************************************************
* Text cursor: column
* 
* Text is printed in 6-pixel-wide characters, 42 to a line. This and
* #R$E710 form the address in the pattern table to print the next
* character at: the column * 6 rounded down to a multiple of 8, with the
* remaining pixels in $E70E. Set by #R$3548 and #R$3564.
cursor_vram_addr:                                          ; >e70f
       byte >00

********************************************************************************
* Text cursor column
* 
* Stashed (unscaled) by #R$3548/#R$3564 when the cursor position is
* set, then incremented by #R$34A8's glyph-plot tail after each
* character; read back at $3609/$3623/$3650 to step the cursor back
* the column that a plot just advanced it by (undoing the auto-
* advance for a redraw/erase pass).
cursor_column:                                             ; >e72c
       byte >00

********************************************************************************
* Saved stack pointer while clearing the space view
* 
* #R$388F clears the space view by pushing zeroes, and keeps the real SP here
* meanwhile.
clear_view_saved_sp:                                       ; >e732
       data >A7CF

********************************************************************************
* Space view message: address
* 
* The message #R$39C8 shows in the space view, which #R$39F1 draws (at $3A03)
* each frame while it is showing.
view_message_address:                                      ; >e735
       data >1eeb

********************************************************************************
* Space view message: column
* 
* The column #R$39C8 works out for the message, centring it in the space view.
view_message_column:                                       ; >e737
       byte >04

********************************************************************************
* Tunnel ring radii
* 
* The radii of the three rings #R$6CB2 draws.
tunnel_ring_radii:                                         ; >e776
       byte >00                                                      ; 
tunnel_ring_radius_2:                                      ; >e777
       byte >00                                                      ; 
tunnel_ring_radius_3:                                      ; >e778
       byte >00                                                      ; 

********************************************************************************
* Stardust rotation: log of the cosine
* 
* Saved by #R$66DC (#R$1FCF).
stardust_log_cos:                                          ; >e779
       data >0000

********************************************************************************
* Stardust rotation: log of the sine
* 
* Saved by #R$66DC (#R$1FCF).
stardust_log_sin:                                          ; >e77b
       data >0000

********************************************************************************
* Stardust rotation: log of the particle's X
* 
* Saved by #R$66DC for each particle.
stardust_log_x:                                            ; >e77d
       data >0000

********************************************************************************
* Stardust rotation: log of the particle's Y
* 
* Saved by #R$66DC for each particle.
stardust_log_y:                                            ; >e77f
       data >0000

********************************************************************************
* Vertices already projected
* 
* One byte for each of the object's vertices, cleared by #R$422E before
* drawing it and set (via IY) once the vertex has been projected, so that each
* vertex is projected only once.
vertex_flags:                                              ; >e784
       byte >FF,>FF,>FF,>FF,>FF,>FF,>FF,>FF
       byte >FF,>FF,>FF,>FF,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00

********************************************************************************
* Edges already drawn
* 
* One byte for each of the object's edges, cleared by #R$422E before drawing
* it and set (via IX) once the edge has been drawn, so that an edge shared by
* two visible faces is drawn only once.
edge_flags:                                                ; >e7b6
       byte >01,>01,>01,>01,>01,>01,>01,>01
       byte >01,>01,>01,>01,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00

********************************************************************************
* Face's scale
* 
* The scale byte of the face being drawn (#R$4255): how far its plane is
* from the ship's centre along its normal. Used by #R$4847, with its bit
* length in #R$E7E9.
face_scale:                                                ; >e7e8
       byte >00

********************************************************************************
* Face's scale: bit length
* 
* The number of bits in #R$E7E8 (from the table at #R$0200).
face_scale_bits:                                           ; >e7e9
       byte >00

********************************************************************************
* Vector being rotated into the view
* 
* The x, y and z (words) of the vector #R$4464 rotates into the view: a face's
* normal (copied by #R$422E), or a vertex (copied by #R$49FD and #R$4A5C).
* #R$4873 keeps the rotated normal here.
rotated_vector:                                            ; >e7ea
       data >4A57                                                    ; 
rotated_vector_y:                                          ; >e7ec
       data >4D4A                                                    ; 
rotated_vector_z:                                          ; >e7ee
       data >ffff                                                    ; 

********************************************************************************
* Rotation record for pitching and rolling an object
* 
* The cosine and sine (3 bytes each, see #R$24A7) of the angle by which
* #R$2365 pitches or #R$23D9 rolls the object, set up by #R$21DA.
pitch_roll_rotation:                                       ; >e7fc
       byte >F5,>6C,>37,>00,>00,>A0

********************************************************************************
* Multiply by sine or cosine: workspace
* 
* Used by #R$24A7 and #R$24D1.
multiply_trig_workspace:                                   ; >e804
       data >376A

********************************************************************************
* Circle: first step
* 
* Nonzero while #R$3D0E or #R$3DF4 works out the first point of each quadrant,
* when there is nothing to join it to yet.
circle_first_step:                                         ; >e80c
       byte >00

********************************************************************************
* Circle: the previous step's points
* 
* The point #R$3D8C last worked out in each of the four quadrants, as (y, x)
* word pairs filled downwards from $E81D, so that the next point can be joined
* to it. #R$3DF4 uses the first two bytes for the previous step's (cos, sin)
* pair.
circle_previous_points:                                    ; >e80d
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00                                          ; 
circle_previous_points_top:                                ; >e819
       byte >00,>00,>00,>00                                          ; 

********************************************************************************
* Circle: saved stack pointer
* 
* #R$3D8C reads and writes the points in #R$E80D with the stack pointer, and
* keeps the real one here meanwhile.
circle_saved_sp:                                           ; >e81d
       data >0000

********************************************************************************
* Circle: centre x
* 
* Set by #R$3D0E and #R$3DF4.
circle_centre_x:                                           ; >e81f
       data >0000

********************************************************************************
* Circle: centre y
* 
* Set by #R$3D0E and #R$3DF4.
circle_centre_y:                                           ; >e821
       data >0000

********************************************************************************
* Filled disc: half-width of the row
* 
* Set by #R$3EAD for the row being filled.
disc_row_half_width:                                       ; >e823
       byte >00

********************************************************************************
* Filled disc: row offset
* 
* Set by #R$3EAD for the row being filled, which is drawn this far above and
* below the centre. Only the low byte is written; the high byte stays 0.
disc_row_offset:                                           ; >e824
       data >0000

********************************************************************************
* Line clipping: bisection counter
* 
* Counts down the (up to 16) bisections #R$3AC2 makes looking for a point
* inside the space view.
clip_bisection_count:                                      ; >e826
       byte >00

********************************************************************************
* Line clipping: reference point x
* 
* The point inside the space view that #R$3AC2 and #R$3BE0 bisect towards when
* moving a point to the edge.
clip_reference_x:                                          ; >e827
       data >0000

********************************************************************************
* Line clipping: reference point y
* 
* See #R$E827.
clip_reference_y:                                          ; >e829
       data >0000

********************************************************************************
* Number of objects of each ship type
* 
* How many objects of each ship type (#R$F7E7) there are about: counted
* up by #R$3037 and down by #R$30A9, and cleared by #R$28D4. Used to limit
* the ships the game spawns (#R$2B05) and the police it launches
* (#R$291E), and by #R$3359.
ship_type_counts:                                          ; >e844
       byte >00                                                      ; $00: (none)
       byte >00                                                      ; $01: Space Station
num_missiles:                                              ; >e846
       byte >00                                                      ; $02: Missile
       byte >00                                                      ; $03: Cargo Canister
num_asteroids:                                             ; >e848
       byte >00                                                      ; $04: Asteroid
       byte >00                                                      ; $05: Escape Capsule
       byte >00                                                      ; $06: Thargon
       byte >00                                                      ; $07: Platlet
       byte >02                                                      ; $08: letter E (title screen)
       byte >01                                                      ; $09: letter L (title screen)
       byte >01                                                      ; $0A: letter I (title screen)
       byte >01                                                      ; $0B: letter T (title screen)
num_vipers:                                                ; >e850
       byte >00                                                      ; $0C: Viper
       byte >00                                                      ; $0D: Fer-De-Lance
       byte >00                                                      ; $0E: Cobra MkIII
       byte >00                                                      ; $0F: Python
       byte >00                                                      ; $10: Anaconda
       byte >00                                                      ; $11: Cobra MK1
       byte >00                                                      ; $12: Krait
num_thargoids:                                             ; >e857
       byte >00                                                      ; $13: Thargoid
       byte >00                                                      ; $14: Boa Class Cruiser
       byte >00                                                      ; $15: Gecko
       byte >00                                                      ; $16: Moray Star Boat
       byte >00                                                      ; $17: Adder
       byte >00                                                      ; $18: Mamba
       byte >00                                                      ; $19: Asp MkII
       byte >00                                                      ; $1A: Sidewinder
       byte >00                                                      ; $1B: Wolf MkII
num_orbit_shuttles:                                        ; >e860
       byte >00                                                      ; $1C: Orbit Shuttle
num_transporters:                                          ; >e861
       byte >00                                                      ; $1D: Transporter
       byte >00                                                      ; $1E: Cougar
       byte >00                                                      ; $1F: Constrictor

********************************************************************************
* Title screen ship's wobble angles and targets
* 
* $E884 and $E885 are the two angles #R$1D3D turns the title screen ship
* by each frame (halved, via #R$2365 and #R$23D9); $E886 and $E887 are the
* targets #R$1DDC swings them towards.
title_wobble:                                              ; >e884
       byte >00                                                      ; 
title_wobble_angle_2:                                      ; >e885
       byte >00                                                      ; 
title_wobble_target_1:                                     ; >e886
       byte >00                                                      ; 
title_wobble_target_2:                                     ; >e887
       byte >00                                                      ; 

********************************************************************************
* Title screen ship's fly-in distance (word)
* 
* Set by #R$1C5C from the ship's size ((($F805) * 64) / 44); #R$1D3D
* moves the ship in until it's this far away.
title_ship_distance:                                       ; >e888
       byte >00,>00

********************************************************************************
* Title screen ship arrived flag
* 
* Cleared by #R$1C5C for each ship, and set by #R$1D3D once the ship has
* flown in to #R$E888.
title_ship_arrived:                                        ; >e88a
       byte >00

********************************************************************************
* Title screen ship's frame countdown
* 
* Set to 150 by #R$1C5C for each ship and counted down by #R$1D3D; when
* it reaches 0 the ship flies off (#R$E88C). Not counted for a mission
* briefing.
title_ship_frames:                                         ; >e88b
       byte >00

********************************************************************************
* Title screen ship flying-off flag
* 
* Set by #R$1D3D when #R$E88B runs out. #R$1C5C then moves the ship away
* by 200 each frame until it's out of sight (($EB9E) below 5), and shows
* the next ship.
title_ship_flying_off:                                     ; >e88c
       byte >00

********************************************************************************
* Title screen: slot of the letter being added (word)
* 
* Set by #R$1E01 (at $1E3D) to the object-table slot of the letter just
* added, so that #R$1E5A can move that letter differently from the rest.
title_letter_slot:                                         ; >e88e
       data >EC40

********************************************************************************
* Title screen: pointer to the next ship in the list (word)
* 
* Set by #R$1C5C to the start of #R$1F40 (or #R$1F4F for a mission
* briefing) and advanced past each ship as it's shown.
title_ship_ptr:                                            ; >e890
       data >0000

********************************************************************************
* Title screen: letter-being-added flag
* 
* Set by #R$1E01 while it's adding the "ELITE" letters one by one, and
* cleared (#R$1E48) once all five are in.
title_letter_being_added:                                  ; >e892
       byte >00

********************************************************************************
* Pending debounced keypress byte [status]
* 
* Holds the last debounced key code, with zero doing double duty as
* "no key pending yet." #R$35E7's key-wait primitive blocks on it
* (`HALT` loop until nonzero), then clears it and returns the value it
* just read as A - the actual key code #R$3631 and friends then act on
* (`CP $0D`/`CP $1B`/`CP $7F`, or store it as a typed character). Set
* by #R$349B's key-scan work (via #R$3465). #R$1EB3 also polls and
* clears it directly, discarding any pending key rather than waiting,
* if one arrived before the message finished displaying.
pending_debounced_keypress_byte_status:                    ; >e8f5
       byte >00

********************************************************************************
* Show the tunnel rings
* 
* Set by #R$1837 while it switches to the front view on launching, so
* that #R$645B shows the tunnel rings (#R$6CB2).
show_tunnel:                                               ; >e8f6
       byte >00

********************************************************************************
* Current screen
* 
* 0 none (a space view), 1 Data on System (#R$6189), 2 market prices
* (#R$5B99), 3 status page (#R$6276), 4 galactic chart (#R$4D0B), 5
* cargo (#R$5C8E), 6 local chart (#R$4F64). #R$88AC checks it so that
* 'H' on a chart jumps to the system under the cursor.
current_screen:                                            ; >e902
       byte >90

********************************************************************************
* Space view showing
* 
* Set when one of the space views is showing (#R$63F1), with the
* dashboard, and cleared when another screen replaces it (#R$60B1). The
* main loop (#R$13FD) only draws the space view and the scanner while
* it's set, and the gauges are only drawn then (#R$6C9E).
space_view_showing:                                        ; >e903
       byte >04

********************************************************************************
* Docked
* 
* Set when the player docks (#R$1873) and at the start of a game
* (#R$1C5C), and cleared on launching (#R$707D) and in the death scene
* (#R$1703). While it's set the main loop (#R$0106) doesn't run the
* per-frame pass (#R$13FD), and keys like '1' and '2' (#R$4173,
* #R$417D) do their docked jobs; #R$6DCF and #R$6393 check it for the
* commands that only work in flight or only when docked.
docked:                                                    ; >e90a
       byte >FF

********************************************************************************
* Alert level
* 
* 0-2, set each frame by #R$15E7, and shown on the status page (#R$6276)
* as the condition: "Green", "Red" or "Red", in green or red - flashing
* (#R$72C1) while it's nonzero. At level 2 the alarm sounds (#R$7202).
alert_level:                                               ; >e90c
       byte >01

********************************************************************************
* Missile state
* 
* 0 unarmed, 1 armed ('T', #R$2D58), 2 locked on to a target (#R$4735,
* #R$E928). Fired with 'M' (#R$2D7E) when locked; 'U' (#R$2D70) cancels
* it. Shown by the missile indicator (#R$6B6E).
missile_state:                                             ; >e910
       byte >47

********************************************************************************
* Current object slot
* 
* The number of the object-table slot (#R$EBA0) whose object the main
* loop (#R$13FD) is processing.
current_slot:                                              ; >e911
       byte >22

********************************************************************************
* ECM countdown
* 
* Set to $78 (120) by the ECM sound effect (#R$7815) when the player's
* ECM or an enemy's is set off, and counted down on every VBlank by
* #R$7202, stopping at -1. While it's running the ECM is on (#R$323C) and
* the "E" indicator is shown (#R$6B12); #R$3294 clears it once it has
* finished.
ecm_countdown:                                             ; >e912
       byte >EF

********************************************************************************
* Alert status-hook toggle
* 
* XOR $30'd by #R$72C1 when the alert-flash countdown (#R$E90D)
* expires under its gated conditions, then passed as E to #R$35B8
* (with HL=$31B3, BC=$0403) - see #R$E90D's description.
e913_status_toggle:                                        ; >e913
       byte >00

********************************************************************************
* Options
* 
* Set with keys while the game is frozen (#R$40DE):
* .
* #TABLE
* { =h Bit | =h Key | =h Effect when set }
* { 0 | S/Q | Sound effects on (#R$7468) }
* { 1 | D | Roll and pitch stop when the keys are released (#R$6BFE) }
* { 2 | R | Roll and pitch stop first when reversed (#R$6A15) }
* { 3 | B | Reverse roll and pitch (#R$40A6) }
* { 4 | Y | Reverse pitch (#R$40A6) }
* { 5 | F | The scanner's blips are drawn on alternate frames (#R$8205),
* and the speed indicator flashes above speed 26 (#R$72C1) }
* { 6 | M | Muted: 'S' and 'Q' have no effect }
* TABLE#
* .
* Saved in the commander file (#R$A551).
options:                                                   ; >e914
       byte >00

********************************************************************************
* Message timer
* 
* Started at $8A by #R$39C8 ($9E by #R$1A8A). While it's negative the
* message is drawn in the space view (#R$3A03), for 10 frames (or 30);
* then it's set to 25 and counts
* down to 0 (#R$39F1), during which #R$39E9 won't show another message.
message_timer:                                             ; >e919
       byte >89

********************************************************************************
* Radius of the tunnel ring being drawn
* 
* Set by #R$6CB2 for each ring it draws, and used by sound effect 7's handler
* (#R$77FB) to make the sound follow the rings.
tunnel_ring_radius:                                        ; >e921
       byte >E5,>00

********************************************************************************
* Tunnel rings finished
* 
* Cleared by sound effect 7 (#R$77EE) and set by #R$6CB2 when it has finished
* drawing the rings, which ends the effect (#R$77FB).
tunnel_rings_finished:                                     ; >e923
       byte >00

********************************************************************************
* Load a new commander from the title screen
* 
* Set by #R$1DB5 when the player answers 'Y' to "Load New Commander";
* the commander menu (#R$A31D) then goes straight to option '1', and
* clears it.
load_new_commander:                                        ; >e924
       byte >00

********************************************************************************
* Missile target
* 
* The slot number (#R$E911) of the object the player's missile is locked
* on to (#R$4735). #R$2D7E gives it to the missile when it's fired
* (#R$F7EF).
missile_target:                                            ; >e928
       byte >00

********************************************************************************
* Redraw the speed gauge
* 
* While it's 0, #R$6A59 doesn't redraw the speed gauge. Cleared while the
* speed is changed in a loop (#R$8B7B, #R$8B8F), and set to $FF again
* afterwards (#R$8B8A, #R$8BA1) and at startup (#R$7045).
redraw_speed_gauge:                                        ; >e92b
       byte >FF

********************************************************************************
* Message row
* 
* The page of the space view's bitmap buffer that messages are drawn into
* (#R$3A03): $E4 for the bottom of the view (the usual), $D6 for the top
* (the title screen's ship names, #R$1C5C).
message_row:                                               ; >e92c
       byte >E4

********************************************************************************
* Next turn number
* 
* The turn number (#R$F7ED) given to the next object added to the object
* table (#R$3037), which cycles it 1, 2, 3, 1...
next_turn_number:                                          ; >e92f
       byte >01

********************************************************************************
* PRNG state (3 bytes)
* 
* #R$2176's (random_byte) own 3-byte shift-register state - see that
* routine's header. Seeded at startup from the Z80 refresh register R
* (#R$7045 step 6).
prng_state:                                                ; >e936
       byte >21                                                      ; 
rng_state_2:                                               ; >e937
       byte >BE                                                      ; 
rng_state_3:                                               ; >e938
       byte >AE                                                      ; 

********************************************************************************
* Number of pirates
* 
* How many pirates (class 4, see #R$A817) there are about: counted by
* #R$3090 and #R$30D7. Limits the pirates #R$2B24 spawns to 2 at a time.
pirate_count:                                              ; >e939
       byte >00

********************************************************************************
* Number of traders
* 
* How many traders (class 0, see #R$A817) there are about: counted by
* #R$3037 and #R$30A9. #R$2B24 only spawns a trader when there are
* none.
trader_count:                                              ; >e93a
       byte >05

********************************************************************************
* Mission state
* 
* The high nibble is the mission number, the low nibble its progress (0
* is no mission). #R$908C starts the next mission every 64 hyperspace
* jumps while there's none under way.
* .
* #TABLE
* { =h State | =h Meaning }
* { $10 | Mission 1: the Constrictor briefing, on docking
* (#R$9120) }
* { $11 | Go to the navy research centre (#R$EFA2, #R$9190) }
* { $12 | The Constrictor has made a galactic jump; follow it
* (#R$894D) }
* { $13/$14 | Follow its trail through five systems (#R$91AA) }
* { $15 | Dock at the last system on the trail (#R$1896) }
* { $16 | "There's a mean, nasty, vicious ship out there!" (#R$6189);
* on launching, $17 (#R$1837) }
* { $17 | The Constrictor appears (#R$2B24): $18 }
* { $18 | Destroying the Constrictor (#R$291E): $19 }
* { $19 | The reward, on docking (#R$91F0) }
* { $20 | Mission 2: the Thargoid documents briefing, on docking
* (#R$9120) }
* { $21 | Carrying the documents to the naval base (#R$EFA2); Thargoids
* come instead of pirates (#R$2C3C), and after every Torus jump
* (#R$13FD); delivered on docking there (#R$91DB) }
* { $30 | Mission 3: "Fuel Leak" on arriving in a system (#R$894D) }
* { $31 | The supernova briefing, on docking (#R$909F) }
* { $32 | Refugees refused; the sun is approaching (#R$887F) }
* { $33 | Refugees on board; the sun is approaching }
* { $34 | Refugees delivered, on docking in the next system
* (#R$90FB) }
* { $40 | Mission 4: the Cougar appears, with Asp MkII escorts (#R$2B24):
* $41; ends when the Cougar has gone (#R$30D7) }
* { $50 | Mission 5: the Thargoid base briefing, on docking
* (#R$9220) }
* { $51 | Go to the next system }
* { $52 | The system has been invaded by the Thargoids; destroy its space
* station (#R$291E) }
* { $53 | The reward, on docking (#R$920F) }
* TABLE#
* .
* #R$8AC8 changes the state on each hyperspace jump.
mission_state:                                             ; >e93d
       byte >C3

********************************************************************************
* Search-cascade gate flag
* 
* #R$6D24's own header names this: "unless ($E940) is set" it skips
* the bit-index search below and falls straight to its tail. Written
* within #R$1C5C (at $1C6B), #R$1DB5 (at $1DC5) and #R$9120 (at $912B).
e940_gate_flag:                                            ; >e940
       byte >00

********************************************************************************
* Number of scanner blips drawn last frame
* 
* Set by #R$8380 from #R$E948; #R$834D restores nothing if it's 0.
scanner_drawn_count:                                       ; >e949
       byte >00

********************************************************************************
* Space station in range flag / compass target
* 
* 1 while the ship is inside the space station's safe zone - within 9000
* of the planet - and 0 otherwise; set and cleared by #R$1549/#R$156D.
* It is also the object-table slot number of the compass target (#R$85FB):
* slot 0 is the planet and slot 1 the space station, so the compass
* tracks the station while it's in range, as the manual describes. Shown
* on the console as the "S" indicator (#R$6ADC). The docking computer
* ('C', #R$1692) only works while it's set, and #R$2B24's hostile-ship
* countdown only runs while it's clear.
station_in_range:                                          ; >eb05
       byte >00

********************************************************************************
* Nose vector, as logarithms
* 
* The object's nose vector (#R$F7DA) as sign-tagged logarithms, cached by
* #R$433F for #R$4464.
nose_vector_logs:                                          ; >eb68
       byte >FF,>FF                                                  ; 
nose_vector_log_y:                                         ; >eb6a
       byte >FF,>FF                                                  ; 
nose_vector_log_z:                                         ; >eb6c
       byte >00,>20                                                  ; 

********************************************************************************
* Live roll-rotation coefficient table
* 
* #R$2209 refreshes this from the roll rate at $F815 via #R$21DA (signed rate
* -> 6-byte cos/sin coefficient record copy); #R$22C0 consumes it to rotate ($F7CE,$F7D4,$F7DA) - see
* #R$221B's own header (its pitch-table sibling) for the full
* rotation mechanism.
live_roll_coeff_table:                                     ; >eb76
       byte >E9                                                      ; 
roll_cos:                                                  ; >eb77
       byte >21,>0C,>6F                                              ; 
roll_sin:                                                  ; >eb7a
       byte >00,>00                                                  ; 

********************************************************************************
* Live pitch-rotation coefficient table
* 
* #R$2212 refreshes this from the pitch rate at $F816 via the same
* #R$21DA lookup-and-copy; #R$221B (step_pitch_rotation)
* consumes it - see that routine's own header for the full mechanism
* and the (F7CE,F7D0,F7D2)-style vector pairing it documents.
live_pitch_coeff_table:                                    ; >eb7c
       byte >00                                                      ; 
pitch_cos:                                                 ; >eb7d
       byte >00,>00,>00                                              ; 
pitch_sin:                                                 ; >eb80
       byte >00,>00                                                  ; 

********************************************************************************
* Distance of the object being processed (word)
* 
* The working object's distance from the player (#R$84A6), stored on
* every path through #R$883D/#R$88A1 (`LD ($EB8E),HL` at $88A8). Read back
* by #R$8755 (threshold-compared against $F805), #R$8205's own
* header, #R$27F4/#R$2A3A (top-nibble-tested via the high byte alone),
* and within #R$46CA (at $46D5) and #R$8B00 (at $8B32/$8B40).
object_distance:                                           ; >eb8e
       byte >00                                                      ; 
object_distance_hi:                                        ; >eb8f
       byte >00                                                      ; 

********************************************************************************
* Pointer input for $47A1's per-entry loop (word)
* 
* #R$4AEC (set up and run #R$47A1's per-entry loop) copies a 2-byte
* table entry here (page $0800+, indexed by ($F7F0)) via two LDIs;
* #R$47A1 consumes it through #R$2160 - see #R$4AEC's own header for
* the full mechanism.
perentry_loop_pointer:                                     ; >eb90
       data >0100

********************************************************************************
* Clip point 1: column (X)
* 
* #R$3AC2's "point 1" X (paired with #R$EB94's Y). #R$3AC2 sign-flips
* and outcode-tests this pair alongside #R$EB96/#R$EB98, then (if not
* trivially inside/outside) falls through to boundary-clipping code
* that can overwrite it with a computed intersection point before
* #R$3C29 converts both pairs to screen space and draws. Note:
* #R$3C29's own I: block calls this same pair "the second endpoint" -
* the file has two conflicting numbering conventions for this pair;
* this block follows #R$3AC2's (5 callers, vs. #R$3C29's 2). Also
* reused as a general scale/quantize output slot by several callers of
* #R$47C4/#R$4B22 outside the clipper itself (#R$442A, #R$4A99's
* callers, #R$496D's cluster).
clip_point1_x:                                             ; >eb92
       byte >FA                                                      ; 
clip_point1_x_hi:                                          ; >eb93
       byte >7F                                                      ; 

********************************************************************************
* Clip point 1: row (Y)
* 
* Paired with #R$EB92 - see its description.
clip_point1_y:                                             ; >eb94
       byte >FE                                                      ; 
clip_point1_y_hi:                                          ; >eb95
       byte >7F                                                      ; 

********************************************************************************
* Clip point 2: column (X)
* 
* #R$3AC2's "point 2" X (paired with #R$EB98's Y) - #R$3C29's I: block
* calls this same pair "the first endpoint"; see #R$EB92's description
* for the numbering conflict.
clip_point2_x:                                             ; >eb96
       byte >FA                                                      ; 
clip_point2_x_hi:                                          ; >eb97
       byte >7F                                                      ; 

********************************************************************************
* Clip point 2: row (Y)
* 
* Paired with #R$EB96 - see its description.
clip_point2_y:                                             ; >eb98
       byte >02                                                      ; 
clip_point2_y_hi:                                          ; >eb99
       byte >80                                                      ; 

********************************************************************************
* Current view
* 
* Which space view is showing: 0 front, 1 rear, 2 left, 3 right. Set by
* #R$645B when the player switches view (and to $FF when the cockpit screen
* is set up, so that the next view always counts as a change). Selects the
* stardust's roll and pitch handlers (#R$67A8), the rear view's handling of
* particles reaching the centre (#R$6915), and the mount whose laser is
* used (#R$6D24).
current_view:                                              ; >eb9a
       byte >00

********************************************************************************
* Depth's shift
* 
* How far the depth was shifted down before its logarithm was taken
* (#R$46CA, #R$47C4); coordinates are shifted likewise when projected
* (#R$47F0).
depth_shift:                                               ; >eb9b
       byte >01

********************************************************************************
* Shared normalization mantissa
* 
* Reused scratch, paired with #R$EB9B: #R$3D0E (and #R$3DF4) cache the
* reduced 8-bit mantissa here for #R$3D76 (scale_by_trig_byte) to
* multiply against; also written directly by a couple of other sites
* ($4FEA, $5149) unrelated to that pairing.
shared_normalize_mantissa:                                 ; >eb9c
       byte >00

********************************************************************************
* Radius on screen
* 
* The object's size (#R$F805), or the planet's or sun's radius,
* projected (#R$46CA, #R$4714); used to check whether it's on screen
* (#R$4A99) and whether to draw it small (#R$4255, #R$4A86).
screen_radius:                                             ; >eb9e
       byte >04,>00

********************************************************************************
* Ship/object table: 20 slots, 40-byte stride
* 
* #TABLE
* { =h Offset | =h Field }
* { $00 | #R$F7CD - status: bit 0 in use, bit 2 can't be shot (#R$4735), bit 3 no collisions (#R$8755) - both set for the planet, the sun and explosions - bit 5 hostile, bit 6 no bounty }
* { $01-$02 | #R$F7CE - Position X (word) }
* { $03-$04 | #R$F7D0 - Position Y (word) }
* { $05 | #R$F7D2 - Position Z, low byte }
* { $06 | #R$F7D3 - Position Z, high byte/sign }
* { $07-$0C | #R$F7D4 - side vector: X/Y/Z words }
* { $0D-$12 | #R$F7DA - nose vector: X/Y/Z words }
* { $13-$18 | #R$F7E0 - roof vector (nose x side): X/Y/Z words }
* { $19 | #R$F7E6 - speed, seeded from blueprint header +$0D }
* { $1A | #R$F7E7 - current ship type }
* { $1B | #R$F7E8 - rotations since the orientation was straightened out }
* { $1C | #R$F7E9 - energy, from byte $0C of the blueprint }
* { $1D | #R$F7EA - missiles, from byte $13 of the blueprint }
* { $1E | #R$F7EB - a Thargon's Thargoid's slot }
* { $1F | #R$F7EC - cargo type, if scooped }
* { $20 | #R$F7ED - turn number (1-3) }
* { $21 | #R$F7EE - handler type (see #R$288D) }
* { $22 | #R$F7EF - the handler's countdown, or a missile's target }
* { $23-$27 | #R$F7F0 - per-type parameter block: for the ship handler types, the two turn-away phases' (countdown, rate) pairs, the next handler type, and the speed-up flag - see its own header for other types }
* TABLE#
* .
* #R$28D4 clears all 20 slots (800 bytes). #R$13FD (at $1450) walks them,
* copying each active slot's record to #R$F7CD to work on it and back
* again, and #R$3037 (at $3016) processes each slot in place. The fields
* are described in full at #R$F7CD and the entries after it.
ship_object_table:                                         ; >eba0
       byte >81                                                      ; 
planet_position:                                           ; >eba1
       byte >E2,>FF                                                  ; 
planet_position_y:                                         ; >eba3
       byte >00,>00                                                  ; 
planet_position_z:                                         ; >eba5
       byte >C0,>00,>00                                              ; 
       byte >40,>00,>00,>00,>00,>00,>00,>08
       byte >00,>01,>40,>00,>00,>01,>40,>08
       byte >80,>00,>08,>30,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >81                                                      ; 
station_position:                                          ; >ebc9
       byte >F1,>FF,>00,>00,>C0,>00,>00                              ; 
       byte >40,>00,>00,>00,>00,>00,>00,>08
       byte >00,>01,>40,>00,>00,>01,>40,>08
       byte >80,>00,>09,>48,>00,>00,>00,>00
       byte >01,>00,>00,>00,>00,>00,>00,>00
       byte >81,>00,>00,>00,>00,>B9,>00,>00
       byte >40,>00,>00,>00,>00,>00,>00,>07
       byte >20,>6A,>37,>00,>00,>6A,>37,>07
       byte >A0,>00,>0A,>5F,>00,>00,>00,>00
       byte >02,>00,>00,>00,>00,>00,>00,>00
object_slot_3:                                             ; >ec18
       byte >81,>0F,>00,>00,>00,>B9,>00,>00
