*********************************************************************
*
* Copy one character row of the space view buffer to the VDP
* (the inner loop of copy_space_view). Copied to scratchpad at
* copy_space_view_row_pad, where it runs without wait states.
*
* HL: Buffer address of the row's first character, advanced past it
* B: Number of characters (MSB)
* R2: VDPWD
*
copy_space_view_row:
       movb *hl,*r2
       movb @>20(hl),*r2
       movb @>40(hl),*r2
       movb @>60(hl),*r2
       movb @>80(hl),*r2
       movb @>a0(hl),*r2
       movb @>c0(hl),*r2
       movb @>e0(hl),*r2
       inc  hl
       sb   one,b
       jne  copy_space_view_row
       rt
copy_space_view_row_end:
       equ  $

*********************************************************************
*
* Clear the space view buffer's rows (the loop of clear_space_view).
* Copied to scratchpad at clear_space_view_rows_pad.
*
* HL: Buffer address of the first row
* R0: Number of rows
*
clear_space_view_rows:
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       clr  *hl+
       ai   hl,10                      ; Skip the other 10 bytes of the row
       dec  r0
       jne  clear_space_view_rows
       rt
clear_space_view_rows_end:
       equ  $

*********************************************************************
*
* The pixel loops of the line drawing (setup_bresenham_line), copied to
* scratchpad at line_loops_pad. The rotate instructions and the plot
* operations are patched there.
*
* HL: Buffer address   R0 (MSB): Error term   R1 (MSB): Pixel mask
* R2: Column step (+1/-1)   B: Pixel count   D: dy   E: dx
*
line_loops:                             ; The shallow loop
       srl  r1,1                       ; Rotate the pixel mask (patched)
       movb r1,r1
       jne  line_shallow_error_term    ; No byte boundary crossed
       mov  @line_mask_wrap,r1         ; The mask wraps round...
       a    r2,hl                      ; ...and the pointer steps a byte
line_shallow_error_term:
       sb   d,r0                       ; Error term -= dy
       joc  line_shallow_plot          ; Still non-negative - no row step
       ab   @e,r0                      ; Add dx back...
       ai   hl,>20                     ; ...and step a row
line_shallow_plot:
       movb *hl,a
line_shallow_plot_op:
       socb r1,a                       ; OR in the pixel (patched to XOR)
       movb a,*hl
       sb   one,b
       jne  line_loops
       .ret
line_steep_loop:
       ai   hl,>20                     ; Step a row (every pixel)
       sb   @e,r0                      ; Error term -= dx
       joc  line_steep_plot            ; Still non-negative - no column step
       ab   d,r0                       ; Add dy back
line_steep_rotate:
       srl  r1,1                       ; Rotate the pixel mask (patched)
       movb r1,r1
       jne  line_steep_plot            ; No byte boundary crossed
       mov  @line_mask_wrap,r1         ; The mask wraps round...
       a    r2,hl                      ; ...and the pointer steps a byte
line_steep_plot:
       movb *hl,a
line_steep_plot_op:
       socb r1,a                       ; OR in the pixel (patched to XOR)
       movb a,*hl
       sb   one,b
       jne  line_steep_loop
       .ret
line_loops_end:
       equ  $
* The loops' entry points and patched instructions in scratchpad
line_shallow_rotate_pad:
       equ  line_loops_pad
line_shallow_plot_op_pad:
       equ  line_loops_pad+line_shallow_plot_op-line_loops
line_steep_loop_pad:
       equ  line_loops_pad+line_steep_loop-line_loops
line_steep_rotate_pad:
       equ  line_loops_pad+line_steep_rotate-line_loops
line_steep_plot_op_pad:
       equ  line_loops_pad+line_steep_plot_op-line_loops

*********************************************************************
*
* VDP Single Byte Multiple Write
*
* R0: Write address in VDP RAM
* R1: MSB of R1 sent to VDP RAM
* R2: Number of bytes to write to VDP RAM
*
vsmw:
       swpb r0
       movb  r0,@vdpwa                 ; Send low byte of VDP RAM write address
       swpb r0
       ori  r0,>4000                   ; Set read/write bits 14 and 15 to write (01)
       movb r0,@vdpwa                  ; Send high byte of VDP RAM write address
       li   r0,vdpwd
vsmw_1:
       movb r1,*r0                     ; Write byte to VDP RAM
       dec  r2                         ; Byte counter
       jne  vsmw_1
       rt
*// vsmw

