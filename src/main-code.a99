********************************************************************************
* Draw an explosion: the next dot's offset
* 
* Used by the routine at #R$4AEC.
* .
* Part of #R$4AEC. Multiplies the next two words of the random table (at
* ($E6DE)) by the explosion's size (#R$EB90), as logarithms (#R$2160).
* 
* O:DE,BC,HL x, y and 0
explosion_dot:                                             ; >47a1
       .proc
       mov  @explosion_random_pointer,hl                   ; LD HL,($E6DE)     ; HL -> the next random number (#R$EEC6)
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,b                                          ; LD B,(HL)         ; BC = the first
       inc  hl                                             ; INC HL            ; 
       .push hl                                            ; PUSH HL           ; save the pointer
       mov  @perentry_loop_pointer,hl                      ; LD HL,($EB90)     ; HL = the explosion's size (as a logarithm)
       bl   @multiply_logs                                 ; CALL $2160        ; HL = the first * the size (#R$2160)
       .ex_sp_hl                                           ; EX (SP),HL        ; save it, HL = the pointer
       movb *hl,@c                                         ; LD C,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,b                                          ; LD B,(HL)         ; BC = the second
       inc  hl                                             ; INC HL            ; 
       mov  hl,@explosion_random_pointer                   ; LD ($E6DE),HL     ; save the pointer for the next dot
       mov  @perentry_loop_pointer,hl                      ; LD HL,($EB90)     ; 
       bl   @multiply_logs                                 ; CALL $2160        ; HL = the second * the size
       movb h,b                                            ; LD B,H            ; BC = y
       movb @l,@c                                          ; LD C,L            ; 
       .pop de                                             ; POP DE            ; DE = x
       li   hl,>0000                                       ; LD HL,$0000       ; HL = z = 0
       .endproc                                            ; RET               ; 

********************************************************************************
* Project a point
* 
* Used by the routines at #R$422E, #R$43C2, #R$496D, #R$49FD and #R$4AEC.
* .
* Divides x and y by the depth z, as logarithms, giving the point's
* position on screen relative to the middle of the view (#R$47F0). Also
* caches log(z) for further projections (#R$EB9B, #R$E6F1).
* 
* I:DE x
* I:BC y
* I:HL z (positive)
* O:BC x on screen
* O:DE y on screen
project_point:                                             ; >47c4
       .proc
       .push bc                                            ; PUSH BC           ; save the caller's BC (the second value to combine)
       movb h,a                                            ; LD A,H            ; A = HL's high byte
       socb a,a                                            ; OR A              ; 
       jeq  _47d5                                          ; JR Z,$47D5        ; z under 256
       movb @l,@c                                          ; LD C,L            ; else: C = HL's low byte
       movb a,@l                                           ; LD L,A            ; L = HL's high byte
       movb @bytes+>02,h                                   ; LD H,$02          ; H = $02 (bit-length table page)
       movb *hl,b                                          ; LD B,(HL)         ; B = table[HL's high byte]'s bit length (shift count)
_47ce:                                                     ; >47ce
       srl  a,1                                            ; RRA               ; TODO: check code. shift z down
       ; RR C                                              ; RR C              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $47CE        ; ...B times (normalizing HL)
       jne  _47ce                                          ;                   
       movb *hl,a                                          ; LD A,(HL)         ; A = the table's own stored exponent value
       movb @c,@l                                          ; LD L,C            ; L = the normalized low byte
_47d5:                                                     ; >47d5
       movb a,@depth_shift                                 ; LD ($EB9B),A      ; the shift
       sb   a,a                                            ; XOR A             ; 
       ; SLA L                                             ; SLA L             ; TODO: check code. L doubled (word index)
       ab   @bytes+>08,a                                   ; ADC A,$08         ; A = 8 + carry (table page)
       movb a,h                                            ; LD H,A            ; HL -> the $0800-$0BFF scaled-word table
       movb *hl,a                                          ; LD A,(HL)         ; read the table entry (little-endian word)...
       ab   one,@l                                         ; INC L             ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; ...HL = the scaled word
       mov  hl,@log_depth                                  ; LD ($E6F1),HL     ; log(z)
       .ex_de_hl                                           ; EX DE,HL          ; HL = the caller's DE (first value to combine)
       bl   @project_coordinate                            ; CALL $47F0        ; project x
       .ex_sp_hl                                           ; EX (SP),HL        ; stash the first result on the stack; HL = the saved BC
       bl   @project_coordinate                            ; CALL $47F0        ; project y
       .ex_de_hl                                           ; EX DE,HL          ; DE = the second result
       .pop bc                                             ; POP BC            ; BC = the first result (stashed above)
       .endproc                                            ; RET               ; return with BC/DE = the two combined results

********************************************************************************
* Project a coordinate
* 
* Used by the routines at #R$46CA and #R$47C4.
* .
* Returns 128 * v / z, worked out with logarithms: log(v) (normalised by
* the same shift as z, #R$EB9B) + log 128 ($1C00) - log(z) (#R$E6F1),
* turned back into a value (#R$21A3); 0 if it's out of range ($4839). Keeps
* v's sign.
* .
* At $4839, gives 0; at $483C, puts back v's sign.
* 
* I:HL v
* O:HL 128 * v / z
project_coordinate:                                        ; >47f0
       .proc
       .ex_de_hl                                           ; EX DE,HL          ; HL = the caller's value; DE = whatever it swaps with
       movb d,a                                            ; LD A,D            ; A = DE's high byte (the value's sign)
       socb a,a                                            ; OR A              ; 
       .push af                                            ; PUSH AF           ; save the sign
       jlt  !                                              ; JP P,$47FD        ; non-negative - skip the negate below
       b    @project_coordinate_abs                        ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate DE (absolute value)...
       sb   @e,a                                           ; SUB E             ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow...
       sb   d,a                                            ; SUB D             ; 
       movb a,d                                            ; LD D,A            ; ...D:E = abs(D:E)
project_coordinate_abs:                                    ; >47fd
       jeq  _4809                                          ; JR Z,$4809        ; zero - skip the normalize loop below
       movb a,@l                                           ; LD L,A            ; else: L = D's (now-positive) high byte
       movb @bytes+>02,h                                   ; LD H,$02          ; H = $02 (bit-length table page)
       movb *hl,b                                          ; LD B,(HL)         ; B = table[D]'s bit length (shift count)
_4803:                                                     ; >4803
       srl  a,1                                            ; RRA               ; TODO: check code. shift DE right...
       ; RR E                                              ; RR E              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $4803        ; ...B times (normalizing DE)
       jne  _4803                                          ;                   
       movb *hl,a                                          ; LD A,(HL)         ; A = the table's own stored exponent value
_4809:                                                     ; >4809
       li   hl,depth_shift                                 ; LD HL,$EB9B       ; HL -> the exponent #R$46CA/#R$47C4 stored
       sb   *hl,a                                          ; SUB (HL)          ; A -= that exponent
       ab   a,a                                            ; ADD A,A           ; A doubled...
       ab   a,a                                            ; ADD A,A           ; ...twice more (A *= 4)
       .ex_af_af_                                          ; EX AF,AF'         ; stash A (and flags) in the shadow set
       sb   a,a                                            ; XOR A             ; 
       ; SLA E                                             ; SLA E             ; TODO: check code. E doubled (word index)
       ab   @bytes+>08,a                                   ; ADC A,$08         ; A = 8 + carry (table page)
       movb @e,@l                                          ; LD L,E            ; 
       movb a,h                                            ; LD H,A            ; 
       movb *hl,a                                          ; LD A,(HL)         ; read the table entry (little-endian word)...
       ab   one,@l                                         ; INC L             ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; ...HL = the scaled word
       li   bc,>1c00                                       ; LD BC,$1C00       ; BC = $1C00
       a    bc,hl                                          ; ADD HL,BC         ; HL += $1C00
       joc  project_coordinate_2                           ; JR C,$4839        ; TODO: check code. overflowed - out of range
       mov  @log_depth,de                                  ; LD DE,($E6F1)     ; DE = the caller's stored scale word
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE
       .ex_af_af_                                          ; EX AF,AF'         ; restore the stashed exponent*4 value
       ab   h,a                                            ; ADD A,H           ; A += HL's high byte
       jhe  !                                              ; JP M,$4839        ; negative - out of range
       b    @project_coordinate_2                          ;                   
!
       movb a,h                                            ; LD H,A            ; else: H = the combined high byte
       bl   @antilog16                                     ; CALL $21A3        ; combine via #R$21A3
       czc  @bit7,h                                        ; BIT 7,H           ; test the result's sign bit
       jlt  !                                              ; JP P,$4837        ; non-negative - keep it
       b    @project_coordinate_join                       ;                   
!
       szcb @bit7,h                                        ; RES 7,H           ; else clear the sign bit (magnitude only)
project_coordinate_join:                                   ; >4837
       jmp  _483c                                          ; JR $483C          ; join the shared sign-reapply tail
project_coordinate_2:                                      ; >4839
       li   hl,>0000                                       ; LD HL,$0000       ; HL = 0 (the out-of-range case)
_483c:                                                     ; >483c
       movb h,d                                            ; LD D,H            ; D = H
       movb @l,@e                                          ; LD E,L            ; E = L (DE = HL, the magnitude copy)
       .pop af                                             ; POP AF            ; restore the value's original sign
       jlt  !                                              ; RET P             ; non-negative - return as-is
       .endproc                                            ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...H:L = -H:L
       .endproc                                            ; RET               ; return with the original sign reapplied to HL

********************************************************************************
* Draw a ship: scale a normal's component
* 
* Used by the routine at #R$4873.
* .
* Part of #R$4873. Multiplies the component by the face's scale byte
* ($E7E8, with its bit length in $E7E9) and divides by 256, keeping the
* sign.
* 
* I:HL Component
* O:HL Scaled component
scale_normal_component:                                    ; >4847
       czc  @bit7,h                                        ; BIT 7,H           ; test H's sign bit (the value's sign, not L's)
       .push af                                            ; PUSH AF           ; save that sign for the end
       jlt  !                                              ; JP P,$4851        ; non-negative - keep L as-is
       b    @scale_normal_abs                              ;                   
!
       movb @l,a                                           ; LD A,L            ; negative: negate L...
       neg a                                               ; NEG               ; 
       movb a,@l                                           ; LD L,A            ; ...L = abs(L)
scale_normal_abs:                                          ; >4851
       movb @l,@e                                          ; LD E,L            ; DE = abs(L)
       sb   d,d                                            ; LD D,$00          ; 
       movb @face_scale_bits,a                             ; LD A,($E7E9)      ; A = the shared bit-count
       movb a,b                                            ; LD B,A            ; B = that bit count (loop counter)
       movb @face_scale,a                                  ; LD A,($E7E8)      ; A = the shared multiplier byte
       movb d,h                                            ; LD H,D            ; HL = 0 (the running product)
       movb d,@l                                           ; LD L,D            ; 
_485d:                                                     ; >485d
       srl  a,1                                            ; RRA               ; TODO: check code. shift the multiplier bit into carry
       jnc  _4861                                          ; JR NC,$4861       ; TODO: check code. clear - skip the add
       a    de,hl                                          ; ADD HL,DE         ; set - accumulate DE into the product
_4861:                                                     ; >4861
       ; SLA E                                             ; SLA E             ; TODO: check code. double DE (shift the double-and-add idiom along)...
       sla  d,1                                            ; RL D              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $485D        ; ...B times
       jne  _485d                                          ;                   
       .pop af                                             ; POP AF            ; restore the value's original sign
       movb h,@l                                           ; LD L,H            ; L = the product's high byte
       sb   h,h                                            ; LD H,$00          ; H = 0
       jlt  !                                              ; RET P             ; non-negative - return as-is
       rt                                                  ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...H:L = -H:L
       rt                                                  ; RET               ; return with the original sign reapplied

********************************************************************************
* Draw a ship: does a face face the player?
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Rotates the face's normal (#R$E7EA) into the view
* (#R$4464), scales it by the face's scale byte (#R$4847), and adds up
* its products with the ship's position (#R$48EC) - a dot product,
* negative if the face can be seen.
* 
* O:A,HL The dot product (A the high byte)
face_visible:                                              ; >4873
       .proc
       .push hl                                            ; PUSH HL           ; save the caller's HL
       bl   @rotate_vertex                                 ; CALL $4464        ; transform the vector via #R$4464 (BC/DE/HL = its three components)
       mov  de,@rotated_vector                             ; LD ($E7EA),DE     ; cache the first component
       mov  bc,@rotated_vector_y                           ; LD ($E7EC),BC     ; cache the second component
       mov  hl,@rotated_vector_z                           ; LD ($E7EE),HL     ; cache the third component
       .ex_de_hl                                           ; EX DE,HL          ; HL = the first component
       bl   @scale_normal_component                        ; CALL $4847        ; scale it via #R$4847
       .push hl                                            ; PUSH HL           ; save the scaled result
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; HL = the second component
       bl   @scale_normal_component                        ; CALL $4847        ; scale it too
       .push hl                                            ; PUSH HL           ; save that result
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; HL = the third component
       bl   @scale_normal_component                        ; CALL $4847        ; scale it too
       .pop bc                                             ; POP BC            ; BC = the second scaled result
       .pop de                                             ; POP DE            ; DE = the first scaled result
       bl   @add_object_position                           ; CALL $44D2        ; combine (third scaled result in HL) with BC/DE via #R$44D2
       czc  @bit7,d                                        ; BIT 7,D           ; test D's sign bit
       jeq  _48a5                                          ; JR Z,$48A5        ; clear - skip the negate below
       sb   a,a                                            ; XOR A             ; set: negate DE...
       sb   @e,a                                           ; SUB E             ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow...
       sb   d,a                                            ; SUB D             ; 
       socb @bytes+>80,a                                   ; OR $80            ; ...and force the sign bit set (sign-magnitude form)
       movb a,d                                            ; LD D,A            ; 
_48a5:                                                     ; >48a5
       czc  @bit7,b                                        ; BIT 7,B           ; test B's sign bit
       jeq  _48b1                                          ; JR Z,$48B1        ; clear - skip the negate below
       sb   a,a                                            ; XOR A             ; set: negate BC...
       sb   @c,a                                           ; SUB C             ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow...
       sb   b,a                                            ; SUB B             ; 
       socb @bytes+>80,a                                   ; OR $80            ; ...and force the sign bit set
       movb a,b                                            ; LD B,A            ; 
_48b1:                                                     ; >48b1
       mov  bc,@face_visible_workspace_1                   ; LD ($E6EA),BC     ; cache the sign-magnitude BC
       czc  @bit7,h                                        ; BIT 7,H           ; test H's sign bit
       jeq  _48c1                                          ; JR Z,$48C1        ; clear - skip the negate below
       sb   a,a                                            ; XOR A             ; set: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; ...propagate the borrow...
       sb   h,a                                            ; SUB H             ; 
       socb @bytes+>80,a                                   ; OR $80            ; ...and force the sign bit set
       movb a,h                                            ; LD H,A            ; 
_48c1:                                                     ; >48c1
       mov  hl,@face_visible_workspace_2                   ; LD ($E6EC),HL     ; cache the sign-magnitude HL
       mov  @rotated_vector,hl                             ; LD HL,($E7EA)     ; HL = the first (unscaled) component again
       bl   @multiply_small_by_word                        ; CALL $48EC        ; multiply it against DE (the sign-magnitude D from above) via #R$48EC
       .push af                                            ; PUSH AF           ; save the product's high byte (A)
       .push hl                                            ; PUSH HL           ; save the product's HL
       mov  @face_visible_workspace_1,de                   ; LD DE,($E6EA)     ; DE = the cached sign-magnitude BC ($E6EA)
       mov  @rotated_vector_y,hl                           ; LD HL,($E7EC)     ; HL = the second (unscaled) component
       bl   @multiply_small_by_word                        ; CALL $48EC        ; multiply it against DE via #R$48EC
       .push af                                            ; PUSH AF           ; save the product's high byte (A)
       .push hl                                            ; PUSH HL           ; save the product's HL
       mov  @face_visible_workspace_2,de                   ; LD DE,($E6EC)     ; DE = the cached sign-magnitude HL ($E6EC)
       mov  @rotated_vector_z,hl                           ; LD HL,($E7EE)     ; HL = the third (unscaled) component
       bl   @multiply_small_by_word                        ; CALL $48EC        ; multiply it against DE via #R$48EC
       .pop de                                             ; POP DE            ; DE = the second product's HL
       .pop bc                                             ; POP BC            ; BC = the second product's high byte
       a    de,hl                                          ; ADD HL,DE         ; HL += DE (sum the second product in)
       ab   b,a                                            ; ADC A,B           ; A += B, with carry
       .pop de                                             ; POP DE            ; DE = the first product's HL
       .pop bc                                             ; POP BC            ; BC = the first product's high byte
       a    de,hl                                          ; ADD HL,DE         ; HL += DE (sum the first product in)
       ab   b,a                                            ; ADC A,B           ; A += B, with carry
       .pop hl                                             ; POP HL            ; restore the caller's HL
       .endproc                                            ; RET               ; return with A:HL = the summed 24-bit accumulator

********************************************************************************
* Multiply a small signed number by a sign-magnitude word
* 
* Used by the routine at #R$4873.
* .
* Returns A:HL = L * DE, where L is a signed number from -128 to 127 (H
* being its sign, so only bit 7 of H matters) and DE is sign-magnitude.
* The sign of the result is the XOR of the two signs, kept in F' while the
* magnitudes are multiplied by shift and add (stopping once no bits of |L|
* are left); the result is a 24-bit two's complement number.
* 
* I:HL The first number (L, with H its sign)
* I:DE The second number (sign-magnitude)
* O:A:HL The product
multiply_small_by_word:                                    ; >48ec
       movb h,a                                            ; LD A,H            ; 
       ; XOR D                                             ; XOR D             ; TODO: check code. the sign of the product
       .ex_af_af_                                          ; EX AF,AF'         ; save it in F'
       szcb @bit7,d                                        ; RES 7,D           ; DE = |DE|
       czc  @bit7,h                                        ; BIT 7,H           ; L negative?
       jeq  _48f9                                          ; JR Z,$48F9        ; no
       movb @l,a                                           ; LD A,L            ; 
       neg a                                               ; NEG               ; 
       movb a,@l                                           ; LD L,A            ; yes: L = |L|
_48f9:                                                     ; >48f9
       movb @l,b                                           ; LD B,L            ; B = |L|, the multiplier
       sb   a,a                                            ; XOR A             ; 
       movb a,h                                            ; LD H,A            ; 
       movb a,@l                                           ; LD L,A            ; 
       movb a,@c                                           ; LD C,A            ; A:HL = 0, the product; C:DE = |DE|, which is shifted left
_48fe:                                                     ; >48fe
       srl  b,1                                            ; SRL B             ; shift the next bit out of the multiplier
       jnc  _4904                                          ; JR NC,$4904       ; TODO: check code. 0 - don't add
       a    de,hl                                          ; ADD HL,DE         ; 1: add C:DE to A:HL
       ab   @c,a                                           ; ADC A,C           ; 
_4904:                                                     ; >4904
       ; SLA E                                             ; SLA E             ; TODO: check code. shift C:DE left
       sla  d,1                                            ; RL D              ; TODO: check code. 
       ; RL C                                              ; RL C              ; TODO: check code. 
       ab   one,b                                          ; INC B             ; any bits left in the multiplier? (INC B then DJNZ tests B)
       sb   one,b                                          ; DJNZ $48FE        ; 
       jne  _48fe                                          ;                   
       movb a,@c                                           ; LD C,A            ; 
       .ex_af_af_                                          ; EX AF,AF'         ; the sign
       movb @c,a                                           ; LD A,C            ; A:HL = the product
       jlt  !                                              ; RET P             ; positive - done
       rt                                                  ;                   
!
       movb b,a                                            ; LD A,B            ; negative: A:HL = 0 - A:HL (B is 0 here)
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       movb b,a                                            ; LD A,B            ; 
       sb   h,a                                            ; SBC A,H           ; 
       movb a,h                                            ; LD H,A            ; 
       movb b,a                                            ; LD A,B            ; 
       sb   @c,a                                           ; SBC A,C           ; 
       rt                                                  ; RET               ; 

********************************************************************************
* Draw a ship: draw a face's edges
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. For each edge in the face's list (a count, then edge
* numbers), looks up its two vertices in the edge data (#R$F7F7) and,
* unless it has already been drawn (its flag at $E7B6, read and written by
* patching the displacement of an (IX+d) instruction), draws it (#R$496D)
* and marks it drawn. An edge whose first vertex has bit 7 set isn't drawn
* but flagged $FF and counted in $E6EE ($4948); when it turns up again
* ($4957) it's flagged 1 and the count goes down.
* .
* At $4969, moves on to the next edge.
draw_face_edges:                                           ; >491a
       .proc
       movb *hl,b                                          ; LD B,(HL)         ; B = the number of edges
       inc  hl                                             ; INC HL            ; 
_491c:                                                     ; >491c
       movb *hl,a                                          ; LD A,(HL)         ; A = the next edge
       movb a,@draw_face_edge_flag+>0003                   ; LD ($4922),A      ; point (IX+d) at the edge's flag (#R$4920+2)
draw_face_edge_flag:                                       ; >4920
       movb @>05(ix),a                                     ; LD A,(IX+$05)     ; A = the edge's flag
       socb a,a                                            ; OR A              ; 
       jne  draw_face_edges_3                              ; JR NZ,$4957       ; already drawn or skipped
       .push hl                                            ; PUSH HL           ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       mov  @bp_edges,hl                                   ; LD HL,($F7F7)     ; HL = the edge data
       ab   a,a                                            ; ADD A,A           ; 
       ab   @l,a                                           ; ADD A,L           ; 
       movb a,@l                                           ; LD L,A            ; 
       joc  !                                              ; JP NC,$4932       ; TODO: check code. 
       b    @draw_face_edge                                ;                   
!
       ab   one,h                                          ; INC H             ; 
draw_face_edge:                                            ; >4932
       movb *hl,a                                          ; LD A,(HL)         ; A = the edge's first vertex
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$4948        ; bit 7 set - skip it
       b    @draw_face_edges_2                             ;                   
!
       movb a,@e                                           ; LD E,A            ; E = the first vertex
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; D = the second vertex
       bl   @draw_edge                                     ; CALL $496D        ; draw the edge
       .pop hl                                             ; POP HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@draw_face_edge_drawn+>0003                  ; LD ($4944),A      ; point (IX+d) at the edge's flag (#R$4942+2)
draw_face_edge_drawn:                                      ; >4942
       movb one,@>05(ix)                                   ; LD (IX+$05),$01   ; the edge is drawn
       jmp  _4955                                          ; JR $4955          ; 
draw_face_edges_2:                                         ; >4948
       li   hl,skipped_edges_count                         ; LD HL,$E6EE       ; 
       ab   one,*hl                                        ; INC (HL)          ; one more edge skipped
       .pop hl                                             ; POP HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@draw_face_edge_skipped+>0005                ; LD ($4953),A      ; point (IX+d) at the edge's flag (#R$4951+2)
draw_face_edge_skipped:                                    ; >4951
       movb @b255,@>00(ix)                                 ; LD (IX+$00),$FF   ; the edge is skipped
_4955:                                                     ; >4955
       jmp  draw_face_next_edge                            ; JR $4969          ; next edge
draw_face_edges_3:                                         ; >4957
       jlt  !                                              ; JP P,$4969        ; already drawn - next edge
       b    @draw_face_next_edge                           ;                   
!
       movb *hl,a                                          ; LD A,(HL)         ; skipped:
       movb a,@draw_face_edge_drawn_2+>0003                ; LD ($4960),A      ; point (IX+d) at the edge's flag (#R$495E+2)
draw_face_edge_drawn_2:                                    ; >495e
       movb one,@>00(ix)                                   ; LD (IX+$00),$01   ; the edge is drawn
       movb @skipped_edges_count,a                         ; LD A,($E6EE)      ; one fewer edge skipped
       sb   one,a                                          ; DEC A             ; 
       movb a,@skipped_edges_count                         ; LD ($E6EE),A      ; 
draw_face_next_edge:                                       ; >4969
       inc  hl                                             ; INC HL            ; 
       sb   one,b                                          ; DJNZ $491C        ; next edge
       jne  _491c                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw an edge
* 
* Used by the routine at #R$491A.
* .
* Projects vertex E (#R$49FD) and, if it's in front of the player, vertex D
* ($49B6), and draws the line between them (#R$3AC2). If vertex E is behind
* the player, draws a line worked out from vertex D alone (#R$4A5C,
* #R$47C4, #R$4B22) instead - or nothing if D is behind the player too.
* .
* At $49B6, with the first vertex projected ($EB92), projects the second
* (#R$49FD): if it's in front of the player, draws the edge ($49EE);
* otherwise clips the edge where it passes the player (#R$4A5C, #R$4B22)
* and draws that.
* .
* At $49EE, stores the second point (BC, HL) and draws the line (#R$3AC2).
* 
* I:D Second vertex
* I:E First vertex
draw_edge:                                                 ; >496d
       .proc
       .push bc                                            ; PUSH BC           ; save the caller's BC
       .push ix                                            ; PUSH IX           ; and IX
       .push de                                            ; PUSH DE           ; save the vertex-index pair for later
       bl   @project_vertex                                ; CALL $49FD        ; project vertex E
       joc  draw_edge_2                                    ; JR C,$49B6        ; TODO: check code. valid - go project the second vertex too
       mov  de,@line_end_1_x                               ; LD ($F769),DE     ; invalid: cache #R$49FD's raw output anyway (unused further here)
       mov  bc,@line_end_1_y                               ; LD ($F76B),BC     ; 
       mov  hl,@line_end_1_z                               ; LD ($F76D),HL     ; 
       .exx                                                ; EXX               ; (scratch use of the shadow set)
       movb @e,a                                           ; LD A,E            ; 
       movb a,@draw_edge_clear_flag_e+>0005                ; LD ($4988),A      ; point (IY+d) at vertex E's flag (#R$4986+2)
draw_edge_clear_flag_e:                                    ; >4986
       movb @zero,@>00(iy)                                 ; LD (IY+$00),$00   ; clear the per-vertex cache flag for E
       .pop de                                             ; POP DE            ; DE = the original vertex-index pair
       movb d,a                                            ; LD A,D            ; A = the second vertex's index
       bl   @vertex_relative                               ; CALL $4A5C        ; project it directly (no caching)
       jnc  _49b4                                          ; JR NC,$49B4       ; TODO: check code. also invalid - no edge to draw
       mov  de,@line_end_2_x                               ; LD ($F76F),DE     ; cache the raw projection
       mov  bc,@line_end_2_y                               ; LD ($F771),BC     ; 
       mov  hl,@line_end_2_z                               ; LD ($F773),HL     ; 
       bl   @project_point                                 ; CALL $47C4        ; finishing step -> point 1
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; -> point 1's X
       mov  de,@clip_point1_y                              ; LD ($EB94),DE     ; -> point 1's Y
       bl   @clip_line_at_player                           ; CALL $4B22        ; a different finishing step -> point 2
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; -> point 2's X
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; -> point 2's Y
       bl   @clip_and_draw_line                            ; CALL $3AC2        ; clip and draw the substitute edge
_49b4:                                                     ; >49b4
       jmp  _49f9                                          ; JR $49F9          ; join the shared return
draw_edge_2:                                               ; >49b6
       mov  bc,@clip_point1_x                              ; LD ($EB92),BC     ; point 1 = vertex E's projection (BC,HL from #R$49FD)
       mov  hl,@clip_point1_y                              ; LD ($EB94),HL     ; 
       .pop de                                             ; POP DE            ; DE = the original vertex-index pair
       .push de                                            ; PUSH DE           ; (peek, restore it)
       movb d,@e                                           ; LD E,D            ; E = the second vertex's index
       bl   @project_vertex                                ; CALL $49FD        ; project it
       joc  draw_edge_draw_clipped                         ; JR C,$49EE        ; TODO: check code. valid - go store it as point 2 and draw
       mov  de,@line_end_1_x                               ; LD ($F769),DE     ; invalid: cache #R$49FD's raw output anyway
       mov  bc,@line_end_1_y                               ; LD ($F76B),BC     ; 
       mov  hl,@line_end_1_z                               ; LD ($F76D),HL     ; 
       .exx                                                ; EXX               ; (scratch use of the shadow set)
       movb @e,a                                           ; LD A,E            ; 
       movb a,@draw_edge_clear_flag_d+>0005                ; LD ($49D7),A      ; point (IY+d) at vertex D's flag (#R$49D5+2)
draw_edge_clear_flag_d:                                    ; >49d5
       movb @zero,@>00(iy)                                 ; LD (IY+$00),$00   ; clear the per-vertex cache flag for D
       .pop de                                             ; POP DE            ; DE = the vertex-index pair again
       movb @e,a                                           ; LD A,E            ; A = the FIRST vertex's index (E, already known valid)
       bl   @vertex_relative                               ; CALL $4A5C        ; project it directly (no caching)
       mov  de,@line_end_2_x                               ; LD ($F76F),DE     ; cache the raw projection
       mov  bc,@line_end_2_y                               ; LD ($F771),BC     ; 
       mov  hl,@line_end_2_z                               ; LD ($F773),HL     ; 
       bl   @clip_line_at_player                           ; CALL $4B22        ; finishing step (only one here - see #R$49EF for where it lands)
       jmp  _49ef                                          ; JR $49EF          ; 
draw_edge_draw_clipped:                                    ; >49ee
       .pop de                                             ; POP DE            ; discard the saved vertex-index pair (draw is now unconditional)
_49ef:                                                     ; >49ef
       mov  bc,@clip_point2_x                              ; LD ($EB96),BC     ; point 2's X
       mov  hl,@clip_point2_y                              ; LD ($EB98),HL     ; point 2's Y
       bl   @clip_and_draw_line                            ; CALL $3AC2        ; clip and draw
_49f9:                                                     ; >49f9
       .pop ix                                             ; POP IX            ; restore the caller's IX
       .pop bc                                             ; POP BC            ; and BC
       .endproc                                            ; RET               ; 

********************************************************************************
* Project a vertex
* 
* Used by the routine at #R$496D.
* .
* Each vertex is projected at most once per frame: if its flag in the table
* at IY (#R$E784, read by patching the displacement of an (IY+d) instruction)
* is set, its screen position is read back from the vertex cache (#R$E61D, at $4A4C). Otherwise the vertex (6 bytes, from #R$F7F5) is rotated into
* the view (#R$4464), added to the ship's position (#R$44D2) and, if it's
* in front of the player, projected (#R$47C4) and cached.
* .
* At $4A4C, reads the cached position from $E6C8 + E * 4, and returns with
* carry set (only vertices in front of the player are cached).
* 
* I:E Vertex number
* O:F Carry set if it's in front of the player
* O:BC,HL Its screen position
project_vertex:                                            ; >49fd
       .proc
       movb @e,a                                           ; LD A,E            ; A = the vertex index
       movb a,@project_vertex_flag+>0003                   ; LD ($4A03),A      ; patch the (IY+d) read to (IY+E) (#R$4A01+2)
project_vertex_flag:                                       ; >4a01
       movb @>00(iy),a                                     ; LD A,(IY+$00)     ; A = this vertex's cache flag
       socb a,a                                            ; OR A              ; 
       jne  project_vertex_from_cache                      ; JR NZ,$4A4C       ; already cached - read it back
       movb @e,a                                           ; LD A,E            ; not cached: A = the vertex index again
       movb a,@project_vertex_set_flag+>0005               ; LD ($4A0D),A      ; patch the (IY+d) write to (IY+E) (#R$4A0B+2)
project_vertex_set_flag:                                   ; >4a0b
       movb @b255,@>05(iy)                                 ; LD (IY+$05),$FF   ; set a second, fixed-offset flag
       .exx                                                ; EXX               ; (scratch use of the shadow set)
       mov  @bp_vertices,hl                                ; LD HL,($F7F5)     ; HL = the vector-record table's base pointer
       ab   a,a                                            ; ADD A,A           ; A = index * 2
       movb a,@c                                           ; LD C,A            ; C = it
       sb   b,b                                            ; LD B,$00          ; BC = index * 2, widened
       ab   a,a                                            ; ADD A,A           ; A = index * 4
       movb a,@vertex_cache_slot                           ; LD ($E6C8),A      ; low byte of this vertex's cache-slot pointer
       ab   @l,a                                           ; ADD A,L           ; A += table base low byte
       movb a,@l                                           ; LD L,A            ; L = table base low byte + index*4
       joc  !                                              ; JP NC,$4A21       ; TODO: check code. no carry - skip the high-byte bump
       b    @project_vertex_record                         ;                   
!
       ab   one,h                                          ; INC H             ; carry into the high byte
project_vertex_record:                                     ; >4a21
       a    bc,hl                                          ; ADD HL,BC         ; HL = table base + index*4 + index*2 = + index*6 (6 bytes/record)
       li   de,rotated_vector                              ; LD DE,$E7EA       ; DE -> the shared vector staging buffer
       .ldi                                                ; LDI               ; copy the 6-byte record...
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; ...done
       bl   @rotate_vertex                                 ; CALL $4464        ; combine via #R$4464
       bl   @add_object_position                           ; CALL $44D2        ; combine that result via #R$44D2
       movb h,a                                            ; LD A,H            ; test the combined result's sign
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; RET M             ; negative - no valid projection, carry clear
       .endproc                                            ;                   
!
       socb @l,a                                           ; OR L              ; exactly zero?
       jne  !                                              ; RET Z             ; yes - no valid projection, carry clear
       .endproc                                            ;                   
!
       bl   @project_point                                 ; CALL $47C4        ; finish the projection
       mov  @vertex_cache_slot,hl                          ; LD HL,($E6C8)     ; HL -> this vertex's cache slot
       movb @c,*hl                                         ; LD (HL),C         ; cache (C,B,E,D) - the projected point
       ab   one,@l                                         ; INC L             ; 
       movb b,*hl                                          ; LD (HL),B         ; 
       ab   one,@l                                         ; INC L             ; 
       movb @e,*hl                                         ; LD (HL),E         ; 
       ab   one,@l                                         ; INC L             ; 
       movb d,*hl                                          ; LD (HL),D         ; 
       .ex_de_hl                                           ; EX DE,HL          ; HL = the projected point's second word
       ; SCF                                               ; SCF               ; TODO: check code. carry set - valid
       .endproc                                            ; RET               ; 
project_vertex_from_cache:                                 ; >4a4c
       movb @e,a                                           ; LD A,E            ; A = the vertex index
       ab   a,a                                            ; ADD A,A           ; A *= 4 (2 doublings)...
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@l                                           ; LD L,A            ; L = the slot offset within the $E6xx page
       movb @bytes+>e6,h                                   ; LD H,$E6          ; H = the page - HL -> this vertex's cache slot
       movb *hl,@c                                         ; LD C,(HL)         ; C = the slot's first byte
       ab   one,@l                                         ; INC L             ; 
       movb *hl,b                                          ; LD B,(HL)         ; B = the second byte - BC is the first cached word
       ab   one,@l                                         ; INC L             ; 
       movb *hl,@e                                         ; LD E,(HL)         ; E = the third byte
       ab   one,@l                                         ; INC L             ; 
       movb *hl,d                                          ; LD D,(HL)         ; D = the fourth byte - DE is the second cached word
       .ex_de_hl                                           ; EX DE,HL          ; HL = the second cached word (DE becomes a leftover pointer, unused)
       ; SCF                                               ; SCF               ; TODO: check code. carry set - always valid
       .endproc                                            ; RET               ; 

********************************************************************************
* Get a vertex relative to the player
* 
* Used by the routines at #R$43C2 and #R$496D.
* .
* Copies vertex A (6 bytes, from #R$F7F5) to #R$E7EA, rotates it into the
* view (#R$4464) and adds the object's position (#R$44D2).
* 
* I:A Vertex number
* O:DE,BC,HL x, y and z
* O:F Carry set if it's in front of the player (z positive)
vertex_relative:                                           ; >4a5c
       .proc
       mov  @bp_vertices,hl                                ; LD HL,($F7F5)     ; HL = the vector-record table's base pointer
       ab   a,a                                            ; ADD A,A           ; A = the record index * 2
       movb a,@c                                           ; LD C,A            ; C = that doubled index
       sb   b,b                                            ; LD B,$00          ; B = 0 (widen to BC)
       ab   a,a                                            ; ADD A,A           ; A = the index * 4
       ab   @l,a                                           ; ADD A,L           ; A += the table base's low byte
       movb a,@l                                           ; LD L,A            ; L = table base low byte + index*4
       joc  !                                              ; JP NC,$4A6A       ; TODO: check code. no carry from that add - skip the high-byte bump
       b    @vertex_relative_record                        ;                   
!
       ab   one,h                                          ; INC H             ; else carry into the high byte
vertex_relative_record:                                    ; >4a6a
       a    bc,hl                                          ; ADD HL,BC         ; HL = table base + index*4 + index*2 = table base + index*6
       li   de,rotated_vector                              ; LD DE,$E7EA       ; DE -> the $E7EA staging buffer
       .ldi                                                ; LDI               ; copy 6 bytes from the record into the staging buffer...
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       .ldi                                                ; LDI               ; 
       bl   @rotate_vertex                                 ; CALL $4464        ; combine the copied vector via #R$4464
       bl   @add_object_position                           ; CALL $44D2        ; combine that result with cached deltas via #R$44D2
       jne  !                                              ; RET Z             ; zero (from #R$44D2's result) - return with its data-dependent carry
       .endproc                                            ;                   
!
       movb h,a                                            ; LD A,H            ; A = the combined result's high byte
       socb a,a                                            ; OR A              ; test its sign (also clears carry)
       jhe  !                                              ; RET M             ; negative - return with carry clear
       .endproc                                            ;                   
!
       ; SCF                                               ; SCF               ; TODO: check code. non-negative - set carry
       .endproc                                            ; RET               ; and return with carry set

********************************************************************************
* Draw a ship: too small or far away
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Draws the object as a circle of its radius on screen
* (#R$EB9E): the planet as an outline (#R$3D0E), anything else - the sun,
* or a distant ship - as a filled disc (#R$3DF4).
draw_small:                                                ; >4a86
       mov  @screen_radius,hl                              ; LD HL,($EB9E)     ; HL = the cached range value (see #R$4735/#R$4738)
       movb @ship_type,a                                   ; LD A,($F7E7)      ; A = the current ship type
       cb   a,@bytes+>64                                   ; CP $64            ; is it mode $64?
       jeq  !                                              ; JP NZ,$3DF4       ; no - dispatch to #R$3DF4
       b    @draw_disc                                     ;                   
!
       li   de,>0002                                       ; LD DE,$0002       ; yes: DE = 2
       movb @bytes+>0a,b                                   ; LD B,$0A          ; B = 10
       b    @draw_circle_jmp                               ; JP $3D0E          ; dispatch to #R$3D0E instead

********************************************************************************
* Draw a ship: is it on screen?
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Checks whether the object's circle on screen - its
* position (BC, DE) and radius (#R$EB9E) - overlaps the view, which runs
* from x = -116 to 118 and y = -63 to 65 (the edges at $E6E0-$E6E6 are
* biased by $8000).
* 
* I:BC x on screen
* I:DE y on screen
* O:A $FF if it's on screen, 0 if not
on_screen:                                                 ; >4a99
       movb @bytes+>80,a                                   ; LD A,$80          ; A = $80
       ab   d,a                                            ; ADD A,D           ; sign-flip D (of DE, the second scaled result)...
       movb a,d                                            ; LD D,A            ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; A = $80 again
       ab   b,a                                            ; ADD A,B           ; sign-flip B (of BC, the first scaled result)...
       movb a,b                                            ; LD B,A            ; 
       .push de                                            ; PUSH DE           ; save the sign-flipped D and original E
       mov  @screen_radius,de                              ; LD DE,($EB9E)     ; DE = the cached range value (see #R$4735/#R$4738)
       movb b,h                                            ; LD H,B            ; HL = the sign-flipped B, original C
       movb @c,@l                                          ; LD L,C            ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = (flipped-B:C) - range
       mov  hl,@on_screen_left                             ; LD ($E6E0),HL     ; store the lower bound
       movb b,h                                            ; LD H,B            ; HL = (flipped-B:C) again
       movb @c,@l                                          ; LD L,C            ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = (flipped-B:C) + range
       mov  hl,@on_screen_right                            ; LD ($E6E2),HL     ; store the upper bound
       .pop bc                                             ; POP BC            ; BC = the sign-flipped D, original E (saved above)
       movb b,h                                            ; LD H,B            ; HL = that pair
       movb @c,@l                                          ; LD L,C            ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = (flipped-D:E) - range
       mov  hl,@on_screen_bottom                           ; LD ($E6E6),HL     ; store a second lower bound
       movb b,h                                            ; LD H,B            ; HL = (flipped-D:E) again
       movb @c,@l                                          ; LD L,C            ; 
       a    de,hl                                          ; ADD HL,DE         ; HL = (flipped-D:E) + range
       mov  hl,@on_screen_top                              ; LD ($E6E4),HL     ; store a second upper bound
       sb   a,a                                            ; XOR A             ; A = 0 (the "out of range" return value)
       mov  @on_screen_left,hl                             ; LD HL,($E6E0)     ; HL = the first lower bound
       li   de,>8076                                       ; LD DE,$8076       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $8076
       joc  !                                              ; RET NC            ; TODO: check code. still >= - out of range, return with A=0
       rt                                                  ;                   
!
       mov  @on_screen_right,hl                            ; LD HL,($E6E2)     ; HL = the first upper bound
       li   de,>7f8c                                       ; LD DE,$7F8C       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $7F8C
       jnc  !                                              ; RET C             ; TODO: check code. below it - out of range, return with A=0
       rt                                                  ;                   
!
       mov  @on_screen_top,hl                              ; LD HL,($E6E4)     ; HL = the second upper bound
       li   de,>7fc1                                       ; LD DE,$7FC1       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $7FC1
       jnc  !                                              ; RET C             ; TODO: check code. below it - out of range, return with A=0
       rt                                                  ;                   
!
       mov  @on_screen_bottom,hl                           ; LD HL,($E6E6)     ; HL = the second lower bound
       li   de,>8041                                       ; LD DE,$8041       ; 
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; compare against $8041
       joc  !                                              ; RET NC            ; TODO: check code. still >= - out of range, return with A=0
       rt                                                  ;                   
!
       sb   one,a                                          ; DEC A             ; all four checks passed - A = $FF (in range)
       rt                                                  ; RET               ; return with A nonzero

********************************************************************************
* Draw an explosion
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. Draws a cloud of dots: one for each of the next
* ($F7EF + 1, at most 50) random offsets in the table at $EEC6 (#R$47A1),
* each multiplied by the explosion's size (#R$F7F0, as a logarithm at
* #R$EB90), added to its position (#R$44D2), projected (#R$47C4) and
* plotted (#R$3DD7). As the explosion's countdown runs out there are
* fewer dots, and they spread as the size grows (#R$2556).
draw_explosion:                                            ; >4aec
       movb @per_type_parameter_block,a                    ; LD A,($F7F0)      ; A = the table index at $F7F0
       ab   a,a                                            ; ADD A,A           ; A *= 2 - 2 bytes per entry
       movb a,@l                                           ; LD L,A            ; L = that offset
       sb   a,a                                            ; LD A,$00          ; A = 0
       ab   @bytes+>08,a                                   ; ADC A,$08         ; A = 8 + the carry from doubling - the page selector (same idiom as #R$1FCF)
       movb a,h                                            ; LD H,A            ; H = the page (8 or 9)
       li   de,perentry_loop_pointer                       ; LD DE,$EB90       ; DE -> $EB90, #R$47A1's pointer input
       .ldi                                                ; LDI               ; copy the entry's first byte to $EB90 (BC isn't set up first - each LDI just decrements whatever BC the caller left)
       .ldi                                                ; LDI               ; copy the entry's second byte to $EB91 (same - BC is now that caller value minus 2, unused as a counter)
       li   hl,explosion_random_numbers                    ; LD HL,$EEC6       ; HL = $EEC6 - the list #R$47A1 walks
       mov  hl,@explosion_random_pointer                   ; LD ($E6DE),HL     ; store it to $E6DE
       movb @handler_countdown,a                           ; LD A,($F7EF)      ; A = a count at $F7EF
       ab   one,a                                          ; INC A             ; A += 1
       cb   a,@bytes+>32                                   ; CP $32            ; compare against 50
       jl   _4b0d                                          ; JR C,$4B0D        ; below 50 - keep it
       movb @bytes+>32,a                                   ; LD A,$32          ; else clamp to 50
_4b0d:                                                     ; >4b0d
       movb a,b                                            ; LD B,A            ; B = the clamped loop count
_4b0e:                                                     ; >4b0e
       .push bc                                            ; PUSH BC           ; save BC across this iteration's calls
       bl   @explosion_dot                                 ; CALL $47A1        ; the next dot's offset (#R$47A1)
       bl   @add_object_position                           ; CALL $44D2        ; add the explosion's position (#R$44D2)
       bl   @project_point                                 ; CALL $47C4        ; project it (#R$47C4)
       .ex_de_hl                                           ; EX DE,HL          ; HL = y on screen
       movb b,d                                            ; LD D,B            ; 
       movb @c,@e                                          ; LD E,C            ; DE = x on screen
       bl   @clip_test_and_plot_single_point               ; CALL $3DD7        ; plot the dot (#R$3DD7)
       .pop bc                                             ; POP BC            ; restore the loop counter
       sb   one,b                                          ; DJNZ $4B0E        ; loop
       jne  _4b0e                                          ;                   
       .ret                                                ; RET               ; done

********************************************************************************
* Clip a line where it passes the player
* 
* Used by the routines at #R$43C2 and #R$496D.
* .
* For a line from a point behind the player (#R$F769) to one in front
* (#R$F76F), finds where it crosses z = 1 - a fraction (1 - z1) / (z2 - z1)
* of the way along (#R$4B76) - and projects that point.
* 
* O:BC,HL The point on screen
clip_line_at_player:                                       ; >4b22
       .proc
       mov  @line_end_2_z,hl                               ; LD HL,($F773)     ; HL = the front end's z
       mov  @line_end_1_z,de                               ; LD DE,($F76D)     ; DE = the back end's z
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL = z2 - z1
       jlt  !                                              ; JP P,$4B35        ; non-negative - keep it
       b    @clip_line_dz                                  ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...HL = |z2 - z1|
clip_line_dz:                                              ; >4b35
       .ex_de_hl                                           ; EX DE,HL          ; DE = that absolute difference
       li   hl,>0001                                       ; LD HL,$0001       ; HL = 1
       mov  @line_end_1_z,bc                               ; LD BC,($F76D)     ; BC = z1
       socb a,a                                            ; OR A              ; 
       s    bc,hl                                          ; SBC HL,BC         ; HL = 1 - z1
       jlt  !                                              ; JP P,$4B49        ; non-negative - keep it
       b    @clip_line_divide                              ;                   
!
       sb   a,a                                            ; XOR A             ; negative: negate HL...
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; ...HL = |1 - z1|
clip_line_divide:                                          ; >4b49
       sb   a,a                                            ; XOR A             ; A = 0 (division setup)
       movb h,@c                                           ; LD C,H            ; C = H
       movb a,b                                            ; LD B,A            ; B = 0
       sb   @l,a                                           ; SUB L             ; A -= L
       s    bc,hl                                          ; SBC HL,BC         ; HL -= BC, with the borrow from above
       movb @bytes+>08,b                                   ; LD B,$08          ; B = 8 (loop count)
_4b51:                                                     ; >4b51
       sla  a,1                                            ; RLA               ; TODO: check code. rotate A left through carry...
       a    hl,hl                                          ; ADC HL,HL         ; ...and HL left, pulling that bit in
       s    de,hl                                          ; SBC HL,DE         ; HL -= DE (the difference computed earlier)
       jnc  _4b59                                          ; JR NC,$4B59       ; TODO: check code. still non-negative - keep the subtraction
       a    de,hl                                          ; ADD HL,DE         ; else undo it (add DE back)
_4b59:                                                     ; >4b59
       sb   one,b                                          ; DJNZ $4B51        ; loop 8 times (one division bit per iteration)
       jne  _4b51                                          ;                   
       sla  a,1                                            ; RLA               ; TODO: check code. shift the last quotient bit into A
       inv  a                                              ; CPL               ; A = 256 * |1 - z1| / |z2 - z1|, the fraction of the way along
       mov  @line_end_2_y,hl                               ; LD HL,($F771)     ; HL = y2
       mov  @line_end_1_y,de                               ; LD DE,($F76B)     ; DE = y1
       bl   @lerp_towards                                  ; CALL $4B76        ; HL = y1 + (y2 - y1) * A / 256 (#R$4B76)
       .push hl                                            ; PUSH HL           ; save it
       mov  @line_end_2_x,hl                               ; LD HL,($F76F)     ; HL = x2
       mov  @line_end_1_x,de                               ; LD DE,($F769)     ; DE = x1
       bl   @lerp_towards                                  ; CALL $4B76        ; HL = x1 + (x2 - x1) * A / 256
       movb h,b                                            ; LD B,H            ; BC = x
       movb @l,@c                                          ; LD C,L            ; 
       .pop hl                                             ; POP HL            ; HL = y
       .endproc                                            ; RET               ; 

********************************************************************************
* Linear interpolation: DE + (HL-DE) * A/256
* 
* Used by the routine at #R$4B22.
* .
* Moves A/256 of the way from DE towards HL - a standard lerp/easing
* step. A is an unsigned 0-255 fraction (0 leaves DE unchanged, 255
* lands one 256th short of HL); the sign of (HL-DE) is preserved
* through the #R$1F86 multiply by working in sign-magnitude form and
* only truncating (not rounding) the low byte of the product, unlike
* #R$24D1/#R$848D's rounded scaling.
* 
* I:A Unsigned interpolation fraction, 0-255 (0=DE, 255~HL)
* I:HL Target value
* I:DE Starting value
* O:HL Interpolated result
lerp_towards:                                              ; >4b76
       .proc
       .push af                                            ; PUSH AF           ; Save the caller's A/flags for the final RET
       .push de                                            ; PUSH DE           ; Save DE (the starting value) for the final add
       .ex_af_af_                                          ; EX AF,AF'         ; Stash the interpolation fraction
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; HL := HL - DE
       .push af                                            ; PUSH AF           ; Save the difference's sign for later
       jlt  !                                              ; JP P,$4B86        ; 
       b    @lerp_multiply                                 ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; HL := |HL-DE|
lerp_multiply:                                             ; >4b86
       .ex_af_af_                                          ; EX AF,AF'         ; Recover the interpolation fraction
       bl   @multiply_16x8                                 ; CALL $1F86        ; A:HL := |HL-DE| * A (24-bit product)
       movb h,@l                                           ; LD L,H            ; 
       movb a,h                                            ; LD H,A            ; Keep the product's top 16 bits (product >> 8), truncated
       .pop af                                             ; POP AF            ; Recover the difference's sign
       jlt  !                                              ; JP P,$4B96        ; 
       b    @lerp_add                                      ;                   
!
       sb   a,a                                            ; XOR A             ; 
       sb   @l,a                                           ; SUB L             ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   a,a                                            ; SBC A,A           ; 
       sb   h,a                                            ; SUB H             ; 
       movb a,h                                            ; LD H,A            ; Reapply the sign of (HL-DE)
lerp_add:                                                  ; >4b96
       .pop de                                             ; POP DE            ; DE := the original starting value
       a    de,hl                                          ; ADD HL,DE         ; HL := DE + (HL-DE)*A/256
       .pop af                                             ; POP AF            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* The message "Missile Locked"
msg_missile_locked:                                        ; >4b9a
       text 'MISSILE LOCKE',>e4

********************************************************************************
* Show a message for a while
* 
* Used by the routines at #R$1683, #R$5C01, #R$5CEE, #R$5D72, #R$5DBB, #R$5E6B,
* #R$5ED1, #R$5EE4, #R$5EFE, #R$6002, #R$6DCF, #R$A377, #R$A3C7 and #R$A542.
* .
* Prints the message at HL (RST $08), waits (#R$3808), and clears the
* message line again (#R$3955).
* 
* I:HL The message
show_message:                                              ; >5ffb
       .proc
       .rst >08                                            ; RST $08           ; 
       bl   @busy_wait_delay                               ; CALL $3808        ; 
       b    @clear_message_line_jmp                        ; JP $3955          ; clear the message line

********************************************************************************
* Enter flight mode: set up the cockpit screen
* 
* Used by the routine at #R$645B.
* .
* Clears $E70B, $E902 and $E949 (so there are no scanner blips to
* erase), sets $EF9E and #R$E903 (space view showing), hides all 32 sprites
* (#R$3942), uploads the missile and compass dot sprite patterns (#R$39B9,
* #R$6EC7), unpacks the cockpit screen picture (#R$7139, see
* #R$CAD7) and draws all the gauges (#R$6433). #R$60B1 is the "leave
* flight" counterpart.
enter_flight_mode:                                         ; >63f1
       .proc
       sb   a,a                                            ; XOR A             ; 
       movb a,@chart_cursor_active_flag                    ; LD ($E70B),A      ; 
       movb a,@current_screen                              ; LD ($E902),A      ; 
       movb a,@scanner_drawn_count                         ; LD ($E949),A      ; no scanner blips to erase
       sb   one,a                                          ; DEC A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; 
       movb a,@space_view_showing                          ; LD ($E903),A      ; space view showing
       li   hl,>1b00                                       ; LD HL,$1B00       ; hide all 32 sprites
       movb @bytes+>20,b                                   ; LD B,$20          ; 
       limi 0                                              ; DI                ; 
       bl   @hide_sprites                                  ; CALL $3942        ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>78,a                                   ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $3880 (sprite patterns)
       li   hl,flight_sprite_patterns                      ; LD HL,$6EC7       ; 
       bl   @write_run_length_encoded_byte_stream          ; CALL $39B9        ; upload the missile patterns
       movb @bytes+>c0,a                                   ; LD A,$C0          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>78,a                                   ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $38C0
       li   hl,compass_dot_pattern                         ; LD HL,$6ED4       ; 
       bl   @write_run_length_encoded_byte_stream          ; CALL $39B9        ; upload the compass dot pattern
       ; EI                                                ; EI                ; TODO: check code. 
       bl   @blank_screen_decompress_picture_recolour      ; CALL $7139        ; unpack the cockpit screen picture
       bl   @redraw_all_dashboard_gauges                   ; CALL $6433        ; draw all the gauges
       sb   a,a                                            ; XOR A             ; 
       movb a,@vram_busy_flag                              ; LD ($EF9E),A      ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Redraw all dashboard gauges
* 
* Used by the routines at #R$63F1 and #R$894D.
* .
* Calls all 13 dashboard-gauge-drawing routines in turn - the same set
* gated by #R$6C9E (gate_dashboard_hidden), which each of them calls
* first to skip the work when the dashboard is hidden.
redraw_all_dashboard_gauges:                               ; >6433
       .proc
       bl   @draw_speed_gauge                              ; CALL $6A59        ; the speed gauge
       bl   @draw_roll_dial                                ; CALL $6BB3        ; the roll dial
       bl   @draw_pitch_dial                               ; CALL $6BCA        ; the pitch dial
       bl   @draw_energy_banks                             ; CALL $6A88        ; the energy banks
       bl   @draw_gauge_dashboard_6b48                     ; CALL $6B48        ; the fore shield
       bl   @draw_gauge_dashboard_6b54                     ; CALL $6B54        ; the aft shield
       bl   @draw_laser_temperature                        ; CALL $6B60        ; the laser temperature
       bl   @draw_fuel_gauge                               ; CALL $6AAD        ; the fuel
       bl   @draw_missile_indicator                        ; CALL $6B6E        ; the missiles
       bl   @draw_altitude                                 ; CALL $6AC4        ; the altitude
       bl   @draw_cabin_temperature                        ; CALL $6AD0        ; the cabin temperature
       bl   @draw_station_indicator                        ; CALL $6ADC        ; the "S" indicator
       bl   @draw_ecm_indicator                            ; CALL $6B12        ; the "E" indicator
       .endproc                                            ; RET               ; 

********************************************************************************
* Switch to a new space view
* 
* Used by the routines at #R$64A1, #R$64B5, #R$64C9 and #R$64DD.
* .
* Shared tail of the four view selectors. Patches the CALL at $6944 in
* the stardust loop (#R$6911) to the view's stardust move handler. When
* not in flight, first calls #R$63F1 and sets the current view ($EB9A)
* to $FF so the view always counts as changed. If the view has changed,
* stores the new view number and copies the view's name (#R$118F: 7
* characters of 5 pixel rows) from DE into rows 1-5 of the character
* patterns at VRAM $0060-$0097 on the dashboard, then scatters a
* fresh stardust field for the new view (#R$6882). Finally shows the
* tunnel rings if launching ($E8F6, #R$6CB2), and sets up the view's
* laser (#R$6D24).
* 
* I:B New view number (0=front, 1=rear, 2=left, 3=right)
* I:DE Source data for the VRAM copy
* I:HL The view's stardust move handler
switch_view:                                               ; >645b
       mov  hl,@stardust_move_handler+>0002                ; LD ($6945),HL     ; patch the stardust move handler (#R$6944+1)
       .push de                                            ; PUSH DE           ; save DE
       movb @space_view_showing,a                          ; LD A,($E903)      ; in flight?
       socb a,a                                            ; OR A              ; 
       jne  _646f                                          ; JR NZ,$646F       ; yes
       .push bc                                            ; PUSH BC           ; 
       bl   @enter_flight_mode                             ; CALL $63F1        ; no: set up the cockpit screen (#R$63F1)
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@current_view                                ; LD ($EB9A),A      ; and make sure the view counts as changed
       .pop bc                                             ; POP BC            ; 
_646f:                                                     ; >646f
       .pop de                                             ; POP DE            ; DE -> the view's name
       movb b,a                                            ; LD A,B            ; A = the new view
       li   hl,current_view                                ; LD HL,$EB9A       ; 
       cb   a,*hl                                          ; CP (HL)           ; the same as the current view?
       jeq  _6496                                          ; JR Z,$6496        ; yes - skip
       movb a,*hl                                          ; LD (HL),A         ; set the current view
       movb @bytes+>61,a                                   ; LD A,$61          ; A = $61, the VRAM address's low byte for the name's first character
       movb @bytes+>07,@c                                  ; LD C,$07          ; 7 characters
_647c:                                                     ; >647c
       .push af                                            ; PUSH AF           ; 
       limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>40,a                                   ; LD A,$40          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $0061 + 8n: rows 1-5 of the character's pattern
       movb @bytes+>05,b                                   ; LD B,$05          ; 5 pixel rows
_6486:                                                     ; >6486
       movb *de,a                                          ; LD A,(DE)         ; copy a row of the name's pattern
       inc  de                                             ; INC DE            ; 
       movb a,@vdpwd                                       ; OUT ($98),A       ; 
       sb   one,b                                          ; DJNZ $6486        ; 
       jne  _6486                                          ;                   
       ; EI                                                ; EI                ; TODO: check code. 
       .pop af                                             ; POP AF            ; 
       ab   @bytes+>08,a                                   ; ADD A,$08         ; next character
       sb   one,@c                                         ; DEC C             ; 
       jne  _647c                                          ; JR NZ,$647C       ; 
       bl   @scatter_stardust                              ; CALL $6882        ; scatter the stardust for the new view (#R$6882)
_6496:                                                     ; >6496
       movb @show_tunnel,a                                 ; LD A,($E8F6)      ; launching?
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; CALL NZ,$6CB2     ; yes - show the tunnel rings (#R$6CB2)
       bl   @tunnel_rings                                  ;                   
!
       bl   @view_laser                                    ; CALL $6D24        ; set up the view's laser (#R$6D24)
       .ret                                                ; RET               ; 

********************************************************************************
* Switch to the front view
* 
* Used by the routines at #R$1703, #R$1837, #R$1873, #R$19FC, #R$1C5C, #R$4173
* and #R$894D.
* .
* The first of four near-identical view selectors (see also #R$64B5,
* #R$64C9 and #R$64DD). Each points ($44CF) - the self-modified
* negate-target operand inside #R$4464 - at the view's own target, then
* passes the view number, its stardust move handler and its VRAM data to
* #R$645B.
switch_to_front_view:                                      ; >64a1
       .proc
       bl   @refuse_if_docked                              ; CALL $6DCF        ; 
       li   hl,view_front                                  ; LD HL,$44E5       ; front view's negate-target inside #R$4464
       mov  hl,@convert_to_view+>0002                      ; LD ($44CF),HL     ; patch the view conversion (#R$44CE+1)
       sb   b,b                                            ; LD B,$00          ; B = 0 (front view)
       li   hl,stardust_front_view                         ; LD HL,$64F1       ; HL = front view stardust handler (#R$64F1)
       li   de,view_name_front                             ; LD DE,$118F       ; DE = front view's VRAM data
       b    @switch_view                                   ; JP $645B          ; switch view

********************************************************************************
* Stardust: move or respawn a particle in the front view
* 
* Used by the routine at #R$68CD.
* .
* The front view's stardust move handler (the default operand of the
* patched CALL at $6944). A particle flagged for respawning is given a
* random position within 63 pixels of the centre on each axis, and #R$6805
* sets its velocity to point straight out from the centre. Otherwise it is
* moved (at $6520).
* .
* At $6520, adds the particle's velocity to its position several times
* over, the number of times depending on how far the particle already is
* from the centre on that axis (the bit length of |offset|/4, minimum 1,
* from the table at $0200), so particles speed up as they fly outwards. X
* and Y are done independently.
* 
* I:F Z set to move the particle, clear to respawn it
* I:IX Pointer to the particle
stardust_front_view:                                       ; >64f1
       jeq  stardust_move_outwards                         ; JR Z,$6520        ; not flagged for respawning - go move it
       .proc
       bl   @random_byte                                   ; CALL $2176        ; A = random byte
       movb a,@l                                           ; LD L,A            ; 
       andi a,>3f00                                        ; AND $3F           ; C = |X| = 0-63
       movb a,@c                                           ; LD C,A            ; 
       ; RL L                                              ; RL L              ; TODO: check code. random sign
       jnc  _6500                                          ; JR NC,$6500       ; TODO: check code. 
       neg a                                               ; NEG               ; 
_6500:                                                     ; >6500
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb a,@>01(ix)                                     ; LD (IX+$01),A     ; set X
       bl   @random_byte                                   ; CALL $2176        ; A = random byte
       movb a,@l                                           ; LD L,A            ; 
       andi a,>3f00                                        ; AND $3F           ; B = |Y| = 0-63
       movb a,b                                            ; LD B,A            ; 
       ; RL L                                              ; RL L              ; TODO: check code. random sign
       jnc  _6514                                          ; JR NC,$6514       ; TODO: check code. 
       neg a                                               ; NEG               ; 
_6514:                                                     ; >6514
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb a,@>03(ix)                                     ; LD (IX+$03),A     ; set Y
       bl   @stardust_set_velocity                         ; CALL $6805        ; set the velocity, pointing away from the centre
       .endproc                                            ; JR $656A          ; 
stardust_move_outwards:                                    ; >6520
       movb *ix,@l                                         ; LD L,(IX+$00)     ; 
       movb @>01(ix),h                                     ; LD H,(IX+$01)     ; HL = X
       movb @>04(ix),@e                                    ; LD E,(IX+$04)     ; 
       movb @>05(ix),d                                     ; LD D,(IX+$05)     ; DE = X velocity
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6533        ; 
       b    @stardust_front_x                              ;                   
!
       neg a                                               ; NEG               ; A = |X|
stardust_front_x:                                          ; >6533
       srl  a,1                                            ; SRL A             ; 
       srl  a,1                                            ; SRL A             ; A = |X| / 4
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>02,b                                   ; LD B,$02          ; 
       movb *bc,a                                          ; LD A,(BC)         ; B = number of steps from the bit length table
       movb a,b                                            ; LD B,A            ; 
_653c:                                                     ; >653c
       a    de,hl                                          ; ADD HL,DE         ; move along X...
       sb   one,b                                          ; DJNZ $653C        ; ...that many times
       jne  _653c                                          ;                   
       movb @l,*ix                                         ; LD (IX+$00),L     ; 
       movb h,@>01(ix)                                     ; LD (IX+$01),H     ; store the new X
       movb @>02(ix),@l                                    ; LD L,(IX+$02)     ; 
       movb @>03(ix),h                                     ; LD H,(IX+$03)     ; HL = Y
       movb @>06(ix),@e                                    ; LD E,(IX+$06)     ; 
       movb @>07(ix),d                                     ; LD D,(IX+$07)     ; DE = Y velocity
       movb h,a                                            ; LD A,H            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6558        ; 
       b    @stardust_front_y                              ;                   
!
       neg a                                               ; NEG               ; A = |Y|
stardust_front_y:                                          ; >6558
       srl  a,1                                            ; SRL A             ; 
       srl  a,1                                            ; SRL A             ; A = |Y| / 4
       movb a,@c                                           ; LD C,A            ; 
       movb @bytes+>02,b                                   ; LD B,$02          ; 
       movb *bc,a                                          ; LD A,(BC)         ; B = number of steps from the bit length table
       movb a,b                                            ; LD B,A            ; 
_6561:                                                     ; >6561
       a    de,hl                                          ; ADD HL,DE         ; move along Y...
       sb   one,b                                          ; DJNZ $6561        ; ...that many times
       jne  _6561                                          ;                   
       movb @l,@>02(ix)                                    ; LD (IX+$02),L     ; 
       movb h,@>03(ix)                                     ; LD (IX+$03),H     ; store the new Y
_656a:                                                     ; >656a
       rt                                                  ; RET               ; 

********************************************************************************
* Stardust: rotate about the centre of the view
* 
* Used by the routines at #R$67B5, #R$67C3, #R$67ED and #R$67F7.
* .
* Used for roll in the front and rear views, and for pitch in the side
* views. Rotates every particle's pixel position (X,Y) about the centre
* of the view by the angle whose cosine and sine are given in HL and DE:
* X' = X*cos - Y*sin, Y' = X*sin + Y*cos. The multiplications are done
* with logarithms: #R$1FCF converts cos and sin to logs, X and Y are
* converted using the log table at $0800 (tagging the sign into bit 6 of
* the high byte), and #R$2160 adds a pair of logs to give the product.
* Then #R$6805 sets the particle's velocity from its new position.
* 
* I:HL Cosine (sign-magnitude, from the roll or pitch coefficients)
* I:DE Sine (sign-magnitude)
stardust_rotate:                                           ; >66dc
       .proc
       bl   @log_sign_tagged                               ; CALL $1FCF        ; convert cos to a log
       mov  hl,@stardust_log_cos                           ; LD ($E779),HL     ; and save it
       .ex_de_hl                                           ; EX DE,HL          ; 
       bl   @log_sign_tagged                               ; CALL $1FCF        ; convert sin to a log
       mov  hl,@stardust_log_sin                           ; LD ($E77B),HL     ; and save it
       mov  @reclaimed_range_start,ix                      ; LD IX,($EFA6)     ; IX -> the stardust table
       movb @bytes+>0f,b                                   ; LD B,$0F          ; B = 15 particles
stardust_rotate_particle:                                  ; >66ef
       .push bc                                            ; PUSH BC           ; 
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; A = X
       socb a,a                                            ; OR A              ; 
       .push af                                            ; PUSH AF           ; save its sign
       jlt  !                                              ; JP P,$66FA        ; 
       b    @stardust_rotate_log_x                         ;                   
!
       neg a                                               ; NEG               ; A = |X|
stardust_rotate_log_x:                                     ; >66fa
       ab   a,a                                            ; ADD A,A           ; 
       mov  a,r1                                           ; LD ($66FF),A      ; index the table with A (instead of patching the operand)
       srl  r1,8                                           ;                   ;
stardust_log_x_lookup:                                     ; >66fe
       mov  @log_table(r1),hl                              ; LD HL,($0800)     ; HL = log |X|
       .pop af                                             ; POP AF            ; 
       jlt  !                                              ; JP P,$6707        ; 
       b    @stardust_rotate_save_log_x                    ;                   
!
       socb @bit6,h                                        ; SET 6,H           ; tag the sign of X
stardust_rotate_save_log_x:                                ; >6707
       mov  hl,@stardust_log_x                             ; LD ($E77D),HL     ; save log X
       movb @>03(ix),a                                     ; LD A,(IX+$03)     ; A = Y
       socb a,a                                            ; OR A              ; 
       .push af                                            ; PUSH AF           ; save its sign
       jlt  !                                              ; JP P,$6714        ; 
       b    @stardust_rotate_log_y                         ;                   
!
       neg a                                               ; NEG               ; A = |Y|
stardust_rotate_log_y:                                     ; >6714
       ab   a,a                                            ; ADD A,A           ; 
       mov  a,r1                                           ; LD ($6719),A      ; index the table with A (instead of patching the operand)
       srl  r1,8                                           ;                   ;
stardust_log_y_lookup:                                     ; >6718
       mov  @log_table(r1),hl                              ; LD HL,($0800)     ; HL = log |Y|
       .pop af                                             ; POP AF            ; 
       jlt  !                                              ; JP P,$6721        ; 
       b    @stardust_rotate_save_log_y                    ;                   
!
       socb @bit6,h                                        ; SET 6,H           ; tag the sign of Y
stardust_rotate_save_log_y:                                ; >6721
       mov  hl,@stardust_log_y                             ; LD ($E77F),HL     ; save log Y
       mov  @stardust_log_sin,bc                           ; LD BC,($E77B)     ; 
       bl   @multiply_logs                                 ; CALL $2160        ; HL = Y * sin
       .ex_de_hl                                           ; EX DE,HL          ; 
       mov  @stardust_log_x,hl                             ; LD HL,($E77D)     ; 
       mov  @stardust_log_cos,bc                           ; LD BC,($E779)     ; 
       bl   @multiply_logs                                 ; CALL $2160        ; HL = X * cos
       socb a,a                                            ; OR A              ; 
       s    de,hl                                          ; SBC HL,DE         ; X' = X * cos - Y * sin
       movb @l,@>01(ix)                                    ; LD (IX+$01),L     ; store the new X
       mov  @stardust_log_x,hl                             ; LD HL,($E77D)     ; 
       mov  @stardust_log_sin,bc                           ; LD BC,($E77B)     ; 
       bl   @multiply_logs                                 ; CALL $2160        ; HL = X * sin
       .ex_de_hl                                           ; EX DE,HL          ; 
       mov  @stardust_log_y,hl                             ; LD HL,($E77F)     ; 
       mov  @stardust_log_cos,bc                           ; LD BC,($E779)     ; 
       bl   @multiply_logs                                 ; CALL $2160        ; HL = Y * cos
       a    de,hl                                          ; ADD HL,DE         ; Y' = X * sin + Y * cos
       movb @l,@>03(ix)                                    ; LD (IX+$03),L     ; store the new Y
       movb @l,a                                           ; LD A,L            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$675C        ; 
       b    @stardust_rotate_abs_y                         ;                   
!
       neg a                                               ; NEG               ; 
stardust_rotate_abs_y:                                     ; >675c
       movb a,b                                            ; LD B,A            ; B = |Y|
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6766        ; 
       b    @stardust_rotate_abs_x                         ;                   
!
       neg a                                               ; NEG               ; 
stardust_rotate_abs_x:                                     ; >6766
       movb a,@c                                           ; LD C,A            ; C = |X|
       bl   @stardust_set_velocity                         ; CALL $6805        ; set the velocity, pointing away from the centre
       li   de,>000b                                       ; LD DE,$000B       ; 
       a    de,ix                                          ; ADD IX,DE         ; IX -> next particle
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DEC B             ; 
       jeq  !                                              ; JP NZ,$66EF       ; loop for all 15 particles
       b    @stardust_rotate_particle                      ;                   
!
       .endproc                                            ; RET               ; 

********************************************************************************
* Stardust: move up or down
* 
* Used by the routines at #R$67CD, #R$67D3, #R$67DD and #R$67E3.
* .
* Used for pitch in the front and rear views, and for roll in the side
* views. Converts the sine in HL to a signed pixel count and adds it to
* every particle's Y, then sets its velocity from its new position
* (#R$6805).
* 
* I:HL Sine (sign-magnitude, from the roll or pitch coefficients)
stardust_move_vertically:                                  ; >6775
       .proc
       movb h,a                                            ; LD A,H            ; 
       ; RL L                                              ; RL L              ; TODO: check code. 
       sla  a,1                                            ; RLA               ; TODO: check code. A = magnitude bits 14-7, carry = sign
       jnc  _677d                                          ; JR NC,$677D       ; TODO: check code. 
       neg a                                               ; NEG               ; 
_677d:                                                     ; >677d
       movb a,@c                                           ; LD C,A            ; C = signed distance to move
       mov  @reclaimed_range_start,ix                      ; LD IX,($EFA6)     ; IX -> the stardust table
       movb @bytes+>0f,b                                   ; LD B,$0F          ; B = 15 particles
_6784:                                                     ; >6784
       movb @>03(ix),a                                     ; LD A,(IX+$03)     ; 
       ab   @c,a                                           ; ADD A,C           ; move the particle up or down
       movb a,@>03(ix)                                     ; LD (IX+$03),A     ; 
       .push bc                                            ; PUSH BC           ; 
       jlt  !                                              ; JP P,$6791        ; 
       b    @stardust_move_abs_y                           ;                   
!
       neg a                                               ; NEG               ; 
stardust_move_abs_y:                                       ; >6791
       movb a,b                                            ; LD B,A            ; B = |Y|
       movb @>01(ix),a                                     ; LD A,(IX+$01)     ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$679B        ; 
       b    @stardust_move_abs_x                           ;                   
!
       neg a                                               ; NEG               ; 
stardust_move_abs_x:                                       ; >679b
       movb a,@c                                           ; LD C,A            ; C = |X|
       bl   @stardust_set_velocity                         ; CALL $6805        ; set the velocity, pointing away from the centre
       li   de,>000b                                       ; LD DE,$000B       ; 
       a    de,ix                                          ; ADD IX,DE         ; IX -> next particle
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6784        ; loop for all 15 particles
       jne  _6784                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Jump to the entry for the current view in a table of handlers
* 
* Used by the routine at #R$68CD.
* .
* Used by #R$68CD to roll and pitch the stardust with the right handler
* for the current view ($EB9A).
* 
* I:HL Address of a table of 4 handler addresses (front, rear, left,
* .    right)
jump_to_view_handler:                                      ; >67a8
       movb @current_view,a                                ; LD A,($EB9A)      ; A = current view
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> this view's entry
       mov  *hl,hl                                         ; LD A,(HL)         ; HL = the handler (TI data words are big-endian)
;      inc  hl                                             ; INC HL            ; 
;      movb *hl,h                                          ; LD H,(HL)         ; 
;      movb a,@l                                           ; LD L,A            ; 
       b    *hl                                            ; JP (HL)           ; TODO. 

********************************************************************************
* Stardust: roll in the front view
* 
* Entry 0 of the roll handler table at #R$6EDD (see #R$67A8). Rotates the
* stardust (#R$66DC) by the negative of the roll angle.
stardust_roll_front:                                       ; >67b5
       mov  @roll_cos,hl                                   ; LD HL,($EB77)     ; HL = cos (roll)
       mov  @roll_sin,de                                   ; LD DE,($EB7A)     ; DE = sin (roll)
       movb d,a                                            ; LD A,D            ; 
       li   r0,128*256                                     ; XOR $80           ; 
       xor  r0,a                                           ;                   
       movb a,d                                            ; LD D,A            ; negate sin
       b    @stardust_rotate                               ; JP $66DC          ; rotate the stardust

********************************************************************************
* Stardust: roll in the rear view
* 
* Entry 1 of the roll handler table at #R$6EDD (see #R$67A8). Rotates the
* stardust (#R$66DC) by the roll angle.
stardust_roll_rear:                                        ; >67c3
       mov  @roll_cos,hl                                   ; LD HL,($EB77)     ; HL = cos (roll)
       mov  @roll_sin,de                                   ; LD DE,($EB7A)     ; DE = sin (roll)
       b    @stardust_rotate                               ; JP $66DC          ; rotate the stardust

********************************************************************************
* Stardust: roll in the left view
* 
* Entry 2 of the roll handler table at #R$6EDD (see #R$67A8). Moves the
* stardust vertically (#R$6775).
stardust_roll_left:                                        ; >67cd
       mov  @roll_sin,hl                                   ; LD HL,($EB7A)     ; HL = sin (roll)
       b    @stardust_move_vertically                      ; JP $6775          ; move the stardust up or down

********************************************************************************
* Stardust: roll in the right view
* 
* Entry 3 of the roll handler table at #R$6EDD (see #R$67A8). Moves the
* stardust vertically (#R$6775), the opposite way to the left view.
stardust_roll_right:                                       ; >67d3
       mov  @roll_sin,hl                                   ; LD HL,($EB7A)     ; HL = sin (roll)
       movb h,a                                            ; LD A,H            ; 
       li   r0,128*256                                     ; XOR $80           ; 
       xor  r0,a                                           ;                   
       movb a,h                                            ; LD H,A            ; negate it
       b    @stardust_move_vertically                      ; JP $6775          ; move the stardust up or down

********************************************************************************
* Stardust: pitch in the front view
* 
* Entry 0 of the pitch handler table at #R$6EE5 (see #R$67A8). Moves the
* stardust vertically (#R$6775).
stardust_pitch_front:                                      ; >67dd
       mov  @pitch_sin,hl                                  ; LD HL,($EB80)     ; HL = sin (pitch)
       b    @stardust_move_vertically                      ; JP $6775          ; move the stardust up or down

********************************************************************************
* Stardust: pitch in the rear view
* 
* Entry 1 of the pitch handler table at #R$6EE5 (see #R$67A8). Moves the
* stardust vertically (#R$6775), the opposite way to the front view.
stardust_pitch_rear:                                       ; >67e3
       mov  @pitch_sin,hl                                  ; LD HL,($EB80)     ; HL = sin (pitch)
       movb h,a                                            ; LD A,H            ; 
       li   r0,128*256                                     ; XOR $80           ; 
       xor  r0,a                                           ;                   
       movb a,h                                            ; LD H,A            ; negate it
       b    @stardust_move_vertically                      ; JP $6775          ; move the stardust up or down

********************************************************************************
* Stardust: pitch in the left view
* 
* Entry 2 of the pitch handler table at #R$6EE5 (see #R$67A8). Rotates the
* stardust (#R$66DC) by the pitch angle.
stardust_pitch_left:                                       ; >67ed
       mov  @pitch_cos,hl                                  ; LD HL,($EB7D)     ; HL = cos (pitch)
       mov  @pitch_sin,de                                  ; LD DE,($EB80)     ; DE = sin (pitch)
       b    @stardust_rotate                               ; JP $66DC          ; rotate the stardust

********************************************************************************
* Stardust: pitch in the right view
* 
* Entry 3 of the pitch handler table at #R$6EE5 (see #R$67A8). Rotates the
* stardust (#R$66DC) by the negative of the pitch angle.
stardust_pitch_right:                                      ; >67f7
       mov  @pitch_cos,hl                                  ; LD HL,($EB7D)     ; HL = cos (pitch)
       mov  @pitch_sin,de                                  ; LD DE,($EB80)     ; DE = sin (pitch)
       movb d,a                                            ; LD A,D            ; 
       li   r0,128*256                                     ; XOR $80           ; 
       xor  r0,a                                           ;                   
       movb a,d                                            ; LD D,A            ; negate sin
       b    @stardust_rotate                               ; JP $66DC          ; rotate the stardust

********************************************************************************
* Stardust: set a particle's velocity
* 
* Used by the routines at #R$64F1, #R$656B, #R$6628, #R$6682, #R$66DC, #R$6775
* and #R$6882.
* .
* Points the particle's velocity in direction (C,B) - normally its own
* distance from the centre (|X|,|Y|) - with the signs of X and Y, i.e.
* away from the centre. First scales C and B down together, keeping their
* ratio, until both fit in 3 bits; then looks up the 8x8 table at #R$6F1F,
* which holds a direction vector of length 63 for each (C,B) pair. With
* v = one component of that vector and b = v/4, the velocity component is
* set to v + b * speed ($F814), so the stardust moves faster the faster
* the ship is flying. b is also stored at +9/+10, as the amount by which
* #R$6956/#R$699C adjust the velocity when the speed goes up or down by
* one. Finally clears the respawn flag.
* 
* I:B |Y| (or a random 4-7 in the side views)
* I:C |X| (or a random 4-7 in the side views)
* I:IX Pointer to the particle
* O:B |Y| scaled down to 3 bits
* O:C |X| scaled down to 3 bits
stardust_set_velocity:                                     ; >6805
       movb @c,a                                           ; LD A,C            ; 
       socb b,a                                            ; OR B              ; 
       movb a,@l                                           ; LD L,A            ; 
       movb @bytes+>02,h                                   ; LD H,$02          ; 
       movb *hl,a                                          ; LD A,(HL)         ; A = bit length of (C OR B)
       sb   @bytes+>04,a                                   ; SUB $04           ; 
       jhe  !                                              ; JP M,$6818        ; both already fit in 3 bits
       b    @stardust_set_velocity_lookup                  ;                   
!
       ab   one,a                                          ; INC A             ; A = number of bits to shift out
_6811:                                                     ; >6811
       ; SRL C                                             ; SRL C             ; TODO: check code. 
       srl  b,1                                            ; SRL B             ; scale C and B down...
       sb   one,a                                          ; DEC A             ; 
       jne  _6811                                          ; JR NZ,$6811       ; ...until both fit in 3 bits
stardust_set_velocity_lookup:                              ; >6818
       .push bc                                            ; PUSH BC           ; 
       movb @c,a                                           ; LD A,C            ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   b,a                                            ; ADD A,B           ; 
       ab   a,a                                            ; ADD A,A           ; 
       movb a,@c                                           ; LD C,A            ; 
       sb   b,b                                            ; LD B,$00          ; 
       li   hl,stardust_directions                         ; LD HL,$6F1F       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> direction vector for (C,B)
       movb *hl,a                                          ; LD A,(HL)         ; A = X component
       inc  hl                                             ; INC HL            ; 
       movb *hl,@c                                         ; LD C,(HL)         ; C = Y component
       movb @>01(ix),r0                                    ; BIT 7,(IX+$01)    ; 
       andi r0,>8000                                       ;                   
       jeq  _6831                                          ; JR Z,$6831        ; 
       neg a                                               ; NEG               ; give it the sign of X
_6831:                                                     ; >6831
       movb a,@l                                           ; LD L,A            ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       sb   a,a                                            ; SBC A,A           ; 
       movb a,h                                            ; LD H,A            ; HL = v, sign-extended
       movb h,d                                            ; LD D,H            ; 
       movb @l,@e                                          ; LD E,L            ; 
       sra  d,1                                            ; SRA D             ; 
       ; RR E                                              ; RR E              ; TODO: check code. 
       sra  d,1                                            ; SRA D             ; 
       ; RR E                                              ; RR E              ; TODO: check code. DE = b = v / 4
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = speed
       socb a,a                                            ; OR A              ; 
       jeq  _6849                                          ; JR Z,$6849        ; stationary - velocity is just v
       movb a,b                                            ; LD B,A            ; 
_6846:                                                     ; >6846
       a    de,hl                                          ; ADD HL,DE         ; add b once for each unit of speed
       sb   one,b                                          ; DJNZ $6846        ; 
       jne  _6846                                          ;                   
_6849:                                                     ; >6849
       movb @l,@>04(ix)                                    ; LD (IX+$04),L     ; 
       movb h,@>05(ix)                                     ; LD (IX+$05),H     ; set the X velocity
       movb @e,@>09(ix)                                    ; LD (IX+$09),E     ; save b for speed changes
       movb @c,a                                           ; LD A,C            ; A = Y component
       movb @>03(ix),r0                                    ; BIT 7,(IX+$03)    ; 
       andi r0,>8000                                       ;                   
       jeq  _685b                                          ; JR Z,$685B        ; 
       neg a                                               ; NEG               ; give it the sign of Y
_685b:                                                     ; >685b
       movb a,@l                                           ; LD L,A            ; 
       sla  a,1                                            ; RLA               ; TODO: check code. 
       sb   a,a                                            ; SBC A,A           ; 
       movb a,h                                            ; LD H,A            ; HL = v, sign-extended
       movb h,d                                            ; LD D,H            ; 
       movb @l,@e                                          ; LD E,L            ; 
       sra  d,1                                            ; SRA D             ; 
       ; RR E                                              ; RR E              ; TODO: check code. 
       sra  d,1                                            ; SRA D             ; 
       ; RR E                                              ; RR E              ; TODO: check code. DE = b = v / 4
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = speed
       socb a,a                                            ; OR A              ; 
       jeq  _6873                                          ; JR Z,$6873        ; stationary - velocity is just v
       movb a,b                                            ; LD B,A            ; 
_6870:                                                     ; >6870
       a    de,hl                                          ; ADD HL,DE         ; add b once for each unit of speed
       sb   one,b                                          ; DJNZ $6870        ; 
       jne  _6870                                          ;                   
_6873:                                                     ; >6873
       movb @l,@>06(ix)                                    ; LD (IX+$06),L     ; 
       movb h,@>07(ix)                                     ; LD (IX+$07),H     ; set the Y velocity
       movb @e,@>0a(ix)                                    ; LD (IX+$0A),E     ; save b for speed changes
       sb   @>08(ix),@>08(ix)                              ; LD (IX+$08),$00   ; clear the respawn flag
       .pop bc                                             ; POP BC            ; restore the scaled-down C and B
       rt                                                  ; RET               ; 

********************************************************************************
* Stardust: scatter a fresh stardust field
* 
* Used by the routines at #R$645B and #R$707D.
* .
* Gives every particle a random position within 87 pixels of the centre
* horizontally and 63 vertically, and sets its velocity (#R$6805). The
* position is rerolled if either of the scaled-down |X| and |Y| values
* returned by #R$6805 is below 4 - i.e. if the particle is too near the
* centre, or much nearer one axis than the other.
scatter_stardust:                                          ; >6882
       .proc
       mov  @reclaimed_range_start,ix                      ; LD IX,($EFA6)     ; IX -> the stardust table
       movb @bytes+>0f,b                                   ; LD B,$0F          ; B = 15 particles
_6888:                                                     ; >6888
       .push bc                                            ; PUSH BC           ; 
_6889:                                                     ; >6889
       bl   @random_byte                                   ; CALL $2176        ; pick a random X...
       movb a,@l                                           ; LD L,A            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6893        ; 
       b    @scatter_stardust_x                            ;                   
!
       neg a                                               ; NEG               ; 
scatter_stardust_x:                                        ; >6893
       cb   a,@bytes+>58                                   ; CP $58            ; 
       jhe  _6889                                          ; JR NC,$6889       ; ...within 87 of the centre
       sb   *ix,*ix                                        ; LD (IX+$00),$00   ; 
       movb @l,@>01(ix)                                    ; LD (IX+$01),L     ; set X
       .ex_af_af_                                          ; EX AF,AF'         ; save |X|
_689f:                                                     ; >689f
       bl   @random_byte                                   ; CALL $2176        ; pick a random Y...
       movb a,@l                                           ; LD L,A            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$68A9        ; 
       b    @scatter_stardust_y                            ;                   
!
       neg a                                               ; NEG               ; 
scatter_stardust_y:                                        ; >68a9
       cb   a,@bytes+>40                                   ; CP $40            ; 
       jhe  _689f                                          ; JR NC,$689F       ; ...within 63 of the centre
       sb   @>02(ix),@>02(ix)                              ; LD (IX+$02),$00   ; 
       movb @l,@>03(ix)                                    ; LD (IX+$03),L     ; set Y
       movb a,b                                            ; LD B,A            ; B = |Y|
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb a,@c                                           ; LD C,A            ; C = |X|
       bl   @stardust_set_velocity                         ; CALL $6805        ; set the velocity, pointing away from the centre
       movb @c,a                                           ; LD A,C            ; 
       cb   a,@bytes+>04                                   ; CP $04            ; scaled-down |X| below 4?
       jl   _68c2                                          ; JR C,$68C2        ; yes - reroll
       movb b,a                                            ; LD A,B            ; 
       cb   a,@bytes+>04                                   ; CP $04            ; scaled-down |Y| below 4?
_68c2:                                                     ; >68c2
       jl   _6889                                          ; JR C,$6889        ; yes - reroll
       li   de,>000b                                       ; LD DE,$000B       ; 
       a    de,ix                                          ; ADD IX,DE         ; IX -> next particle
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6888        ; loop for all 15 particles
       jne  _6888                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Move and plot the stardust
* 
* Used by the routine at #R$872E.
* .
* The stardust is 15 particles held in an 11-byte-per-particle table at
* ($EFA6) (the reclaimed startup code at #R$6F9F). Each particle's position
* is relative to the centre of the 176x128 space view: +0/+1 is X and +2/+3
* is Y, both signed 8.8 fixed point (the high byte is the pixel offset);
* +4/+5 and +6/+7 are its X and Y velocities (same format); +8 is the
* respawn flag (nonzero means the particle has left the view and the move
* handler should respawn it); +9/+10 are the velocity increments applied
* per step of speed change (see #R$6805).
* .
* First applies the ship's roll and pitch, through the jump tables at #R$6EDD
* (roll) and #R$6EE5 (pitch), indexed by the current view ($EB9A: 0=front,
* 1=rear, 2=left, 3=right). In the front and rear views roll rotates the
* stardust about the centre (#R$66DC) and pitch moves it up or down
* (#R$6775); in the side views it's the other way round. Then each particle
* that's inside the view is plotted as a single pixel (#R$3CFD) and moved
* by the current view's move handler: #R$64F1 (front, particles fly out
* from the centre), #R$656B (rear, fly in from the edges), #R$6628 (left,
* right to left) or #R$6682 (right, left to right). The handler is selected
* by #R$645B patching the CALL at $6944 when the view changes. A particle
* outside the view isn't plotted, and is flagged for respawning instead (at
* $6950).
* .
* At $6902, checks X against the left edge (X < -87 is outside), then Y
* against the bottom (Y > 64) and top ($6911) edges.
* .
* At $6911, checks Y against the top edge (Y < -63 is outside). In the rear
* view, where the particles converge on the centre, a particle within 10
* pixels of the centre on both axes is respawned rather than plotted.
* Otherwise plots the particle and calls the current view's move handler,
* then loops back to #R$68CD for the next particle.
* .
* At $6950, a particle that has left the view (or, in the rear view,
* reached the centre) is flagged for respawning, and the move handler is
* called (at $6940) without plotting it, so it gets a new position.
move_and_plot_stardust:                                    ; >68cd
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; no stardust after a drive malfunction (set by #R$894D)
       socb a,a                                            ; OR A              ; 
       jeq  !                                              ; RET NZ            ; 
       .ret                                                ;                   
!
       movb @roll_rate,a                                   ; LD A,($F815)      ; A = roll rate
       socb a,a                                            ; OR A              ; 
       jeq  _68de                                          ; JR Z,$68DE        ; not rolling - skip the roll
       li   hl,stardust_roll_handlers                      ; LD HL,$6EDD       ; HL -> the per-view roll handlers
       bl   @jump_to_view_handler                          ; CALL $67A8        ; roll the stardust for this view
_68de:                                                     ; >68de
       movb @pitch_rate,a                                  ; LD A,($F816)      ; A = pitch rate
       socb a,a                                            ; OR A              ; 
       jeq  _68ea                                          ; JR Z,$68EA        ; not pitching - skip the pitch
       li   hl,stardust_pitch_handlers                     ; LD HL,$6EE5       ; HL -> the per-view pitch handlers
       bl   @jump_to_view_handler                          ; CALL $67A8        ; pitch the stardust for this view
_68ea:                                                     ; >68ea
       mov  @reclaimed_range_start,ix                      ; LD IX,($EFA6)     ; IX -> the stardust table
       movb @bytes+>0f,b                                   ; LD B,$0F          ; B = 15 particles
_68f0:                                                     ; >68f0
       .push bc                                            ; PUSH BC           ; save the particle counter
       movb @>01(ix),@e                                    ; LD E,(IX+$01)     ; E = X pixel offset
       movb @>03(ix),d                                     ; LD D,(IX+$03)     ; D = Y pixel offset
       movb @e,a                                           ; LD A,E            ; 
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$6902        ; X negative - check the left edge instead
       b    @stardust_check_left_edge                      ;                   
!
       cb   a,@bytes+>59                                   ; CP $59            ; X > 88?
       jhe  stardust_flag_respawn                          ; JR NC,$6950       ; yes - off the right edge, respawn it
       jmp  _6906                                          ; JR $6906          ; go check Y
stardust_check_left_edge:                                  ; >6902
       cb   a,@bytes+>a9                                   ; CP $A9            ; X < -87?
       jl   stardust_flag_respawn                          ; JR C,$6950        ; yes - off the left edge, respawn it
_6906:                                                     ; >6906
       movb d,a                                            ; LD A,D            ; A = Y pixel offset
       socb a,a                                            ; OR A              ; 
       jhe  !                                              ; JP M,$6911        ; Y negative - check the top edge instead
       b    @stardust_check_top_edge_and_plot              ;                   
!
       cb   a,@bytes+>41                                   ; CP $41            ; Y > 64?
       jhe  stardust_flag_respawn                          ; JR NC,$6950       ; yes - off the bottom edge, respawn it
       jmp  _6915                                          ; JR $6915          ; inside the view - go plot it
stardust_check_top_edge_and_plot:                          ; >6911
       cb   a,@bytes+>c1                                   ; CP $C1            ; Y < -63?
       jl   stardust_flag_respawn                          ; JR C,$6950        ; yes - off the top edge, respawn it
_6915:                                                     ; >6915
       movb @current_view,a                                ; LD A,($EB9A)      ; A = current view
       sb   one,a                                          ; DEC A             ; 
       jne  _6931                                          ; JR NZ,$6931       ; not the rear view - go plot it
       movb @e,a                                           ; LD A,E            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6922        ; 
       b    @stardust_check_centre_x                       ;                   
!
       neg a                                               ; NEG               ; A = |X|
stardust_check_centre_x:                                   ; >6922
       cb   a,@bytes+>0a                                   ; CP $0A            ; 
       jhe  _6931                                          ; JR NC,$6931       ; |X| >= 10 - go plot it
       movb d,a                                            ; LD A,D            ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$692D        ; 
       b    @stardust_check_centre_y                       ;                   
!
       neg a                                               ; NEG               ; A = |Y|
stardust_check_centre_y:                                   ; >692d
       cb   a,@bytes+>0a                                   ; CP $0A            ; 
       jl   stardust_flag_respawn                          ; JR C,$6950        ; |Y| < 10 too - reached the centre, respawn it
_6931:                                                     ; >6931
       movb @e,a                                           ; LD A,E            ; 
       ab   @bytes+>57,a                                   ; ADD A,$57         ; C = screen column (view centre is column 87)
       movb a,@c                                           ; LD C,A            ; 
       movb d,a                                            ; LD A,D            ; 
       ab   @bytes+>3f,a                                   ; ADD A,$3F         ; B = screen row (view centre is row 63)
       movb a,b                                            ; LD B,A            ; 
       .push ix                                            ; PUSH IX           ; 
       bl   @plot_single_pixel                             ; CALL $3CFD        ; plot the particle
       .pop ix                                             ; POP IX            ; 
_6940:                                                     ; >6940
       movb @>08(ix),a                                     ; LD A,(IX+$08)     ; Z flag = particle doesn't need respawning
       socb a,a                                            ; OR A              ; 
stardust_move_handler:                                     ; >6944
       bl   @stardust_front_view                           ; CALL $64F1        ; move or respawn it (operand patched per view by #R$645B)
       li   de,>000b                                       ; LD DE,$000B       ; 
       a    de,ix                                          ; ADD IX,DE         ; IX -> next particle
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $68F0        ; loop for all 15 particles
       jne  _68f0                                          ;                   
       .ret                                                ; RET               ; 
stardust_flag_respawn:                                     ; >6950
       movb @b255,@>08(ix)                                 ; LD (IX+$08),$FF   ; flag the particle for respawning
       jmp  _6940                                          ; JR $6940          ; go call the move handler

********************************************************************************
* Draw the speed gauge
* 
* Used by the routines at #R$6433, #R$6956 and #R$699C.
* .
* Does nothing while the redrawing is off (#R$E92B). Otherwise draws the
* speed indicator at $31B3 - which changes above speed 26, and flashes
* (#R$72C1) - and the speed gauge's bar at $11B3 (#R$6C37), from the
* speed (#R$F814, 0-30).
draw_speed_gauge:                                          ; >6a59
       .proc
       movb @redraw_speed_gauge,a                          ; LD A,($E92B)      ; 
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; RET Z             ; redrawing off (#R$E92B)
       .endproc                                            ;                   
!
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; A = the speed
       cb   a,@bytes+>1a                                   ; CP $1A            ; over 26?
       movb @bytes+>b1,a                                   ; LD A,$B1          ; colour $B1
       joc  _6a69                                          ; JR C,$6A69        ; TODO: check code. no
       movb @bytes+>81,a                                   ; LD A,$81          ; yes: colour $81
_6a69:                                                     ; >6a69
       movb a,@e913_status_toggle                          ; LD ($E913),A      ; the colour the indicator flashes with (#R$E913)
       movb @bytes+>03,@c                                  ; LD C,$03          ; 3 cells
       li   hl,>31b3                                       ; LD HL,$31B3       ; at $31B3, the indicator's colours
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; colour it (#R$6CA8)
       movb @speed_gauge_value,a                           ; LD A,($F814)      ; 
       movb @bytes+>18,@e                                  ; LD E,$18          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = the speed * 24
       movb @bytes+>1e,a                                   ; LD A,$1E          ; 
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = the speed * 24 / 30 (#R$2079)
       movb @l,a                                           ; LD A,L            ; A = the bar's length (0-24)
       li   hl,>11b3                                       ; LD HL,$11B3       ; the speed gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the energy banks
* 
* Used by the routines at #R$190D, #R$19EC and #R$6433.
* .
* Does nothing if the dashboard isn't shown (#R$6C9E). Draws the energy
* (#R$F817) as four bars (#R$6C37) of up to 24 each, one above the other,
* filling the bottom one first (at $6A9C for the bar that isn't full).
draw_energy_banks:                                         ; >6a88
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       li   hl,>17b0                                       ; LD HL,$17B0       ; HL = $17B0, the bottom bar's VRAM address
       movb @energy_gauge,a                                ; LD A,($F817)      ; A = the energy
       movb @bytes+>04,b                                   ; LD B,$04          ; 4 bars
_6a93:                                                     ; >6a93
       cb   a,@bytes+>19                                   ; CP $19            ; 
       jl   continuation_rows_value_under_per_row          ; JR C,$6A9C        ; less than a full bar left
       movb @bytes+>18,@c                                  ; LD C,$18          ; 
       sb   @c,a                                           ; SUB C             ; a full bar (24)
       jmp  _6a9e                                          ; JR $6A9E          ; 
continuation_rows_value_under_per_row:                     ; >6a9c
       movb a,@c                                           ; LD C,A            ; a partial bar...
       sb   a,a                                            ; XOR A             ; ...and nothing left for the ones above
_6a9e:                                                     ; >6a9e
       .push af                                            ; PUSH AF           ; 
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb @c,a                                           ; LD A,C            ; 
       bl   @draw_bar_gauge                                ; CALL $6C37        ; draw the bar (#R$6C37)
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       .pop af                                             ; POP AF            ; 
       sb   one,h                                          ; DEC H             ; 
       ab   one,@l                                         ; INC L             ; the next bar up (a character row up and a pixel row down)
       sb   one,b                                          ; DJNZ $6A93        ; 
       jne  _6a93                                          ;                   
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw the fuel gauge [dashboard]
* 
* Used by the routines at #R$1577, #R$6433 and #R$894D.
* .
* Draws the fuel (#R$F775, 0-70) as a bar of 0-24 pixels (#R$6C37). Does
* nothing if the dashboard isn't shown (#R$6C9E).
draw_fuel_gauge:                                           ; >6aad
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @fuel_level,a                                  ; LD A,($F775)      ; A = the fuel
       movb @bytes+>18,@e                                  ; LD E,$18          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = fuel * 24 (#R$1F60)
       movb @bytes+>46,a                                   ; LD A,$46          ; 
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = fuel * 24 / 70 (#R$2079)
       movb @l,a                                           ; LD A,L            ; 
       li   hl,>1339                                       ; LD HL,$1339       ; the fuel gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the altitude gauge [dashboard]
* 
* Used by the routines at #R$1577 and #R$6433.
* .
* Draws the altitude (#R$F812) as a bar (#R$6C37). Does nothing if the
* dashboard isn't shown (#R$6C9E).
draw_altitude:                                             ; >6ac4
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @altitude_gauge,a                              ; LD A,($F812)      ; A = the altitude
       li   hl,>1639                                       ; LD HL,$1639       ; the altitude gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the cabin temperature gauge [dashboard]
* 
* Used by the routines at #R$1577 and #R$6433.
* .
* Draws the cabin temperature (#R$F811) as a bar (#R$6C37). Does nothing if
* the dashboard isn't shown (#R$6C9E).
draw_cabin_temperature:                                    ; >6ad0
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @cabin_temperature,a                           ; LD A,($F811)      ; A = the cabin temperature
       li   hl,>1439                                       ; LD HL,$1439       ; the cabin temperature gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the "S" (space station in range) indicator
* 
* Used by the routines at #R$1549 and #R$6433.
* .
* Draws the console's "S" (#R$6EFF) if ($EB05) is 1, i.e. the ship is
* inside the space station's safe zone (see #R$1549); otherwise blanks it
* (at $6B05). Does nothing if the dashboard isn't shown (#R$6C9E).
draw_station_indicator:                                    ; >6adc
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @station_in_range,a                            ; LD A,($EB05)      ; 
       sb   one,a                                          ; DEC A             ; the space station in range?
       jne  continuation_blank_status_lamp_tile            ; JR NZ,$6B05       ; no - blank the indicator
       limi 0                                              ; DI                ; 
       movb @bytes+>a0,a                                   ; LD A,$A0          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>56,a                                   ; LD A,$56          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $16A0: the pattern of row 22, column 20
       li   hl,station_indicator_glyph                     ; LD HL,$6EFF       ; HL -> the "S" glyph (#R$6EFF)
       movb @bytes+>08,b                                   ; LD B,$08          ; its first 8 rows
       bl   @copy_to_vram                                  ; CALL $3830        ; write them (#R$3830)
       movb @bytes+>a0,a                                   ; LD A,$A0          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>57,a                                   ; LD A,$57          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $17A0: row 23, column 20
       movb @bytes+>04,b                                   ; LD B,$04          ; its last 4 rows
       bl   @copy_to_vram                                  ; CALL $3830        ; write them
       jmp  _6b10                                          ; JR $6B10          ; 
continuation_blank_status_lamp_tile:                       ; >6b05
       li   hl,>16a0                                       ; LD HL,$16A0       ; HL = $16A0 again
       movb @bytes+>0c,b                                   ; LD B,$0C          ; 12 pixel rows
       movb one,@c                                         ; LD C,$01          ; 1 character
       sb   a,a                                            ; XOR A             ; of 0
       bl   @fill_vram_rect                                ; CALL $35B8        ; blank the indicator (#R$35B8)
_6b10:                                                     ; >6b10
       ; EI                                                ; EI                ; TODO: check code. 
       .endproc                                            ; RET               ; 

********************************************************************************
* Show or hide the "E" (ECM) indicator
* 
* Used by the routines at #R$25B9, #R$3223, #R$323C and #R$6433.
* .
* Shows the console's "E" (#R$6F0B) while the ECM is on (#R$E912
* nonzero), otherwise blanks it (at $6B3B). Does nothing if the dashboard
* isn't shown (#R$6C9E).
draw_ecm_indicator:                                        ; >6b12
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @ecm_countdown,a                               ; LD A,($E912)      ; 
       socb a,a                                            ; OR A              ; ECM on?
       jeq  continuation_blank_status_lamp_tile_6b3b       ; JR Z,$6B3B        ; no - blank the indicator
       limi 0                                              ; DI                ; 
       movb @bytes+>50,a                                   ; LD A,$50          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>56,a                                   ; LD A,$56          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1650: the pattern of row 22, column 10
       li   hl,ecm_indicator_glyph                         ; LD HL,$6F0B       ; HL -> the "E" glyph (#R$6F0B)
       movb @bytes+>08,b                                   ; LD B,$08          ; its first 8 rows
       bl   @copy_to_vram                                  ; CALL $3830        ; write them (#R$3830)
       movb @bytes+>50,a                                   ; LD A,$50          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>57,a                                   ; LD A,$57          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1750: row 23, column 10
       movb @bytes+>04,b                                   ; LD B,$04          ; its last 4 rows
       bl   @copy_to_vram                                  ; CALL $3830        ; write them
       jmp  _6b46                                          ; JR $6B46          ; 
continuation_blank_status_lamp_tile_6b3b:                  ; >6b3b
       li   hl,>1650                                       ; LD HL,$1650       ; HL = $1650 again
       movb @bytes+>0c,b                                   ; LD B,$0C          ; 12 pixel rows
       movb one,@c                                         ; LD C,$01          ; 1 character
       sb   a,a                                            ; XOR A             ; of 0
       bl   @fill_vram_rect                                ; CALL $35B8        ; blank the indicator (#R$35B8)
_6b46:                                                     ; >6b46
       ; EI                                                ; EI                ; TODO: check code. 
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw the fore shield gauge [dashboard]
* 
* Used by the routines at #R$1928, #R$193F and #R$6433.
draw_gauge_dashboard_6b48:                                 ; >6b48
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; 
       movb @fore_shield,a                                 ; LD A,($F80F)      ; 
       li   hl,>113b                                       ; LD HL,$113B       ; 
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; 

********************************************************************************
* Draw the aft shield gauge [dashboard]
* 
* Used by the routines at #R$1928, #R$193F and #R$6433.
draw_gauge_dashboard_6b54:                                 ; >6b54
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; 
       movb @aft_shield,a                                  ; LD A,($F810)      ; 
       li   hl,>123a                                       ; LD HL,$123A       ; 
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; 

********************************************************************************
* Draw the laser temperature gauge [dashboard]
* 
* Used by the routines at #R$190D, #R$2AD0 and #R$6433.
* .
* Draws the laser temperature (#R$F813) / 2 as a bar (#R$6C37). Does nothing
* if the dashboard isn't shown (#R$6C9E).
draw_laser_temperature:                                    ; >6b60
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb @laser_temp_gauge,a                            ; LD A,($F813)      ; 
       srl  a,1                                            ; SRL A             ; A = the laser temperature / 2
       li   hl,>1539                                       ; LD HL,$1539       ; the laser temperature gauge
       b    @draw_bar_gauge_jmp                            ; JP $6C37          ; draw it (#R$6C37)

********************************************************************************
* Draw the missile indicator
* 
* Used by the routines at #R$2D58, #R$2D70, #R$2D7E, #R$46CA and #R$6433.
* .
* Does nothing unless the dashboard is showing (#R$6C9E). Sets the four
* sprites 4-7 (from $1B10 in the sprite attribute table, #R$39A4) along the
* dashboard: one for each missile the ship can carry, in green for each
* missile it has (#R$F776) - except the next to be fired, which is light
* red when armed and dark red when locked on (#R$E910) - and an empty
* pattern for the rest.
* .
* At $6B8F, uses the missile pattern, coloured light red if it's the next
* to be fired and armed, dark red if locked on, otherwise green ($6BA3).
* .
* At $6BA5, sets this missile's sprite (#R$39A4) and moves on to the next,
* 6 pixels to the right.
draw_missile_indicator:                                    ; >6b6e
       .proc
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; do nothing unless the dashboard is showing
       limi 0                                              ; DI                ; 
       movb @bytes+>10,a                                   ; LD A,$10          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>5b,a                                   ; LD A,$5B          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address $1B10: sprite 4's attributes
       ; EI                                                ; EI                ; TODO: check code. 
       li   bc,>b838                                       ; LD BC,$B838       ; y = $B8, x = $38
       mov  @missile_count,hl                              ; LD HL,($F776)     ; L = number of missiles
       movb one,h                                          ; LD H,$01          ; H = 1 for the first
_6b83:                                                     ; >6b83
       movb h,a                                            ; LD A,H            ; 
       cb   a,@l                                           ; CP L              ; 
       jeq  draw_missile_indicator_2                       ; JR Z,$6B8F        ; the next to be fired
       joc  draw_missile_indicator_2                       ; JR C,$6B8F        ; TODO: check code. one the ship has
       movb @bytes+>14,d                                   ; LD D,$14          ; no missile: the empty pattern...
       movb @bytes+>0f,@e                                  ; LD E,$0F          ; ...in white
       jmp  _6ba5                                          ; JR $6BA5          ; 
draw_missile_indicator_2:                                  ; >6b8f
       movb @bytes+>10,d                                   ; LD D,$10          ; the missile pattern
       jne  draw_missile_indicator_3                       ; JR NZ,$6BA3       ; not the next to be fired
       movb @missile_state,a                               ; LD A,($E910)      ; A = missile state
       socb a,a                                            ; OR A              ; 
       jeq  draw_missile_indicator_3                       ; JR Z,$6BA3        ; not armed
       cb   a,@bytes+>02                                   ; CP $02            ; 
       movb @bytes+>09,@e                                  ; LD E,$09          ; armed: light red
       jne  _6ba1                                          ; JR NZ,$6BA1       ; 
       movb @bytes+>06,@e                                  ; LD E,$06          ; locked on: dark red
_6ba1:                                                     ; >6ba1
       jmp  _6ba5                                          ; JR $6BA5          ; 
draw_missile_indicator_3:                                  ; >6ba3
       movb @bytes+>02,@e                                  ; LD E,$02          ; green
_6ba5:                                                     ; >6ba5
       bl   @set_sprite                                    ; CALL $39A4        ; set the sprite
       movb @c,a                                           ; LD A,C            ; 
       ab   @bytes+>06,a                                   ; ADD A,$06         ; 6 pixels to the right
       movb a,@c                                           ; LD C,A            ; 
       ab   one,h                                          ; INC H             ; next missile
       movb h,a                                            ; LD A,H            ; 
       cb   a,@bytes+>05                                   ; CP $05            ; all four done?
       jne  _6b83                                          ; JR NZ,$6B83       ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw the roll dial [dashboard]
* 
* Used by the routines at #R$6433 and #R$6BE1.
* .
* Draws the roll rate (#R$F815, -16 to 16) as a pixel at (rate + 16) * 22 / 32
* + 1 on the roll dial (#R$6C71).
draw_roll_dial:                                            ; >6bb3
       .proc
       movb @roll_rate,a                                   ; LD A,($F815)      ; A = the roll rate
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       movb @bytes+>16,@e                                  ; LD E,$16          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = (rate + 16) * 22 (#R$1F60)
       movb @bytes+>20,a                                   ; LD A,$20          ; 
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = (rate + 16) * 22 / 32 (#R$2079)
       movb @l,a                                           ; LD A,L            ; 
       ab   one,a                                          ; INC A             ; 
       li   hl,>12b3                                       ; LD HL,$12B3       ; the roll dial
       b    @draw_dial_gauge                               ; JP $6C71          ; draw it (#R$6C71)

********************************************************************************
* Draw the pitch dial [dashboard]
* 
* Used by the routines at #R$6433 and #R$6BE1.
* .
* Draws the pitch rate (#R$F816, -16 to 16) as a pixel at (rate + 16) * 22 /
* 32 + 1 on the pitch dial (#R$6C71).
draw_pitch_dial:                                           ; >6bca
       .proc
       movb @pitch_rate,a                                  ; LD A,($F816)      ; A = the pitch rate
       ab   @bytes+>10,a                                   ; ADD A,$10         ; 
       movb @bytes+>16,@e                                  ; LD E,$16          ; 
       .call @multiply_a_e_16bit                           ; CALL $1F60        ; HL = (rate + 16) * 22 (#R$1F60)
       movb @bytes+>20,a                                   ; LD A,$20          ; 
       bl   @divide_hl_a                                   ; CALL $2079        ; HL = (rate + 16) * 22 / 32 (#R$2079)
       movb @l,a                                           ; LD A,L            ; 
       ab   one,a                                          ; INC A             ; 
       li   hl,>13b3                                       ; LD HL,$13B3       ; the pitch dial
       b    @draw_dial_gauge                               ; JP $6C71          ; draw it (#R$6C71)

********************************************************************************
* Draw a bar gauge [dashboard]
* 
* Used by the routines at #R$6A59, #R$6A88, #R$6AAD, #R$6AC4, #R$6AD0, #R$6B48,
* #R$6B54 and #R$6B60.
* .
* Draws a bar A pixels long (0-24) across the three 8-pixel character cells
* of a dashboard gauge, 4 pixel rows tall (#R$6CA8): A / 8 full cells, a
* cell with the first A mod 8 pixels set (from #R$6DE3), then empty cells.
* Does nothing if the dashboard isn't shown (#R$6C9E).
* 
* I:A The bar's length in pixels (0-24)
* I:HL The VRAM address of the gauge's first cell
draw_bar_gauge:                                            ; >6c37
       .proc
draw_bar_gauge_jmp:
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb a,@e                                           ; LD E,A            ; E = the length
       sb   d,d                                            ; LD D,$00          ; D = 0, the number of cells drawn
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; A = the number of full cells
       jeq  _6c52                                          ; JR Z,$6C52        ; none
       movb a,@c                                           ; LD C,A            ; C = the number of full cells
       movb a,d                                            ; LD D,A            ; D = the cells drawn
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       ab   a,a                                            ; ADD A,A           ; 
       sb   @e,a                                           ; SUB E             ; 
       neg a                                               ; NEG               ; 
       movb a,@e                                           ; LD E,A            ; E = the pixels left over (length mod 8)
       movb @b255,a                                        ; LD A,$FF          ; all pixels set
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw the full cells (#R$6CA8)
_6c52:                                                     ; >6c52
       movb @e,a                                           ; LD A,E            ; 
       socb a,a                                            ; OR A              ; 
       jeq  _6c66                                          ; JR Z,$6C66        ; no pixels left over
       ab   one,d                                          ; INC D             ; one more cell drawn
       li   ix,gauge_bar_patterns                          ; LD IX,$6DE3       ; IX -> the partial cell patterns (#R$6DE3)
       movb a,@bar_gauge_partial_pattern+>0003             ; LD ($6C60),A      ; patch the displacement (#R$6C5E+2)
bar_gauge_partial_pattern:                                 ; >6c5e
       movb @>00(ix),a                                     ; LD A,(IX+$00)     ; A = the pattern for that many pixels
       movb one,@c                                         ; LD C,$01          ; one cell
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw it
_6c66:                                                     ; >6c66
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       sb   d,a                                            ; SUB D             ; 
       jeq  _6c70                                          ; JR Z,$6C70        ; all 3 cells drawn
       movb a,@c                                           ; LD C,A            ; C = the cells left
       sb   a,a                                            ; XOR A             ; empty
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw them
_6c70:                                                     ; >6c70
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw a dial gauge [dashboard]
* 
* Used by the routines at #R$6BB3 and #R$6BCA.
* .
* Draws a single pixel at position A (0-23) across the three 8-pixel
* character cells of a dashboard gauge, 4 pixel rows tall (#R$6CA8): empty
* cells up to the one with the pixel, the pixel (from #R$E700), then empty
* cells. Used for the roll and pitch dials. Does nothing if the dashboard
* isn't shown (#R$6C9E).
* 
* I:A The pixel's position (0-23)
* I:HL The VRAM address of the gauge's first cell
draw_dial_gauge:                                           ; >6c71
       bl   @gate_dashboard_hidden                         ; CALL $6C9E        ; return if the dashboard isn't shown (#R$6C9E)
       movb one,d                                          ; LD D,$01          ; D = 1 (counting the cell with the pixel)
       movb a,@e                                           ; LD E,A            ; E = the position
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       andi a,>1f00                                        ; AND $1F           ; A = the number of empty cells before the pixel
       jeq  _6c85                                          ; JR Z,$6C85        ; none
       movb a,@c                                           ; LD C,A            ; 
       ab   d,a                                            ; ADD A,D           ; 
       movb a,d                                            ; LD D,A            ; D = the cells drawn
       sb   a,a                                            ; XOR A             ; empty
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw them (#R$6CA8)
_6c85:                                                     ; >6c85
       movb @e,a                                           ; LD A,E            ; 
       andi a,>0700                                        ; AND $07           ; the pixel's position in its cell
       mov  a,r1                                           ; LD ($6C8C),A      ; index the table with A (instead of patching the operand)
       srl  r1,8                                           ;                   ;
dial_gauge_pixel_mask:                                     ; >6c8b
       movb @pixel_bitmask_table(r1),a                     ; LD A,($E704)      ; A = the pixel's mask (#R$E700)
       movb one,@c                                         ; LD C,$01          ; one cell
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw it
       movb @bytes+>03,a                                   ; LD A,$03          ; 
       sb   d,a                                            ; SUB D             ; 
       jeq  _6c9d                                          ; JR Z,$6C9D        ; all 3 cells drawn
       movb a,@c                                           ; LD C,A            ; C = the cells left
       sb   a,a                                            ; XOR A             ; empty
       bl   @draw_gauge_tiles                              ; CALL $6CA8        ; draw them
_6c9d:                                                     ; >6c9d
       .ret                                                ; RET               ; 

********************************************************************************
* Dashboard-hidden gate: skip both this routine and its caller if $E903=0
* 
* Used by the routines at #R$2DC8, #R$6A88, #R$6AAD, #R$6AC4, #R$6AD0, #R$6ADC,
* #R$6B12, #R$6B48, #R$6B54, #R$6B60, #R$6B6E, #R$6C37, #R$6C71 and #R$85FB.
* .
* All the dashboard-gauge-drawing routines below call this first. When the
* dashboard is hidden ($E903=0) it POPs the caller's own return address off
* the stack before returning, so RET here unwinds two levels - both this
* routine and whichever gauge routine called it - skipping the drawing work
* entirely.
gate_dashboard_hidden:                                     ; >6c9e
       .proc
       .ex_af_af_                                          ; EX AF,AF'         ; 
       movb @space_view_showing,a                          ; LD A,($E903)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _6ca6                                          ; JR NZ,$6CA6       ; 
       .pop af                                             ; POP AF            ; 
_6ca6:                                                     ; >6ca6
       .ex_af_af_                                          ; EX AF,AF'         ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Draw C tiles (4 pixel-rows tall) at HL using pattern A [dashboard]
* 
* Used by the routines at #R$6A59, #R$6C37 and #R$6C71.
* .
* A thin wrapper around #R$35B8 with the height fixed at 4; HL (the VRAM
* address) and C (the tile count) are left set by the caller.
draw_gauge_tiles:                                          ; >6ca8
       .proc
       .push de                                            ; PUSH DE           ; 
       movb a,@e                                           ; LD E,A            ; 
       movb @bytes+>04,b                                   ; LD B,$04          ; 
       bl   @fill_vram_rect                                ; CALL $35B8        ; 
       ; EI                                                ; EI                ; TODO: check code. 
       .pop de                                             ; POP DE            ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Show the tunnel rings
* 
* Used by the routines at #R$1873, #R$645B and #R$894D.
* .
* The effect for launching (#R$645B, when $E8F6 is set by #R$1837),
* docking (#R$1873) and hyperspace (#R$894D): clears the space view
* (#R$388F), plays sound effect 7, and draws three circles (#R$3D0E)
* that grow outwards - radii starting at 2, 26 and 68 and growing by 4,
* 7 and 10 each frame - 6 frames at a time (#R$3846), four times over.
* The line drawing is switched from OR to XOR meanwhile (at $3CA8 and
* $3CE7), so that each ring is drawn over the last.
tunnel_rings:                                              ; >6cb2
       .proc
       bl   @clear_space_view                              ; CALL $388F        ; clear the space view
       movb @bytes+>a9,a                                   ; LD A,$A9          ; 
       movb a,@shallow_line_plot_op                        ; LD ($3CA8),A      ; draw lines with XOR
       movb a,@steep_line_plot_op                          ; LD ($3CE7),A      ; 
       movb @bytes+>07,a                                   ; LD A,$07          ; 
;       .call @play_sound_effect                            ; CALL $7468        ; play sound effect 7
       movb @bytes+>04,b                                   ; LD B,$04          ; four times
_6cc4:                                                     ; >6cc4
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>02,a                                   ; LD A,$02          ; 
       movb a,@tunnel_ring_radii                           ; LD ($E776),A      ; first ring's radius
       movb @bytes+>1a,a                                   ; LD A,$1A          ; 
       movb a,@tunnel_ring_radius_2                        ; LD ($E777),A      ; second's
       movb @bytes+>44,a                                   ; LD A,$44          ; 
       movb a,@tunnel_ring_radius_3                        ; LD ($E778),A      ; third's
       movb @bytes+>06,b                                   ; LD B,$06          ; 6 frames
_6cd6:                                                     ; >6cd6
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>04,@c                                  ; LD C,$04          ; 
       li   hl,tunnel_ring_radii                           ; LD HL,$E776       ; the radii
       movb @bytes+>03,b                                   ; LD B,$03          ; 3 rings
_6cde:                                                     ; >6cde
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb *hl,@l                                         ; LD L,(HL)         ; 
       sb   h,h                                            ; LD H,$00          ; 
       movb @bytes+>03,b                                   ; LD B,$03          ; 
       li   de,>0010                                       ; LD DE,$0010       ; 
       li   ix,>0000                                       ; LD IX,$0000       ; 
       li   iy,>0000                                       ; LD IY,$0000       ; 
       mov  hl,@tunnel_ring_radius                         ; LD ($E921),HL     ; 
       bl   @draw_circle                                   ; CALL $3D0E        ; draw a ring
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       ab   @c,a                                           ; ADD A,C           ; 
       movb a,*hl                                          ; LD (HL),A         ; grow it by 4, 7 or 10
       inc  hl                                             ; INC HL            ; 
       ab   one,@c                                         ; INC C             ; 
       ab   one,@c                                         ; INC C             ; 
       ab   one,@c                                         ; INC C             ; 
       sb   one,b                                          ; DJNZ $6CDE        ; next ring
       jne  _6cde                                          ;                   
       movb @message_timer,a                               ; LD A,($E919)      ; 
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6D0D        ; 
       b    @tunnel_rings_show                             ;                   
!
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@message_timer                               ; LD ($E919),A      ; 
tunnel_rings_show:                                         ; >6d0d
       bl   @copy_space_view                               ; CALL $3846        ; copy the space view to the screen
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6CD6        ; next frame
       jne  _6cd6                                          ;                   
       .pop bc                                             ; POP BC            ; 
       sb   one,b                                          ; DJNZ $6CC4        ; 
       jne  _6cc4                                          ;                   
       movb @b255,a                                        ; LD A,$FF          ; 
       movb a,@tunnel_rings_finished                       ; LD ($E923),A      ; 
       movb @bytes+>b1,a                                   ; LD A,$B1          ; 
       movb a,@shallow_line_plot_op                        ; LD ($3CA8),A      ; draw lines with OR again
       movb a,@steep_line_plot_op                          ; LD ($3CE7),A      ; 
       .endproc                                            ; RET               ; 

********************************************************************************
* Set up the laser for the current view
* 
* Used by the routine at #R$645B.
* .
* Called when the view changes (#R$645B). Finds which laser is fitted to
* the current view (#R$EB9A): each laser's entry in the equipment has one
* bit per mount (bit 0 front, 1 rear, 2 left, 3 right), and they're checked
* in the order pulse (#R$F779), mining (#R$F781), beam (#R$F77A) and
* military (#R$F782) - the last one fitted wins. On the title screen
* ($E940) there's none. Stores the laser type (0-3, or $FF for none) in
* #R$F818; with none, hides the crosshair sprites, otherwise sets up the
* laser ($6D82).
* .
* At $6D82, looks up the laser type's record at #R$6EB3: its cooldown
* between shots (#R$F819) and power (#R$F81A), and its crosshair pattern
* (#R$6DEB), which it uploads to the sprite patterns at $3800 (#R$39B9);
* then sets up the crosshair as four 16x16 sprites around the middle of the
* view (#R$39A4), in the laser type's colour.
view_laser:                                                ; >6d24
       .proc
       movb @b255,@c                                       ; LD C,$FF          ; no laser yet
       movb @e940_gate_flag,a                              ; LD A,($E940)      ; 
       socb a,a                                            ; OR A              ; 
       jne  _6d6e                                          ; JR NZ,$6D6E       ; the title screen - no laser
       movb @current_view,a                                ; LD A,($EB9A)      ; A = current view
       movb a,b                                            ; LD B,A            ; 
       ab   one,b                                          ; INC B             ; 
       movb @bytes+>80,a                                   ; LD A,$80          ; 
_6d33:                                                     ; >6d33
       sla  a,1                                            ; RLCA              ; TODO: check code. 
       sb   one,b                                          ; DJNZ $6D33        ; A = the view's mount bit
       jne  _6d33                                          ;                   
       movb b,d                                            ; LD D,B            ; 
       movb @b255,@c                                       ; LD C,$FF          ; 
       movb a,@e                                           ; LD E,A            ; E = mount bit
       movb @item_pulse_laser,a                            ; LD A,($F779)      ; pulse laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d46                                          ; JR Z,$6D46        ; not fitted
       movb b,d                                            ; LD D,B            ; 
       ; AND E                                             ; AND E             ; TODO: check code. 
       jeq  _6d46                                          ; JR Z,$6D46        ; not on this mount
       movb b,@c                                           ; LD C,B            ; type 0
_6d46:                                                     ; >6d46
       ab   one,b                                          ; INC B             ; 
       movb @item_mining_laser,a                           ; LD A,($F781)      ; mining laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d53                                          ; JR Z,$6D53        ; 
       movb b,d                                            ; LD D,B            ; 
       ; AND E                                             ; AND E             ; TODO: check code. 
       jeq  _6d53                                          ; JR Z,$6D53        ; 
       movb b,@c                                           ; LD C,B            ; type 1
_6d53:                                                     ; >6d53
       ab   one,b                                          ; INC B             ; 
       movb @item_beam_laser,a                             ; LD A,($F77A)      ; beam laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d60                                          ; JR Z,$6D60        ; 
       movb b,d                                            ; LD D,B            ; 
       ; AND E                                             ; AND E             ; TODO: check code. 
       jeq  _6d60                                          ; JR Z,$6D60        ; 
       movb b,@c                                           ; LD C,B            ; type 2
_6d60:                                                     ; >6d60
       ab   one,b                                          ; INC B             ; 
       movb @item_military_laser,a                         ; LD A,($F782)      ; military laser
       andi a,>0f00                                        ; AND $0F           ; 
       jeq  _6d6d                                          ; JR Z,$6D6D        ; 
       movb b,d                                            ; LD D,B            ; 
       ; AND E                                             ; AND E             ; TODO: check code. 
       jeq  _6d6d                                          ; JR Z,$6D6D        ; 
       movb b,@c                                           ; LD C,B            ; type 3
_6d6d:                                                     ; >6d6d
       ab   one,b                                          ; INC B             ; 
_6d6e:                                                     ; >6d6e
       movb d,a                                            ; LD A,D            ; 
       movb a,@flag_search_result_cache                    ; LD ($EFA0),A      ; 
       movb @c,a                                           ; LD A,C            ; 
       movb a,@view_laser_type                             ; LD ($F818),A      ; the laser type for this view
       socb a,a                                            ; OR A              ; 
       jlt  !                                              ; JP P,$6D82        ; there is one - set it up
       b    @set_up_laser                                  ;                   
!
       li   hl,>1b00                                       ; LD HL,$1B00       ; none: hide the crosshair sprites
       movb @bytes+>04,b                                   ; LD B,$04          ; 
       b    @hide_sprites_jmp                              ; JP $3942          ; 
set_up_laser:                                              ; >6d82
       movb a,@e                                           ; LD E,A            ; E = the laser type
       ab   a,a                                            ; ADD A,A           ; A = type * 5
       ab   a,a                                            ; ADD A,A           ; 
       ab   @e,a                                           ; ADD A,E           ; 
       movb a,@e                                           ; LD E,A            ; 
       sb   d,d                                            ; LD D,$00          ; 
       li   hl,laser_types                                 ; LD HL,$6EB3       ; the laser types
       a    de,hl                                          ; ADD HL,DE         ; HL -> this type's record
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@laser_cooldown                              ; LD ($F819),A      ; laser cooldown
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb a,@laser_power                                 ; LD ($F81A),A      ; laser power
       movb *hl,@e                                         ; LD E,(HL)         ; E = the crosshair colour
       inc  hl                                             ; INC HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
       movb *hl,h                                          ; LD H,(HL)         ; 
       movb a,@l                                           ; LD L,A            ; HL = the RLE pattern stream pointer (record bytes 3-4)
       limi 0                                              ; DI                ; 
       sb   a,a                                            ; LD A,$00          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb @bytes+>78,a                                   ; LD A,$78          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, write mode: $3800 (sprite pattern table)
       bl   @write_run_length_encoded_byte_stream          ; CALL $39B9        ; write the RLE-encoded pattern
       sb   a,a                                            ; LD A,$00          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; VRAM address low byte
       movb @bytes+>5b,a                                   ; LD A,$5B          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; ...high byte, write mode: $1B00 (sprite attribute table)
       li   bc,>3870                                       ; LD BC,$3870       ; initial (row, column)
       sb   d,d                                            ; LD D,$00          ; pattern/colour base
       movb @bytes+>02,@l                                  ; LD L,$02          ; 2 columns
_6db8:                                                     ; >6db8
       .push bc                                            ; PUSH BC           ; 
       movb @bytes+>02,h                                   ; LD H,$02          ; 2 rows
_6dbb:                                                     ; >6dbb
       bl   @set_sprite                                    ; CALL $39A4        ; write this quadrant's sprite-attribute entry
       movb b,a                                            ; LD A,B            ; 
       ab   @bytes+>10,a                                   ; ADD A,$10         ; next row, 16 pixels down
       movb a,b                                            ; LD B,A            ; 
       sb   one,h                                          ; DEC H             ; 
       jne  _6dbb                                          ; JR NZ,$6DBB       ; next row
       .pop bc                                             ; POP BC            ; 
       movb @c,a                                           ; LD A,C            ; 
       ab   @bytes+>10,a                                   ; ADD A,$10         ; next column, 16 pixels across
       movb a,@c                                           ; LD C,A            ; 
       sb   one,@l                                         ; DEC L             ; 
       jne  _6db8                                          ; JR NZ,$6DB8       ; next column
       ; EI                                                ; EI                ; TODO: check code. 
       .endproc                                            ; RET               ; 

********************************************************************************
* Refuse a flight command while docked
* 
* Used by the routines at #R$19FC, #R$1A8A, #R$1B13, #R$1B25, #R$2D58, #R$3223,
* #R$329E, #R$64A1, #R$64B5, #R$64C9, #R$64DD, #R$88AC and #R$8926.
* .
* Called by the handlers for keys that only work in flight. If the
* player is docked (#R$E90A), beeps, shows "Docked!" on the message line
* (#R$3955, #R$5FFB) and returns to the key handler's caller; otherwise returns normally.
refuse_if_docked:                                          ; >6dcf
       .proc
       movb @docked,a                                      ; LD A,($E90A)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  _6de2                                          ; JR Z,$6DE2        ; in flight
;       .call @trigger_sfx_6                                ; CALL $16FE        ; beep
       bl   @clear_message_line                            ; CALL $3955        ; clear the message line
       li   hl,msg_docked                                  ; LD HL,$6F17       ; "Docked!"
       bl   @show_message                                  ; CALL $5FFB        ; show it for a while
       .pop hl                                             ; POP HL            ; return to the key handler's caller
_6de2:                                                     ; >6de2
       .endproc                                            ; RET               ; 

********************************************************************************
* Gauge bar patterns
* 
* The patterns for the end of a gauge's bar (#R$6C37), 0-7 pixels long.
gauge_bar_patterns:                                        ; >6de3
       byte >00,>80,>C0,>E0,>F0,>F8,>FC,>FE

********************************************************************************
* Crosshair patterns
* 
* The crosshair sprite patterns for the four laser types (#R$6EB3), which
* #R$6D82 uploads to sprite patterns 0-15 at $3800 and shows as four 16x16
* sprites making up a 32x32 crosshair. Each is a run-length encoded stream
* (#R$39B9) of (count, value) pairs, ending with 0, that expands to the 128
* bytes of the four sprite patterns: pulse laser at #R$6DEB, mining laser
* at #R$6E1A, beam laser at #R$6E47 and military laser at #R$6E80.
* .
* The beam laser's stream expands to only 127 bytes, so the last byte of
* sprite pattern 15 keeps whatever the previous crosshair left there. The
* other three streams all end with a run of zeros, so it's 0.
crosshair_patterns:                                        ; >6deb
       byte >0F,>00,>01,>3F,>02,>00,>07,>01                          ; pulse laser: a cross with a gap in the middle
       byte >06,>00,>01,>80,>01,>3F,>0F,>00
       byte >01,>80,>06,>00,>07,>01,>04,>00
       byte >07,>80,>06,>00,>01,>01,>0F,>00
       byte >01,>FC,>01,>01,>06,>00,>07,>80
       byte >02,>00,>01,>FC,>0F,>00
       byte >00                                                      ; end
crosshair_mining:                                          ; >6e1a
       byte >05,>00,>01,>0F,>05,>0C,>05,>00                          ; mining laser: a box, open at the sides
       byte >05,>00,>01,>FF,>0F,>00,>05,>0C
       byte >01,>0F,>0F,>00,>01,>FF,>0A,>00
       byte >01,>FF,>0F,>00,>01,>F0,>05,>30
       byte >0F,>00,>01,>FF,>0A,>00,>05,>30
       byte >01,>F0,>05,>00
       byte >00                                                      ; end
crosshair_beam:                                            ; >6e47
       byte >01,>00,>01,>60,>01,>30,>01,>18                          ; beam laser: an X with a gap in the middle (127 bytes)
       byte >01,>0C,>01,>06,>01,>03,>22,>00
       byte >01,>03,>01,>06,>01,>0C,>01,>18
       byte >01,>30,>01,>60,>22,>00,>01,>06
       byte >01,>0C,>01,>18,>01,>30,>01,>60
       byte >01,>C0,>22,>00,>01,>C0,>01,>60
       byte >01,>30,>01,>18,>01,>0C,>01,>06
       byte >00                                                      ; end
crosshair_military:                                        ; >6e80
       byte >07,>00,>01,>0F,>03,>0C,>09,>00                          ; military laser: a box with a tick above and below
       byte >03,>01,>01,>FF,>0D,>00,>03,>0C
       byte >01,>0F,>0F,>00,>01,>FF,>03,>01
       byte >08,>00,>03,>80,>01,>FF,>0F,>00
       byte >01,>F0,>03,>30,>0D,>00,>01,>FF
       byte >03,>80,>09,>00,>03,>30,>01,>F0
       byte >07,>00
       byte >00                                                      ; end

********************************************************************************
* Laser types
* 
* Five bytes for each type of laser, read by #R$6D82: the cooldown between
* shots (#R$F819), the power (#R$F81A), the colour of the crosshair
* sprites, and the address of the crosshair pattern (#R$6DEB).
laser_types:                                               ; >6eb3
       byte >05,>05,>02                                              ; 0: pulse laser - cooldown 5, power 5, medium green
       data crosshair_patterns                                       ; the crosshair pattern
       byte >04,>0A,>06                                              ; 1: mining laser - cooldown 4, power 10, dark red
       data crosshair_mining                                         ; the crosshair pattern
       byte >02,>05,>07                                              ; 2: beam laser - cooldown 2, power 5, cyan
       data crosshair_beam                                           ; the crosshair pattern
       byte >00,>0A,>0D                                              ; 3: military laser - cooldown 0, power 10, magenta
       data crosshair_military                                       ; the crosshair pattern

********************************************************************************
* Flight sprite patterns
* 
* Two run-length encoded sprite pattern streams (see #R$39B9), each ending
* with 0, uploaded whenever the cockpit screen is set up (#R$63F1). The
* first fills the 16x16 sprite patterns $10 and $14 at $3880: a filled 5x5
* square (a missile the ship has) and a hollow one (an empty missile slot),
* as used by #R$6B6E. The second fills pattern $18 at $38C0: the compass
* dot used by #R$85FB.
flight_sprite_patterns:                                    ; >6ec7
       byte >05,>F8,>1B,>00,>01,>F8,>03,>88,>01,>F8,>1B,>00,>00      ; $3880: missile, empty missile slot
compass_dot_pattern:                                       ; >6ed4
       byte >01,>40,>02,>E0,>01,>40,>1C,>00,>00                      ; $38C0: compass dot

********************************************************************************
* Stardust roll handlers
* 
* The handlers that roll the stardust in each view, indexed by the current
* view (see #R$67A8, #R$68CD).
stardust_roll_handlers:                                    ; >6edd
       data stardust_roll_front                                      ; front
       data stardust_roll_rear                                       ; rear
       data stardust_roll_left                                       ; left
       data stardust_roll_right                                      ; right

********************************************************************************
* Stardust pitch handlers
* 
* The handlers that pitch the stardust in each view, indexed by the current
* view (see #R$67A8, #R$68CD).
stardust_pitch_handlers:                                   ; >6ee5
       data stardust_pitch_front                                     ; front
       data stardust_pitch_rear                                      ; rear
       data stardust_pitch_left                                      ; left
       data stardust_pitch_right                                     ; right

********************************************************************************
* Station indicator glyph
* 
* The 12 pixel rows of the console's "S" (space station in range)
* indicator, drawn by #R$6ADC: the first 8 into one character cell's
* pattern and the last 4 into the top of the cell below.
station_indicator_glyph:                                   ; >6eff
       byte >1F,>3F,>30,>30,>30,>3E,>1F,>03                          ; upper cell
       byte >03,>03,>3F,>3E                                          ; lower cell

********************************************************************************
* ECM indicator glyph
* 
* The 12 pixel rows of the console's "E" (ECM on) indicator, drawn by
* #R$6B12: the first 8 into one character cell's pattern and the last 4
* into the top of the cell below.
ecm_indicator_glyph:                                       ; >6f0b
       byte >1F,>1F,>18,>18,>18,>1E,>1E,>18                          ; upper cell
       byte >18,>18,>1F,>1F                                          ; lower cell

********************************************************************************
* The message "Docked!"
msg_docked:                                                ; >6f17
       text 'DOCKED!',>00

********************************************************************************
* Stardust direction vectors
* 
* An 8x8 table of direction vectors of length 63, used by #R$6805 to point
* a stardust particle's velocity. Entry (C,B), at $6F1F+2*(8*C+B), holds
* the vector (C,B) scaled up to length 63: first the X component,
* 63*C/sqrt(C^2+B^2), then the Y component, 63*B/sqrt(C^2+B^2), both
* rounded. Each line below is one value of C, for B = 0 to 7. Entry (0,0),
* which has no direction, holds (0,63) like the rest of its line.
stardust_directions:                                       ; >6f1f
       byte >00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F,>00,>3F ; C=0
       byte >3F,>00,>2D,>2D,>1C,>38,>14,>3C,>0F,>3D,>0C,>3E,>0A,>3E,>09,>3E ; C=1
       byte >3F,>00,>38,>1C,>2D,>2D,>23,>34,>1C,>38,>17,>3A,>14,>3C,>11,>3D ; C=2
       byte >3F,>00,>3C,>14,>34,>23,>2D,>2D,>26,>32,>20,>36,>1C,>38,>19,>3A ; C=3
       byte >3F,>00,>3D,>0F,>38,>1C,>32,>26,>2D,>2D,>27,>31,>23,>34,>1F,>37 ; C=4
       byte >3F,>00,>3E,>0C,>3A,>17,>36,>20,>31,>27,>2D,>2D,>28,>30,>25,>33 ; C=5
       byte >3F,>00,>3E,>0A,>3C,>14,>38,>1C,>34,>23,>30,>28,>2D,>2D,>29,>30 ; C=6
       byte >3F,>00,>3E,>09,>3D,>11,>3A,>19,>37,>1F,>33,>25,>30,>29,>2D,>2D ; C=7

********************************************************************************
* Startup code, now the stardust table
* 
* Used by the routine at #R$0106.
* .
* The startup code, which #R$0106 calls once. It is disassembled as
* #R$6F9F@startup, from a snapshot taken before it ran. Its last job is to
* hand its own memory over to the stardust table: it stores its start
* ($6F9F) in #R$EFA6 and its end ($7044) in #R$EFA4, and #R$68CD keeps the
* 15 particles here (11 bytes each). So in this snapshot these bytes are
* the stardust table.
* .
* Each particle's 11 bytes:
* .
* #TABLE
* { =h Offset | =h Contents }
* { $00-$01 | X: the horizontal position relative to the centre of the space
* view (#R$68CD), in signed 8.8 fixed point - the high byte is the pixel
* offset, negative to the left; the view is 176 pixels across }
* { $02-$03 | Y: the vertical position, in the same format - negative
* upwards; the view is 128 pixels high }
* { $04-$05 | The X velocity: the amount added to X each time the
* particle moves, in the same format (#R$6805) }
* { $06-$07 | The Y velocity, likewise }
* { $08 | The respawn flag: $FF when the particle has left the view and
* needs a new position (#R$68CD), 0 once it has one (#R$6805) }
* { $09 | The amount added to the X velocity for each step up in the
* ship's speed, and taken away for each step down (#R$6956, #R$699C): a
* quarter of the direction vector's X component (#R$6F1F) }
* { $0A | The same for the Y velocity }
* TABLE#
* .
* The startup code:
* .
* 1. Saves HL (the address of the cockpit screen picture) in #R$F740.
* 2. Clears $D600-$EFAA.
* 3. Writes 23 JPs, 8 bytes apart from $0000, from the table of addresses
* at #R$71F2: the RST vectors (#R$0000 to #R$0038), and 15 more that
* nothing uses (see #R$003B).
* 4. Copies the pixel masks at $1187 to #R$E700.
* 5. Initialises some variables, loads the default commander (#R$A433) and
* relocates the ship blueprints (#R$7045).
* 6. Seeds the random number generator (#R$2176) from the R register.
* 7. Hands its memory over to the stardust table, as above.
* 8. Fills the explosion's table of random numbers (#R$EEC6).
* 9. Sets the sprite size to 16x16 (VDP register 1, #R$F3E0).
startup_code_stardust_table:                               ; >6f9f
       byte >00,>15,>00,>19,>28,>00,>30,>00,>00,>0A,>0C              ; particle 0
       byte >00,>37,>00,>CB,>2D,>00,>D3,>FF,>00,>0B,>F4              ; particle 1
       byte >00,>EB,>00,>1B,>D8,>FF,>30,>00,>00,>F6,>0C              ; particle 2
       byte >00,>3B,>00,>E0,>37,>00,>E1,>FF,>00,>0D,>F8              ; particle 3
       byte >00,>13,>00,>EC,>27,>00,>CF,>FF,>00,>09,>F3              ; particle 4
       byte >00,>3F,>00,>DD,>37,>00,>E1,>FF,>00,>0D,>F8              ; particle 5
       byte >00,>30,>00,>2C,>30,>00,>28,>00,>00,>0C,>0A              ; particle 6
       byte >00,>EF,>00,>16,>D9,>FF,>31,>00,>00,>F6,>0C              ; particle 7
       byte >00,>DD,>00,>2F,>D9,>FF,>31,>00,>00,>F6,>0C              ; particle 8
       byte >00,>E8,>00,>12,>CC,>FF,>23,>00,>00,>F3,>08              ; particle 9
       byte >00,>29,>00,>C7,>25,>00,>CD,>FF,>00,>09,>F3              ; particle 10
       byte >00,>CB,>00,>32,>D3,>FF,>2D,>00,>00,>F4,>0B              ; particle 11
       byte >00,>3E,>00,>35,>30,>00,>29,>00,>00,>0C,>0A              ; particle 12
       byte >00,>24,>00,>CA,>23,>00,>CC,>FF,>00,>08,>F3              ; particle 13
       byte >00,>3F,>00,>21,>37,>00,>1F,>00,>00,>0D,>07              ; particle 14

********************************************************************************
* Draw the cockpit picture
* 
* Used by the routine at #R$63F1.
* .
* Turns the display off (bit 6 of VDP register 1, cached at $F3E0),
* decompresses the cockpit picture (#R$F740, #R$390E) - recolouring the
* space view in witchspace (#R$EEC1, #R$3A4D, colour $51) - and turns the
* display back on.
blank_screen_decompress_picture_recolour:                  ; >7139
       .proc
       limi 0                                              ; DI                ; 
       movb @vdp_reg1_cache,a                              ; LD A,($F3E0)      ; A = VDP register 1 (#R$F3E0)
       .push af                                            ; PUSH AF           ; save it
       andi a,>bf00                                        ; AND $BF           ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; turn the display off
       mov  @cockpit_picture_addr,hl                       ; LD HL,($F740)     ; HL -> the cockpit picture (#R$F740)
       bl   @decompress_picture                            ; CALL $390E        ; decompress it (#R$390E)
       movb @in_witchspace,a                               ; LD A,($EEC1)      ; in witchspace?
       socb a,a                                            ; OR A              ; 
       jeq  _7157                                          ; JR Z,$7157        ; no
       movb @bytes+>51,a                                   ; LD A,$51          ; yes: colour the space view $51
       bl   @colour_space_view                             ; CALL $3A4D        ; (#R$3A4D)
_7157:                                                     ; >7157
       .pop af                                             ; POP AF            ; 
       limi 0                                              ; DI                ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; 
       movb @bytes+>81,a                                   ; LD A,$81          ; 
       movb a,@vdpwa                                       ; OUT ($99),A       ; turn the display back on
       ; EI                                                ; EI                ; TODO: check code. 
       .endproc                                            ; RET               ; 

********************************************************************************
* Ship blueprint table
*
* The address of each ship type's blueprint (see #R$A817 for the layout),
* indexed by ship type (#R$F7E7) by #R$2FE9. Entry 0 is unused. Relocated
* at startup (#R$7045). Each blueprint ends with the ship's name, from
* which the names here are taken. Ship types 8-11 are the letters E, L,
* I and T shown on the title screen, which have no names.
ship_blueprints:                                           ; >a7d7
       data >0000                                                    ; $00: (none)
       data ship_space_station_header                                ; $01: Space Station
       data ship_missile_header                                      ; $02: Missile
       data ship_cargo_canister_header                               ; $03: Cargo Canister
       data ship_asteroid_header                                     ; $04: Asteroid
       data ship_escape_capsule_header                               ; $05: Escape Capsule
       data ship_thargon_header                                      ; $06: Thargon
       data ship_platlet_header                                      ; $07: Platlet
       data ship_letter_e_header                                     ; $08: letter E (title screen)
       data ship_letter_l_header                                     ; $09: letter L (title screen)
       data ship_letter_i_header                                     ; $0A: letter I (title screen)
       data ship_letter_t_header                                     ; $0B: letter T (title screen)
       data ship_viper_header                                        ; $0C: Viper
       data ship_fer_de_lance_header                                 ; $0D: Fer-De-Lance
       data ship_cobra_mkiii_header                                  ; $0E: Cobra MkIII
       data ship_python_header                                       ; $0F: Python
       data ship_anaconda_header                                     ; $10: Anaconda
       data ship_cobra_mk1_header                                    ; $11: Cobra MK1
       data ship_krait_header                                        ; $12: Krait
       data ship_thargoid_header                                     ; $13: Thargoid
       data ship_boa_class_cruiser_header                            ; $14: Boa Class Cruiser
       data ship_gecko_header                                        ; $15: Gecko
       data ship_moray_star_boat_header                              ; $16: Moray Star Boat
       data ship_adder_header                                        ; $17: Adder
       data ship_mamba_header                                        ; $18: Mamba
       data ship_asp_mkii_header                                     ; $19: Asp MkII
       data ship_sidewinder_header                                   ; $1A: Sidewinder
       data ship_wolf_mkii_header                                    ; $1B: Wolf MkII
       data ship_orbit_shuttle_header                                ; $1C: Orbit Shuttle
       data ship_transporter_header                                  ; $1D: Transporter
       data ship_cougar_header                                       ; $1E: Cougar
       data ship_constrictor_header                                  ; $1F: Constrictor

********************************************************************************
* Cockpit screen picture (compressed)
* 
* The whole in-flight screen: the empty space view with its frame, and
* the control panel below it - the gauge labels, the scanner ellipse and
* grid, the compass and the "ELITE" logo. #R$63F1 unpacks it when
* entering flight (via #R$7139, which reads this address from #R$F740),
* and #R$6433 then draws the gauges' current values over it.
* .
* Two run-length-encoded streams in the format #R$3928 decodes, each
* starting with its escape byte ($14 here): the 6144-byte pattern table
* ($CAD7-$CF7E), then the 6144-byte colour table ($CF7F-$D329). Each
* stream ends with an escape byte followed by a zero repeat count.
cockpit_picture:                                           ; >cad7
       byte >14,>14,>00,>20,>FE,>14,>01,>07
       byte >00,>55,>AA,>55,>AA,>55,>AA,>FF
       byte >00,>55,>AA,>55,>AA,>55,>AA,>FF
       byte >00,>55,>AA,>55,>AA,>55,>AA,>FF
       byte >00,>55,>AA,>55,>AA,>55,>AA,>FF
       byte >00,>55,>AA,>55,>AA,>55,>AA,>FF
       byte >00,>55,>AA,>55,>AA,>55,>AA,>FF
       byte >00,>56,>AA,>56,>AA,>56,>AA,>FF
       byte >14,>00,>07,>FF,>14,>00,>07,>FF
       byte >14,>00,>07,>FF,>14,>00,>07,>FF
       byte >14,>00,>07,>FF,>14,>00,>07,>FF
       byte >14,>00,>07,>FF,>00,>D5,>AA,>D5
       byte >AA,>D5,>AA,>FF,>00,>55,>AA,>55
       byte >AA,>55,>AA,>FF,>00,>55,>AA,>55
       byte >AA,>55,>AA,>FF,>00,>55,>AA,>55
       byte >AA,>55,>AA,>FF,>00,>55,>AA,>55
