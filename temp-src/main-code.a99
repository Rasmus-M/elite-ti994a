********************************************************************************
* RST $38 vector: the Z80 IM1 interrupt entry point (VBlank handler)
* 
* Used by the routine at #R$6F9F.
* .
* The maskable interrupt (the VDP's VBlank) arrives here in IM 1. See
* #R$7202.

********************************************************************************
* Unused
* 
* Apart from the 3-byte JPs at the eight RST vectors, nothing in the first
* 256 bytes is used by the game in this snapshot. #R$6F9F wrote 23 JPs, 8
* bytes apart from $0000, from the table of addresses at $71F2: the first 8
* are the RST vectors, and the other 15 are the JPs at $0040-$00B0 below,
* which nothing calls. The 5 bytes after each RST vector and after each JP
* at $0040-$0060, and $003B-$003F, are left over from before #R$6F9F ran.
* The MSX BIOS tape routines at $00E1-$00F0 called by #R$A492 and #R$A4CA
* are not in this RAM: #R$A511 pages the BIOS ROM in first.

********************************************************************************
* Game entry point
* 
* The loader jumps here once the game is in memory. A 1-instruction stub jumping past 4 dead bytes at #R$0102 (never
* called from anywhere) into the real work at #R$0106.
game_entry:                                                ; >0100
       jmp  main_loop_start                                ; JR $0106          ; 

********************************************************************************
* Unused
* 
* Two RST $10 instructions, which #R$0100 jumps over.
unused_0102:                                               ; >0102
       .rst >10                                            ; RST $10           ; 
       ; AND A                                             ; AND A             ; TODO: check code. 
       .rst >10                                            ; RST $10           ; 
       ; AND A                                             ; AND A             ; TODO: check code. 

********************************************************************************
* Main loop
* 
* Used by the routine at #R$0100.
* .
* Reached only via #R$0100's `JR $0106`. Sets the stack and runs the
* one-time startup code (#R$6F9F), then shows the title screen (#R$1C5C),
* which returns once a game has been started (Y or N at "Load New
* Commander ?"). The game then runs in the loop at $010F - polling the
* keyboard (#R$401C) and running the per-frame pass (#R$13FD) while
* not docked (#R$E90A) - until the game is over (#R$F749). It then stops the
* sound (#R$7438), shows the death scene (#R$1703) unless the player quit,
* and goes back to the title screen.
main_loop_start:                                           ; >0106
       li   sp,ship_blueprints                             ; LD SP,$A7D7       ; Set up the stack
       .call @startup_code_stardust_table                  ; CALL $6F9F        ; One-time startup, run once before the loop (see #R$6F9F)
main_loop:                                                 ; >010c
       .call @title_screen                                 ; CALL $1C5C        ; show the title screen until a game is started
main_loop_wait_tick:                                       ; >010f
       mov  @main_loop_tick_counter,hl                     ; LD HL,($F746)     ; 
       inc  hl                                             ; INC HL            ; 
       mov  hl,@main_loop_tick_counter                     ; LD ($F746),HL     ; advance the frame counter
       sb   a,a                                            ; XOR A             ; 
       movb a,@vblank_subtick_counter                      ; LD ($F748),A      ; 
       .call @read_controls                                ; CALL $401C        ; 
       movb @docked,a                                      ; LD A,($E90A)      ; docked?
       socb a,a                                            ; OR A              ; 
       jne  !                                              ; CALL Z,$13FD      ; no - run the per-frame pass
       .call @process_frame                                ;                   
!
       movb @game_over,a                                   ; LD A,($F749)      ; 
       socb a,a                                            ; OR A              ; 
       jeq  main_loop_wait_tick                            ; JR Z,$010F        ; loop until the game is over
       sb   a,a                                            ; XOR A             ; 
       movb a,@alert_level                                 ; LD ($E90C),A      ; 
       movb a,@mission_state                               ; LD ($E93D),A      ; 
       .call @stop_all_sound                               ; CALL $7438        ; stop the sound
       movb @game_over_cause,a                             ; LD A,($F74A)      ; 
       cb   a,@bytes+>03                                   ; CP $03            ; 
       jeq  !                                              ; CALL NZ,$1703     ; show the death scene, unless the player quit
       .call @death_scene                                  ;                   
!
       sb   a,a                                            ; XOR A             ; 
       movb a,@game_over                                   ; LD ($F749),A      ; clear the game-over flag
       b    @main_loop                                     ; JP $010C          ; back to the title screen

********************************************************************************
* The message "* GAME OVER"
msg_game_over:                                             ; >0143
       text '* GAME OVER'

********************************************************************************
* Do nothing
* 
* #R$13FD and #R$40DE call $0151, a RET - probably where debugging code
* was once called. Nothing jumps to $014E, a jump into #R$0152.
entry_hex_byte_screen_debug_utility:                       ; >014e
       jne  _017a                                          ; JR NZ,$017A       ; 
       nop                                                 ; NOP               ; 
* This entry point is used by the routines at #R$13FD and #R$40DE.
do_nothing:                                                ; >0151
       .ret                                                ; RET               ; 

********************************************************************************
* Write HL in hex to the VDP (unused)
* 
* Writes the patterns of the four hex digits of HL, from the font
* (#R$0A9F), to the VDP at its current address. At $0157, writes A's two
* digits; at $0160, A's low digit. Nothing calls it - probably left-over
* debugging code.
write_hex_byte_as_vram_tiles:                              ; >0152
       movb h,a                                            ; LD A,H            ; 
       .call @write_hex_a                                  ; CALL $0157        ; write H's two digits
       movb @l,a                                           ; LD A,L            ; then L's
write_hex_a:                                               ; >0157
       .push af                                            ; PUSH AF           ; 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       srl  a,1                                            ; RRA               ; TODO: check code. 
       .call @write_hex_digit                              ; CALL $0160        ; write A's high digit
       .pop af                                             ; POP AF            ; 
write_hex_digit:                                           ; >0160
       andi a,>0f00                                        ; AND $0F           ; 
       ab   @bytes+>30,a                                   ; ADD A,$30         ; 
       cb   a,@bytes+>3a                                   ; CP $3A            ; 
       jl   _016a                                          ; JR C,$016A        ; 
       ab   @bytes+>07,a                                   ; ADD A,$07         ; A = the digit's character, '0'-'9' or 'A'-'F'
_016a:                                                     ; >016a
       .push bc                                            ; PUSH BC           ; 
       .push hl                                            ; PUSH HL           ; 
       movb a,@l                                           ; LD L,A            ; 
       sb   h,h                                            ; LD H,$00          ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       a    hl,hl                                          ; ADD HL,HL         ; 
       li   bc,log_table+>019f                             ; LD BC,$099F       ; 
       a    bc,hl                                          ; ADD HL,BC         ; HL -> the character's pattern (#R$0A9F)
       movb @bytes+>08,b                                   ; LD B,$08          ; 8 pixel rows
_0178:                                                     ; >0178
       movb *hl,a                                          ; LD A,(HL)         ; 
       inc  hl                                             ; INC HL            ; 
* This entry point is used by the routine at #R$014E.
_017a:                                                     ; >017a
       movb a,@vdpwd                                       ; OUT ($98),A       ; write a row
       sb   one,b                                          ; DJNZ $0178        ; 
       jne  _0178                                          ;                   
       .pop hl                                             ; POP HL            ; 
       .pop bc                                             ; POP BC            ; 
       .ret                                                ; RET               ; 

********************************************************************************
* Unused
* 
* A jump into the MSX system area. Nothing jumps here; probably left over,
* like #R$014E and #R$0152 before it.
unused_0181:                                               ; >0181
       b    @bios_vars_f40b+>0015                          ; JP $F420          ; 

********************************************************************************
* Two words, then unused zeros
* 
* Two words, $EBDA and $EBD9 (addresses in the $EB00 work area; nothing
* traced reads them), followed by zeros up to $01FF - apparently padding
* so that the tables that follow start on page boundaries.
unused_0184:                                               ; >0184
       data station_position+>0011,station_position+>0010
       byte >00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00,>00,>00,>00,>00
       byte >00,>00,>00,>00

********************************************************************************
* Bit-length table
* 
* Entry n (0-255) is the number of bits needed to hold n, i.e. the
* position of its highest set bit plus one (with entry 0 = 1): 1 for
* 0-1, 2 for 2-3, 3 for 4-7, and so on up to 8 for 128-255. Page-aligned
* so that it can be read with `LD H,$02 / LD L,n / LD A,(HL)` (or through BC
* or DE). Used as a loop or shift count - how many times to halve something
* until it fits - by the multiply routines (#R$1F5E, #R$1F73, #R$200A), the
* drawing of an object (#R$422E, for its normals' scale) and its size on
* screen (#R$46CA), the projection of points (#R$47C4, #R$47F0), the
* stardust (#R$64F1, #R$656B, #R$6805), the length of a vector (#R$84A6) and
* the compass (#R$8570).
bit_length_table:                                          ; >0200
       byte >01,>01,>02,>02,>03,>03,>03,>03,>04,>04,>04,>04,>04,>04,>04,>04
       byte >05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05,>05
       byte >06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06
       byte >06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06,>06
       byte >07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07
       byte >07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07
       byte >07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07
       byte >07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07,>07
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08
       byte >08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08,>08

********************************************************************************
* Signed 3/4 scaling table
* 
* Entry n is the signed byte n * 3/4, rounded to the nearest (halves away
* from zero): $00-$7F map to $00-$5F, and $80-$FF (-128 to -1) map to
* $A0-$FF (-96 to -1). Page-aligned so that it can be read with `LD H,$03 /
* LD L,n` (or through DE). Used by #R$3C29, #R$3DD7 and #R$3EAD (at $3F06
* and $3F28) to turn a signed X coordinate into a screen column: the result
* plus $57 (87, the centre of the 176-pixel-wide space view) gives a column
* from -9 to 182. #R$5524 also uses it to scale the first coordinate of each
* point of the jump-range circle by 3/4.
scale_3_4_table:                                           ; >0300
       byte >00,>01,>02,>02,>03,>04,>05,>05,>06,>07,>08,>08,>09,>0A,>0B,>0B
       byte >0C,>0D,>0E,>0E,>0F,>10,>11,>11,>12,>13,>14,>14,>15,>16,>17,>17
       byte >18,>19,>1A,>1A,>1B,>1C,>1D,>1D,>1E,>1F,>20,>20,>21,>22,>23,>23
       byte >24,>25,>26,>26,>27,>28,>29,>29,>2A,>2B,>2C,>2C,>2D,>2E,>2F,>2F
       byte >30,>31,>32,>32,>33,>34,>35,>35,>36,>37,>38,>38,>39,>3A,>3B,>3B
       byte >3C,>3D,>3E,>3E,>3F,>40,>41,>41,>42,>43,>44,>44,>45,>46,>47,>47
       byte >48,>49,>4A,>4A,>4B,>4C,>4D,>4D,>4E,>4F,>50,>50,>51,>52,>53,>53
       byte >54,>55,>56,>56,>57,>58,>59,>59,>5A,>5B,>5C,>5C,>5D,>5E,>5F,>5F
       byte >A0,>A1,>A1,>A2,>A3,>A4,>A4,>A5,>A6,>A7,>A7,>A8,>A9,>AA,>AA,>AB
       byte >AC,>AD,>AD,>AE,>AF,>B0,>B0,>B1,>B2,>B3,>B3,>B4,>B5,>B6,>B6,>B7
       byte >B8,>B9,>B9,>BA,>BB,>BC,>BC,>BD,>BE,>BF,>BF,>C0,>C1,>C2,>C2,>C3
       byte >C4,>C5,>C5,>C6,>C7,>C8,>C8,>C9,>CA,>CB,>CB,>CC,>CD,>CE,>CE,>CF
       byte >D0,>D1,>D1,>D2,>D3,>D4,>D4,>D5,>D6,>D7,>D7,>D8,>D9,>DA,>DA,>DB
       byte >DC,>DD,>DD,>DE,>DF,>E0,>E0,>E1,>E2,>E3,>E3,>E4,>E5,>E6,>E6,>E7
       byte >E8,>E9,>E9,>EA,>EB,>EC,>EC,>ED,>EE,>EF,>EF,>F0,>F1,>F2,>F2,>F3
       byte >F4,>F5,>F5,>F6,>F7,>F8,>F8,>F9,>FA,>FB,>FB,>FC,>FD,>FE,>FE,>FF

********************************************************************************
* Antilog table
* 
* 512 words: entry i is 2^(i/32), rounded (1 up to $FA83). With the log
* table at #R$0800 (log2(n)*1024), multiplying two numbers is a matter
* of adding their logs and looking up the sum here: #R$1FF2 uses the
* sum's top 9 bits as the index and returns the high byte of the entry,
* which is the product divided by 256. See #R$2160.
antilog_table:                                             ; >0400
       data >0001,>0001,>0001,>0001,>0001,>0001,>0001,>0001          ; i = 0-7
       data >0001,>0001,>0001,>0001,>0001,>0001,>0001,>0001          ; i = 8-15
       data >0001,>0001,>0001,>0001,>0001,>0001,>0001,>0001          ; i = 16-23
       data >0001,>0001,>0001,>0001,>0001,>0001,>0001,>0001          ; i = 24-31
       data >0002,>0002,>0002,>0002,>0002,>0002,>0002,>0002          ; i = 32-39
       data >0002,>0002,>0002,>0002,>0002,>0002,>0002,>0002          ; i = 40-47
       data >0002,>0002,>0002,>0003,>0003,>0003,>0003,>0003          ; i = 48-55
       data >0003,>0003,>0003,>0003,>0003,>0003,>0003,>0003          ; i = 56-63
       data >0004,>0004,>0004,>0004,>0004,>0004,>0004,>0004          ; i = 64-71
       data >0004,>0004,>0004,>0005,>0005,>0005,>0005,>0005          ; i = 72-79
       data >0005,>0005,>0005,>0006,>0006,>0006,>0006,>0006          ; i = 80-87
       data >0006,>0006,>0007,>0007,>0007,>0007,>0007,>0007          ; i = 88-95
       data >0008,>0008,>0008,>0008,>0008,>0008,>0009,>0009          ; i = 96-103
       data >0009,>0009,>0009,>000A,>000A,>000A,>000A,>000b          ; i = 104-111
       data >000b,>000b,>000b,>000C,>000C,>000C,>000C,>000D          ; i = 112-119
       data >000D,>000D,>000E,>000E,>000E,>000E,>000F,>000F          ; i = 120-127
       data >0010,>0010,>0010,>0011,>0011,>0011,>0012,>0012          ; i = 128-135
       data >0013,>0013,>0013,>0014,>0014,>0015,>0015,>0016          ; i = 136-143
       data >0016,>0017,>0017,>0018,>0018,>0019,>0019,>001A          ; i = 144-151
       data >001A,>001b,>001C,>001C,>001D,>001D,>001E,>001F          ; i = 152-159
       data >0020,>0020,>0021,>0022,>0022,>0023,>0024,>0025          ; i = 160-167
       data >0026,>0026,>0027,>0028,>0029,>002A,>002b,>002C          ; i = 168-175
       data >002D,>002E,>002F,>0030,>0031,>0032,>0033,>0034          ; i = 176-183
       data >0035,>0036,>0038,>0039,>003A,>003b,>003D,>003E          ; i = 184-191
       data >0040,>0041,>0042,>0044,>0045,>0047,>0048,>004A          ; i = 192-199
       data >004C,>004D,>004F,>0051,>0052,>0054,>0056,>0058          ; i = 200-207
       data >005A,>005C,>005E,>0060,>0062,>0064,>0067,>0069          ; i = 208-215
       data >006B,>006D,>0070,>0072,>0075,>0077,>007A,>007D          ; i = 216-223
       data >0080,>0082,>0085,>0088,>008B,>008E,>0091,>0094          ; i = 224-231
       data >0098,>009B,>009E,>00A2,>00A5,>00A9,>00AD,>00B1          ; i = 232-239
       data >00B5,>00B8,>00BD,>00C1,>00C5,>00C9,>00CE,>00D2          ; i = 240-247
       data >00D7,>00DB,>00E0,>00E5,>00ea,>00EF,>00F5,>00FA          ; i = 248-255
       data >0100,>0105,>010B,>0111,>0117,>011D,>0123,>0129          ; i = 256-263
       data >0130,>0137,>013D,>0144,>014B,>0153,>015A,>0162          ; i = 264-271
       data >016a,>0171,>017a,>0182,>018A,>0193,>019C,>01A5          ; i = 272-279
       data >01AE,>01B7,>01C1,>01CB,>01D5,>01DF,>01EA,>01F5          ; i = 280-287
       data >0200,>020B,>0216,>0222,>022E,>023A,>0247,>0253          ; i = 288-295
       data >0260,>026E,>027B,>0289,>0297,>02A6,>02B5,>02C4          ; i = 296-303
       data >02D4,>02E3,>02F4,>0304,>0315,>0326,>0338,>034A          ; i = 304-311
