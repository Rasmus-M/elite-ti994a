       .pop de                                             ; POP DE            ; DE = the first product's HL
       .pop bc                                             ; POP BC            ; BC = the first product's high byte
       a    de,hl                                          ; ADD HL,DE         ; HL += DE (sum the first product in)
       jnc  !                                              ;                   ; (ADC: add the carry first)
       ab   one,a                                          ;                   ; 
!
       ab   b,a                                            ; ADC A,B           ; A += B, with carry
       .pop hl                                             ; POP HL            ; restore the caller's HL
       .endproc                                            ; RET               ; return with A:HL = the summed 24-bit accumulator

********************************************************************************
* Multiply a small signed number by a sign-magnitude word
* 
* Used by the routine at #R$4873.
* .
* Returns A:HL = L * DE, where L is a signed number from -128 to 127 (H
* being its sign, so only bit 7 of H matters) and DE is sign-magnitude.
* The sign of the result is the XOR of the two signs, kept in F' while the
* magnitudes are multiplied by shift and add (stopping once no bits of |L|
* are left); the result is a 24-bit two's complement number.
* 
* I:HL The first number (L, with H its sign)
* I:DE The second number (sign-magnitude)
* O:A:HL The product
multiply_small_by_word:                                    ; >48ec
       mov  hl,r0                                          ; LD A,H            ; 
       xor  de,r0                                          ; XOR D             ; R0 bit 15 = the sign of the product
       andi de,>7fff                                       ; RES 7,D           ; DE = |DE|
       clr  r1                                             ;                   ; 
       movb @l,r1                                          ;                   ; 
       mov  hl,hl                                          ; BIT 7,H           ; L negative?
       jgt  !                                              ; JR Z,$48F9        ; no
       jeq  !                                              ;                   ; 
       neg  r1                                             ; NEG               ; yes: L = |L|
!
       srl  r1,8                                           ; LD B,L            ; R1 = |L|
       mpy  de,r1                                          ; ADD HL,DE         ; R1:R2 = the product (the shift-and-add loop on the Z80)
       mov  r0,r0                                          ; EX AF,AF'         ; the sign
       jgt  !                                              ; RET P             ; positive - done
       jeq  !                                              ;                   ; 
       inv  r1                                             ; SUB L             ; negative: negate the product
       neg  r2                                             ; SBC A,H           ; 
       jne  !                                              ;                   ; 
       inc  r1                                             ;                   ; 
!
       mov  r2,hl                                          ;                   ; 
       swpb r1                                             ;                   ; 
       movb r1,a                                           ; LD A,C            ; A:HL = the product
       rt                                                  ; RET               ; 

********************************************************************************
* Draw a ship: draw a face's edges
* 
* Used by the routine at #R$422E.
* .
* Part of #R$4255. For each edge in the face's list (a count, then edge
* numbers), looks up its two vertices in the edge data (#R$F7F7) and,
* unless it has already been drawn (its flag at $E7B6, read and written by
* patching the displacement of an (IX+d) instruction), draws it (#R$496D)
* and marks it drawn. An edge whose first vertex has bit 7 set isn't drawn
* but flagged $FF and counted in $E6EE ($4948); when it turns up again
* ($4957) it's flagged 1 and the count goes down.
* .
* At $4969, moves on to the next edge.
draw_face_edges:                                           ; >491a
       .proc
       movb *hl,b                                          ; LD B,(HL)         ; B = the number of edges
       inc  hl                                             ; INC HL            ; 
_491c:                                                     ; >491c
       movb *hl,a                                          ; LD A,(HL)         ; A = the next edge
       movb a,@draw_face_edge_flag+>0003                   ; LD ($4922),A      ; point (IX+d) at the edge's flag (#R$4920+2)
draw_face_edge_flag:                                       ; >4920
       movb @>05(ix),a                                     ; LD A,(IX+$05) / OR A; A = the edge's flag
       jne  draw_face_edges_3                              ; JR NZ,$4957       ; already drawn or skipped
       .push hl                                            ; PUSH HL           ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb @bp_edges,hl                                   ; LD HL,($F7F7)     ; HL = the edge data
       movb @bp_edges+1,@l                                 ;                   ;
       ab   a,a                                            ; ADD A,A           ; 
       ab   @l,a                                           ; ADD A,L           ; 
       movb a,@l                                           ; LD L,A            ; 
       jnc  draw_face_edge                                 ; JP NC,$4932       ; 
!
       ab   one,h                                          ; INC H             ; 
draw_face_edge:                                            ; >4932
       movb *hl,a                                          ; LD A,(HL) / OR A  ; A = the edge's first vertex
       jlt  draw_face_edges_2                              ; JP M,$4948        ; bit 7 set - skip it
!
       movb a,@e                                           ; LD E,A            ; E = the first vertex
       inc  hl                                             ; INC HL            ; 
       movb *hl,d                                          ; LD D,(HL)         ; D = the second vertex
       bl   @draw_edge                                     ; CALL $496D        ; draw the edge
       bl   @ti_poll_vblank                                ;                   ; (TI: poll for VBlank, interrupts are off)
       .pop hl                                             ; POP HL            ; 
       movb *hl,a                                          ; LD A,(HL)         ; 
       movb a,@draw_face_edge_drawn+>0003                  ; LD ($4944),A      ; point (IX+d) at the edge's flag (#R$4942+2)
draw_face_edge_drawn:                                      ; >4942
       movb one,@>05(ix)                                   ; LD (IX+$05),$01   ; the edge is drawn
       jmp  _4955                                          ; JR $4955          ; 
draw_face_edges_2:                                         ; >4948
