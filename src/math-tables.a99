********************************************************************************
* Signed 3/4 scaling table
* 
* Entry n is the signed byte n * 3/4, rounded to the nearest (halves away
* from zero): $00-$7F map to $00-$5F, and $80-$FF (-128 to -1) map to
* $A0-$FF (-96 to -1). Page-aligned so that it can be read with `LD H,$03 /
* LD L,n` (or through DE). Used by #R$3C29, #R$3DD7 and #R$3EAD (at $3F06
* and $3F28) to turn a signed X coordinate into a screen column: the result
* plus $57 (87, the centre of the 176-pixel-wide space view) gives a column
* from -9 to 182. #R$5524 also uses it to scale the first coordinate of each
* point of the jump-range circle by 3/4.
scale_3_4_table:                                           ; >0300
       byte >00,>01,>02,>02,>03,>04,>05,>05,>06,>07,>08,>08,>09,>0A,>0B,>0B
       byte >0C,>0D,>0E,>0E,>0F,>10,>11,>11,>12,>13,>14,>14,>15,>16,>17,>17
       byte >18,>19,>1A,>1A,>1B,>1C,>1D,>1D,>1E,>1F,>20,>20,>21,>22,>23,>23
       byte >24,>25,>26,>26,>27,>28,>29,>29,>2A,>2B,>2C,>2C,>2D,>2E,>2F,>2F
       byte >30,>31,>32,>32,>33,>34,>35,>35,>36,>37,>38,>38,>39,>3A,>3B,>3B
       byte >3C,>3D,>3E,>3E,>3F,>40,>41,>41,>42,>43,>44,>44,>45,>46,>47,>47
       byte >48,>49,>4A,>4A,>4B,>4C,>4D,>4D,>4E,>4F,>50,>50,>51,>52,>53,>53
       byte >54,>55,>56,>56,>57,>58,>59,>59,>5A,>5B,>5C,>5C,>5D,>5E,>5F,>5F
       byte >A0,>A1,>A1,>A2,>A3,>A4,>A4,>A5,>A6,>A7,>A7,>A8,>A9,>AA,>AA,>AB
